From c25e7a3289d315aed6c9a5ca9880cc425fd4a389 Mon Sep 17 00:00:00 2001
From: TL-QCPHYSD <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 15:33:33 +0000
Subject: [PATCH 1/2] gen: bare full-area hard IP types take their single clock
 terminal, no R4 tap grid (QC phy_serdes/phy_serdes_b/phy_ucie_kv)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 tools/die_plan/schema.py                 | 17 ++++++++++++++
 tools/die_plan/test_full_area_hard_ip.py | 28 ++++++++++++++++++++++++
 2 files changed, 45 insertions(+)
 create mode 100644 tools/die_plan/test_full_area_hard_ip.py

diff --git a/tools/die_plan/schema.py b/tools/die_plan/schema.py
index 4eb786124d..6894a87e26 100644
--- a/tools/die_plan/schema.py
+++ b/tools/die_plan/schema.py
@@ -2486,10 +2486,27 @@ def core_tap_early_ps(P, tp, corner="TT"):
     return max(0.0, core_tap_insertion_ps(tp, corner) - common_latency_ps(P, corner))
 
 
+def full_area_hard_ip(t):
+    """QC-PHY-1 11-14 (COORD ruling, QC phy_serdes/phy_serdes_b/phy_ucie_kv): a bare hard type whose only content is one
+    placed hard IP covering >= 95% of the partition (licensed PHY abstract used as-is).  There is no free site for an
+    R4 grid tap and no clock sink inside the abstract: its one clock terminal is clock.tap_um (same as bare_hard_single_tap).
+    False for every other type, so existing kits and budgets are unchanged."""
+    if not bare_hard_single_tap(t):
+        return False
+    cs = t.get("contents", []) or []
+    if len(cs) != 1 or not cs[0].get("lef") or not cs[0].get("origin_um") or not cs[0].get("outline_um"):
+        return False
+    w, h = t["outline_um"]
+    mw, mh = cs[0]["outline_um"]
+    return w > 0 and h > 0 and (mw * mh) >= 0.95 * (w * h)
+
+
 def _grid_taps(P, tn):
     """the R4 pitch grid of tap_grid (no added sink taps)."""
     t = P.types[tn]
     xy = t.get("clock", {}).get("tap_um")
+    if full_area_hard_ip(t) and isinstance(xy, (list, tuple)) and len(xy) == 2:
+        return [("clk", float(xy[0]), float(xy[1]))]
     if (bare_hard(t) and t.get("clock", {}).get("tap_mode") == "grid+explicit"
             and isinstance(xy, (list, tuple)) and len(xy) == 2):
         # FLOW-20 11-01: the "grid" of a bare hard wrapper (grid+explicit) is its terminal at clock.tap_um, exactly
diff --git a/tools/die_plan/test_full_area_hard_ip.py b/tools/die_plan/test_full_area_hard_ip.py
new file mode 100644
index 0000000000..228951c889
--- /dev/null
+++ b/tools/die_plan/test_full_area_hard_ip.py
@@ -0,0 +1,28 @@
+import schema as S
+
+
+def _t(**kw):
+    t = {"hard": True, "outline_um": [100.0, 200.0], "clock": {"tap_um": [50.0, 199.0]},
+         "contents": [{"inst": "u", "module": "m", "lef": "a.lef", "origin_um": [0, 0], "outline_um": [99.0, 199.0]}]}
+    t.update(kw)
+    return t
+
+
+def test_full_area_macro_detected():
+    assert S.full_area_hard_ip(_t())
+
+
+def test_small_macro_not_full_area():
+    t = _t()
+    t["contents"][0]["outline_um"] = [50.0, 50.0]
+    assert not S.full_area_hard_ip(t)
+
+
+def test_needs_lef_and_single_content_and_no_hard_cores():
+    t = _t()
+    t["contents"][0].pop("lef")
+    assert not S.full_area_hard_ip(t)
+    assert not S.full_area_hard_ip(_t(hard_cores=[{"inst": "c"}]))
+    t2 = _t()
+    t2["contents"].append(dict(t2["contents"][0], inst="v"))
+    assert not S.full_area_hard_ip(t2)
-- 
2.53.0


From 3a3336542dc00974a635205e68c2677400c45f07 Mon Sep 17 00:00:00 2001
From: TL-QCPHYSD <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 16:00:38 +0000
Subject: [PATCH 2/2] gen: full-area hard IP kit gets timed_face.json, zero
 core margin, rtlmp skip; face_guard accepts epoch-from-reset on declared
 timed buses

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 tools/die_plan/face_guard.py |  4 +++-
 tools/die_plan/gen_phys.py   | 10 +++++++++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/tools/die_plan/face_guard.py b/tools/die_plan/face_guard.py
index a542796065..c978ba4f2f 100644
--- a/tools/die_plan/face_guard.py
+++ b/tools/die_plan/face_guard.py
@@ -981,7 +981,9 @@ def guard(text, top=None, skip_re=SKIP_RE, pins=None, ft1=(), straps=(), bumps=(
         return seam.get(re.sub(r"\[\d+\]$", "", str(b)), frozenset())
 
     def fail(cls, b, why):
-        if timed and cls in TIMED_CLASSES and re.sub(r"\[\d+\]$", "", str(b)) in timed:
+        if timed and re.sub(r"\[\d+\]$", "", str(b)) in timed and (
+                cls in TIMED_CLASSES or (cls == "feedthrough" and why == "buffered from port arst_n")):
+            # QC-PHY-1 11-14: a bare registered-pin hard IP drives its epoch bit with the delivered reset level (bind.py reg_hard)
             res["timed_declared"].append(f"{b}: {cls} {why}")   # DIE-KV-61/hr: declared timed-face bit
             return
         if cls != "merged" and cls in seam_cls(b):
diff --git a/tools/die_plan/gen_phys.py b/tools/die_plan/gen_phys.py
index 7cffc85426..5329c4e2fd 100644
--- a/tools/die_plan/gen_phys.py
+++ b/tools/die_plan/gen_phys.py
@@ -221,7 +221,7 @@ def _gutter_block_um(budgets, tn):
 def _macros_all_plan_fixed(t):
     """KW-FIX-45 11-12 (COORD ruling, PHY MPL-0006): a hard-wrapper type (type.hard) has every macro placed and fixed by the plan
     (macro_place.tcl place_macro -exact), so rtl_macro_placer is skipped (macro_skip_rtlmp.tcl).  Other types: False."""
-    return bool(t.get("hard")) and bool(t.get("hard_cores"))
+    return bool(t.get("hard")) and (bool(t.get("hard_cores")) or S.full_area_hard_ip(t))
 
 
 def _gutter_block_min_span_um(budgets):
@@ -4253,6 +4253,8 @@ def kit_core_area(t):
         # origin / spans the frozen outline, so a 4.32 um inset core can neither contain nor place it.  Every other type is
         # unchanged; an explicit kit_core_margins_um still wins.
         hc=[c for c in t.get("hard_cores",[]) if c.get("lef") and c.get("outline_um") and c.get("origin_um")]
+        if not hc and S.full_area_hard_ip(t):       # QC-PHY-1 11-14: bare full-area hard IP in contents[] (same rule)
+            hc=list(t["contents"])
         if t.get("hard") and len(hc)==1:
             (ox,oy),(mw,mh)=hc[0]["origin_um"],hc[0]["outline_um"]
             eps=1e-6
@@ -5594,6 +5596,12 @@ puts "OT_CLAND preserved $cland_refirm legally packed cells FIRM through DPL"
         (kd / "land_slots.json").write_text(json.dumps(land_slots, indent=1) + "\n")
     port_pins = port_bind_pin_records(P, tn, pins, bump_ports)
     (kd / "port_bind_pins.json").write_text(json.dumps(port_pins, indent=1) + "\n")
+    if S.full_area_hard_ip(t) and any(c.get("registered_pins") for c in t.get("contents", []) or []):
+        # QC-PHY-1 11-14 (COORD ruling): a bare full-area hard IP has no face flops, its registered FDI pins are the
+        # boundary registers; the macro pin is timed from its lib, so every plan bus is a declared timed face.
+        (kd / "timed_face.json").write_text(json.dumps(dict(
+            schema="opentallas.kit_timed_face.v1", buses=sorted({b["name"] for b in t.get("buses", [])}),
+            ruling="COORD 11-14 QC-PHY-1", reason="bare hard IP with registered FDI pins: no face flops, macro pin timed from its lib"), indent=1) + "\n")
     if spare_out:                               # DIE-S81-46: declared spare-out bits (kit_rtl.json), face_guard
         from face_guard import SPARE_SCHEMA
         (kd / "spare_out.json").write_text(json.dumps(dict(schema=SPARE_SCHEMA, bits=list(spare_out)), indent=1) + "\n")
-- 
