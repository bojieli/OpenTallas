From 2c6ddad381f8125ee336a7a7973084e2404f8c45 Mon Sep 17 00:00:00 2001
From: TL-QCPHYSD <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 17:42:25 +0000
Subject: [PATCH] schema/check: full-area hard IP ports skip the partition
 PG-band keep-out (pg_free); tests

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 tools/die_plan/check.py                  |  2 +-
 tools/die_plan/schema.py                 | 17 +++++++++++++----
 tools/die_plan/test_pg_free_full_area.py | 24 ++++++++++++++++++++++++
 3 files changed, 38 insertions(+), 5 deletions(-)
 create mode 100644 tools/die_plan/test_pg_free_full_area.py

diff --git a/tools/die_plan/check.py b/tools/die_plan/check.py
index ebe1e8deca..d3b5f38616 100644
--- a/tools/die_plan/check.py
+++ b/tools/die_plan/check.py
@@ -677,7 +677,7 @@ def check_faces(P, R, face_pins):
                 if ln not in P.layers:
                     continue
                 nb = sum(1 for k in range(b0, b1) if k % nl == li)
-                tr = max(1, S.usable_tracks(P.layers[ln], ln, lo, hi))     # tracks off the PG stripes (M5-M8)
+                tr = max(1, S.usable_tracks(P.layers[ln], ln, lo, hi, pg_free=P.port_pg_free(pr)))     # tracks off the PG stripes (M5-M8)
                 if nb / tr > B["pin_track_max"] + EPS:
                     R.err("faces", f"port {pid}: {nb} pins on {tr} {ln} tracks = {nb / tr:.2f} > "
                           f"{B['pin_track_max']}", port=pid)
diff --git a/tools/die_plan/schema.py b/tools/die_plan/schema.py
index 2143121397..7b619302f5 100644
--- a/tools/die_plan/schema.py
+++ b/tools/die_plan/schema.py
@@ -2212,6 +2212,8 @@ class Plan:
         part = pr[side]["part"]
         tf, win, lays, order = self._type_geom(part, pr[side]["bus"])
         tp = dict(pr, face=tf, window_um=win, layers=lays, order=order)
+        if full_area_hard_ip(self.types[self.parts[part]["type"]]):
+            tp["pg_free"] = True          # QC-PHY-1 11-14 (COORD): the macro's own pins are fixed; no partition PG keep-out
         tp.pop("segments", None)          # type-declared geometry is one window (segments are die-frame port data)
         p = self.parts[part]
         w, h = self.types[p["type"]]["outline_um"]
@@ -2222,6 +2224,11 @@ class Plan:
             base, ext, flip = p["origin_um"][0], w, o in ("MY", "R180")
         return sorted((b, ln, round(base + (ext - c if flip else c), 6)) for b, ln, c in pin_positions(tp, self.layers))
 
+    def port_pg_free(self, pr):
+        """QC-PHY-1: True when the port's type-declared geometry belongs to a full-area hard IP type (see port_pins)."""
+        side = pr.get("_geom_from")
+        return bool(side) and full_area_hard_ip(self.types[self.parts[pr[side]["part"]]["type"]])
+
     def port_point(self, pid):
         """centre of the port window on its face, die frame."""
         pr = self.ports[pid]
@@ -2785,12 +2792,13 @@ def spread(A, n, lo, hi):
     return lowh + ([(m - 1) // 2] if n % 2 else []) + [m - 1 - i for i in reversed(lowh)]
 
 
-def usable_tracks(L, ln, lo, hi):
-    """number of tracks of layer ln (dict L: pitch_um, offset_um) inside [lo, hi] off the partition PG bands."""
+def usable_tracks(L, ln, lo, hi, pg_free=False):
+    """number of tracks of layer ln (dict L: pitch_um, offset_um) inside [lo, hi] off the partition PG bands
+    (pg_free: a full-area hard IP port, QC-PHY-1: its pins are the macro's own, no PG band applies)."""
     p, off = L["pitch_um"], L["offset_um"]
     k0 = math.ceil((lo - off) / p - 1e-9)
     k1 = math.floor((hi - off) / p + 1e-9)
-    return sum(1 for k in range(k0, k1 + 1) if not pg_blocked(ln, off + k * p))
+    return sum(1 for k in range(k0, k1 + 1) if pg_free or not pg_blocked(ln, off + k * p))
 
 
 def window_for(lo, pins, names, layers=None, per_um=6.0, track_max=0.6):
@@ -2859,7 +2867,8 @@ def _window_pins(port, layers, window, pins):
         k0 = math.ceil((lo - off) / p - 1e-9)
         k1 = math.floor((hi - off) / p + 1e-9)
         # usable tracks: in the window and off the partition PG stripe bands (PART_PG_BANDS)
-        A = [k for k in range(k0, k1 + 1) if not pg_blocked(ln, off + k * p)]
+        pgf = bool(port.get("pg_free"))     # QC-PHY-1 11-14 (COORD): full-area hard IP pins sit on the macro's own pins
+        A = [k for k in range(k0, k1 + 1) if pgf or not pg_blocked(ln, off + k * p)]
         m = len(A)
         if m < n:
             raise ValueError(f"port {port['id']}: {n} bits on {ln} need {n} tracks, window has {m} off the PG "
diff --git a/tools/die_plan/test_pg_free_full_area.py b/tools/die_plan/test_pg_free_full_area.py
new file mode 100644
index 0000000000..fcd1efaf38
--- /dev/null
+++ b/tools/die_plan/test_pg_free_full_area.py
@@ -0,0 +1,24 @@
+import schema as S
+
+LAYERS = {"M5": {"pitch_um": 0.048, "offset_um": 0.0, "dir": "V", "name": "M5"}}
+
+
+def _port(pg_free):
+    return dict(id="p", face="N", window_um=[0.0, 3.0], layers=["M5"], width=60, order="lsb_low",
+                **({"pg_free": True} if pg_free else {}))
+
+
+def test_usable_tracks_pg_free_counts_every_track():
+    L = LAYERS["M5"]
+    assert S.usable_tracks(L, "M5", 0.0, 3.0, pg_free=True) > S.usable_tracks(L, "M5", 0.0, 3.0)
+
+
+def test_window_pins_pg_free_places_pins_the_pg_keepout_refuses():
+    # 60 pins at the macro's 0.048 pitch fill a 3 um window: the PG stripe keep-out leaves only 52 tracks
+    try:
+        S._window_pins(_port(False), LAYERS, [0.0, 3.0], list(range(60)))
+        raise AssertionError("default must refuse (window has fewer PG-free tracks than pins)")
+    except ValueError as exc:
+        assert "off the PG" in str(exc)
+    pins = S._window_pins(_port(True), LAYERS, [0.0, 3.0], list(range(60)))
+    assert len({x[2] for x in pins}) == 60
-- 
