{
  "architecture": "deepseek-v41-rom-array",
  "description": "Reduced DeepSeek-V4.1-Flash hardwired decode core (ot_hdc_core_v41), one die of the ROM array.  The routed matrix engine and V4.1 units (activation quantiser, FP4 quantise-dequantise, block-dot lanes, top-16 select, Engram hash, softplus/sqrt) take their activity from the RTL simulation of rtl/test/tb_hdc_core_v41.sv (tools/rtl_hdc_v41_decode_campaign.py single step, position 7, token 3118), every register mapped by name onto its routed flop (RTL-name matching; the propagation error is measured on the Qwen core, which shares the matrix engine).  The step is 1,088,551 cycles, so activity is sampled uniformly: 1,000 cycles of every 10,000.",
  "output": "results/physical_abi3/asap7/signoff/v41_core_signoff.json",
  "scratch": "${OT_SIGNOFF_SCRATCH}",
  "blocks": {
    "v41_core": {
      "activity": {
        "bench": "rtl/test/tb_hdc_core_v41.sv",
        "bench_top": "tb_hdc_core_v41",
        "dut_module": "ot_hdc_core_v41",
        "rtl_from": "tools/rtl_hdc_v41_decode_campaign.py:RTL",
        "rtl": [],
        "include_dirs": [
          "rtl/hdc/v41",
          "rtl/hdc"
        ],
        "liberty": [
          "${HOME}/.local/opentallas-pdk-asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib",
          "${HOME}/.local/opentallas-pdk-asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib",
          "${HOME}/.local/opentallas-pdk-asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib",
          "${HOME}/.local/opentallas-pdk-asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
          "${HOME}/.local/opentallas-pdk-asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib"
        ],
        "prepare": [
          [
            "{python}",
            "tools/hdc_program_v41.py",
            "--out",
            "{work}/img"
          ]
        ],
        "plusargs": [
          "+DIR={work}/img"
        ],
        "plusargs_file": "{work}/img/run.args",
        "window": [
          0,
          1100000,
          10000,
          1000
        ],
        "scopes": {
          "matvec": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_me",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/core/wd",
            "netlist_prefix": "u_me.",
            "saif_top": "dut"
          },
          "actquant": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_qe.u_aq",
            "saif_top": "u_aq",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_actquant/wd"
          },
          "fp4qdq": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_qe.u_fq",
            "saif_top": "u_fq",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_fp4qdq/wd"
          },
          "blockdot_lane0": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_qe.g_lane[0].u_bd",
            "saif_top": "u_bd",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_blockdot/wd"
          },
          "blockdot_lane15": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_qe.g_lane[15].u_bd",
            "saif_top": "u_bd",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_blockdot/wd"
          },
          "select": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_xu.u_sel",
            "saif_top": "u_sel",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_select_k16/wd"
          },
          "engram_hash": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_xu.u_hash",
            "saif_top": "u_hash",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_engram_hash/wd"
          },
          "softplus": {
            "scope": "TOP.tb_hdc_core_v41.dut.u_su.u_sp",
            "saif_top": "u_sp",
            "map_netlist": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_softplus/wd"
          }
        },
        "half_period_ps": 450,
        "netlists": {},
        "engine": "verilator"
      },
      "analyses": [
        {
          "key": "v41_actquant",
          "routed": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_actquant/wd",
          "record": "${OT_SIGNOFF_ROUTES}/blocks/hdc__v41__ot_hdc_actquant/physical.json",
          "saif": "actquant",
          "saif_scope": "u_aq",
