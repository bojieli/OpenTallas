# Native commands only; each read evaluates included Tcl exactly once.
incr ::matrix_reads([sta::cmd_mode_name])
create_clock -name core -period 770 [get_ports clk]
set_input_delay 100 -clock core [get_ports {a[*]}]
set_output_delay 100 -clock core [get_ports {y[*]}]
set_load 80 [get_ports {y[0]}]
set_load -pin_load -min -rise 11 [get_ports {y[1]}]
set_load -pin_load -min -fall 12 [get_ports {y[1]}]
set_load -pin_load -max -rise 13 [get_ports {y[1]}]
set_load -pin_load -max -fall 14 [get_ports {y[1]}]
set_load -wire_load -min -rise 21 [get_ports {y[1]}]
set_load -wire_load -min -fall 22 [get_ports {y[1]}]
set_load -wire_load -max -rise 23 [get_ports {y[1]}]
set_load -wire_load -max -fall 24 [get_ports {y[1]}]
set_load -pin_load 0 [get_ports {y[2]}]
set_load -wire_load 9 [get_ports {y[2]}]
set_load 31 [get_ports {y[3] y[4]}]
set_port_fanout_number -min 3 [get_ports {y[0]}]
set_port_fanout_number -max 7 [get_ports {y[0]}]
set_load -min 41 [get_nets {y[5]}]
set_load -max -subtract_pin_load 43 [get_nets {y[5]}]
source /src/test/include.sdc
set ::scene_count([sta::cmd_mode_name]) [llength [get_scenes -modes [sta::cmd_mode_name] *]]
set_load [expr {50 + $::scene_count([sta::cmd_mode_name])}] [get_ports {y[7]}]
# Independent single entries let native serialization expose every rf/mm slot.
set_load -pin_load -rise -min 61 [get_ports {y[12]}]
set_load -wire_load -fall -min 62 [get_ports {y[13]}]
set_load -pin_load -rise -max 63 [get_ports {y[14]}]
set_load -wire_load -fall -max 64 [get_ports {y[15]}]
