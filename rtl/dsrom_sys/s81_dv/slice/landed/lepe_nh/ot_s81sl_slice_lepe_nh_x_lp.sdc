# GENERATED by tools/landed_parent/lp.py for ot_s81sl_slice_lepe_nh_x_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_K -period $ot_lp_per [get_ports ck_K]
set_clock_uncertainty -setup 60 [get_clocks {ck_K}]
set_clock_uncertainty -hold 25 [get_clocks {ck_K}]
# 1-bit reset runs S -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_K]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_K]
set_clock_uncertainty -setup 120 -from [get_clocks ck_K] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_K] -to [get_clocks core_clk]
# 3 landings (LANDING-CONTRACT L5): ring -> read multicycle -setup 2 -hold 3, window (2 - 4) T + t_hold < dL < 2 T - t_cq - t_setup
set ot_lp_lands {0 1 2}
set ot_lp_miss 0
foreach ot_ln $ot_lp_lands {
  set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w.*]
  set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r.*]
  if {[llength $ot_lf] == 0} { set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w/*] }
  if {[llength $ot_lt] == 0} { set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r/*] }
  if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { incr ot_lp_miss; continue }
  set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
  set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
}
puts "OT_LP_LAND_SDC [expr {[llength $ot_lp_lands] - $ot_lp_miss}] of [llength $ot_lp_lands] landings constrained"
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {tx0[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {tx1[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {rx0[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {rx1[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {tf[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_K [get_ports {fault}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_K}] }
set_case_analysis 0 [get_ports {ch_b}]   ;# identity strap
set_case_analysis 0 [get_ports {sid[*]}]   ;# identity strap
