# GENERATED by tools/landed_parent/lp.py for ot_s81sl_slice_c1x_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_L0 -period $ot_lp_per [get_ports ck_L0]
create_clock -name ck_L1 -period $ot_lp_per [get_ports ck_L1]
create_clock -name ck_L3 -period $ot_lp_per [get_ports ck_L3]
create_clock -name ck_L4 -period $ot_lp_per [get_ports ck_L4]
set_clock_uncertainty -setup 60 [get_clocks {ck_L0 ck_L1 ck_L3 ck_L4}]
set_clock_uncertainty -hold 25 [get_clocks {ck_L0 ck_L1 ck_L3 ck_L4}]
# 1-bit reset runs C -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_L0]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_L0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_L0] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_L0] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_L1]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_L1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_L1] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_L1] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_L3]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_L3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_L3] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_L3] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_L4]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_L4]
set_clock_uncertainty -setup 120 -from [get_clocks ck_L4] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_L4] -to [get_clocks core_clk]
# 8 landings (LANDING-CONTRACT L5): ring -> read multicycle -setup 2 -hold 3, window (2 - 4) T + t_hold < dL < 2 T - t_cq - t_setup
set ot_lp_lands {0 1 2 3 4 5 6 7}
set ot_lp_miss 0
foreach ot_ln $ot_lp_lands {
  set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w.*]
  set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r.*]
  if {[llength $ot_lf] == 0} { set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w/*] }
  if {[llength $ot_lt] == 0} { set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r/*] }
  if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { incr ot_lp_miss; continue }
  set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
  set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
}
puts "OT_LP_LAND_SDC [expr {[llength $ot_lp_lands] - $ot_lp_miss}] of [llength $ot_lp_lands] landings constrained"
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_L0 ck_L1 ck_L3 ck_L4}] }
set_case_analysis 0 [get_ports {sid[*]}]   ;# identity strap
