# GENERATED by tools/landed_parent/lp.py for ot_pdie_ucie_col (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_rck -period $ot_lp_per [get_ports ck_rck]
set_clock_uncertainty -setup 60 [get_clocks {ck_rck}]
set_clock_uncertainty -hold 25 [get_clocks {ck_rck}]
# regional_reset_ports: every region lands its own reset port; no cross-region reset hop
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_rck [get_ports {pma_rx[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_rck}] }
