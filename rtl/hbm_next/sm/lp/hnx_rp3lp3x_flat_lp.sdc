# GENERATED by tools/hbm_next/landed_parent/lp.py for hnx_rp3lp3x_flat_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_s -period $ot_lp_per [get_ports ck_s]
set_clock_uncertainty -setup 60 [get_clocks {ck_s}]
set_clock_uncertainty -hold 25 [get_clocks {ck_s}]
# 1-bit reset runs n -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_s]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_s]
set_clock_uncertainty -setup 120 -from [get_clocks ck_s] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_s] -to [get_clocks core_clk]
# 3 landings (LANDING-CONTRACT L5): ring -> read multicycle -setup 2 -hold 3, window (2 - 4) T + t_hold < dL < 2 T - t_cq - t_setup
set ot_lp_lands {0 1 2}
set ot_lp_miss 0
foreach ot_ln $ot_lp_lands {
  set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w.*]
  set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r.*]
  if {[llength $ot_lf] == 0} { set ot_lf [get_cells -quiet u_lpl_${ot_ln}_w/*] }
  if {[llength $ot_lt] == 0} { set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r/*] }
  if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { incr ot_lp_miss; continue }
  set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
  set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
}
puts "OT_LP_LAND_SDC [expr {[llength $ot_lp_lands] - $ot_lp_miss}] of [llength $ot_lp_lands] landings constrained"
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {xss_a1[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {xss_g1[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {xss_a2[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {xss_g2[*]}]
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {rin_s[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {rout_s[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_s [get_ports {gout[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_s}] }
