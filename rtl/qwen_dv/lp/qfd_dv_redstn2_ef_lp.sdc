# GENERATED by tools/landed_parent/lp.py for qfd_dv_redstn2_ef_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_r1 -period $ot_lp_per [get_ports ck_r1]
create_clock -name ck_r2 -period $ot_lp_per [get_ports ck_r2]
create_clock -name ck_r3 -period $ot_lp_per [get_ports ck_r3]
create_clock -name ck_r4 -period $ot_lp_per [get_ports ck_r4]
create_clock -name ck_r5 -period $ot_lp_per [get_ports ck_r5]
create_clock -name ck_r6 -period $ot_lp_per [get_ports ck_r6]
create_clock -name ck_r7 -period $ot_lp_per [get_ports ck_r7]
set_clock_uncertainty -setup 60 [get_clocks {ck_r1 ck_r2 ck_r3 ck_r4 ck_r5 ck_r6 ck_r7}]
set_clock_uncertainty -hold 25 [get_clocks {ck_r1 ck_r2 ck_r3 ck_r4 ck_r5 ck_r6 ck_r7}]
# 1-bit reset runs r0 -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r1]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r1] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r1] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r2]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r2] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r2] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r3]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r3] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r3] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r4]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r4]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r4] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r4] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r5]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r5]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r5] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r5] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r6]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r6]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r6] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r6] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_r7]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_r7]
set_clock_uncertainty -setup 120 -from [get_clocks ck_r7] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_r7] -to [get_clocks core_clk]
# 44 landings (LANDING-CONTRACT L5): ring -> read multicycle -setup 2 -hold 3, window (2 - 4) T + t_hold < dL < 2 T - t_cq - t_setup
set ot_lp_pairs {0 0 1 1 2 2 3 3 0 4 1 5 2 6 3 7 0 8 1 9 2 10 3 11 0 12 1 13 2 14 3 15 0 16 1 17 2 18 3 19 0 20 1 21 2 22 3 23 0 24 1 25 2 26 3 27 28 28 29 29 30 30 31 31 32 32 33 33 34 34 35 35 36 36 37 37 38 38 39 39 40 40 41 41 42 42 43 43}
set ot_lp_lands {}; foreach {ot_lw ot_ln} $ot_lp_pairs { lappend ot_lp_lands $ot_ln; set ot_lp_ring($ot_ln) $ot_lw }
set ot_lp_miss 0
foreach ot_ln $ot_lp_lands {
  set ot_lw $ot_lp_ring($ot_ln)
  set ot_lf [get_cells -quiet u_lpl_${ot_lw}_w.*]
  set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r.*]
  if {[llength $ot_lf] == 0} { set ot_lf [get_cells -quiet u_lpl_${ot_lw}_w/*] }
  if {[llength $ot_lt] == 0} { set ot_lt [get_cells -quiet u_lpl_${ot_ln}_r/*] }
  if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { incr ot_lp_miss; continue }
  set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
  set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
}
puts "OT_LP_LAND_SDC [expr {[llength $ot_lp_lands] - $ot_lp_miss}] of [llength $ot_lp_lands] landings constrained"
set_input_delay [expr {0.2 * $ot_lp_per}] -clock ck_r1 [get_ports {rs_s_lo_r1[*]}]
