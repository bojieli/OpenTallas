set_clock_uncertainty -setup 120 -from [get_clocks ck_sw] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_sw] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_sc]
