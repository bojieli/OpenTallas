create_clock -name ck_sw -period $ot_lp_per [get_ports ck_sw]
create_clock -name ck_sc -period $ot_lp_per [get_ports ck_sc]
create_clock -name ck_se -period $ot_lp_per [get_ports ck_se]
set_clock_uncertainty -setup 60 [get_clocks {ck_hd ck_ef ck_wf ck_nw ck_nc ck_ne ck_sw ck_sc ck_se}]
set_clock_uncertainty -hold 25 [get_clocks {ck_hd ck_ef ck_wf ck_nw ck_nc ck_ne ck_sw ck_sc ck_se}]
# 1-bit reset runs core -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_hd]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_hd]
