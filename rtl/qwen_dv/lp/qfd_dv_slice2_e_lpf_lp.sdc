# GENERATED by tools/landed_parent/lp.py for qfd_dv_slice2_e_lpf_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_hd -period $ot_lp_per [get_ports ck_hd]
create_clock -name ck_ef -period $ot_lp_per [get_ports ck_ef]
create_clock -name ck_wf -period $ot_lp_per [get_ports ck_wf]
create_clock -name ck_nw -period $ot_lp_per [get_ports ck_nw]
create_clock -name ck_nc -period $ot_lp_per [get_ports ck_nc]
