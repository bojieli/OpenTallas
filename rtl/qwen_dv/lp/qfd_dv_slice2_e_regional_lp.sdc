set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_sw [get_ports {cw_s0[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_sc [get_ports {cw_s1[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_sc [get_ports {cw_s2[*]}]
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_se [get_ports {cw_s3[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_hd ck_ef ck_wf ck_nw ck_nc ck_ne ck_sw ck_sc ck_se ck_su0 ck_su1 ck_su2 ck_su3 ck_su4 ck_su5 ck_su6 ck_su7}] }
