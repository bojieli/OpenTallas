`verilator_config
// Keep the array's replicated elements and arithmetic units as C++ classes
// (one per module, not one flattened copy per instance).
no_inline -module "ot_hdc_v41x_q4dot"
no_inline -module "ot_hdc_v41x_bmul"
no_inline -module "ot_hdc_fp32_add_fast"
no_inline -module "ot_hdc_v41x_idx_chunk"
no_inline -module "ot_hdc_v41x_idx_tail"
no_inline -module "ot_hdc_v41x_idx_engine"
no_inline -module "ot_hdc_v41x_idx_score_slice"
