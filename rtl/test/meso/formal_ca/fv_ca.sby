[tasks]
prove
reach
mut_k
mut_freerun
mut_noguard

[options]
prove: mode prove
mut_k: mode bmc
reach: mode bmc
reach: depth 300
mut_freerun: mode bmc
mut_noguard: mode bmc
mut_k: depth 700
mut_freerun: depth 700
mut_noguard: depth 700
multiclock on
aigsmt none

[engines]
prove: abc pdr
mut_k: abc bmc3
reach: abc bmc3
mut_freerun: abc bmc3
mut_noguard: abc bmc3

[script]
prove: read -formal -DOT_MESO_CA_FV ot_meso_fifo.sv ot_dp_clk_landing.sv ot_dp_clk_landing_ca.sv fv_ca.sv
reach: read -formal -DOT_MESO_CA_FV -DFV_REACH ot_meso_fifo.sv ot_dp_clk_landing.sv ot_dp_clk_landing_ca.sv fv_ca.sv
mut_k: read -formal -DOT_MESO_CA_FV -DOT_MESO_CA_MUTANT_K ot_meso_fifo.sv ot_dp_clk_landing.sv ot_dp_clk_landing_ca.sv fv_ca.sv
mut_freerun: read -formal -DOT_MESO_CA_FV -DOT_MESO_CA_MUTANT_FREERUN ot_meso_fifo.sv ot_dp_clk_landing.sv ot_dp_clk_landing_ca.sv fv_ca.sv
mut_noguard: read -formal -DOT_MESO_CA_FV -DOT_MESO_CA_MUTANT_NO_GUARD ot_meso_fifo.sv ot_dp_clk_landing.sv ot_dp_clk_landing_ca.sv fv_ca.sv
hierarchy -top fv_ca
setattr -mod -unset keep_hierarchy *
prep -top fv_ca

[files]
../../../common/ot_meso_fifo.sv
../../../common/ot_dp_clk_landing.sv
../../../common/ot_dp_clk_landing_ca.sv
fv_ca.sv
