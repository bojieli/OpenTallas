`verilator_config
// Keep the array's replicated elements and arithmetic units as C++ classes
// (one per module, not one flattened copy per instance).
no_inline -module "ot_hdc_v41x_q4dot_l"
no_inline -module "ot_hdc_v41x_bmul_l"
no_inline -module "ot_hdc_fp32_add_fast"
no_inline -module "ot_hdc_v41x_idx_chunk_l"
no_inline -module "ot_hdc_v41x_idx_tail_l"
no_inline -module "ot_hdc_v41x_idx_engine_l"
no_inline -module "ot_hdc_v41x_idx_score_slice_l"
