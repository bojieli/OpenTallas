`verilator_config
// XDIE-S81-2: keep each PHY / KP4 / link-layer / leg module ONE generated module (32-64 SerDes macros and lane legs in the
// co-sim; inlining them multiplies verilator_bin memory by the instance count).  As rtl/test/xdie_s81/xdie_s81.vlt + legs.
no_inline -module "ot_pdie_serdes"
no_inline -module "ot_s81_kp4_*"
no_inline -module "ot_s81ph_coll_lane"
no_inline -module "ot_s81ph_link_ep"
no_inline -module "ot_s81ph_link_gbx"
no_inline -module "ot_s81sl_lep_core"
no_inline -module "ot_s81sl_lep"
no_inline -module "ot_s81sl_rstop"
no_inline -module "ot_s81_land"
no_inline -module "ot_dvrly_st"
no_inline -module "xdie2_leg"
no_inline -module "xdie2_chan"
no_inline -module "xdie_s81_2_ep"
