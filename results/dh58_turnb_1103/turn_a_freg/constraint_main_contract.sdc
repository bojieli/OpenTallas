set cland_data_outputs [get_ports {t_o[*] rst_o_0 start_o_0 cland_fstart_out_t_o cland_up_ready_t_o cland_up_fault_t_o rst_start_raw_0 rst_start_raw_1 rst_start_raw_2}]
# GENERATED by tools/die_plan/gen.py phys: partition type hd_turn_a of die_plan s81_head.
# clock taps (R4 grid, one port per tap, local trees): clk clk_t1 clk_t2 clk_t3 clk_t4
create_clock -name clk -period 833.0000 [get_ports {clk clk_t1 clk_t2 clk_t3 clk_t4}]
# neighbour boundary flops run on the bound insertion (TT 450 ps here; FF 342 ps via the FF-only flow steps; ruling 9.7 / decision 5e): virtual IO clock
# PHY-edge clock (plan clock.edge_clocks): synchronous with clk, period 1 x T
create_clock -name fclk_in_t_i -period 833.0000 [get_ports fclk_in_t_i]
create_clock -name vclk -period 833.0000
set_clock_latency -source 450.0000 [get_clocks vclk]
# plan clock.tap_window (COORD 11:24): die tap-to-tap arrival window 30 ps on every real clock port, [-W, 0]; IO delays shifted to keep the seam contract (gen_phys.tap_window_ps)
set_clock_latency -source -early -clock clk -30.0000 [get_ports {clk clk_t1 clk_t2 clk_t3 clk_t4}]
set_clock_latency -source -late -clock clk 0.0000 [get_ports {clk clk_t1 clk_t2 clk_t3 clk_t4}]
# clock uncertainty: sign-off margin policy nominal (OWNER 12.24b/c 2026-10-31: nominal setup (setup clock uncertainty 0, hold 25 kept; legacy setup 60 = A/B only))
set_clock_uncertainty 0.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
# seam paths: uncertainty counted once per seam (COORD 16:58): 0.5 on each partition side
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 0.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 0.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [all_inputs -no_clocks]
set_input_delay -max 136.6000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk $cland_data_outputs
# ft slots: hop share 0.16 T at the face, the rest is the last station segment
set_input_delay -max 669.7200 -clock vclk [get_ports {t_i[*]}]
set_output_delay -max 133.2800 -clock vclk [get_ports {t_o[*]}]
set_input_delay -min -90.0000 -clock vclk $non_clk_in
set_output_delay -min 30.0000 -clock vclk $cland_data_outputs
# OWNER 10-25 option B: per-instance ID straps (plan id_straps), tied at the parent
set_false_path -from [get_ports {strap_ca_efall strap_ca_k_t_i strap_ca_pad}]
set_load 2 $cland_data_outputs
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
create_generated_clock -name fclk_out_t_o -master_clock clk -source [get_ports clk_t1] -divide_by 1 [get_ports fclk_out_t_o]
set_max_delay -ignore_clock_latency 416.5000 -from [get_clocks fclk_in_t_i] -to [get_clocks clk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks fclk_in_t_i] -to [get_clocks clk]
set_max_delay -ignore_clock_latency 416.5000 -from [get_clocks clk] -to [get_clocks fclk_in_t_i]
set_min_delay -ignore_clock_latency 0 -from [get_clocks clk] -to [get_clocks fclk_in_t_i]
# source-synchronous ring inputs (COORD 10-29 21:11): timed against their forwarded write clock, not vclk (landing_contract.ring_input_sdc)
# OT_FWD_RING_MIN 80.0000
# OT_FWD_RING_INPUTS fclk_in_t_i t_i[*] cland_dn_ready_t_i cland_dn_fault_t_i cland_fstart_in_t_i
set_input_delay -max 699.7200 -clock fclk_in_t_i [get_ports {t_i[*]}]
set_input_delay -min 80.0000 -clock fclk_in_t_i [get_ports {t_i[*]}]
set_input_delay -max 166.6000 -clock fclk_in_t_i [get_ports {cland_dn_ready_t_i}]
set_input_delay -min 80.0000 -clock fclk_in_t_i [get_ports {cland_dn_ready_t_i}]
set_input_delay -max 166.6000 -clock fclk_in_t_i [get_ports {cland_dn_fault_t_i}]
set_input_delay -min 80.0000 -clock fclk_in_t_i [get_ports {cland_dn_fault_t_i}]
set_input_delay -max 166.6000 -clock fclk_in_t_i [get_ports {cland_fstart_in_t_i}]
set_input_delay -min 80.0000 -clock fclk_in_t_i [get_ports {cland_fstart_in_t_i}]
