read_json /work/pre.json
select qkd_hr_core_prompt/t:ot_sram*
expose -evert
select *
memory_share
memory_map
rename qkd_hr_core_prompt gold
design -stash g
read_json /work/mut.json
select qkd_hr_core_prompt/t:ot_sram*
expose -evert
select *
memory_share
memory_map
rename qkd_hr_core_prompt gate
