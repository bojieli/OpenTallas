# QC-SU-F4-2 LEC: old (m2 view) vs new (column view) vm8x vmr / crh RTL, SRAMs as black boxes (cut points).
# Gold/gate SRAM instances keep their names; SRAM inputs are named nets (proven), SRAM rd_out = cut points (unprovable
# free variables by construction, listed). MIF=0 (canonical).
read_verilog -sv -DSYNTHESIS /lec/vm8x_old_suffixed.sv
read_verilog -sv /lec/bb_m2.v /lec/bb_ns.v /lec/bb_128.v /lec/bb_256.v
hierarchy -top TOP_O
proc; flatten; opt_clean; memory -nomap; opt -fast
rename TOP_O gold
design -stash gold
read_verilog -sv -DSYNTHESIS /lec/vm8x_new.sv
read_verilog -sv /lec/bb_m2.v /lec/bb_ns.v /lec/bb_128.v /lec/bb_256.v
hierarchy -top TOP_N
proc; flatten; opt_clean; memory -nomap; opt -fast
rename TOP_N gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
async2sync
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status
