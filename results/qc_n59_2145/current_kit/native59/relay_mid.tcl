# GENERATED by tools/die_plan/gen.py phys (sourced at the end of face_flops.tcl, PRE_GLOBAL_PLACE): soft relay stations
# of a partition with hard cores sit ON the straight line between their fixed source and fixed sink, at L*j/(n+1).
# Why (S81-P8 10-23, S81 G3 frame kits): a wirelength-driven GPL put each single relay (ot_s81_rly u_y_*) next to its
# source macro, so the hop to the sink macro was 0.8-1.0 mm (1.2-2.5k register-to-register connections > 750 um per
# kit; COORD: internal hops > 750 need a stage).  At the midpoint the same relay gives two ~450-um hops.
# A relay = the flops whose name matches $::env(OT_RELAY_MID_RE) (group = first capture).  Its sources / sinks are traced
# through <= 4 buffers/inverters to FIXED points (hard-core pins, ports, FIRM face flops) or to another relay group
# (a chain: stage j of n between the head's fixed sources and the tail's fixed sinks).  Groups whose endpoints are not
# all fixed, or whose span is < OT_RELAY_MID_MIN_UM (200), are left to GPL.  Each group is placed FIRM as one compact
# cluster outside every hard-core halo; face_flops_release.tcl releases them (ot_relay_mid.txt) before DPL.
uplevel #0 {
set rm_blk [ord::get_db_block]
set rm_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set rm_re $::env(OT_RELAY_MID_RE)
set rm_min [expr {[info exists ::env(OT_RELAY_MID_MIN_UM)] ? $::env(OT_RELAY_MID_MIN_UM) : 200.0}]
set rm_core [$rm_blk getCoreArea]
set rm_x0 [$rm_core xMin]; set rm_y0 [$rm_core yMin]; set rm_x1 [$rm_core xMax]; set rm_y1 [$rm_core yMax]
set rm_rows [$rm_blk getRows]
set rm_sw [[[lindex $rm_rows 0] getSite] getWidth]
set rm_rh [[[lindex $rm_rows 0] getSite] getHeight]
set rm_orient {}
foreach r $rm_rows { dict set rm_orient [lindex [$r getOrigin] 1] [$r getOrient] }
set rm_halo [expr {int(8.64 * $rm_dbu)}]
set rm_mac {}
foreach i [$rm_blk getInsts] {
  if {[[$i getMaster] isBlock]} {
    set b [$i getBBox]
    lappend rm_mac [list [expr {[$b xMin]-$rm_halo}] [expr {[$b yMin]-$rm_halo}] [expr {[$b xMax]+$rm_halo}] [expr {[$b yMax]+$rm_halo}]]
  }
}
set rm_grp {}
set rm_of {}
foreach i [$rm_blk getInsts] {
  set m [$i getMaster]
  if {[$m isBlock] || ![string match "*DFF*" [$m getName]]} continue
  if {![regexp $rm_re [string map {\\ {}} [$i getName]] -> pfx]} continue
  if {[$i getPlacementStatus] in {FIRM LOCKED COVER}} continue
  dict lappend rm_grp $pfx $i
  dict set rm_of [$i getName] $pfx
}
proc rm_isbuf {inst} {
  set m [[$inst getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "INV*" $m] || [string match "HB*" $m]}]
}
proc rm_ctr {b} { return [list [expr {([$b xMin] + [$b xMax]) / 2}] [expr {([$b yMin] + [$b yMax]) / 2}]] }
proc rm_sig {inst io} {
  set r {}
  foreach it [$inst getITerms] {
    if {[$it getSigType] ne "SIGNAL"} continue
    if {[[$it getMTerm] getIoType] eq $io} { lappend r $it }
  }
  return $r
}
# endpoint of an iterm's instance: {P x y} fixed point, {G pfx} relay group, or {} (soft logic)
proc rm_end {it} {
  global rm_of
  set inst [$it getInst]
  if {[[$inst getMaster] isBlock]} { return [concat P [rm_ctr [$it getBBox]]] }
  if {[dict exists $rm_of [$inst getName]]} { return [list G [dict get $rm_of [$inst getName]]] }
  if {[$inst getPlacementStatus] in {FIRM LOCKED}} { return [concat P [rm_ctr [$inst getBBox]]] }
  return {}
}
proc rm_drv {net depth} {
  if {$net eq "NULL" || $net eq "" || [$net getSigType] ne "SIGNAL"} { return {} }
  foreach bt [$net getBTerms] { return [list [concat P [rm_ctr [$bt getBBox]]]] }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "OUTPUT"} continue
    set inst [$it getInst]
    if {[string match "TIE*" [[$inst getMaster] getName]]} { return {} }
    if {$depth < 4 && ![[$inst getMaster] isBlock] && [rm_isbuf $inst]} {
      foreach i2 [rm_sig $inst INPUT] { return [rm_drv [$i2 getNet] [expr {$depth + 1}]] }
    }
    set e [rm_end $it]
    return [expr {$e eq {} ? [list X] : [list $e]}]
  }
  return {}
}
# a 2-input gate on the way to the sink (the seam writer's chunk clear: q = rq ? i : 0, ot_pl_seam_w_pl) is part of the
# data path, not an endpoint (S81 g3k3 review 10-24: h10_r2 u_y_rt_24b_0..sk -> u_lpl_8_w -> S face flop was left to GPL,
# 4 stages bunched at the source, last hop 894 um); only on the load side, where the gated input is the traced one
proc rm_isgate {inst} {
  return [regexp {^(AND2|NAND2|OR2|NOR2)x} [[$inst getMaster] getName]]
}
proc rm_loads {net depth} {
  set r {}
  if {$net eq "NULL" || $net eq "" || [$net getSigType] ne "SIGNAL"} { return $r }
  foreach bt [$net getBTerms] { lappend r [concat P [rm_ctr [$bt getBBox]]] }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set inst [$it getInst]
    # flop async set/reset / clock pins are not data sinks (a relay's reset-pin register drives its own RESETNs)
    if {[string match "*DFF*" [[$inst getMaster] getName]] && [[$it getMTerm] getName] ne "D"} continue
    if {$depth < 4 && ![[$inst getMaster] isBlock] && ([rm_isbuf $inst] || [rm_isgate $inst])} {
      foreach o [rm_sig $inst OUTPUT] { set r [concat $r [rm_loads [$o getNet] [expr {$depth + 1}]]] }
      continue
    }
    set e [rm_end $it]
    lappend r [expr {$e eq {} ? "X" : $e}]
  }
  return $r
}
# per group: fixed source / sink centroids, source / sink groups, soft (X) endpoints
set rm_info {}
dict for {g insts} $rm_grp {
  set sp {}; set sg {}; set kp {}; set kg {}; set soft 0
  foreach i $insts {
    foreach d [rm_sig $i INPUT] {
      if {[[$d getMTerm] getName] ne "D"} continue
      foreach e [rm_drv [$d getNet] 0] {
        switch [lindex $e 0] { P { lappend sp [lrange $e 1 2] } G { if {[lindex $e 1] ne $g} { dict set sg [lindex $e 1] 1 } } default { incr soft } }
      }
    }
    foreach q [rm_sig $i OUTPUT] {
      foreach e [rm_loads [$q getNet] 0] {
        switch [lindex $e 0] { P { lappend kp [lrange $e 1 2] } G { if {[lindex $e 1] ne $g} { dict set kg [lindex $e 1] 1 } } default { incr soft } }
      }
    }
  }
  dict set rm_info $g [list $sp [dict keys $sg] $kp [dict keys $kg] $soft]
}
proc rm_cent {pts} {
  set x 0; set y 0
  foreach p $pts { set x [expr {$x + [lindex $p 0]}]; set y [expr {$y + [lindex $p 1]}] }
  set n [llength $pts]
  return [list [expr {$x / $n}] [expr {$y / $n}]]
}
# chains: head = fixed sources only; follow the unique successor group (whose unique predecessor is this group)
set rm_station {}
dict for {g inf} $rm_info {
  lassign $inf sp sg kp kg soft
  # a few soft endpoints (<= 2% of the fixed ones: status / debug taps) do not move the station
  if {$soft > 0.02 * ([llength $sp] + [llength $kp]) || [llength $sp] == 0 || [llength $sg] > 0} continue
  set chain [list $g]; set cur $g
  while {1} {
    lassign [dict get $rm_info $cur] csp csg ckp ckg csoft
    if {[llength $ckp] > 0 && [llength $ckg] == 0} break
    if {[llength $ckg] != 1 || [llength $ckp] > 0} { set chain {}; break }
    set nx [lindex $ckg 0]
    lassign [dict get $rm_info $nx] nsp nsg nkp nkg nsoft
    if {$nsoft > 0.02 * ([llength $nsp] + [llength $nkp] + 1) || [llength $nsp] > 0 || [llength $nsg] != 1 || [lsearch $chain $nx] >= 0} { set chain {}; break }
    lappend chain $nx; set cur $nx
  }
  if {$chain eq {}} continue
  lassign [rm_cent $sp] ax ay
  lassign [rm_cent [lindex [dict get $rm_info [lindex $chain end]] 2]] bx by
  if {abs($bx - $ax) + abs($by - $ay) < $rm_min * $rm_dbu} continue
  set n [llength $chain]
  set j 0
  foreach c $chain {
    incr j
    dict set rm_station $c [list [expr {int($ax + ($bx - $ax) * $j / ($n + 1.0))}] [expr {int($ay + ($by - $ay) * $j / ($n + 1.0))}]]
  }
}
# place: nearest point outside every halo (rings of 2.16 um), compact cluster, clusters at one spot stack upward
proc rm_free {x y} {
  global rm_mac rm_x0 rm_y0 rm_x1 rm_y1
  if {$x < $rm_x0 || $y < $rm_y0 || $x > $rm_x1 || $y > $rm_y1} { return 0 }
  foreach m $rm_mac { lassign $m a b c d; if {$x > $a && $x < $c && $y > $b && $y < $d} { return 0 } }
  return 1
}
set rm_out [open $::env(RESULTS_DIR)/ot_relay_mid.txt w]
set rm_log [open $::env(RESULTS_DIR)/ot_relay_mid_stations.txt w]
set rm_stack {}
set rm_n 0
set rm_step [expr {int(2.16 * $rm_dbu)}]
dict for {g st} $rm_station {
  lassign $st x y
  if {![rm_free $x $y]} {
    set best {}
    for {set r 1} {$r < 400 && $best eq {}} {incr r} {
      set d [expr {$r * $rm_step}]
      foreach {dx dy} [list 0 $d 0 -$d $d 0 -$d 0 $d $d -$d $d $d -$d -$d -$d] {
        if {[rm_free [expr {$x + $dx}] [expr {$y + $dy}]]} { set best [list [expr {$x + $dx}] [expr {$y + $dy}]]; break }
      }
    }
    if {$best ne {}} { lassign $best x y }
  }
  set key "[expr {$x / (20*$rm_dbu)}],[expr {$y / (20*$rm_dbu)}]"
  set off [expr {[dict exists $rm_stack $key] ? [dict get $rm_stack $key] : 0}]
  set cells [dict get $rm_grp $g]
  set nc [llength $cells]
  set ncol [expr {max(1, int(ceil(sqrt($nc * 4.0))))}]
  set pitch [expr {$rm_sw * 24}]
  set k 0
  foreach c $cells {
    set cx [expr {$x + ($k % $ncol) * $pitch - ($ncol * $pitch) / 2}]
    set cy [expr {$y + ($off + $k / $ncol) * $rm_rh}]
    set cx [expr {$rm_x0 + (($cx - $rm_x0) / $rm_sw) * $rm_sw}]
    set cy [expr {$rm_y0 + (($cy - $rm_y0) / $rm_rh) * $rm_rh}]
    set cx [expr {min(max($cx, $rm_x0), $rm_x1 - [[$c getMaster] getWidth])}]
    set cy [expr {min(max($cy, $rm_y0), $rm_y1 - $rm_rh)}]
    $c setLocation $cx $cy
    if {[dict exists $rm_orient $cy]} { $c setOrient [dict get $rm_orient $cy] }
    $c setPlacementStatus FIRM
    puts $rm_out [$c getName]
    incr k; incr rm_n
  }
  dict set rm_stack $key [expr {$off + int(ceil(double($nc) / $ncol)) + 1}]
  puts $rm_log "$g\t[expr {$x / double($rm_dbu)}]\t[expr {$y / double($rm_dbu)}]\t$nc"
}
close $rm_out; close $rm_log
puts "OT_RELAY_MID placed $rm_n relay flops of [dict size $rm_station] stations ([dict size $rm_grp] relay groups) FIRM on their source-sink lines"
}
