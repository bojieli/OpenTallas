# GENERATED by tools/die_plan/gen.py phys: partition type native59 of die_plan qwen_compute.
# clock taps (R4 grid, one port per tap, local trees): clk clk_t1 clk_t2 clk_t3
create_clock -name clk -period 833.0000 [get_ports {clk clk_t1 clk_t2 clk_t3}]
# neighbour boundary flops run on the bound insertion (TT 250 ps here; FF 202.5 ps via the FF-only flow steps; ruling 9.7 / decision 5e): virtual IO clock
create_clock -name vclk -period 833.0000
set_clock_latency -source 250.0000 [get_clocks vclk]
set_clock_uncertainty 60.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
# seam paths: uncertainty counted once per seam (COORD 16:58): 0.5 on each partition side
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 30.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 30.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [all_inputs -no_clocks]
set_input_delay -max 166.6000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk [all_outputs]
# ft slots: hop share 0.08 T at the face, the rest is the last station segment
set_input_delay -max 766.3600 -clock vclk [get_ports {ctx_x_ctx_x_i[*] dh_user_dh_user_i[*] seq_dh_dh_i[*] tt_fab_fab_i[*] tt_kok_kok_i[*] tt_kwd_kwd_i[*] tt_pw_pw_i[*] cal_descriptor_obs_seq_descriptor_obs_i[*] cal_image_ready_seq_cfg_image_ready_i[*] cal_program_obs_seq_program_obs_i[*] command_stage_tt_command_stage_i[*] control_stores_ready_tt_control_stores_ready_i[*] dc_seq_dc_i[*] emb_start_core_start_i[*] emb_token_core_token_i[*] layer_context_v_tt_layer_context_v_i[*] native_pos_tt_native_pos_i[*] native_tok_tt_native_tok_i[*] program_obs_tt_program_obs_i[*] fltt_i[*] mufl_i[*]}]
set_output_delay -max 66.6400 -clock vclk [get_ports {ctx_x_ctx_x_o[*] dh_user_dh_user_o[*] seq_dh_dh_o[*] tt_fab_fab_o[*] tt_kok_kok_o[*] tt_kwd_kwd_o[*] tt_pw_pw_o[*] cal_descriptor_obs_seq_descriptor_obs_o[*] cal_image_ready_seq_cfg_image_ready_o[*] cal_program_obs_seq_program_obs_o[*] command_stage_tt_command_stage_o[*] control_stores_ready_tt_control_stores_ready_o[*] dc_seq_dc_o[*] emb_start_core_start_o[*] emb_token_core_token_o[*] layer_context_v_tt_layer_context_v_o[*] native_pos_tt_native_pos_o[*] native_tok_tt_native_tok_o[*] program_obs_tt_program_obs_o[*] fltt_o[*] mufl_o[*]}]
set_input_delay -min -40.0000 -clock vclk $non_clk_in
set_output_delay -min 0.0000 -clock vclk [all_outputs]
set_load 2 [all_outputs]
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
