# GENERATED by tools/die_plan/reset_tree.py (OWNER RESET RULE 10-24): FIRM sites of the reset entry stage (root
# synchroniser u_rst_root or synchronous pin register u_rst_in, at the arst_n pin) and of the synchronous reset relays
# u_rrl_<k> (hops <= 405 um).  Sourced inside face_flops.tcl (PRE_GLOBAL_PLACE) before reset_taps.tcl; uses its
# ff_put_near / ff_blk / ff_dbu.  Listed in ot_face_flops.txt so face_flops_release.tcl hands them to DPL.
set rtr_n 0; set rtr_miss {}; set rtr_at {}; set rtr_qnets {}
set rtr_fh [open $::env(RESULTS_DIR)/ot_face_flops.txt a]
proc rtr_place {key pat x y tag} {
  global ff_blk ff_dbu rtr_n rtr_miss rtr_fh rtr_at rtr_qnets
  set hit 0
  foreach i [$ff_blk getInsts] {
    set nm [$i getName]
    if {![string match $pat $nm]} continue
    if {![string match "*DFF*" [[$i getMaster] getName]]} continue
    set got [ff_put_near $i [expr {round($x * $ff_dbu)}] [expr {round($y * $ff_dbu)}]]
    if {$got eq ""} { lappend rtr_miss $nm; continue }
    puts $rtr_fh "$nm\t$tag\t[expr {[lindex $got 0] / double($ff_dbu)}]\t[expr {[lindex $got 1] / double($ff_dbu)}]\t-"
    dict set rtr_at $key $got
    set qnets {}
    foreach it [$i getITerms] {
      if {[[$it getMTerm] getIoType] eq "OUTPUT" && [$it getNet] ne "NULL"} { lappend qnets [$it getNet] }
    }
    if {[llength $qnets] == 1} { dict set rtr_qnets $key [lindex $qnets 0] }
    incr rtr_n; incr hit
  }
  if {!$hit} { lappend rtr_miss $pat }
}

rtr_place rst_root_n {*u_rst_in[./]*} 768.480 388.768 rentry
rtr_place run_root {*u_run_in[./]*} 768.480 390.432 sentry
rtr_place rst_rl_0 {*u_rrl_0[./]*} 583.200 362.880 rrl:tap1
rtr_place rn_rst_rl_0 {*u_srl_0[./]*} 583.200 362.880 rrl:tap1
rtr_place rst_rl_1 {*u_rrl_1[./]*} 583.200 362.880 rrl:pad2
rtr_place rn_rst_rl_1 {*u_srl_1[./]*} 583.200 362.880 rrl:pad2
rtr_place rst_n_t3 {*u_rrl_2[./]*} 583.200 362.880 rrl:pad3
rtr_place rst_rl_3 {*u_rrl_3[./]*} 583.200 129.600 rrl:pad2
rtr_place rn_rst_rl_3 {*u_srl_3[./]*} 583.200 129.600 rrl:pad2
rtr_place rst_n_t1 {*u_rrl_4[./]*} 583.200 129.600 rrl:tap3
rtr_place rst_rl_5 {*u_rrl_5[./]*} 272.160 362.880 rrl:wire2
rtr_place rn_rst_rl_5 {*u_srl_5[./]*} 272.160 362.880 rrl:wire2
rtr_place rst_n_t0 {*u_rrl_6[./]*} 194.400 129.600 rrl:tap3
rtr_place rst_rl_7 {*u_rrl_7[./]*} 468.496 388.768 rrl:pad1
rtr_place rn_rst_rl_7 {*u_srl_7[./]*} 468.496 388.768 rrl:pad1
rtr_place rst_rl_8 {*u_rrl_8[./]*} 468.496 388.768 rrl:wire2
rtr_place rn_rst_rl_8 {*u_srl_8[./]*} 468.496 388.768 rrl:wire2
rtr_place rst_n_t2 {*u_rrl_9[./]*} 194.400 362.880 rrl:tap3
close $rtr_fh
# placed hop check (driver relay -> relay, Manhattan between placed sites)
set rtr_hmax 0; set rtr_hbad 0; set rtr_lim [expr {405 * $ff_dbu}]
foreach {q d} {rst_rl_0 rst_root_n rn_rst_rl_0 run_root rst_rl_1 rst_rl_0 rn_rst_rl_1 rn_rst_rl_0 rst_n_t3 rst_rl_1 rst_rl_3 rst_rl_0 rn_rst_rl_3 rn_rst_rl_0 rst_n_t1 rst_rl_3 rst_rl_5 rst_rl_0 rn_rst_rl_5 rn_rst_rl_0 rst_n_t0 rst_rl_5 rst_rl_7 rst_root_n rn_rst_rl_7 run_root rst_rl_8 rst_rl_7 rn_rst_rl_8 rn_rst_rl_7 rst_n_t2 rst_rl_8 } {
  if {![dict exists $rtr_at $q] || ![dict exists $rtr_at $d]} continue
  lassign [dict get $rtr_at $q] x1 y1; lassign [dict get $rtr_at $d] x0 y0
  set h [expr {abs($x1 - $x0) + abs($y1 - $y0)}]
  if {$h > $rtr_hmax} { set rtr_hmax $h }
  if {$h > $rtr_lim} { incr rtr_hbad }
}
set rtr_v [expr {($rtr_hbad || [llength $rtr_miss]) ? "FAIL" : "PASS"}]
puts "OT_RESET_TREE entry relayed depth 3 (6 tree + 4 pad relays, planned max hop 311.0 um): placed $rtr_n flops FIRM, placed max hop [format %.1f [expr {$rtr_hmax / double($ff_dbu)}]] um, $rtr_hbad hops > 405 um: $rtr_v (missing: [llength $rtr_miss] $rtr_miss)"
