read_verilog -sv -defer /rtl/kit_cells.sv /rtl/bind_cells_kit.sv /rtl/ot_reset_sync.sv /rtl/qfd_native59_command_context.sv /rtl/qfd_native59_dv_headprep_obs1.sv /rtl/qfd_native59_mctx_helpers.sv /rtl/qfd_native59_q_export_control.sv /rtl/qfd_native59_record_endpoint.sv /rtl/qfd_native59_static_service_obs1.sv /rtl/qfd_status_obs_hold_chunk.sv /rtl/qkd_native_attention_record.sv /rtl/ot_qfd_su_kv_static_posted.sv /rtl/qfd_kvn_static_transport.sv /e/new/qfd_native59_svc_obs1.sv
