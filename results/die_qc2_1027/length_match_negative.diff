+def leg_points(p, c, pad, site=None, w=5.0):
+    """polyline p -> c whose Manhattan length is |p c| + pad: a U-jog (depth pad/2, width 2w) at the leg middle,
+    perpendicular to the leg's long axis, on the side whose far corner needs the smaller legal-site move."""
+    p, c = (float(p[0]), float(p[1])), (float(c[0]), float(c[1]))
+    if pad <= 0:
+        return [p, c]
+    h = pad / 2.0
+    if abs(c[0] - p[0]) >= abs(c[1] - p[1]):            # horizontal leg: vertical jog at x = mid
+        mx, sx = (p[0] + c[0]) / 2, (1.0 if c[0] >= p[0] else -1.0)
+        opts = [[p, (mx - sx * w, p[1]), (mx - sx * w, p[1] + s_ * h), (mx + sx * w, p[1] + s_ * h), (mx + sx * w, p[1]), c]
+                for s_ in (1.0, -1.0)]
+    else:
+        my, sy = (p[1] + c[1]) / 2, (1.0 if c[1] >= p[1] else -1.0)
+        opts = [[p, (p[0], my - sy * w), (p[0] + s_ * h, my - sy * w), (p[0] + s_ * h, my + sy * w), (p[0], my + sy * w), c]
+                for s_ in (1.0, -1.0)]
+    if site is not None:
+        def cost(o):
+            return sum(0.0 if site.legal(q) else _man(q, site.nearest(q)) for q in o[2:4])
+        opts.sort(key=cost)
+    return opts[0]
+
