+def _toy_nodes():
+    # root 0 at (0,0) -> kids 1 (100,0) and 2 (-300,0) [kid 2 slid farther]; leaves carry one tap each at their node
+    n = {0: dict(x=0.0, y=0.0, parent=None, level=0, kids=[1, 2], taps=[]),
+         1: dict(x=100.0, y=0.0, parent=0, level=1, kids=[], taps=[("p", "a", 100.0, 50.0)]),
+         2: dict(x=-300.0, y=0.0, parent=0, level=1, kids=[], taps=[("p", "b", -300.0, 10.0)])}
+    return n
+
+
+def test_length_match_pads_the_shorter_sibling_to_equal_root_to_leaf_length():
+    n = _toy_nodes()
+    info = D.length_match(n)
+    # down lengths: kid1 100 + 50 = 150, kid2 300 + 10 = 310 -> kid1 leg padded by 160
+    assert n[1]["pad_um"] == 160.0 and n[2]["pad_um"] == 0.0
+    assert info["legs"] == 1 and info["pad_um_total"] == 160.0 and info["down_len_root_um"] == 310.0
+
+
+def test_length_match_handles_corner_nodes_on_the_same_level():
+    n = {0: dict(x=0.0, y=0.0, parent=None, level=0, kids=[1, 3], taps=[]),
+         1: dict(x=200.0, y=0.0, parent=0, level=1, kids=[2], taps=[], corner=True),
+         2: dict(x=200.0, y=100.0, parent=1, level=1, kids=[], taps=[("p", "a", 200.0, 100.0)]),
+         3: dict(x=-50.0, y=0.0, parent=0, level=1, kids=[], taps=[("p", "b", -50.0, 0.0)])}
+    D.length_match(n)
+    assert n[3]["pad_um"] == 250.0 and n[1]["pad_um"] == 0.0 and n[2]["pad_um"] == 0.0
+
