+def length_match(nodes, err=None, inside=None):
+    """DIE-QC-2 opt-in (--tree-length-match, slice-spine path): DME-style equal-length construction AFTER the site
+    pass.  Legal-site moves of blocked nodes make sibling root->leaf lengths unequal (QC r250 routed tree: up to 783 um
+    inside a std partition, 1,518 um in W5; the ideal req_xy tree has 0).  Bottom-up, each node's down-length
+    D(n) = max_k(|n k| + pad_k + D(k)) (a leaf: its longest leaf->tap leg); every shorter kid leg gets
+    pad_k = D(n) - |n k| - D(k) um of extra wire, drawn as a U-jog at the leg middle (tree_netlist).  Plan geometry
+    only (no measured value); leaf->tap legs are not padded.
+    err {node: um}: realized-minus-drawn leg length from the previous placement (repeaters snapped to legal sites),
+    so the pads close on the REALIZED lengths (clock_kit iterates).  inside: nodes whose incoming leg may be padded
+    (below a region root: cross-region phase is absorbed by the count-aligned crossings, so feeds stay unpadded).
+    -> dict(pad_um_total, legs, max_pad_um)"""
+    err = err or {}
+    D, order = {}, [i for i, nd in nodes.items() if nd["parent"] is None]
+    for i in order:                                  # BFS (corner nodes share their child's level)
+        order.extend(nodes[i]["kids"])
+    for i in reversed(order):
+        nd = nodes[i]
+        tl = [abs(t[2] - nd["x"]) + abs(t[3] - nd["y"]) for t in nd["taps"]]
+        kl = {k: abs(nodes[k]["x"] - nd["x"]) + abs(nodes[k]["y"] - nd["y"]) + err.get(k, 0.0) + D[k]
+              for k in nd["kids"]}
+        free = [k for k in nd["kids"] if inside is None or k in inside]
+        fixed = [kl[k] for k in nd["kids"] if k not in free]
+        D[i] = max(tl + list(kl.values()), default=0.0)
+        for k, v in kl.items():
+            nodes[k]["pad_um"] = round(D[i] - v, 3) if (k in free and D[i] - v > 1.0) else 0.0
+        if fixed:                     # unpadded feeds: D is the longest branch (no balance across regions)
+            D[i] = max([D[i]] + fixed)
+    pads = [nd["pad_um"] for nd in nodes.values() if nd.get("pad_um", 0.0) > 0]
+    return dict(pad_um_total=round(sum(pads), 1), legs=len(pads), max_pad_um=round(max(pads, default=0.0), 1),
+                down_len_root_um=round(D[min(nodes)], 1))
+
