read_verilog -sv old.sv
hierarchy -top qkd_kv_hbm_elastic_front_mc
proc; setattr -mod -unset keep_hierarchy *; flatten; memory -nomap; memory_map; opt_clean; async2sync
rename qkd_kv_hbm_elastic_front_mc gold
design -stash gold
read_verilog -sv new.sv
hierarchy -top qkd_kv_hbm_elastic_front_mc
proc; setattr -mod -unset keep_hierarchy *; flatten; memory -nomap; memory_map; opt_clean; async2sync
rename qkd_kv_hbm_elastic_front_mc gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate eq
hierarchy -top eq
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
