# GENERATED by tools/die_plan/gen.py phys: partition type coll_ftc of die_plan qwen_compute.
# clock taps (R4 grid, one port per tap, local trees): clk clk_t1 clk_t2 clk_t3 clk_t4 clk_t5 clk_t6 clk_t7 clk_t8 clk_t9 clk_t10 clk_t11 clk_t12 clk_t13 clk_t14 clk_t15 clk_t16 clk_t17 clk_t18 clk_t19 clk_t20 clk_t21
create_clock -name clk -period 833.0000 [get_ports {clk clk_t1 clk_t2 clk_t3 clk_t4 clk_t5 clk_t6 clk_t7 clk_t8 clk_t9 clk_t10 clk_t11 clk_t12 clk_t13 clk_t14 clk_t15 clk_t16 clk_t17 clk_t18 clk_t19 clk_t20 clk_t21}]
# neighbour boundary flops run on the bound insertion (TT 250 ps here; FF 202.5 ps via the FF-only flow steps; ruling 9.7 / decision 5e): virtual IO clock
create_clock -name vclk -period 833.0000
set_clock_latency -source 250.0000 [get_clocks vclk]
set_clock_uncertainty 60.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
# seam paths: uncertainty counted once per seam (COORD 16:58): 0.5 on each partition side
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 30.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 30.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [all_inputs -no_clocks]
set_input_delay -max 166.6000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk [all_outputs]
# ft slots: hop share 0.08 T at the face, the rest is the last station segment
set_input_delay -max 766.3600 -clock vclk [get_ports {ag_wo_ag5_i[*] ard_wo_in_data_i[*] arl_wo_in_last_i[*] arm_wo_in_mode_i[*] art_wo_in_tag_i[*] arv_wo_in_valid_i[*] ccm_wo_cmd_mode_i[*] cct_wo_cmd_tag_i[*] ccv_wo_cmd_v_i[*] ccw_wo_cmd_words_i[*] dd_wo_dd_i_i[*] ss_wo_ss5_i[*] out_data_rd_wi_i[*] out_err_re_wi_i[*] out_last_rl_wi_i[*] out_rank_rr_wi_i[*] out_valid_rv_wi_i[*] dr_o_dr_wi_i[*] cmd_cmd_wi_i[*] hr_hr_wi_i[*] tl_st_wi_i[*] table_req_treq_wi_i[*] crec_tx_s0_i[*] crec_rx_s0_i[*] fltk_i[*] fltv_i[*]}]
set_output_delay -max 66.6400 -clock vclk [get_ports {ag_wo_ag5_o[*] ard_wo_in_data_o[*] arl_wo_in_last_o[*] arm_wo_in_mode_o[*] art_wo_in_tag_o[*] arv_wo_in_valid_o[*] ccm_wo_cmd_mode_o[*] cct_wo_cmd_tag_o[*] ccv_wo_cmd_v_o[*] ccw_wo_cmd_words_o[*] dd_wo_dd_i_o[*] ss_wo_ss5_o[*] out_data_rd_wi_o[*] out_err_re_wi_o[*] out_last_rl_wi_o[*] out_rank_rr_wi_o[*] out_valid_rv_wi_o[*] dr_o_dr_wi_o[*] cmd_cmd_wi_o[*] hr_hr_wi_o[*] tl_st_wi_o[*] table_req_treq_wi_o[*] crec_tx_s0_o[*] crec_rx_s0_o[*] fltk_o[*] fltv_o[*]}]
set_input_delay -min -40.0000 -clock vclk $non_clk_in
# HOLD-REPAIR plan_demand: sender guarantee - plan seam hold demand (-66 ps vs vclk)
set_input_delay -min -66.0000 -clock vclk [get_ports {ag_wo_ag5_i[*] ard_wo_in_data_i[*] art_wo_in_tag_i[*] cct_wo_cmd_tag_i[*] ccw_wo_cmd_words_i[*] cmd_cmd_wi_i[*] crec_rx_s0_i[*] crec_tx_s0_i[*] dd_wo_dd_i_i[*] dr_o_dr_wi_i[*] fltv_i[*] hr_hr_wi_i[*] out_data_rd_wi_i[*] out_rank_rr_wi_i[*] ss_wo_ss5_i[*] table_req_treq_wi_i[*] tl_st_wi_i[*]}]
set_output_delay -min 0.0000 -clock vclk [all_outputs]
set_load 2 [all_outputs]
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
