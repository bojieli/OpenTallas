  "architecture": "One reusable compute tile owns four striped ROM output lanes; each lane selects one of S macro pairs. A pair alternates two 4096x274 macros and captures at macro pins before selection. No tile-to-tile weight crossbar.",
  "geometry_assumptions": {
    "pair_width_um": 125.28,
    "pair_height_um": 125.82,
    "macro_pair_mm2": 0.0157627296,
    "leaf_channel_um": 32,
    "trunk_channel_um": 112,
    "signal_layers_per_direction": 2,
    "pitch_um": 0.08,
    "clock_pg_reserve_fraction": 0.5,
    "wire_reach_um_per_stage": 504,
    "wire_reach_basis": "uarch_model WIRE_REACH_SS_UM; optimistic bound if additional mux logic shares stage, therefore stages charged separately",
    "mux2_bit_cell_um2_proxy": 0.2,
    "dff_cell_um2": 0.2916,
    "logic_util": 0.5,
    "sram_pack_factor": 1.31,
    "sram_128x256_um2": 3891.57696,
    "metadata_per_leaf_bits": 32,
    "metadata_note": "32b reserve only; actual descriptor/epoch widths may enlarge",
    "selection_policy": "binary registered tree one logic level per cycle; source capture then pair select register; wire stages additional conservative allowance"
  },
  "feed": {
    "raw_rom_bits_per_cycle": 1096,
    "selected_compute_line_bits": 1088,
    "weight_code_bytes_per_cycle": 128,
    "frequency_hz": 1200000000.0,
    "code_GB_s": 153.6,
    "FP4": {
      "active_MAC_per_cycle_per_column": 256,
      "meaningful_bytes": 136,
      "scale_bytes": 8,
      "padding_bytes": 0
    },
    "FP8": {
      "active_MAC_per_cycle_per_column": 128,
      "meaningful_bytes": 132,
      "scale_bytes": 4,
      "padding_bytes": 4
    },
    "BF16": {
      "active_MAC_per_cycle_per_column": 64,
      "meaningful_bytes": 128,
      "scale_bytes": 0,
      "padding_bytes": 8
    },
    "columns_note": "One column for AR. Extra activation columns reuse weight line, not extra weight bandwidth. Modes exclusive; never sum MAC rates.",
    "packing": "Rewire 4 words into128B codes then8 exponent bytes; FP8/BF16 unused exponent bytes constants. FP4 two block scales per ROM word. Pair words must contain consumer chunk-lane order, not arbitrary contiguous K order."
  },
  "equations": {
    "pairs": "N=4*S",
    "binary_mux_nodes": "4*(S-1) 274b data muxes; pair selects N additional274b muxes",
    "bank_request_demux": "4 one-hot decoders S outputs; each selected pair receives row address and enable; registered buffered tree, never a single unpriced high fanout address bus",
    "capture_bits": "548*N (macro-pin captures), 306*N (pair output incl32b tag)",
    "selection_tree_register_bits": "306*4*(S-1)",
    "source_to_sink_wire_stage_allowance": "ceil((ROM_block_width+ROM_block_height)/504)",
    "aggregate_tracks": "4*(274+32)+64=1288 (64 reserved request/control trunk bits; forward and return separate)",
    "channel_capacity": "floor(width_um*2/.08*.5)",
    "latency_to_packed_response": "2 capture +1 pair-select +log2(S) registered selects +ceil((width+height)/504) extra wire stages +1 pack",
    "credit_depth_beats": "2*latency+2 for symmetric registered return; exact scheduler may replace. Reserve before irreversible macro issue; credit returned only on consumer release.",
    "sram_fifo": "5 parallel128x256 1r1w macros ->128beats x1280b; used1088b/beat; excess width is real paid capacity.",
    "total_area": "ROM block with channels + stdcell mux/capture/tree/pipeline/FIFO-control at50% utilization + packed5SRAM footprint; excludes compute tile, activation memory, top die network and CTS overhead"
  },
  "interface": {
    "request": "valid/ready, descriptor identity, epoch, line address, reserved consumer slot tag, format; four selected lane addresses derived from immutable mapping",
    "response": "valid,1088-bit line, reserved slot tag and epoch; no acceptance of a response without reserved capacity",
    "ordering": "Exactly existing sm_v chunk/lane/slot order. Preserve BF16 bits and FP4/FP8 exponent bytes. Transport can reorder only with tagged reorder buffer delivering original sequence.",
    "bounds": "Descriptor format/address bounds and immutable mapping validity checked before ROM issue. Unknown/stale epoch must fault, not overwrite live slot.",
    "protection": "No ROM ECC/parity. Mutable FIFO/tag protection remains required and is not included in lower-bound area."
  },
  "options": {
    "hierarchical_striped": "4 S:1 mux trees, fixed ownership. Preferred; one136Bbeat/clk independent of capacity. Requires compiler striping and records bank collisions.",
    "crossbar": "4 independent N:1 trees needs4*(N-1) 274b mux nodes versus4*(S-1); roughly4x selection nodes; each leaf fanout4 plus arbitration/conflict network. No need for first vehicle; not included.",
    "multi_tile": "Replicate complete tile+4lane network; do not assume compute tile can borrow neighboring ROM bandwidth. Such borrowing needs a separately priced fabric."
  },
