  "findings": [
    {
      "id": "B1",
      "issue": "16-bit context tag cannot index DS dictionary; retain 32-bit home mapping",
      "owner": "Popper",
      "required": "Pin per-model/per-die dictionary identity, source-order home ID and actual provider reference translation; keep model/rank/SM/kind/offset ownership"
    },
    {
      "id": "B2",
      "issue": "PC-lane namespace is implicit only before aggregation; same tuple collides across physical PC lanes",
      "owner": "Popper+Dewey",
      "required": "Exact PC->coalescer->SM-ring reversible map with finite slots, scope, allocation, held-return capture and inverse ACK/reverse match; do not assume 4 PCs/SM"
    },
    {
      "id": "B3",
      "issue": "4-bit generation wrap has no source-backed drain/reuse bound",
      "owner": "Popper+Dewey",
      "required": "Either prove every old forward/return/RF common ACK/consumer/reverse/CDC copy drained before legal slot reuse, or price a source-bound wrap/quarantine mechanism. Reset must invalidate both domains after actual quiescence; 16 count credits do not prove stale age."
    },
    {
      "id": "B4",
      "issue": "Bulk 1024-slot/512-outstanding ring cannot inherit PC slot4 or receive partial sector as complete line",
      "owner": "Popper+Dewey",
      "required": "Keep ring slot10 and all four sector identities/eligibility plus assembly, no duplicate beat visibility, original tag and source line release. Price actual finite map capacity and per-cycle read/write/update ports."
    },
    {
      "id": "B5",
      "issue": "All DS missing SM/retire rows are persistent HBM produced-state homes, not RF omissions",
      "owner": "Popper+Dewey",
      "required": "Retain their refusal until actual version/producer-rank/region/append-reader lease and epoch ownership binds. Do not invent an SM or RF-style last-use PC; input binding gives produced-fragment PC, not persistent retirement."
    },
    {
      "id": "B6",
      "issue": "Native-program PC and physical HBM pseudo-channel are different namespaces; address-derived channel cannot replace program lifecycle identity",
      "owner": "Popper+Dewey",
      "required": "Use instruction birth/last-use only within named token/epoch and actual visibility/reverse receipts; serialize/update same-edge allocation and completion matching atomically, fault unmatched/duplicate without credit release."
    },
    {
      "id": "B7",
      "issue": "MAX_OUT16 is an installed per-client count bound, not an installed 16-slot exact-identity allocator or reverse-drained ownership table",
      "owner": "Popper+Dewey",
      "required": "Price candidate slot4 state/ports and separate backend count retirement from owner/lease release; source counter decrements on accepted read return or write pulse, before unproven RF consumer/reverse lifecycle. Compose simultaneous allocate/read/write completion deltas and reject stale/duplicate without freeing the new owner."
    }
  ],
