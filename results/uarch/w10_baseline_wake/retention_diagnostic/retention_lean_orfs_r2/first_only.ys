read_verilog -sv /work/retention_lean_orfs_r2/wake.sv
hierarchy -top wake_diag
proc
write_json /work/retention_lean_orfs_r2/first_only_proc.json
# W10 modeled wake cells: select drivers from eight named wires, not $procdff names.
select -assert-count 8 w:g_wake.g_leaf*.wake
select -set ot_wake_proc w:g_wake.g_leaf*.wake %ci t:$adff %i
select -assert-count 8 @ot_wake_proc
setattr -set keep 1 @ot_wake_proc
select -clear
synth -top wake_diag -run coarse:coarse
write_json /work/retention_lean_orfs_r2/first_only_coarse.json
opt -fast -full
memory_map
opt -full
techmap
write_json /work/retention_lean_orfs_r2/first_only_techmap.json

opt -fast
dfflibmap -liberty /work/asap7_seq_ss.lib
opt -fast
abc
opt -fast
write_json /work/retention_lean_orfs_r2/first_only_mapped.json
