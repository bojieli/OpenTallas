chparam -set MUT 0 red_pin_cone
hierarchy -top red_pin_cone
proc; setattr -mod -unset keep_hierarchy; setattr -unset keep_hierarchy; flatten; hierarchy -top red_pin_cone; async2sync; opt; techmap; opt
