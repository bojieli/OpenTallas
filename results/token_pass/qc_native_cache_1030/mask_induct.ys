read_verilog -formal -sv actual_hold.sv actual_status.sv miter.sv
chparam -set MUT 0 cache_refinement
hierarchy -top cache_refinement; setattr -mod -unset keep_hierarchy; proc; flatten
async2sync; dffunmap; opt -noff -keepdc; select -module cache_refinement
sat -seq 4 -tempinduct-def -maxsteps 8 -set-def-inputs -set-init-def -set rst_n 1 -set-at 1 rst_n 0 -set-at 2 rst_n 0 -set-at 3 rst_n 0 -set-at 4 rst_n 0 -prove mask_bad 0 -show-inputs -show-outputs -verify
