# hd_tile: preserve every actual master+clock-root site, reorder only pipeline bit/stage occupants.
set tile6_fd [open /work/rtl/ot_s81hd_bundle_native.sv r]
set tile6_rtl [read $tile6_fd];close $tile6_fd
foreach ab {a b} {
 if {[string first "#(.W(16), .D(SK * (j % 8))) u_$ab" $tile6_rtl] < 0} {error "TILE6 requires actual 16-bit native skew lanes"}
}
proc tile6_repack {names label} {
 global ff_blk
 set cls {};set n 0
 foreach nm [lsort -ascii $names] {
  set ii [$ff_blk findInst $nm];if {$ii eq "NULL"} {error "TILE6 missing actual skew register"}
  if {![regexp {g_sk[^0-9]*([0-9]+).*line[^0-9]*([0-9]+)} $nm -> lane flat]} {error "TILE6 unknown actual skew index"}
  set root {}
  foreach it [$ii getITerms] {
   set mt [$it getMTerm]
   if {[$mt getSigType] eq "CLOCK" || [regexp {^(CLK|CK|GCLK)$} [$mt getName]]} {
    set net [$it getNet];if {$net eq "NULL"} {error "TILE6 unclocked skew register"};lappend root [$net getName]
   }
  }
  if {[llength $root]!=1} {error "TILE6 expects one actual skew clock"}
  set mk [list [[$ii getMaster] getName] $root]
  set key [format {%09d|%09d|%09d} $lane [expr {$flat%16}] [expr {$flat/16}]]
  dict lappend cls $mk [list $key $ii [$ii getOrigin] [$ii getOrient]]
 }
 dict for {mk old} $cls {
  set sorted [lsort -dictionary -index 0 $old]
  foreach dst $sorted slot $old {
   set ii [lindex $dst 1];lassign [lindex $slot 2] x y
   $ii setPlacementStatus PLACED;$ii setOrient [lindex $slot 3];$ii setOrigin $x $y;$ii setPlacementStatus FIRM;incr n
  }
 }
 puts "TILE6_REPACK $label $n registers: exact master/clock-root site inventory preserved"
}
