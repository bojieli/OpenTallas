read_verilog -sv vline.v orig_fdiv.v new_fdiv.v
chparam -set ZERO_RST 1 ot_hdc_v41x_fdiv
hierarchy -check; proc; flatten; opt_clean
rename fdiv_orig gold; rename ot_hdc_v41x_fdiv gate
async2sync
miter -equiv -flatten -make_outputs gold gate m; hierarchy -top m; flatten; opt
sat -verify -seq 26 -prove-skip 22 -set-at 1 in_rst_n 0 -set-at 2 in_rst_n 0 -set-at 3 in_rst_n 1 -set-at 4 in_rst_n 1 -set-at 5 in_rst_n 1 -set-at 6 in_rst_n 1 -set-at 7 in_rst_n 1 -set-at 8 in_rst_n 1 -set-at 9 in_rst_n 1 -set-at 10 in_rst_n 1 -set-at 11 in_rst_n 1 -set-at 12 in_rst_n 1 -set-at 13 in_rst_n 1 -set-at 14 in_rst_n 1 -set-at 15 in_rst_n 1 -set-at 16 in_rst_n 1 -set-at 17 in_rst_n 1 -set-at 18 in_rst_n 1 -set-at 19 in_rst_n 1 -set-at 20 in_rst_n 1 -set-at 21 in_rst_n 1 -set-at 22 in_rst_n 1 -set-at 23 in_rst_n 1 -set-at 24 in_rst_n 1 -set-at 25 in_rst_n 1 -set-at 26 in_rst_n 1  -prove trigger 0 -show-ports m
