diff --git a/tools/die_plan/test_sdc_lint.py b/tools/die_plan/test_sdc_lint.py
index 0752b8630..4104f380d 100644
--- a/tools/die_plan/test_sdc_lint.py
+++ b/tools/die_plan/test_sdc_lint.py
@@ -146,6 +146,10 @@ def test_core_tap_source_latency_only_as_planned():
     """CP2 early core taps: source latency on a tap port must equal the plan's -early; nothing else may carry one."""
     txt, ctx = _kit(TINY)
     tap = ctx["clock_ports"][0]
+    # Turn this synthetic local tap into an early core tap: it must leave the
+    # local-tree estimate, as the generator does for real CP2 core taps.
+    txt = "\n".join(ln.replace("[get_ports {" + tap + " ", "[get_ports {")
+                    if ln.startswith("set_clock_latency -clock clk") else ln for ln in txt.splitlines()) + "\n"
     line = f"set_clock_latency -source -clock clk -30.0000 [get_ports {tap}]\n"
     assert any("early core tap" in x for x in _errs(txt + line, ctx))
     assert _errs(txt + line, ctx, port_latency_ps={tap: -30.0}) == []
@@ -177,3 +181,24 @@ def test_ft_hop_in_share_plan_field():
     assert _errs(txt, sdc_lint.kit_context(P, tn)) == []
     old = gen_phys.sdc(P0, tn, gen_phys.type_pins(P0, tn))
     assert _errs(old, sdc_lint.kit_context(P, tn))
+
+
+def test_pre_cts_network_estimate_only_on_local_taps():
+    txt, ctx = _kit(TINY)
+    estimates=[ln for ln in txt.splitlines() if ln.startswith("set_clock_latency -clock clk")]
+    assert len(estimates)==1
+    assert _errs(txt,ctx)==[]
+    # The estimate may neither move the virtual clock nor become a source delay.
+    assert any("network latency override" in e for e in _errs(txt.replace(estimates[0], "set_clock_latency 250 [get_clocks clk]"),ctx))
+    assert any("network latency override" in e for e in _errs(txt.replace(estimates[0], estimates[0].replace("250.0000", "300.0000")),ctx))
+    assert any("network latency override" in e for e in _errs(txt,dict(ctx,network_latency_ports=[])))
+
+
+def test_early_core_taps_cannot_take_network_estimate():
+    txt,ctx=_kit(TINY)
+    ctx=dict(ctx,port_latency_ps={ctx["clock_ports"][0]:-160})
+    e=_errs(txt,ctx)
+    # A source early contract is distinct; merely listing it as a local estimate
+    # must not override the core's measured internal insertion.
+    assert any("no source latency" in x for x in e)
+    assert any("network latency override" in x for x in e)
