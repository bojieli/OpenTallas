read_verilog -sv skid_old.sv
chparam -set WIDTH 5 skid_old
read_verilog -sv skid_new.sv
chparam -set WIDTH 5 -set MUT 1 ot_hbm_svc_pin_skid2
proc; opt_clean; async2sync; flatten
equiv_make skid_old ot_hbm_svc_pin_skid2 eq
hierarchy -top eq
cd eq
equiv_add \cnt_gold \g_sl[0].cnt_k_gate
equiv_add \wp_gold \g_sl[0].wp_k_gate
equiv_add \rp_gold \g_sl[0].rp_k_gate
equiv_add \e0_gold[4:0] \g_sl[0].e0_gate
equiv_add \e1_gold[4:0] \g_sl[0].e1_gate
cd ..
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
