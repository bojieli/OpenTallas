proc ln_phase4_portbuffer_affinity {command op} {
 set b [ord::get_db_block]
 set count 0
 foreach i [$b getInsts] {
  if {[$i getGroup] ne "NULL" || ![regexp {^(BUF|INV)} [[$i getMaster] getName]]} {continue}
  set hits [dict create]
  foreach it [$i getITerms] {
   set net [$it getNet]
   if {$net eq "NULL"} {continue}
   foreach bt [$net getBTerms] {
    set pn [$bt getName]
    if {[dict exists $::ln_phase4_port_groups $pn]} {dict set hits [dict get $::ln_phase4_port_groups $pn] 1}
   }
  }
  if {[dict size $hits]>1} {error "Native portbuffer aliases different physical islands"}
  if {[dict size $hits]==1} {
   set group [$b findGroup [lindex [dict keys $hits] 0]]
   if {$group eq "NULL"} {error "Missing reviewed physical chunk group"}
   $group addInst $i
   incr count
  }
 }
 puts "LN_PHASE4_PORTBUFFERS_PHYSICAL_ISLANDS $count"
}
trace add execution global_placement enter ln_phase4_portbuffer_affinity

