set clk_period 2000
create_clock -name core_clk -period $clk_period [get_ports clk]
set non_clock_inputs [all_inputs -no_clocks]
set_input_delay [expr $clk_period * 0] -clock core_clk $non_clock_inputs
set_output_delay [expr $clk_period * 0] -clock core_clk [all_outputs]
set_load 3.898 [all_outputs]
set_max_fanout 32 [current_design]
set_max_transition 320 [current_design]
set_false_path -from [get_ports rst_n]
set_false_path -from [get_ports m_v]
set_false_path -from [get_ports m_keep]
set_false_path -from [get_ports m_ref]
set_false_path -from [get_ports w_v]
set_false_path -from [get_ports w_head]
set_false_path -from [get_ports w_w]
set_false_path -from [get_ports w_qsc]
set_false_path -from [get_ports p_v]
set_false_path -from [get_ports p_smask]
set_false_path -from [get_ports p_ys]
set_false_path -from [get_ports p_fs]
set_false_path -from [get_ports p_mask]
set_false_path -from [get_ports p_y]
set_false_path -from [get_ports p_f]
