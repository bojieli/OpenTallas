set clk_period 12000
create_clock -name core_clk -period $clk_period [get_ports clk]
set non_clock_inputs [all_inputs -no_clocks]
set_input_delay [expr $clk_period * 0] -clock core_clk $non_clock_inputs
set_output_delay [expr $clk_period * 0] -clock core_clk [all_outputs]
set_load 3.898 [all_outputs]
set_max_fanout 32 [current_design]
set_max_transition 320 [current_design]
set_false_path -from [get_ports rst_n]
set_false_path -from [get_ports cfg_ik_base]
set_false_path -from [get_ports su_go]
set_false_path -from [get_ports i_dst]
set_false_path -from [get_ports i_obase]
set_false_path -from [get_ports i_orow]
set_false_path -from [get_ports i_nout]
set_false_path -from [get_ports i_kdim]
set_false_path -from [get_ports kv_we]
set_false_path -from [get_ports kv_waddr]
set_false_path -from [get_ports kv_wdata]
set_false_path -from [get_ports w_rdy]
