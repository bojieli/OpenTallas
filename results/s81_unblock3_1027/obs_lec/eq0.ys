read_verilog -sv stubs.v
read_verilog -sv orig.sv
chparam -set FMUT 0 dsdv_hostb_seqhost_mux
hierarchy -top dsdv_hostb_seqhost_mux
proc; flatten; delete t:dsdv_hostb_source t:dsdv_seq_host_mux; expose -input w:t_core w:t_mf w:hostb_fault; setundef -undriven -zero; opt_clean
rename dsdv_hostb_seqhost_mux gold
design -stash gold
read_verilog -sv stubs.v
read_verilog -sv -DS81_HOSTB_LAND_OBS dsdv_hostb_seqhost_mux.sv
chparam -set FMUT 0 dsdv_hostb_seqhost_mux
hierarchy -top dsdv_hostb_seqhost_mux
proc; flatten; delete t:dsdv_hostb_source t:dsdv_seq_host_mux; expose -input w:t_core w:t_mf w:hostb_fault; setundef -undriven -zero; opt_clean
rename dsdv_hostb_seqhost_mux gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
async2sync
miter -equiv -flatten -make_assert -ignore_gold_x gold gate miter
hierarchy -top miter
sat -verify -tempinduct -prove-asserts -set-init-zero -seq 1 -maxsteps 12 miter
