# GENERATED by gen_core_kit_legacy.py: fixed macro sites (core frame um; y on the M4 track phase of the macro pins).
# Instances are found by master (flattened names differ by stage / frontend); several instances of one master take the
# listed sites in instance-name order (identical masters: interchangeable sites).
set b [ord::get_db_block]
set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
foreach {master sites} {ot_sram_1r1w_128x256_m1_r2c2 {{107.568 71.28 R0} {107.568 112.368 R0}}} {
  set hit {}
  foreach i [$b getInsts] { if {[[$i getMaster] getName] eq $master} { lappend hit $i } }
  if {[llength $hit] != [llength $sites]} { error "legacy macro_place: [llength $hit] instances of $master (want [llength $sites])" }
  set hit [lsort -command {apply {{a b} {string compare [$a getName] [$b getName]}}} $hit]
  foreach i $hit s $sites {
    lassign $s x y orient
    $i setOrient $orient
    $i setLocation [expr {round($x * $dbu)}] [expr {round($y * $dbu)}]
    $i setPlacementStatus FIRM
    puts "LEGACY place: [$i getName] $master at $x $y $orient"
  }
}
