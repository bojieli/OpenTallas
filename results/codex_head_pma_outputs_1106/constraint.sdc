set pad_seam_outputs [get_ports {cfg_o[*] fx_o[*] fr_o[*]}]
create_clock -name pma_rck -period 1250.0000 [get_ports {pma_rck[0]}]
set pad_data_outputs [get_ports {cfg_o[*] fx_o[*] fr_o[*] pma_tx[*]}]
# GENERATED by tools/die_plan/gen.py phys: partition type mid of die_plan tiny.
# clock taps (R4 grid, one port per tap, local trees): clk clk_t1 clk_t2 clk_t3 clk_t4 clk_t5 clk_t6 clk_t7 clk_t8
create_clock -name clk -period 833.0000 [get_ports {clk clk_t1 clk_t2 clk_t3 clk_t4 clk_t5 clk_t6 clk_t7 clk_t8}]
# neighbour boundary flops run on the bound insertion (TT 250 ps here; FF 202.5 ps via the FF-only flow steps; ruling 9.7 / decision 5e): virtual IO clock
create_clock -name vclk -period 833.0000
set_clock_latency -source 250.0000 [get_clocks vclk]
# clock uncertainty: sign-off margin policy nominal (OWNER 12.24b/c 2026-10-31: nominal setup (setup clock uncertainty 0, hold 25 kept; legacy setup 60 = A/B only))
set_clock_uncertainty 0.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
# seam paths: uncertainty counted once per seam (COORD 16:58): 0.5 on each partition side
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 0.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 0.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [all_inputs -no_clocks]
set_input_delay -max 166.6000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk $pad_seam_outputs
# ft slots: hop share 0.08 T at the face, the rest is the last station segment
set_input_delay -max 766.3600 -clock vclk [get_ports {fx_i[*] fr_i[*]}]
set_output_delay -max 66.6400 -clock vclk [get_ports {fx_o[*] fr_o[*]}]
set_input_delay -min -40.0000 -clock vclk $non_clk_in
set_output_delay -min 0.0000 -clock vclk $pad_seam_outputs
set_load 2 $pad_data_outputs
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
create_generated_clock -name pma_tck -master_clock clk -source [get_ports {clk}] -divide_by 1 [get_ports {pma_tck[0]}]
set_clock_uncertainty 0.0000 -setup [get_clocks pma_tck]
set_clock_uncertainty 25.0000 -hold [get_clocks pma_tck]
set_output_delay -max 166.6000 -clock pma_tck [get_ports {pma_tx[*]}]
set_output_delay -min 0.0000 -clock pma_tck [get_ports {pma_tx[*]}]
