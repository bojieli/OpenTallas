read_verilog -sv derived.sv miter.sv
hierarchy -top miter
proc; flatten; opt_clean
async2sync; dffunmap
# induction step only (k=1): assume p at step 1, prove p at step 2, all inputs free
sat -tempinduct -tempinduct-inductonly -maxsteps 1 -seq 1 -set-at 1 p 1 -prove p 1 -show-inputs -verify
design -reset
read_verilog -sv derived.sv miter.sv
hierarchy -top inv_only
proc; flatten; opt_clean
async2sync; dffunmap
sat -tempinduct -tempinduct-inductonly -maxsteps 1 -seq 1 -set-at 1 inv 1 -prove inv 1 -verify
# base: after any edge with rq low the invariant holds (rq is the only reset; state otherwise free)
sat -seq 2 -set-at 1 uo.rq 0 -prove-skip 1 -prove inv 1 -verify
design -reset
read_verilog -sv derived.sv miter.sv
hierarchy -top miter
proc; flatten; opt_clean
async2sync; dffunmap
# base for P: two copies in the SAME arbitrary state; after one edge with rq low (control reset in both) P holds
sat -seq 2 -set-at 1 uo.rq 0 -set-at 1 un.rq 0 -set-at 1 uo.wc un.wc -set-at 1 uo.write_oh un.write_oh -set-at 1 uo.valid un.valid -prove-skip 1 -prove p 1 -verify
