{
 "schema": "opentallas.hbm_globalfp.op_map.v1",
 "candidate": "v5",
 "attention": {
  "mode": "sm",
  "kv_home": "stack_local",
  "rules": {
   "KV": "attention on SM (owner adoption 10-15, H-ATTQ B): KV rows stream PHY -> PC -> SM on the existing SM HBM port like weights; QK and PV each stream the row set (KV_hbm already counts both). kv_home=stack_local: dense rows are sequence-sliced to the SM whose stack holds them (token t -> SM t%32), DS top-k rows are rank-assigned (rank r -> SM r%32) and the compressed KV is replicated in all four stacks so every SM reads its rows from its own stack (+3 row writes per layer per token, +3x KV capacity); kv_home=interleave: one copy, top-k rows read across quadrants over the VM ring",
   "SCORES": "partial scores out of each SM (FP32, heads x rows), softmax on SU (read scores, write P), P back to the SM on the x-load port, PV partial outputs back to VM and reduced by SU: Qwen 8 q heads x 8192 x 4 B x 36, DS 16 x 640 x 4 B x 40",
   "DESC": "KV prefetch descriptors (row ids from window + IDX top-k) read by each SM from its quadrant VM hub: 4 B per row"
  },
  "freed": "ATT tiles, gathers, Q/P fields, reduction, ATT control, attention RG/WG, LG ATT groups, PV return (H-ATTQ: 111.1 mm2 / ~161 W on v14)"
 },
