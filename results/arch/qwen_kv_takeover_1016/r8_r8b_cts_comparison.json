  "repair_sdc_diff": "--- \n+++ \n@@ -1,3 +1,6 @@\n+# qfd_d2d_static_r8: ROUTE-TIME FF hold-repair SDC (NOT sign-off; generated by tools/ref_tile/ref_tile.py): signoff.sdc\n+# with the boundary hold requirement relieved by 20 ps = route.hold_margin_ns - route.io_hold_margin_ns, so the\n+# repair margin on IO paths is io_hold_margin while reg->reg keeps hold_margin.  Sign-off reads signoff.sdc.\n # qfd_d2d_static_r8: sign-off at 833.333 ps (generated by tools/ref_tile/ref_tile.py; same form as\n # physical/qwen_die_masters/jobs/signoff_sdc.py): clock re-created at the real period, propagated, 60 / 25 ps uncertainty,\n # die-context boundary io_ref_skew.sdc with this block's REFGLOB / INTER bound.\n@@ -7,7 +10,8 @@\n set_clock_uncertainty -setup 60 [all_clocks]\n set_clock_uncertainty -hold 25 [all_clocks]\n set ::env(OT_IO_SKEW) 90\n-set ::env(OT_IO_HOLD_SKEW) 50\n+set ::env(OT_IO_HOLD_SKEW) 30\n+set ::env(OT_IO_IN_HOLD_SKEW) -20\n set ::env(OT_REF_GLOB) {*}\n set ::env(OT_IO_INTER) {none_*}\n set ::env(OT_IO_SKEW_INTER) 150\n@@ -129,3 +133,5 @@\n if {[llength [get_ports -quiet tile_id*]]} { set_false_path -from [get_ports tile_id*] }\n \n set_propagated_clock [all_clocks]\n+set ::env(OT_IO_HOLD_SKEW) 50\n+unset -nocomplain ::env(OT_IO_IN_HOLD_SKEW)\n",
