{
 "schema": "opentallas.qcluster.bench_land.v1",
 "lane": "Q-CL16-LAND",
 "host": "ot-epyc5 (ot-run)",
 "pass_benches": [
  {
   "name": "qcluster16_lockstep_land",
   "cmd": "bash tools/qwen_cluster/bench_lockstep.sh OUT",
   "pass_regex": "LOCKSTEP_EXIT 0",
   "log": "lockstep/bench.log"
  },
  {
   "name": "qcluster_fabric_land",
   "cmd": "bash tools/qwen_cluster/bench.sh OUT",
   "pass_regex": "BENCH_EXIT 0",
   "log": "fabric/bench.log"
  }
 ],
 "mutants": [
  {
   "bench": "lockstep",
   "mut": 1,
   "what": "extra relay on leg (2,0).a",
   "fail_regex": "LOCKSTEP_FAIL MUT 1 FAR 0",
   "witness": "lockstep/run_m1_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 1,
   "what": "extra relay on leg (2,0).a",
   "fail_regex": "QCLUSTER_FAIL MUT 1 FAR 0",
   "witness": "fabric/run_m1_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 2,
   "what": "leaves of (1,0).a/(1,2).a swapped",
   "fail_regex": "LOCKSTEP_FAIL MUT 2 FAR 0",
   "witness": "lockstep/run_m2_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 2,
   "what": "leaves of (1,0).a/(1,2).a swapped",
   "fail_regex": "QCLUSTER_FAIL MUT 2 FAR 0",
   "witness": "fabric/run_m2_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 3,
   "what": "extra relay on column-2 run",
   "fail_regex": "LOCKSTEP_FAIL MUT 3 FAR 0",
   "witness": "lockstep/run_m3_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 3,
   "what": "extra relay on column-2 run",
   "fail_regex": "QCLUSTER_FAIL MUT 3 FAR 0",
   "witness": "fabric/run_m3_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 4,
   "what": "extra feedthrough relay",
   "fail_regex": "LOCKSTEP_FAIL MUT 4 FAR 0",
   "witness": "lockstep/run_m4_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 4,
   "what": "extra feedthrough relay",
   "fail_regex": "QCLUSTER_FAIL MUT 4 FAR 0",
   "witness": "fabric/run_m4_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 5,
   "what": "feedthrough bits 0/1 swapped",
   "fail_regex": "LOCKSTEP_FAIL MUT 5 FAR 0",
   "witness": "lockstep/run_m5_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 5,
   "what": "feedthrough bits 0/1 swapped",
   "fail_regex": "QCLUSTER_FAIL MUT 5 FAR 0",
   "witness": "fabric/run_m5_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 6,
   "what": "LANDING read slot K = E + 1",
   "fail_regex": "LOCKSTEP_FAIL MUT 6 FAR 0",
   "witness": "lockstep/run_m6_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 6,
   "what": "LANDING read slot K = E + 1",
   "fail_regex": "QCLUSTER_FAIL MUT 6 FAR 0",
   "witness": "fabric/run_m6_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": 7,
   "what": "LANDING read-side epoch one edge late",
   "fail_regex": "LOCKSTEP_FAIL MUT 7 FAR 0",
   "witness": "lockstep/run_m7_f0.log"
  },
  {
   "bench": "fabric",
   "mut": 7,
   "what": "LANDING read-side epoch one edge late",
   "fail_regex": "QCLUSTER_FAIL MUT 7 FAR 0",
   "witness": "fabric/run_m7_f0.log"
  },
  {
   "bench": "lockstep",
   "mut": "S",
   "what": "station bit inverted (DUT only)",
   "fail_regex": "LOCKSTEP_FAIL MUT 0 FAR 0 mismatching",
   "witness": "lockstep/run_mS_f0.log"
  },
  {
   "bench": "region_audit",
   "mut": "station",
   "what": "c0r0 station on ck_c3r3",
   "fail_regex": "REGION_AUDIT_FAIL",
   "witness": "lockstep/region_audit_station.log"
  },
  {
   "bench": "region_audit",
   "mut": "tile",
   "what": "tile (0,0) entry on ck_c2r0",
   "fail_regex": "REGION_AUDIT_FAIL",
   "witness": "lockstep/region_audit_tile.log"
  },
  {
   "bench": "region_audit",
   "mut": "landclk",
   "what": "LANDING read half on the ring's write clock ck_c3r3 (timing-only error)",
   "fail_regex": "REGION_AUDIT_FAIL",
   "witness": "lockstep/region_audit_landclk.log"
  }
 ],
 "note": "MUT 7 is caught by the lockstep (latency), not by the LAND_FAULT assertion: a static epoch offset shifts rc and the expected epoch together (the slot tags only catch a slip inside a run)."
}