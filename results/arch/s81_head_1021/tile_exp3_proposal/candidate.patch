+// Named same-edge data/control owner: all seven captured values and the three
+// local exponent muxes stay together. No reset or pipeline edge is introduced.
+(* keep_hierarchy="yes" *) module ot_hdc_mul_exp3_local (
+    input wire clk, input wire top_d,
+    input wire [2:0] e47, e46, output wire [2:0] fl
+);
