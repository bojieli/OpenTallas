{
 "schema": "opentallas.hier_contract.handoff.v1",
 "element_group": "hbm-no3",
 "elements": {
  "ot_hbm_native_frame_station_rb_NO3_split": "NO=2",
  "ot_hbm_native_frame_station_rb_NO3": "NO=3",
  "ot_hbm_native_frame_station_rb_NO3_SAFE": "NO=3 (same SAFE=1 RTL as NO3)"
 },
 "rule": "TWO-LEVEL HIERARCHY (owner 10-11 21:00): 5 slice tiles + ot_hbm_w2_stn_hub placed directly by the die; every tile<->hub seam is a die-level seam",
 "source": {
  "branch": "claude/el1011-hbm-no3-ph25",
  "views_commit": "60091125e",
  "rtl": "physical/hbm_w2_rb_station_20261006/{station_rb_static.sv,slice_static.sv} HIER=1 (composition = bit-exact bench tools/w2_station_rb_gate.py --hier)"
 },
 "period_ps": 833.333,
 "layer_contract": "tile signals M1-M7 routed around own full-length VDD/VSS M7 stripes (PG pins on M7); die straps M8 onto them (reference physical/hbm_w2_rb_station_20261006/pdn_hier_m8.tcl)",
 "seam_timing": {
  "model": "tile SDC (closed routes, period 770 route / 833.333 sign-off): neighbour virtual clock nbr_clk source latency 250 ps (SS) / 150 (FF); setup unc 60, hold unc 25",
  "tile_inputs": "din*, gr, rst_p, rst_e, go_commit, go_repair, go_check, go_sel, ph4*: input delay max 300+60 = 360 ps (i.e. ~0.43 T available to the die-level wire+sender), min 30 ps; every input is captured by a flop at the pin (no logic before it)",
  "tile_outputs": "dout*, grc_o*, v_same/v_bad/v_cbad/v_ce/v_ue/v_clean, q* (slice5): launched from flops; output delay max 360 ps, min 100 ps (RULE H1: hold_io on sender min)",
  "seam_rule": "each tile<->hub seam: flop->wire->flop, <= ~500 um per stage at 833 ps; hub->slice control broadcast (go_*, ph4, gr, rst_p/rst_e) and slice->hub verdicts (v_*, grc_o, q) are one-stage today: place the hub so the farthest slice is <= ~450 um or add a relay (adds 1 cycle to the S1->S2 loop: needs the hub FSM to absorb it - tell hbm-no3 first)",
  "data_seams": "die pins in_* -> slice din (bottom face, data-bit order left->right words 0..36); slice dout -> die out_* (top face). Station data never passes through the hub.",
  "measured_tile_route_slack": "closed (TT setup >=0, FF hold >=0, DRC 0) at the SDC above; slice8 views from routes whose closing pass was the loop hold ECO (record/views LEF/LIB at routed insertion)",
  "seam_in_slice5_note": "slice5 q is 320 bits; hub reads q[280:0]"
 },
