VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN coupon_a ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
TRACKS Y 3 DO 209 STEP 48 LAYER M4 ;
TRACKS X 0 DO 209 STEP 48 LAYER M5 ;
GCELLGRID X 0 DO 11 STEP 1000 ;
GCELLGRID Y 0 DO 11 STEP 1000 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 1 ;
    - FIXED_PIN_CONTROL + NET FIXED_PIN_CONTROL + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER M4 ( -12 -12 ) ( 12 12 )
        + LAYER M4 ( -276 -21 ) ( 12 3 )
        + FIXED ( 1020 1008 ) N ;
END PINS
NETS 1 ;
    - FIXED_PIN_CONTROL ( PIN FIXED_PIN_CONTROL ) + USE SIGNAL ;
END NETS
END DESIGN
