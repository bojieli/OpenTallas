    report_checks -path_delay $d -group_count 200000 -endpoint_count 1 -unique_paths_to_endpoint -format end > /work/sta/tt_$tag.end.rpt
  }
  report_checks -path_delay $d -group_path_count 12 -fields {slew cap fanout} -digits 1 > /work/sta/tt_$tag.paths.rpt
}
report_check_types -max_slew -max_capacitance -violators > /work/sta/tt_drv.rpt
proc rv_worst {fo l ps} {
  foreach d {max min} {
    set pe [lindex [find_timing_paths -path_delay $d -to $ps -group_path_count 1] 0]
    if {$pe eq ""} { puts $fo "$l $d none"; continue }
    set pn "?"; catch { set pn [get_full_name [[$pe path] pin]] }
    set sl "?"; catch { set sl [sta::format_time [$pe slack] 1] }
    puts $fo "$l $d $sl $pn"
  }
}
