# GENERATED by tools/landed_parent/lp.py for forest_top_lp (PARENTS-LANDED): regional roots, landing multicycles.
# Every region root: same period as core_clk (related, neighbour-relative die delivery).
set ot_lp_per [get_property [get_clocks core_clk] period]
create_clock -name ck_far -period $ot_lp_per [get_ports ck_far]
set_clock_uncertainty -setup 60 [get_clocks {ck_far}]
set_clock_uncertainty -hold 25 [get_clocks {ck_far}]
# 1-bit reset runs core -> every region: single-cycle with the 60-ps die residual on top of 60 / 25
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_far]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_far]
set_clock_uncertainty -setup 120 -from [get_clocks ck_far] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_far] -to [get_clocks core_clk]
# D4/E2 directly timed landing: supported compensated phase +/-0.75T; sample age1.25..2.75T, overwrite gap>=1.25T.
# Conservative quarter-T setup envelope; ordinary60ps/25ps plus residual60ps remains charged. No data exceptions.
set_clock_uncertainty -setup -from [get_clocks core_clk] -to [get_clocks ck_far] [expr {120.0 + 0.75 * $ot_lp_per}]
set_clock_uncertainty -hold -from [get_clocks core_clk] -to [get_clocks ck_far] 85.0
set_clock_uncertainty -setup -from [get_clocks ck_far] -to [get_clocks core_clk] [expr {120.0 + 0.75 * $ot_lp_per}]
set_clock_uncertainty -hold -from [get_clocks ck_far] -to [get_clocks core_clk] 85.0
set_output_delay [expr {0.2 * $ot_lp_per}] -clock ck_far [get_ports {o[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_far}] }
