{
 "schema": "opentallas.hbm_b2.bind_wiring.v1",
 "rule": "HBM-BIND 10-24: machine-readable B2 (8-SM, NW+NE) native-bind delta over the r18h5 as-built die (tools/hbm_b2/b2_top.py applies it; tools/hbm_b2/make_wiring.py writes it).",
 "keep": {
  "quadrants": [
   "NW",
   "NE"
  ],
  "instances": [
   "tkm_SW"
  ],
  "drop_instances": []
 },
 "strap_ports": [
  ".*\\.(tgt|qid|sid|bid|bank_id|pc_id|id_sm|id_stack|sm_hbm|sm_stream|stk|attn_column|attn_rowbase|xs_a1|xs_a2|xs_g1|xs_g2|first_ord|quad|lbase|slot|half|rl_cfg|wc_cfg|tile_id)"
 ],
 "items": [
  {
   "id": "W-RING",
   "kind": "wiring",
   "status": "done",
   "what": "COLL ring A hb_coll_{NW,NE}.pr_* and ring B hcollb_{NW,NE}.cw/ccw closed as 2-stop rings: NW.cw_o->NE.cw_i (new), NE.cw_o->NW.cw_i (as built), NE.ccw_o->NW.ccw_i (new), NW.ccw_o->NE.ccw_i (as built); qid straps 2/3 unchanged; ring programme addresses qid 2/3 only"
  },
  {
   "id": "W-OBS",
   "kind": "wiring",
   "status": "done",
   "what": "observation ring ingress->obs_C->obs_NE->obs_NW->ingress (LID 0/3/4 kept; LID 1/2 absent: host reads of SW/SE words return d=0 unmatched)"
  },
  {
   "id": "W-HLEAF",
   "kind": "param+wiring",
   "status": "done",
   "what": "hleaf_NW NT/NF (19, 31), hleaf_NE NT/NF (21, 31) (ot_hbm_host_cfg_leaf2); host_status NT 43 NF 75 NH 6 NA 2, TGTS re-derived per slot",
   "moved": {
    "hleaf_NE": [
     "t_ready:col_su.ready[0]",
     "t_ready:col_idx.ready[0]",
     "t_ready:hc_eng.configured[0]",
     "t_ready:hc_eng.configured[0]",
     "t_active:col_su.active[0]",
     "t_active:col_idx.active[0]",
     "t_active:hc_eng.program_active[0]",
     "t_active:hc_eng.program_active[0]",
     "t_fault:col_su.fault[0]",
     "t_fault:col_idx.fault[0]",
     "t_fault:ep_S3.fault[0]",
     "t_fault:hc_eng.fault[0]"
    ],
    "hleaf_NW": [
     "t_fault:ep_S0.fault[0]",
     "t_fault:ep_S1.fault[0]"
    ]
   },
   "host_fault_map": "hleaf s_fault bit order = rebuild t_fault order (host software map changes)"
  },
  {
   "id": "W-CFG",
   "kind": "wiring",
   "status": "done",
   "what": "col_su / col_idx / hc_eng cfg/desc/launch <- hleaf_NE copy a (as-built hleaf_SE a); c_busy {valid,busy} / c_done <- pgp_NW (SU programme part 0 of the 2-part root; as-built pgp_SW)"
  },
  {
   "id": "W-EP",
   "kind": "param+wiring",
   "status": "done (plan change owed)",
   "what": "hb_coll_NW -> ot_hfd_coll_q3_hard_v8x NLINK 3 (lanes N0,S0,S1) + TKM interface to tkm_SW + ARGMAX engine (as-built SW q3 role); hb_coll_NE q2 NLINK 2 (N2,S3); epcal_NW W 57, epcal_NE W 38 (19-bit endpoint field k at [19k+18:19k]); ep faults to hleaf_NW (S0,S1) / hleaf_NE (S3)",
   "plan": "B2l q_hub type carries u_hb_coll_Q = q2_hard_v8g for BOTH hubs (mirrored); the 5 SerDes need q3 NLINK 3 on one hub and q2 NLINK 2 on the other -> NW_hub / NE_hub become two types (or one superset type), and tkm_SW (root) must face the q3 hub. VM_RT 81 kept from the as-built NW/NE engines: re-derive from the B2 plan VM round trip."
  },
  {
   "id": "W-RID",
   "kind": "wiring",
   "status": "done",
   "what": "hb_router_ids run_v/run_layer <- cp_svg_NW0 (as-built cp_svg_SW0, same master and run_arg slice)"
  },
  {
   "id": "P-VMST",
   "kind": "param",
   "status": "done",
   "what": "vm_status4 NQ 2 {hb_vms_NE, hb_vms_NW} (bench rtl/hbm_accel/generic/vm/static/run_vms_status_nq.sh)"
  }
 ],
