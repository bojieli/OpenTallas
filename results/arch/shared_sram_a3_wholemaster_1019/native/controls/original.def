VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN coupon_a2 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 12500 12500 ) ;
TRACKS Y 3 DO 261 STEP 48 LAYER M4 ;
TRACKS X 0 DO 261 STEP 48 LAYER M5 ;
GCELLGRID X 0 DO 14 STEP 1000 ;
GCELLGRID Y 0 DO 14 STEP 1000 ;
COMPONENTS 0 ;
END COMPONENTS
NETS 5 ;
    - case0_net0 + USE SIGNAL
      + ROUTED M4 ( 8436 8688 ) ( 8700 * ) ;
    - case1_net0 + USE SIGNAL
      + ROUTED M4 ( 10356 8679 ) ( 10620 * )
      NEW M4 ( 10608 8676 ) RECT ( 0 0 24 24 )  ;
    - case2_net0 + USE SIGNAL
      + ROUTED M4 ( 876 10608 ) ( 1140 * ) ;
    - case2_net1 + USE SIGNAL
      + ROUTED M4 ( 876 10655 ) ( 1140 * ) ;
    - case3_net0 + USE SIGNAL
      + ROUTED M4 ( 2676 10608 ) ( 2906 * )
      NEW M4 ( 2928 10596 ) RECT ( 0 0 24 24 )  ;
END NETS
END DESIGN
