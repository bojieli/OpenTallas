      "    wire [127:0] w_d;",
      "    generate for (k = 0; k < 4; k = k + 1) begin : g_wd",
      "        if(FAN32!=0)begin:g_half",
      "            for(genvar h=0;h<2;h=h+1)begin:g_h",
      "                wire tv=h?tok_half[29+k]:tcv_r[k];",
      "                wire gd=h?tok_half[25+k]:gd_r[k];",
      "                assign w_d[k*32+h*16+:16]=tv?pf_q[k*32+h*16+:16]:(gd?hi_q[k*32+h*16+:16]:lo_q[k*32+h*16+:16]);",
      "            end",
      "        end else begin:g_legacy",
      "        assign w_d[k*32 +: 32] = tcv_r[k] ? pf_q[k*32 +: 32] : (gd_r[k] ? hi_q[k*32 +: 32] : lo_q[k*32 +: 32]);",
      "        end",
      "    end endgenerate",
      "    wire [127:0] sx_q [0:2];",
      "    assign sx0_data = sx_q[0]; assign sx1_data = sx_q[1]; assign sx2_data = sx_q[2];",
      "    generate for (j = 0; j < 3; j = j + 1) begin : g_sxo",
      "        (* keep_hierarchy = 1 *) ot_coll_split_sxd_native32 #(.W(128), .FACE(j), .QI(QI)) u_face (.clk(clk), .data(w_d),",
      "            .qdata(sx_q[j]));",
      "    end endgenerate",
      "    reg [8:0] cc;",
      "    always @(posedge clk or negedge rs_g) if (!rs_g) cc <= 9'd0; else cc <= cc + 9'd1;",
      "    wire [127:0] td_d;",
      "    ot_coll_sring512_native32 #(.W(128), .ID(QI*4 + 2)) u_sd (.clk(clk), .wa(cc), .ra(cc - 9'(LS + 1)), .wd(w_d), .rd(td_d));"
    ],
