read_verilog -sv /srv/opentallas-scratch2/claude/hb4_lec/mut/gold.sv
hierarchy -top lec_top
setattr -mod -unset keep_hierarchy *
proc; flatten; async2sync; opt_clean
rename lec_top gold
design -stash gold
read_verilog -sv /srv/opentallas-scratch2/claude/hb4_lec/mut/gate.sv
hierarchy -top lec_top
setattr -mod -unset keep_hierarchy *
proc; flatten; async2sync; opt_clean
rename lec_top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 2
equiv_induct
equiv_status -assert
