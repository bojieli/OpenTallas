 "latency": {
  "KQ_SHARE_EDGES": 2,
  "applies_to": "every COLL kq bank write of BOTH writers: A = hb_coll_<q> v6 writer (bank samples low C+2 -> C+4, high C+3 -> C+5 from ingress capture C), B = hcollgl_<q> gather land (publish IE+32+2h -> IE+34+2h, self-land IE+27 -> IE+29)",
  "fault": "+1 (sticky diagnostic)",
  "calendar": "every COLL kq wslot reservation (code 2) moves 2 calendar words later (tools/hgi_sim/collq_gather_1018.py KQ_SHARE_EDGES for B; the COLL v6 writer's kq reservations must add the same 2)",
  "gather_span": "+2 (38 -> 40 fixed edges): results/arch/hbm_die_d4g/collq/collq_schedule.json regenerated"
 },
 "tile_split": {
  "decision": "4 leaves per quadrant (one per bank pair, one clock clk_pair[p] each), hardened once as hcoll_kqs_leaf_1018 129.6 x 129.6 (562 pins per face, 4.3/um), placed at the WRITER end abutting coll_<q>/collgl_<q>",
  "why": "A (hb_coll) and B (hcollgl) both originate beside coll_<q>; at the writer end only the merged 2,248-b word runs the 3-8 mm to the vmb pairs; leaves beside the bank pairs would carry A and B (4,496 b) over that distance",
  "faces": {
   "E": "a_kq (from hb_coll)",
   "N": "b_kq (from hcollgl)",
   "W": "vm_kq (to the bank pair)",
   "S": "clk, rst_n, fault"
  },
  "orient": "die flow picks R0/MX/MY/R180 per slot so E faces coll and N faces collgl"
 },
