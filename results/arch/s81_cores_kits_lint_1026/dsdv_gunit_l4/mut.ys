hierarchy -check -top dsdv_gunit_l4
proc
memory
flatten
opt_clean
async2sync
rename -top gold
design -stash gold
read_verilog -defer -sv -noautowire -I/eq/mut /eq/mut/ot_rst_relay.sv
read_verilog -defer -sv -noautowire -I/eq/mut /eq/mut/ot_hdc_fastfp_lat_f12.sv
