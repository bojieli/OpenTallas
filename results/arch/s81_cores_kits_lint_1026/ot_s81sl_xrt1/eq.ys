verilog_defines -DSYNTHESIS
read_verilog -defer -sv -noautowire -I/eq/gold /eq/gold/ot_rst_relay.sv
read_verilog -defer -sv -noautowire -I/eq/gold /eq/gold/ot_s81sl_xrt.sv
hierarchy -check -top ot_s81sl_xrt1 -chparam FOREG 0
proc
memory
flatten
opt_clean
async2sync
rename -top gold
design -stash gold
read_verilog -defer -sv -noautowire -I/work/rtl /work/rtl/ot_rst_relay.sv
read_verilog -defer -sv -noautowire -I/work/rtl /work/rtl/ot_s81sl_xrt.sv
hierarchy -check -top ot_s81sl_xrt1 -chparam FOREG 0
proc
memory
flatten
opt_clean
async2sync
rename -top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
