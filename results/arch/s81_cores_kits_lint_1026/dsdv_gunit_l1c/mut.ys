verilog_defines -DSYNTHESIS
read_verilog -defer -sv -noautowire -I/eq/gold /eq/gold/ot_rst_relay.sv
read_verilog -defer -sv -noautowire -I/eq/gold /eq/gold/dsdv_gunit_sel.sv
read_verilog -defer -sv -noautowire -I/eq/gold /eq/gold/dsdv_gunit_l1c.sv
hierarchy -check -top dsdv_gunit_l1c
proc
memory
flatten
opt_clean
async2sync
rename -top gold
design -stash gold
verilog_defines -DOT_RTLC_MUT_L1C
read_verilog -defer -sv -noautowire -I/eq/mut /eq/mut/ot_rst_relay.sv
read_verilog -defer -sv -noautowire -I/eq/mut /eq/mut/dsdv_gunit_sel.sv
read_verilog -defer -sv -noautowire -I/eq/mut /eq/mut/dsdv_gunit_l1c.sv
hierarchy -check -top dsdv_gunit_l1c
proc
memory
flatten
opt_clean
async2sync
rename -top gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 2
equiv_induct -seq 2
equiv_status -assert
