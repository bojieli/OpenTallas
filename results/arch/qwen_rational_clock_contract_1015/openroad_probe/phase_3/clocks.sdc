create_clock -name pll_ref -period 5000 [get_ports pll_ref]
create_generated_clock -name core -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 6 [get_pins core_gen/Y]
create_generated_clock -name fdi_ck -master_clock pll_ref -source [get_ports pll_ref] -edges {1 2 3} -edge_shift {500.000000000000 -1500.000000000000 -3500.000000000000} [get_pins fdi_gen/Y]
create_generated_clock -name rx0_ck -master_clock pll_ref -source [get_ports pll_ref] -edges {1 2 3} -edge_shift {500.000000000000 -1500.000000000000 -3500.000000000000} [get_pins rx0_gen/Y]
create_generated_clock -name rx1_ck -master_clock pll_ref -source [get_ports pll_ref] -edges {1 2 3} -edge_shift {500.000000000000 -1500.000000000000 -3500.000000000000} [get_pins rx1_gen/Y]
create_generated_clock -name rx2_ck -master_clock pll_ref -source [get_ports pll_ref] -edges {1 2 3} -edge_shift {500.000000000000 -1500.000000000000 -3500.000000000000} [get_pins rx2_gen/Y]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 10 -clock core [get_ports d]
set_input_delay 10 -clock fdi_ck -add_delay [get_ports shared_rx]
set_input_delay 10 -clock rx0_ck -add_delay [get_ports shared_rx]
set_input_delay 10 -clock rx1_ck -add_delay [get_ports shared_rx]
set_input_delay 10 -clock rx2_ck -add_delay [get_ports shared_rx]
