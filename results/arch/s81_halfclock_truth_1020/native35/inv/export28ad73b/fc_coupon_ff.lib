        timing_type : rising_edge;
        cell_rise(template_2) {
          index_1("0.72000,  1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000");
          values("101.80981,105.14419,110.58955,119.70747,135.66443,166.06938,226.36462");
