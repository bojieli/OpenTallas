create_clock -name input_clk -period 900 -waveform {23 377} [get_ports clk_in]
set_clock_latency -source 17 [get_clocks input_clk]
create_generated_clock -name ck_o_fwd -source [get_ports clk_in] -divide_by 1 -invert [get_ports clk_out]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 70 -clock input_clk [get_ports d]
set_output_delay 50 -clock input_clk [get_ports q]
set_input_transition 20 [get_ports clk_in]
set_input_transition 15 [get_ports d]
set_load 37 [get_ports clk_out]
set_load 20 [get_ports q]
set_propagated_clock [all_clocks]
