library (fc_coupon_ss_forwarded) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 0.63;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("fc_coupon") {
    area : 0.364 
    is_macro_cell : true;
    pin("clk_in") {
      direction : input;
      capacitance : 4.2738;
    }
    pin("clk_out") {
      direction : output;
      capacitance : 2.1280;
      timing() {
        related_pin : "clk_in";
        timing_sense : negative_unate;
        timing_type : combinational;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("100.39268,104.34969,110.64253,123.09348,147.70021,196.84369,295.15936");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("13.92010,19.63581,32.00449,58.03670,112.11281,221.15036,439.45551");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("77.35883,80.62762,85.68661,95.06878,113.61475,150.76857,225.16647");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("10.82509,14.82592,23.29225,41.17002,78.59586,154.93117,307.81967");
        }
      }
    }
    pin("d") {
      direction : input;
      capacitance : 2.0610;
    }
    pin("q") {
      direction : output;
      capacitance : 1.4322;
    }
  }

}
