library (fc_coupon_tt_forwarded) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 0.70;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("fc_coupon") {
    area : 0.364 
    is_macro_cell : true;
    pin("ck") {
      direction : input;
      capacitance : 6.6118;
    }
    pin("ck_o") {
      direction : output;
      capacitance : 4.2560;
      timing() {
        related_pin : "ck";
        timing_sense : negative_unate;
        timing_type : combinational;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("76.12841,79.26368,84.09609,92.01453,107.28111,137.65738,198.39035");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("11.28588,15.00014,22.34798,37.79535,70.18800,137.14653,272.24609");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("67.38459,70.20604,74.50893,81.34561,93.79989,118.70403,168.63498");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("9.20830,12.49497,18.27083,29.94600,54.57126,105.69709,209.47658");
        }
      }
    }
    pin("d") {
      direction : input;
      capacitance : 3.6313;
    }
    pin("q") {
      direction : output;
      capacitance : 2.8643;
    }
  }

}
