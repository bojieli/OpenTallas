library (fc_coupon_ff_forwarded) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 0.0;
  nom_voltage                    : 0.77;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("fc_coupon") {
    area : 0.539 
    is_macro_cell : true;
    pin("ck") {
      direction : input;
      capacitance : 3.2924;
    }
    pin("ck_o") {
      direction : output;
      capacitance : 1.1517;
      timing() {
        related_pin : "ck";
        timing_sense : negative_unate;
        timing_type : combinational;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("97.41723,99.72982,103.83101,111.59097,126.84572,157.23810,217.93810");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("7.61333,11.68242,19.95986,36.84299,71.06668,139.93100,277.88904");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("89.27900,91.48926,95.30718,102.24935,115.70682,142.49167,195.98189");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("6.99644,10.42751,17.26706,31.14941,59.35947,116.35451,230.77367");
        }
      }
    }
    pin("d") {
      direction : input;
      capacitance : 2.1597;
    }
    pin("q") {
      direction : output;
      capacitance : 1.4322;
    }
  }

}
