read_verilog -sv -DSYNTHESIS -DOT_SMH_RP4_SRST /l/eq/bb.sv /l/eq/gold.sv /l/eq/gate.sv
chparam -set P 3 lfx_gold lfx_gate
proc
flatten
opt_clean
cd lfx_gate; rename g_ln[0].u_lane.u_bdc g_ln[0].u_bdc; cd ..
cd lfx_gate; rename g_ln[0].u_lane.u_tcc g_ln[0].u_tcc; cd ..
cd lfx_gate; rename g_ln[1].u_lane.u_bdc g_ln[1].u_bdc; cd ..
cd lfx_gate; rename g_ln[1].u_lane.u_tcc g_ln[1].u_tcc; cd ..
cd lfx_gate; rename g_ln[2].u_lane.u_bdc g_ln[2].u_bdc; cd ..
cd lfx_gate; rename g_ln[2].u_lane.u_tcc g_ln[2].u_tcc; cd ..
select -module lfx_gate w:*.u_lane.*
select -clear
async2sync
equiv_make lfx_gold lfx_gate eqm
hierarchy -top eqm
equiv_simple -seq 2
equiv_status
