read_verilog -sv -formal -DSYNTHESIS -DOT_CMD_FIRE_EARLY -DFORMAL -DOT_CMD_FIRE_EARLY_NEG /eq/candidate.sv
chparam -set MODE 1 -set CW 308 -set RELF 2 -set TGT_PIN 1 -set NA 1 -set NF 1 -set DATA_RESET_REPLICAS 1 cp_rstrep_core
hierarchy -top cp_rstrep_core
proc; flatten; opt_clean; async2sync
sat -tempinduct -prove-asserts -set-at 1 rst_n 0 -maxsteps 30 -verify
