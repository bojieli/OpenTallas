VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tiny ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 100000 100000 ) ;
TRACKS X 100 DO 100 STEP 1000 LAYER M1 M2 M3 ;
TRACKS Y 100 DO 100 STEP 1000 LAYER M1 M2 M3 ;
COMPONENTS 2 ;
- a TILE + FIXED ( 20000 20000 ) N ;
- b TILE + FIXED ( 70000 70000 ) N ;
END COMPONENTS
PINS 4 ;
- clk + NET clk + DIRECTION INPUT + USE CLOCK + PORT + LAYER M2 ( -100 -100 ) ( 100 100 ) + FIXED ( 10100 21000 ) N ;
- vdd + NET VDD + DIRECTION INOUT + USE POWER + PORT + LAYER M1 ( -100 -100 ) ( 100 100 ) + FIXED ( 5000 20100 ) N ;
- din + NET sig_in + DIRECTION INPUT + USE SIGNAL + PORT + LAYER M3 ( -100 -100 ) ( 100 100 ) + FIXED ( 100 25100 ) N ;
- dout + NET sig_out + DIRECTION OUTPUT + USE SIGNAL + PORT + LAYER M3 ( -100 -100 ) ( 100 100 ) + FIXED ( 99900 75100 ) N ;
END PINS
NETS 1 ;
- clk ( PIN clk ) ( a CK ) ( b CK ) + USE CLOCK
 + FIXED M2 ( 10100 21000 ) ( 10100 71000 ) VIA23
 NEW M3 ( 10100 71000 ) ( 70100 71000 )
 NEW M2 ( 10100 21000 ) VIA23
 NEW M3 ( 10100 21000 ) ( 20100 21000 ) ;
END NETS
SPECIALNETS 1 ;
- VDD ( PIN vdd ) ( a VDD ) ( b VDD ) + USE POWER
 + FIXED M1 200 ( 5000 20100 ) ( 25000 20100 ) VIA12
 NEW M2 200 ( 25000 20100 ) ( 25000 70100 ) VIA12
 NEW M1 200 ( 25000 70100 ) ( 75000 70100 ) ;
END SPECIALNETS
END DESIGN
