read_verilog -sv -DSYNTHESIS   gold_xr1/rtl/lib/ot_rst_relay.sv gold_xr1/rtl/dsrom_sys/s81_dv/slice/ot_s81sl_xr.sv
hierarchy -check -top ot_s81sl_xr1
proc; flatten; opt -full; opt_dff -sat; opt -full; opt_clean -purge; async2sync; opt_clean
rename ot_s81sl_xr1 gold
design -stash gold
read_verilog -sv -DSYNTHESIS   new/rtl/lib/ot_rst_relay.sv new/rtl/dsrom_sys/s81_dv/slice/ot_s81sl_xr.sv
hierarchy -check -top ot_s81sl_xr1
proc; flatten; opt -full; opt_dff -sat; opt -full; opt_clean -purge; async2sync; opt_clean
rename ot_s81sl_xr1 gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 8
equiv_induct -seq 8
tee -o out/xr1_foreg0/equiv_status.txt equiv_status
equiv_status -assert
