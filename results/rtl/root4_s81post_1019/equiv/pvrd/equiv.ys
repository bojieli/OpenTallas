read_verilog -sv -DSYNTHESIS   gold_pvrd/rtl/dsrom_sys/s81_dv/land/dsfd_dvland_pvrd.sv gold_pvrd/rtl/dsrom_sys/s81_dv/land/ot_s81_land.sv
hierarchy -check -top dsfd_dvland_pvrd
proc; flatten; opt -full; opt_dff -sat; opt -full; opt_clean -purge; async2sync; opt_clean
rename dsfd_dvland_pvrd gold
design -stash gold
read_verilog -sv -DSYNTHESIS   new/rtl/dsrom_sys/s81_dv/land/dsfd_dvland_pvrd.sv new/rtl/dsrom_sys/s81_dv/land/ot_s81_land.sv
hierarchy -check -top dsfd_dvland_pvrd
proc; flatten; opt -full; opt_dff -sat; opt -full; opt_clean -purge; async2sync; opt_clean
rename dsfd_dvland_pvrd gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple -seq 8
equiv_induct -seq 8
tee -o out/pvrd/equiv_status.txt equiv_status
equiv_status -assert
