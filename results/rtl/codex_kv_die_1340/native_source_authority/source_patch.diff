diff --git a/tools/qwen_kv_die/kv_bound_netlist.py b/tools/qwen_kv_die/kv_bound_netlist.py
index 6a5f11794..6f98cbe34 100755
--- a/tools/qwen_kv_die/kv_bound_netlist.py
+++ b/tools/qwen_kv_die/kv_bound_netlist.py
@@ -198,6 +198,21 @@ def main(argv=None):
     bindings = dict(PHY_BINDINGS, **K.BINDINGS)
     files = [str(ROOT / b['file']) for b in bindings.values() if (ROOT / b['file']).exists()]
     files += [a.relay_rtl] if a.relay_rtl else []
+    # Native S6C ownership must be unique in the active compilation readset.
+    # Historical variants under rtl/ are indexed for dependencies, but an active
+    # shared assembly may not redeclare a module owned by another binding file.
+    if any(b['module'] in ('qkd_kvs_grp_s6c', 'qkd_kvs_grp_h_s6c') for b in bindings.values()):
+        _active_definitions = defaultdict(list)
+        for _path in sorted(set(files)):
+            for _module in PB.parse_modules(PB.preprocess(PB.strip_comments(Path(_path).read_text()), {}), _path):
+                _active_definitions[_module.name].append(Path(_path).resolve())
+        for _binding in bindings.values():
+            if _binding['module'] not in ('qkd_kvs_grp_s6c', 'qkd_kvs_grp_h_s6c'):
+                continue
+            _authority = (ROOT / _binding['file']).resolve()
+            _conflicts = [p for p in _active_definitions[_binding['module']] if p != _authority]
+            if _conflicts:
+                raise SystemExit(f"kv_bound_netlist: {_binding['module']}: active compilation redeclares selected source {_authority}: {_conflicts}")
     idx, _amb = PB.rtl_index(['rtl'], files, {}, files)
     # The selected binding file is source authority. A module with the same name
     # elsewhere in the repository cannot replace a missing generated variant.
diff --git a/tools/qwen_kv_die/kv_port_bind_v2.sh b/tools/qwen_kv_die/kv_port_bind_v2.sh
index 31409c549..d3dc21b0f 100755
--- a/tools/qwen_kv_die/kv_port_bind_v2.sh
+++ b/tools/qwen_kv_die/kv_port_bind_v2.sh
@@ -53,6 +53,12 @@ grep -qE "qkd_(rlysh0?|landsh0?)_" "$D" && F+=(--rtl-file "$R/rtl/qwen_sys/kv_fw
 if [ "${OT_KV_STATIC_DIE:-0}" = 1 ]; then
   KT=$(cd $R/tools/qwen_kv_die && python3 -c 'import kv_static_die as S; print(S.RTL_FILE)' 2>/dev/null | tail -1)
   [ -n "$KT" ] && [ -f "$R/$KT" ] && F+=(--rtl-file "$R/$KT")
+  # The active S6C assembly deliberately omits the native registered groups.
+  # Pass their actual source files to BOTH strict compilation/hierarchy passes.
+  for NATIVE in $(cd "$R/tools/qwen_kv_die" && python3 -c 'import kv_static_die as S; print(" ".join(sorted(S.GRP_S6C_RTL.values())) if S.GRP_S6C else "")'); do
+    [ -f "$R/$NATIVE" ] || { echo "missing selected native RTL: $NATIVE"; exit 3; }
+    F+=(--rtl-file "$R/$NATIVE")
+  done
   # KV-FACELAND-WIRE 10-19: face-landed top tiles bind their kit's wrapper (<master>_fl; two files define qkd_kvs_attn_fl)
   for FLW in $(cd $R/tools/qwen_kv_die && python3 -c 'import kv_static_die as S; print(" ".join(sorted({b["file"] for b in S.bindings().values() if b["module"].endswith("_fl")})))' 2>/dev/null | tail -1); do
     [ -f "$R/$FLW" ] && F+=(--rtl-file "$R/$FLW" --rtl-file "$R/rtl/lib/ot_rst_relay.sv" --rtl-file "$R/rtl/lib/ot_pin_land.sv")
diff --git a/tools/qwen_kv_die/kv_static_die.py b/tools/qwen_kv_die/kv_static_die.py
index 13df760a6..4dc5c1a21 100644
--- a/tools/qwen_kv_die/kv_static_die.py
+++ b/tools/qwen_kv_die/kv_static_die.py
@@ -1698,6 +1698,11 @@ def rtl_text():
     """one module per tile kind; every replica must produce the identical text"""
     mods = OrderedDict()
     for d, t in all_tiles().items():
+        # S6C modules are registered native RTL, not the wires-only tile model.
+        # Keep the tile for placement/connections, but never emit a second body
+        # with the same module name into the active compilation unit.
+        if GRP_S6C and t['kind'] in GRP_S6C_RTL:
+            continue
         name = KIND_MASTER[t['kind']]
         txt = module_text(t, name)
         if name in mods and mods[name][0] != txt:
@@ -1720,6 +1725,8 @@ def sources():
     for t in all_tiles().values():
         for n in t['members']:
             s.add(ins()[n]['source'])
+    if GRP_S6C:
+        s.update(GRP_S6C_RTL.values())
     s.update(K.pc_emb_sources())
     if BOOT:
         s.update(BOOT_PC_DEPS)
