read_liberty -lib /src/physical/ref_tile/ot_hdc_v41x_idx_hslice_m5/views/ot_hdc_v41x_idx_hslice/ot_hdc_v41x_idx_hslice_tt.lib
read_liberty -lib /src/physical/ref_tile/hidx_tail_native_rr/views/ot_hbm_idx_tail_native/ot_hbm_idx_tail_native_tt.lib
