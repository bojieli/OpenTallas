  SPACING 0.384 ;
  WIDTH 0.384 ;
END V5
LAYER M6
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 1.024 ;
  WIDTH 0.512 ;
  SPACING 0.512 ;
  OFFSET 0.256 ;
END M6
LAYER V6
  TYPE CUT ;
  SPACING 0.512 ;
  WIDTH 0.512 ;
END V6
LAYER M7
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 1.024 ;
  WIDTH 0.512 ;
  SPACING 0.512 ;
  OFFSET 0.256 ;
END M7
LAYER V7
  TYPE CUT ;
  SPACING 0.512 ;
  WIDTH 0.512 ;
END V7
LAYER M8
  TYPE ROUTING ;
  DIRECTION HORIZONTAL ;
  PITCH 1.280 ;
  WIDTH 0.640 ;
  SPACING 0.640 ;
  OFFSET 1.856 ;
END M8
LAYER V8
  TYPE CUT ;
  SPACING 0.640 ;
  WIDTH 0.640 ;
END V8
LAYER M9
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 1.280 ;
  WIDTH 0.640 ;
  SPACING 0.640 ;
  OFFSET 1.856 ;
END M9
VIA VIA12 DEFAULT
  LAYER M1 ;
    RECT -0.144 -0.144 0.144 0.144 ;
  LAYER V1 ;
    RECT -0.144 -0.144 0.144 0.144 ;
  LAYER M2 ;
    RECT -0.144 -0.144 0.144 0.144 ;
END VIA12
VIA VIA23 DEFAULT
  LAYER M2 ;
    RECT -0.144 -0.144 0.144 0.144 ;
  LAYER V2 ;
    RECT -0.144 -0.144 0.144 0.144 ;
  LAYER M3 ;
