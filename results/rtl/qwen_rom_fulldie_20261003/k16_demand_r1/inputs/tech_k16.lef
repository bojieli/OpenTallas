  TYPE CUT ;
  SPACING 0.384 ;
  WIDTH 0.384 ;
END V4
LAYER M5
  TYPE ROUTING ;
  DIRECTION VERTICAL ;
  PITCH 0.768 ;
  WIDTH 0.384 ;
  SPACING 0.384 ;
  OFFSET 0.192 ;
END M5
LAYER V5
