create_clock -name pll_ref -period 5000 [get_ports pll_ref]
create_generated_clock -name core -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 6 [get_pins u_gen_core/Y]
create_generated_clock -name fdi -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 5 [get_pins u_gen_fdi/Y]
create_generated_clock -name rx0 -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 5 [get_pins u_gen_rx0/Y]
create_generated_clock -name rx1 -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 5 [get_pins u_gen_rx1/Y]
create_generated_clock -name rx2 -master_clock pll_ref -source [get_ports pll_ref] -multiply_by 5 [get_pins u_gen_rx2/Y]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core -add_delay [get_ports {tx_valid tx_frame*}]
set_output_delay 166.667 -clock core -add_delay [get_ports {rx_valid rx_frame* core_fault}]
set_output_delay 200.000 -clock fdi -add_delay [get_ports {phy_tx_valid phy_tx_frame* fdi_fault}]
set_input_delay 200.000 -clock fdi -add_delay [get_ports {phy_rx_valid phy_rx_frame*}]
set_input_delay 200.000 -clock rx0 -add_delay [get_ports {phy_rx_valid phy_rx_frame*}]
set_input_delay 200.000 -clock rx1 -add_delay [get_ports {phy_rx_valid phy_rx_frame*}]
set_input_delay 200.000 -clock rx2 -add_delay [get_ports {phy_rx_valid phy_rx_frame*}]
set_input_delay 166.667 -clock core -add_delay [get_ports {rst_n}]
