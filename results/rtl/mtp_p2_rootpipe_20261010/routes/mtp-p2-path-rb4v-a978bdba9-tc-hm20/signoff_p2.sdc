# generated by physical/dsrom_fh_safe/cl_route.sh (p2): insertion SS 535 / FF 437 ps
create_clock -name core_clk -period 833.333 [get_ports clk]
set_propagated_clock [all_clocks]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
create_clock -name vclk_io -period 833.333
if {[llength [get_libs -quiet *_FF_*]]} { set_clock_latency 437 [get_clocks vclk_io] } else { set_clock_latency 535 [get_clocks vclk_io] }
set_clock_uncertainty -setup 60 [get_clocks vclk_io]
set_clock_uncertainty -hold 25 [get_clocks vclk_io]
set_input_delay -max 250 -clock vclk_io [all_inputs -no_clocks]
set_input_delay -min 0 -clock vclk_io [all_inputs -no_clocks]
set_output_delay -max 250 -clock vclk_io [all_outputs]
set_output_delay -min -50 -clock vclk_io [all_outputs]
set_load 3.898 [all_outputs]
set_false_path -from [get_ports rst_n]

