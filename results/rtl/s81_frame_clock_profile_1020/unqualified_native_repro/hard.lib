library(hard_tt) { time_unit : "1ps"; capacitive_load_unit(1,ff); nom_voltage : 0.7; nom_temperature : 25; nom_process : 1; cell(cf) { area : 100; pin("C0") { direction : input; clock : true; capacitance : 1; }
