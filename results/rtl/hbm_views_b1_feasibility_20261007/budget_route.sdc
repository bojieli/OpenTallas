# generated by tools/budgets/make_block_sdc.py sdc hfd_index_q_b1 --mode route from its budget sheet
# vclk at the sheet insertion 1139 ps (measured: closure-loop calibrate hbm_idxq_b1_48529891f (ot-epyc2:/srv/opentallas-scratch2/scratch/claude/closure-loop/hbm_idxq_b1_48529891f)); target 1154 ps; die entry target SS {'mean': 2883.2, 'min': 2881.7, 'max': 2884.8}
create_clock -name vclk -period [get_property [get_clocks core_clk] period]
set_clock_uncertainty -setup 123 [get_clocks {core_clk vclk}]
set_clock_uncertainty -hold 25 [get_clocks {core_clk vclk}]
set_clock_latency 1139 [get_clocks {core_clk vclk}]
set ot_in [all_inputs -no_clocks]
unset_input_delay -clock core_clk $ot_in
unset_output_delay -clock core_clk [all_outputs]
# a0i input 529b: L 0.3 um (pins), intra skew 94.4
set_input_delay 224.8 -clock vclk [get_ports -quiet {a0i a0i[*]}]
set_input_delay -min 32.2 -clock vclk [get_ports -quiet {a0i a0i[*]}]
# a0o output 529b: L 1.7 um (pins), intra skew 101.8
set_output_delay 174.7 -clock vclk [get_ports -quiet {a0o a0o[*]}]
set_output_delay -min -14.8 -clock vclk [get_ports -quiet {a0o a0o[*]}]
# kin input 513b: L 0.3 um (pins), intra skew 94.4
set_input_delay 224.8 -clock vclk [get_ports -quiet {kin kin[*]}]
set_input_delay -min 32.2 -clock vclk [get_ports -quiet {kin kin[*]}]
# kout output 513b: L 1.7 um (pins), intra skew 101.8
set_output_delay 174.7 -clock vclk [get_ports -quiet {kout kout[*]}]
set_output_delay -min -14.8 -clock vclk [get_ports -quiet {kout kout[*]}]
# reset release (rst_mcp2, as make_io_vclk.sh)
set ot_rst {}
foreach ot_c [get_cells *] { if {[string match {rst_s\[1\]*} [get_full_name $ot_c]]} { lappend ot_rst $ot_c } }
if {[llength $ot_rst]} { set_multicycle_path -setup 2 -from $ot_rst; set_multicycle_path -hold 1 -from $ot_rst }
