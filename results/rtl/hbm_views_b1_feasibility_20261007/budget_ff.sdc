# generated by tools/budgets/make_block_sdc.py ff hfd_index_q_b1: FF hold sign-off post-SDC (sheet insertion FF min 724 / max 804, 50 ps hold IO uncertainty)
set_clock_latency 724 [get_clocks vclk]
create_clock -name vclki -period [get_property [get_clocks core_clk] period]
set_clock_latency 804 [get_clocks vclki]
unset_input_delay -clock vclk [get_ports -quiet {a0i a0i[*]}]
set_input_delay 224.8 -clock vclki [get_ports -quiet {a0i a0i[*]}]
set_input_delay -min 32.2 -clock vclki [get_ports -quiet {a0i a0i[*]}]
unset_input_delay -clock vclk [get_ports -quiet {kin kin[*]}]
set_input_delay 224.8 -clock vclki [get_ports -quiet {kin kin[*]}]
set_input_delay -min 32.2 -clock vclki [get_ports -quiet {kin kin[*]}]
set_clock_uncertainty -hold 50 -from [get_clocks vclki] -to [get_clocks core_clk]
set_clock_uncertainty -hold 50 -from [get_clocks core_clk] -to [get_clocks vclk]
