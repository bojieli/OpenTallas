+    input  wire [31:0] b,
+    output wire [31:0] y,
+    output wire        fault
+);
+    generate if (LAT == 3) begin : g_q
+        ot_hdc_qadd u (clk, rst_n, v, a, b, y, fault);
+    end else begin : g_l
+        ot_qwen_w12_ladd #(.LAT(LAT)) u (clk, rst_n, v, a, b, y, fault);
+    end endgenerate
