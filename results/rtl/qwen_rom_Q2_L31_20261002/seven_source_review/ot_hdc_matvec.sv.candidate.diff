+    output wire [31:0] y,
+    output wire        fault
+);
+    wire [1:0] err;
+    wire vo;
+    ot_hdc_fp32_add_lat #(.LAT(LAT)) u (.clk(clk), .rst_n(rst_n), .valid_in(v), .a(a), .b(b), .y(y), .err(err),
+                                        .valid_out(vo));
+    assign fault = vo && (err != 2'd0);
