+    function automatic integer cnt(input integer l);
+        integer i, n;
+        begin n = N; for (i = 0; i < l; i = i + 1) n = nxt(n); cnt = n; end
+    endfunction
+    function automatic integer depth(input integer d);
+        integer n, l;
+        begin n = N; l = 0; while (n > 2) begin n = nxt(n); l = l + 1; end depth = l; end
+    endfunction
