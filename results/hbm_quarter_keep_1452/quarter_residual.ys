read_verilog -lib physical/asap7_memory_macros_v2/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v
read_verilog -sv -DSYNTHESIS rtl/hbm_next/idxn/ot_hnx_idxn_keybuf.sv
read_verilog -sv -DSYNTHESIS rtl/lib/ot_rst_delivered3.sv
read_verilog -sv -DSYNTHESIS rtl/lib/ot_rst_relay.sv
read_verilog -sv -DSYNTHESIS rtl/hdc/v41x/ot_hbm_idx_chunk_rt_h.sv
read_verilog -sv -DSYNTHESIS rtl/hbm_accel/index/quad_1017/ot_hbm_idx_score_quarter_static_h.sv
read_verilog -sv -DSYNTHESIS rtl/hdc/ot_hdc_delay.sv
read_verilog -sv -DSYNTHESIS rtl/hdc/v41x/ot_hbm_idx_owned_native.sv
read_verilog -sv -DSYNTHESIS rtl/hdc/ot_hdc_delay_rf.sv
read_verilog -sv -DSYNTHESIS rtl/hbm_accel/index/hidx_meta_w25_d123_r0.sv
read_verilog -sv -DSYNTHESIS rtl/hbm_accel/index/quad_1017/ot_hbm_idx_score_fault_static.sv
read_verilog -sv -DSYNTHESIS rtl/hbm_next/idxn/ot_hnx_idxn_quarter_with_keybuf.sv
blackbox ot_hidx_score_hcol
blackbox ot_hbm_idx_tail_native
chparam -set DELIVERED_RESET 1 ot_hnx_idxn_quarter_with_keybuf
chparam -set TP 192 ot_hnx_idxn_quarter_with_keybuf
hierarchy -check -top ot_hnx_idxn_quarter_with_keybuf
tcl physical/common_flow/ot_keep_regs.tcl
tee -o /out/quarter_residual.hier.stat stat
synth -top ot_hnx_idxn_quarter_with_keybuf -flatten
dfflibmap -liberty /tmp/lib/seq.lib
abc -liberty /tmp/lib/all.lib
opt_clean
tee -o /out/quarter_residual.stat stat -liberty /tmp/lib/all.lib
write_verilog -noattr /out/quarter_residual.netlist.v
write_json /out/quarter_residual.mapped.json
