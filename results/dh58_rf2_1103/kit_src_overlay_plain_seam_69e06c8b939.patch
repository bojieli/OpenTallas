+                    + _ft_delay_lines("input", [f"{n}_i" for n in slots], (1 - sh) * per,
+                                      {k: t_lib(v) for k, v in s_in.items()}, lambda v: f"{v + t_lib(tw_in):.4f}")
+                    + _ft_delay_lines("output", [f"{n}_o" for n in slots], sh * per,
