set f [open /work/corners.tcl];set s [read $f];close $f
eval [string range $s 0 [expr {[string first "# GENERATED by gen_core_kit_legacy.py:" $s]-1}]]
ot_lib_load TT /work/placed_tt_libraries.json
read_db /work/run/results/asap7/kl_ot_s81_rck_rxs_vB/base/3_place.odb
read_sdc /work/constraint.sdc
source /work/setRC_rcx.tcl
estimate_parasitics -placement
report_checks -path_delay max -group_path_count 5 -format full_clock_expanded -fields {slew cap fanout} > /work/placed_tt_max.rpt
set rp {}
foreach p [all_registers -output_pins] {if {[string match *u_bm* [get_full_name $p]]} {lappend rp $p}}
puts "BM recurrence start pins [llength $rp]"
report_checks -from $rp -path_delay max -group_path_count 3 -format full_clock_expanded -fields {slew cap fanout} > /work/placed_tt_bm_recurrence.rpt
report_worst_slack -max
report_tns
puts "RCK_PLACED_TT_DONE"
