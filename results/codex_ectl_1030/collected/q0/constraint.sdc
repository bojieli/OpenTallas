# GENERATED by gen_core_kit_kv.py: core qkd_ectlk_q0__216x172.8; ps / fF (ASAP7 liberty units).
create_clock -name clk -period 833.0000 [get_ports {ck}]
# the partition logic around the core runs on the budgeted insertion (250 ps): virtual IO clock
create_clock -name vclk -period 833.0000
set_clock_latency -source 250.0000 [get_clocks vclk]
set_clock_uncertainty 60.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 30.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 30.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [get_ports {rsp_epoch rsp_layer rsp_t rsp_v rsp_valid s2 s3 rst_n s0 s1 si cfg epoch kgo layer rsp_data}]
set_input_delay -max 166.6000 -clock vclk $non_clk_in
set_input_delay -min -40.0000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk [get_ports {so t0 e2 e3 fault req_epoch req_layer req_t req_valid}]
set_output_delay -min 0.0000 -clock vclk [get_ports {so t0 e2 e3 fault req_epoch req_layer req_t req_valid}]
# reset rst_n: wavefront relay -> registered synchronous input, data IO budget (166.6000)
set_load 2 [get_ports {so t0 e2 e3 fault req_epoch req_layer req_t req_valid}]
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
