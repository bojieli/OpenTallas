hierarchy -check -top ot_reduction_endpoint -chparam DATA_W 32 -chparam GROUPS 2 -chparam SOURCES 8 -chparam TAG_W 16
proc
memory
flatten
opt_clean
write_json /work/equivalence_mapped_gold_transition_pre_state.json
