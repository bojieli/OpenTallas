dffunmap
splitnets -ports
opt_clean
select -assert-any t:$dff
select -assert-none t:$adff t:$adffe t:$sdff t:$sdffe t:$sdffce t:$dffe t:$dffsr t:$dffsre t:$dlatch t:$adlatch t:$dlatchsr t:$_DFF_* t:$_DFFE_* t:$_DFFSR_* t:$_DFFSRE_* t:$_SDFF_* t:$_SDFFE_* t:$_SDFFCE_* t:$_DLATCH_* t:$_DLATCHSR_*
