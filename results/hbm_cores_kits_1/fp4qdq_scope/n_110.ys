read_verilog -sv /work/gold.sv
read_verilog -sv /work/gate.sv
chparam -set PACKED 1 -set PIPE 1 -set XEXT 0 gold gate
proc; opt_clean
tee -o /work/check_gold_110.txt check gold
memory; flatten; opt -fast
async2sync
equiv_make gold gate eq
hierarchy -top eq
equiv_simple -seq 2
equiv_induct -seq 2
tee -o /work/eq_110.txt equiv_status -assert
