foreach pgp_a $pgp_assignments {
  lassign $pgp_a pgp_name pgp_master pgp_x pgp_y pgp_orient
  set pgp_i [$pgp_block findInst $pgp_name]
  if {$pgp_i eq "NULL" || $pgp_i eq ""} { error "PROG proposal missing exact instance: $pgp_name" }
  if {[[$pgp_i getMaster] getName] ne $pgp_master} { error "PROG proposal master mismatch: $pgp_name" }
}
foreach pgp_a $pgp_assignments {
  lassign $pgp_a pgp_name pgp_master pgp_x pgp_y pgp_orient
  set pgp_i [$pgp_block findInst $pgp_name]
  $pgp_i setOrient $pgp_orient
  $pgp_i setLocation [expr {round($pgp_x*$pgp_dbu)}] [expr {round($pgp_y*$pgp_dbu)}]
  $pgp_i setPlacementStatus FIRM
}
puts "PROG_STATIC_CANDIDATE assigned [llength $pgp_assignments] exact data cells; native DPL/readback and clock/cut gates still required"
unset pgp_assignments pgp_block pgp_dbu pgp_a pgp_name pgp_master pgp_x pgp_y pgp_orient pgp_i
