VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN rcx_width_probe ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 440000 440000 ) ;
NONDEFAULTRULES 4 ;
- ndr_160 + LAYER M1 WIDTH 18 SPACING 18 + LAYER M2 WIDTH 18 SPACING 18 + LAYER M3 WIDTH 18 SPACING 18 + LAYER M4 WIDTH 24 SPACING 24 + LAYER M5 WIDTH 24 SPACING 24 + LAYER M6 WIDTH 32 SPACING 32 + LAYER M7 WIDTH 32 SPACING 32 + LAYER M8 WIDTH 160 SPACING 80 + LAYER M9 WIDTH 160 SPACING 80 ;
- ndr_320 + LAYER M1 WIDTH 18 SPACING 18 + LAYER M2 WIDTH 18 SPACING 18 + LAYER M3 WIDTH 18 SPACING 18 + LAYER M4 WIDTH 24 SPACING 24 + LAYER M5 WIDTH 24 SPACING 24 + LAYER M6 WIDTH 32 SPACING 32 + LAYER M7 WIDTH 32 SPACING 32 + LAYER M8 WIDTH 320 SPACING 80 + LAYER M9 WIDTH 320 SPACING 80 ;
