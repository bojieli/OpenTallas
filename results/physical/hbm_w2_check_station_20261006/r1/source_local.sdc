# SS60/FF25 actual mapped source-local receiver; actual die RC/insertion OPEN.
create_clock -name clk_sm -period 833.333333 [get_ports clk_sm]
set prev [get_ports clk_sm]
set master clk_sm
for {set i 0} {$i<4} {incr i} {
 set roots {}
 foreach p [get_pins -hierarchical *] {
  if {[regexp "u_clk${i}.*/Y$" [get_full_name $p]]} {lappend roots $p}
 }
 if {[llength $roots]!=1} {error "missing real kept station forwarding inverter $i"}
 create_generated_clock -name forwarded$i -source $prev -master_clock $master -divide_by 1 -invert [lindex $roots 0]
 set prev [lindex $roots 0];set master forwarded$i
}
create_generated_clock -name forwarded_port -source $prev -master_clock $master -divide_by 1 [get_ports fclk_o]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
foreach p [all_inputs] {
 if {[get_full_name $p] eq "clk_sm"} {continue}
 set_input_delay -min 0 -clock clk_sm $p
 set_input_delay -max 166.666667 -clock clk_sm $p
}
foreach p [all_outputs] {
 if {[get_full_name $p] eq "fclk_o"} {continue}
 set_output_delay -min 0 -clock clk_sm $p
 set_output_delay -max 166.666667 -clock clk_sm $p
}
set_max_fanout 32 [current_design]
set {cap_ss(clk_sm)} 6219.540826
set {cap_ss(por_n)} 10144.77324
set {cap_ss(in_v)} 124.544068
set {cap_ss(in_data[0])} 2.673896
