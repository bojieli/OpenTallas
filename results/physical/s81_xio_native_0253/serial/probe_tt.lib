    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 3.8152;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("44.78859");
        }
        cell_fall(scalar) {
          values("49.38269");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("47.96312");
        }
        cell_fall(scalar) {
          values("52.37802");
        }
      }
    }
    pin("fault") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("207.57925,210.92192,216.98906,228.55281,251.40318,297.00732,388.11633");
        }
