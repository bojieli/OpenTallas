# GENERATED by gen_core_kit_hbm.py (HBM-CORES-R11 2026-10-27, COORD 10:37 ruling 2): TT setup repair POST-CTS.
# HBM kits skip ORFS's own CTS repair (SKIP_CTS_REPAIR_TIMING=1: it would repair on the tree BEFORE the POST_CTS
# tap/leaf balance), so TT setup used to be repaired nowhere before DRT (aq_tree13 k2r: TT -20.41 reg2reg at GRT).
# This hook runs the kit's previous POST_CTS hook (balanced tree) and then a SETUP-ONLY repair: in the two-mode session
# (kit_modes.py stage, OT_HOLD_MM=1) setup is timed in scene tc (mode ss, vclk OT_VCLK_TT); mode ff never checks setup.
# Hold is NOT repaired here (FF hold belongs to the GRT step, scene BC / vclk OT_VCLK_FF).  OT_CTS_SETUP_TT=0 disables.
source {/work/f4_chain_leaf.tcl}
if {![info exists ::env(OT_CTS_SETUP_TT)] || $::env(OT_CTS_SETUP_TT) ne "0"} {
  estimate_parasitics -placement
  set ot_cst_b [worst_slack -max]
  puts [format "OT_CTS_SETUP_TT before: worst setup %.2f ps" $ot_cst_b]
  if {$ot_cst_b < 0} {
    repair_timing_helper -setup
    if {[catch {detailed_placement} ot_cst_msg]} { error "OT_CTS_SETUP_TT: detailed placement after setup repair failed: $ot_cst_msg" }
    check_placement -verbose
    estimate_parasitics -placement
  }
  puts [format "OT_CTS_SETUP_TT after: worst setup %.2f ps" [worst_slack -max]]
}
