set {cap_ff(ACK_frame[145])} 0.683678
set {cap_ff(release_r)} 0.620008
foreach p [all_outputs] {
 set n [get_full_name $p]
 set receiver {}
 if {[regexp {^out_data\[([0-9]+)\]$} $n -> bit]} {set receiver [format {in_data[%d]} [expr {$bit%2063}]]}
 if {[regexp {^out_owner\[([0-9]+)\]$} $n -> bit]} {set receiver [format {in_owner[%d]} [expr {$bit%192}]]}
 if {[regexp {^out_frame\[([0-9]+)\]$} $n -> bit]} {set receiver [format {in_frame[%d]} [expr {$bit%73}]]}
 if {[regexp {^out_v\[[0-9]+\]$} $n]} {set receiver in_v}
 if {$n eq "in_r" || $n eq "release_r"} {set receiver {out_r[1]}}
 if {$n eq "release_v"} {set receiver {ACK_v[0]}}
 if {[regexp {^release_owner\[([0-9]+)\]$} $n -> bit]} {set receiver [format {ACK_owner[%d]} $bit]}
 if {[regexp {^release_frame\[([0-9]+)\]$} $n -> bit]} {set receiver [format {ACK_frame[%d]} $bit]}
 if {$n in {fault paused drained}} {set receiver in_v}
 if {$n eq "fclk_o"} {set receiver clk_sm}
 if {$receiver eq "" || ![info exists cap_ss($receiver)] || ![info exists cap_ff($receiver)]} {error "unbound actual mapped receiver $n -> $receiver"}
 set_load -max $cap_ss($receiver) $p
 set_load -min $cap_ff($receiver) $p
}
