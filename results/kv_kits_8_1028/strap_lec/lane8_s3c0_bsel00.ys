design -reset
read_verilog -sv -DSYNTHESIS /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_rst_relay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_delay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_prod.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_head_hs.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat_nr.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_mul_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fastfp.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_prefix.sv  /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/old/rtl/hdc/nearhbm/ot_qkh_subtiles.sv
hierarchy -top ot_qkh_lane8 -chparam LT_COPY 1 -chparam ADD_LAT 7 -chparam LTW 12 -chparam S3_COPY 0
proc; setattr -mod -unset keep_hierarchy *; setattr -unset keep_hierarchy *; flatten; opt_clean
rename -top gold
delete -port gold/w:bsel
cd gold; connect -set bsel 2'b00; cd ..
opt -full; opt_dff -sat; opt -full; opt_clean; async2sync
stat
design -stash gold
design -reset
read_verilog -sv -DSYNTHESIS /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_rst_relay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_delay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_prod.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_head_hs.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat_nr.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_mul_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fastfp.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_prefix.sv  /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/new/rtl/hdc/nearhbm/ot_qkh_subtiles.sv
hierarchy -top ot_qkh_lane8 -chparam LT_COPY 1 -chparam ADD_LAT 7 -chparam LTW 12 -chparam S3_COPY 0 -chparam STRAP_DIRECT 1
proc; setattr -mod -unset keep_hierarchy *; setattr -unset keep_hierarchy *; flatten; opt_clean
rename -top gate
delete -port gate/w:bsel
cd gate; connect -set bsel 2'b00; cd ..
opt -full; opt_dff -sat; opt -full; opt_clean; async2sync
stat
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
equiv_make gold gate eq; hierarchy -top eq
equiv_simple -seq 3; equiv_induct -seq 3; equiv_status -assert
