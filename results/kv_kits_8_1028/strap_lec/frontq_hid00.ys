design -reset
read_verilog -sv -DSYNTHESIS /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_rst_relay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_delay.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_prod.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_qwen_nearhbm_head_hs.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_add_lat_nr.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fp32_mul_lat.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_fastfp.sv /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/leaf/ot_hdc_prefix.sv  /srv/opentallas-scratch2/claude/kv-kits-8-1028/strap_lec/old/rtl/qwen_sys/split_20261014/ot_qkh_head_native_r4.sv
hierarchy -top ot_qkh_head_frontq_native -chparam PORT_REGS 1 -chparam Q_FP32 1 -chparam MUT 0
proc; setattr -mod -unset keep_hierarchy *; setattr -unset keep_hierarchy *; flatten; opt_clean
