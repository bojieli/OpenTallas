{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentallas.example/schemas/compiler/qwen3/checkpoint_validation_v1.schema.json",
  "title": "OpenTallas Qwen3 official checkpoint validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_lock_id",
    "model_id",
    "parameter_count",
    "payload_bytes",
    "schema",
    "tensor_count",
    "tensor_structure_sha256",
    "validation_id"
  ],
  "properties": {
    "checkpoint_lock_id": {
      "$ref": "#/$defs/sha256"
    },
    "model_id": {
      "const": "qwen3-8b"
    },
    "parameter_count": {
      "const": 8190735360
    },
    "payload_bytes": {
      "const": 16381470720
    },
    "schema": {
      "const": "opentallas.qwen3.checkpoint_validation.v1"
    },
    "tensor_count": {
      "const": 399
    },
    "tensor_structure_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "validation_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
