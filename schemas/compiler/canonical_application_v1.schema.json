{
  "$id": "https://opentallas.org/schemas/compiler/canonical_application_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "$ref": "#/$defs/sha256"
    },
    "assignments": {
      "items": {
        "$ref": "#/$defs/assignment"
      },
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "evidence_scope": {
      "enum": [
        "development_fixture",
        "official_checkpoint"
      ]
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/input"
      },
      "minItems": 1,
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "schema": {
      "const": "opentallas.canonical_application.v1"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "status": {
      "enum": [
        "complete_official_transform_application",
        "development_fixture_application_not_release_evidence",
        "partial_official_transform_application_not_release_evidence"
      ]
    }
  },
  "required": [
    "application_id",
    "assignments",
    "coverage",
    "evidence_scope",
    "inputs",
    "plan",
    "schema",
    "selection",
    "source",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_scope": {
            "const": "development_fixture"
          }
        },
        "required": [
          "evidence_scope"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "development_fixture_application_not_release_evidence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_scope": {
            "const": "official_checkpoint"
          },
          "selection": {
            "properties": {
              "complete_plan": {
                "const": true
              }
            },
            "required": [
              "complete_plan"
            ]
          }
        },
        "required": [
          "evidence_scope",
          "selection"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "complete_official_transform_application"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_scope": {
            "const": "official_checkpoint"
          },
          "selection": {
            "properties": {
              "complete_plan": {
                "const": false
              }
            },
            "required": [
              "complete_plan"
            ]
          }
        },
        "required": [
          "evidence_scope",
          "selection"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial_official_transform_application_not_release_evidence"
          }
        }
      }
    }
  ],
  "title": "OpenTallas canonical checkpoint application v1",
  "type": "object",
  "$defs": {
    "assignment": {
      "additionalProperties": false,
      "properties": {
        "logical_dtype": {
          "$ref": "#/$defs/nonempty"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "payload_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "rank": {
          "minimum": 0,
          "type": "integer"
        },
        "scale_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/tensorSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "source": {
          "$ref": "#/$defs/tensorSource"
        },
        "storage_dtype": {
          "$ref": "#/$defs/dtype"
        },
        "transform": {
          "enum": [
            "dequantize_fp8_e8m0_to_bf16_rne",
            "identity",
            "reinterpret_i8_bytes_as_native_mxfp4_low_nibble_first"
          ]
        }
      },
      "required": [
        "logical_dtype",
        "name",
        "path",
        "payload_bytes",
        "rank",
        "scale_source",
        "sha256",
        "shape",
        "source",
        "storage_dtype",
        "transform"
      ],
      "type": "object"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "consumed_input_count": {
          "minimum": 1,
          "type": "integer"
        },
        "consumed_input_payload_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "output_assignment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "output_payload_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "consumed_input_count",
        "consumed_input_payload_bytes",
        "output_assignment_count",
        "output_payload_bytes"
      ],
      "type": "object"
    },
    "dtype": {
      "enum": [
        "BF16",
        "BOOL",
        "F16",
        "F32",
        "F64",
        "F8_E4M3",
        "F8_E5M2",
        "F8_E8M0",
        "I16",
        "I32",
        "I64",
        "I8",
        "U16",
        "U32",
        "U64",
        "U8"
      ]
    },
    "input": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/nonempty"
        },
        "logical_dtype": {
          "$ref": "#/$defs/nonempty"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "storage_dtype": {
          "$ref": "#/$defs/dtype"
        }
      },
      "required": [
        "action",
        "logical_dtype",
        "name",
        "payload_sha256",
        "shape",
        "size_bytes",
        "storage_dtype"
      ],
      "type": "object"
    },
    "name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,239}$",
      "type": "string"
    },
    "nonempty": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000\\\\]+$",
      "type": "string"
    },
    "plan": {
      "additionalProperties": false,
      "properties": {
        "expected_input_count": {
          "minimum": 1,
          "type": "integer"
        },
        "plan_id": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "required": [
        "expected_input_count",
        "plan_id",
        "schema"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "complete_plan": {
          "type": "boolean"
        },
        "dependency_input_names": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requested_input_names": {
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "complete_plan",
        "dependency_input_names",
        "requested_input_names"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "shape": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "slice": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        },
        "stop": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "axis",
        "start",
        "stop"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_lock_id": {
          "$ref": "#/$defs/sha256"
        },
        "repository": {
          "$ref": "#/$defs/nonempty"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_lock_id",
        "repository",
        "revision"
      ],
      "type": "object"
    },
    "tensorSource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "slice": {
          "oneOf": [
            {
              "$ref": "#/$defs/slice"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage_dtype": {
          "$ref": "#/$defs/dtype"
        }
      },
      "required": [
        "name",
        "payload_sha256",
        "shape",
        "slice",
        "storage_dtype"
      ],
      "type": "object"
    }
  }
}
