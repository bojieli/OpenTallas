      "type": "object"
    },
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "combination_destinations": { "const": 4 },
        "combination_sources": { "const": 4 },
        "flattened_width": { "const": 16384 },
        "hc_multiplier": { "const": 4 },
        "hidden_size": { "const": 4096 },
        "mix_fields": { "const": 24 },
        "post_fields": { "const": 4 },
        "pre_fields": { "const": 4 },
