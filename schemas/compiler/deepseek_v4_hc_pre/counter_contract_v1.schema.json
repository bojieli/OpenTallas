        "hc_pre_projection_rms_multiplies": { "const": 24 },
        "hc_pre_residual_bf16_values_preserved": { "const": 16384 },
        "hc_pre_rms_divides": { "const": 1 },
        "hc_pre_rms_epsilon_adds": { "const": 1 },
        "hc_pre_rms_reduction_adds": { "const": 16383 },
        "hc_pre_rms_square_multiplies": { "const": 16384 },
        "hc_pre_rsqrt_evaluations": { "const": 1 },
        "hc_pre_sigmoid_evaluations": { "const": 8 },
