{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/bf16_projection_expectations_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_id": {"$ref": "#/$defs/sha256"},
