{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/production_tensor_kernel_ir_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "graph_id": {"$ref": "#/$defs/sha256"},
    "kernel_ir_id": {"$ref": "#/$defs/sha256"},
    "kernels": {
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/lookup"},
          {"$ref": "#/$defs/matmul"},
          {"$ref": "#/$defs/rmsnorm"},
          {"$ref": "#/$defs/add"},
          {"$ref": "#/$defs/silu_mul"},
          {"$ref": "#/$defs/rope"},
          {"$ref": "#/$defs/kv_prepare"},
          {"$ref": "#/$defs/attention"},
          {"$ref": "#/$defs/state_commit"}
        ]
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "qualification_report_id": {"$ref": "#/$defs/sha256"},
    "schema": {"const": "opentallas.production_tensor_kernel_ir.v1"}
  },
  "required": ["graph_id", "kernel_ir_id", "kernels", "qualification_report_id", "schema"],
  "title": "OpenTallas production-neutral Tensor Kernel IR v1",
  "type": "object",
  "$defs": {
    "add": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "addition": {"const": "binary32_rne"},
            "input_dtype": {"const": "bf16"},
            "output_dtype": {"const": "bf16"},
            "output_rounding": {"const": "rne"},
            "zero_canonicalization": {"const": "positive"}
          },
          "required": ["addition", "input_dtype", "output_dtype", "output_rounding", "zero_canonicalization"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "ADD"},
        "numeric_contract": {"const": "bf16_add_rne_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {"$ref": "#/$defs/vector_shape"},
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "attention": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "causal_mask_bf16_code": {"const": 65407},
            "prepared_state_visibility": {"const": "transaction_private"},
            "probability_dtype": {"const": "bf16"},
            "query_heads_per_key_value_head": {"minimum": 1, "type": "integer"},
            "scale_bf16_code": {"const": 15797},
            "score_reduction_order": {"const": "strictly_increasing_head_dimension"},
            "softmax_compute_dtype": {"const": "fp32"},
            "softmax_reduction_lanes": {"const": 8},
            "value_reduction_order": {"const": "strictly_increasing_context"}
          },
          "required": [
            "causal_mask_bf16_code",
            "prepared_state_visibility",
            "probability_dtype",
            "query_heads_per_key_value_head",
            "scale_bf16_code",
            "score_reduction_order",
            "softmax_compute_dtype",
            "softmax_reduction_lanes",
            "value_reduction_order"
          ],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "ATTENTION"},
        "numeric_contract": {"const": "qwen3_gqa_fp32_softmax_bf16_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {"$ref": "#/$defs/attention_shape"},
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "attention_shape": {
      "additionalProperties": false,
      "properties": {
        "head_dim": {"minimum": 1, "type": "integer"},
        "key_value_heads": {"minimum": 1, "type": "integer"},
        "max_context_tokens": {"minimum": 1, "type": "integer"},
        "query_heads": {"minimum": 1, "type": "integer"},
        "query_tokens_symbol": {"$ref": "#/$defs/identifier"}
      },
      "required": ["head_dim", "key_value_heads", "max_context_tokens", "query_heads", "query_tokens_symbol"],
      "type": "object"
    },
    "identifier": {"minLength": 1, "type": "string"},
    "kv_prepare": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "append_position_symbol": {"$ref": "#/$defs/identifier"},
            "generation_check": {"const": "exact_expected_generation"},
            "state_resource": {"$ref": "#/$defs/identifier"},
            "transaction_scope": {"const": "model_forward_request"},
            "visibility": {"const": "transaction_private_until_commit"}
          },
          "required": ["append_position_symbol", "generation_check", "state_resource", "transaction_scope", "visibility"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "KV_PREPARE"},
        "numeric_contract": {"const": "bf16_byte_preserving_state_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {
          "additionalProperties": false,
          "properties": {
            "head_dim": {"minimum": 1, "type": "integer"},
            "key_value_heads": {"minimum": 1, "type": "integer"},
            "max_context_tokens": {"minimum": 1, "type": "integer"},
            "tokens_symbol": {"$ref": "#/$defs/identifier"}
          },
          "required": ["head_dim", "key_value_heads", "max_context_tokens", "tokens_symbol"],
          "type": "object"
        },
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "lookup": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "index_dtype": {"const": "u32"},
            "output_dtype": {"const": "bf16"},
            "source_index_max_exclusive": {"minimum": 1, "type": "integer"},
            "source_index_min": {"const": 0}
          },
          "required": ["index_dtype", "output_dtype", "source_index_max_exclusive", "source_index_min"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "EMBEDDING_LOOKUP"},
        "numeric_contract": {"const": "bf16_payload_lookup_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {"$ref": "#/$defs/vector_shape"},
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "matmul": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "accumulator_dtype": {"const": "fp32"},
            "input_dtype": {"const": "bf16"},
            "output_dtype": {"const": "bf16"},
            "output_rounding": {"const": "rne"},
            "reduction_order": {"const": "strictly_increasing_k"},
            "transpose_weight": {"const": true}
          },
          "required": [
            "accumulator_dtype",
            "input_dtype",
            "output_dtype",
            "output_rounding",
            "reduction_order",
            "transpose_weight"
          ],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "MATMUL"},
        "numeric_contract": {"const": "bf16_bf16_fp32_sequential_rne_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {
          "additionalProperties": false,
          "properties": {
            "reduction_width": {"minimum": 1, "type": "integer"},
            "rows": {"minimum": 1, "type": "integer"},
            "width": {"minimum": 1, "type": "integer"}
          },
          "required": ["reduction_width", "rows", "width"],
          "type": "object"
        },
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "one_identifier": {
      "items": {"$ref": "#/$defs/identifier"},
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "rmsnorm": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "epsilon_binary32_code": {"const": 897988541},
            "final_weight_product": {"const": "bf16_multiply_then_bf16_rne"},
            "normalized_boundary": {"const": "bf16_rne_before_weight"},
            "reduction_order": {"const": "canonical_balanced_binary32_tree"},
            "rsqrt": {"const": "correctly_rounded_binary32_rne"}
          },
          "required": ["epsilon_binary32_code", "final_weight_product", "normalized_boundary", "reduction_order", "rsqrt"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "RMS_NORM"},
        "numeric_contract": {"const": "qwen3_rmsnorm_fp32_bf16_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {"$ref": "#/$defs/vector_shape"},
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "rope": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "coefficient_layout": {"const": "cos_head_dim_then_sin_head_dim"},
            "key_value_heads": {"minimum": 1, "type": "integer"},
            "max_positions": {"minimum": 1, "type": "integer"},
            "position_symbol": {"$ref": "#/$defs/identifier"},
            "query_heads": {"minimum": 1, "type": "integer"},
            "rotation": {"const": "concat_neg_second_half_first_half"}
          },
          "required": [
            "coefficient_layout",
            "key_value_heads",
            "max_positions",
            "position_symbol",
            "query_heads",
            "rotation"
          ],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "ROPE"},
        "numeric_contract": {"const": "qwen3_rope_fp32_bf16_v1"},
        "outputs": {"$ref": "#/$defs/two_identifiers"},
        "shape": {
          "additionalProperties": false,
          "properties": {
            "head_dim": {"minimum": 2, "type": "integer"}
          },
          "required": ["head_dim"],
          "type": "object"
        },
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "silu_mul": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "activation_boundary": {"const": "bf16_rne_before_up_multiply"},
            "exponential": {"const": "correctly_rounded_binary32_rne"},
            "input_dtype": {"const": "bf16"},
            "output_dtype": {"const": "bf16"},
            "output_rounding": {"const": "rne"},
            "sigmoid": {"const": "stable_sign_selected_binary32"},
            "zero_canonicalization": {"const": "positive"}
          },
          "required": ["activation_boundary", "exponential", "input_dtype", "output_dtype", "output_rounding", "sigmoid", "zero_canonicalization"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/two_identifiers"},
        "kind": {"const": "SILU_MUL"},
        "numeric_contract": {"const": "qwen3_silu_mul_bf16_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {"$ref": "#/$defs/vector_shape"},
        "source_operation_id": {"$ref": "#/$defs/identifier"}
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id"],
      "type": "object"
    },
    "state_commit": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "atomic": {"const": true},
            "coverage": {"enum": ["complete_operation", "qualified_resource_subset"]},
            "generation_increment": {"const": 1},
            "source_atomic_state_count": {"maximum": 64, "minimum": 1, "type": "integer"},
            "transaction_scope": {"const": "model_forward_request"}
          },
          "required": ["atomic", "coverage", "generation_increment", "source_atomic_state_count", "transaction_scope"],
          "type": "object"
        },
        "index": {"minimum": 0, "type": "integer"},
        "inputs": {"$ref": "#/$defs/one_identifier"},
        "kind": {"const": "STATE_COMMIT"},
        "numeric_contract": {"const": "bf16_byte_preserving_state_v1"},
        "outputs": {"$ref": "#/$defs/one_identifier"},
        "shape": {
          "additionalProperties": false,
          "properties": {
            "atomic_state_count": {"maximum": 64, "minimum": 1, "type": "integer"}
          },
          "required": ["atomic_state_count"],
          "type": "object"
        },
        "source_operation_id": {"$ref": "#/$defs/identifier"},
        "state_resources": {
          "items": {"$ref": "#/$defs/identifier"},
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["attributes", "index", "inputs", "kind", "numeric_contract", "outputs", "shape", "source_operation_id", "state_resources"],
      "type": "object"
    },
    "two_identifiers": {
      "items": {"$ref": "#/$defs/identifier"},
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "vector_shape": {
      "additionalProperties": false,
      "properties": {"rows": {"minimum": 1, "type": "integer"}, "width": {"minimum": 1, "type": "integer"}},
      "required": ["rows", "width"],
      "type": "object"
    }
  }
}
