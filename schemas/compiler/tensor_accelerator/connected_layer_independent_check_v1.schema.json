{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/connected_layer_independent_check_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {"$ref": "#/$defs/sha256"},
    "check_id": {"$ref": "#/$defs/sha256"},
    "command_count": {"const": 23570},
    "command_program_sha256": {"$ref": "#/$defs/sha256"},
    "expected_counters": {"$ref": "connected_layer_expectations_v1.schema.json#/$defs/counters"},
    "expected_intermediate_payload_sha256": {"$ref": "connected_layer_expectations_v1.schema.json#/$defs/intermediate_hashes"},
    "expected_output_payload_sha256": {"$ref": "connected_layer_expectations_v1.schema.json#/$defs/output_hashes"},
    "expected_saturated_element_count": {"$ref": "connected_layer_expectations_v1.schema.json#/$defs/saturation"},
    "expected_state_sha256": {"$ref": "#/$defs/sha256"},
    "graph_id": {"$ref": "#/$defs/sha256"},
    "hbm_image_sha256": {"$ref": "#/$defs/sha256"},
    "kernel_ir_id": {"$ref": "#/$defs/sha256"},
    "no_retained_activation_regions": {"const": true},
    "physical_plan_id": {"$ref": "#/$defs/sha256"},
    "qualification_bundle_id": {"$ref": "#/$defs/sha256"},
    "schema": {"const": "opentallas.tensor_accelerator.connected_layer_independent_check.v1"},
    "source_lock_id": {"$ref": "#/$defs/sha256"},
    "status": {"const": "pass"}
  },
  "required": [
    "capability_id",
    "check_id",
    "command_count",
    "command_program_sha256",
    "expected_counters",
    "expected_intermediate_payload_sha256",
    "expected_output_payload_sha256",
    "expected_saturated_element_count",
    "expected_state_sha256",
    "graph_id",
    "hbm_image_sha256",
    "kernel_ir_id",
    "no_retained_activation_regions",
    "physical_plan_id",
    "qualification_bundle_id",
    "schema",
    "source_lock_id",
    "status"
  ],
  "title": "Connected Qwen layer independent reconstruction check v1",
  "type": "object",
  "$defs": {"sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}
}
