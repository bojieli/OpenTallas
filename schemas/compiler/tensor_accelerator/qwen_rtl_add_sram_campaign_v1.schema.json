{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentallas.example/schemas/compiler/tensor_accelerator/qwen_rtl_add_sram_campaign_v1.schema.json",
  "title": "Qwen authentic SRAM-bound ADD_BF16 RTL campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_id",
    "campaign_id",
    "cases",
    "claim_boundary",
    "command_program_sha256",
    "correlation",
    "schema",
    "simulators",
    "source_sha256",
    "status",
    "tools",
    "vector_set_id"
  ],
  "properties": {
    "build_id": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/case"}
    },
    "claim_boundary": {
      "const": {
        "behavioral_sram_model": true,
        "complete_add_command": true,
        "complete_layer_execution": false,
        "memory_request_writeback_control": true,
        "qualified_sram_macro": false,
        "ta_rtl_6_closed": false,
        "timing_or_performance": false
      }
    },
    "command_program_sha256": {"$ref": "#/$defs/sha256"},
    "correlation": {
      "const": {
        "add_input_sram_bytes_read": 16384,
        "add_output_sram_bytes_written": 8192,
        "command_index": 5131,
        "destination_address": 3145728,
        "expected_output_sha256": "f872ce6f57ca36a30edf6abccfa2877bbb7234a905fe9e1417d99ea89ee79ec3",
        "fault_write_suppression_cases": 2,
        "maximum_outstanding_reads": 1,
        "operand_count": 4096,
        "residual_additions": 4096,
        "source0_address": 1048576,
        "source1_address": 2097152,
        "sram_read_transactions": 8192,
        "sram_write_transactions": 4096
      }
    },
    "schema": {
      "const": "opentallas.tensor_accelerator.qwen_rtl_add_sram_campaign.v1"
    },
    "simulators": {"const": ["iverilog", "verilator"]},
    "source_sha256": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"},
      "minProperties": 14
    },
    "status": {"enum": ["fail", "pass"]},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iverilog", "verilator"],
      "properties": {
        "iverilog": {"minLength": 1, "type": "string"},
        "verilator": {"minLength": 1, "type": "string"}
      }
    },
    "vector_set_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "compile_log",
        "compile_returncode",
        "log_sha256",
        "name",
        "run_log",
        "run_returncode",
        "status"
      ],
      "properties": {
        "command": {"minLength": 1, "type": "string"},
        "compile_log": {"type": "string"},
        "compile_returncode": {"type": "integer"},
        "log_sha256": {"$ref": "#/$defs/sha256"},
        "name": {"enum": ["iverilog", "verilator"]},
        "run_log": {"type": "string"},
        "run_returncode": {"type": ["integer", "null"]},
        "status": {"enum": ["fail", "pass"]}
      }
    }
  }
}
