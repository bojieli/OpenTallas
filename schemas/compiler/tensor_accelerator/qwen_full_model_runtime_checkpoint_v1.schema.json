{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/qwen_full_model_runtime_checkpoint_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {"const": "6445ef52a940af167f3bde52e0a326258bb8c8da013d4bb25a3b16e18f171bad"},
    "capability_id": {"const": "a9b231b5f146f845257325e68031f02440f0a3712db42d4e4e2b54c69031f6cd"},
    "checkpoint_id": {"$ref": "#/$defs/sha256"},
    "checkpoint_lock_id": {"const": "fa32932d73c1f605a69db3a803f1f25ef5b022a98cc3c6b5fe42b7f7af024e2a"},
    "checkpoint_version": {"const": "tensor-accelerator-qwen-full-model-runtime-checkpoint-0.1.0"},
    "claim_boundary": {
      "additionalProperties": false,
      "properties": {
        "acceptance_execution_complete": {"const": false},
        "restart_state_only": {"const": true},
        "target_precision_reference_verified": {"const": false},
        "timing_or_performance": {"const": false}
      },
      "required": [
        "acceptance_execution_complete",
        "restart_state_only",
        "target_precision_reference_verified",
        "timing_or_performance"
      ],
      "type": "object"
    },
    "command_program_sha256": {"const": "dfc7ee4d89a091aea616f602174f8bd41cae319ceec92d31fda4cb43636dce6d"},
    "context_capacity": {"const": 8192},
    "graph_id": {"const": "738f3cd8cb5db1ce400c0a44c12385cef6c42ddb2854e22d473251e97a1a51e3"},
    "hbm_logical_sha256": {"const": "55fbb4f91ff9a081dede418edec25d7373553a591ce3c031a27d219048b90b97"},
    "kernel_ir_id": {"const": "35bae3f71666c72ec886875abf336fefc68dd1635288d3b49720c4297d4cc1e1"},
    "next_step_index": {"maximum": 8031, "minimum": 1, "type": "integer"},
    "physical_plan_id": {"const": "2bb30b4bc970b3c0af716eb78b86d3158ed06108218735b515d8e2133dc407a2"},
    "previous_greedy_token_id": {"maximum": 151935, "minimum": 0, "type": "integer"},
    "previous_report_id": {"$ref": "#/$defs/sha256"},
    "schema": {"const": "opentallas.tensor_accelerator.qwen_full_model_runtime_checkpoint.v1"},
    "session_id": {"$ref": "#/$defs/sha256"},
    "simulator_version": {"const": "tensor-accelerator-qwen-full-model-simulator-0.1.0"},
    "state_count": {"const": 36},
    "state_image": {
      "additionalProperties": false,
      "properties": {
        "logical_sha256": {"$ref": "#/$defs/sha256"},
        "shard_bytes": {"const": 268435456},
        "shards": {
          "items": {"$ref": "#/$defs/shard"},
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
        },
        "size_bytes": {"maximum": 1184219136, "minimum": 147456, "type": "integer"}
      },
      "required": ["logical_sha256", "shard_bytes", "shards", "size_bytes"],
      "type": "object"
    },
    "states": {
      "items": {"$ref": "#/$defs/state"},
      "maxItems": 36,
      "minItems": 36,
      "type": "array"
    }
  },
  "required": [
    "build_id",
    "capability_id",
    "checkpoint_id",
    "checkpoint_lock_id",
    "checkpoint_version",
    "claim_boundary",
    "command_program_sha256",
    "context_capacity",
    "graph_id",
    "hbm_logical_sha256",
    "kernel_ir_id",
    "next_step_index",
    "physical_plan_id",
    "previous_greedy_token_id",
    "previous_report_id",
    "schema",
    "session_id",
    "simulator_version",
    "state_count",
    "state_image",
    "states"
  ],
  "title": "Qwen authenticated byte-exact runtime checkpoint v1",
  "type": "object",
  "$defs": {
    "plane": {
      "additionalProperties": false,
      "properties": {
        "logical_offset": {"minimum": 0, "type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"maximum": 16447488, "minimum": 2048, "type": "integer"}
      },
      "required": ["logical_offset", "sha256", "size_bytes"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "shard": {
      "additionalProperties": false,
      "properties": {
        "index": {"maximum": 4, "minimum": 0, "type": "integer"},
        "logical_offset": {"minimum": 0, "type": "integer"},
        "path": {"pattern": "^state/hbm\\.[0-9]{5}\\.[0-9a-f]{64}\\.bin$", "type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"maximum": 268435456, "minimum": 1, "type": "integer"}
      },
      "required": ["index", "logical_offset", "path", "sha256", "size_bytes"],
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "capacity": {"const": 8192},
        "generation": {"maximum": 8031, "minimum": 1, "type": "integer"},
        "key": {"$ref": "#/$defs/plane"},
        "layer": {"maximum": 35, "minimum": 0, "type": "integer"},
        "length": {"maximum": 8031, "minimum": 1, "type": "integer"},
        "resource_id": {"pattern": "^kv\\.layer\\.(?:[0-9]|[12][0-9]|3[0-5])$", "type": "string"},
        "value": {"$ref": "#/$defs/plane"}
      },
      "required": [
        "capacity",
        "generation",
        "key",
        "layer",
        "length",
        "resource_id",
        "value"
      ],
      "type": "object"
    }
  }
}
