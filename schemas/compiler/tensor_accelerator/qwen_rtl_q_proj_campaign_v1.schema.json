{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentallas.example/schemas/compiler/tensor_accelerator/qwen_rtl_q_proj_campaign_v1.schema.json",
  "title": "Complete Qwen q_proj RTL campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "arithmetic_evidence",
    "build_id",
    "campaign_id",
    "cases",
    "claim_boundary",
    "command_program_sha256",
    "program_correlation",
    "schema",
    "simulators",
    "source_sha256",
    "status",
    "tools",
    "vector_set_id"
  ],
  "properties": {
    "arithmetic_evidence": {
      "const": {
        "first_output_block_campaign_id": "c0dba5230a77daa1eecab33aa43960b2e41f198cd453e6ef139653ef1a14a298",
        "first_output_block_vector_set_id": "4fe481b232112fe5b494cab1ca4445159b91a512a524471bee18267fe5525129",
        "signed_fp32_add_differential_cases": 20000,
        "status": "pass"
      }
    },
    "build_id": {"const": "3460d88ce16f5ef0ca4d1277daf8ebb19ae555e88822f95d55deb4aa8cad290f"},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/iverilog_case"},
        {"$ref": "#/$defs/verilator_case"}
      ],
      "items": false
    },
    "claim_boundary": {
      "const": {
        "activity_derived_power_or_timing": false,
        "architectural_simulator_output_correlated": true,
        "authentic_command_records": true,
        "behavioral_hbm_and_sram": true,
        "complete_layer_execution": false,
        "complete_q_projection_graph_operation": true,
        "dual_simulator_complete_operation": true,
        "independent_reference_all_operations_exact": true,
        "preloaded_attention_norm_row": true,
        "program_order_and_fail_stop": true,
        "qualified_hbm_phy": false,
        "qualified_sram_macro": false,
        "raw_weight_payload_retained": false,
        "ta_rtl_6_closed": false
      }
    },
    "command_program_sha256": {"const": "f0ce6b50b01f462f837a28504e6ff9a024a24d24abf339f924875d0c2059bcec"},
    "program_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accumulator_payload_sha256",
        "accumulator_read_count",
        "accumulator_write_count",
        "all_accumulator_tiles_sha256",
        "auxiliary_payload_sha256",
        "auxiliary_saturation_count",
        "auxiliary_write_count",
        "command_count",
        "command_end",
        "command_start",
        "dma_hbm_bytes",
        "dma_hbm_request_count",
        "dma_sram_write_count",
        "early_terminal_fail_stop_cases",
        "graph_operation_id",
        "input_payload_sha256",
        "matmul_add_count",
        "matmul_input_read_count",
        "matmul_multiply_count",
        "matmul_weight_read_count",
        "output_block_count",
        "weight_payload_sha256"
      ],
      "properties": {
        "accumulator_payload_sha256": {"const": "b866aee6c4a9916f6164b9283d70758dfea9f37e0b9fbc364fd8de8e6d946f78"},
        "accumulator_read_count": {"const": 122880},
        "accumulator_write_count": {"const": 65536},
        "all_accumulator_tiles_sha256": {"const": "1c0f3cee4259ca1b19b538c3a449ee50fc3f234396d38ac824e179c6c3d4b531"},
        "auxiliary_payload_sha256": {"const": "b900b79fd38ff6a9bff470ac27e9672b0c3724b84f6a1f7e964c2ec0918ea0ff"},
        "auxiliary_saturation_count": {"const": 0},
        "auxiliary_write_count": {"const": 4096},
        "command_count": {"const": 2048},
        "command_end": {"const": 2050},
        "command_start": {"const": 3},
        "dma_hbm_bytes": {"const": 33554432},
        "dma_hbm_request_count": {"const": 524288},
        "dma_sram_write_count": {"const": 2097152},
        "early_terminal_fail_stop_cases": {"const": 1},
        "graph_operation_id": {"const": "node.0002"},
        "input_payload_sha256": {"const": "976d6de1a3ed91a066c7efed4354e578edf366a3b51a7e6077d68282981ffa58"},
        "matmul_add_count": {"const": 16777216},
        "matmul_input_read_count": {"const": 262144},
        "matmul_multiply_count": {"const": 16777216},
        "matmul_weight_read_count": {"const": 16777216},
        "output_block_count": {"const": 64},
        "weight_payload_sha256": {"const": "27406586791294918cb04052d91f7d47c41aac1af56650c4b47f68ac00f1ff9b"}
      }
    },
    "schema": {"const": "opentallas.tensor_accelerator.qwen_rtl_q_proj_campaign.v1"},
    "simulators": {"const": ["iverilog", "verilator"]},
    "source_sha256": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"},
      "minProperties": 17
    },
    "status": {"enum": ["fail", "pass"]},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iverilog", "verilator"],
      "properties": {
        "iverilog": {"type": "string", "minLength": 1},
        "verilator": {"type": "string", "minLength": 1}
      }
    },
    "vector_set_id": {"const": "32dbdaa446fc4192f31a0a26394e04094e74c6459858d8a6b0135c11fc9e324b"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycles", "read_stalls", "request_stalls", "write_stalls"],
      "properties": {
        "cycles": {"type": "integer", "minimum": 1},
        "read_stalls": {"type": "integer", "minimum": 1},
        "request_stalls": {"type": "integer", "minimum": 1},
        "write_stalls": {"type": "integer", "minimum": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "compile_log", "compile_returncode", "log_sha256", "name", "observation", "run_log", "run_returncode", "status"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "compile_log": {"type": "string"},
        "compile_returncode": {"type": "integer"},
        "log_sha256": {"$ref": "#/$defs/sha256"},
        "name": {"type": "string"},
        "observation": {"oneOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]},
        "run_log": {"type": "string"},
        "run_returncode": {"type": ["integer", "null"]},
        "status": {"enum": ["fail", "pass"]}
      }
    },
    "iverilog_case": {
      "allOf": [
        {"$ref": "#/$defs/case"},
        {"properties": {"name": {"const": "q_proj_iverilog"}}}
      ]
    },
    "verilator_case": {
      "allOf": [
        {"$ref": "#/$defs/case"},
        {"properties": {"name": {"const": "q_proj_verilator"}}}
      ]
    }
  }
}
