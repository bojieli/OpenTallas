{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/connected_layer_expectations_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_id": {"$ref": "#/$defs/sha256"},
    "counters": {"$ref": "#/$defs/counters"},
    "expectations_id": {"$ref": "#/$defs/sha256"},
    "intermediate_payload_sha256": {"$ref": "#/$defs/intermediate_hashes"},
    "output_payload_sha256": {"$ref": "#/$defs/output_hashes"},
    "qualification_bundle_id": {"$ref": "#/$defs/sha256"},
    "saturated_element_count": {"$ref": "#/$defs/saturation"},
    "schema": {"const": "opentallas.tensor_accelerator.connected_layer_expectations.v1"},
    "state_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "check_id",
    "counters",
    "expectations_id",
    "intermediate_payload_sha256",
    "output_payload_sha256",
    "qualification_bundle_id",
    "saturated_element_count",
    "schema",
    "state_sha256"
  ],
  "title": "Connected Qwen layer execution expectations v1",
  "type": "object",
  "$defs": {
    "counters": {
      "additionalProperties": {"minimum": 0, "type": "integer"},
      "maxProperties": 72,
      "minProperties": 72,
      "propertyNames": {
        "enum": [
          "accumulator_sram_bytes_read",
          "accumulator_sram_bytes_written",
          "add_command_count",
          "add_input_sram_bytes_read",
          "add_output_sram_bytes_written",
          "attention_command_count",
          "attention_output_sram_bytes_written",
          "attention_query_sram_bytes_read",
          "command_count",
          "complete_command_count",
          "direct_dma_command_count",
          "dma_command_count",
          "dma_sram_bytes_written",
          "epsilon_additions",
          "exponential_evaluations",
          "final_weight_multiplications",
          "hbm_transferred_bytes_read",
          "hbm_transferred_bytes_written",
          "hbm_useful_bytes_read",
          "hbm_useful_bytes_written",
          "indexed_dma_command_count",
          "input_square_multiplications",
          "kv_prepare_command_count",
          "kv_prepare_sram_bytes_read",
          "mask_additions",
          "matmul_command_count",
          "matmul_input_sram_bytes_read",
          "matmul_output_sram_bytes_written",
          "matmul_weight_sram_bytes_read",
          "matrix_input_sram_bytes_read",
          "matrix_output_sram_bytes_written",
          "mean_divisions",
          "normalization_multiplications",
          "probability_multiplications",
          "projection_accumulation_additions",
          "projection_multiplications",
          "reciprocal_square_roots",
          "reduction_additions",
          "residual_additions",
          "rmsnorm_command_count",
          "rmsnorm_input_sram_bytes_read",
          "rmsnorm_output_sram_bytes_written",
          "rmsnorm_weight_sram_bytes_read",
          "rope_additions",
          "rope_command_count",
          "rope_input_sram_bytes_read",
          "rope_multiplications",
          "rope_output_sram_bytes_written",
          "runtime_request_sram_bytes_written",
          "scalar_accumulation_additions",
          "scalar_multiplications",
          "scaling_multiplications",
          "score_accumulation_additions",
          "score_multiplications",
          "sigmoid_denominator_additions",
          "sigmoid_divisions",
          "sigmoid_exponentials",
          "silu_command_count",
          "silu_input_sram_bytes_read",
          "silu_multiplications",
          "silu_output_sram_bytes_written",
          "softmax_reciprocal_divisions",
          "softmax_reduction_additions",
          "state_commit_command_count",
          "state_metadata_bytes_read",
          "state_metadata_bytes_written",
          "state_payload_bytes_read",
          "state_payload_bytes_written",
          "up_gate_multiplications",
          "value_accumulation_additions",
          "value_multiplications",
          "weight_sram_bytes_read"
        ]
      },
      "type": "object"
    },
    "intermediate_hashes": {
      "additionalProperties": false,
      "properties": {
        "attention": {"$ref": "#/$defs/sha256"},
        "attention_norm": {"$ref": "#/$defs/sha256"},
        "attention_projected": {"$ref": "#/$defs/sha256"},
        "down": {"$ref": "#/$defs/sha256"},
        "gate": {"$ref": "#/$defs/sha256"},
        "gated_mlp": {"$ref": "#/$defs/sha256"},
        "hidden_0": {"$ref": "#/$defs/sha256"},
        "k_norm": {"$ref": "#/$defs/sha256"},
        "k_raw": {"$ref": "#/$defs/sha256"},
        "k_rotary": {"$ref": "#/$defs/sha256"},
        "mlp_norm": {"$ref": "#/$defs/sha256"},
        "post_attention": {"$ref": "#/$defs/sha256"},
        "probabilities": {"$ref": "#/$defs/sha256"},
        "q_norm": {"$ref": "#/$defs/sha256"},
        "q_raw": {"$ref": "#/$defs/sha256"},
        "q_rotary": {"$ref": "#/$defs/sha256"},
        "scaled_scores": {"$ref": "#/$defs/sha256"},
        "silu_activation": {"$ref": "#/$defs/sha256"},
        "up": {"$ref": "#/$defs/sha256"},
        "v": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "attention",
        "attention_norm",
        "attention_projected",
        "down",
        "gate",
        "gated_mlp",
        "hidden_0",
        "k_norm",
        "k_raw",
        "k_rotary",
        "mlp_norm",
        "post_attention",
        "probabilities",
        "q_norm",
        "q_raw",
        "q_rotary",
        "scaled_scores",
        "silu_activation",
        "up",
        "v"
      ],
      "type": "object"
    },
    "output_hashes": {
      "additionalProperties": false,
      "properties": {"hidden_1": {"$ref": "#/$defs/sha256"}},
      "required": ["hidden_1"],
      "type": "object"
    },
    "rmsnorm_saturation": {
      "additionalProperties": false,
      "properties": {
        "normalized": {"minimum": 0, "type": "integer"},
        "output": {"minimum": 0, "type": "integer"}
      },
      "required": ["normalized", "output"],
      "type": "object"
    },
    "saturation": {
      "additionalProperties": false,
      "properties": {
        "attention": {
          "additionalProperties": false,
          "properties": {
            "mask": {"minimum": 0, "type": "integer"},
            "output": {"minimum": 0, "type": "integer"},
            "probability": {"minimum": 0, "type": "integer"},
            "scaling": {"minimum": 0, "type": "integer"},
            "score": {"minimum": 0, "type": "integer"}
          },
          "required": ["mask", "output", "probability", "scaling", "score"],
          "type": "object"
        },
        "projection": {
          "additionalProperties": false,
          "properties": {
            "attention_output": {"minimum": 0, "type": "integer"},
            "down": {"minimum": 0, "type": "integer"},
            "gate": {"minimum": 0, "type": "integer"},
            "k": {"minimum": 0, "type": "integer"},
            "q": {"minimum": 0, "type": "integer"},
            "up": {"minimum": 0, "type": "integer"},
            "v": {"minimum": 0, "type": "integer"}
          },
          "required": ["attention_output", "down", "gate", "k", "q", "up", "v"],
          "type": "object"
        },
        "rmsnorm": {
          "additionalProperties": false,
          "properties": {
            "attention_norm": {"$ref": "#/$defs/rmsnorm_saturation"},
            "k_norm": {"$ref": "#/$defs/rmsnorm_saturation"},
            "mlp_norm": {"$ref": "#/$defs/rmsnorm_saturation"},
            "q_norm": {"$ref": "#/$defs/rmsnorm_saturation"}
          },
          "required": ["attention_norm", "k_norm", "mlp_norm", "q_norm"],
          "type": "object"
        },
        "rope": {
          "additionalProperties": false,
          "properties": {
            "addition": {"minimum": 0, "type": "integer"},
            "multiplication": {"minimum": 0, "type": "integer"}
          },
          "required": ["addition", "multiplication"],
          "type": "object"
        },
        "vector": {
          "additionalProperties": false,
          "properties": {
            "attention_residual": {"minimum": 0, "type": "integer"},
            "final_residual": {"minimum": 0, "type": "integer"},
            "silu_activation": {"minimum": 0, "type": "integer"},
            "silu_output": {"minimum": 0, "type": "integer"}
          },
          "required": ["attention_residual", "final_residual", "silu_activation", "silu_output"],
          "type": "object"
        }
      },
      "required": ["attention", "projection", "rmsnorm", "rope", "vector"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
