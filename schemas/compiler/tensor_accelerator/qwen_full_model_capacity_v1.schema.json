        "immutable_weight_bytes": {"const": 16381470720},
        "margin_bytes": {"const": 257304817152},
        "metadata_and_descriptor_bytes": {"const": 4608},
        "mutable_kv_bytes": {"const": 1179648000},
        "required_bytes": {"const": 17573089792},
        "rope_coefficient_bytes": {"const": 4096000}
      },
      "required": [
        "alignment_padding_bytes",
        "available_bytes",
        "immutable_weight_bytes",
        "margin_bytes",
        "metadata_and_descriptor_bytes",
