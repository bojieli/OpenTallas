{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentallas.example/schemas/compiler/tensor_accelerator/qwen_rtl_command_campaign_v1.schema.json",
  "title": "Qwen production-command RTL campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_id",
    "campaign_id",
    "cases",
    "claim_boundary",
    "command_program_sha256",
    "execution_report_id",
    "negative_vector_count",
    "positive_vector_count",
    "schema",
    "simulators",
    "source_sha256",
    "status",
    "tools",
    "vector_set_id"
  ],
  "properties": {
    "build_id": {"$ref": "#/$defs/sha256"},
    "campaign_id": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "compile_log",
          "compile_returncode",
          "log_sha256",
          "name",
          "run_log",
          "run_returncode",
          "status"
        ],
        "properties": {
          "command": {"minLength": 1, "type": "string"},
          "compile_log": {"type": "string"},
          "compile_returncode": {"type": "integer"},
          "log_sha256": {"$ref": "#/$defs/sha256"},
          "name": {"enum": ["iverilog", "verilator"]},
          "run_log": {"type": "string"},
          "run_returncode": {"type": ["integer", "null"]},
          "status": {"enum": ["fail", "pass"]}
        }
      }
    },
    "claim_boundary": {
      "const": {
        "complete_kernel_execution": false,
        "complete_layer_execution": false,
        "production_command_record_admission": true,
        "ta_rtl_6_closed": false,
        "timing_or_performance": false
      }
    },
    "command_program_sha256": {"$ref": "#/$defs/sha256"},
    "execution_report_id": {"$ref": "#/$defs/sha256"},
    "negative_vector_count": {"const": 7},
    "positive_vector_count": {"const": 12},
    "schema": {"const": "opentallas.tensor_accelerator.qwen_rtl_command_campaign.v1"},
    "simulators": {"const": ["iverilog", "verilator"]},
    "source_sha256": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"},
      "minProperties": 3
    },
    "status": {"enum": ["fail", "pass"]},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iverilog", "verilator"],
      "properties": {
        "iverilog": {"minLength": 1, "type": "string"},
        "verilator": {"minLength": 1, "type": "string"}
      }
    },
    "vector_set_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
