        "q": {
          "minimum": 0,
          "type": "integer"
        },
        "v": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "k",
        "q",
        "v"
      ],
      "type": "object"
    },
    "qkv_projection_samples": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "$ref": "#/$defs/projection_sample"
        },
        "q": {
          "$ref": "#/$defs/projection_sample"
        },
        "v": {
          "$ref": "#/$defs/projection_sample"
        }
      },
      "required": [
        "k",
        "q",
        "v"
      ],
      "type": "object"
    },
    "qkv_samples": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "$ref": "#/$defs/sample"
        },
        "q": {
          "$ref": "#/$defs/sample"
