        "k_normalized": {
          "minimum": 0,
          "type": "integer"
        },
        "k_output": {
          "minimum": 0,
          "type": "integer"
        },
        "q_normalized": {
          "minimum": 0,
          "type": "integer"
        },
        "q_output": {
          "minimum": 0,
