        "mean_divisions": {
          "minimum": 0,
          "type": "integer"
        },
        "normalization_multiplications": {
          "minimum": 0,
          "type": "integer"
        },
        "projection_accumulation_additions": {
          "minimum": 0,
          "type": "integer"
        },
        "projection_multiplications": {
          "minimum": 0,
          "type": "integer"
