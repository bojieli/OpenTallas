        "v": {
          "$ref": "#/$defs/sample"
        }
      },
      "required": [
        "k",
        "q",
        "v"
      ],
      "type": "object"
    },
    "projection_sample": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "codes",
        "rows"
      ],
      "type": "object"
    },
    "rms_payload": {
      "additionalProperties": false,
      "properties": {
        "inverse_rms_binary32_codes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mean_square_binary32_codes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        }
      },
      "required": [
        "inverse_rms_binary32_codes_sha256",
        "mean_square_binary32_codes_sha256",
        "normalized_payload_sha256",
        "payload_sha256",
        "shape"
      ],
      "type": "object"
    },
    "sample": {
      "additionalProperties": false,
      "properties": {
        "codes": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "element_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "codes",
        "element_indices"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "shape": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "tensor": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "payload_sha256",
        "shape",
        "tensor"
      ],
      "type": "object"
    }
