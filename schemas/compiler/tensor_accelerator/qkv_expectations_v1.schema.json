{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/qkv_expectations_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "$ref": "#/$defs/sha256"
    },
    "counters": {
      "$ref": "#/$defs/counters"
    },
    "expectations_id": {
      "$ref": "#/$defs/sha256"
    },
    "intermediate_payload_sha256": {
      "additionalProperties": false,
      "properties": {
        "attention_norm": {
          "$ref": "#/$defs/sha256"
        },
        "k_norm": {
          "$ref": "#/$defs/sha256"
        },
        "k_raw": {
          "$ref": "#/$defs/sha256"
        },
        "q_norm": {
          "$ref": "#/$defs/sha256"
        },
        "q_raw": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "attention_norm",
        "k_norm",
        "k_raw",
        "q_norm",
        "q_raw"
      ],
      "type": "object"
    },
    "output_payload_sha256": {
      "additionalProperties": false,
      "properties": {
        "k_rotary": {
          "$ref": "#/$defs/sha256"
        },
        "q_rotary": {
          "$ref": "#/$defs/sha256"
        },
        "v": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "k_rotary",
        "q_rotary",
        "v"
      ],
      "type": "object"
    },
    "qualification_report_id": {
      "$ref": "#/$defs/sha256"
    },
    "schema": {
      "const": "opentallas.tensor_accelerator.qkv_expectations.v1"
    }
  },
  "required": [
    "check_id",
    "counters",
    "expectations_id",
    "intermediate_payload_sha256",
    "output_payload_sha256",
    "qualification_report_id",
    "schema"
  ],
  "title": "Q/K/V execution expectations v1",
  "type": "object",
  "$defs": {
    "counter": {
      "minimum": 0,
      "type": "integer"
    },
    "counters": {
      "additionalProperties": false,
      "properties": {
        "accumulator_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "accumulator_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "command_count": {
          "$ref": "#/$defs/counter"
        },
        "complete_command_count": {
          "$ref": "#/$defs/counter"
        },
        "direct_dma_command_count": {
          "$ref": "#/$defs/counter"
        },
        "dma_command_count": {
          "$ref": "#/$defs/counter"
        },
        "dma_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "epsilon_additions": {
          "$ref": "#/$defs/counter"
        },
        "final_weight_multiplications": {
          "$ref": "#/$defs/counter"
        },
        "hbm_transferred_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "hbm_useful_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "indexed_dma_command_count": {
          "$ref": "#/$defs/counter"
        },
        "input_square_multiplications": {
          "$ref": "#/$defs/counter"
        },
        "matmul_command_count": {
          "$ref": "#/$defs/counter"
        },
        "matmul_input_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "matmul_output_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "matmul_weight_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "mean_divisions": {
          "$ref": "#/$defs/counter"
        },
        "normalization_multiplications": {
          "$ref": "#/$defs/counter"
        },
        "reciprocal_square_roots": {
          "$ref": "#/$defs/counter"
        },
        "reduction_additions": {
          "$ref": "#/$defs/counter"
        },
        "rmsnorm_command_count": {
          "$ref": "#/$defs/counter"
        },
        "rmsnorm_input_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "rmsnorm_output_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "rmsnorm_weight_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "rope_additions": {
          "$ref": "#/$defs/counter"
        },
        "rope_command_count": {
          "$ref": "#/$defs/counter"
        },
        "rope_input_sram_bytes_read": {
          "$ref": "#/$defs/counter"
        },
        "rope_multiplications": {
          "$ref": "#/$defs/counter"
        },
        "rope_output_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "runtime_request_sram_bytes_written": {
          "$ref": "#/$defs/counter"
        },
        "scalar_accumulation_additions": {
          "$ref": "#/$defs/counter"
        },
        "scalar_multiplications": {
          "$ref": "#/$defs/counter"
        }
      },
      "required": [
        "accumulator_sram_bytes_read",
        "accumulator_sram_bytes_written",
        "command_count",
        "complete_command_count",
        "direct_dma_command_count",
        "dma_command_count",
        "dma_sram_bytes_written",
        "epsilon_additions",
        "final_weight_multiplications",
        "hbm_transferred_bytes_read",
        "hbm_useful_bytes_read",
        "indexed_dma_command_count",
        "input_square_multiplications",
        "matmul_command_count",
        "matmul_input_sram_bytes_read",
        "matmul_output_sram_bytes_written",
        "matmul_weight_sram_bytes_read",
        "mean_divisions",
        "normalization_multiplications",
        "reciprocal_square_roots",
        "reduction_additions",
        "rmsnorm_command_count",
        "rmsnorm_input_sram_bytes_read",
        "rmsnorm_output_sram_bytes_written",
        "rmsnorm_weight_sram_bytes_read",
        "rope_additions",
        "rope_command_count",
        "rope_input_sram_bytes_read",
        "rope_multiplications",
        "rope_output_sram_bytes_written",
        "runtime_request_sram_bytes_written",
        "scalar_accumulation_additions",
        "scalar_multiplications"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
