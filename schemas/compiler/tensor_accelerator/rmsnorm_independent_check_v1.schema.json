{
  "$id": "https://opentallas.org/schemas/compiler/tensor_accelerator/rmsnorm_independent_check_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_id": {"$ref": "#/$defs/sha256"},
    "check_id": {"$ref": "#/$defs/sha256"},
    "command_count": {"minimum": 1, "type": "integer"},
    "expected_counters": {"$ref": "rmsnorm_expectations_v1.schema.json#/$defs/counters"},
    "graph_id": {"$ref": "#/$defs/sha256"},
    "kernel_ir_id": {"$ref": "#/$defs/sha256"},
    "physical_plan_id": {"$ref": "#/$defs/sha256"},
    "qualification_report_id": {"$ref": "#/$defs/sha256"},
    "reconstructed_sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "payload_sha256": {"$ref": "#/$defs/sha256"},
          "role": {"enum": ["embedding_row", "rmsnorm_weight"]},
          "size_bytes": {"minimum": 1, "type": "integer"},
          "source_tensor": {"minLength": 1, "type": "string"}
        },
        "required": ["payload_sha256", "role", "size_bytes", "source_tensor"],
        "type": "object"
      },
      "minItems": 2,
      "maxItems": 2,
      "type": "array"
    },
    "request_id": {"$ref": "#/$defs/sha256"},
    "schema": {"const": "opentallas.tensor_accelerator.rmsnorm_independent_check.v1"},
    "source_lock_id": {"$ref": "#/$defs/sha256"},
    "status": {"const": "pass"}
  },
  "required": ["capability_id", "check_id", "command_count", "expected_counters", "graph_id", "kernel_ir_id", "physical_plan_id", "qualification_report_id", "reconstructed_sources", "request_id", "schema", "source_lock_id", "status"],
  "title": "Embedding-to-RMSNorm independent check v1",
  "type": "object",
  "$defs": {"sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}
}
