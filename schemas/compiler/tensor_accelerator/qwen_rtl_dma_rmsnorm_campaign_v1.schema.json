        "rmsnorm_element_count": 4096,
        "rmsnorm_sram_read_count": 8192,
        "rmsnorm_sram_write_count": 4096,
        "weight_payload_sha256": "00695bad97c2abc77a9d1ce57e4d4a5e5c2b574387fcb4029ef5ce12239b2530",
