    "arithmetic_verilator_case": {
      "allOf": [
        {"$ref": "#/$defs/case"},
        {"properties": {"name": {"const": "arithmetic_verilator"}}}
      ]
    },
    "program_iverilog_case": {
      "allOf": [
        {"$ref": "#/$defs/case"},
        {"properties": {"name": {"const": "program_iverilog"}}}
      ]
    },
    "program_verilator_case": {
      "allOf": [
        {"$ref": "#/$defs/case"},
        {"properties": {"name": {"const": "program_verilator"}}}
      ]
    }
