      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/arithmetic_iverilog_case"},
        {"$ref": "#/$defs/arithmetic_verilator_case"},
        {"$ref": "#/$defs/program_iverilog_case"},
        {"$ref": "#/$defs/program_verilator_case"}
