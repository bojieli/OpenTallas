{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentallas.local/schemas/compiler/deepseek_v4_generation_replay_v1.schema.json",
  "title": "OpenTallas DeepSeek V4 generation control replay",
  "type": "object",
  "additionalProperties": false,
  "required": ["config", "model_results", "prompt_token_ids", "schema"],
  "properties": {
    "schema": {"const": "opentallas.deepseek_v4_generation_replay.v1"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bos_token_id",
        "decode_mode",
        "eos_token_id",
        "max_batch_size",
        "max_context_tokens",
        "max_new_tokens",
        "rng_seed",
        "temperature",
        "top_p",
        "vocab_size"
      ],
      "properties": {
        "bos_token_id": {"const": 0},
        "decode_mode": {"const": "target_only"},
        "eos_token_id": {"const": 1},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "max_context_tokens": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1048576
        },
        "max_new_tokens": {"type": "integer", "minimum": 1},
        "rng_seed": {"const": 33377335},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"const": 1.0},
        "vocab_size": {"const": 129280}
      }
    },
    "prompt_token_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "integer", "minimum": 0, "maximum": 129279}
      }
    },
    "model_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argmax_token_ids",
          "candidate_token_ids",
          "invocation_id",
          "logits_sha256",
          "processed_start_pos",
          "processed_stop_pos_exclusive",
          "rng_state_after_sha256",
          "rng_state_before_sha256",
          "state_commit_sha256"
        ],
        "properties": {
          "argmax_token_ids": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array",
                "items": {"type": "integer", "minimum": 0, "maximum": 129279}
              }
            ]
          },
          "candidate_token_ids": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 129279}
          },
          "invocation_id": {"$ref": "#/$defs/sha256"},
          "logits_sha256": {"$ref": "#/$defs/sha256"},
          "processed_start_pos": {"type": "integer", "minimum": 0},
          "processed_stop_pos_exclusive": {"type": "integer", "minimum": 1},
          "rng_state_after_sha256": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
          },
          "rng_state_before_sha256": {
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
          },
          "state_commit_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
