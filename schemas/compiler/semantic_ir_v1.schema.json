{
  "$id": "https://opentallas.org/schemas/compiler/semantic_ir_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "$ref": "#/$defs/identifier"
    },
    "numeric_profile": {
      "const": "int_exact_fixture_v1"
    },
    "operations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "inputs": {
            "items": {
              "$ref": "#/$defs/identifier"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "kind": {
            "enum": [
              "ROM_MATMUL",
              "VECTOR_ADD"
            ]
          },
          "output": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required": [
          "id",
          "inputs",
          "kind",
          "output"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "opentallas.semantic_ir.v1"
    },
    "tensors": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "rom"
                }
              },
              "required": [
                "storage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "values"
                ]
              }
            }
          }
        ],
        "properties": {
          "dtype": {
            "enum": [
              "i8",
              "i32"
            ]
          },
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "shape": {
            "items": {
              "maximum": 1099511627776,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "storage": {
            "enum": [
              "input",
              "rom",
              "activation",
              "output"
            ]
          },
          "values": {
            "items": {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "dtype",
          "id",
          "shape",
          "storage"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "model_id",
    "numeric_profile",
    "operations",
    "outputs",
    "schema",
    "tensors"
  ],
  "title": "OpenTallas semantic IR fixture v1",
  "type": "object",
  "$defs": {
    "identifier": {
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    }
  }
}
