{
  "schema_version": 1,
  "campaign": "public_reference_rtl_coverage",
  "evidence_class": "public_open_tool_rtl_simulation",
  "evidence_boundary": "Logical source RTL coverage on reduced public-reference configurations. This is not ATPG, target-node, macro, PHY, PDK, manufacturing, numerical-quality, or product-silicon signoff.",
  "thresholds": {
    "line_percent": 95.0,
    "branch_percent": 90.0,
    "toggle_percent": 85.0,
    "must_bin_percent": 100.0,
    "fsm_state_bin_percent": 100.0
  },
  "point_accounting": {
    "native_format": "Verilator SystemC::Coverage-3",
    "classes": {
      "line": "v_line",
      "branch": "v_branch",
      "toggle": "v_toggle"
    },
    "source_deduplication_key": [
      "file",
      "line",
      "column",
      "point_class",
      "point_type",
      "description",
      "source_span"
    ],
    "ignored_metadata": [
      "hierarchy",
      "parameterized page suffix"
    ],
    "hit_rule": "A source point is hit when any elaborated instance in any planned Verilator case has count greater than zero."
  },
  "warning_policy": {
    "unexpected_warning_is_failure": true,
    "iverilog_allowed_patterns": [
      "^.*: warning: @\\* is sensitive to all [0-9]+ words in array '.*'\\.$"
    ],
    "verilator_suppressions": {
      "PROCASSINIT": "Timed testbench initialization only.",
      "UNUSEDSIGNAL": "Self-checking testbench observation and randomized source fields only.",
      "PINCONNECTEMPTY": "Deliberately unobserved outputs on auxiliary coverage-only instances.",
      "SYNCASYNCNET": "Known structural diagnostic limited to the independently reset full-stage integration case; CDC/RDC is gated separately."
    }
  },
