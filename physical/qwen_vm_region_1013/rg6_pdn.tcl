# generated by tools/ref_tile/ref_tile.py (qfd_vm_rg6, cluster): layer contract PG top M7 as full-length stripes = the
# block's power pins; cluster: M5/M6 stripes + M7 stripes (pins); each hard child strapped from the layer above its own PG pins (recipe physical/hgi_idx_hier/pdn_hier.tcl @8d848821f).
add_global_connection -net {VDD} -inst_pattern {.*} -pin_pattern {^VDD$} -power
add_global_connection -net {VDD} -inst_pattern {.*} -pin_pattern {^VDDPE$}
add_global_connection -net {VDD} -inst_pattern {.*} -pin_pattern {^VDDCE$}
add_global_connection -net {VSS} -inst_pattern {.*} -pin_pattern {^VSS$} -ground
add_global_connection -net {VSS} -inst_pattern {.*} -pin_pattern {^VSSE$}
global_connect
set_voltage_domain -name {CORE} -power {VDD} -ground {VSS}
define_pdn_grid -name {top} -voltage_domains {CORE} -pins {M7 M8 M9}
add_pdn_stripe -grid {top} -layer {M1} -width {0.018} -pitch {0.54} -offset {0} -followpins
add_pdn_stripe -grid {top} -layer {M2} -width {0.018} -pitch {0.54} -offset {0} -followpins
add_pdn_stripe -grid {top} -layer {M5} -width {0.12} -spacing {0.072} -pitch {5.4} -offset {0.300}
add_pdn_stripe -grid {top} -layer {M6} -width {0.288} -spacing {0.096} -pitch {5.4} -offset {0.513}
add_pdn_stripe -grid {top} -layer {M7} -width {0.288} -spacing {5.112} -pitch {10.8} -offset {1.0}
add_pdn_connect -grid {top} -layers {M1 M2}
add_pdn_connect -grid {top} -layers {M2 M5}
add_pdn_connect -grid {top} -layers {M5 M6}
add_pdn_connect -grid {top} -layers {M6 M7}
proc ot_ref_has_master {pats} {
  foreach inst [[ord::get_db_block] getInsts] {
    set m [[$inst getMaster] getName]
    foreach p $pats { if {[string match $p $m]} { return 1 } }
  }
  return 0
}
proc ot_ref_present {cells} { set out {}; foreach c $cells { if {[ot_ref_has_master $c]} { lappend out $c } }; return $out }
set ot_c [ot_ref_present {ot_qfd_vm_bank_t ot_qfd_vm_bctl_t ot_qfd_vm_rr2_t ot_qfd_vm_rr4_t ot_qfd_vm_sctl_t ot_qfd_vm_su1024_t ot_qfd_vm_su_t ot_qfd_vm_xfifo8_t ot_qfd_vm_xpad2_t ot_qfd_vm_xrelay_t ot_qfd_vm_xrelay_w ot_qwen_tree_delay1_t ot_qwen_tree_delay2_t}]
if {[llength $ot_c]} {
  define_pdn_grid -name {hard_m5} -voltage_domains {CORE} -macro -cells $ot_c -orient {R0 R180 MX MY} -halo {2.0 2.0 2.0 2.0}
  add_pdn_connect -grid {hard_m5} -layers {M5 M6}
}

# Die PG pass-through: exact r11a origin0, pitch9.091,width.48; top grid is core-inset2.16.
add_pdn_stripe -grid {top} -layer {M8} -width {0.48} -pitch {9.091} -offset {7.6180} -nets {VSS}
add_pdn_stripe -grid {top} -layer {M8} -width {0.48} -pitch {9.091} -offset {3.0725} -nets {VDD}
add_pdn_stripe -grid {top} -layer {M9} -width {0.48} -pitch {9.091} -offset {7.3060} -nets {VSS}
add_pdn_stripe -grid {top} -layer {M9} -width {0.48} -pitch {9.091} -offset {2.7605} -nets {VDD}
add_pdn_connect -grid {top} -layers {M7 M8}
add_pdn_connect -grid {top} -layers {M8 M9}
