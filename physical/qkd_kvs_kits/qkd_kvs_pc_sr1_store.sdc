# KV-PC SAFE 10-19 (generated by tools/qwen_kv_die/kvpc_sram_kit.py): the eight HBM storage roots clock only the
# write ports of the native SRAM banks (front: pc__front_hbm_data[k], return ring: pc__return_hbm_data[k]).  The die
# delivers each at the hclk period and phase (qkd_kv_hbm_elastic_front_mc: "every root at the same phase"), so they
# are clocks of the hclk family: same period / waveform / uncertainty, propagated with hclk; no exception.
set ot_st_prop 0
catch {set ot_st_prop [get_property [get_clocks core_clk] is_propagated]}
catch {unset_input_delay [get_ports {pc__front_hbm_data[0]}]}
create_clock -name hfd0 -period 1024.000 [get_ports {pc__front_hbm_data[0]}]
set_clock_uncertainty -setup 60 [get_clocks hfd0]
set_clock_uncertainty -hold 25 [get_clocks hfd0]
if {$ot_st_prop} { set_propagated_clock [get_clocks hfd0] }
catch {unset_input_delay [get_ports {pc__front_hbm_data[1]}]}
create_clock -name hfd1 -period 1024.000 [get_ports {pc__front_hbm_data[1]}]
set_clock_uncertainty -setup 60 [get_clocks hfd1]
set_clock_uncertainty -hold 25 [get_clocks hfd1]
if {$ot_st_prop} { set_propagated_clock [get_clocks hfd1] }
catch {unset_input_delay [get_ports {pc__front_hbm_data[2]}]}
create_clock -name hfd2 -period 1024.000 [get_ports {pc__front_hbm_data[2]}]
set_clock_uncertainty -setup 60 [get_clocks hfd2]
set_clock_uncertainty -hold 25 [get_clocks hfd2]
if {$ot_st_prop} { set_propagated_clock [get_clocks hfd2] }
catch {unset_input_delay [get_ports {pc__front_hbm_data[3]}]}
create_clock -name hfd3 -period 1024.000 [get_ports {pc__front_hbm_data[3]}]
set_clock_uncertainty -setup 60 [get_clocks hfd3]
set_clock_uncertainty -hold 25 [get_clocks hfd3]
if {$ot_st_prop} { set_propagated_clock [get_clocks hfd3] }
catch {unset_input_delay [get_ports {pc__return_hbm_data[0]}]}
create_clock -name hrd0 -period 1024.000 [get_ports {pc__return_hbm_data[0]}]
set_clock_uncertainty -setup 60 [get_clocks hrd0]
set_clock_uncertainty -hold 25 [get_clocks hrd0]
if {$ot_st_prop} { set_propagated_clock [get_clocks hrd0] }
catch {unset_input_delay [get_ports {pc__return_hbm_data[1]}]}
create_clock -name hrd1 -period 1024.000 [get_ports {pc__return_hbm_data[1]}]
set_clock_uncertainty -setup 60 [get_clocks hrd1]
set_clock_uncertainty -hold 25 [get_clocks hrd1]
if {$ot_st_prop} { set_propagated_clock [get_clocks hrd1] }
catch {unset_input_delay [get_ports {pc__return_hbm_data[2]}]}
create_clock -name hrd2 -period 1024.000 [get_ports {pc__return_hbm_data[2]}]
set_clock_uncertainty -setup 60 [get_clocks hrd2]
set_clock_uncertainty -hold 25 [get_clocks hrd2]
if {$ot_st_prop} { set_propagated_clock [get_clocks hrd2] }
catch {unset_input_delay [get_ports {pc__return_hbm_data[3]}]}
create_clock -name hrd3 -period 1024.000 [get_ports {pc__return_hbm_data[3]}]
set_clock_uncertainty -setup 60 [get_clocks hrd3]
set_clock_uncertainty -hold 25 [get_clocks hrd3]
if {$ot_st_prop} { set_propagated_clock [get_clocks hrd3] }
