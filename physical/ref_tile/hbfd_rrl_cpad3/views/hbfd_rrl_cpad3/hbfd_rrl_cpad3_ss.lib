library (hbfd_rrl_cpad3_ss) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 0.63;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
  }

  cell ("hbfd_rrl_cpad3") {
    area : 2.741 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.7513;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("45.66695");
        }
        cell_fall(scalar) {
          values("52.41738");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("48.46180");
        }
        cell_fall(scalar) {
          values("54.83250");
        }
      }
    }
    pin("rst_n") {
      direction : output;
      capacitance : 0.2094;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("336.59293,340.40308,347.06714,359.78583,384.76001,434.41995,533.57990");
        }
        rise_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("13.30925,19.88386,33.29198,60.57899,115.81031,226.87256,449.27902");
        }
        cell_fall(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("315.05331,318.39233,323.99564,333.99741,353.03009,390.61035,465.57550");
        }
        fall_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("12.25186,17.01745,26.42987,45.38053,83.91716,161.97078,318.97800");
        }
      }
    }
    pin("rst_n_in") {
      direction : input;
      capacitance : 0.6735;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-68.00584");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("86.42084");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
