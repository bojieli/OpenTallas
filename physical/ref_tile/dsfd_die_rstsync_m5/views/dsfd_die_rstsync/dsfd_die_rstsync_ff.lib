library (dsfd_die_rstsync_ff) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 0.0;
  nom_voltage                    : 0.77;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("dsfd_die_rstsync") {
    area : 2.552 
    is_macro_cell : true;
    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 3.3253;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("31.67652");
        }
        cell_fall(scalar) {
          values("33.42570");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("32.35775");
        }
        cell_fall(scalar) {
          values("34.09378");
        }
      }
    }
    pin("rn") {
      direction : output;
      capacitance : 0.1711;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("159.93262,162.24583,166.34674,174.10684,189.36203,219.75478,280.45392");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("7.61145,11.68060,19.95879,36.84272,71.06615,139.93100,277.88898");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("167.67577,169.88600,173.70435,180.64655,194.10381,220.88876,274.37900");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("6.99613,10.42720,17.26693,31.14938,59.35943,116.35442,230.77361");
        }
      }
    }
    pin("rst") {
      direction : input;
      capacitance : 1.1151;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-31.98715");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("43.40309");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
