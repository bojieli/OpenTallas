# generated by tools/ref_tile/ref_tile.py (qfd_xf_native_rx32): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports wck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qwen_romio_slots/qfd_xf_ch.sdc
# el1013-qwen-small-masters r3b 2026-10-13: the reader's clock (rck) of the IO-band CDC channel leaf qfd_xf_ch for the
# REFERENCE TILE FLOW (spec sdc_extra, inlined at the end of clock.sdc and signoff.sdc; core_clk = wck is created by
# ref_tile and is NOT relaxed here).  Constraint form of the closed two-clock leaf qkd_cdc_wleaf_ref
# (physical/qwen_stream4_cdc/qkd_cdc_wleaf_ref.sdc):
#   two asynchronous roots; the master serves ck -> cku / cks and cku / cks -> ck, so BOTH roots carry the core period
#   (the PHY digital clocks are not faster than the core clock);
#   NO clock groups and NO false paths on the crossings: every wck <-> rck arc (Gray pointer -> first synchroniser
#   flop, FIFO array -> read-select register) is a datapath budget = period - setup uncertainty in both directions,
#   hold = non-negative datapath delay;
#   each boundary port 0.2 T outside the block in its OWN domain; after CTS the rck ports are referenced to the
#   propagated rck tree exactly as io_ref_skew.sdc does for core_clk (median rck pin flop).
set ot_xf_T [get_property [get_clocks core_clk] period]
create_clock -name rck -period $ot_xf_T [get_ports rck]
set_clock_uncertainty -setup 60 [get_clocks rck]
set_clock_uncertainty -hold 25 [get_clocks rck]
set ot_xf_prop 0
catch {set ot_xf_prop [get_property [get_clocks core_clk] is_propagated]}
if {$ot_xf_prop} { set_propagated_clock [get_clocks rck] }
set ot_xf_x [expr {$ot_xf_T - 60.0}]
set_max_delay -ignore_clock_latency $ot_xf_x -from [get_clocks core_clk] -to [get_clocks rck]
set_max_delay -ignore_clock_latency $ot_xf_x -from [get_clocks rck] -to [get_clocks core_clk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks core_clk] -to [get_clocks rck]
set_min_delay -ignore_clock_latency 0 -from [get_clocks rck] -to [get_clocks core_clk]
set ot_xf_ri [get_ports {o_cr}]
set ot_xf_ro [get_ports {o_v o_d[*] r_fault}]
catch {unset_input_delay [get_ports rck]}
unset_input_delay $ot_xf_ri
unset_output_delay $ot_xf_ro
set ot_xf_io [expr {0.2 * $ot_xf_T}]
set ot_xf_lmax 0.0; set ot_xf_lmin 0.0
set ot_xf_sk 0.0; set ot_xf_hk 0.0; set ot_xf_hki 0.0
if {$ot_xf_prop} {
  set ot_xf_sk  [expr {[info exists ::env(OT_IO_SKEW)] ? $::env(OT_IO_SKEW) : 90}]
  set ot_xf_hk  [expr {[info exists ::env(OT_IO_HOLD_SKEW)] ? $::env(OT_IO_HOLD_SKEW) : 50}]
  set ot_xf_hki [expr {[info exists ::env(OT_IO_IN_HOLD_SKEW)] ? $::env(OT_IO_IN_HOLD_SKEW) : 0}]
  catch {sta::worst_slack_cmd max}
  set ot_xf_ck {}
  # reference = the output pin station (odp: 1,024 flops launching o_d at the E face) and the o_cr pin flop
  foreach c [get_cells -quiet -hier *odp*] {
    set k [get_pins -quiet "[get_full_name $c]/CLK"]
    if {[llength $k]} { lappend ot_xf_ck $k }
  }
  if {[llength [info procs ot_pf_clks]]} { foreach k [ot_pf_clks $ot_xf_ri] { lappend ot_xf_ck $k } }
  if {![llength $ot_xf_ck]} { set ot_xf_ck [lrange [all_registers -clock rck -clock_pins] 0 255] }
  set ot_xf_pf {}
  foreach p $ot_xf_ck {
    set a [get_property $p arrival_max_rise]
    if {[string is double -strict $a]} { lappend ot_xf_pf [list $a $p] }
  }
  if {[llength $ot_xf_pf]} {
    set ot_xf_m [lindex [lsort -real -index 0 $ot_xf_pf] [expr {[llength $ot_xf_pf] / 2}]]
    set ot_xf_lmax [lindex $ot_xf_m 0]
    set ot_xf_lmin [get_property [lindex $ot_xf_m 1] arrival_min_rise]
    if {![string is double -strict $ot_xf_lmin]} { set ot_xf_lmin $ot_xf_lmax }
    puts "QFD_XF_CH rck reference [get_full_name [lindex $ot_xf_m 1]] of [llength $ot_xf_pf] pin flops: clock arrival max $ot_xf_lmax min $ot_xf_lmin skew $ot_xf_sk hold $ot_xf_hk"
  } else {
    puts "QFD_XF_CH rck reference: no rck register arrival (ideal boundary kept)"
  }
  set_input_delay  [expr {$ot_xf_io + $ot_xf_lmax + $ot_xf_sk}] -max -clock rck $ot_xf_ri
  set_input_delay  [expr {$ot_xf_lmin - $ot_xf_hki}]            -min -clock rck $ot_xf_ri
  set_output_delay [expr {$ot_xf_io - $ot_xf_lmax + $ot_xf_sk}] -max -clock rck $ot_xf_ro
  set_output_delay [expr {0.0 - $ot_xf_lmin - $ot_xf_hk}]       -min -clock rck $ot_xf_ro
} else {
  set_input_delay  $ot_xf_io -clock rck $ot_xf_ri
  set_output_delay $ot_xf_io -clock rck $ot_xf_ro
}
# the raw reset: asynchronous assertion, released through the channel's own per-domain synchronisers
set_false_path -from [get_ports rst_n]
set_input_transition 150 [all_inputs -no_clocks]
