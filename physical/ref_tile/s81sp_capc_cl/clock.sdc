# generated by tools/ref_tile/ref_tile.py (s81sp_capc_cl): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck_c]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_ph_views/capture/capc_clocks.sdc
# generated by tools/s81_ph/capc_plan.py (ref_tile spec sdc_extra): the capture cluster has one clock ENTRY per child.
# The die delivers every entry at phi - R of its child (R = the child's routed TT boundary insertion), so each
# entry carries source latency -R here and the children's flops line up; the cluster adds wires, no tree.
# ckv_x has no measured serial insertion in the dsfd_capt_x view (its insertion.json is the stream clock): 0.
set ot_cc_p [get_property [get_clocks core_clk] period]
create_clock -name core_clk -period $ot_cc_p [get_ports {ck_c ck_g[*] ck_x[*] ck_ka[*] ck_kb[*] ck_sb[*] ck_sn}]
create_clock -name ser_clk -period [expr {$ot_cc_p * 4.0 / 3.0}] [get_ports {ckv_x[*] ckv_d ckv_r}]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
if {![catch {get_property [get_clocks core_clk] is_propagated} ot_cc_pr] && $ot_cc_pr eq "1"} { set_propagated_clock [all_clocks] }
catch {unset_input_delay [get_ports {ck_c ck_g[*] ck_x[*] ck_ka[*] ck_kb[*] ck_sb[*] ck_sn ckv_x[*] ckv_d ckv_r}]}
set_false_path -from [get_ports {rst[*] rsv[*]}]
set_clock_latency -source -208.4 [get_ports {ck_g[*]}]
set_clock_latency -source -269.3 [get_ports {ck_x[*]}]
set_clock_latency -source -90.3 [get_ports {ck_c}]
set_clock_latency -source -43.1 [get_ports {ckv_d}]
set_clock_latency -source -42.6 [get_ports {ckv_r}]
set_clock_latency -source -62.4 [get_ports {ck_ka[0]}]
set_clock_latency -source -56.6 [get_ports {ck_kb[0]}]
set_clock_latency -source -32.3 [get_ports {ck_sb[0]}]
set_clock_latency -source -62.4 [get_ports {ck_ka[1]}]
set_clock_latency -source -56.6 [get_ports {ck_kb[1]}]
set_clock_latency -source -32.3 [get_ports {ck_sb[1]}]
set_clock_latency -source -62.4 [get_ports {ck_ka[2]}]
set_clock_latency -source -56.6 [get_ports {ck_kb[2]}]
set_clock_latency -source -32.3 [get_ports {ck_sb[2]}]
set_clock_latency -source -62.4 [get_ports {ck_ka[3]}]
set_clock_latency -source -56.6 [get_ports {ck_kb[3]}]
set_clock_latency -source -32.3 [get_ports {ck_sb[3]}]
set_clock_latency -source -61.3 [get_ports {ck_ka[4]}]
set_clock_latency -source -61.3 [get_ports {ck_kb[4]}]
set_clock_latency -source -32.4 [get_ports {ck_sb[4]}]
set_clock_latency -source -61.3 [get_ports {ck_ka[5]}]
set_clock_latency -source -61.3 [get_ports {ck_kb[5]}]
set_clock_latency -source -32.4 [get_ports {ck_sb[5]}]
set_clock_latency -source -61.3 [get_ports {ck_ka[6]}]
set_clock_latency -source -61.3 [get_ports {ck_kb[6]}]
set_clock_latency -source -32.4 [get_ports {ck_sb[6]}]
set_clock_latency -source -61.3 [get_ports {ck_ka[7]}]
set_clock_latency -source -61.3 [get_ports {ck_kb[7]}]
set_clock_latency -source -32.4 [get_ports {ck_sb[7]}]
set_clock_latency -source -62.4 [get_ports {ck_sn}]
# serial-domain outputs: 0.2 T of the serial period against ser_clk (they were set against core_clk above)
set ot_cc_so [get_ports {t_vm[*] t_cd[*]}]
unset_output_delay $ot_cc_so
set_output_delay [expr {0.2 * $ot_cc_p * 4.0 / 3.0}] -clock ser_clk $ot_cc_so
