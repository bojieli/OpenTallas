set ::ot_cdc_groups [dict create {bridge_stream_reset} {src serial dst core width 1 payload 0 sync 250.0 pay 0.0} {pg_fault_level} {src core dst serial width 1 payload 0 sync 250.0 pay 0.0} {pg_leaf_reset} {src serial dst core width 1 payload 0 sync 250.0 pay 0.0} {pg_tap_reset} {src serial dst core width 1 payload 0 sync 250.0 pay 0.0}]

proc ot_cdc_flow_names {name} {
  set names [list $name]
  if {[regsub {^u_ot_pr_core[./]} $name {} core]} {
    lappend names $core
    if {[regexp {^([^$]+)\$} $core -> base]} {lappend names $base}
  }
  # LH-PGVM2 10-19: contents of kept-hierarchy instances (keep_hierarchy region / replica cells) are named with '/'
  # in the routed netlist; the lint flattens them with '.' (cdc_sync_constraints.elaborate)
  foreach n $names {if {[string first / $n] >= 0} {lappend names [string map {/ .} $n]}}
  return $names
}
