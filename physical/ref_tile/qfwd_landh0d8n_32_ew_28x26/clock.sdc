# generated by tools/ref_tile/ref_tile.py (qfwd_landh0d8n_32_ew_28x26): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qwen_fwd_lane/land8_clocks.tcl
# QW-LAND8 10-19: clocks of the D8 hop-0 landing masters (rtl/qwen_split/qfd_land8.sv, physical/qwen_fwd_lane/
# qfd_land8_masters.sv); sdc_extra + boundary_tcl of every qfwd_landh0d8* kit (re-applied after every io_ref switch and
# at sign-off).  ck = receiving root (core_clk), ck_s = source root at the landing (lane_ckf, same period).
# The ring -> o crossing is DIRECTLY TIMED (no false path, no disabled arc) under the D8 sampled-age envelope of contract
# 5a266752c (LEAD-QW 12:15 adopted D8): write -> read age >= 1.25 T, read -> next overwrite >= 3.875 T.
#   setup: related phase-zero STA with a 2-edge check (multicycle -setup 2) and extra setup uncertainty 0.75 T + the
#          150 ps cross-root reserve + the ordinary 60 ps leaves 2T - 0.75T - 210 ps = 1.25 T - 210 ps for EVERY
#          lane_ckf -> core_clk cone (bank / valid flop -> 8:1 AND-OR -> o / fault capture).  The die strap K places the
#          read in [1.25 T, 4.125 T] (bench tools/qwen_split/bench_land8.sh, all K 0..15 and 8 phases).
#   hold:  checked at the SAME edge (multicycle -hold 1 => hold edge 0) with 25 ps + the 100 ps cross-root reserve; the
#          real retention is >= 3.875 T, so this is conservative.
# Real insertion / skew of both trees is charged (propagated after CTS).  The source-side en pin is captured on
# lane_ckf (en_s0, async clear): its budget is the lane input budget.  Nothing reaches the ICG enable but en_icg.Q.
set ot_fl_ck [get_clocks core_clk]
set ot_fl_T [get_property $ot_fl_ck period]
if {[llength [get_ports -quiet ck_s]]} {
  create_clock -name lane_ckf -period $ot_fl_T [get_ports ck_s]
  if {!([info exists ::ot_ref_pre_cts] && $::ot_ref_pre_cts) || [get_property $ot_fl_ck is_propagated]} {
    set_propagated_clock [get_clocks lane_ckf]
  }
  set ot_fl_in [get_ports -quiet {a[*] a en}]
  if {[llength $ot_fl_in]} {
    unset_input_delay $ot_fl_in
    set ot_fl_c [expr {[info exists ::env(OT_BH_LAUNCH_MIN_PS)] ? $::env(OT_BH_LAUNCH_MIN_PS) : 25}]
    set ot_fl_u [expr {[info exists ::env(OT_BH_TILE_HOLD_UNC_PS)] ? $::env(OT_BH_TILE_HOLD_UNC_PS) : 25}]
    # min credits the lane tree's own insertion L_min at the write flops (fwd_lane_clocks.tcl QK-LANDH548 rule)
    set ot_fl_l 0.0
    if {[get_property [get_clocks lane_ckf] is_propagated] &&
        !([info exists ::env(OT_FL_LMIN_CREDIT)] && $::env(OT_FL_LMIN_CREDIT) eq "0")} {
      catch {sta::worst_slack_cmd max}
      set ot_fl_lv {}
      foreach p [all_registers -clock [get_clocks lane_ckf] -clock_pins] {
        set a [get_property $p arrival_min_rise]
        if {[string is double -strict $a]} { lappend ot_fl_lv $a }
      }
      if {[llength $ot_fl_lv]} { set ot_fl_l [tcl::mathfunc::min {*}$ot_fl_lv] }
    }
    set_input_delay -max [expr {0.2 * $ot_fl_T}] -clock lane_ckf $ot_fl_in
    set_input_delay -min [expr {$ot_fl_l + $ot_fl_c + $ot_fl_u}] -clock lane_ckf $ot_fl_in
    puts "OT_LAND8: lane inputs min = L_min $ot_fl_l + C $ot_fl_c + U $ot_fl_u (lane_ckf write flops)"
  }
  set ot_l8_su [expr {60.0 + 150.0 + 0.75 * $ot_fl_T}]
  set_multicycle_path -setup 2 -from [get_clocks lane_ckf] -to $ot_fl_ck
  set_multicycle_path -hold 1 -from [get_clocks lane_ckf] -to $ot_fl_ck
  set_clock_uncertainty -setup -from [get_clocks lane_ckf] -to $ot_fl_ck $ot_l8_su
  set_clock_uncertainty -hold -from [get_clocks lane_ckf] -to $ot_fl_ck 125.0
  # no core_clk -> lane_ckf data path exists in the RTL; keep it timed (ordinary related-phase check) if one appears
  set_clock_uncertainty -setup -from $ot_fl_ck -to [get_clocks lane_ckf] $ot_l8_su
  set_clock_uncertainty -hold -from $ot_fl_ck -to [get_clocks lane_ckf] 125.0
  puts "OT_LAND8: lane_ckf on ck_s (period $ot_fl_T); ring -> o timed 2T check, setup unc $ot_l8_su (=> 1.25T-210ps), hold same-edge 125 ps"
}
set_input_transition 150 [all_inputs -no_clocks]
set_input_transition 150 [all_inputs -no_clocks]
