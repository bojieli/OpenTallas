# generated by tools/ref_tile/ref_tile.py (qkd_kvs_grp_r2da): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qkd_kvs_kits/qkd_kvs_grp_r2da_hck.sdc
# KDIE5-RTL: o_ctl removed from the hclk outputs (qkd_kvs_grp_r2 exit flops are on ck); otherwise = qkd_kvs_grp_r1
# KV-INTEG/KITS-B 10-18: sdc_extra of qkd_kvs_grp_r2da (GENERATED by tools/qwen_kv_die/kvs_tile_kits.py specs; do not edit).
# Second clock hclk on port hck (the HBM trunk clk_hbm_<region>); its IO = the ports whose registers are ALL on hck
# plus, on a mixed-domain port, the BITS whose registers are all on hck (TW2-KVGRP 10-19; measured on the elaborated
# RTL, results/arch/qwen_kv_kits_b_1018/<kind>_ports.json bit_domains); every other port / bit stays on
# core_clk.  Two asynchronous roots, NO clock groups and NO false paths: each crossing arc is a datapath budget of
# core_clk period - 60 ps in both directions, hold = non-negative datapath delay; IO 0.2 T in its own domain.
create_clock -name hclk -period 1024.000 [get_ports hck]
set_clock_uncertainty -setup 60 [get_clocks hclk]
set_clock_uncertainty -hold 25 [get_clocks hclk]
set ot_cw_prop 0
catch {set ot_cw_prop [get_property [get_clocks core_clk] is_propagated]}
if {$ot_cw_prop} { set_propagated_clock [get_clocks hclk] }
set ot_cw_x [expr {[get_property [get_clocks core_clk] period] - 60.0}]
set_max_delay -ignore_clock_latency $ot_cw_x -from [get_clocks core_clk] -to [get_clocks hclk]
set_max_delay -ignore_clock_latency $ot_cw_x -from [get_clocks hclk] -to [get_clocks core_clk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks core_clk] -to [get_clocks hclk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks hclk] -to [get_clocks core_clk]
catch {unset_input_delay [get_ports hck]}
set ot_cw_hi [get_ports {hrst_n}]
set ot_cw_ho [get_ports {o_pc0[0] o_pc0[1] o_pc0[2] o_pc0[3] o_pc0[4] o_pc0[5] o_pc0[6] o_pc0[7] o_pc0[8] o_pc0[9] o_pc0[10] o_pc0[11] o_pc0[12] o_pc0[13] o_pc0[14] o_pc0[15] o_pc0[16] o_pc0[17] o_pc0[18] o_pc0[19] o_pc0[20] o_pc0[21] o_pc0[22] o_pc0[23] o_pc0[24] o_pc0[25] o_pc0[26] o_pc0[27] o_pc0[28] o_pc0[29] o_pc0[30] o_pc0[31] o_pc0[32] o_pc0[33] o_pc0[34] o_pc0[35] o_pc0[36] o_pc0[37] o_pc0[38] o_pc0[39] o_pc0[40] o_pc0[41] o_pc0[42] o_pc0[43] o_pc0[44] o_pc0[45] o_pc0[46] o_pc0[47] o_pc0[48] o_pc0[49] o_pc0[50] o_pc0[51] o_pc0[52] o_pc0[53] o_pc0[54] o_pc0[55] o_pc0[56] o_pc0[57] o_pc0[58] o_pc0[59] o_pc0[60] o_pc0[61] o_pc0[62] o_pc0[63] o_pc0[64] o_pc0[65] o_pc0[66] o_pc0[67] o_pc0[68] o_pc0[69] o_pc0[70] o_pc0[71] o_pc0[105] o_pc0[106] o_pc0[107] o_pc0[108] o_pc0[109] o_pc0[110] o_pc0[111] o_pc0[112] o_pc0[113] o_pc0[114] o_pc0[115] o_pc0[116] o_pc0[117] o_pc0[118] o_pc0[119] o_pc0[120] o_pc0[121] o_pc0[122] o_pc0[123] o_pc0[124] o_pc0[125] o_pc0[126] o_pc0[127] o_pc1[0] o_pc1[1] o_pc1[2] o_pc1[3] o_pc1[4] o_pc1[5] o_pc1[6] o_pc1[7] o_pc1[8] o_pc1[9] o_pc1[10] o_pc1[11] o_pc1[12] o_pc1[13] o_pc1[14] o_pc1[15] o_pc1[16] o_pc1[17] o_pc1[18] o_pc1[19] o_pc1[20] o_pc1[21] o_pc1[22] o_pc1[23] o_pc1[24] o_pc1[25] o_pc1[26] o_pc1[27] o_pc1[28] o_pc1[29] o_pc1[30] o_pc1[31] o_pc1[32] o_pc1[33] o_pc1[34] o_pc1[35] o_pc1[36] o_pc1[37] o_pc1[38] o_pc1[39] o_pc1[40] o_pc1[41] o_pc1[42] o_pc1[43] o_pc1[44] o_pc1[45] o_pc1[46] o_pc1[47] o_pc1[48] o_pc1[49] o_pc1[50] o_pc1[51] o_pc1[52] o_pc1[53] o_pc1[54] o_pc1[55] o_pc1[56] o_pc1[57] o_pc1[58] o_pc1[59] o_pc1[60] o_pc1[61] o_pc1[62] o_pc1[63] o_pc1[64] o_pc1[65] o_pc1[66] o_pc1[67] o_pc1[68] o_pc1[69] o_pc1[70] o_pc1[71] o_pc1[105] o_pc1[106] o_pc1[107] o_pc1[108] o_pc1[109] o_pc1[110] o_pc1[111] o_pc1[112] o_pc1[113] o_pc1[114] o_pc1[115] o_pc1[116] o_pc1[117] o_pc1[118] o_pc1[119] o_pc1[120] o_pc1[121] o_pc1[122] o_pc1[123] o_pc1[124] o_pc1[125] o_pc1[126] o_pc1[127] o_pc2[0] o_pc2[1] o_pc2[2] o_pc2[3] o_pc2[4] o_pc2[5] o_pc2[6] o_pc2[7] o_pc2[8] o_pc2[9] o_pc2[10] o_pc2[11] o_pc2[12] o_pc2[13] o_pc2[14] o_pc2[15] o_pc2[16] o_pc2[17] o_pc2[18] o_pc2[19] o_pc2[20] o_pc2[21] o_pc2[22] o_pc2[23] o_pc2[24] o_pc2[25] o_pc2[26] o_pc2[27] o_pc2[28] o_pc2[29] o_pc2[30] o_pc2[31] o_pc2[32] o_pc2[33] o_pc2[34] o_pc2[35] o_pc2[36] o_pc2[37] o_pc2[38] o_pc2[39] o_pc2[40] o_pc2[41] o_pc2[42] o_pc2[43] o_pc2[44] o_pc2[45] o_pc2[46] o_pc2[47] o_pc2[48] o_pc2[49] o_pc2[50] o_pc2[51] o_pc2[52] o_pc2[53] o_pc2[54] o_pc2[55] o_pc2[56] o_pc2[57] o_pc2[58] o_pc2[59] o_pc2[60] o_pc2[61] o_pc2[62] o_pc2[63] o_pc2[64] o_pc2[65] o_pc2[66] o_pc2[67] o_pc2[68] o_pc2[69] o_pc2[70] o_pc2[71] o_pc2[105] o_pc2[106] o_pc2[107] o_pc2[108] o_pc2[109] o_pc2[110] o_pc2[111] o_pc2[112] o_pc2[113] o_pc2[114] o_pc2[115] o_pc2[116] o_pc2[117] o_pc2[118] o_pc2[119] o_pc2[120] o_pc2[121] o_pc2[122] o_pc2[123] o_pc2[124] o_pc2[125] o_pc2[126] o_pc2[127] o_pc3[0] o_pc3[1] o_pc3[2] o_pc3[3] o_pc3[4] o_pc3[5] o_pc3[6] o_pc3[7] o_pc3[8] o_pc3[9] o_pc3[10] o_pc3[11] o_pc3[12] o_pc3[13] o_pc3[14] o_pc3[15] o_pc3[16] o_pc3[17] o_pc3[18] o_pc3[19] o_pc3[20] o_pc3[21] o_pc3[22] o_pc3[23] o_pc3[24] o_pc3[25] o_pc3[26] o_pc3[27] o_pc3[28] o_pc3[29] o_pc3[30] o_pc3[31] o_pc3[32] o_pc3[33] o_pc3[34] o_pc3[35] o_pc3[36] o_pc3[37] o_pc3[38] o_pc3[39] o_pc3[40] o_pc3[41] o_pc3[42] o_pc3[43] o_pc3[44] o_pc3[45] o_pc3[46] o_pc3[47] o_pc3[48] o_pc3[49] o_pc3[50] o_pc3[51] o_pc3[52] o_pc3[53] o_pc3[54] o_pc3[55] o_pc3[56] o_pc3[57] o_pc3[58] o_pc3[59] o_pc3[60] o_pc3[61] o_pc3[62] o_pc3[63] o_pc3[64] o_pc3[65] o_pc3[66] o_pc3[67] o_pc3[68] o_pc3[69] o_pc3[70] o_pc3[71] o_pc3[105] o_pc3[106] o_pc3[107] o_pc3[108] o_pc3[109] o_pc3[110] o_pc3[111] o_pc3[112] o_pc3[113] o_pc3[114] o_pc3[115] o_pc3[116] o_pc3[117] o_pc3[118] o_pc3[119] o_pc3[120] o_pc3[121] o_pc3[122] o_pc3[123] o_pc3[124] o_pc3[125] o_pc3[126] o_pc3[127]}]
if {[llength $ot_cw_hi]} { unset_input_delay $ot_cw_hi }
if {[llength $ot_cw_ho]} { unset_output_delay $ot_cw_ho }
set ot_cw_b 204.800
set ot_cw_lmax 0.0; set ot_cw_lmin 0.0
set ot_cw_sk 0.0; set ot_cw_hk 0.0; set ot_cw_hki 0.0
if {$ot_cw_prop} {
  set ot_cw_sk  [expr {[info exists ::env(OT_IO_SKEW)] ? $::env(OT_IO_SKEW) : 90}]
  set ot_cw_hk  [expr {[info exists ::env(OT_IO_HOLD_SKEW)] ? $::env(OT_IO_HOLD_SKEW) : 50}]
  set ot_cw_hki [expr {[info exists ::env(OT_IO_IN_HOLD_SKEW)] ? $::env(OT_IO_IN_HOLD_SKEW) : 0}]
  catch {sta::worst_slack_cmd max}
  set ot_cw_ck {}
  if {[llength $ot_cw_hi] && [llength [info procs ot_pf_clks]]} { set ot_cw_ck [ot_pf_clks $ot_cw_hi] }
  if {![llength $ot_cw_ck]} { set ot_cw_ck [lrange [all_registers -clock hclk -clock_pins] 0 255] }
  set ot_cw_pf {}
  foreach p $ot_cw_ck {
    set a [get_property $p arrival_max_rise]
    if {[string is double -strict $a]} { lappend ot_cw_pf [list $a $p] }
  }
  if {[llength $ot_cw_pf]} {
    set ot_cw_m [lindex [lsort -real -index 0 $ot_cw_pf] [expr {[llength $ot_cw_pf] / 2}]]
    set ot_cw_lmax [lindex $ot_cw_m 0]
    set ot_cw_lmin [get_property [lindex $ot_cw_m 1] arrival_min_rise]
    if {![string is double -strict $ot_cw_lmin]} { set ot_cw_lmin $ot_cw_lmax }
    puts "qkd_kvs_grp_r2da hclk reference [get_full_name [lindex $ot_cw_m 1]] of [llength $ot_cw_pf] pin flops: clock arrival max $ot_cw_lmax min $ot_cw_lmin"
  }
}
if {[llength $ot_cw_hi]} {
  set_input_delay  [expr {$ot_cw_b + $ot_cw_lmax + $ot_cw_sk}] -max -clock hclk $ot_cw_hi
  set_input_delay  [expr {$ot_cw_lmin - $ot_cw_hki}]          -min -clock hclk $ot_cw_hi
}
if {[llength $ot_cw_ho]} {
  set_output_delay [expr {$ot_cw_b - $ot_cw_lmax + $ot_cw_sk}] -max -clock hclk $ot_cw_ho
  set_output_delay [expr {0.0 - $ot_cw_lmin - $ot_cw_hk}]     -min -clock hclk $ot_cw_ho
}
set_input_transition 150 [all_inputs -no_clocks]
