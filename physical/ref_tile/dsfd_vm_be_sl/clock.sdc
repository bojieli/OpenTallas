# generated by tools/ref_tile/ref_tile.py (dsfd_vm_be_sl): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_ph_views/vm_master/be_sl_clock_ref.sdc
# el1011-ds-vm/be 2026-10-12: stream domain of dsfd_vm_be_sl for the REFERENCE TILE FLOW (spec sdc_extra; core_clk = ck is
# created by the ref_tile clock.sdc / signoff.sdc).  Replaces be_sl_clock.sdc, which re-referenced the old io_vclk flow
# (vclk / vclk_t + post_cts_vm_domains.tcl).  str_clk = 3/4 of the core period on cks; vrv / vrq leave and rns_in arrives in
# the stream domain; the internal ck <-> cks ratio-CDC paths stay timed (no clock groups, as be_sl_clock.sdc).
# Boundary: 0.2 T of str_clk + 90 ps skew, referenced to the propagated str_clk tree (same form as io_ref_skew.sdc for
# core_clk).  In-route the kit's post-CTS hooks re-read io_ref_skew.sdc, which puts the stream ports back on core_clk; the
# two false paths below drop only those wrong-domain (str_clk -> core_clk port / core_clk port -> str_clk) checks, so the
# stream ports are timed against str_clk in clock.sdc and at sign-off.
create_clock -name str_clk -period [expr {[get_property [get_clocks core_clk] period] * 3.0 / 4.0}] [get_ports {cks*}]
catch {set_propagated_clock [get_clocks str_clk]}
set_clock_uncertainty -setup 60 [get_clocks str_clk]
set_clock_uncertainty -hold 25 [get_clocks str_clk]
catch {unset_input_delay -clock core_clk [get_ports {cks*}]}
set ot_sT [get_property [get_clocks str_clk] period]
set ot_slx 0.0; set ot_sln 0.0
catch {
  set ot_sr [lindex [all_registers -clock str_clk -clock_pins] 0]
  if {$ot_sr ne ""} {
    set a [get_property $ot_sr arrival_max_rise]; set b [get_property $ot_sr arrival_min_rise]
    # finite only: before CTS (ideal clocks, synthesis) the arrival reads -Inf/Inf -> keep 0 (r1 df88d1e26 STA-0562 'set_output_delay -Inf')
    if {[string is double -strict $a] && [string is double -strict $b] && abs($a) < 1e6 && abs($b) < 1e6} { set ot_slx $a; set ot_sln $b }
  }
}
puts "BE_SL str_clk boundary: T $ot_sT reference insertion max $ot_slx min $ot_sln"
set ot_so [get_ports {vrv* vrq*}]
catch {unset_output_delay -clock core_clk $ot_so}
set_output_delay [expr {$ot_sT * 0.2 - $ot_slx + 90}] -max -clock str_clk $ot_so
set_output_delay [expr {0 - $ot_sln - 50}] -min -clock str_clk $ot_so
set ot_si [get_ports {rns_in*}]
catch {unset_input_delay -clock core_clk $ot_si}
set_input_delay [expr {$ot_sT * 0.2 + $ot_slx + 90}] -max -clock str_clk $ot_si
set_input_delay [expr {0 + $ot_sln}] -min -clock str_clk $ot_si
set_false_path -from [get_clocks str_clk] -through $ot_so -to [get_clocks core_clk]
set_false_path -from [get_clocks core_clk] -through $ot_si -to [get_clocks str_clk]
set_input_transition 150 [all_inputs -no_clocks]
