 "job": {
  "owner": "Claude:QW-SRAM3",
  "branch": "claude/qw-sram3-1019",
  "tag": "p192e",
  "purpose": "Real-parent pin-access gate of the p192 SRAM successor (INF.SRAM): qfd_tt_ctlm_head unchanged RTL with both 64x512 program SRAMs on ot_sram_1r1w_64x512_m1_r2c2_p192_mir (<=5.21 pins/um, M4 lead RC in Liberty). PARALLEL fallback: original p192_mir pin plan, macros separated by a 62-um crossing channel (y 43.2 / 259.2), 259.2x453.6, reset landing ON, TritonCTS. p192d FAIL only on TT pin-flop spread 84.6 (FF 72.3; GRT ovf 0): clock entered at the SW corner (S face 6-7.5 um), 713 um Manhattan to the far pin flops -> clk moved to the W-face centre (225-228 um, provisional die pin). Bit-sliced p192_bs master (no W<->E data crossing). Checks: GRT ovf 0, TT/FF spread <=80.",
  "extra_paths": [
   "physical/qfd_tt_ctlm_split",
   "rtl/test/tb_qfd_tt_ctlm_i_psram.sv",
   "rtl/test/run_tt_ctlm_i_lockstep.sh",
   "rtl/lib/sram_p192_1019",
   "tools/mem_compiler/build_qw_p192_1019.py",
   "physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2_p192_bs"
  ],
  "benches": [
   {
    "name": "split_cycle_exact",
    "cmd": "bash physical/qfd_tt_ctlm_split/bench.sh {RUN}/bench/strict strict",
    "expect": "pass",
    "pass_regex": "^PASS tt_ctlm_split strict",
    "threads": 4,
    "peak_ram_gb": 8
   },
   {
    "name": "split_mutant",
    "cmd": "bash physical/qfd_tt_ctlm_split/bench.sh {RUN}/bench/neg strict mut",
    "expect": "fail",
    "fail_regex": "^FAIL tt_ctlm_split strict mut",
    "threads": 4,
    "peak_ram_gb": 8
   },
   {
    "name": "split_argmax",
    "cmd": "bash physical/qfd_tt_ctlm_split/bench.sh {RUN}/bench/argmax strict_argmax",
    "expect": "pass",
    "pass_regex": "^PASS tt_ctlm_split strict_argmax",
    "threads": 4,
    "peak_ram_gb": 8
   }
  ]
 },
 "clock": "cts",
