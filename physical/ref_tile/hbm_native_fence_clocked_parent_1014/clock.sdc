# generated by tools/ref_tile/ref_tile.py (hbm_native_fence_clocked_parent_1014): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports clk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_native_fence_clocked_1014/mixed_clock_phase.sdc
# Private mixed-own-CTS plus independent hard-bank clock entries. No wires-only adoption.
set ot_fence_period [get_property [get_clocks core_clk] period]
if {![llength [get_clocks -quiet ot_entry_0]]} { create_clock -name ot_entry_0 -period $ot_fence_period [get_ports {bank_clks[0]}] }
