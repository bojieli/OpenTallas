  "owner": "Claude:H-ELEM-B",
  "branch": "claude/hbm-elemb-su-1015",
  "tag": "r3",
  "purpose": "Candidate structural per-macro clocks: six distinct provider roots plus one boundary-register root. Previous bank r1 CTS insertion316.9ps/spread92.5ps/slew229.8ps, two SRAMs sharing clocknets. Actual one source per macro, no added data edge/retiming. Serial1111.111111ps unchanged. No route/replication qualification before physical slot/pins and TTsetup FFhold DRC0 nativeclock checks. Native CTS attempt1 rejected mixed raw-macro CTS roots; corrected explicit hybrid policy: six actual raw SRAM pin references plus one CTS root, no macro pin on a CTS source. Word-select flops remain on the existing register root. r3 (H-ELEM-B, coordinator 12:24): the r2 CTS measured raw macro clock slew 417.5 ps because all seven clock pins were clustered on the N face; each raw macro clock pin now sits over its own macro column on the face nearest its row (bottom row 0-2 on S, top row 3-5 on N, 20 um ranges at the macro column centres); register root clk + rst_n stay on N. No RTL change.",
  "views_to": "physical/ref_tile/hbm_su_static_bank6_clock7_1015/views",
  "record_to": "results/arch/hbm_su_f2_static_1014/arithmetic/physical/bank_clock7",
  "benches": [
   {
    "name": "bank_exact",
    "cmd": "bash tools/hbm_static/su_bank_run.sh {RUN}/bench/bank",
    "expect": "pass",
    "pass_regex": "SU_PINNED_BANK PASS",
