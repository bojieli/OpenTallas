    lassign [lindex $pts $st] x y
    lassign [lindex $dirs $st] ux uy
    set off [expr {($bit - ($w - 1) / 2.0) * $ot_rl_spread}]
    set x [expr {$x + $ux * $off}]; set y [expr {$y + $uy * $off}]
