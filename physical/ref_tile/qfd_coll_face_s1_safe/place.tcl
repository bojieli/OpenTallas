set i [ot_ref_pick $ot_ref_by ot_qkvd_llr_replay_sram_leaf {*g_bank?3?*u_store}]
$i setOrient R0; $i setLocation [expr {round(648.0 * $dbu)}] [expr {round(259.2 * $dbu)}]; $i setPlacementStatus FIRM
