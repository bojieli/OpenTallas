  "job": {
    "owner": "Claude:q13-rhead-r2",
    "branch": "claude/q13-kvh",
    "tag": "q13b",
    "purpose": "TP8 KV read head (die cell qkd_rhead x128), two-level cluster 16 closed lane8 + closed ktree. q13b: shared S2b relay stage, symmetric clock spine, corrected child ETMs, recipe 2 (successor of q13a TT -41.92 / FF -64.05). Gates: TT/FF >= 0, DRC 0, layer_hs_pos 14/14 exact + HEAD_HS_TPUT <= 1.10 x 1816, HSMUT mutant FAIL, nr_standin EQUIV.",
    "benches": [
      {
        "name": "layer_hs_pos",
        "cmd": "mkdir -p {RUN}/bench && HSUB=1 DQ=64 HT=1 SBD=16 HUBT=1 bash tools/qwen_kv_die/bench_gate.sh pos {RUN}/bench/hs_pos && python3 tools/qwen_kv_die/head_hs_tput_gate.py {RUN}/bench/hs_pos/results.jsonl {RUN}/bench/head_hs_tput.json",
        "expect": "pass",
        "threads": 8,
        "peak_ram_gb": 16,
        "needs": [
          "verilator"
        ],
        "timeout_s": 43200,
        "min_count_regex": "\"runs\": (\\d+)",
        "pass_regex": "HEAD_HS_TPUT PASS"
      },
      {
        "name": "layer_hs_mut",
        "cmd": "mkdir -p {RUN}/bench && HSUB=1 HSMUT=1 DQ=64 HT=1 SBD=16 HUBT=1 bash tools/qwen_kv_die/bench_gate.sh neg {RUN}/bench/hs_neg 0",
        "expect": "fail",
        "threads": 8,
        "peak_ram_gb": 16,
        "needs": [
          "verilator"
        ],
        "timeout_s": 43200,
        "fail_regex": "\"mismatches\": [1-9]"
      },
      {
        "name": "nr_standin_equiv",
        "cmd": "mkdir -p {RUN}/bench && bash rtl/test/nearhbm/run_nr_standin_equiv.sh {RUN}/bench/eq",
        "expect": "pass",
        "threads": 1,
        "peak_ram_gb": 8,
        "needs": [
          "verilator"
        ],
        "timeout_s": 14400,
        "pass_regex": "^EQUIV PASS"
      }
    ],
    "views_to": "physical/ref_tile/qkh_head_hs_ref/views",
    "record_to": "results/rtl/ref_tile/qkh_head_hs_ref",
    "extra_paths": [
