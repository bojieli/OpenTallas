# generated by tools/ref_tile/ref_tile.py (hdie_col_su_r1): route SDC (over-constrained 833.333 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
# OT_CLOCK_ENTRY_DOMAIN_API_VERSION 1
create_clock -name core_clk -period 833.333000000
create_clock -name ot_io_serial -period 1111.110666667
create_clock -name ot_entry_0 -period 833.333000000 [get_ports {clk_in}]
create_clock -name ot_entry_1 -period 1111.110666667 [get_ports {clk}]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
set_input_transition 150 [all_inputs -no_clocks]
# OT_CLOCK_ENTRY_DOMAIN_API_VERSION 1
# AUTO clock entries: bound insertion.json boundary refs; no ETM arc modification.
set ::ot_ce_leaf_roots 1
set ::ot_ce_related_data 1
set ::ot_ce_refs [dict create ]
set ::ot_ce_counts [dict create ]
set ::ot_ce_domains [dict create {core} {clock core_clk io_budget_ps 166.667 inputs {{cfg_v} {cfg_target} {cfg_addr} {cfg_data} {desc_v} {launch_v}} outputs {}} {serial} {clock ot_io_serial io_budget_ps 222.222 inputs {{rst_n} {tgt} {c_busy} {c_done} {c_fault}} outputs {{pw_we} {pw_addr} {pw_data} {prm} {start_v} {go} {rec} {ready} {active} {fault}}}]
set ::ot_ce_source_domains [dict create {clk_in} {core} {clk} {serial}]
set ::ot_ce_explicit_domains 1
set ::ot_ce_cts_roots {{clk_in} {clk}}
set ::ot_ce_ports {{clk_in} {clk}}
