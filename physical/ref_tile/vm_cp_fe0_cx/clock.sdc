# generated by tools/ref_tile/ref_tile.py (vm_cp_fe0_cx): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_accel_die_views/vm/cp/codex_specs/vm_cp_fe0_fclk.sdc
# vm_cp_fe0: qSE[580] qSE[581] are FORWARDED clocks (ot_fwd_clk_inv of ck, kept inverter at the face), not data
# outputs: the all_outputs data budget (0.2 T referenced to the tree insertion) timed ck -> fclk as data (g1/g2 gates:
# the only negative class; fe2 CTS setup repair from -327 ps crashed ODB-0445). Same modelling as the closed
# hattn_ks_entry (ks_entry_fwd.sdc). Period, uncertainty and every data boundary are unchanged. OPEN at die level:
# fclk-to-data offset = this tile's routed clock insertion; the receiver's source-synchronous budget must use it.
set_false_path -to [get_ports {qSE[580]}]
set_false_path -to [get_ports {qSE[581]}]
