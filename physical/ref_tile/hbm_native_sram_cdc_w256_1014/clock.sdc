# generated by tools/ref_tile/ref_tile.py (hbm_native_sram_cdc_w256_1014): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports wclk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_native_sram_cdc_1014/deep_related_domains.sdc
source /src/physical/hbm_native_bounded_cdc_1014/related_domains.sdc
# Actual TT source-root R315.9/304.3 in predecessor CTS; use deep pair S210/H100.
# No native clock delivery or corner compensation is inferred.
foreach {ot_from ot_to} {core_clk vm_clk vm_clk core_clk} {
 set_clock_uncertainty -setup 210 -from [get_clocks $ot_from] -to [get_clocks $ot_to]
 set_clock_uncertainty -hold 100 -from [get_clocks $ot_from] -to [get_clocks $ot_to]
}
set_input_transition 150 [all_inputs -no_clocks]
