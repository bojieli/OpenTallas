    bit_to : 0;
  }
  type ("dq") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }

  cell ("dsfd_hstnh_1") {
    area : 1.006 
