        rise_constraint(scalar) {
          values("76.78596");
        }
        fall_constraint(scalar) {
          values("78.80831");
        }
      }
    }
    }
    bus("dq") {
      bus_type : dq;
      direction : output;
      capacitance : 0.0000;
    pin("dq[0]") {
      direction : output;
      capacitance : 0.1631;
      timing() {
        related_pin : "ck[0]";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("112.81471,115.12812,119.22896,126.98911,142.24445,172.63733,233.33614");
