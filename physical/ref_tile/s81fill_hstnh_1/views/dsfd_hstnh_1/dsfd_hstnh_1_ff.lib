    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("ck") {
      bus_type : ck;
      direction : input;
      capacitance : 0.0000;
    pin("ck[0]") {
      direction : input;
      clock : true;
      capacitance : 1.4319;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.16206");
        }
        cell_fall(scalar) {
          values("0.16187");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.18481");
        }
        cell_fall(scalar) {
          values("0.18574");
        }
      }
    }
    }
    bus("di") {
      bus_type : di;
      direction : input;
      capacitance : 0.0000;
    pin("di[0]") {
      direction : input;
      capacitance : 0.6987;
      timing() {
        related_pin : "ck[0]";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-60.74063");
        }
        fall_constraint(scalar) {
          values("-62.47996");
        }
      }
      timing() {
        related_pin : "ck[0]";
