    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }
  type ("dq") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }

  cell ("dsfd_hstnh_1") {
    area : 1.006 
    is_macro_cell : true;
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("ck") {
      bus_type : ck;
      direction : input;
      capacitance : 0.0000;
    pin("ck[0]") {
      direction : input;
      clock : true;
      capacitance : 1.3847;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.15181");
        }
        cell_fall(scalar) {
          values("0.15110");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.17607");
        }
        cell_fall(scalar) {
          values("0.17611");
        }
      }
    }
    }
    bus("di") {
      bus_type : di;
      direction : input;
      capacitance : 0.0000;
    pin("di[0]") {
      direction : input;
      capacitance : 0.6586;
      timing() {
        related_pin : "ck[0]";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-85.66758");
        }
        fall_constraint(scalar) {
          values("-85.29607");
        }
      }
      timing() {
        related_pin : "ck[0]";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("99.16292");
        }
        fall_constraint(scalar) {
          values("102.60150");
        }
      }
    }
    }
    bus("dq") {
      bus_type : dq;
      direction : output;
      capacitance : 0.0000;
    pin("dq[0]") {
      direction : output;
      capacitance : 0.1631;
      timing() {
        related_pin : "ck[0]";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("157.41669,160.75964,166.82632,178.39037,201.24083,246.84494,337.95395");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("10.71709,16.69291,28.89354,53.73941,103.98736,204.87100,406.85129");
