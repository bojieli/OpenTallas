  }
  type ("di") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }
  type ("dq") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }

  cell ("dsfd_hstnh_1") {
    area : 1.006 
    is_macro_cell : true;
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("ck") {
      bus_type : ck;
      direction : input;
      capacitance : 0.0000;
    pin("ck[0]") {
      direction : input;
      clock : true;
      capacitance : 1.3566;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.14512");
        }
        cell_fall(scalar) {
          values("0.14447");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.17039");
        }
        cell_fall(scalar) {
          values("0.17039");
        }
      }
    }
    }
    bus("di") {
      bus_type : di;
      direction : input;
      capacitance : 0.0000;
    pin("di[0]") {
      direction : input;
      capacitance : 0.6353;
      timing() {
        related_pin : "ck[0]";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-120.53970");
        }
        fall_constraint(scalar) {
          values("-111.86220");
        }
      }
      timing() {
        related_pin : "ck[0]";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("145.52750");
        }
        fall_constraint(scalar) {
          values("138.86841");
        }
      }
    }
    }
    bus("dq") {
      bus_type : dq;
      direction : output;
      capacitance : 0.0000;
    pin("dq[0]") {
      direction : output;
      capacitance : 0.1631;
      timing() {
        related_pin : "ck[0]";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("236.68793,242.00458,251.58566,270.33304,307.23764,381.06296,528.58093");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("16.76818,26.47090,46.28210,86.56641,167.93460,331.09821,657.69623");
