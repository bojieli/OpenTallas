library (hbfd_rrl_cpad6_ff) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 0.0;
  nom_voltage                    : 0.77;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
  }

  cell ("hbfd_rrl_cpad6") {
    area : 3.995 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.8740;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("24.80250");
        }
        cell_fall(scalar) {
          values("25.67818");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("26.16714");
        }
        cell_fall(scalar) {
          values("27.02533");
        }
      }
    }
    pin("rst_n") {
      direction : output;
      capacitance : 0.1528;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("157.83427,159.54260,162.46632,167.88972,178.33464,199.09061,240.45430");
        }
        rise_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("6.64826,9.43573,15.13957,26.81085,50.68372,98.93432,195.84180");
        }
        cell_fall(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("152.79115,154.42796,157.15297,162.00314,171.26443,189.49475,225.86357");
        }
        fall_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("6.13760,8.55229,13.37335,23.15406,43.11050,83.61996,165.20340");
        }
      }
    }
    pin("rst_n_in") {
      direction : input;
      capacitance : 0.7438;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-31.95761");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("43.99831");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
