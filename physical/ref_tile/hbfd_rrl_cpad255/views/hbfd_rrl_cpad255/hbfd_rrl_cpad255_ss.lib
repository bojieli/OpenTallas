library (hbfd_rrl_cpad255_ss) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 0.63;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
  }

  cell ("hbfd_rrl_cpad255") {
    area : 8.048 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.7619;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("53.30433");
        }
        cell_fall(scalar) {
          values("58.98701");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("57.99670");
        }
        cell_fall(scalar) {
          values("63.07463");
        }
      }
    }
    pin("rst_n") {
      direction : output;
      capacitance : 0.2273;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("332.68445,336.41699,343.17538,355.86957,380.83652,430.51569,529.67676");
        }
        rise_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("14.17495,20.56345,33.67006,60.75786,115.86232,226.87694,449.27499");
        }
        cell_fall(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("317.95911,321.35910,326.98462,336.95557,356.00061,393.50607,468.45068");
        }
        fall_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("12.77074,17.42899,26.69925,45.54296,83.98921,161.98979,318.97937");
        }
      }
    }
    pin("rst_n_in") {
      direction : input;
      capacitance : 0.6708;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-77.78128");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("96.35558");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
