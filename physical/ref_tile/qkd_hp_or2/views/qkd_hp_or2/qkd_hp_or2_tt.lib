    index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
  }

  cell ("qkd_hp_or2") {
    area : 0.802 
    is_macro_cell : true;
    pin("a") {
      direction : input;
      capacitance : 0.7667;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-65.30080");
        }
        fall_constraint(scalar) {
          values("-65.25362");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("81.07415");
        }
        fall_constraint(scalar) {
          values("81.62708");
        }
      }
    }
    pin("b") {
      direction : input;
      capacitance : 0.7232;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-66.82999");
        }
        fall_constraint(scalar) {
          values("-66.23876");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("81.74685");
        }
        fall_constraint(scalar) {
          values("81.89298");
        }
      }
    }
    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 2.0672;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.34115");
        }
        cell_fall(scalar) {
          values("0.33995");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.38193");
        }
        cell_fall(scalar) {
          values("0.38203");
        }
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.1751;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("139.50189,141.91263,146.16080,154.10321,169.58110,200.41345,262.02844");
        }
        rise_transition(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("8.76546,12.84363,21.17171,38.18781,72.71120,142.24277,281.61118");
