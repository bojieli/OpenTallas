        rise_constraint(scalar) {
          values("115.09710");
        }
        fall_constraint(scalar) {
          values("112.25385");
        }
      }
    }
    pin("b") {
      direction : input;
      capacitance : 0.6954;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-94.92570");
        }
        fall_constraint(scalar) {
          values("-88.84136");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("115.89957");
        }
        fall_constraint(scalar) {
          values("112.76889");
        }
      }
    }
    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 2.0391;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.32990");
        }
        cell_fall(scalar) {
          values("0.32879");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.37238");
        }
        cell_fall(scalar) {
          values("0.37240");
        }
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.1751;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000,  184.32001");
          values("212.97011,216.72029,223.40800,236.10886,261.09427,310.77859,409.94260");
