# generated by tools/ref_tile/ref_tile.py (dsfd_r2l_vr_512x1__hsel_negcap_v2): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_die_views/hend/negcap/dsfd_r2l_vr_512x1__hsel.sdc
set ot_hend_setup [expr {[get_property [get_clocks core_clk] period] < 800.0 ? 123 : 60}]
unset_input_delay [all_inputs]
unset_output_delay [all_outputs]
# generated by physical/s81_die_views/glue/make_sdc_hend.sh 0 (r2l)
create_clock -name w_fi0 -period 833.331 [get_ports {fi0*}]
create_clock -name core_clk -period 1111.108 [get_ports {ck*}]
create_clock -name vw -period 833.331
create_clock -name vclk -period 1111.108
set_clock_latency 0 [get_clocks {vclk vw}]
set_clock_uncertainty -setup $ot_hend_setup [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.666 -clock vw [get_ports {di*}]
set_input_delay -min 0 -clock vw [get_ports {di*}]
set_output_delay 372.222 -clock vclk [get_ports {o*}]
set_output_delay -min 0 -clock vclk [get_ports {o*}]
set_false_path -from [get_ports {rs*}]
set_max_fanout 32 [current_design]
set_propagated_clock [get_clocks {core_clk w_*}]

# CLAUDE S81-DIE hub end / start block POST_CTS (make_sdc_hend.sh): each virtual IO clock at its own tree's measured
# WC insertion midpoint (vclk <- core_clk, vw <- the first w_* clock: the forwarded / second-domain tree), output min
# delay from the BC core tree (L - BC max - 25 ps, the S81-PH per-corner convention).
proc ot_ins {clk scene} {
  sta::redirect_string_begin
  set rc [catch {report_clock_latency -clock $clk -scenes $scene}]
  set s [sta::redirect_string_end]
  if {!$rc && [regexp {rise -> rise.*?([0-9.]+)\s+([0-9.]+)\s+latency} $s -> lo hi]} { return [list $lo $hi] }
  sta::redirect_string_begin
  catch {report_clock_latency -clock $clk}
  set s [sta::redirect_string_end]
  if {[regexp {rise -> rise.*?([0-9.]+)\s+([0-9.]+)\s+latency} $s -> lo hi]} { return [list $lo $hi] }
  return {}
}
set ot_w ""
foreach c [get_clocks -quiet {w_*}] { set n [get_property $c full_name]; if {$ot_w eq "" || [string compare $n $ot_w] < 0} { set ot_w $n } }
foreach {c v} [list core_clk vclk $ot_w vw] {
  if {$c eq ""} { continue }
  set wc [ot_ins $c WC]
  if {[llength $wc] == 0} { puts "post_cts_hend: no $c latency"; continue }
  set L [expr {round(([lindex $wc 0] + [lindex $wc 1]) / 2.0)}]
  set_clock_latency $L [get_clocks $v]
  puts "post_cts_hend: $c WC $wc -> $v latency $L"
}
