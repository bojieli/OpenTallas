  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }

  cell ("ot_qfd_vm_fan_t") {
    area : 0.991 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.9538;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.06882");
        }
        cell_fall(scalar) {
          values("0.06872");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.08267");
        }
        cell_fall(scalar) {
          values("0.08324");
        }
      }
    }
    pin("me_e") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("d") {
      bus_type : d;
      direction : input;
      capacitance : 0.0000;
    pin("d[0]") {
      direction : input;
      capacitance : 1.0350;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-87.94796");
        }
        fall_constraint(scalar) {
          values("-94.13428");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("104.42093");
        }
        fall_constraint(scalar) {
          values("110.73428");
        }
      }
    }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[0]") {
      direction : output;
      capacitance : 0.1884;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("122.50858,124.82175,128.92270,136.68279,151.93796,182.33072,243.02982");
