library (ot_qfd_vm_fan_t_ss) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 0.63;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }
  type ("d") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }
  type ("q") {
    base_type : array;
    data_type : bit;
    bit_width : 1;
    bit_from : 0;
    bit_to : 0;
  }

  cell ("ot_qfd_vm_fan_t") {
    area : 0.991 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.8784;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.05851");
        }
        cell_fall(scalar) {
          values("0.05812");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.07389");
        }
        cell_fall(scalar) {
          values("0.07391");
        }
      }
    }
    pin("me_e") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("d") {
      bus_type : d;
      direction : input;
      capacitance : 0.0000;
    pin("d[0]") {
      direction : input;
      capacitance : 0.9100;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-163.58540");
        }
        fall_constraint(scalar) {
          values("-166.59360");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("189.34477");
        }
        fall_constraint(scalar) {
          values("194.33754");
        }
      }
    }
    }
    bus("q") {
      bus_type : q;
      direction : output;
      capacitance : 0.0000;
    pin("q[0]") {
      direction : output;
      capacitance : 0.1884;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("255.49321,260.81180,270.38486,289.13879,326.03690,399.86450,547.38782");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("16.76746,26.47058,46.28198,86.56495,167.93477,331.09653,657.69574");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("285.77713,290.41025,298.32037,312.79590,340.89188,396.79404,508.34091");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("14.95349,21.85134,35.52232,63.17350,119.52331,233.29575,461.75406");
        }
      }
    }
    }
