# generated by tools/ref_tile/ref_tile.py (vm_cp_fe3_cx): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_accel_die_views/vm/cp/codex_specs/vm_cp_fe3_fclk.sdc
# vm_cp_fe3: qNE[580] qNE[581] are FORWARDED clocks (ot_fwd_clk_inv of ck, kept inverter at the face), not data
# outputs. The cx1 routes (eca45f5dc) timed ck -> qNE[580|581] as data under the all_outputs budget: the only stalled
# hold class (ot_hold_stall: I2O=2, "ck -> qNE[*]"); a clock cannot take a pin register. Same modelling as the closed
# fe0/fe1/fe2/fw1/fw2 cx2 kits and hattn_ks_entry. Period, uncertainty and every data boundary are unchanged. OPEN at
# die level: fclk-to-data offset = this tile's routed clock insertion; the receiver source-synchronous budget must use it.
set_false_path -to [get_ports {qNE[580]}]
set_false_path -to [get_ports {qNE[581]}]
