# generated by tools/ref_tile/ref_tile.py (dsfd_vm_fcc_m5): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_ph_views/vm_master/fe_h_str_clock_ref.sdc
# el1013-s81-vmfe: second clock of the two-clock FE leaves dsfd_vm_fcc / dsfd_vm_fcn for the REFERENCE TILE FLOW (sdc_extra;
# core_clk = ck is created by ref_tile's clock.sdc / signoff.sdc).  cks = the stream clock, period 3/4 of ck, one die PLL:
# the ot_ratio_cdc_fifo crossings are flop -> flop arcs timed between the two RELATED clocks (no clock groups), as
# physical/s81_ph_views/vm_master/str_clock_vm.sdc does for the flat FE.  ref_tile signs every leaf off with ck at 833.333 ps
# (the real VM serial clock is 1,111.1 ps), so cks is 625 ps here: both domains and the crossing window (208 ps instead of
# 278 ps) are STRICTER than the design clocks, never looser.  Stream-domain IO: 0.2 T of str_clk.
create_clock -name str_clk -period [expr {[get_property [get_clocks core_clk] period] * 3.0 / 4.0}] [get_ports {cks}]
set_clock_uncertainty -setup 60 [get_clocks str_clk]
set_clock_uncertainty -hold 25 [get_clocks str_clk]
catch {unset_input_delay -clock core_clk [get_ports {cks}]}
set ot_ti [get_ports -quiet {vwe vwa[*] vwd[*] vre vra[*] cv cd[*]}]
if {[llength $ot_ti]} {
  catch {unset_input_delay -clock core_clk $ot_ti}
  set_input_delay [expr {[get_property [get_clocks str_clk] period] * 0.2}] -clock str_clk $ot_ti
}
set ot_to [get_ports -quiet {dv dt[*]}]
if {[llength $ot_to]} {
  catch {unset_output_delay -clock core_clk $ot_to}
  set_output_delay [expr {[get_property [get_clocks str_clk] period] * 0.2}] -clock str_clk $ot_to
}
# asynchronous resets enter through synchronisers; fe_flt is sticky status (no fixed-cycle requirement)
set_false_path -from [get_ports -quiet {rst rss}]
set_false_path -to [get_ports -quiet {fe_flt[*]}]
