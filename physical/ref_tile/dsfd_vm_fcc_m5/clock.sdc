# generated by tools/ref_tile/ref_tile.py (dsfd_vm_fcc_m5): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_ph_views/vm_master/fe_h_str_clock_ref.sdc
# el1013-s81-vmfe/B6: the two clocks of dsfd_vm_fcc / dsfd_vm_fcn at their TRUE periods for the REFERENCE TILE FLOW
# (spec sdc_extra: inlined at the end of clock.sdc and signoff.sdc; re-read after every io_ref switch by
# fe_h_str_boundary.tcl).  One die PLL, ratio 4 : 3:
#   str_clk = cks, the stream clock    = the period ref_tile generated for core_clk (route 770 ps, sign-off 833.333 ps)
#   core_clk = ck, the VM serial clock = 4/3 of it                                  (route 1,026.667, sign-off 1,111.111)
# B5's version kept ck at 833.333 and put cks at 3/4 of it (625 ps): 33 % stricter than the design in both domains and in
# the crossing window (208 instead of 278 ps); its -308 ps (fcn dv / dt) and -27 ps (fcc u_cc1.wp_r) were measured there.
# B8 (coordinator decision 10-13 (a) / (b)): the two clocks stay RELATED and every arc between them stays TIMED at the
# 277.8-ps window and the coincident-edge hold, EXCEPT the arcs of a real two-clock crossing, which are named one by one at
# the end of this file (ot_fh_cdc): Gray pointer / online / sticky level -> the FIRST flop of its 2-flop synchroniser, and
# FIFO storage -> its read-domain register (read only after the synchronised pointer).  No clock group, no false path
# between the clocks, nothing on a same-domain path.
# Boundary, both domains, the io_ref_skew.sdc form re-referenced to each clock's OWN propagated tree:
#   in  max = E + L_max + 90   min = L_min          out max = E - L_max + 90   min = -L_min - 50
#   L = clock arrival of the domain's boundary register of median arrival (0 while the clocks are ideal)
#   E = period - (base - 166.667): every pin keeps the budget of an 833.333-ps leaf (pin -> flop / flop -> pin within
#       0.8 x 833.333), in the stream domain (E = 166.667 = 0.2 T) and in the serial domain alike (E = 444.444: the
#       neighbours of these pins are leaves signed off at 833.333, so the longer serial period is NOT given to the pins)
set ot_fh_core [get_clocks core_clk]
set ot_fh_cp [get_property $ot_fh_core period]
set ot_fh_str [get_clocks -quiet str_clk]
if {[llength $ot_fh_str] && abs($ot_fh_cp - [get_property $ot_fh_str period] * 4.0 / 3.0) < 0.01} {
  set ot_fh_base [get_property $ot_fh_str period]         ;# already applied (in-flow re-read): keep the clocks
} else {
  set ot_fh_base $ot_fh_cp                                ;# fresh clock.sdc / signoff.sdc: core_clk was just created at the base
  set ot_fh_prop 0
  catch {set ot_fh_prop [get_property $ot_fh_core is_propagated]}
  create_clock -name str_clk -period $ot_fh_base [get_ports {cks}]
  create_clock -name core_clk -period [expr {$ot_fh_base * 4.0 / 3.0}] [get_ports {ck}]
  if {$ot_fh_prop} { set_propagated_clock [all_clocks] }
  set_clock_uncertainty -setup 60 [all_clocks]
  set_clock_uncertainty -hold 25 [all_clocks]
}
set ot_fh_cp [get_property [get_clocks core_clk] period]
proc ot_fh_ref {globs} {
  # {L_max L_min} of the median-arrival CLK pin over the cells matching the globs; {0 0} while the clock is ideal
  catch {sta::worst_slack_cmd max}
  set pf {}
  foreach g $globs {
    foreach c [get_cells -quiet -hierarchical $g] {
      set p [get_pins -quiet "[get_full_name $c]/CLK"]
      if {![llength $p]} { continue }
      set a [get_property $p arrival_max_rise]; set b [get_property $p arrival_min_rise]
      if {[string is double -strict $a] && [string is double -strict $b] && abs($a) < 1e6 && abs($b) < 1e6} { lappend pf [list $a $b] }
    }
  }
  if {![llength $pf]} { return {0.0 0.0 0} }
  set pf [lsort -real -index 0 $pf]
  set m [lindex $pf [expr {[llength $pf] / 2}]]
  return [list [lindex $m 0] [lindex $m 1] [llength $pf]]
}
# stream-domain ports (fcc: the ctrl VM request; fcn: the engine channel); everything else is serial
set ot_fh_si [get_ports -quiet {vwe vwa[*] vwd[*] vre vra[*] cv cd[*] vwe[*] vre[*] cv[*]}]
set ot_fh_so [get_ports -quiet {dv dt[*] dv[*]}]
set ot_fh_sn {}
foreach p [concat $ot_fh_si $ot_fh_so] { lappend ot_fh_sn [get_full_name $p] }
set ot_fh_ci {}; set ot_fh_co {}
foreach p [all_inputs -no_clocks] { if {[lsearch -exact $ot_fh_sn [get_full_name $p]] < 0} { lappend ot_fh_ci $p } }
foreach p [all_outputs] { if {[lsearch -exact $ot_fh_sn [get_full_name $p]] < 0} { lappend ot_fh_co $p } }
catch {unset_input_delay [all_inputs]}
catch {unset_output_delay [all_outputs]}
lassign [ot_fh_ref {*u_s0*}] ot_fh_cx ot_fh_cn ot_fh_cc
lassign [ot_fh_ref {cd_p* dt_q* s_wd*}] ot_fh_sx ot_fh_sm ot_fh_sc
set ot_fh_ce [expr {$ot_fh_cp - ($ot_fh_base - 166.667)}]
set ot_fh_se 166.667
puts [format "FE_H two-clock boundary: base %.3f core_clk %.3f str_clk %.3f | serial E %.3f L %.1f / %.1f (%d out flops) | stream E %.3f L %.1f / %.1f (%d pin flops) | ports serial %d in %d out, stream %d in %d out" \
  $ot_fh_base $ot_fh_cp $ot_fh_base $ot_fh_ce $ot_fh_cx $ot_fh_cn $ot_fh_cc $ot_fh_se $ot_fh_sx $ot_fh_sm $ot_fh_sc \
  [llength $ot_fh_ci] [llength $ot_fh_co] [llength $ot_fh_si] [llength $ot_fh_so]]
if {[llength $ot_fh_ci]} {
  set_input_delay [expr {$ot_fh_ce + $ot_fh_cx + 90}] -max -clock core_clk $ot_fh_ci
  set_input_delay [expr {$ot_fh_cn}] -min -clock core_clk $ot_fh_ci
}
if {[llength $ot_fh_co]} {
  set_output_delay [expr {$ot_fh_ce - $ot_fh_cx + 90}] -max -clock core_clk $ot_fh_co
  set_output_delay [expr {0 - $ot_fh_cn - 50}] -min -clock core_clk $ot_fh_co
}
if {[llength $ot_fh_si]} {
  set_input_delay [expr {$ot_fh_se + $ot_fh_sx + 90}] -max -clock str_clk $ot_fh_si
  set_input_delay [expr {$ot_fh_sm}] -min -clock str_clk $ot_fh_si
}
if {[llength $ot_fh_so]} {
  set_output_delay [expr {$ot_fh_se - $ot_fh_sx + 90}] -max -clock str_clk $ot_fh_so
  set_output_delay [expr {0 - $ot_fh_sm - 50}] -min -clock str_clk $ot_fh_so
}
# asynchronous resets enter through synchronisers
set_false_path -from [get_ports -quiet {rst rss rst[*] rss[*]}]

# ---- B8: the real two-clock crossings of dsfd_vm_fcn (ot_s81_engine_adapter XRT 1: u_cmd stream -> serial, u_done serial ->
# stream, both ot_async_fifo EXT_RST 1) and dsfd_vm_fcc (g_cca.u_cc0 / u_cc1, stream -> serial).  Structure (rtl/lib/
# ot_async_fifo.sv): wr_gray / rd_gray are REGISTERS, Gray-coded, each sampled by two flops in the other domain (wr_gray_r1 /
# _r2, rd_gray_w1 / _w2); empty / full are registered from the synchronised pointer; a storage word is read (mem -> read
# mux -> the first read-domain register) only while rd_valid, i.e. >= 2 read cycles after the write edge that stored it,
# and is not rewritten before the read pointer has crossed back.  Constraint of those arcs, and of nothing else:
#   pointer / online / sticky level -> first synchroniser flop : max datapath delay 0.5 x T_stream (= the bus-skew bound of
#                                                                a Gray pointer: bits within half a period of the faster
#                                                                clock + the source tree's spread), no hold relation
#   storage -> read-domain register                            : max datapath delay 1.0 x T_stream - 60 ps, no hold relation
# (OpenSTA has no -datapath_only / set_bus_skew: -ignore_clock_latency + false-path -hold is the same check; the per-bus
#  spread is REPORTED after every re-read, line "FE_H CDC bus".)
proc ot_fh_cdc {} {
  set ts [get_property [get_clocks str_clk] period]
  set cls {
    ptr_s {[.](wr_gray|rd_gray)\[[0-9]+\]}  ptr_d {[.](wr_gray_r1|rd_gray_w1)\[[0-9]+\]}
    onl_s {[.](wr_online|rd_online)([^_a-z]|$)}  onl_d {[.](wr_online_r1|rd_online_w1)([^0-9a-z]|$)}
    lvl_s {(u_ad[.]ef([^_a-z]|$)|u_ad[.]g_xrt[.]e_rt\[0\]|(^|[.])s_ovf([^_a-z]|$))}  lvl_d {(u_ad[.]ef_c1|u_ad[.]eonline_c1|(^|[.])so_s\[0\]|ad_flt_s\[0\])([^0-9a-z]|$)}
    mem {[.]u_fifo[.]mem\[|g_cca[.]u_cc[01][.]mem\[}
  }
  foreach k {ptr_s ptr_d onl_s onl_d lvl_s lvl_d mem_s mem_c} { set L($k) {} }
  foreach c [all_registers -cells] {
    set n [get_full_name $c]
    foreach k {ptr_d onl_d lvl_d ptr_s onl_s lvl_s} {
      if {[regexp [dict get $cls $k] $n]} { lappend L($k) $c; break }
    }
    if {[regexp [dict get $cls mem] $n]} {
      # the storage of a FIFO lives in its WRITE domain: u_cmd / g_cca.u_cc* = stream, u_done = serial
      if {[regexp {u_done[.]u_fifo} $n]} { lappend L(mem_c) $c } else { lappend L(mem_s) $c }
    }
  }
  set dp [expr {0.5 * $ts}]; set dm [expr {$ts - 60.0}]
  # by DESTINATION: the D pin of a first synchroniser flop has no other source than the crossing (yosys merges a Gray
  # pointer's MSB flop with the binary pointer's, so a source list by name misses bits: gate 184111, 12 of 16)
  foreach b {ptr_d onl_d lvl_d} {
    if {[llength $L($b)]} {
      set_max_delay -ignore_clock_latency $dp -to $L($b)
      set_false_path -hold -to $L($b)
    }
  }
  if {[llength $L(mem_s)]} {
    set_max_delay -ignore_clock_latency $dm -from $L(mem_s) -to [get_clocks core_clk]
    set_false_path -hold -from $L(mem_s) -to [get_clocks core_clk]
  }
  if {[llength $L(mem_c)]} {
    set_max_delay -ignore_clock_latency $dm -from $L(mem_c) -to [get_clocks str_clk]
    set_false_path -hold -from $L(mem_c) -to [get_clocks str_clk]
  }
  puts [format "FE_H CDC arcs: Gray pointer %d -> %d first synchroniser flops, online %d -> %d, sticky level %d -> %d (max datapath %.1f ps, no hold); storage stream %d / serial %d flops -> read-domain registers (max datapath %.1f ps, no hold)" \
    [llength $L(ptr_s)] [llength $L(ptr_d)] [llength $L(onl_s)] [llength $L(onl_d)] [llength $L(lvl_s)] [llength $L(lvl_d)] $dp \
    [llength $L(mem_s)] [llength $L(mem_c)] $dm]
  # per-bus spread of the Gray pointers (data arrival at the first synchroniser flop's D, max - min over the bits)
  catch {
    array set B {}
    foreach c $L(ptr_d) {
      set n [get_full_name $c]
      if {![regexp {^(.*)\[[0-9]+\]} $n -> bus]} { continue }
      set dpin [get_pins -quiet "$n/D"]
      if {![llength $dpin]} { continue }
      set pth [find_timing_paths -to $dpin -path_delay max -group_path_count 1]
      if {![llength $pth]} { continue }
      set p0 [lindex $pth 0]
      set d [expr {[get_property $p0 arrival] - [get_property [get_property $p0 startpoint_clock] period] * 0}]
      lappend B($bus) $d
    }
    foreach bus [lsort [array names B]] {
      set v [lsort -real $B($bus)]
      puts [format "FE_H CDC bus %s: %d bits, arrival %.1f .. %.1f ps, spread %.1f ps (bound %.1f)" $bus [llength $v] [lindex $v 0] [lindex $v end] [expr {[lindex $v end] - [lindex $v 0]}] $dp]
    }
  }
}
ot_fh_cdc
