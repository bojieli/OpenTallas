    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.8413;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("46.22215");
        }
        cell_fall(scalar) {
          values("52.87357");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("49.05999");
        }
        cell_fall(scalar) {
          values("55.34925");
        }
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.7898;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-81.42222");
        }
        fall_constraint(scalar) {
          values("-73.88419");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("98.03645");
        }
        fall_constraint(scalar) {
          values("100.85252");
        }
      }
    }
    pin("q0") {
      direction : output;
      capacitance : 0.2348;
