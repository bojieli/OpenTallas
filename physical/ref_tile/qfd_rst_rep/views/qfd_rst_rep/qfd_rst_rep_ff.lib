    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.9119;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("23.63983");
        }
        cell_fall(scalar) {
          values("24.55738");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("24.75431");
        }
        cell_fall(scalar) {
          values("25.67807");
        }
      }
    }
    pin("d") {
      direction : input;
      capacitance : 0.8603;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-39.69263");
        }
        fall_constraint(scalar) {
          values("-38.16026");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("51.38572");
        }
        fall_constraint(scalar) {
          values("54.94630");
        }
      }
    }
