# generated by tools/ref_tile/ref_tile.py (smh_own_wg_ref): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports cut_2]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra results/arch/hbm_native_1013/sm_own_logic/own_generated_clock.sdc
# This port is the retained ICG GCLK output, not a data signal.
# Model its actual source latency; all 617 data/control cut nets retain normal IO constraints.
unset_output_delay [get_ports cut_7768]
create_generated_clock -name own_gated_fwd -source [get_ports cut_2] -master_clock core_clk -divide_by 1 [get_ports cut_7768]
set_propagated_clock [get_clocks own_gated_fwd]
set_clock_uncertainty -setup 60 [get_clocks own_gated_fwd]
set_clock_uncertainty -hold 25 [get_clocks own_gated_fwd]
set_input_transition 150 [all_inputs -no_clocks]
