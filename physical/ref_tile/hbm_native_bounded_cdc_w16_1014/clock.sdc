# generated by tools/ref_tile/ref_tile.py (hbm_native_bounded_cdc_w16_1014): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports wclk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_native_bounded_cdc_1014/related_domains.sdc
# Exact propagated clock-path selection adapted from deployed 9ebcd61e5/59774111c.
proc ot_ce_finite {value} {
  return [expr {[string is double -strict $value] && ![regexp -nocase {inf|nan} $value]}]
}
proc ot_bound_clock_arr {pin clock sense} {
  set scene [get_property [sta::cmd_scene] name]
  set clock_name [get_full_name $clock]
  set values {}
  foreach vertex [$pin vertices] {
    if {$vertex eq "NULL"} continue
    set paths [$vertex path_iterator rise $sense]
    while {[$paths has_next]} {
      set path [$paths next]
      # OpenSTA's Path tag identifies scene, rise/max, clock and propagation.
      # Match the complete fixed fields, never accept another scene's path.
      set tag [$path tag]
      if {[lindex $tag 1] ne $scene || [lindex $tag 2] ne "^$sense" ||
          [lindex $tag 3] ne $clock_name || [lindex $tag 4] ne "^" ||
          [string first "(clock prop)" $tag] < 0} continue
      set arrival [sta::time_sta_ui [$path arrival]]
      if {![ot_ce_finite $arrival]} {
        $paths finish
        error "BOUNDED_CDC_CLOCK_PATH: nonfinite propagated clock arrival on [get_full_name $pin] scene=$scene clock=$clock_name"
      }
      lappend values $arrival
    }
    $paths finish
  }
  if {[llength $values] != 1} {
    # Synthesis/floorplan have no extracted entry wire. This is solely a finite
    # pre-CTS diagnostic reference; routed gates must measure a clock path.
    if {![llength $values] && [info exists ::ot_ref_pre_cts] && $::ot_ref_pre_cts &&
        (![info exists ::ot_ce_require_wire] || !$::ot_ce_require_wire)} {
      puts "BOUNDED_CDC_CLOCK_PATH PRE_CTS_ZERO_WIRE [get_full_name $pin] scene=$scene"
      return 0.0
    }
    error "BOUNDED_CDC_CLOCK_PATH: missing unique finite propagated clock arrival on [get_full_name $pin] scene=$scene clock=$clock_name"
  }
  return [lindex $values 0]
}

# Related PLL /3 and /4 clocks. No asynchronous groups or crossing exceptions.
set ot_bound_period [expr {[get_property [get_clocks core_clk] period]*4.0/3.0}]
create_clock -name vm_clk -period $ot_bound_period [get_ports rclk]
# IO-reference SDCs can carry explicit rising/falling delays on a secondary clock source.
# Clear every clock-tagged edge before querying the actual clock-pin boundary arrivals.
foreach ot_c [all_clocks] {
 foreach ot_p [get_ports {wclk rclk}] {
  unset_input_delay -clock $ot_c $ot_p
  unset_input_delay -clock $ot_c -clock_fall $ot_p
 }
}
unset_input_delay [get_ports {wclk rclk}]
puts "BOUNDED_CDC_PERIODS core=[get_property [get_clocks core_clk] period] vm=[get_property [get_clocks vm_clk] period] ratio=4/3"
# Canonical same-domain60/25 remains; related4:3 crossings use S150/H100.
set_clock_uncertainty -setup 60 [get_clocks {core_clk vm_clk}]
set_clock_uncertainty -hold 25 [get_clocks {core_clk vm_clk}]
foreach {ot_from ot_to} {core_clk vm_clk vm_clk core_clk} {
 set_clock_uncertainty -setup 150 -from [get_clocks $ot_from] -to [get_clocks $ot_to]
 set_clock_uncertainty -hold 100 -from [get_clocks $ot_from] -to [get_clocks $ot_to]
}
foreach {c ins outs} {core_clk {wrst_n we wdata* wepoch*} {full rd_freed* w_fault} vm_clk {rrst_n re repoch*} {rdata* empty r_fault}} {
 set cc [get_clocks $c]; set offmax 0; set offmin 0
 if {![info exists ::ot_ref_pre_cts] || !$::ot_ref_pre_cts} {
  set_clock_latency -source 0 $cc
  set_propagated_clock $cc; sta::worst_slack_cmd max
  set arrivals {}
  foreach pin [all_registers -clock $cc -clock_pins] {
   set a [ot_bound_clock_arr $pin $cc max]
   if {[string is double -strict $a]} { lappend arrivals [list $a $pin] }
  }
  if {![llength $arrivals]} { error "BOUNDED_CDC: actual clock root has no timed registers $c" }
  set a [lindex [lsort -real -index 0 $arrivals] [expr {[llength $arrivals]/2}]]
  set offmax [lindex $a 0];set offmin [ot_bound_clock_arr [lindex $a 1] $cc min]
  puts "BOUNDED_CDC_BOUNDARY $c logicalclockpins=[llength $arrivals] min=$offmin max=$offmax"
 }
 set budget [expr {$c eq "core_clk" ? 166.6666 : 222.2222}]
 set ip {}; set op {}
 foreach pat $ins { foreach x [get_ports -quiet $pat] { lappend ip $x } }
 foreach pat $outs { foreach x [get_ports -quiet $pat] { lappend op $x } }
 unset_input_delay $ip;unset_output_delay $op
 set_input_delay [expr {$budget+$offmax+90}] -max -clock $cc $ip
 set_input_delay $offmin -min -clock $cc $ip
 set_output_delay [expr {$budget-$offmax+90}] -max -clock $cc $op
 set_output_delay [expr {-$offmin-50}] -min -clock $cc $op
}
# ---- sdc_extra physical/hbm_native_bounded_cdc_1014/cdc_arcs.sdc
# Native CDC crossing arcs (A4 HBM group A 2026-10-14; pattern of the accepted dsfd_vm_fcn/fcc B8 constraint).
# Routed npin1 w1/w16: FF hold -88/-93 on 548 reg->reg endpoints, ALL two-domain crossings core_clk <-> vm_clk:
# slots -> landed_slots (400) and the first synchroniser flops of the epoch rails / Gray ack / Gray publish counts (148).
# Structure (ot_hbm_native_{bounded,sram}_cdc): ack / pub are Gray counts (and their complement rails) sampled by two
# flops; the 32-bit epochs change only while both sides are drained and are checked rail-against-rail after two flops (an
# incoherent sample is a transient mismatch that blocks, never a value); a landed slot is selected by the consumer only
# after its publication crossed two synchroniser edges, and the source does not rewrite it before the consumer's Gray
# release crossed back.  Constraint of those arcs, and of nothing else (by DESTINATION, the D of a first synchroniser /
# landing flop has no other source than the crossing):
#   source register -> first synchroniser flop : max datapath 0.5 x min period (Gray bus-skew bound), no hold relation
#   slots -> landed_slots                       : max datapath 1.0 x min period - 60 ps, no hold relation
# (OpenSTA has no -datapath_only / set_bus_skew: -ignore_clock_latency + false-path -hold is the same check.)
proc ot_ncdc_arcs {} {
  set t [expr {min([get_property [get_clocks core_clk] period],[get_property [get_clocks vm_clk] period])}]
  set syc {}; set syv {}; set ld {}
  foreach c [all_registers -cells] {
    set b [string trimleft [lindex [split [get_full_name $c] "\["] 0] "\\"]
    if {[lsearch -exact {ack1 ackn1 re1 ren1} $b] >= 0} {
      lappend syc $c
    } elseif {[lsearch -exact {pub1 pubn1 we1 wen1} $b] >= 0} {
      lappend syv $c
    } elseif {$b eq "landed_slots"} {
      lappend ld $c
    }
  }
  # -from the OTHER domain's clock: only the crossing arcs, never the destination's own reset / pin paths
  # (plain variables in the constraint commands: OpenSTA's sdc_file_line list-parses the calling command text)
  set dp [expr {0.5*$t}]; set dm [expr {$t-60.0}]
  set cc [get_clocks core_clk]; set vc [get_clocks vm_clk]
  if {[llength $syc]} {
    set_max_delay -ignore_clock_latency $dp -from $vc -to $syc
    set_false_path -hold -from $vc -to $syc
  }
  if {[llength $syv]} {
    set_max_delay -ignore_clock_latency $dp -from $cc -to $syv
    set_false_path -hold -from $cc -to $syv
  }
  if {[llength $ld]} {
    set_max_delay -ignore_clock_latency $dm -from $cc -to $ld
    set_false_path -hold -from $cc -to $ld
  }
  set sy [concat $syc $syv]
  puts [format "NATIVE_CDC arcs: %d first synchroniser flops (max datapath %.1f ps, no hold), %d landing flops (max datapath %.1f ps, no hold)" [llength $sy] $dp [llength $ld] $dm]
}
ot_ncdc_arcs
set_input_transition 150 [all_inputs -no_clocks]
