      direction : input;
      capacitance : 0.0000;
    }
    pin("tv_e[2]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("tv_e[1]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("tv_e[0]") {
      direction : input;
      capacitance : 0.0000;
    }
    }
  }

}
