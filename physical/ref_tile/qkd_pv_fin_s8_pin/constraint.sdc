# GENERATED by tools/ref_tile/ref_tile.py (qkd_pv_fin_s8_pin): core-view golden SDC, gen_phys.sdc form (CP1-R10);
# ps / fF.  Sign-off: tools/die_plan/signoff.py --ff-vclk bound-ff --ff-bound-ps 202.5.
create_clock -name clk -period 833.0000 [get_ports {ck}]
# the partition logic around the core runs on the core-view insertion (250 ps): virtual IO clock
create_clock -name vclk -period 833.0000
set_clock_latency -source 250.0000 [get_clocks vclk]
set_clock_uncertainty 0.0000 -setup [all_clocks]
set_clock_uncertainty 25.0000 -hold [all_clocks]
# seam paths: uncertainty counted once per seam: 0.5 on each side
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -setup 0.0000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -setup 0.0000
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks clk] -to [get_clocks vclk] -hold 12.5000
set non_clk_in [all_inputs -no_clocks]
set_input_delay -max 166.6000 -clock vclk $non_clk_in
set_output_delay -max 166.6000 -clock vclk [all_outputs]
# reset: synchronous landing (reset_landing.json), data IO budget
# seam hold: neighbour face flop launches from the fast end of the insertion window (-tol, no credit)
set_input_delay -min -40.0000 -clock vclk $non_clk_in
set_output_delay -min 0.0000 -clock vclk [all_outputs]
set_load 2 [all_outputs]
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y $non_clk_in
