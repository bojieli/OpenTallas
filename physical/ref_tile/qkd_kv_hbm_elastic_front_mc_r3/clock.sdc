# generated by tools/ref_tile/ref_tile.py (qkd_kv_hbm_elastic_front_mc_r3): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports pll_hbm]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qwen_kv_die_native_static_pins/qkd_kv_hbm_elastic_front_mc_r3.sdc

# Four actual die-delivered storage clocks; ordinary STA between same-phase HBM roots.
for {set i 0} {$i<4} {incr i} {
 create_clock -name hdata_$i -period [get_property [get_clocks core_clk] period] [get_ports [format {pll_hbm_data[%d]} $i]]
 set_clock_uncertainty -setup 60 [get_clocks hdata_$i]
 set_clock_uncertainty -hold 25 [get_clocks hdata_$i]
 if {[get_property [get_clocks core_clk] is_propagated]} {set_propagated_clock [get_clocks hdata_$i]}
}
set_input_transition 150 [all_inputs -no_clocks]
