   "physical/asap7_memory_macros_v2/ot_sram_1r1w_1024x256_m2_r2c2",
   "physical/common_flow/assigned_pin_exact.tcl",
   "physical/common_flow/macro_channel_block.tcl",
   "physical/common_flow/clock_entries.tcl"
  ],
  "record_to": "results/rtl/ref_tile/hnx_vms_bank",
  "views_to": "physical/ref_tile/hnx_vms_bank/views",
