 "safe_design_checklist": {
  "1_pins": "all ports on the W face touching the shell E face; ~1200 pins / 432.0 um",
  "2_reach": "engine face direct to the touching shell; internal hops < 405 um",
  "3_fanout": "native32 source max 32; wrapper copies (reset leaves, w_v BUFs) <= 20 loads; raw census max 32",
  "4_depth": "native engine at 1.667 ns (ingest clock)",
  "5_storage": "32 actual 32x128 one-read/one-write SRAM macros; exact regenerated instances97851..97882, clock pins bound to ck_ingest; 75.6x43.2 lattice.",
  "6_floorplan": "util ~40-50 %; FALLBACK enlarges",
  "7_clock": "ck_ingest owns actual engine sinks and all32 SRAM clock pins; ck_rl owns two landing plus35 reset leaves. Fixed1:1 intended relation retained; physical spread/phase remain measured qualification obligations.",
  "8_reset": "34 kept engine-region reset leaves, control only"
 },
