create_clock -name core_clk -period 770.0000 [get_ports {ck}]
set_clock_uncertainty -setup 60.0000 core_clk
set_clock_uncertainty -hold 25.0000 core_clk
set_propagated_clock [get_clocks {core_clk}]
create_clock -name clk_i -period 1540.0000 [get_ports {clk_i}]
set_clock_uncertainty -setup 60.0000 clk_i
set_clock_uncertainty -hold 25.0000 clk_i
set_propagated_clock [get_clocks {clk_i}]
create_clock -name clk_h -period 1000.0000 [get_ports {clk_h}]
set_clock_uncertainty -setup 60.0000 clk_h
set_clock_uncertainty -hold 25.0000 clk_h
set_propagated_clock [get_clocks {clk_h}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {clk_h}]\
 -group [get_clocks {clk_i}]\
 -group [get_clocks {core_clk}]
