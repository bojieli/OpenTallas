# hdie_svg_fg2w: sign-off at 833.333 ps (generated by tools/ref_tile/ref_tile.py; same form as
# physical/qwen_die_masters/jobs/signoff_sdc.py): clock re-created at the real period, propagated, 60 / 25 ps uncertainty,
# die-context boundary io_ref_skew.sdc with this block's REFGLOB / INTER bound.
set ::ot_ref_pre_cts 0
# OT_CLOCK_ENTRY_DOMAIN_API_VERSION 1
create_clock -name core_clk -period 833.333000000
create_clock -name ot_io_hbm -period 1024.000000000
create_clock -name ot_entry_0 -period 833.333000000 [get_ports {stream_clk}]
create_clock -name ot_entry_1 -period 833.333000000 [get_ports {stream_bank_clk[0]}]
create_clock -name ot_entry_2 -period 833.333000000 [get_ports {stream_bank_clk[1]}]
create_clock -name ot_entry_3 -period 1024.000000000 [get_ports {hbm_clk}]
create_clock -name ot_entry_4 -period 1024.000000000 [get_ports {hbm_fifo_clk[0]}]
create_clock -name ot_entry_5 -period 1024.000000000 [get_ports {hbm_fifo_clk[1]}]
create_clock -name ot_entry_6 -period 1024.000000000 [get_ports {hbm_pc_clk[0]}]
create_clock -name ot_entry_7 -period 1024.000000000 [get_ports {hbm_pc_clk[1]}]
create_clock -name ot_entry_8 -period 1024.000000000 [get_ports {hbm_pc_clk[2]}]
create_clock -name ot_entry_9 -period 1024.000000000 [get_ports {hbm_pc_clk[3]}]
set_propagated_clock [all_clocks]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set ::env(OT_IO_SKEW) 90
set ::env(OT_IO_HOLD_SKEW) 50
set ::env(OT_REF_GLOB) {*}
set ::env(OT_IO_INTER) {none_*}
set ::env(OT_IO_SKEW_INTER) 150
set ::ot_ce_require_wire 1
# OT_CLOCK_ENTRY_DOMAIN_API_VERSION 1
# AUTO clock entries: bound insertion.json boundary refs; no ETM arc modification.
set ::ot_ce_leaf_roots 1
set ::ot_ce_related_data 0
set ::ot_ce_refs [dict create ]
set ::ot_ce_counts [dict create ]
set ::ot_ce_domains [dict create {core} {clock core_clk io_budget_ps 166.667 inputs {{stream_rst_n} {id_stack} {id_sm} {program_cfg_we} {program_cfg_addr} {program_cfg_data} {desc_we} {desc_addr} {desc_data} {run_v} {run_base} {run_count}} outputs {{running} {run_done} {program_active} {fault} {sm_packet} {sm_command} {expected_request} {lt0} {lt1} {lb0} {lb1} {fm}}} {hbm} {clock ot_io_hbm io_budget_ps 204.8 inputs {{hbm_rst_n} {k_rdy} {k_wr_done} {kr_v} {kr_tag} {kr_beat} {kr_data}} outputs {{k_v} {k_addr} {k_len} {k_tag} {k_we} {k_wdata} {k_wstrb} {kr_rdy}}}]
