    "pass_regex": "BENCH PASS p4_m0_t0",
    "threads": 8,
    "peak_ram_gb": 24,
    "cmd": "bash rtl/hbm_next/sm/tb/run_leaf_bench.sh {RUN}/xs4 4 0 0 -DHNX_XS4"
   }
  ]
 },
