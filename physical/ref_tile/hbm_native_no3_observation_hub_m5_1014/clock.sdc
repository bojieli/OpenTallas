# generated by tools/ref_tile/ref_tile.py (hbm_native_no3_observation_hub_m5_1014): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports clk_sm]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_native_no3_observation_1014/observation_clock.sdc
# Source-bound observation-only ABI; literal six-master receiver census is in census.py.
# No functional clock/data receiver is driven by fclk_observe in this composition.
# Keep the old generic data-output negative receipt as a separate immutable diagnostic.
unset_output_delay [get_ports fclk_observe]
create_generated_clock -name no3_observe_clk -source [get_ports clk_sm] -divide_by 1 [get_ports fclk_observe]
set_clock_uncertainty -setup 60 [get_clocks no3_observe_clk]
set_clock_uncertainty -hold 25 [get_clocks no3_observe_clk]
set_propagated_clock [get_clocks no3_observe_clk]
puts "NO3_OBSERVATION_ABI literal_clk_sm same_edge divide1 top_output_only external_load80"
set_input_transition 150 [all_inputs -no_clocks]
