# generated by tools/ref_tile/ref_tile.py (qfd_c_b16_reg1): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck_c1r1]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qcluster/qfd_c_b16_reg1_regions.sdc
# GENERATED by tools/qwen_cluster/qc_reg_kit.py -- do not edit.  CB16 representative region c1r1: four neighbour
# region roots (same period, related, neighbour-relative delivery), die residual between communicating pairs, and
# the landed bank window on every crossing (LANDING-CONTRACT L5: writer -> reader multicycle -setup 2 -hold 3).
set ot_q_per [get_property [get_clocks core_clk] period]
create_clock -name ck_c1r0 -period $ot_q_per [get_ports ck_c1r0]
create_clock -name ck_c1r2 -period $ot_q_per [get_ports ck_c1r2]
create_clock -name ck_c0r1 -period $ot_q_per [get_ports ck_c0r1]
create_clock -name ck_c2r1 -period $ot_q_per [get_ports ck_c2r1]
set_clock_uncertainty -setup 60 [get_clocks {ck_c1r0 ck_c1r2 ck_c0r1 ck_c2r1}]
set_clock_uncertainty -hold 25 [get_clocks {ck_c1r0 ck_c1r2 ck_c0r1 ck_c2r1}]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c1r0]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c1r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r0] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r0] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c1r2]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c1r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r2] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r2] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c0r1]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c0r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r1] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r1] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c2r1]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c2r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r1] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r1] -to [get_clocks core_clk]
set ot_qc_lands {l_dn1_rly3 l_dn1_rly6 l_leg_1_1b_y l_leg_2_0a_3 l_leg_2_0b_y l_leg_3_0a_4 l_leg_4_0b_1 l_leg_4_0b_5 p_2_0a}
set ot_qc_land_n 0
foreach ot_ln $ot_qc_lands {
  foreach ot_h {lo hi} {
    set ot_lf [get_cells -quiet u_${ot_ln}_w${ot_h}]
    set ot_lt [get_cells -quiet u_${ot_ln}_r${ot_h}]
    if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { continue }
    set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
    set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
    incr ot_qc_land_n
  }
}
puts "OT_QC_LAND_SDC $ot_qc_land_n landed half pairs constrained"
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {bc[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r2 [get_ports {bco[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {la_i[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r1 [get_ports {lb_i[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r1 [get_ports {lt_o[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r1 [get_ports {ly_o[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r2 [get_ports {lf_i[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {lf_o[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {lrst_dn1_rly3_w}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r2 [get_ports {lrst_dn1_rly6_r}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {lrst_leg_2_0a_3_w}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r1 [get_ports {lrst_leg_2_0b_y_w}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r1 [get_ports {lrst_leg_1_1b_y_r}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r1 [get_ports {lrst_leg_3_0a_4_r}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r2 [get_ports {lrst_leg_4_0b_1_w}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {lrst_leg_4_0b_5_r}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_c1r0 ck_c1r2 ck_c0r1 ck_c2r1}] }
if {!$::ot_ref_pre_cts} {
  proc ot_qc_pinreg_cks {bus dir} {
    set out {}; set seen [dict create]
    set pl [get_ports -quiet [format {%s[*]} $bus]]
    if {![llength $pl]} { set pl [get_ports -quiet $bus] }
    foreach port $pl {
      set nets [get_nets -quiet [get_full_name $port]]
      for {set hop 0} {$hop < 4 && [llength $nets]} {incr hop} {
        set next {}
        foreach n $nets {
          foreach pin [get_pins -quiet -of_objects $n] {
            if {[string first / [get_full_name $pin]] < 0} { continue }
            set pd [get_property $pin direction]
            if {($dir eq "in" && $pd ne "input") || ($dir eq "out" && $pd ne "output")} { continue }
            set c [get_cells -quiet -of_objects $pin]
            if {![llength $c]} { continue }
            set fn [get_full_name $c]
            set ck [get_pins -quiet "$fn/ck"]
            if {![llength $ck]} { set ck [get_pins -quiet "$fn/CLK"] }
            if {[llength $ck]} {
              if {![dict exists $seen $fn]} { dict set seen $fn 1; lappend out $ck }
            } elseif {[regexp {^(BUF|HB|INV)} [get_property $c ref_name]]} {
              foreach op [get_pins -quiet -of_objects $c] {
                set od [get_property $op direction]
                if {($dir eq "in" && $od eq "output") || ($dir eq "out" && $od eq "input")} { lappend next [get_nets -quiet -of_objects $op] }
              }
            }
          }
        }
        set nets $next
      }
    }
    return $out
  }
  catch {sta::worst_slack_cmd max}
  set ot_qc_ib [expr {[info exists ::env(OT_IO_IN_BUDGET_PS)] ? $::env(OT_IO_IN_BUDGET_PS) : 0.2 * $ot_q_per}]
  set ot_qc_ob [expr {[info exists ::env(OT_IO_OUT_BUDGET_PS)] ? $::env(OT_IO_OUT_BUDGET_PS) : 0.2 * $ot_q_per}]
  set ot_qc_sk [expr {[info exists ::env(OT_IO_SKEW)] ? $::env(OT_IO_SKEW) : 90}]
  set ot_qc_hk [expr {[info exists ::env(OT_IO_HOLD_SKEW)] ? $::env(OT_IO_HOLD_SKEW) : 50}]
  set ot_qc_hki [expr {[info exists ::env(OT_IO_IN_HOLD_SKEW)] ? $::env(OT_IO_IN_HOLD_SKEW) : 0}]
  set ot_qc_die [expr {[info exists ::env(OT_IO_HOLD_BUDGET)] && $::env(OT_IO_HOLD_BUDGET) eq "die"}]
  set ot_qc_c [expr {[info exists ::env(OT_BH_LAUNCH_MIN_PS)] ? $::env(OT_BH_LAUNCH_MIN_PS) : 25}]
  set ot_qc_u [expr {[info exists ::env(OT_BH_TILE_HOLD_UNC_PS)] ? $::env(OT_BH_TILE_HOLD_UNC_PS) : 25}]
  set ot_qc_r [expr {[info exists ::env(OT_BH_ROUTE_RELIEF_PS)] ? $::env(OT_BH_ROUTE_RELIEF_PS) : 0}]
  set ot_qc_io_n 0
  foreach {ot_qc_bus ot_qc_dir ot_qc_clk} {bc in ck_c1r0 bco out ck_c1r2 la_i in ck_c1r0 lb_i in ck_c0r1 lt_o out ck_c0r1 ly_o out ck_c2r1 lf_i in ck_c1r2 lf_o out ck_c1r0} {
    set ot_qc_a {}
    foreach p [ot_qc_pinreg_cks $ot_qc_bus $ot_qc_dir] {
      set a0 [get_property $p arrival_min_rise]; set a1 [get_property $p arrival_max_rise]
      if {[string is double -strict $a0] && [string is double -strict $a1]} { lappend ot_qc_a $a0 $a1 }
    }
    if {![llength $ot_qc_a]} { error "OT_QC_IO: no pin register clock arrival found for $ot_qc_bus ($ot_qc_dir)" }
    set ot_qc_a [lsort -real $ot_qc_a]; set lmin [lindex $ot_qc_a 0]; set lmax [lindex $ot_qc_a end]
    set pp [get_ports -quiet [format {%s[*]} $ot_qc_bus]]
    if {![llength $pp]} { set pp [get_ports $ot_qc_bus] }
    if {$ot_qc_dir eq "in"} {
      set_input_delay [expr {$ot_qc_ib + $lmax + $ot_qc_sk}] -max -clock $ot_qc_clk $pp
      set_input_delay [expr {$ot_qc_die ? $lmin + $ot_qc_c + $ot_qc_u + $ot_qc_r : $lmin - $ot_qc_hki}] -min -clock $ot_qc_clk $pp
    } else {
      set_output_delay [expr {$ot_qc_ob - $lmax + $ot_qc_sk}] -max -clock $ot_qc_clk $pp
      set_output_delay [expr {$ot_qc_die ? $ot_qc_u + $ot_qc_r - $lmin - $ot_qc_c : 0 - $lmin - $ot_qc_hk}] -min -clock $ot_qc_clk $pp
    }
    incr ot_qc_io_n
    puts "OT_QC_IO $ot_qc_bus $ot_qc_dir $ot_qc_clk L $lmin..$lmax ([expr {[llength $ot_qc_a] / 2}] pin registers) die=$ot_qc_die"
  }
  puts "OT_QC_IO_SDC $ot_qc_io_n buses referenced to their region tree"
}
set_case_analysis 0 [get_ports {cid[*]}]
set_case_analysis 0 [get_ports far]
set_input_transition 150 [all_inputs -no_clocks]
