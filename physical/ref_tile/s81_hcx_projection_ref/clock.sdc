# generated by tools/ref_tile/ref_tile.py (s81_hcx_projection_ref): route SDC (over-constrained 1000.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 1000.0 [get_ports clk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/ref_tile/s81_hcx_projection_ref/serial_clock.sdc
# Actual fixed S81 serial PLL /4 domain is0.9GHz; fast controller remains1.2GHz.
# Price: leaf264serial edges=352fast cycles, excluding80-beat prefetch/physical hops.
# Keep60/25ps uncertainty and all die IO/hold constraints; no timing exceptions.
if {$::ot_ref_pre_cts} {set hcx_period 1000.0} else {set hcx_period 1111.111111}
create_clock -name core_clk -period $hcx_period [get_ports clk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
if {!$::ot_ref_pre_cts} {set_propagated_clock [all_clocks]}
set_input_transition 150 [all_inputs -no_clocks]
