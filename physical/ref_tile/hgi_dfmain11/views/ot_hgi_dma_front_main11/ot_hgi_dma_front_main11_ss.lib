    pin("wl_rdy[2]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("wl_rdy[1]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("wl_rdy[0]") {
      direction : input;
      capacitance : 0.0000;
    }
    }
  }

}
