# generated by tools/ref_tile/ref_tile.py (vms_elastic_regional_cx): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports clk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/hbm_ring_transport_1013/regional_clocks.sdc
# Same-phase regional clocks, all cross-root paths timed. No false paths.
set ring_region_period [get_property [get_clocks core_clk] period]
for {set r 0} {$r < 9} {incr r} {
 set p [get_ports [format {data_clk[%d]} $r]]
 if {[llength $p] != 1} { error "Missing ring regional clock $r" }
 create_clock -name ring_data_$r -period $ring_region_period $p
}
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
# Clock creation must precede input-delay assignment for the new clock ports.
unset_input_delay -clock core_clk [get_ports {data_clk*}]
if {[get_property [get_clocks core_clk] is_propagated]} {
 set_propagated_clock [get_clocks {ring_data_*}]
}
