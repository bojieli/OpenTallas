set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r3] -to [get_clocks ck_c3r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r3] -to [get_clocks ck_c3r2]
# Q-CLUSTER-LANDALL: 54 landed crossings (LANDING-CONTRACT L5): ring -> read multicycle -setup 2 -hold 3, window (2 - 4) T + t_hold < dL < 2 T - t_cq - t_setup
set ot_qc_lands {dn0_rly3 dn0_rly6 dn0_rly9 dn1_rly3 dn1_rly6 dn1_rly9 dn2_rly3 dn2_rly6 dn2_rly9 dn3_rly3 dn3_rly6 dn3_rly9 leg_1_0a_y leg_1_1b_y leg_1_2b_y leg_1_3a_y leg_1_4b_y leg_1_5b_y leg_1_6a_y leg_1_7a_y leg_2_0a_3 leg_2_0b_y leg_2_1a_0 leg_2_1a_3 leg_2_1a_y leg_2_1b_y leg_2_2a_0 leg_2_2a_3 leg_2_2b_y leg_2_3a_3 leg_2_3a_y leg_2_3b_y leg_3_0a_4 leg_3_0a_y leg_3_0b_0 leg_3_0b_5 leg_3_0b_y leg_3_1a_2 leg_3_1b_0 leg_3_1b_1 leg_3_1b_3 leg_4_0a_0 leg_4_0a_2 leg_4_0a_7 leg_4_0a_9 leg_4_0a_y leg_4_0b_1 leg_4_0b_5 leg_4_0b_y rs_0 ft_2 ft_6 ft_9 ft_13}
set ot_qc_land_miss 0
foreach ot_ln $ot_qc_lands {
  set ot_lf [get_cells -quiet u_fab.u_land_${ot_ln}_w.*]
  set ot_lt [get_cells -quiet u_fab.u_land_${ot_ln}_r.*]
  if {[llength $ot_lf] == 0 || [llength $ot_lt] == 0} { incr ot_qc_land_miss; continue }
  set_multicycle_path -setup 2 -from $ot_lf -to $ot_lt
  set_multicycle_path -hold 3 -from $ot_lf -to $ot_lt
}
puts "OT_QC_LAND_SDC [expr {[llength $ot_qc_lands] - $ot_qc_land_miss}] of [llength $ot_qc_lands] landings constrained"
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r1 [get_ports {rst_c0r1}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r2 [get_ports {rst_c0r2}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r3 [get_ports {rst_c0r3}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r3 [get_ports {bco0[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {bc1[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {rst_c1r0}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {rs[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r1 [get_ports {rst_c1r1}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r2 [get_ports {rst_c1r2}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r3 [get_ports {rs_i[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r3 [get_ports {rst_c1r3}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r3 [get_ports {bco1[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r0 [get_ports {bc2[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r0 [get_ports {rst_c2r0}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r0 [get_ports {rs_o[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r1 [get_ports {rst_c2r1}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r2 [get_ports {rst_c2r2}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r3 [get_ports {rst_c2r3}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r3 [get_ports {bco2[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r0 [get_ports {bc3[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r0 [get_ports {rst_c3r0}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r1 [get_ports {rst_c3r1}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r2 [get_ports {rst_c3r2}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r3 [get_ports {rst_c3r3}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r3 [get_ports {bco3[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_c0r1 ck_c0r2 ck_c0r3 ck_c1r0 ck_c1r1 ck_c1r2 ck_c1r3 ck_c2r0 ck_c2r1 ck_c2r2 ck_c2r3 ck_c3r0 ck_c3r1 ck_c3r2 ck_c3r3}] }
if {!$::ot_ref_pre_cts} {
  proc ot_qc_pinreg_cks {bus dir} {
    set out {}; set seen [dict create]
    set pl [get_ports -quiet [format {%s[*]} $bus]]
    if {![llength $pl]} { set pl [get_ports -quiet $bus] }
    foreach port $pl {
      set nets [get_nets -quiet [get_full_name $port]]
      for {set hop 0} {$hop < 4 && [llength $nets]} {incr hop} {
        set next {}
        foreach n $nets {
          foreach pin [get_pins -quiet -of_objects $n] {
            if {[string first / [get_full_name $pin]] < 0} { continue }
            set pd [get_property $pin direction]
            if {($dir eq "in" && $pd ne "input") || ($dir eq "out" && $pd ne "output")} { continue }
            set c [get_cells -quiet -of_objects $pin]
            if {![llength $c]} { continue }
            set fn [get_full_name $c]
            set ck [get_pins -quiet "$fn/ck"]
            if {![llength $ck]} { set ck [get_pins -quiet "$fn/CLK"] }
            if {[llength $ck]} {
              if {![dict exists $seen $fn]} { dict set seen $fn 1; lappend out $ck }
            } elseif {[regexp {^(BUF|HB|INV)} [get_property $c ref_name]]} {
              foreach op [get_pins -quiet -of_objects $c] {
                set od [get_property $op direction]
                if {($dir eq "in" && $od eq "output") || ($dir eq "out" && $od eq "input")} { lappend next [get_nets -quiet -of_objects $op] }
              }
            }
          }
        }
        set nets $next
      }
    }
    return $out
  }
  catch {sta::worst_slack_cmd max}
  set ot_qc_ib [expr {[info exists ::env(OT_IO_IN_BUDGET_PS)] ? $::env(OT_IO_IN_BUDGET_PS) : 0.2 * $ot_q_per}]
  set ot_qc_ob [expr {[info exists ::env(OT_IO_OUT_BUDGET_PS)] ? $::env(OT_IO_OUT_BUDGET_PS) : 0.2 * $ot_q_per}]
  set ot_qc_sk [expr {[info exists ::env(OT_IO_SKEW)] ? $::env(OT_IO_SKEW) : 90}]
  set ot_qc_hk [expr {[info exists ::env(OT_IO_HOLD_SKEW)] ? $::env(OT_IO_HOLD_SKEW) : 50}]
  set ot_qc_hki [expr {[info exists ::env(OT_IO_IN_HOLD_SKEW)] ? $::env(OT_IO_IN_HOLD_SKEW) : 0}]
  set ot_qc_die [expr {[info exists ::env(OT_IO_HOLD_BUDGET)] && $::env(OT_IO_HOLD_BUDGET) eq "die"}]
  set ot_qc_c [expr {[info exists ::env(OT_BH_LAUNCH_MIN_PS)] ? $::env(OT_BH_LAUNCH_MIN_PS) : 25}]
  set ot_qc_u [expr {[info exists ::env(OT_BH_TILE_HOLD_UNC_PS)] ? $::env(OT_BH_TILE_HOLD_UNC_PS) : 25}]
  set ot_qc_r [expr {[info exists ::env(OT_BH_ROUTE_RELIEF_PS)] ? $::env(OT_BH_ROUTE_RELIEF_PS) : 0}]
  set ot_qc_io_n 0
  foreach {ot_qc_bus ot_qc_dir ot_qc_clk} {rst_c0r1 in ck_c0r1 rst_c0r2 in ck_c0r2 rst_c0r3 in ck_c0r3 bco0 out ck_c0r3 bc1 in ck_c1r0 rst_c1r0 in ck_c1r0 rs out ck_c1r0 rst_c1r1 in ck_c1r1 rst_c1r2 in ck_c1r2 rs_i in ck_c1r3 rst_c1r3 in ck_c1r3 bco1 out ck_c1r3 bc2 in ck_c2r0 rst_c2r0 in ck_c2r0 rs_o out ck_c2r0 rst_c2r1 in ck_c2r1 rst_c2r2 in ck_c2r2 rst_c2r3 in ck_c2r3 bco2 out ck_c2r3 bc3 in ck_c3r0 rst_c3r0 in ck_c3r0 rst_c3r1 in ck_c3r1 rst_c3r2 in ck_c3r2 rst_c3r3 in ck_c3r3 bco3 out ck_c3r3} {
    set ot_qc_a {}
    foreach p [ot_qc_pinreg_cks $ot_qc_bus $ot_qc_dir] {
      set a0 [get_property $p arrival_min_rise]; set a1 [get_property $p arrival_max_rise]
      if {[string is double -strict $a0] && [string is double -strict $a1]} { lappend ot_qc_a $a0 $a1 }
    }
    if {![llength $ot_qc_a]} { error "OT_QC_IO: no pin register clock arrival found for $ot_qc_bus ($ot_qc_dir)" }
    set ot_qc_a [lsort -real $ot_qc_a]; set lmin [lindex $ot_qc_a 0]; set lmax [lindex $ot_qc_a end]
    set pp [get_ports -quiet [format {%s[*]} $ot_qc_bus]]
    if {![llength $pp]} { set pp [get_ports $ot_qc_bus] }
    if {$ot_qc_dir eq "in"} {
      set_input_delay [expr {$ot_qc_ib + $lmax + $ot_qc_sk}] -max -clock $ot_qc_clk $pp
      set_input_delay [expr {$ot_qc_die ? $lmin + $ot_qc_c + $ot_qc_u + $ot_qc_r : $lmin - $ot_qc_hki}] -min -clock $ot_qc_clk $pp
    } else {
      set_output_delay [expr {$ot_qc_ob - $lmax + $ot_qc_sk}] -max -clock $ot_qc_clk $pp
      set_output_delay [expr {$ot_qc_die ? $ot_qc_u + $ot_qc_r - $lmin - $ot_qc_c : 0 - $lmin - $ot_qc_hk}] -min -clock $ot_qc_clk $pp
    }
    incr ot_qc_io_n
    puts "OT_QC_IO $ot_qc_bus $ot_qc_dir $ot_qc_clk L $lmin..$lmax ([expr {[llength $ot_qc_a] / 2}] pin registers) die=$ot_qc_die"
  }
  puts "OT_QC_IO_SDC $ot_qc_io_n buses referenced to their region tree"
}
set_case_analysis 0 [get_ports {cid[*]}]
set_case_analysis 0 [get_ports far]
set_input_transition 150 [all_inputs -no_clocks]
