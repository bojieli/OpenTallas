# generated by tools/ref_tile/ref_tile.py (smh_fcbc_ref_p45): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
create_clock -name core_clk -period 770.0 [get_ports clk]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/ref_tile_specs/smh/fc_bc_ring_mcp.sdc
# fc_bc: the bulk copy's ring read is a designed two-cycle path (oq5 RING_MACRO=1; rd_out registered at E1, oq* capture at E3);
# identical to front_c's hand SDC (tools/hbm_accel_smh_physical.py sdc_block ring=True) and ot_hbm_accel_bulk_copy_mc2.sdc
set_multicycle_path -setup 2 -from [get_cells -hierarchical *u_ring]
set_multicycle_path -hold 1 -from [get_cells -hierarchical *u_ring]
