library (dsfd_die_r1_ss) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 0.63;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("dsfd_die_r1") {
    area : 0.991 
    is_macro_cell : true;
    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 0.7528;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.04859");
        }
        cell_fall(scalar) {
          values("0.04827");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.06131");
        }
        cell_fall(scalar) {
          values("0.06131");
        }
      }
    }
    pin("i") {
      direction : input;
      capacitance : 0.9201;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-163.80467");
        }
        fall_constraint(scalar) {
          values("-166.81506");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("189.55457");
        }
        fall_constraint(scalar) {
          values("194.54889");
        }
      }
    }
    pin("o") {
      direction : output;
      capacitance : 0.1688;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("273.58170,278.90051,288.47256,307.22733,344.12463,417.95251,565.47644");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("16.76737,26.47054,46.28196,86.56477,167.93478,331.09628,657.69568");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("303.06918,307.70221,315.61237,330.08801,358.18399,414.08636,525.63330");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("14.95333,21.85126,35.52244,63.17326,119.52327,233.29581,461.75406");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
