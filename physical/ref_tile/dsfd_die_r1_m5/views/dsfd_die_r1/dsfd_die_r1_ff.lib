library (dsfd_die_r1_ff) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,fF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ps";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 10;
  slew_lower_threshold_pct_fall : 10;
  slew_upper_threshold_pct_rise : 90;
  slew_upper_threshold_pct_fall : 90;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 0.0;
  nom_voltage                    : 0.77;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
  }

  cell ("dsfd_die_r1") {
    area : 0.991 
    is_macro_cell : true;
    pin("ck") {
      direction : input;
      clock : true;
      capacitance : 0.8282;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
        cell_rise(scalar) {
          values("0.05712");
        }
        cell_fall(scalar) {
          values("0.05704");
        }
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
        cell_rise(scalar) {
          values("0.06857");
        }
        cell_fall(scalar) {
          values("0.06903");
        }
      }
    }
    pin("i") {
      direction : input;
      capacitance : 1.0451;
      timing() {
        related_pin : "ck";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("-88.05399");
        }
        fall_constraint(scalar) {
          values("-94.25185");
        }
      }
      timing() {
        related_pin : "ck";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("104.53716");
        }
        fall_constraint(scalar) {
          values("110.78735");
        }
      }
    }
    pin("o") {
      direction : output;
      capacitance : 0.1688;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("130.73051,133.04367,137.14462,144.90471,160.15987,190.55260,251.25177");
        }
        rise_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("7.61153,11.68068,19.95884,36.84273,71.06618,139.93100,277.88898");
        }
        cell_fall(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("139.53638,141.74663,145.56480,152.50700,165.96434,192.74927,246.23947");
        }
        fall_transition(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("6.99625,10.42732,17.26698,31.14939,59.35944,116.35445,230.77364");
        }
      }
    }
    pin("VDD") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VSS") {
      direction : input;
      capacitance : 0.0000;
    }
  }

}
