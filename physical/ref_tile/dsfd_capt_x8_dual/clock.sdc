# generated by tools/ref_tile/ref_tile.py (dsfd_capt_x8_dual): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/s81_ph_views/capture/x8_dual_clocks.sdc
# Related 3:4 stream/serial clocks; keep every crossing timed.
set capx_p [get_property [get_clocks core_clk] period]
create_clock -name ser_clk -period [expr {$capx_p * 4.0 / 3.0}] [get_ports {ckv ckv[*]}]
set_clock_uncertainty -setup 60 [get_clocks ser_clk]
set_clock_uncertainty -hold 25 [get_clocks ser_clk]
foreach capx_pin [get_ports {ck ck[*] ckv ckv[*]}] {
    foreach capx_refclk [all_clocks] {
        unset_input_delay -clock $capx_refclk $capx_pin
        unset_input_delay -clock $capx_refclk -clock_fall $capx_pin
    }
    unset_input_delay $capx_pin
}
set_false_path -from [get_ports {rsv rsv[*]}]
unset_output_delay [get_ports {t_vm[*] t_st[*]}]
set_output_delay 222.222 -clock ser_clk [get_ports {t_vm[*] t_st[*]}]

if {[get_property [get_clocks core_clk] is_propagated]} {set_propagated_clock [get_clocks ser_clk]}
