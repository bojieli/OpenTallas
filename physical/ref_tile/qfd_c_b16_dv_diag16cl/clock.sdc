# generated by tools/ref_tile/ref_tile.py (qfd_c_b16_dv_diag16cl): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck_c0r0]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qcluster/qfd_c_b16_dv_quadrants.sdc
# Q-CLUSTER qfd_c_b16_dv: the 15 non-core regional roots (generated by tools/qwen_cluster/qc_kit.py; DO NOT EDIT).
# Same period / phase as core_clk (related, neighbour-relative die delivery); each boundary port is timed against the
# clock of the region that holds its pin register (0.2 T in / out, as core_clk's ports).
set ot_q_per [get_property [get_clocks core_clk] period]
create_clock -name ck_c0r1 -period $ot_q_per [get_ports ck_c0r1]
create_clock -name ck_c0r2 -period $ot_q_per [get_ports ck_c0r2]
create_clock -name ck_c0r3 -period $ot_q_per [get_ports ck_c0r3]
create_clock -name ck_c1r0 -period $ot_q_per [get_ports ck_c1r0]
create_clock -name ck_c1r1 -period $ot_q_per [get_ports ck_c1r1]
create_clock -name ck_c1r2 -period $ot_q_per [get_ports ck_c1r2]
create_clock -name ck_c1r3 -period $ot_q_per [get_ports ck_c1r3]
create_clock -name ck_c2r0 -period $ot_q_per [get_ports ck_c2r0]
create_clock -name ck_c2r1 -period $ot_q_per [get_ports ck_c2r1]
create_clock -name ck_c2r2 -period $ot_q_per [get_ports ck_c2r2]
create_clock -name ck_c2r3 -period $ot_q_per [get_ports ck_c2r3]
create_clock -name ck_c3r0 -period $ot_q_per [get_ports ck_c3r0]
create_clock -name ck_c3r1 -period $ot_q_per [get_ports ck_c3r1]
create_clock -name ck_c3r2 -period $ot_q_per [get_ports ck_c3r2]
create_clock -name ck_c3r3 -period $ot_q_per [get_ports ck_c3r3]
set_clock_uncertainty -setup 60 [get_clocks {ck_c0r1 ck_c0r2 ck_c0r3 ck_c1r0 ck_c1r1 ck_c1r2 ck_c1r3 ck_c2r0 ck_c2r1 ck_c2r2 ck_c2r3 ck_c3r0 ck_c3r1 ck_c3r2 ck_c3r3}]
set_clock_uncertainty -hold 25 [get_clocks {ck_c0r1 ck_c0r2 ck_c0r3 ck_c1r0 ck_c1r1 ck_c1r2 ck_c1r3 ck_c2r0 ck_c2r1 ck_c2r2 ck_c2r3 ck_c3r0 ck_c3r1 ck_c3r2 ck_c3r3}]
# Q-CL16-LAND: die delivery residual 60 ps between the 26 communicating region pairs (both directions), setup and hold, on top of 60 / 25 (die_clock_contract.json obligation 2)
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c0r1]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c0r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r1] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r1] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks core_clk] -to [get_clocks ck_c1r0]
set_clock_uncertainty -hold 85 -from [get_clocks core_clk] -to [get_clocks ck_c1r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r0] -to [get_clocks core_clk]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r0] -to [get_clocks core_clk]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r1] -to [get_clocks ck_c0r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r1] -to [get_clocks ck_c0r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r2] -to [get_clocks ck_c0r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r2] -to [get_clocks ck_c0r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r1] -to [get_clocks ck_c1r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r1] -to [get_clocks ck_c1r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r1] -to [get_clocks ck_c0r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r1] -to [get_clocks ck_c0r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r2] -to [get_clocks ck_c0r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r2] -to [get_clocks ck_c0r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r3] -to [get_clocks ck_c0r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r3] -to [get_clocks ck_c0r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r2] -to [get_clocks ck_c1r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r2] -to [get_clocks ck_c1r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r2] -to [get_clocks ck_c0r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r2] -to [get_clocks ck_c0r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c0r3] -to [get_clocks ck_c1r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c0r3] -to [get_clocks ck_c1r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r3] -to [get_clocks ck_c0r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r3] -to [get_clocks ck_c0r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r0] -to [get_clocks ck_c1r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r0] -to [get_clocks ck_c1r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r1] -to [get_clocks ck_c1r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r1] -to [get_clocks ck_c1r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r0] -to [get_clocks ck_c2r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r0] -to [get_clocks ck_c2r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r0] -to [get_clocks ck_c1r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r0] -to [get_clocks ck_c1r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r1] -to [get_clocks ck_c1r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r1] -to [get_clocks ck_c1r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r2] -to [get_clocks ck_c1r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r2] -to [get_clocks ck_c1r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r1] -to [get_clocks ck_c2r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r1] -to [get_clocks ck_c2r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r1] -to [get_clocks ck_c1r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r1] -to [get_clocks ck_c1r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r2] -to [get_clocks ck_c1r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r2] -to [get_clocks ck_c1r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r3] -to [get_clocks ck_c1r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r3] -to [get_clocks ck_c1r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r2] -to [get_clocks ck_c2r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r2] -to [get_clocks ck_c2r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r2] -to [get_clocks ck_c1r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r2] -to [get_clocks ck_c1r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c1r3] -to [get_clocks ck_c2r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c1r3] -to [get_clocks ck_c2r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r3] -to [get_clocks ck_c1r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r3] -to [get_clocks ck_c1r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r0] -to [get_clocks ck_c2r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r0] -to [get_clocks ck_c2r1]
