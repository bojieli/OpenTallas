set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r1] -to [get_clocks ck_c2r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r0] -to [get_clocks ck_c3r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r0] -to [get_clocks ck_c3r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r0] -to [get_clocks ck_c2r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r0] -to [get_clocks ck_c2r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c2r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c2r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r1] -to [get_clocks ck_c2r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r1] -to [get_clocks ck_c2r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r2] -to [get_clocks ck_c2r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r2] -to [get_clocks ck_c2r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r1] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r1] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c2r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c2r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r2] -to [get_clocks ck_c2r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r2] -to [get_clocks ck_c2r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r3] -to [get_clocks ck_c2r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r3] -to [get_clocks ck_c2r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r2] -to [get_clocks ck_c3r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r2] -to [get_clocks ck_c3r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r2] -to [get_clocks ck_c2r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r2] -to [get_clocks ck_c2r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c2r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c2r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r2]
