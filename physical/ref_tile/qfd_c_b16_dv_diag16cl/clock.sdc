set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r0] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r0]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r0]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r1] -to [get_clocks ck_c3r2]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r1]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r1]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r2] -to [get_clocks ck_c3r3]
set_clock_uncertainty -setup 120 -from [get_clocks ck_c3r3] -to [get_clocks ck_c3r2]
set_clock_uncertainty -hold 85 -from [get_clocks ck_c3r3] -to [get_clocks ck_c3r2]
# Q-CL16-LAND landing leg_3_1b_0 (u_fab.u_leg_3_1b_0 (c3r3) -> u_fab.u_leg_3_1b_1 (c2r2)): ring u_fab.u_land_leg_3_1b_0_w -> read u_fab.u_land_leg_3_1b_0_r o, E 2, D 4 (LANDING-CONTRACT L5)
set_multicycle_path -setup 2 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r2]
set_multicycle_path -hold 3 -from [get_clocks ck_c3r3] -to [get_clocks ck_c2r2]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c0r3 [get_ports {bco0[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {bc1[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r0 [get_ports {rs[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r3 [get_ports {rs_i[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c1r3 [get_ports {bco1[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r0 [get_ports {bc2[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r0 [get_ports {rs_o[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c2r3 [get_ports {bco2[*]}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r0 [get_ports {bc3[*]}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_c3r3 [get_ports {bco3[*]}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_c0r1 ck_c0r2 ck_c0r3 ck_c1r0 ck_c1r1 ck_c1r2 ck_c1r3 ck_c2r0 ck_c2r1 ck_c2r2 ck_c2r3 ck_c3r0 ck_c3r1 ck_c3r2 ck_c3r3}] }
set_case_analysis 0 [get_ports {cid[*]}]
set_case_analysis 0 [get_ports far]
set_input_transition 150 [all_inputs -no_clocks]
