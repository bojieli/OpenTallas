# qfwd_landh0_300_ne_54x54_r16: sign-off at 833.333 ps (generated by tools/ref_tile/ref_tile.py; same form as
# physical/qwen_die_masters/jobs/signoff_sdc.py): clock re-created at the real period, propagated, 60 / 25 ps uncertainty,
# die-context boundary io_ref_skew.sdc with this block's REFGLOB / INTER bound.
set ::ot_ref_pre_cts 0
create_clock -name core_clk -period 833.333 [get_ports ck]
set_propagated_clock [all_clocks]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set ::env(OT_IO_SKEW) 90
set ::env(OT_IO_HOLD_SKEW) 50
set ::env(OT_IO_HOLD_BUDGET) die
set ::env(OT_BH_LAUNCH_MIN_PS) 25
set ::env(OT_BH_TILE_HOLD_UNC_PS) 25
set ::env(OT_BH_ROUTE_RELIEF_PS) 0
set ::env(OT_REF_GLOB) {*u_land.rc*}
set ::env(OT_IO_INTER) {*}
set ::env(OT_IO_SKEW_INTER) 150
# Die-context boundary (post-CTS only; OpenROAD 26Q3 crashes on -reference_pin, so it is applied numerically):
# L = propagated clock arrival at a boundary register of this block (OT_REF_GLOB, default *go_q*), measured here.
#   input  max = 166.667 + L_max + skew      min = L_min - hold_skew
#   output max = 166.667 - L_max + skew      min = -L_min - hold_skew
# skew = OT_IO_SKEW (90, same clock region) or OT_IO_SKEW_INTER (150) on the OT_IO_INTER port globs; hold_skew =
# OT_IO_HOLD_SKEW (50).  Margin rule 2026-10-06 (+ clarification: 150 ps only across clock regions).
set ot_sk [expr {[info exists ::env(OT_IO_SKEW)] ? $::env(OT_IO_SKEW) : 90}]
set ot_hk [expr {[info exists ::env(OT_IO_HOLD_SKEW)] ? $::env(OT_IO_HOLD_SKEW) : 50}]
# Outside share of the boundary (default 0.2 T = 166.667 ps of 833.333).  A ref_tile spec "io_budget" {in,out} may only
# TIGHTEN it: tools/ref_tile/ref_tile.py exports OT_IO_IN_BUDGET_PS / OT_IO_OUT_BUDGET_PS to the route and the sign-off SDC.
set ot_ib [expr {[info exists ::env(OT_IO_IN_BUDGET_PS)] ? $::env(OT_IO_IN_BUDGET_PS) : 166.667}]
set ot_ob [expr {[info exists ::env(OT_IO_OUT_BUDGET_PS)] ? $::env(OT_IO_OUT_BUDGET_PS) : 166.667}]
set ot_glob [expr {[info exists ::env(OT_REF_GLOB)] ? $::env(OT_REF_GLOB) : "*go_q*"}]
unset_input_delay [all_inputs]
unset_output_delay [all_outputs]
# PINFLOP-REF (drive-0849 2026-10-10, coordinator class-1 fix: 39 hold floods at CTS/GRT): the IO reference register used
# to be the FIRST register of the design / clock (an arbitrary tree position), so the input min delay sat far from the
# capture flops' clock and CTS / GRT hold repair flooded (ehash / core18 / kvwq closed only after naming the input pin
# flops by hand).  When the block has a REGISTERED input boundary -- input ports reaching register D pins directly or
# through <= 2 buffers ("pin flops") -- the reference is the pin flop of MEDIAN clock arrival.  No pin flops -> the
# previous reference.  An explicit matching OT_REF_GLOB keeps priority; OT_REF_PINFLOP=0 opts out.
# PF-HOLDPAD (NATIVE-REF 2026-10-18, S81-SMHKP4 finding): (a) after CTS / GRT hold repair a pin flop sits behind the
# input hold pad + driver + CTS hold buffers (smhq d[24]: HB2 ot_inhold -> BUFx4f ot_ihdrv -> HB2 -> BUFx2 -> ... -> D):
# the 3-hop search lost every pin flop at GRT, the reference fell to the FIRST register (a hard child's raw clock pin
# g_l[0].u_sml/ck, ~250 ps before the pin flops) and GRT hold repair padded all 341 inputs (3,756 buffers).  Past the
# first 3 hops the search now follows single-load BUF / HB chains (hold pads are inserted in series) up to OT_PF_HOPS
# (default 32) hops; fan-out trees past hop 3 are not followed, so a deep reset tree never makes every flop a pin flop.
# (b) a hard child (a macro whose Liberty clock pin carries min/max_clock_tree_path: an ETM view) reached by an input is a
# pin "flop" at its clock pin + its internal insertion (kp4_dec, a wires-only parent: the reference was the raw child
# clock pin u_chn/clk, ~250 ps before the child's flops -> 10k hold buffers).  ot_pf_arr PIN max|min is the arrival every
# caller reads: pin arrival + that internal insertion for a hard-child clock pin (also when OT_REF_GLOB or the
# first-register fallback names one), the plain pin arrival otherwise.  Insertion is read from the bound ETM Liberty
# files (ADDITIONAL_LIBS; an FF-only session uses the _ff sibling of a _tt lib).
proc ot_pf_lib_ins {} {
  # {lib cell -> {clock pin -> {max min}}} from the hard-child Liberty files of this session (cached)
  # FF values: an FF-only session, or the BC scene of a multi-scene session (::ot_ioref_scene, io_ref_routed.sdc)
  set ff [expr {([info exists ::ot_ioref_scene] && $::ot_ioref_scene eq "BC") ||
                (![catch {llength [get_libs -quiet *FF*]} nf] && $nf && ![catch {llength [get_libs -quiet *TT*]} nt] && !$nt)}]
  if {[info exists ::ot_pf_libins_c] && [dict exists $::ot_pf_libins_c $ff]} { return [dict get $::ot_pf_libins_c $ff] }
  if {![info exists ::ot_pf_libins_c]} { set ::ot_pf_libins_c [dict create] }
  set ::ot_pf_libins [dict create]
  set libs {}
  foreach v {ADDITIONAL_LIBS OT_PF_MACRO_LIBS} { if {[info exists ::env($v)]} { lappend libs {*}$::env($v) } }
  foreach lib $libs {
    if {$ff} { regsub {_tt(\.lib(\.gz)?)$} $lib {_ff\1} l2; if {[file readable $l2]} { set lib $l2 } }
    if {![file readable $lib] || [string match *.gz $lib]} continue
    if {[catch {set f [open $lib]; set txt [read $f]; close $f}]} continue
    if {![regexp {cell\s*\(\s*"?([A-Za-z0-9_]+)"?\s*\)} $txt -> cell]} continue
    foreach chunk [lrange [regexp -all -inline -indices {pin\s*\(\s*"?[^")]+"?\s*\)\s*\{} $txt] 0 end] {
      set s [lindex $chunk 0]
      set body [string range $txt $s [expr {$s + 2000}]]
      if {![regexp {^pin\s*\(\s*"?([^")]+)"?\s*\)} $body -> pn]} continue
      set nxt [string first "pin(" $body 4]; if {$nxt > 0} { set body [string range $body 0 $nxt] }
      set mx ""; set mn ""
      regexp {max_clock_tree_path;\s*cell_rise\s*\(\s*scalar\s*\)\s*\{\s*values\s*\(\s*"([-0-9.eE]+)"} $body -> mx
      regexp {min_clock_tree_path;\s*cell_rise\s*\(\s*scalar\s*\)\s*\{\s*values\s*\(\s*"([-0-9.eE]+)"} $body -> mn
      if {$mx eq "" && $mn eq ""} continue
      if {$mx eq ""} { set mx $mn }
      if {$mn eq ""} { set mn $mx }
      dict set ::ot_pf_libins $cell $pn [list $mx $mn]
    }
  }
  dict set ::ot_pf_libins_c $ff $::ot_pf_libins
  return $::ot_pf_libins
}
proc ot_pf_ins {pin mm} {
  # internal insertion behind PIN when it is a hard child's clock pin (else 0)
  set c [get_cells -quiet -of_objects $pin]
  if {![llength $c]} { return 0.0 }
  set li [ot_pf_lib_ins]
  set ref [get_property $c ref_name]
  if {![dict exists $li $ref]} { return 0.0 }
  set pn [get_property $pin lib_pin_name]
  if {![dict exists $li $ref $pn]} { return 0.0 }
  return [lindex [dict get $li $ref $pn] [expr {$mm eq "min" ? 1 : 0}]]
}
proc ot_pf_arr {pin mm} {
  set a [get_property $pin [expr {$mm eq "min" ? "arrival_min_rise" : "arrival_max_rise"}]]
  if {![string is double -strict $a]} { return $a }
  return [expr {$a + [ot_pf_ins $pin $mm]}]
}
proc ot_pf_clks {ports} {
  set seen [dict create]; set out {}; set vis [dict create]
  set li [ot_pf_lib_ins]
  set lim [expr {[info exists ::env(OT_PF_HOPS)] && [string is integer -strict $::env(OT_PF_HOPS)] ? $::env(OT_PF_HOPS) : 32}]
  foreach port $ports {
    set nets [get_nets -quiet [get_full_name $port]]
    for {set hop 0} {$hop < $lim && [llength $nets]} {incr hop} {
      set next {}
      foreach n $nets {
        set lds {}
        foreach pin [get_pins -quiet -of_objects $n] {
          if {[string first / [get_full_name $pin]] < 0} { continue }
          if {[get_property $pin direction] ne "input"} { continue }
          lappend lds $pin
        }
        # past the first 3 hops only single-load chains (series hold pads) are followed
        set follow [expr {$hop < 3 || [llength $lds] == 1}]
        foreach pin $lds {
          set c [get_cells -quiet -of_objects $pin]
          if {![llength $c]} { continue }
          set fn [get_full_name $c]
          set ck [get_pins -quiet "$fn/CLK"]
          set ref [get_property $c ref_name]
          if {[llength $ck]} {
            if {[get_property $pin lib_pin_name] ne "CLK" && ![dict exists $seen $fn]} { dict set seen $fn 1; lappend out $ck }
          } elseif {[dict exists $li $ref]} {
            # a hard child: its clock pin(s), counted at pin arrival + internal insertion (ot_pf_arr)
            if {![dict exists $li $ref [get_property $pin lib_pin_name]] && ![dict exists $seen $fn]} {
              dict set seen $fn 1
              foreach cp [dict keys [dict get $li $ref]] {
                set p [get_pins -quiet "$fn/$cp"]
                if {[llength $p]} { lappend out $p }
              }
            }
          } elseif {$follow && ![dict exists $vis $fn] && [regexp {^(BUF|HB)} $ref]} {
            dict set vis $fn 1
            foreach op [get_pins -quiet -of_objects $c] {
              if {[get_property $op direction] eq "output"} { lappend next [get_nets -quiet -of_objects $op] }
            }
          }
        }
      }
      set nets $next
    }
  }
  return $out
}
proc ot_pf_ref {ports} {
  if {[info exists ::env(OT_REF_PINFLOP)] && $::env(OT_REF_PINFLOP) eq "0"} { return {} }
  catch {sta::worst_slack_cmd max}   ;# arrivals need an updated timing graph (as the QDM reference reads below)
  set pf {}; set nh 0
  foreach p [ot_pf_clks $ports] {
    set a [ot_pf_arr $p max]
    if {[string is double -strict $a]} { lappend pf [list $a $p]; if {[ot_pf_ins $p max] != 0.0} { incr nh } }
  }
  if {![llength $pf]} { return {} }
  set pf [lsort -real -index 0 $pf]
  set m [lindex $pf [expr {[llength $pf] / 2}]]
  puts "QDM PINFLOP reference: [llength $pf] input pin flops ($nh hard-child clock pins at +insertion), median arrival [lindex $m 0] (range [lindex [lindex $pf 0] 0] .. [lindex [lindex $pf end] 0])"
  return [lindex $m 1]
}
# GLOB-MEDIAN (drive-0849 2026-10-10): a matching REFGLOB names a register GROUP (usually the input pin flops); the
# reference is its member of median clock arrival, not the first match (an arbitrary tree position).
proc ot_pf_median {pins label} {
  catch {sta::worst_slack_cmd max}
  set pf {}
  foreach p $pins {
    set a [ot_pf_arr $p max]
    if {[string is double -strict $a]} { lappend pf [list $a $p] }
  }
  if {![llength $pf]} { return {} }
  set pf [lsort -real -index 0 $pf]
  set m [lindex $pf [expr {[llength $pf] / 2}]]
  puts "QDM $label reference: [llength $pf] registers, median arrival [lindex $m 0] (range [lindex [lindex $pf 0] 0] .. [lindex [lindex $pf end] 0])"
  return [lindex $m 1]
}
set qdm_ref {}
if {$ot_glob ne "" && $ot_glob ne "*"} {   ;# "*" names no reference: PINFLOP default
  set ot_gm {}
  foreach c [get_cells -quiet -hierarchical $ot_glob] {
    set p [get_pins -quiet "[get_full_name $c]/CLK"]
    if {[llength $p]} { lappend ot_gm $p }
  }
  if {[llength $ot_gm]} {
    if {[info exists ::env(OT_REF_PINFLOP)] && $::env(OT_REF_PINFLOP) eq "0"} { set qdm_ref [lindex $ot_gm 0] } else {
      set qdm_ref [ot_pf_median $ot_gm "REFGLOB $ot_glob"] }
  }
}
if {[llength $qdm_ref] == 0} { set qdm_ref [ot_pf_ref [all_inputs -no_clocks]] }
if {[llength $qdm_ref] == 0} { set qdm_ref [lindex [all_registers -clock_pins] 0] }
set qdm_w [sta::worst_slack_cmd max]
set qdm_lmax [ot_pf_arr $qdm_ref max]
set qdm_lmin [ot_pf_arr $qdm_ref min]
puts "QDM reference pin [get_full_name $qdm_ref] clock arrival max $qdm_lmax min $qdm_lmin skew $ot_sk hold $ot_hk"
set_input_delay [expr $ot_ib + $qdm_lmax + $ot_sk] -max -clock core_clk [all_inputs -no_clocks]
# RULE H1 (flow-hold 2026-10-07): a die link's hold budget (die clock-arrival term OT_IO_HOLD_SKEW + hold uncertainty) is
# carried ONCE, by the SENDER's output min delay below.  The receiver's input check keeps only its own tree offset from the
# reference register (+ hold time + uncertainty): input min = L_min - OT_IO_IN_HOLD_SKEW (default 0).  Counting the 50 ps on
# both sides demanded ~150 ps of hold delay per link for a 50 ps skew (the FF -30..-45 ps input band of every master).
set ot_hki [expr {[info exists ::env(OT_IO_IN_HOLD_SKEW)] ? $::env(OT_IO_IN_HOLD_SKEW) : 0}]
set_input_delay [expr $qdm_lmin - $ot_hki] -min -clock core_clk [all_inputs -no_clocks]
set_output_delay [expr $ot_ob - $qdm_lmax + $ot_sk] -max -clock core_clk [all_outputs]
set_output_delay [expr 0 - $qdm_lmin - $ot_hk] -min -clock core_clk [all_outputs]
# OT_BH begin -- DIE BOUNDARY HOLD BUDGET (FLOW-HOLD, owner 2026-10-16 ~22:00; results/arch/boundary_hold_budget_1016/RULE.md).  Opt-in:
# OT_IO_HOLD_BUDGET=die (ref_tile spec "hold_budget": "die"; registered-pin tiles only).  Setup lines above unchanged.
#   output min = U - (L_min + C)     the SENDER guarantees launch >= L_min + C at FF (C = OT_BH_LAUNCH_MIN_PS, default 25:
#                                    a pin register's FF clk->Q, no pad), nothing more
#   input  min = L_min + C + U       the RECEIVER credits that guaranteed launch (0 wire); U = OT_BH_TILE_HOLD_UNC_PS (25)
#                                    cancels the tile's own hold uncertainty on boundary paths only
# The link's skew (<= 80 ps neighbour budget), hold uncertainty and any shortfall are the DIE's: die FF STA on the tiles'
# ETMs (whose hold arcs do not depend on these delays) must hold >= 0, fixed in relay stations / die-net hold cells.
# OT_BH_ROUTE_RELIEF_PS (route-time only, = hold_margin - io_hold_margin): the boundary is repaired at the io margin.
if {[info exists ::env(OT_IO_HOLD_BUDGET)] && $::env(OT_IO_HOLD_BUDGET) eq "die"} {
  set ot_bhc [expr {[info exists ::env(OT_BH_LAUNCH_MIN_PS)] ? $::env(OT_BH_LAUNCH_MIN_PS) : 25}]
  set ot_bhu [expr {[info exists ::env(OT_BH_TILE_HOLD_UNC_PS)] ? $::env(OT_BH_TILE_HOLD_UNC_PS) : 25}]
  set ot_bhr [expr {[info exists ::env(OT_BH_ROUTE_RELIEF_PS)] ? $::env(OT_BH_ROUTE_RELIEF_PS) : 0}]
  set_input_delay [expr $qdm_lmin + $ot_bhc + $ot_bhu + $ot_bhr] -min -clock core_clk [all_inputs -no_clocks]
  set_output_delay [expr $ot_bhu + $ot_bhr - $qdm_lmin - $ot_bhc] -min -clock core_clk [all_outputs]
  puts "OT_HOLD_BUDGET die: L_min $qdm_lmin C $ot_bhc U $ot_bhu relief $ot_bhr"
}
# OT_BH end
if {[info exists ::env(OT_IO_INTER)] && $::env(OT_IO_INTER) ne ""} {
  set ot_ski [expr {[info exists ::env(OT_IO_SKEW_INTER)] ? $::env(OT_IO_SKEW_INTER) : 150}]
  set ot_ii {}; set ot_io {}
  foreach g [split $::env(OT_IO_INTER) ","] {
    foreach p [get_ports -quiet $g] { if {[get_property $p direction] eq "input"} { lappend ot_ii $p } else { lappend ot_io $p } }
  }
  if {[llength $ot_ii]} { set_input_delay [expr $ot_ib + $qdm_lmax + $ot_ski] -max -clock core_clk $ot_ii }
  if {[llength $ot_io]} { set_output_delay [expr $ot_ob - $qdm_lmax + $ot_ski] -max -clock core_clk $ot_io }
  puts "OT_IO_INTER [llength $ot_ii] inputs [llength $ot_io] outputs at $ot_ski ps"
}
if {[llength [get_ports -quiet tile_id*]]} { set_false_path -from [get_ports tile_id*] }
# ---- sdc_extra physical/qwen_fwd_lane/safe_land_clocks.tcl
# Q-DIE11-RLY 10-18: clocks of the Qwen forwarded half-cycle lane frames (rtl/qwen_split/qfd_fwd_lane.sv, generated
# wrappers physical/qwen_fwd_lane/qfd_fwd_lane_masters.sv), sdc_extra + boundary_tcl of every qfwd_* kit (re-applied
# after every io_ref switch and at sign-off).
#   station  qfd_rlyh_*   clock port ckf; ck_o = ~ckf through ONE kept inverter -> generated clock ck_o_fwd INVERTED
#   hop 0    qfd_rlyh0_*  clock port ck (source root); capture on cko = ICG(ck) (RISING ck edge, Q-DIE11 10-18 kit fix),
#                         ck_o = ~cko -> generated clock ck_o_fwd INVERTED (the S81 dsfd_dvrlyh form)
#   landing  qfd_landh_*  clock port ck (receiving root, read side); ckf = the lane clock (ring write side) -> clock
#                         lane_ckf, same period; landh0: ck_s (source root, ring written on ICG(~ck_s))
#   ck_o carries no data budget.  The landing's lane inputs a / ea are captured on the lane clock: their IO budget is
#   re-referenced to lane_ckf.  The ring -> o crossing (lane clock -> ck) is the die STA's landing window
#   SAFE-QW-LAND: every crossing remains timed under the conservative sampled-age envelope.
set ot_fl_ck [get_clocks core_clk]
set ot_fl_T [get_property $ot_fl_ck period]
if {[llength [get_ports -quiet ck_o]]} {
  unset_output_delay [get_ports ck_o]
  if {![llength [get_clocks -quiet ck_o_fwd]]} {
    if {[llength [get_ports -quiet ckf]]} {
      create_generated_clock -name ck_o_fwd -source [get_ports ckf] -divide_by 1 -invert [get_ports ck_o]
      puts "OT_FWD_LANE: station ck_o = ~ckf (generated ck_o_fwd INVERTED, half-cycle hop)"
    } elseif {[llength [get_ports -quiet ck]]} {
      create_generated_clock -name ck_o_fwd -source [get_ports ck] -divide_by 1 -invert [get_ports ck_o]
      puts "OT_FWD_LANE: hop-0 ck_o = ~(ck gated) (generated ck_o_fwd INVERTED), capture on the rising ck edge"
    }
  }
} else {
  # Q-DIE11b 10-18: idempotent.  The sign-off session reads 6_final.sdc (lane_ckf at the ROUTE period, 770) and then
  # re-creates core_clk at 833.333 and replaces every input delay on core_clk (unset_input_delay [all_inputs]), so a
  # skip-if-exists left lane_ckf at the route period and the lane inputs a / ea on core_clk (false-pathed to the ring):
  # always (re)define lane_ckf at the CURRENT core_clk period and re-apply the lane inputs' budget on it.
  set ot_fl_wp [expr {[llength [get_ports -quiet ckf]] ? "ckf" : "ck_s"}]
  if {[llength [get_ports -quiet $ot_fl_wp]]} {
    create_clock -name lane_ckf -period $ot_fl_T [get_ports $ot_fl_wp]
    # QK-LAND600 10-18: lane_ckf is propagated only once the tree exists (post-CTS / sign-off: core_clk already
    # propagated, or ::ot_ref_pre_cts 0), as every other clock.  Propagating it PRE-CTS timed the landh0 ring through the
    # single unbuffered hop-0 ICGx1 driving all 4 x W + 13 ring clock pins (W 600: 2,419 sinks, 15.5 ns slew, 1.5 ns
    # clk->Q): the PREROUTE_MARGIN -857..-988 ps of all four qfwd_landh0_600 kits was this artifact, not logic.
    if {!([info exists ::ot_ref_pre_cts] && $::ot_ref_pre_cts) || [get_property $ot_fl_ck is_propagated]} {
      set_propagated_clock [get_clocks lane_ckf]
    }
    set ot_fl_in [get_ports -quiet {a[*] ea[*] ea en[*] en}]
    if {[llength $ot_fl_in]} {
      unset_input_delay $ot_fl_in
      # max: the tile's 0.2 T outside share; min: the sender's guaranteed launch C + this tile's hold uncertainty U
      # (OT_BH_LAUNCH_MIN_PS + OT_BH_TILE_HOLD_UNC_PS, 25 + 25; the forwarded edge is the reference, no tree term)
      set ot_fl_c [expr {[info exists ::env(OT_BH_LAUNCH_MIN_PS)] ? $::env(OT_BH_LAUNCH_MIN_PS) : 25}]
      set ot_fl_u [expr {[info exists ::env(OT_BH_TILE_HOLD_UNC_PS)] ? $::env(OT_BH_TILE_HOLD_UNC_PS) : 25}]
      # QK-LANDH548 10-18: the min credits the lane tree's own insertion L_min at the ring write flops, exactly as the
      # core_clk die hold budget (io_ref_skew.sdc OT_BH: input min = L_min + C + U).  Without the L term every routed
      # landing padded its data inputs by the whole lane_ckf insertion (548 b: 8-11 hold BUFx2 per a[*] pin, ~200 ps;
      # landh_548_EN a[253] arrives 405 ps, native capture S + R_lane 245 / landh0_548_EW 272, en 351, > 190 on 549
      # pins) and the die's T/2 forwarded hop paid them in setup.  The data is safe without the pads: a landh lane
      # input is launched on the sender's ckf rise = this ckf FALL (half-cycle hop: T/2 hold margin), a landh0 input on
      # the source root whose ck_s pin the die delivers at phi - R (native rule), so data at the pin is >= L + C late.
      # Pre-CTS (ideal lane clock) L = 0: unchanged.  Override OT_FL_LMIN_CREDIT=0.
      set ot_fl_l 0.0
      if {[get_property [get_clocks lane_ckf] is_propagated] &&
          !([info exists ::env(OT_FL_LMIN_CREDIT)] && $::env(OT_FL_LMIN_CREDIT) eq "0")} {
        catch {sta::worst_slack_cmd max}
        set ot_fl_lv {}
        foreach p [all_registers -clock [get_clocks lane_ckf] -clock_pins] {
          set a [get_property $p arrival_min_rise]
          if {[string is double -strict $a]} { lappend ot_fl_lv $a }
        }
        if {[llength $ot_fl_lv]} { set ot_fl_l [tcl::mathfunc::min {*}$ot_fl_lv] }
      }
      set_input_delay -max [expr {0.2 * $ot_fl_T}] -clock lane_ckf $ot_fl_in
      set_input_delay -min [expr {$ot_fl_l + $ot_fl_c + $ot_fl_u}] -clock lane_ckf $ot_fl_in
      puts "OT_FWD_LANE: lane inputs min = L_min $ot_fl_l + C $ot_fl_c + U $ot_fl_u (lane_ckf ring write flops)"
    }
    # Supported read age = [T/4, 13T/4] at the compensated clock roots.
    # A slot is rewritten after4T, so next overwrite is at least3T/4 later.
    # Related phase-zero STA is the reference envelope, NOT an assertion that
    # the forwarded clock physically arrives with phase zero. Extra3T/4 setup
    # uncertainty leaves T/4 for EVERY write-domain -> read-domain data cone.
    # Real insertion/skew and ordinary60ps setup/25ps hold are still charged.
    # No data false paths, disabled paths, or multicycle exceptions are used.
    set_clock_uncertainty -setup -from [get_clocks lane_ckf] -to $ot_fl_ck [expr {60.0 + 0.75 * $ot_fl_T}]
    set_clock_uncertainty -hold -from [get_clocks lane_ckf] -to $ot_fl_ck 25.0
    set_clock_uncertainty -setup -from $ot_fl_ck -to [get_clocks lane_ckf] [expr {60.0 + 0.75 * $ot_fl_T}]
    set_clock_uncertainty -hold -from $ot_fl_ck -to [get_clocks lane_ckf] 25.0
    puts "OT_FWD_LANE: landing write clock lane_ckf on $ot_fl_wp (period $ot_fl_T); all ring -> o/select paths directly timed with quarter-period setup envelope"
  }
}

set_propagated_clock [all_clocks]
