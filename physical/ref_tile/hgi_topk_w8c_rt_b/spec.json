  "tag": "t1",
  "purpose": "el1012-t1 re-route of w8 cluster (rt_a EARLY_FAIL_HOLD flat -400.6: input-pin IO hold from orfs_hold_mm FF arrival measured before parasitics (fixed on main de53a3b7c) + child clock pins as own spine leaves (OT_SPINE_MACRO_LEAF=1); RTL: rst_n port drives only an 11-region ot_rst_relay (16 child rst_n pins were on the raw port, SS setup -856 at u_l7/rst_n), bfifo not ready while in reset). Same outline/children/pins as rt_a.",
  "benches": [
   {
    "name": "heap_iw8w8_short_exact",
    "cmd": "bash tools/hgi_topk_heap_bench.sh {RUN}/bench/short -DIW=8 -DHW=8 -DHUBC -DSHORT",
    "expect": "pass",
    "pass_regex": "^HGI_TOPK_HEAP PASS",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "timeout_s": 7200
   },
   {
    "name": "heap_iw8w8_full_exact",
    "cmd": "bash tools/hgi_topk_heap_bench.sh {RUN}/bench/full -DIW=8 -DHW=8 -DHUBC",
    "expect": "pass",
    "pass_regex": "^HGI_TOPK_HEAP PASS \\(16 cases\\)",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "timeout_s": 7200
   },
   {
    "name": "heap_bypass_mutant",
    "cmd": "bash tools/hgi_topk_heap_bench.sh {RUN}/bench/mbyp -DIW=8 -DHW=8 -DHUBC -DSHORT -DOT_TOPK_HEAP_MUT_BYP",
    "expect": "fail",
    "fail_regex": "HGI_TOPK_HEAP FAIL errors",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "timeout_s": 7200
   },
   {
    "name": "heap_clear_mutant",
    "cmd": "bash tools/hgi_topk_heap_bench.sh {RUN}/bench/mclr -DIW=8 -DHW=8 -DHUBC -DSHORT -DOT_TOPK_HEAP_MUT_CLR",
    "expect": "fail",
    "fail_regex": "HGI_TOPK_HEAP FAIL errors",
