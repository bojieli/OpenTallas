# generated by tools/ref_tile/ref_tile.py (qfd_c_b16_dv_diagc): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck_w0]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/qcluster/qfd_c_b16_dv_quadrants.sdc
# Q-CLUSTER qfd_c_b16_dv: the seven non-core regional roots (generated by tools/qwen_cluster/qc_kit.py; DO NOT EDIT).
# Same period / phase as core_clk (related, neighbour-relative die delivery); each boundary port is timed against the
# clock of the region that holds its pin register (0.2 T in / out, as core_clk's ports).
set ot_q_per [get_property [get_clocks core_clk] period]
create_clock -name ck_w1 -period $ot_q_per [get_ports ck_w1]
create_clock -name ck_w2 -period $ot_q_per [get_ports ck_w2]
create_clock -name ck_w3 -period $ot_q_per [get_ports ck_w3]
create_clock -name ck_e0 -period $ot_q_per [get_ports ck_e0]
create_clock -name ck_e1 -period $ot_q_per [get_ports ck_e1]
create_clock -name ck_e2 -period $ot_q_per [get_ports ck_e2]
create_clock -name ck_e3 -period $ot_q_per [get_ports ck_e3]
set_clock_uncertainty -setup 60 [get_clocks {ck_w1 ck_w2 ck_w3 ck_e0 ck_e1 ck_e2 ck_e3}]
set_clock_uncertainty -hold 25 [get_clocks {ck_w1 ck_w2 ck_w3 ck_e0 ck_e1 ck_e2 ck_e3}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_w3 [get_ports {rs_i*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_w3 [get_ports {bco0*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_w3 [get_ports {bco1*}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_e0 [get_ports {bc2*}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_e0 [get_ports {bc3*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_e0 [get_ports {rs_o*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_e3 [get_ports {bco2*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_e3 [get_ports {bco3*}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_w1 ck_w2 ck_w3 ck_e0 ck_e1 ck_e2 ck_e3}] }
set_case_analysis 0 [get_ports {cid[*]}]
set_case_analysis 0 [get_ports far]
set_input_transition 150 [all_inputs -no_clocks]
