 "job": {
  "owner": "Claude:H-D4G5/HOSTEP",
  "branch": "claude/hd4g5-hostep",
  "tag": "r1",
  "purpose": "HBM die d4g host control plane on the static link endpoint (coordinator 0gd, lanes/OWNERS-HBM.md C2): successor of ot_hbm_host_cp_rx for host_N <-> hfd_ep_static <-> this tile; retires ot_hbm_lk_ep / ot_lkep_sub / ot_lkep_ctrl_phy_data / hfd_lk_ep_face / ot_hbm_host_phy_adapt and the on-die credit loop. Link sequencer (slot-calendar TX, one-frame RX pingpong drain), host link reliability (COLL static link capture with wrapping 16-b sequences), unchanged landing256 (2 SRAM), credit-free packet controller; 4 replay SRAM leaves.",
  "benches": [
   {
    "name": "cprxs_e2e_vs_cprx",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/pass 0 70000",
    "expect": "pass",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "min_count_regex": "^HOST_CP_RXS_PASS requests=(\\d+)"
   },
   {
    "name": "cprxs_mut1",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/mut1 1 3000",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "fail_regex": "^HOST_CP_RXS_FAIL MUT=1 fault_edge=[0-9]",
    "note": "TX slot calendar one step late (frame on beat phase 4 / IDLE -> endpoint cal_fault)",
    "fail_witness": "results/rtl/hbm_host_ep_1018/witness/mut1.log"
   },
   {
    "name": "cprxs_mut2",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/mut2 2 3000",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "fail_regex": "^HOST_CP_RXS_FAIL MUT=2 fault_edge=[0-9]",
    "note": "RX expect one edge early (link slot / sequence check -> epoch abort)",
    "fail_witness": "results/rtl/hbm_host_ep_1018/witness/mut2.log"
   },
   {
    "name": "cprxs_mut3",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/mut3 3 3000",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "fail_regex": "^HOST_CP_RXS_FAIL MUT=3 fault_edge=[0-9]",
    "note": "no TX spacing (frames closer than the far one-frame pingpong recycle -> host endpoint early fault)",
    "fail_witness": "results/rtl/hbm_host_ep_1018/witness/mut3.log"
   },
   {
    "name": "cprxs_mut4",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/mut4 4 3000",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "fail_regex": "^HOST_CP_RXS_FAIL MUT=4 fault_edge=[0-9]",
    "note": "rx word bit 40 flipped into the landing (configuration corrupted -> transaction mismatch)",
    "fail_witness": "results/rtl/hbm_host_ep_1018/witness/mut4.log"
   },
   {
    "name": "cprxs_mut5",
    "cmd": "bash rtl/hbm_accel/host_ep_20261018/run_host_cp_rxs.sh {RUN}/bench/mut5 5 70000",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 8,
    "needs": [
     "verilator"
    ],
    "pass_regex": "^HOST_CP_RXS_PASS",
    "fail_regex": "^HOST_CP_RXS_FAIL MUT=5 fault_edge=[0-9]",
    "note": "saturating link sequence counters (COLL behaviour): the session aborts at 65,536 frames",
    "fail_witness": "results/rtl/hbm_host_ep_1018/witness/mut5.log"
   }
  ],
