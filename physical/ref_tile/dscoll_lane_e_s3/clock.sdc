# generated by tools/ref_tile/ref_tile.py (dscoll_lane_e_s3): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/dscoll_cx/tf_fwdclk_out.sdc
# HF-3b (10-18): dsfd_coll_lane_{w,e} forwarded-clock output tf[0] = ck through the kept clock buffer ot_s81ph_ckbuf
# (u.u_tf), a clock-network output, not data.  The lt W route dscoll_lane_w_lt-lt-9356760de failed FF hold on exactly ONE
# path, ck[0] -> tf[0] (-88.94 ps, 16 levels = the clock tree to the tf tap), because the die-context boundary SDC
# (io_ref_skew.sdc / io_ref_routed.sdc) times every output as core_clk data: min output delay = -L_min - 50 asks the clock
# tap to arrive later than the boundary register mean.  Every data class passed (tx outputs >= +10.91, inputs >= +12.43,
# reg->reg >= +8.86).  Route hold repair cannot pad a clock net, and a larger io_hold_margin only raises the requirement.
# Same treatment as main's hfd_router fclk_ports_signoff.sdc: the forwarded clock is excluded from the core_clk data IO
# check; its position against the registered tx beat at the die face is REPORTED below (OT_TF_SKEW), not hidden.
if {[llength [get_ports -quiet {tf[0]}]]} {
  set_false_path -to [get_ports {tf[0]}]
  if {!([info exists ::ot_ref_pre_cts] && $::ot_ref_pre_cts)} {
    catch {
      set ot_tf_p [get_pins -quiet -of_objects [get_nets -quiet {tf[0]}] -filter "direction == output"]
      if {[llength $ot_tf_p]} {
        puts "OT_TF_SKEW tf driver [get_full_name [lindex $ot_tf_p 0]] arrival max [get_property [lindex $ot_tf_p 0] arrival_max_rise] min [get_property [lindex $ot_tf_p 0] arrival_min_rise] (ps, from ck; tx is the registered gearbox beat on the same face)"
      }
    }
  }
}
set_input_transition 150 [all_inputs -no_clocks]
