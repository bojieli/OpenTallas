          values("103.21630");
        }
        fall_constraint(scalar) {
          values("104.41964");
        }
      }
    }
    pin("o") {
      direction : output;
      capacitance : 0.2055;
      timing() {
        related_pin : "ck";
        timing_type : rising_edge;
        cell_rise(template_1) {
          index_1("1.44000,  2.88000,  5.76000,  11.52000,  23.04000,  46.08000,  92.16000");
          values("162.76788,166.11035,172.17778,183.74136,206.59166,252.19582,343.30481");
        }
