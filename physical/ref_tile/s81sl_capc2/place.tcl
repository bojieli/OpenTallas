# generated by tools/ref_tile/ref_tile.py (s81sl_capc2): fixed macro / hard-child placement on the asap7
# track lattice (origins from check_macro_track_alignment best shift), >= 20 um channels, no macro at a pin
# face.  Instance names are matched with backslashes stripped on BOTH sides (the db holds g\[1\].u or g[1].u
# depending on the stage).  A spec instance pattern (glob) picks among same-master instances; else dictionary
# order.  The halo is MACRO_PLACE_HALO (rows cut by tapcell); NO extra placement blockage: a hard blockage over
# the halo covers the row-end endcaps and fails detailed placement (DPL-0004 / DPL-0033, ref gate 2026-10-11).
set b [ord::get_db_block]
set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
proc ot_ref_strip {n} { return [string map {\\ {}} $n] }
set ot_ref_by {}
set ot_ref_l {}
foreach i [$b getInsts] { if {[[$i getMaster] isBlock]} { lappend ot_ref_l [list [ot_ref_strip [$i getName]] $i] } }
foreach p [lsort -dictionary -index 0 $ot_ref_l] {
  set i [lindex $p 1]; dict lappend ot_ref_by [[$i getMaster] getName] $i
}
set ot_ref_used {}
proc ot_ref_pick {by master pat} {
  upvar ot_ref_used used
  if {![dict exists $by $master]} { error "ref_tile place: no instance of $master in the netlist" }
  foreach i [dict get $by $master] {
    set n [ot_ref_strip [$i getName]]
    if {[lsearch -exact $used $n] >= 0} continue
    set sp [ot_ref_strip $pat]
    # exact name first: a generate name g_q[0].u_rq is a glob char class to string match (never matches)
    if {$pat ne "" && $sp ne $n && ![string match $sp $n]} continue
    lappend used $n; return $i
  }
  error "ref_tile place: no unplaced instance of $master matching '$pat'"
}
set ot_ref_n 0
set i [ot_ref_pick $ot_ref_by ot_s81sl_cap_rt {u_p.u_core.g_hard.u_rt}]
$i setOrient R0; $i setLocation [expr {round(43.2 * $dbu)}] [expr {round(43.2 * $dbu)}]; $i setPlacementStatus FIRM
puts "REF_TILE place: [$i getName] ot_s81sl_cap_rt at 43.2 43.2 R0"
set i [ot_ref_pick $ot_ref_by ot_s81sl_cap_tr {u_p.u_core.g_hard.u_tw}]
$i setOrient R0; $i setLocation [expr {round(43.2 * $dbu)}] [expr {round(302.4 * $dbu)}]; $i setPlacementStatus FIRM
puts "REF_TILE place: [$i getName] ot_s81sl_cap_tr at 43.2 302.4 R0"
set i [ot_ref_pick $ot_ref_by ot_s81sl_cap_tr {u_p.u_core.g_hard.u_te}]
$i setOrient R0; $i setLocation [expr {round(216.0 * $dbu)}] [expr {round(302.4 * $dbu)}]; $i setPlacementStatus FIRM
puts "REF_TILE place: [$i getName] ot_s81sl_cap_tr at 216.0 302.4 R0"
set i [ot_ref_pick $ot_ref_by ot_s81sl_cap_ed {u_p.u_core.g_ed.u_ed}]
$i setOrient R0; $i setLocation [expr {round(216.0 * $dbu)}] [expr {round(216.0 * $dbu)}]; $i setPlacementStatus FIRM
puts "REF_TILE place: [$i getName] ot_s81sl_cap_ed at 216.0 216.0 R0"
set i [ot_ref_pick $ot_ref_by ot_s81sl_cap_ld {u_p.u_core.g_ld3.u_ld3}]
$i setOrient R0; $i setLocation [expr {round(43.2 * $dbu)}] [expr {round(216.0 * $dbu)}]; $i setPlacementStatus FIRM
puts "REF_TILE place: [$i getName] ot_s81sl_cap_ld at 43.2 216.0 R0"
set nb 0; dict for {k v} $ot_ref_by { incr nb [llength $v] }
if {$nb != 5} { error "ref_tile place: expected 5 macros, netlist has $nb" }
