# GENERATED by tools/ref_tile/ref_tile.py (qkd_pv_fin_s8): route-time FF hold frame = sign-off FF frame (NOT a
# sign-off SDC; signoff.py reads constraint.sdc with --ff-vclk bound-ff 202.5).
create_clock -name vclk -period 833.0000
set_clock_latency -source 202.5000 [get_clocks vclk]
set_clock_uncertainty 25.0000 -hold [get_clocks vclk]
set_clock_uncertainty -from [get_clocks vclk] -to [get_clocks core_clk] -hold 12.5000
set_clock_uncertainty -from [get_clocks core_clk] -to [get_clocks vclk] -hold 12.5000
unset_input_delay [all_inputs -no_clocks]
unset_output_delay [all_outputs]
set_input_delay -max 166.6000 -clock vclk [all_inputs -no_clocks]
set_input_delay -min -40.0000 -clock vclk [all_inputs -no_clocks]
set_output_delay -max 166.6000 -clock vclk [all_outputs]
set_output_delay -min 0.0000 -clock vclk [all_outputs]
# the golden's port load / drive (the route SDC has set_load 80, which hid ~10 ps of output hold at FF)
set_load 2 [all_outputs]
set_driving_cell -lib_cell BUFx4_ASAP7_75t_R -pin Y [all_inputs -no_clocks]
