# generated by tools/ref_tile/ref_tile.py (dsfd_vm_bgl28_mc5_h1pc): route SDC (over-constrained 770.0 ps; sign-off
# 833.333 in signoff.sdc), 60 / 25 ps uncertainty, boundary 0.2 / 0.2 x 833.333 ps outside the block.
# After CTS the hooks re-reference the boundary to the propagated tree (qwen_die_masters/io_ref_skew.sdc).
set ::ot_ref_pre_cts 1
create_clock -name core_clk -period 770.0 [get_ports ck]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay 166.667 -clock core_clk [all_inputs -no_clocks]
set_output_delay 166.667 -clock core_clk [all_outputs]
set_max_fanout 32 [current_design]
set_load 80 [all_outputs]
set_max_transition 260 [current_design]
# ---- sdc_extra physical/ref_tile_specs/ds_vm/dsfd_vm_bgl28_mc5.sdc
# Five RELATED clocks. No asynchronous groups, false paths, multicycle paths,
# or period relaxation. Internal bank/relay paths remain timed at the real period.
source /src/physical/ref_tile_specs/ds_vm/dsfd_vm_bgl28_mc5_nominal.tcl
set ot_mc_period [get_property [get_clocks core_clk] period]
create_clock -name req_clk -period $ot_mc_period [get_ports ck_req]
create_clock -name ret_clk -period $ot_mc_period [get_ports ck_ret]
create_clock -name fwd0_clk -period $ot_mc_period [get_ports ck_fwd0]
create_clock -name fwd1_clk -period $ot_mc_period [get_ports ck_fwd1]
create_clock -name ot_bgl_io -period $ot_mc_period
set_input_transition 150 [get_ports {ck ck_req ck_ret ck_fwd0 ck_fwd1}]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
# The default single-root hook runs before this scoped hook in signoff.sdc.
# Clear ALL clock and clock-fall data tags, including clock-source ports, before
# reading any arrival. OpenSTA unset_input_delay without -clock clears all tags.
foreach ot_mc_clock [all_clocks] {
    unset_input_delay -clock $ot_mc_clock [all_inputs]
    unset_input_delay -clock $ot_mc_clock -clock_fall [all_inputs]
    unset_output_delay -clock $ot_mc_clock [all_outputs]
    unset_output_delay -clock $ot_mc_clock -clock_fall [all_outputs]
}
unset_input_delay [all_inputs]
unset_output_delay [all_outputs]
proc ot_bgl_mc_ports {patterns} {
    set result {}
    foreach pattern $patterns { foreach p [get_ports -quiet $pattern] { lappend result $p } }
    return $result
}
proc ot_bgl_mc_mean {clock patterns} {
    set values {}; set best_values {}
    set pins {}
    set allowed [dict create]
    foreach p [all_registers -clock_pins -clock [get_clocks $clock]] { dict set allowed [get_full_name $p] 1 }
    if {$patterns eq {ALL}} {
        set pins [all_registers -clock_pins -clock [get_clocks $clock]]
    } else {
        foreach pattern $patterns {
            foreach c [get_cells -quiet -hierarchical $pattern] {
                foreach pin [get_pins -quiet "[get_full_name $c]/CLK"] { lappend pins $pin }
            }
        }
    }
    foreach p $pins {
        if {![dict exists $allowed [get_full_name $p]]} { continue }
        set a [get_property $p arrival_max_rise]
        set best [get_property $p arrival_min_rise]
        if {[string is double -strict $a] && [string is double -strict $best]} {
            lappend values $a; lappend best_values $best
        }
    }
    if {![llength $values]} { error "BGL_MC: no measured reference for $clock ($patterns)" }
    set sum 0.0
    foreach a $values { set sum [expr {$sum+$a}] }
    set mean [expr {$sum/[llength $values]}]
    set best_sum 0.0
    foreach a $best_values { set best_sum [expr {$best_sum+$a}] }
    set best_mean [expr {$best_sum/[llength $best_values]}]
    set sorted [lsort -real $values]; set best_sorted [lsort -real $best_values]
    # Positive-edge DFFs only. In the route's two loaded scenes, arrival_max
    # is the actual configured setup scene (TC=TT), arrival_min is BC=FF.
    # Single-corner replay/export measures that actual corner on both senses.
    puts "BGL_MC_RAW root=$clock n=[llength $values] max_mean=$mean max_min=[lindex $sorted 0] max_max=[lindex $sorted end] min_mean=$best_mean min_min=[lindex $best_sorted 0] min_max=[lindex $best_sorted end]"
    return [list $mean $best_mean]
}
# Pin ownership is explicit. Request input/output share rb0; return input/output
# use rt/so in H1. Bank input straps/reset reference bank rst/gidq clocks.
set ot_mc_owners [list [list req_clk {i_v* i_we* i_row* i_mask* i_d*} {} {ALL}] \
    [list ret_clk {r_v* r_d* r_f* r_o*} {o_v* o_d* o_f* o_o*} {ALL}] \
    [list core_clk {rs grp* bi*} {} {u_leaf.u.gidq* u_leaf.u.rst_s* u_leaf.u.g_reset_hist_split.rst_hist_b*}]]
# Explicit per-port output launch ownership; input i_* also captures on req_clk.
# Virtual IO phi0 remains UNBOUND actual peer phase, not correlation evidence.
foreach half {0 1} {
 set outs {};set ins {}
 foreach spec {{v 1} {we 1} {row 14} {mask 4} {d 128}} {
  lassign $spec signal width
  for {set p [expr {14*$half}]} {$p < 14*($half+1)} {incr p} {
   for {set bit 0} {$bit < $width} {incr bit} {
    set index [expr {$p*$width+$bit}]
    # Escaped literal brackets prevent Tcl substitutions and glob ranges.
    lappend outs [format {f_%s\[%d\]} $signal $index]
    lappend ins [format {i_%s\[%d\]} $signal $index]
   }
  }
 }
 lappend ot_mc_owners [list fwd${half}_clk $ins $outs {ALL}]
}
set ot_mc_post [expr {![info exists ::ot_ref_pre_cts] || !$::ot_ref_pre_cts}]
set ot_mc_physical [get_clocks {core_clk req_clk ret_clk fwd0_clk fwd1_clk}]
# Clear previous compensation before EACH measurement; arrivals below are RAW.
set_clock_latency -source 0 $ot_mc_physical
if {$ot_mc_post} { set_propagated_clock $ot_mc_physical; catch {sta::worst_slack_cmd max} }
set ot_mc_refs [dict create]
foreach owner $ot_mc_owners {
    lassign $owner clock inputs outputs refs
    set R 0.0; set Rmin 0.0
    if {$ot_mc_post} { lassign [ot_bgl_mc_mean $clock $refs] R Rmin }
    dict set ot_mc_refs $clock [list $R $Rmin]
    set ii [ot_bgl_mc_ports $inputs]; set oo [ot_bgl_mc_ports $outputs]
    set sk [expr {$ot_mc_post ? 90.0 : 0.0}]
    set hk [expr {$ot_mc_post ? 50.0 : 0.0}]
    if {[llength $ii]} {
        set_input_delay [expr {166.667+$sk}] -max -clock ot_bgl_io $ii
        set_input_delay 0.0 -min -clock ot_bgl_io $ii
    }
    if {[llength $oo]} {
        set_output_delay [expr {166.667+$sk}] -max -clock ot_bgl_io $oo
        set_output_delay [expr {-$hk}] -min -clock ot_bgl_io $oo
    }
}
# Source-port data tags must be absent after all IO assignments.
unset_input_delay [get_ports {ck ck_req ck_ret ck_fwd0 ck_fwd1}]
# Apply real phi-R delivery once, retaining the measured boundary spread.
# The RAW mean/min/max records above are the root R evidence. Saved SDC / generic
# clock insertion reports include this source compensation; they are NOT raw R.
if {$ot_mc_post} {
    dict for {clock references} $ot_mc_refs {
        lassign $references R Rmin
        if {![dict exists $::ot_bgl_mc_nominal_refs $clock]} { error "BGL_MC missing bound nominalTT reference for $clock" }
        set nominal_R [dict get $::ot_bgl_mc_nominal_refs $clock]
        # ONE physical source phase, used unchanged for early/late and TT/FF/SS.
        # Actual min/max corner tree variation remains in every timed crossing.
        set_clock_latency -source [expr {-$nominal_R}] [get_clocks $clock]
        puts "BGL_MC_DELIVERY root=$clock period=$ot_mc_period phi=0 nominal_R=$nominal_R source_latency=[expr {-$nominal_R}] raw_max_R=$R raw_min_R=$Rmin"
    }
    dict for {from refs_from} $ot_mc_refs {
        set Rf [dict get $::ot_bgl_mc_nominal_refs $from]
        dict for {to refs_to} $ot_mc_refs {
            set Rt [dict get $::ot_bgl_mc_nominal_refs $to]
            if {$from eq $to} { continue }
            set skew [expr {$Rf > 300.0 || $Rt > 300.0 ? 150.0 : 90.0}]
            set_clock_uncertainty -setup [expr {60.0+$skew}] -from [get_clocks $from] -to [get_clocks $to]
            set_clock_uncertainty -hold 100.0 -from [get_clocks $from] -to [get_clocks $to]
        }
    }
}
set_input_transition 150 [all_inputs -no_clocks]
