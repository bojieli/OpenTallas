# el1011-q-sp (2026-10-11, owner textbook audit): the su64 LANE TILE -- ot_hdc_vstream_lane_t (one ot_hdc_vstream_lane behind
# pin flops on every input, out flops on every output, its own reset register), routed once and placed 64x by the su64
# parent (ot_hdc_vstream LT=1, RD relays).  Classes fixed on the flat su64: one ~780k-sink clock tree over 1.5 x 2 mm
# (now 64 local trees), one reset net (tile reset relay), lane I/O combinational across the tile (registered seams).
# Params as the su64 master: WR=W=16 AW=24 NW=18 KV_FP8=1 ML=VL=7 (ports), RD=2.
# r3 (lane_t_a TT -180.69: fp32 mul stage 2 = 4 CSA levels + 48-b prefix add, class 5): QLM=5 / QLA=4 (ot_hdc_*_lat cuts,
# same values); ~+6k tap/SFU flops.  Variant c: 259.2 x 259.2 (util ~0.50).
TOP=ot_hdc_vstream_lane_t
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_su_master_bv.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_su_master.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/ot_hdc_vstream_lane.sv rtl/hdc/ot_hdc_vstream_lane_t.sv rtl/hdc/ot_hdc_vreduce.sv rtl/hdc/ot_hdc_vstream.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param WR=16 --param AW=24 --param NW=18 --param KV_FP8=1 --param ML=7 --param RD=2 --param QLA=4 --param QLM=5)
FW=259.2
FH=259.2
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(emit0|live|i|fin_th|i_last_r|cura0|curb0|curc0|curd0|rrow|asi|bsi|csi|dsi|asrc|bsrc|csrc|mc|md|redsq|ma|mb|dst|red|ad|imm1|imm2|cls|accept|i_sfu)(\[|$)=left' --pin-region '^(va_q|vb_q|vc_q|wrom_q|crom_q)(\[|$)=bottom' --pin-region '^(va_re|va_addr|vb_re|vb_addr|vc_re|vc_addr|wrom_re|wrom_addr|crom_re|crom_addr)(\[|$)=top' --pin-region '^(vm_\w+|kv_\w+|l_\w+|retire)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr
