# sys-takeover 2026-10-09 master qfd_coll_xfifo_b (variant b outline 324 x 540, same RTL / kit): ot_qwen_die_coll_xfifo, the Qwen ROM die's native collective local
# port (registry qfd_native_collective_binding): sq sequencer (ckd) -> collective (ck) 546 b + valid / credits, cq
# collective -> sequencer 516 b + valid / credits, ckd return-space credit gate.  Instantiated by ot_qwen_die_io_xfifo
# NCOLL = 1 (die-top: inside the IO-band CDC slot); routed standalone here.  Multi-clock kit mc/qfd_coll_xfifo.
TOP=ot_qwen_die_coll_xfifo
SRCS='rtl/physical/ot_qwen_die_coll_xfifo.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/physical/ot_qwen_async_fifo_w.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=()
FW=324.0
FH=540.0
PINS=(--pin-region '^(i_seq_coll|i_seq_coll_v|i_seq_coll_cr)(\[|$)=left:10-260' --pin-region '^(o_coll_seq|o_coll_seq_v|o_coll_seq_cr)(\[|$)=left:280-530' --pin-region '^(o_seq_coll|o_seq_coll_v|o_seq_coll_cr)(\[|$)=right:10-260' --pin-region '^(i_coll_seq|i_coll_seq_v)(\[|$)=right:280-530' --pin-region '^(ck|ckd|rst_n|fault_ck|fault_ckd)$=top:81-243')
INTER='*'
REFGLOB='*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_coll_xfifo
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
PIN_H="M4 M6"
PIN_V="M5 M7"
