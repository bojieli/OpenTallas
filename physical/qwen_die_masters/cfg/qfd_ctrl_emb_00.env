# emb-hbm 2026-10-08 (r21c, NOT YET ROUTED: design review first): Qwen JEDEC scheduler PC00 with the embedding region's
# STATIC-ROW port (ot_qwen_ctrl_pc_emb: ot_qwen_ctrl_pc_head + ot_hbm_r14_stream_pc_srow SROW 1, 4-entry static queue,
# S_STARVE 8, TWIN 0), successor of qfd_ctrl_ready_hbm_00; HBM controller clock (1.024 ns).  Static port captured at
# the pin (s_*), credit s_cr and col_sr launched from flops.
TOP=ot_qwen_ctrl_pc_emb
SRCS='rtl/qwen_sys/emb_hbm_20261008/ot_qwen_ctrl_pc_emb.sv rtl/qwen_sys/emb_hbm_20261008/ot_hbm_r14_stream_pc_srow.sv'
PARAMS=(--param ENABLE=1 --param PC=0)
FW=247.536
FH=370.44
PINS=(--pin-region '^cmd(_v)?(\[|$)=left:8-120' --pin-region '^s_(v|we|bank|col|row)(\[|$)=left:125-240' --pin-region '^(read_credit|cmd_credit|s_cr)(\[|$)=left:245-360' --pin-region '^(row|col)_.*=right:8-360' --pin-region '^(clk|rst_n|busy|fault)$=top:8-240')
INTER='*'
REFGLOB='*cmd_q*'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr

# Qualified against the actual implemented clock domain; async FIFOs are instantiated in the die/bench.
ROUTE_PERIOD_NS=0.960
QDMD=/src/physical/qwen_die_masters/mc/qfd_ctrl_emb_00
SDCF=plain.sdc
CLKPORT=clk
