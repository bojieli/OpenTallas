# hgi-1010/g2 2026-10-10: the native index scorer's HARDENED ELEMENT = one 8-head chunk (ot_hdc_v41x_idx_chunk_el: the
# generated ot_hdc_v41x_idx_chunk_l with its head base as a strap; NB 4 x NKT 4 keys a cycle, the tap's FPL 7 / FML 5 /
# QL 5).  The L4 column tap = 4 of these + idx_tail + the line/beat front end (the flat 512-adder tap does not synthesize).
# Ports within the tap's clock region (90 ps).  Variant b: 760 x 760 um.
TOP=ot_hdc_v41x_idx_chunk_el
SRCS='rtl/hdc/v41x/ot_hdc_v41x_idx_chunk_el.sv rtl/hdc/v41x/ot_hdc_v41x_idx_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv'
PARAMS=(--param NB=4 --param NKT=4 --param FPL=7 --param FML=5 --param QL=5)
FW=760
FH=760
PINS=(--pin-region '^(k_v|k_kv|k_key)(\[|$)=left:10-750' --pin-region '^(ql_v|ql_head|ql_codes|ql_sc|ql_w|hb)(\[|$)=top:10-750' --pin-region '^(c_v|c_kv|c_sum|c_fault)(\[|$)=right:10-750' --pin-region '^(clk|rst_n)$=bottom:360-400')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*rkey*'
PD=0.50
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
