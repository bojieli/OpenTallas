# GX7 hgi-takeover: RSTR=1 registered reset + 4-cycle reset-tree multicycle (mtp18_rstr_mc.sdc) for the -594.68 ps rst_s[1] recovery miss.
# HGI token18 production-shaped full core, exact SPECF0/XSEL1, matching trace gate required.
TOP=hgi_mtp_core18_route
SRCS='rtl/hbm_accel/generic/hgi_mtp_core18_route.sv rtl/hbm_accel/generic/ot_hgi_mtp_core18.sv physical/hbm_mtp/rtl/ot_hfd_mtp_core.sv physical/hbm_mtp/rtl/ot_hfd_mtp_skid.sv physical/hbm_mtp/rtl/ot_dshbm_dspark_top_m.sv physical/hbm_mtp/rtl/ot_dshbm_dspark_ctl_m.sv physical/hbm_mtp/rtl/ot_dshbm_argmax_m.sv physical/hbm_mtp/rtl/ot_dshbm_expert_union_m.sv rtl/gpu/dshbm/ot_dshbm_accept_port.sv rtl/hdc/ot_hdc_accept.sv rtl/gpu/dshbm/ot_dshbm_spec_state.sv rtl/gpu/dshbm/ot_dshbm_spec_state_r.sv rtl/gpu/dshbm/ot_dshbm_spec_state_f.sv rtl/gpu/ot_gpu_router_topk.sv rtl/gpu/ot_gpu_router_topk_f.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/gpu/ot_gpu_fadd.sv'
PARAMS=(--param RSTR=1 --param SPECF=2)
FW=466.56
FH=200.88
PINS=(--pin-region '^(clk|rst_n|start|cfg_gamma|cfg_force|cfg_ngen|cfg_plen)(\[|$)=top:40-426' --pin-region '^(p_tok|f_tok|lg_v|lg_last|lg_bias_en|lg_mask|lg_vals|lg_bias|eng_done|cmd_ready)(\[|$)=left:5-196' --pin-region '^(p_addr|f_addr|e_v|e_tok|e_idx|done|cmd_v|cmd_op|cmd_idx|cmd_ncol|cmd_pos|cmd_tok1|cmd_toks|am_v|am_idx|am_fault)(\[|$)=right:5-196' --pin-region '^(sr_v|sr_ready|sr_kind|sr_idx|sr_pos|sa_v|sa_addr|sa_tok|sa_pad|sa_last|sa_err|n_committed)(\[|$)=bottom:5-165' --pin-region '^(x_v|x_draft|x_ids|x_col|t_v|t_ids|t_col|u_clr|u_flush|u_v|u_ready|u_id|u_mask|u_last)(\[|$)=bottom:170-315' --pin-region '^(step_v|step_a|step_g|steps|cyc_total|cyc_engine|cyc_markov)(\[|$)=bottom:320-462')
INTER='*'
REFGLOB='*i_lg_vals*'   # 7b24bc7f1 CTS: 11.9k input pin flops (lg_vals / lg_bias / rst) ~200 ps later than the i_p_tok reference -> hold flood; reference the majority group
FALSE_FROM='rst_n'
PIN_H='M4 M6'
PIN_V='M5 M7'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=pnr
SDCF=die_p770_mtp18_rstr.sdc
