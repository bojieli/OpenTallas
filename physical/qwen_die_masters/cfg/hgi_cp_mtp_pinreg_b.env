# fe-push-hgi-1010 2026-10-10: the registered MX1 MTP collar of the CP die (ot_hgi_cp_die MTP=2 MTP_PINREG=1;
# rtl/hbm_accel/generic/ot_hgi_cp_mtp_pinreg.sv): feasibility row "MX1 collar unregistered on f_mtp 517 / t_mtp 197".
# Faces: N = controller die nets f_mtp / t_mtp (to hgi_mtp_native); W = host / provider (mh_*, loader band);
# E = translator side (f_backend / t_backend / f_am, die-internal to ot_hgi_cp_die).
TOP=ot_hgi_cp_mtp_pinreg
SRCS='rtl/lib/ot_rst_relay.sv rtl/common/ot_sc_pfifo.sv rtl/hbm_accel/control/ot_hbm_native_mtp_transaction_cp_join_mx1.sv rtl/hbm_accel/control/ot_hbm_native_mtp_emit_queue_mx1.sv physical/hbm_cp_mtp_native/rtl/hfd_cmdproc_s_mtp_native_mx1.sv rtl/hbm_accel/generic/ot_hgi_cp_mtp_pinreg.sv'
PARAMS=(--param ENABLE_MTP=1)
FW=300
FH=300
PINS=(--pin-region '^(clk|rst_n|f_mtp|t_mtp)(\[|$)=top:8-292' --pin-region '^(f_host|t_host|f_provider|t_provider|t_emit|f_emit_host|t_emit_host|t_abort|t_drained)(\[|$)=left:8-292' --pin-region '^(f_backend|t_backend|f_am)(\[|$)=right:8-292')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*hd_q*'
PD=0.40
NC=8
MACROS=()
EXTRA=()
STAGES=pnr
