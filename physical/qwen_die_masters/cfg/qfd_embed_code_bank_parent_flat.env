# qwen-missing 2026-10-07 FLATTEN variant of qfd_embed_code_bank_parent: the ingress cell is the same RTL the hardened
# child was routed from (physical/qwen_embedding_parent/flat/ingress_code_flat.v -> ot_qwen_embedding_ingress_numeric),
# placed inside the parent; no ingress macro, so the parent's M1-M5 grid (pdn_m5) has no M6 pin to reach (PDN-0233).
# Boundary: the die-master io_ref_skew.sdc (rule H1) referenced to the flattened ingress valid_q register.
TOP=ot_qwen_embed_code_bank_parent
SRCS='physical/qwen_embedding_parent/flat/ingress_code_flat.v rtl/physical/ot_qwen_embedding_ingress_numeric.sv rtl/physical/ot_qwen_embed_code_bank_parent.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v'
PARAMS=(--param OCRED=4)
FW=270
FH=120.42
PINS=(--pin-region '^(i_(v|addr|cr)|o_cr)(\[|$)=left' --pin-region '^o_(v|data)(\[|$)=right' --pin-region '^(clk|rst_n|fault)$=bottom')
INTER='i_*,o_*,fault'
REFGLOB='*valid_q*'
SDCF=embed_bank_p770.sdc
PD=0.55
NC=8
MACROS=(physical/asap7_memory_macros/ot_rom_4096x266_m8)
EXTRA=(--macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_embedding_parent/flat/place_code.tcl --step-tcl PRE_FLOORPLAN=physical/qwen_embedding_padded/preserve.tcl --orfs-var EMBED_PAD_CELLS=150)
STAGES=pnr
