# el1011-ds-misc/pqc 2026-10-11: T_AQ HARDENED SUB-TILE of the DS-ROM PQ spine screen (ot_v41_pqc_spine_screen): the FP8
# quantiser ot_dsrom_aq12t = ot_dsrom_aq12m with its 1024 b x 20 wait line in a 4 x SRAM 128 x 256 ring (+ capture
# flops), ~11.5k flops + 4 macros, own clock tree.  x and v enter on the top face into the s0_x pin flops; q / y / e / vo
# / fault leave from output flops on the bottom face.  Variant b: 518.4 x 108 um, 4 macros in a row, lane-ordered, PD 0.55.
TOP=ot_dsrom_aq12t
SRCS='rtl/lib/ot_rst_relay.sv physical/s81_pq_tiles/rtl/ot_dsrom_aq12t.sv physical/s81_pq_xrv/pinned/rtl/hdc/v41x/ot_dsrom_aq12m.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_fp32_f12.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_fp32_mul_lat.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_fastfp_lat_f12.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_sfu.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_fp32_add_lat.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_fastfp.sv physical/s81_pq_xrv/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_xrv/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_xrv/pinned/rtl/common/ot_prefix.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=()
FW=518.4
FH=108
PINS=(--pin-region '^(x|v)(\[|$)=top:8-510.4' --pin-region '^(q|y|e|vo|fault)(\[|$)=bottom:8-510.4' --pin-region '^(clk|rst_n)$=left:40-60')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*s0_x*'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view_sram.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/s81_pq_tiles/aq12t_place_b.tcl)
STAGES=pnr
