# Normative ATT record adapter, isolated from unchanged closed G12 leaf.
TOP=ot_hgi_att_record_adapter
SRCS='rtl/hbm_accel/generic/g12/record/ot_hgi_att_record_adapter.sv'
PARAMS=()
FW=320
FH=320
PINS=(--pin-region '^rec_desc(\[|$)=left:4-316' --pin-region '^att_desc(\[|$)=right:4-316' --pin-region '^(rec_hdr|rec_sut|rec_pos1|rec_b_count|rec_c_count|rec_v|rec_r)(\[|$)=top:4-316' --pin-region '^(att_hdr|att_v|att_r|att_done|att_fault|rows_cmd_v|rows_cmd_r|rows_ring|rows_pos1|rows_b_n|rows_b_m|rows_c_n|rows_done|rows_fault|busy|u_done|u_fault)(\[|$)=bottom:4-316' --pin-region '^(clk|rst_n)$=left:1-2')
INTER='*'
REFGLOB='*att_desc_q*'
CLKPORT=clk
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
