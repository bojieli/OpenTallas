# el1011-hbm-fq (2026-10-11): ot_hgi_quant_wide_h hardened sub-tile ot_hgi_qw_dec (280x280); layer contract: routing M2-M6, PDN pdn_block.tcl (<= M6), parent owns M7.
TOP=ot_hgi_qw_dec
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic/qw/ot_hgi_qw_dec.sv rtl/hbm_accel/generic/ot_hgi_quant_decode.sv physical/hbm_accel_die_views/common/ot_hfd_oreg1.sv physical/hbm_accel_die_views/quant/rtl/ot_hfd_actquant_m.sv rtl/hbm_accel/generic/ot_hgi_fp4qdq.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat_f12.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=()
FW=280
FH=280
PINS=(--pin-region '^(v|header|x)(\[|$)=left:10-270' --pin-region '^(vo|y|fault|decode_fault)(\[|$)=right:10-270' --pin-region '^(clk|rst_n)$=top:10-40')
PIN_H='M4 M6'
PIN_V='M5'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*i_v*'
CLKPORT=clk
PD=0.5
NC=16
RLAYERS='M2 M6'
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/tools/chip_assembly/tcl/pdn_block.tcl)
STAGES=synth,pnr
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
