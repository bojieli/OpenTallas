# hbm-phys-1010 [idx] (R25GQ, lead decision 10-10: index score lanes 12 a stack, taller slot): one L4 column tap of the
# 12-lane native grid (hfd_idx_score L=4 BK=12 LANE0=4: 12-key beats, lines 6b + LANE0/2 + j), behind hfd_idx_lrg (its
# W face abuts the lrg's E face: ik / ikc / q there) and ahead of hfd_idx_t3_join (s / sc on the E face).  FA 4: the
# lrg holds the svc credits (FIFO 64 a port); the tap only covers the lrg -> tap hop (16 credits a port).
# Slot plan: physical/hbm_accel_die_views/index/native_g12/slot.json.
TOP=hfd_idx_score
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_score.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv rtl/hdc/v41x/ot_hdc_v41x_idx_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hbm_accel/service/ot_hbm_accel_cdc_fifo.sv'
PARAMS=(--param L=4 --param FA=4 --param CRED=128 --param LANE0=4 --param FWD=0 --param BK=12)
FW=1698.84
FH=799.2
PINS=(--pin-region '^(ik|ikf|ikc)(\[|$)=left:10-560' --pin-region '^q(\[|$)=left:580-789' --pin-region '^(qx|s|sc|st)(\[|$)=right:10-789' --pin-region '^(ck|rst)$=bottom:840-860')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*_q*'
CLKPORT=ck
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
