# struct-close 2026-10-09 (review AB5): qfd_pc_head_owner without ID64 (ot_qfd_pc_head_owner_n: head_id removed, ack lanes 7 b) in the registered-boundary wrapper.
# struct-close 2026-10-09 ("-cl" registered-boundary batch): qfd_pc_head_owner_cl in the generated registered-boundary wrapper (pin flop on every input, flop on every output: +1 in / +1 out).
# drive-0158 "-cl" of qfd_pc_head_owner (REVIEW Q6 + addendum 02:35): one state copy (TMR removed, S4), registered outputs. Same pins / outline as 0cce9d18f.
TOP=ot_qfd_pc_head_owner_n
SRCS='physical/struct_close/regbound/ot_qfd_pc_head_owner_n_rb.sv rtl/common/ot_sc_pfifo.sv rtl/common/ot_secded.sv'
PARAMS=(--param ENABLE=1 --param PC=0)
FW=116.64
FH=116.64
PINS=(--pin-region '^(in_v|in_payload)(\[|$)=left' --pin-region '^(head_v|head_payload|head_id)(\[|$)=right' --pin-region '^(ack_v|ack_data)(\[|$)=bottom' --pin-region '^clk$=top:8-16' --pin-region '^(rst_n|credit_return|fault|ce)(\[|$)=top:40-108')
INTER='in_*,head_*,ack_*,credit_return'
REFGLOB='*wp*'
SDCF=die_p770.sdc
EXTRA=(--orfs-var 'VERILOG_INCLUDE_DIRS=/src/rtl/common')
PD=0.55
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=64
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
STAGES=pnr
