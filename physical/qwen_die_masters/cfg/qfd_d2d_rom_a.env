TOP=ot_qkvd_rom_end
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_rom_end.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_d2d.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo.sv'
