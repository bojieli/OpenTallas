FW=777.6
FH=259.2
PINS=(--pin-region '^(x3_v|x3_d|x3_tag|x3_cr|ea_v|ea_kind|ea_addr|ea_cr|eq_v|eq_d|ar_v|ar_d|ar_cr|dc_v|dc_d|dc_cr|dh_v|dh_d|dh_cr)(\[|$)=top' --pin-region '^(tx_up|tx_v|tx_flit|rx_v|rx_flit)(\[|$)=bottom' --pin-region '^(clk|rst_n|fault|fault_cause)(\[|$)=left')
INTER='x3_*,ea_*,eq_*,ar_*,dc_*,dh_*,fault*'
