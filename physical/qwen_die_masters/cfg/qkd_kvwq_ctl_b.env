# redesign-qwen 2026-10-09: KV-die landing write queue CONTROL tile (ot_qkvd_kv_wq_ctl): posted-row pin capture (W), the
# QD-row queue, head bookkeeping, one registered feed port per quarter group (E), return pin flops.  Variant b.
TOP=ot_qkvd_kv_wq_ctl
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_wq_tiles.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=()
FW=259.2
FH=432.0
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(kvw_v|kvw_vg|kvw_t|kvw_layer|kvw_d|kvw_cr)(\[|$)=left' --pin-region '^(f_v|f_d|f_sec|f_lane|f_tag|r_v|r_bad)(\[|$)=right' --pin-region '^(rw_v|rw_id|fault)(\[|$)=bottom')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=8
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr
export OT_MULTI_VT=lvt
