# redesign-qwen 2026-10-09: tree-top CONTROL tile (ot_qfd_tt_ctl = ot_qfd_sp_tree_top minus the upper levels): the band
# words never enter it; AMR 1 (argmax top registered at the accumulator: tree_top_b am_idx -> am_idx 1.5-2.3 ns), SPRE 1
# (scale request registered one edge before use, balanced-OR ring read: pretag -> scale_addr 1.8 ns), output stations
# on the synchronised reset (rst_n -> u_os 600 ps of wire), IS / OS pin stations, pin flops at the pins.  ME issue /
# status + VM faces on the S side (toward the VM / SU / sequencer), selects to the upper tiles N, port-element faces W/E.
# Variant a: 777.6 x 1296.0.
TOP=ot_qfd_tt_ctl
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_tree_top.sv rtl/qwen_sys/redesign_qwen/ot_qfd_tt_split.sv rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_qwen_w12_arith.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv'
PARAMS=(--param W=16 --param IL=8 --param AW=24 --param NW=18 --param GT=6144 --param TG=4 --param SMIN=7 --param SMAX=11 --param TCUT=7 --param XD=105 --param XVM=15 --param ORD=7 --param ACC_LAT=7 --param TREE_LAT=7 --param MUL_LAT=6 --param FAST_ISSUE=1 --param KV_PREP=3 --param SCALE_LAT=6 --param IS=1 --param OS=1 --param LANDED=1 --param BAND=1 --param LNK=0 --param CLNK=0 --param AMR=1 --param SPRE=1)
FW=777.6
FH=1296.0
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(go|ready|idle|i_\w+|wrom_\w+|kv_re|progress|ov|am_\w+|fault|fab_fault|x_\w+|mx_\w+|land_cnt)(\[|$)=bottom' --pin-region '^(t_sel_e|t_tv_e|tr_fault|up_fault)(\[|$)=top' --pin-region '^(p_\w+)(\[|$)=left' --pin-region '^(scale_\w+)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

