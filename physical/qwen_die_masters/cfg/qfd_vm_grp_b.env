# el1011-q-sp 2026-10-11 (owner textbook audit classes 1/2/3/4/6 on qfd_sp_vector_memory; main decision: near-square VM slot
# 2,332.8 x 2,073.6, me_en one edge early): the VM BANK-GROUP TILE ot_qfd_vm_grp (VMT = 1), routed once, placed 8x by the VM
# parent (4 rows x 2 columns, pin faces toward a central parent strip; W-column tiles R0, E-column MY).  One tile = 8 copy-0
# row banks (16 x 256x256) + the 3 SU copies' 2 banks each (12 x 1024x256), own clock tree / reset relay / me_en replica;
# every input a pin flop, every output a register; x words through an NPP = 12 FIFO (r5: NRI 2 / NRX 2 / NRS 1 in-tile wire relays) (push on the clock, pop on engine edges).
# Production params: NRB 64 / NRBS 16 / ELEMS 177,808 -> DEPTH 174 (LAW 8), DEPTHS 695 (LAWS 10), RV 1 (NPP = RV + 6).
# Signals M2-M6, VDD/VSS exposed as M6 straps (pdn_qkvd_tile_m6.tcl); M7 free for the parent straps (PARENT PDN UPDATE 3).  All pins on the E face (M4 / M6).
# Variant b: 993.6 x 648.0.
TOP=ot_qfd_vm_grp
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_sp_vector_memory_bv.sv rtl/qwen_sys/vm_me_20261008/ot_qfd_res_path.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_vector_memory.sv rtl/hdc/ot_hdc_delay.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param NBK=8 --param NSB=2 --param NSU=3 --param DEPTH=174 --param LAW=8 --param DEPTHS=695 --param LAWS=10 --param USE_MACRO=1 --param NPP=12 --param MEREG=1 --param NRI=2 --param NRX=2 --param NRS=1)
FW=993.6
FH=648.0
PINS=(--pin-region '.*=right')
PIN_H='M4 M6'
PIN_V='M5'
RLAYERS='M2 M6'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_tile_m6.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/vm_grp_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0')
STAGES=synth,pnr
