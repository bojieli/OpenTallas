TOP=ot_qfd_kv_row_endpoint
SRCS='rtl/qwen_sys/system_20261009/ot_qfd_kv_row_endpoint.sv rtl/qwen_sys/system_20261009/ot_qfd_kv_row_arb.sv'
PARAMS=(--param ENABLE=1 --param STACK=0 --param ROW=0 --param DEPTH=8)
FW=96.768
FH=1200.096
PINS=(--pin-region '^h_(v|need|id|data|tile0|tile1|loc0|loc1|sel0|sel1|isk|tail|tail_lanes)(\[|$)=left' --pin-region '^tile_credit_return(\[|$)=left' --pin-region '^(ack_v|ack_data|row_v|row_data)(\[|$)=right' --pin-region '^clk$=top:8-16' --pin-region '^(rst_n|rr|fault)(\[|$)=top:40-88')
INTER='h_*,tile_credit_return,row_*,ack_*'
REFGLOB='*last_id*'
SDCF=die_p770.sdc
PD=0.55
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=64
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
STAGES=pnr
