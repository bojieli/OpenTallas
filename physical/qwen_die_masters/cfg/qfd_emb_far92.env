# Real class split + finite link crossing. Model takeover/far_bus_binding_model.json.
TOP=ot_qfd_link_far_bus
SRCS='rtl/lib/ot_reset_sync.sv rtl/lib/ot_async_fifo.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/qwen_sys/emb_hbm_20261008/ot_qfd_link_far.sv rtl/qwen_sys/emb_hbm_20261008/ot_qfd_link_far_bus.sv'
PARAMS=(--param ENABLE=1)
FW=92.016
FH=1401.84
PINS=(--pin-region '^(hub_i)(\[|$)=left' --pin-region '^(hub_o)(\[|$)=right' --pin-region '^(emb_i|emb_o)(\[|$)=top' --pin-region '^(kv_i|kv_o)(\[|$)=bottom' --pin-region '^(ck|lclk|rst_n|fault)(\[|$)=left')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=lclk
PD=0.55
NC=16
MACROS=()
# Actual rx ingress523*128; generic memory cap must admit its real shape.
EXTRA=(--orfs-var SYNTH_MEMORY_MAX_BITS=66944)
STAGES=synth,pnr
ROUTE_PERIOD_NS=0.770
QDMD=/src/physical/qwen_die_masters/mc/qfd_emb_far92
SDCF=plain.sdc
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2
