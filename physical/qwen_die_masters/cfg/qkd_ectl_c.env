# kv-die 2026-10-09 re-cut H: the near-HBM row engine CONTROL tile (ot_qwen_nearhbm_ectl_h: boundary, request generator, row / e
# FIFOs, issue, pend / arm, local-tree decisions, score tags / running max, node beat tags, S1 + 2 x S1b), a hard sub-tile between
# the head tiles 1 and 2.  Variant c (648 x 108: the measured 24.5 k um2 control logic; t0 / ts0 on the S face to heads 0 / 1, t1 / ts1 on the N face to heads 2 / 3).
TOP=ot_qwen_nearhbm_ectl_h
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_stack_h.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param HD=128 --param R=8 --param E=0)
FW=648.0
FH=108.0
PINS=(--pin-region '^(t0_|ts0_)[a-z]*(\[|$)=bottom' --pin-region '^(t1_|ts1_)[a-z]*(\[|$)=top' --pin-region '^(req_|rsp_|clk|rst_n)[a-z_]*(\[|$)=left' --pin-region '^(start_in|T_in|cyc8_in|q_valid_in|q_beat_in|q_data_in|exp_done|er_|sc_|lmax|nb_|k_done|v_done|fault|ev_)[a-z_0-9]*(\[|$)=right')
INTER='*'
REFGLOB='*start_in*'
SDCF=die_p770.sdc
PD=0.35
NC=16
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var SYNTH_MEMORY_MAX_BITS=262144 --orfs-var GPL_TIMING_DRIVEN=0)
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
