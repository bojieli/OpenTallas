FH=1000.08
PINS=(--pin-region '^(clk|rst_n|po_me_clk)$=top' --pin-region '^(pi_|h_start|tp_|kv_|me_mem|vm_rq|c_ready|r_|pw_|dw_).*=left' --pin-region '^(?!(c_ready|vm_rq|po_me_clk))(po_|s_|seq_|core_|coll_|su_|kvd_|me_clk_en|vm_|c_|rom_).*=right')
INTER='*'
