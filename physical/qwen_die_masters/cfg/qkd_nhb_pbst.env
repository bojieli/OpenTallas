# el1011-q-kvd 2026-10-11: hardened sub-tile ot_nhb_pbst of the attention hub (ot_qwen_nearhbm_attn_hub_t.sv; textbook-audit
# rebuild of ot_qwen_nearhbm_attn_hub_p).  Own clock tree + ot_rst_relay, pin flops in, registered out.  Layer
# contract: routes M2-M6, power on M6 (parent owns M7).
TOP=ot_nhb_pbst
SRCS='rtl/hdc/nearhbm/ot_nhb_tiles.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_hub_p.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_delay.sv rtl/lib/ot_rst_relay.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=()
FW=124.2
FH=118.8
PINS=(--pin-region '^(pdata|pv|pgi|pbeat)(\[|$)=bottom' --pin-region '^(sr)(\[|$)=top' --pin-region '^(clk|rst_n|ra)(\[|$)=left')
INTER='none_*'
REFGLOB='*pv_b*'
SDCF=die_p770.sdc
PD=0.50
NC=8
PIN_H='M4 M6'
PIN_V='M5'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 10.8 10.8 --orfs-var PLACE_DENSITY_LB_ADDON= --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkd_nhb_pbst_place.tcl --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_tile_m6.tcl --routing-layers M2 M6)
# el1011-q-kvd 2026-10-11: route_master's --routing-layers ${RLAYERS:-M2 M7} came after EXTRA and overrode its 'M2 M6', so the
# first views routed signals on M7 (parent strap layer). Layer contract via RLAYERS; PINKO = pin-access keepout.
RLAYERS='M2 M6'
PINKO=1
# el1011-q-kvd 2026-10-11 22:10: qkd_nhb_pbst-a-87a8d98ac-ka (and -ko) crashed GPL-0305 in 3_3 global place: core 20,781 um2 for
# 7,788 um2 of macros + 549 um2 of cells (40% util, 4.9% movable), and PD 0.50 never applied -- PLACE_DENSITY_LB_ADDON 0.05 set
# target 0.1075, so with M2-M6 only (no M7) the routability inflation loop could not drive overflow below 0.125 and diverged.
# Floorplan to ~58% util, aspect 1.05: 151.2x145.8 -> 124.2x118.8, halo 20.16 -> 10.8, macro gap 20.52 -> 10.8; LB_ADDON
# cleared so PD 0.50 is the target (as tools/w18/channel.py).  Pin density 520/124.2 = 4.2 b/um on M5 (cap ~10).
