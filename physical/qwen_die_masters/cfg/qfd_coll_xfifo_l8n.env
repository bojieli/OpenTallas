# el1011-q-coll 2026-10-11 THROUGHPUT (owner 10-10 rule): l8m + CQ_AD 128 (cq body ot_sram_1r1w2c_128x516_m1, RRES 132).  At PIPE 2 the
# ckd return-space reservation (RRES 68) bound the stream: AR256 358 vs priced 318 cycles (1.126).  CQ_AD 128: 318 / layer
# 574 (<= priced 318 / 584), argmax latency +8.
# el1011-q-coll 2026-10-11 TEXTBOOK REBUILD (class 1 + 6) of qfd_coll_xfifo_l8: the l8 routes put ck 36,222 / ckd 14,259
# sinks on single roots (50,318 flops; cq async FIFO 64 x 516 alone ~33k) at util 0.31 / 0.20, and the hold ECO padded 49,656
# buffers.  Both CDC FIFO bodies are now dual-clock 1R1W register-file macros (tools/mem_compiler 1r1w2c:
# ot_sram_1r1w2c_128x516_m1 cq, ot_sram_1r1w2c_16x546_m1 sq; write port on the writer's clock, registered read on the
# reader's), PIPE 2 (RSEL2 read timing, kept pin relays, output pin stations), ~11k flops left.  Outline 270.0 x 270.0 at ~50 %
# util, macros centred with >= 25 um channels (xfifo_m_place.tcl), pin bands aligned with each channel's macro.

TOP=ot_qwen_die_coll_xfifo
SRCS='rtl/physical/ot_qwen_die_coll_xfifo.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/physical/ot_qwen_async_fifo_w.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv rtl/lib/ot_hdly.sv physical/asap7_memory_macros/ot_sram_1r1w2c_128x516_m1/ot_sram_1r1w2c_128x516_m1_bb.v physical/asap7_memory_macros/ot_sram_1r1w2c_16x546_m1/ot_sram_1r1w2c_16x546_m1_bb.v'
PARAMS=(--param CR=8 --param ENG_IB=8 --param LCR=8 --param PIPE=2 --param MEMM=1 --param CQ_AD=128)
FW=270.0
FH=270.0
PINS=(--pin-region '^(i_seq_coll|i_seq_coll_v|i_seq_coll_cr)(\[|$)=left:140-260.0' --pin-region '^(o_coll_seq|o_coll_seq_v|o_coll_seq_cr)(\[|$)=left:10-130.0' --pin-region '^(o_seq_coll|o_seq_coll_v|o_seq_coll_cr)(\[|$)=right:140-260.0' --pin-region '^(i_coll_seq|i_coll_seq_v)(\[|$)=right:10-130.0' --pin-region '^(ck|ckd|rst_n|fault_ck|fault_ckd)$=top:10-260.0')
INTER='*'
REFGLOB='*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_coll_xfifo
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w2c_128x516_m1 physical/asap7_memory_macros/ot_sram_1r1w2c_16x546_m1)
EXTRA=(--macro-view ot_sram_1r1w2c_128x516_m1=physical/asap7_memory_macros/ot_sram_1r1w2c_128x516_m1 --macro-view ot_sram_1r1w2c_16x546_m1=physical/asap7_memory_macros/ot_sram_1r1w2c_16x546_m1 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/xfifo_m_place.tcl)
STAGES=pnr
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=1
export OT_PIN_BALANCE_H="M4 M6"
export OT_PIN_BALANCE_V="M5 M7"
