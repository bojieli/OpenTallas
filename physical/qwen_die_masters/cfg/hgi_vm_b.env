# hgi-takeover 2026-10-09: the HGI-1 vector memory hard view (ot_hgi_vm_unit NC 8: ECC VM core, 64 macros, 8 packet
# client stations) in its 1399.656 x 1080 low spine slot (r2: was 885.6, util 65.7 % > 60 % at FLOORPLAN_MARGIN; NC 8 = the full single-CP client set) (tools/hgi_die_dispatch.py HGI_VM_SLOT).
TOP=ot_hgi_vm_unit
SRCS='rtl/hbm_accel/generic/vm/ot_hgi_vm_unit.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_core.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param NC=8 --param WP=1)
FW=1399.656
FH=1080.0
PINS=(--pin-region '^(cq|cr|status|wq|wq_done)(\[|$)=top:20-1380' --pin-region '^(clk|rst_n)$=bottom:680-720')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*h_v*'
SDCF=die_p770.sdc
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_vm_place.tcl)
STAGES=pnr

# PPL-0107 (submit lint, 0cbe85eef refused: ordered cq|cr|status group 1,855 pins): bounded groups on two layers; layout only
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
PIN_H='M4 M6'
PIN_V='M5 M7'
