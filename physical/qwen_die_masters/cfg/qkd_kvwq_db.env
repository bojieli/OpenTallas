# redesign-qwen 2026-10-09: qkd_kvwq_db = ot_qkvd_kv_wq_dist (distributed successor: per-quarter-group feed F1 + group head + return R1; +3 cycles a row, posted) on the qkd_kvwq_a strip; pin flops FIRM at their pins (io_flop_at_pins.tcl, released for DPL). f7e45bead EF -639: one central head row fed all 32 PCs' output flops across the 1,296-um face. Variant b: 259.2-um wide strip, PD 0.45 (room for the 4 feed copies between the queue and the PC flops).
TOP=ot_qkvd_kv_wq_dist
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_wq_dist.sv'
PARAMS=(--param HD=128 --param NPC=32 --param QD=4 --param TAGW=9)
FW=259.2
FH=1296.0
PINS=(--pin-region '^(kvw_|rw_|fault)[a-z_0-9]*(\[|$)=left' --pin-region '^(w_|wd_)[a-z_0-9]*(\[|$)=right' --pin-region '^(clk|rst_n)(\[|$)=top')
INTER='kvw_*,rw_*,w_*,wd_*,fault'
REFGLOB='*kvw_v*'
SDCF=die_p770.sdc
PD=0.45
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
