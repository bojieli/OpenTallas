# hbm-phys-1010 [idx] (R25GQ, lead decision 10-10): attention-root -> SU lane relay station (529 b, one register,
# i W / o E at the attention half's 'o' pin rows y 2.412..103.788, 4-track pitch = 0.192 um), 60 per die
# (tools/hbm_att_su_relay.py -> physical/hbm_accel_die_views/att_su_relay/relays_r25gq.json).
TOP=hfd_att_su_relay
SRCS='physical/hbm_accel_die_views/att_su_relay/rtl/hfd_att_su_relay.sv'
PARAMS=()
FW=43.2
FH=108
PINS=(--pin-region '^i(\[|$)=left:2.4-103.8' --pin-region '^o(\[|$)=right:2.4-103.8' --pin-region '^(ck|rst)(\[|$)=bottom:18-26')
PIN_H='M4'
PIN_V='M5'
PIN_MIN_TRACKS=4
INTER='*'
REFGLOB='*'
CLKPORT=ck
PD=0.30
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
