# New distinct RSO master. Existing closed WS cfg/view stays intact.
# These are intrinsic source0 child candidates, not native phase/pin adoption.
source physical/qwen_die_masters/cfg/engc_ws_b.env
TOP=ot_engc_t_ws_rso
SRCS='rtl/dsrom_sys/engram/rso_candidate/ot_engc_t_ws_rso.sv rtl/dsrom_sys/s81_ctrl/ot_s81_secded.sv'
PINS+=(--pin-region '^rso$=right:112-118')
QDMD=/src/physical/s81_engc_tiles/rso_closure
SDCF=child_mean.sdc
ROUTE_PERIOD_NS=0.833333
