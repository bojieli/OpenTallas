# el1011-q-kvd-head 2026-10-11 (owner textbook audit: qkd_rhead class 1 = one clock root over 198,881-207,978 sinks;
# class 3/5 = hid strap pin -> 1,024 q enables, nb_d -> far pin): HARDENED SUB-TILE ot_qkh_lane8 of the hierarchical
# head ot_qwen_nearhbm_head_hs (16 a head): 8 lanes (product, lane adder + loop, local P.V lanes, q slices), K levels
# 1-3, own reset relay, pin flops in / registered out.  ~12.5k flops, 129.6 um square (variant b, ~60 % std util).
# Layer contract: routes M2-M6, power pins M6 (pdn_qkh_sub.tcl); the head owns M7.
TOP=ot_qkh_lane8
SRCS='rtl/lib/ot_rst_relay.sv rtl/hdc/nearhbm/ot_qkh_subtiles.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param ADD_LAT=7)
FW=129.6
FH=129.6
PINS=(--pin-region '^(c_in|row_in|e_in|lt_in|hid|bsel|q_valid_in|q_beat_in|q_data_in)(\[|$)=bottom' --pin-region '^(kp|kpv|nb|gf)(\[|$)=right' --pin-region '^(clk|rst_n)(\[|$)=left')
INTER='*'
REFGLOB='*qv3*'
SDCF=die_p770.sdc
PD=0.62
NC=16
PIN_H='M4'
PIN_V='M5'
STAGES=synth,pnr
PIN_MIN_TRACKS=2
MACROS=()
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var GPL_TIMING_DRIVEN=0 --orfs-var MAX_ROUTING_LAYER=M6 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkh_sub.tcl)
