# emb-hbm 2026-10-08 (r21c, NOT YET ROUTED: design review REVIEW_QUEUE.md "EMB-HBM" first): ot_qwen_die_hub_emb_top =
# the full-rate hub (qfd_hub_fr) + the EMB link class (EMB heads wait for the gateway; FETCH broadcast and BOOT_WR /
# BOOT_END routing on the tx side) + the embedding gateway ot_qfd_emb_gw + the SU embedding face (ea 26 b in, ea_cr,
# eq 512 b + valid out, pin flops both ways).  ~+5.5 k flops on qfd_hub_fr's ~0.27 M: frame +1 % each side.
TOP=ot_qwen_die_hub_emb_top
SRCS='rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_pkg.sv rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_gw.sv rtl/qwen_sys/emb_hbm_20261008/ot_qwen_die_hub_emb.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=()
FW=567.216
FH=567.216
PINS=(--pin-region '^l2_(i|o)(\[|$)=right:5.4-84.4' --pin-region '^x3_(v|d|tag|cr)(\[|$)=right:87.1-163.4' --pin-region '^ar_(v|d|cr)(\[|$)=right:166.1-242.3' --pin-region '^l3_(i|o)(\[|$)=right:245.0-324.0' --pin-region '^l0_(i|o)(\[|$)=right:326.7-439.7' --pin-region '^l1_(i|o)(\[|$)=right:442.4-555.4' --pin-region '^(ea_v|ea_kind|ea_addr|ea_cr)(\[|$)=left:20-80' --pin-region '^(eq_v|eq_d)(\[|$)=left:300-560' --pin-region '^(ck|fck0|fck1|fck2|fck3|rst_n|fault|fault_cause.*|emb_ready|emb_fault|emb_fault_code.*)$=top:136.1-408.4')
INTER='*'
REFGLOB='*ard_q*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_hub_fr
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
