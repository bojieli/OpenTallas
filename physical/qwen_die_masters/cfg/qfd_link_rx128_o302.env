# DRIVE-1358 2026-10-08: qfd_link_rx128 at a 302.4 um outline (~55% placement util vs 77.5% at 259.2; the 259.2 run hit 97.2% after
# 146,408 HM-50 CTS hold buffers -> DPL-0033).  STAGES=pnr: host Yosys 0.68 asserts (modules_.count) on paramod ot_async_fifo.
# Far-end receive endpoint of the FULL-RATE link (gate link_credit_rtt, claude/qwen-contracts-20261007): one
# ot_qwen_die_cdc_ch W=523 IBUF=128 OCRED=8 AD=8 = the strip-side (qfd_kvc) receive buffer that the hub's 128 link
# credits require (predecessor IBUF 4).  Routed standalone to price the area the strip endpoint grows by; data in on
# the W face, out on the E face, clocks/resets/faults on the top face.
TOP=ot_qwen_die_cdc_ch
SRCS='rtl/physical/ot_qwen_die_cdc_ch.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=(--param W=523 --param IBUF=128 --param OCRED=8 --param AD=8)
FW=302.4
FH=302.4
PINS=(--pin-region '^(i_v|i_d|i_cr)(\[|$)=left:4-298' --pin-region '^(o_v|o_d|o_cr)(\[|$)=right:4-298' --pin-region '^(wclk|rclk|wrst_n|rrst_n|w_fault|r_fault)$=top:60-240')
INTER='*'
REFGLOB='*od_q*'
CLKPORT=rclk
QDMD=/src/physical/qwen_die_masters/mc/qfd_link_rx128
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=pnr
# the 128 x 523 receive buffer (66,944 bits) is a flop memory by design: lift the ORFS synth memory cap
export OT_SYNTH_MEMORY_MAX_BITS=262144
