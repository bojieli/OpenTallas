# emb-hbm 2026-10-08 (r21c, NOT YET ROUTED: design review first): the per-stack strip embedding engine (ot_qfd_emb_strip,
# core clock) as a stand-alone route vehicle; on the die it sits in the qfd_kvc frame beside the strip-end link endpoint
# and taps the 32 PC landing words there.  ~41 k flops (32 x 4 x 258-b return FIFOs dominate).  Its 32 x 258-b return
# inputs (8.3 k pins) set the frame: two faces, M4/M5.
TOP=ot_qfd_emb_strip
SRCS='rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_pkg.sv rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_strip.sv'
PARAMS=()
FW=414.72
FH=414.72
PINS=(--pin-region '^(e_v|e_d)(\[|$)=left' --pin-region '^(s_m|s_we|s_bank|s_col|s_row|s_cr|w_m|w_d)(\[|$)=right' --pin-region '^(i_v|i_d|i_cr|o_v|o_d|o_cr)(\[|$)=bottom' --pin-region '^(clk|rst_n|fault|fault_code|ce_cnt|ue_info)(\[|$)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
