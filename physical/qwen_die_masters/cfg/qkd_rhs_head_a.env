# el1011-q-kvd-head 2026-10-11: the HIERARCHICAL head tile ot_qwen_nearhbm_head_hs (successor of qkd_rhead /
# ot_qwen_nearhbm_head_h, same ports, opt-in KVD_HSUB): 16 hardened ot_qkh_lane8 (qkd_rhs_l8_a views, 140.4 um) as a 4 x 4
# array + 1 ot_qkh_ktree (qkd_rhs_kt views) centred in the S band (qkh_head_place.tcl: 21.6 um channels, 43.2 um off the
# W / S / E pin faces).  The head itself holds only flops: S2 pin flops, 2 relay stages a sub-tile (kept copies, every
# hop <= ~350 um), 2 on the K partials, 2 on the node slice, 1 on the score.  ~13k flops on its own tree.
# Pins M4 / M5 only (die mirror legality: the die places heads MX).  Layer contract: sub-tiles M2-M6, head owns M7.
TOP=ot_qwen_nearhbm_head_hs
SRCS='rtl/lib/ot_rst_relay.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_head_hs.sv rtl/hdc/nearhbm/ot_qkh_subtiles_bb.v'
PARAMS=(--param HD=128 --param H=0)
FW=712.8
FH=842.4
PINS=(--pin-region '^(c_in|row_in|e_in|lt_in|hid|q_valid_in|q_beat_in|q_data_in|sc_d|sc_f|g_f)(\[|$)=bottom' --pin-region '^(nb_d)(\[|$)=right' --pin-region '^(clk|rst_n)(\[|$)=left')
INTER='*'
REFGLOB='*qv2*'
SDCF=die_p770.sdc
PD=0.50
NC=16
PIN_H='M4'
PIN_V='M5'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/qwen_die_masters/views/qkd_rhs_l8_a physical/qwen_die_masters/views/qkd_rhs_kt)
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var GPL_TIMING_DRIVEN=0 --macro-view ot_qkh_lane8=physical/qwen_die_masters/views/qkd_rhs_l8_a --macro-view ot_qkh_ktree=physical/qwen_die_masters/views/qkd_rhs_kt --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkh_head.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkh_head_place.tcl --orfs-var QKH_SW=140.4 --orfs-var QKH_KW=151.2 --orfs-var QKH_KH=129.6 --orfs-var QKH_CH=21.6)
