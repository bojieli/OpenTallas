# el1011-hbm-idx 2026-10-11: the production 8-wide IDX.TOPK engine, HIERARCHICAL (textbook audit): 8 hardened heap tiles
# ot_hgi_topk_heap_tile (closed hgi-idx-topk-tile-a-f87bdf90d: TT +78.3 / FF +0.9 ps, DRC 0; 260 x 260 um, own clock tree)
# as macros + 8 reverse-buffer SRAMs + the front end (survivor FIFOs, registered max-root tournament) and the pipelined
# 2-way merge tree (r5).  1450 x 1450 um, 20.16-um macro channels.
TOP=ot_hgi_idx_topk_wreg
SRCS='physical/hgi_idx_topk_w8h/ot_hgi_topk_heap_tile_bb.v rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param ENABLE=1 --param IW=8 --param W=8)
FW=1450
FH=1450
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-1440' --pin-region '^in_.*(\[|$)=left:8-1440' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-1440')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*q_id*'
PD=0.50
NC=16
MACROS=(physical/hgi_idx_topk_w8h/views/ot_hgi_topk_heap_tile physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_hgi_topk_heap_tile=physical/hgi_idx_topk_w8h/views/ot_hgi_topk_heap_tile --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/hgi_idx_hier/pdn_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/hgi_idx_topk_w8h/place.tcl)
STAGES=pnr
