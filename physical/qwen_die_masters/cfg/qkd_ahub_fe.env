# hardcore-1010 fe-h (2026-10-10): qkd_ahub_b + ANR=1 (attention hub FP32 adders as ot_hdc_fp32_add_lat_nr: valid-only cut resets + HSPLIT). qkd_ahub_b-eafd37271 TT -1.67 / FF -25.11 (3,857 hold pins on the adders' zero-logic cut hops; routed with the pre-eee75ddd7 LVT corner bug). Bit-identical, 0 cycles.
TOP=ot_qwen_nearhbm_attn_hub_p
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_hub_p.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=(--param HD=128 --param ANR=1)
FW=648
FH=648
PINS=(--pin-region '^(si_|pi_)[a-z_]*(\[|$)=bottom' --pin-region '^(mo_)[a-z_]*(\[|$)=left' --pin-region '^(out_|start|fault|ev)[a-z_]*(\[|$)=top' --pin-region '^(clk|rst_n)(\[|$)=right')
INTER='si_*,pi_*,mo_*,out_*,start,fault,ev*'
REFGLOB='*_b*'
SDCF=die_p770.sdc
PD=0.50
NC=16
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var SYNTH_MEMORY_MAX_BITS=262144)
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
