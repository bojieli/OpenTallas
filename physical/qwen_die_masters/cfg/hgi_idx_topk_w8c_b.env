# el1011-hbm-idx 2026-10-11 r6: the production 8-wide IDX.TOPK as ONE hard cluster ot_hgi_idx_topk_w8_cluster (owner glue
# placement): hub glue (pipelined, registered seams: lane relays, status AND tree, F2 compare, FD 16, merge relay nodes,
# registered SRAM ports, result skid) + 8 hard heap tiles (closed r1 views f87bdf90d, PG M5 -> hard_m5 grid) on the S/N edges,
# SRAMs + hub logic in the middle band.  1300 x 1120 um, 20+ um channels, 8.64-um grid.
TOP=ot_hgi_idx_topk_w8_cluster
SRCS='physical/hgi_idx_topk_w8h/ot_hgi_topk_heap_tile_bb.v rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_w8_hub.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=()
FW=1300
FH=1120
PINS=(--pin-region '^(clk|rst_n|cmd_.*|in_.*)(\[|$)=left:300-820' --pin-region '^(out_.*|done|error)(\[|$)=right:300-820')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*q_r*'
PD=0.45
NC=16
MACROS=(physical/hgi_idx_topk_w8h/views/ot_hgi_topk_heap_tile physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_hgi_topk_heap_tile=physical/hgi_idx_topk_w8h/views/ot_hgi_topk_heap_tile --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/hgi_idx_hier/pdn_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/hgi_idx_topk_w8_cluster/place.tcl)
STAGES=pnr
