# el1011-ds-misc/engram 2026-10-11: bank-1 PAIR TILE of the all-tile dsfd_engram_c (replaces the 691 um T_PBB, class 1;
# spec el1011-ds-misc.log 'PHYSICAL SPEC bank-1 PAIR CHAIN').  HEAD (P0): write + transit in on the N face straight from T_WS above.  2 SRAM stacked, 233.28 x 120.96 (~58% util).
# Variant a: PD 0.45.  Own clock tree (ck), every input a pin flop (rd_in: one OR into the out flop), every output a flop.
TOP=ot_engc_t_pth
SRCS='rtl/dsrom_sys/engram/tiles/ot_engc_pt.sv rtl/v41rom/ot_v41_kreg.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
PARAMS=()
FW=233.28
FH=120.96
CLKPORT=ck
SDCF=die_p770_ck.sdc
PINS=(--pin-region '^(wi_oh|wi_a|wi_d|xi_d)(\[|$)=top:4-228' --pin-region '^(pos|ck|rst)(\[|$)=top:229-232' --pin-region '^rd_in(\[|$)=left:86-114' --pin-region '^(rqo_oh|rqo_a)(\[|$)=left:115-119' --pin-region '^(wo_oh|wo_a|wo_d)(\[|$)=right:2-40' --pin-region '^xo_d(\[|$)=right:42-84' --pin-region '^r_d(\[|$)=right:86-114' --pin-region '^(rq_oh|rq_a)(\[|$)=right:115-119')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*wa_p*'
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view_sram.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/s81_engc_tiles/pt_place.tcl)
STAGES=pnr
