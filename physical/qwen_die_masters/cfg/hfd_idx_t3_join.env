# hbm-phys-1010 [idx] (R25GQ 12-lane grid): three-tap join + 12 -> 16 lane gearbox (the unchanged 610 b native score
# boundary to hfd_idx_sel), top-right corner of the slot: taps / tap_credit on the W / bottom faces (from the slot's E
# channel), s / sc / fault on the top face (die net to the selector).
TOP=hfd_idx_t3_join
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_t3_join.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv'
PARAMS=()
FW=432
FH=216
PINS=(--pin-region '^(taps|tap_credit)(\[|$)=left:10-206' --pin-region '^(s|sc|fault)(\[|$)=top:10-422' --pin-region '^(ck|rst)$=bottom:200-220')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*'
CLKPORT=ck
PD=0.50
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
