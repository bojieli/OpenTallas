# el1011-hbm-hcvm/vm 2026-10-11: ot_hgi_vm_btile (hard bank tile of ot_hgi_vm_tunit at the die config: NC 9, 3 read + 3 W2
# lane groups, LQ 32), variant b: 464.4 x 553.23 um, PD 0.40.  5 macros in one left column (hgi_vm_place_bt_b.tcl), every input
# in a pin flop, every output a flop; faces: right = down tree + DMA line (gi, lanes, w_*: 2,813 pins), top = the bank's
# lanes (rq_in, rr, w2q_in, events, credits: 1,674), bottom = return to the group merge (u_*), clk, rst_n, bid.
TOP=ot_hgi_vm_btile
SRCS='rtl/lib/ot_hdly.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_btile.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=()
FW=464.4
FH=553.23
PINS=(--pin-region '^(gi|lanes|w_hit|w_row|w_enc|w_wm)(\[|$)=right:10-543.23' --pin-region '^(rq_in|rr|w2q_in|rqh_v|rqh_m|rq_cr|w2h_v|w2h_m|w2q_cr|w2q_done)(\[|$)=top:47.0-454.4' --pin-region '^(u_v|u_c|u_d|u_ce|u_ue|bid|clk|rst_n)(\[|$)=bottom:47.0-454.4')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*wh_q*'
SDCF=die_p770.sdc
PD=0.40
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_vm_place_bt_b.tcl --step-tcl PRE_FLOORPLAN=physical/qwen_die_masters/hdly_dont_touch.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
