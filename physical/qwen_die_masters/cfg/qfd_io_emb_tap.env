# qwen-rtl-finish 2026-10-07: qfd_io_embedding_rom column tap (ot_qfd_emb_tap: one registered hop of the request chain
# down / response chain up beside each bank parent, 4-entry request FIFO, bank credits); a corridor-width element.
TOP=ot_qfd_emb_tap
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_io_embedding_rom.sv'
PARAMS=(--param LT=9)
FW=52.68
FH=86.4
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(d_\w+|p_\w+)(\[|$)=top' --pin-region '^(n_\w+|u_\w+)(\[|$)=bottom' --pin-region '^(b_\w+|fault)(\[|$)=left')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
