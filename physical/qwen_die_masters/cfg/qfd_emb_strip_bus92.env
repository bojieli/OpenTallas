# Full 32-PC physical buses; source model takeover/real_ports_binding_model.json.
TOP=ot_qfd_emb_strip_bus
SRCS='rtl/qwen_sys/emb_hbm_20261008/synth/ot_qfd_emb_strip.sv rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_strip_bus.sv'
PARAMS=(--param ENABLE=1 --param STK=0)
FW=92.016
FH=2000.16
PINS=(--pin-region '^ret[0-9]+=left' --pin-region '^cmd[0-9]+=right' --pin-region '^(link_i|link_o)=bottom' --pin-region '^(clk|rst_n|fault|ce_cnt|ue_info)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr

# Qualified against the actual implemented clock domain; async FIFOs are instantiated in the die/bench.
ROUTE_PERIOD_NS=0.770
QDMD=/src/physical/qwen_die_masters/mc/qfd_emb_strip_bus92
SDCF=plain.sdc

# Bind the two planned access layers and prevent one-track local clustering.
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2

# Explicit alternating per-pin layers; all ports on a face share one placement interval.
export OT_PIN_GROUP_MAX=1
export OT_PIN_BALANCE_H="M4 M6"
export OT_PIN_BALANCE_V="M5 M7"
