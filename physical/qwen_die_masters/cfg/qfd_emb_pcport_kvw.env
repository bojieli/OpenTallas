# sys-takeover 2026-10-09: qfd_hbm_ecc_provider = ot_qfd_emb_pcport KVW=1 (KV write side-band encoder + 4-entry KV write FIFO,
# +1,152 flops); outline 116.64 -> 150.12 um, KV write data on the bottom face with wd.
# emb-hbm 2026-10-08 (r21c, NOT YET ROUTED: design review first): per-PC embedding port in the controller band
# (ot_qfd_emb_pcport): RD class FIFO (32), SECDED72 x4 decode in two registered stages, encode of the static write data
# into a 4-entry FIFO; HBM controller clock (1.024 ns).  ~2.6 k flops.
TOP=ot_qfd_emb_pcport
SRCS='rtl/qwen_sys/emb_hbm_20261008/synth/ot_qfd_emb_pcport.sv'
PARAMS=(--param KVW=1)
FW=150.12
FH=150.12
PINS=(--pin-region '^(col_v|col_we|col_sr|r_v|r_d)(\[|$)=right' --pin-region '^(wd|kw_v|kw_d)(\[|$)=bottom' --pin-region '^(w_v|w_d|em_v|em_d)(\[|$)=left' --pin-region '^(kv_v|kv_d)(\[|$)=top' --pin-region '^(clk|rst_n|fault)$=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr

# Qualified against the actual implemented clock domain; async FIFOs are instantiated in the die/bench.
ROUTE_PERIOD_NS=0.960
QDMD=/src/physical/qwen_die_masters/mc/qfd_emb_pcport
SDCF=plain.sdc
