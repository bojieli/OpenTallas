# Per-PC decoder only, not a replacement for the complete KVC master.
TOP=ot_qwen_kvc_decode_pc
SRCS='rtl/physical/ot_qwen_kvc_decode_pc.sv'
PARAMS=(--param ENABLE=1)
FW=328.32
FH=370.44
PINS=(--pin-region '^i_(v|data|sec|expected|pos|row|layer|count|limit|active|done)(\[|$)=right:8-362' --pin-region '^o_(v|data|tile0|tile1|loc0|loc1|sel0|sel1|n|isk|tail|bad|drop|tail_lanes)(\[|$)=left:8-362' --pin-region '^(clk|rst_n|i_cr|o_cr|fault)$=top:8-320')
INTER='*'
REFGLOB='*data0*'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
