# hgi-takeover (Claude 2026-10-09): compact outline. 7c38 at 600x240 was 1.3% utilised (~1.8k um2 of cells in 140k um2): the read_word -> state -> enable loop crossed long buffered wires (wire10324..10321, 170 ps slew) for -430. c0c RTL unchanged; 180x140 second outline (looser pins, ~6% util).
TOP=ot_hgi_coll_row_formatter
SRCS='rtl/hbm_accel/generic/collective/ot_hgi_coll_row_formatter.sv'
PARAMS=(--param ENABLE=1)
FW=180
FH=140
PINS=(--pin-region '^(start_v|group_size|owner_block|destinations|row_count|row_words|context_rows|id_v|id|read_r|response_v|response_data|response_written|out_r|done_r)(\[|$)=left:4-136' --pin-region '^(start_r|id_r|read_v|read_owner|read_local_row|read_word|response_r|out_v|out_data|out_index|out_word|out_destinations|done_v|fault)(\[|$)=right:4-136' --pin-region '^(clk|rst_n)(\[|$)=bottom:4-176')
INTER=''
REFGLOB='*read_owner*'
SDCF=die_p770.sdc
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
