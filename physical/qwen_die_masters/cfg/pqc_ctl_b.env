# el1011-ds-misc/pqc 2026-10-11: hardened sub-tile of the DS-ROM PQ spine screen (v15 hierarchical spine,
# physical/s81_pq_hier).  T_CTL: op slots, loader, stream-ROM reader, streamer, beat control, row totals, return config master (R16 screen params).
# Variant b: 160 x 150 um.  Own clock tree and reset relay; datapath unreset; seams register to register.
# PDN = the view contract (s81_ph_views/common/pdn_view.tcl: M7 PG pins) so the composition's M8 grid connects M7-M8.
TOP=ot_pqc_t_ctl16
SRCS='physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv physical/s81_pq_hier/pinned/physical/dsrom_field_spine/ot_v41_pqc_tile_tops.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_spine_pqc_w17w10.sv'
PARAMS=()
FW=160
FH=150
PINS=(--pin-region '^(go|i_ph|i_np|i_xbase|i_xps|i_obase|i_ops|i_fmt|x_rv|f_fault|clk|rst_n|o_ready|o_idle|o_x_re|o_x_addr|o_fault|o_ev)(\[|$)=top:4-156' --pin-region '^(rom_pa0|rom_pa1|rom_pq0|rom_pq1|rom_sa|rom_sq)(\[|$)=left:4-146' --pin-region '^(aq_vin|aqf|aqi_o|ba_v_o|ba_blk_o|hw_o|h_hi_o|h_b0_o|h_b1_o)(\[|$)=right:4-146' --pin-region '^(mdr_o|q2f_i|ga_i|bc_hr_o)(\[|$)=bottom:4-156')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*q_ph*'
PD=0.55
NC=16
MACROS=()
EXTRA=( --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
