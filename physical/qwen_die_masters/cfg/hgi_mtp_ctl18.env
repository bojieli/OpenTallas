# Generic HGI-1 token18 full endpoint; fixed top avoids parameterized-top assertion.
TOP=hgi_mtp_ctl18_route
SRCS='rtl/hbm_accel/generic/hgi_mtp18_route_tops.sv rtl/hbm_accel/generic/ot_hgi_mtp_ctl18.sv rtl/hdc/ot_hdc_accept.sv rtl/hdc/ot_hdc_prefix.sv rtl/gpu/dshbm/ot_dshbm_accept_port.sv physical/hbm_mtp/rtl/ot_dshbm_dspark_ctl_m.sv'
PARAMS=()
FW=180
FH=140
PINS=(--pin-region '^(clk|rst_n)$=top:55-125' --pin-region '^(start|cfg_gamma|cfg_force|cfg_ngen|cfg_plen|p_tok|f_tok|cmd_ready|eng_done|am_v|am_idx|n)(\[|$)=left:5-135' --pin-region '^(p_addr|f_addr|e_v|e_tok|e_idx|done|cmd_v|cmd_op|cmd_idx|cmd_ncol|cmd_pos|cmd_tok1|cmd_toks|n_set|n_val|tw_v|tw_pos|tw_tok|step_v|step_a|step_g|steps|cyc_total|cyc_engine|cyc_markov)(\[|$)=right:5-135')
INTER='*'
REFGLOB='*u_ctl*'
FALSE_FROM='rst_n'
PIN_H='M4 M6'
PIN_V='M5 M7'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=pnr
