# redesign-qwen 2026-10-10 (kv-die 04:05 per-PC leaf, adopted): ot_qkvd_kv_wq_leaf -- one per landing CDC (32 a stack), abutting
# the CDC's c face (W: w_* out, w_room / wd_* in, pin flops), chained down the landing column (N: feed in + done out, S: feed out +
# done in, registered hops at the 379-um CDC pitch), lane strap E.  Variant a: 86.4 x 183.6.
TOP=ot_qkvd_kv_wq_leaf
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_wq_tiles.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=()
FW=86.4
FH=183.6
PINS=(--pin-region '^(clk|rst_n|lane)(\[|$)=right' --pin-region '^(w_v|w_sec|w_data|w_tag|w_room|wd_v|wd_tag)(\[|$)=left' --pin-region '^(c_v|c_d|c_sec|c_tag|c_lane|dp_v|dp_bad)(\[|$)=top' --pin-region '^(n_v|n_d|n_sec|n_tag|n_lane|dn_v|dn_bad)(\[|$)=bottom')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n,lane'
CLKPORT=clk
PD=0.40
NC=8
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

