# el1011-ds-misc/pqc 2026-10-11: hardened sub-tile of the DS-ROM PQ spine screen (v15 hierarchical spine,
# physical/s81_pq_hier).  T_IX: BF16 x-buffer partition kl in [4g,4g+3] + 16 read lanes (~5.6k flops); xw on top, controls left, bt_d bottom.
# Variant c: 86.4 x 86.4 um.  Own clock tree and reset relay; datapath unreset; seams register to register.
# PDN = the view contract (s81_ph_views/common/pdn_view.tcl: M7 PG pins) so the composition's M8 grid connects M7-M8.
TOP=ot_pqc_t_ix
SRCS='physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv physical/s81_pq_hier/pinned/physical/dsrom_field_spine/ot_v41_pqc_tile_tops.sv'
PARAMS=()
FW=86.4
FH=86.4
PINS=(--pin-region '^(xw)(\[|$)=top:4-82.4' --pin-region '^(par|ba_v|ba_blk|h_hi|hw7|clk|rst_n)(\[|$)=left:4-82.4' --pin-region '^(bt_d)(\[|$)=bottom:4-82.4')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*ba_hi*'
PD=0.55
NC=16
MACROS=()
EXTRA=( --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
