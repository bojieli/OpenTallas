# el1011-hbm-idx 2026-10-11: ONE indexer head x ONE key as a hardened slice (ot_hdc_v41x_idx_hslice; textbook audit classes
# 1+2 on the flat chunk): systolic column element -- every input on the north edge (pin flops), every output on the south
# edge (registered), so 8 slices stack into a chunk column.  160 x 120 um, PD 0.50, own clock tree.
# 10-11 ~19:00 PREAMBLE UPDATE 3: signals + pins M2-M6 only (M7 free over the slice so the chunk parent's M7 straps via onto its M6 power pins; chunk-h 8d848821f PDN-0233 = slice M7 signal OBS).
TOP=ot_hdc_v41x_idx_hslice
SRCS='rtl/hdc/v41x/ot_hdc_v41x_idx_hslice.sv rtl/lib/ot_rst_relay.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv'
PARAMS=(--param NB=4 --param FPL=7 --param FML=5 --param QL=5)
FW=160
FH=120
PINS=(--pin-region '^(clk|rst_n|hid|first|ql_.*|k_key|cs_in|cf_in)(\[|$)=top:4-156' --pin-region '^(qo_.*|ko_key|cs_out|cf_out)(\[|$)=bottom:4-156')
PIN_H='M4 M6'
PIN_V='M5'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
INTER=''
REFGLOB='*key_p*'
PD=0.50
NC=16
MACROS=()
EXTRA=()
RLAYERS='M2 M6'
STAGES=synth,pnr
