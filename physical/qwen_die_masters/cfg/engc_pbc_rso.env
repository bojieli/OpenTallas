# New distinct RSO master. Existing closed PBC cfg/view stays intact.
# These are intrinsic source0 child candidates, not native phase/pin adoption.
source physical/qwen_die_masters/cfg/engc_pbc_b.env
TOP=ot_engc_t_pbc_rso
SRCS='rtl/dsrom_sys/engram/rso_candidate/ot_engc_pbank_rso.sv rtl/v41rom/ot_v41_kreg.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
PINS+=(--pin-region '^rso$=left:182-188')
QDMD=/src/physical/s81_engc_tiles/rso_closure
SDCF=child_mean.sdc
ROUTE_PERIOD_NS=0.833333
