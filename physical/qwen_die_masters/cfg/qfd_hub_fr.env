# FULL-RATE successor of qfd_hub (gate link_credit_rtt, claude/qwen-contracts-20261007): ot_qwen_die_hub_fr_top =
# the r21 hub with link credits CR=128 (remote receive buffer 128 x 523 b a link, >= the measured 117/119-cycle credit
# round trip of the 54/55-station forwarded link), per-link 8-word output FIFOs, 8-word x3 skid, 6-bit native fault
# cause.  Same pins/order as qfd_hub (E face, scaled to the frame) + fault_cause on the top face; same multi-clock kit.
# Frame 561.6 x 561.6 (predecessor 412.536: +0.1452 mm2) for ~0.27 M added flops at <= 55-60 % util.
TOP=ot_qwen_die_hub_fr_top
SRCS='rtl/physical/ot_qwen_die_hub_fr.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=()
FW=561.6
FH=561.6
PINS=(--pin-region '^l2_(i|o)(\[|$)=right:5.4-84.4' --pin-region '^x3_(v|d|tag|cr)(\[|$)=right:87.1-163.4' --pin-region '^ar_(v|d|cr)(\[|$)=right:166.1-242.3' --pin-region '^l3_(i|o)(\[|$)=right:245.0-324.0' --pin-region '^l0_(i|o)(\[|$)=right:326.7-439.7' --pin-region '^l1_(i|o)(\[|$)=right:442.4-555.4' --pin-region '^(ck|fck0|fck1|fck2|fck3|rst_n|fault|fault_cause.*)$=top:136.1-408.4')
INTER='*'
REFGLOB='*ard_q*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_hub_fr
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
