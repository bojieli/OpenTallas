# Dedicated same-edge transit address/mask flops; old masters preserved.
source physical/qwen_die_masters/cfg/engc_pbb_rso.env
TOP=ot_engc_t_pbb_rso_xt
SRCS='rtl/dsrom_sys/engram/rso_candidate/ot_engc_pbank_rso_xt.sv rtl/v41rom/ot_v41_kreg.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
EXTRA+=(--step-tcl POST_IO_PLACEMENT=physical/s81_engc_tiles/rso_closure/pbb_xt_place.tcl)
# The transit copies sit at E. Their original N-left address/mask pins caused
# a 565ps input transport chain; put those fourteen inputs beside the actual
# same-edge transit outputs. Internal SRAM copies retain normal D/feedback checks.
# This is a new standalone pin recipe, not a native slot-pin assignment.
PINS[1]='^w_d(\[|$)=top:8-150'
PINS+=(--pin-region '^(w_oh|w_a)(\[|$)=right:4-30')
# Apply the same registered-port rule to the already dedicated320-bit data
# transit. Keep input and output bits on the same E band; no new data edge.
PINS[3]='^x_d\[([0-9]|[1-5][0-9]|6[0-3])\]=right:4-30'
PINS+=(--pin-region '^x_d\[(6[4-9]|[7-9][0-9]|[1-3][0-9][0-9])\]=right:30-88')
