# el1011-q-coll 2026-10-11 TEXTBOOK REBUILD (class 1 / 4 / 6) of qfd_io_collective (pr2m = pr2t + MEMM): the routed
# pr2_pf had clk 119,632 sinks on one root over a 756 x 756 um core at util 0.145; ~70k of them were the 4 x 32 x 546
# receive-FIFO flops.  Each source FIFO body is now a single-clock 1R1W macro (ot_sram_1r1w_32x546_m1) read at level-1
# timing into the PR = 2 head slices; outline 450 x 450 (~55 % util), macro column beside the rx face (icoll_m_place.tcl).
# Residual class 1: the 3 x 16 LAT-7 adder lanes + skew lines (~45k sinks) stay on one root -> lane-slice sub-tiles next.
# el1011-q-coll 2026-10-11 qfd_io_collective STRUCTURAL boundary (pr2t = pr2_pf + TXK / FPIPE / HDLO): pr2_pf-7f5522d03-f9a routed
# TT -63.6 = 141 tx_rec ports over 11 wire levels (txrec_q merged with the interior lpq: one flop per bit for the pin AND the
# local FIFO, so it could not be anchored at the right-face pins) -> TXK 1 own keep_hierarchy pin register; -31.5 err -> fault
# (16-lane OR, 12 levels) -> FPIPE 1 registered reduce-error fault (+1 edge on fault only); FF -18.0 on 318 out_data ports ->
# HDLO HB4 delay stage on out_* (TT setup on that class >= +60).  Bench: tools/qwen_coll_margin_bench.py --margin 5.
# safe-qwen S-A3 (2026-10-08, REVIEW_20261008 A3): PR=2: hv / pop / refill reach every (source, 128-b slice) through a 2-level
# registered fanout tree of keep_hierarchy leaves (the PR=1 copies were merged by Yosys: only g_r[0].g_k[0] survived in
# 6_final.v of _pr-f5c360282, so hv[0] fanned out to every head bit: SS -709 hv[0] -> hdk); slice registers act one edge
# later and the s0 consumers are re-timed (+1 cycle per collective word); rst_n reaches only per-region reset synchronisers.
# qwen-blocks qfd_io_collective_pr: replicated pop per (source, slice), slice-local head refill / s0 capture, registered local push, enable-free tx_rec (PR=1)
# r21 master qfd_io_collective: its collective ENGINE ot_rom_oneshot_die_m (MARGIN form of ot_rom_oneshot_die: pin
# registers, registered FIFO heads, ADD_LAT 7 binary32 adders, credit local port), N 4, RANK 0 (every rank has the
# same structure), DEPTH 32 (DEPTH 16 lost ~19% throughput to the longer credit round trip: bench reduce_320w 2,098 -> 2,505 cycles; DEPTH 32 1,308 -> 1,320).  Routed in a 760 x 760 um frame (owner <= 1 mm block rule; ~66k um2 of cells would sit at
# ~2 % in the 2,302 x 1,564 um reservation): the die-top places it inside the IO-band collective reservation.
TOP=ot_rom_oneshot_die_m
SRCS='rtl/rom/ot_rom_oneshot_die_m.sv rtl/rom/ot_coll_fold_slice.sv rtl/rom/ot_coll_rst_leaf.sv rtl/lib/ot_hdly.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1/ot_sram_1r1w_32x546_m1_bb.v'
PARAMS=(--param N=4 --param RANK=0 --param LANES=16 --param TAGW=32 --param DEPTH=32 --param ADD_LAT=7 --param IB=4 --param PR=2 --param TXK=1 --param FPIPE=1 --param HDLO=${OT_HDLO:-0} --param MEMM=1)
FW=450.0
FH=450.0
PINS=(--pin-region '^(in_valid|in_cr|in_data|in_last|in_mode|in_tag)(\[|$)=bottom:15-215' --pin-region '^(out_valid|out_data|out_last|out_rank|out_err)(\[|$)=bottom:230-435' --pin-region '^(tx_valid|tx_rec|tx_ready|cr_in|cr_out)(\[|$)=right:15-140' --pin-region '^(rx_valid|rx_rec)(\[|$)=right:150-440' --pin-region '^(clk|rst_n|fault|fault_code)(\[|$)=top:150-300')
INTER='*'
REFGLOB='*s0_v*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1)
EXTRA=()
# ORFS performs real mapped synthesis; omit the redundant host Yosys0.68 screen
# whose cached paramod frontend asserts for the full LAT7 hierarchy.
STAGES=pnr
# safe-qwen SQ-9 (reviewer 2026-10-08 ~22:20): two-layer pin spread (route_master PIN_H/PIN_V, be5b56d78): the faces hit
# FLOORPLAN_MARGIN at 20.5-20.8 b/um on M4 alone; M4+M6 / M5+M7 halve the per-layer density.  Layout only, 0 cycles.
PIN_H='M4 M6'
PIN_V='M5 M7'
# fill-9 2026-10-10 (pr2_pf, qfd_io_collective root cause): f6-pd45 routed TT -32.89 = OUTPUT PORTS only (reg->reg +11.45,
# in->reg +41.33) and FF -9.49 led by in_data -> irec_q / od_q -> out_data: the pin registers exist in the RTL but the
# 0.45-PD timing-driven GPL pulls them toward the fold / gather logic, so the flop -> pin wire eats the 0.2 T outside
# budget.  Design standard (handoff section 1): pin flops anchored at their pins -- io_flop_at_pins.tcl places each
# port's launching / capturing flop FIRM at its own pin before GPL, out_flop_release.tcl hands them to DPL.  0 cycles.
EXTRA=(--macro-view ot_sram_1r1w_32x546_m1=physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/icoll_m_place.tcl --step-tcl PRE_FLOORPLAN=physical/qwen_die_masters/hdly_dont_touch.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
