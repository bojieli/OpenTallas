PARAMS=()
FW=859.072
FH=370.44
PINS=(--pin-region '^w_(v|sec|data|tag|room)(\[|$)=left:8-360' --pin-region '^phy_.*=right:8-360' --pin-region '^(cmd|read_credit|sched).*'=top:8-430 --pin-region '^(clk|rst_n|.*fault|stop|quarantine|refresh_.*|epoch_.*|upstream_quiescent)$=bottom:430-850')
INTER='*'
