# qwen-vm-me 2026-10-08: r21m die master qfd_sp_su64_sfu_bv = ot_qfd_sp_su64_sfu_ab with banked-VM ports
# (rtl/qwen_sys/vm_me_20261008/ot_qfd_su_master_bv.sv): per operand a {re0, re1, a0, a1} descriptor (lane 0 / 1
# registers), answers at 1 + VL (VL = 7), lanes at ML = max(IS + OS + CRX, VL) = 7, lane-row writes as {mask, a0, a1,
# data}.  Control IS = OS = 1, constant ROM across the channel, embedding row buffer as ab.  Core clock (r21m: 833.333).
TOP=ot_qfd_sp_su64_sfu_bv
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_su_master_bv.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_su_master.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/ot_hdc_vstream_lane.sv rtl/hdc/ot_hdc_vreduce.sv rtl/hdc/ot_hdc_vstream.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv'
PARAMS=(--param IS=1 --param OS=1 --param VL=7)
FW=777.6
FH=2058.48
PINS=(--pin-region '^(clk|rst_n)$=left' --pin-region '^(i_|go|a_src|tok|ready|idle|obs_|progress|fault|wrom_fault|crom_|ea_|eq_|kv_)(\[|$)=left' --pin-region '^(s_|sw_|red_)(\[|$)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
