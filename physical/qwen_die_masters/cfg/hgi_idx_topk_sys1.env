# redesign-hbm 2026-10-09: SYSTOLIC top-k core (ot_hgi_idx_topk_sys.sv, TS=1), outline sized from the measured 175.5k um2 (e442d85c4) x 2.0 at ~50% util.
TOP=ot_hgi_idx_topk_full
SRCS='rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_sys.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_registered.sv physical/hgi_idx_topk_20261009/ot_hgi_idx_topk_full.sv'
PARAMS=()
FW=900
FH=900
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-890' --pin-region '^in_.*(\[|$)=left:8-890' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-890')
INTER='*'
REFGLOB='*q_id*'
PD=0.50
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=()
EXTRA=()
STAGES=synth,pnr
