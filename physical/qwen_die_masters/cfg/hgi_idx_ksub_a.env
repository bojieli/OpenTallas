# el1011-ds-misc/idx 2026-10-11: HARDENED SUB-TILE of the indexer chunk element = one key lane of an 8-head chunk
# (ot_hdc_v41x_idx_ksub_el: 8 heads x NB 4 block dots + the head chain, FPL 7 / FML 5 / QL 5, ~40k flops).  The chunk
# element ot_hdc_v41x_idx_chunk_el = 4 of these as macros in a row (q-load broadcast along a top channel, key lane g
# straight down into sub-tile g, outputs off the bottom).  Every input is a pin flop, every output a flop.
# Pins: all inputs on the top face, outputs on the bottom face.  Variant a: 290 x 290 um.
TOP=ot_hdc_v41x_idx_ksub_el
SRCS='rtl/hdc/v41x/ot_hdc_v41x_idx_ksub_el.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv'
PARAMS=(--param NB=4 --param FPL=7 --param FML=5 --param QL=5 --param KR=2)
FW=290
FH=290
PINS=(--pin-region '^(hb|ql_v|ql_head|ql_codes|ql_sc|ql_w|k_v|k_kv|k_key)(\[|$)=top:8-282' --pin-region '^(c_v|c_kv|c_sum|c_fault)(\[|$)=bottom:8-125' --pin-region '^(clk|rst_n)$=bottom:140-150')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*rkey*'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
