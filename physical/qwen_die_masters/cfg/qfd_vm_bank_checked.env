# Physical measurement of the protected Qwen VM bank element (VM gates vm_me_service / vm_su_service, stream
# qwen-contracts): ot_qwen_checked_vm_bank_direct_readback DIRECT_READBACK=1 = the CAP1 SECDED adapter + the 4-bank
# masked-visible raw backend (256 x ot_sram_1r1w_512x128_m4_r2c2, 2 MiB) + 32 check macros.  It is the storage element
# every finite-VM option of the committed packages instantiates (the only service priced so far serialises through
# it).  Inputs on the W face, outputs on the E face; manual macro grid physical/qwen_vm_bank/macro_place_vm_bank.tcl.
TOP=ot_qwen_checked_vm_bank_direct_readback
SRCS='rtl/gpu/w6/ot_gpu_w6_secded_pkg.sv rtl/hbm_accel/qwen/vm_direct_readback_20261007/ot_qwen_vm_bank4_direct_readback.sv rtl/hbm_accel/qwen/vm_direct_readback_20261007/ot_qwen_checked_vm_bank_direct_readback.sv rtl/chip/ot_v41_vm_bank4_macro_pipe.sv physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2/ot_sram_1r1w_512x128_m4_r2c2_bb.v'
PARAMS=(--param DIRECT_READBACK=1)
FW=1825.2
FH=1304.64
PINS=(--pin-region '^(rd_v|rd_base_word|rd_owner|wr_v|wr_word_addr|wr_word_data|wr_lane_mask|wr_owner)(\[|$)=left:4-1300' --pin-region '^(rd_accept_v|rd_out_v|rd_out_rot|rd_out_bank_words|rd_out_owner|rd_fault|wr_accept_v|wr_ack_v|wr_ack_owner|wr_ack_word_addr|wr_ack_lane_mask|wr_fault|rw_collision_fault)(\[|$)=right:4-1300' --pin-region '^(clk|rst_n)$=top:780-1000')
INTER=''
REFGLOB='*rd_out_bank_words*'
CLKPORT=clk
SDCF=die_p770.sdc
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_512x128_m4_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_vm_bank/macro_place_vm_bank.tcl --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0')
# --macro-view is a pnr-only option (run_abi3_physical refuses host synth with macro views)
STAGES=pnr
