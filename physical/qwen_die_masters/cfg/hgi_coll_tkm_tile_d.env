# el1011-hbm-idx 2026-10-11 r3: hardened tile of the TOPK_MERGE chain (ot_hgi_coll_tkm_tile, PT 64 positions x 85 b) as a
# TWO-STAGE insertion pipeline (stage C: key compares of the pinned block vs the array and vs the block in flight, compare
# vectors moved through the insertion mux; stage I: count -> decode -> 9:1 insertion mux), elements stored in key form,
# block copies replicated per 8 positions (~12.5k flops, own clock tree).  r2 failed TT -312 ps with compare + count +
# insertion mux in one edge (textbook class 5).  Signals route M2-M6 only: the tile is a hard child whose M6 power pins
# the parent straps from M7 (PDN-0233 rule, preamble UPDATE 3).  340 x 340 um.
TOP=ot_hgi_coll_tkm_tile
SRCS='rtl/hbm_accel/generic/collective/tkm/ot_hgi_coll_tkm.sv'
PARAMS=(--param EW=85 --param PT=64 --param TW=6 --param LW=7)
FW=340
FH=340
PINS=(--pin-region '^(ins_v|ins_b|up_out)(\[|$)=top:8-332' --pin-region '^(ovf_v|ovf_b|up_in)(\[|$)=bottom:8-332' --pin-region '^(clk|tid|clr|conv|tau_t|tau_l|tau_o|busy)(\[|$)=left:8-332')
PIN_H='M4 M6'
PIN_V='M5'
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
INTER='*'
REFGLOB='*p_b*'
PD=0.50
NC=16
MACROS=()
EXTRA=(--routing-layers M2 M6)
STAGES=synth,pnr
