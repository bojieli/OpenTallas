# hardcore-1010 D FALLBACK (2026-10-10, "-cl fb"): qfd_seq_su_bi_a (518.4 x 518.4) + PSRAM=1: the 64 x 1,024 program store (65,536 flops: the bi_a-a15f65288 prog_base -> prog_q 26-level / pw_addr -> prog_mem 20-level classes, and most of the block's hold endpoints) becomes two ot_sram_1r1w_64x512_m1_r2c2 macros (bit-masked 64-bit writes), read at the prog_re edge, output captured in prog_q one edge later = PRL 2 timing (0 cycles). Macros mid-die with 21.6 um between them, halo 12.96, pdn_m5.
# qwen-1010/a: ot_qfd_seq_su_bi = the boundary successor + ICUT (registered readiness) + station resets from the registered tile reset.
# Old route inputs unchanged; adoption also needs E issue/status/S constant-port SU acceptance successor.
# stream unit (2 + 2 stations).  No ME issue / status pins (the ME side runs in qfd_tt_ctlm); the ME snapshot (x_*)
# arrives over the SU <-> tree-top relays.  Pin flops at the pins.  Variant a: 518.4 x 518.4.
TOP=ot_qfd_seq_su_bi
SRCS='rtl/qwen_sys/redesign_qwen/ot_qfd_seq_su_bi.sv rtl/rom/ot_qwen_tp_seq_w12.sv rtl/rom/ot_rom_pkg_link.sv rtl/rom/ot_rom_pkg_ctrl.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param PSRAM=1)
FW=518.4
FH=518.4
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(pi_su_|po_su_|su_tok|su_asrc).*=left' --pin-region '^(x_|me_.*_o|su_.*_o).*=top' --pin-region '^(h_start|tp_|kv_|vm_rq|c_ready|r_|pw_|dw_).*=bottom' --pin-region '^(stage_in|cb_|kvd_).*=bottom' --pin-region '^(?!(c_ready|vm_rq|su_.*_o))(s_|seq_|core_|coll_|vm_|c_|rom_).*=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/seq_su_psram_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

