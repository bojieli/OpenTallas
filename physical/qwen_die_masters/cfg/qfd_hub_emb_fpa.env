# fe-push-qwen-1010 (2026-10-10): qfd_hub_emb with RXS=1 -- each link's 128 x 523 receive buffer (ot_qwen_die_cdc_ch IBUF)
# is 2x ot_sram_1r1w_128x256_m1_r2c2 + 11 remainder bits in flops, on the link's own wclk (the buffer is wholly in that
# domain; the CDC stays the 8-slot Gray-pointer ot_async_fifo with 2-flop synchronisers).  qfd_hub_emb_g700pf-5d5ae8a54
# stalled 4.7 h in global placement (HPWL 1e10, overflow 0.63, 1.57 M nets) on 4 x 66,944 flop bits forced through by
# SYNTH_MEMORY_MAX_BITS=66944: that override is REMOVED.  +2 wclk per word (staged SRAM read, as RXP 1), full rate,
# order / values / credits / faults unchanged (tb_cdc_ch_rxp + emb_hbm e2e exact; RXS 2 and async-pointer mutants FAIL).
# Fixed macro placement hub_emb_rxs_place.tcl.  Variant a: outline 700 (as g700).
TOP=ot_qwen_die_hub_emb_top
SRCS='rtl/qwen_sys/emb_hbm_20261008/synth/ot_qfd_emb_gw.sv rtl/qwen_sys/emb_hbm_20261008/synth/ot_qwen_die_hub_emb.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param RXS=1)
FW=700.002
FH=700.002
PINS=(--pin-region '^l2_(i|o)(\[|$)=right:5.4-84.4' --pin-region '^x3_(v|d|tag|cr)(\[|$)=right:87.1-163.4' --pin-region '^ar_(v|d|cr)(\[|$)=right:166.1-242.3' --pin-region '^l3_(i|o)(\[|$)=right:245.0-324.0' --pin-region '^l0_(i|o)(\[|$)=right:326.7-439.7' --pin-region '^l1_(i|o)(\[|$)=right:442.4-555.4' --pin-region '^(ea_v|ea_kind|ea_addr|ea_cr)(\[|$)=left:20-80' --pin-region '^(eq_v|eq_d)(\[|$)=left:300-560' --pin-region '^(ck|fck0|fck1|fck2|fck3|rst_n|fault|fault_cause.*|emb_ready|emb_fault|emb_fault_code.*)$=top:136.1-408.4')
INTER='*'
REFGLOB='*ard_q*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_hub_emb
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hub_emb_rxs_place.tcl)
STAGES=pnr

ROUTE_PERIOD_NS=0.770
