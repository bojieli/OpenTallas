# hgi-1010/g2 2026-10-10: the IDX.TOPK element of the TOPKW=1 IDX unit = ot_hgi_idx_topk_wreg IW 4 / W 4 (four banked-SRAM
# pipelined heaps r2: two cycles a level, registered grandchild word; 20 1R1W macros; data flops reset-free, rst_n
# through ot_rst_relay; cmd_ready / in_ready / outputs from flops).  1040 x 1040 um.
TOP=ot_hgi_idx_topk_wreg
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param ENABLE=1 --param IW=4 --param W=4)
FW=1040
FH=1040
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-1030' --pin-region '^in_.*(\[|$)=left:8-1030' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-1030')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*q_id*'
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
STAGES=pnr
