# el1011-ds-misc/engram 2026-10-11: ALL-TILE dsfd_engram_c (textbook class 1: no top-level register; physical spec in
# el1011-ds-misc.log 'PHYSICAL SPEC dsfd_engram_c ALL-TILE').  T_WS = west seam: sink write port (N face, aligned with the sink S face) -> encode -> bank 1 + transit (S face); HBM pair W face <-> lookup (S face right end).
# Variant a: PD 0.45.  Own clock tree (clock port ck), every input a pin flop, every output a flop.
TOP=ot_engc_t_ws
SRCS='rtl/dsrom_sys/engram/tiles/ot_engc_t_ws.sv rtl/dsrom_sys/s81_ctrl/ot_s81_secded.sv'
PARAMS=()
FW=388.8
FH=120.96
CLKPORT=ck
SDCF=die_p770_ck.sdc
PINS=(--pin-region '^wr_v$=top:60-72' --pin-region '^wr_addr(\[|$)=top:74-96' --pin-region '^wr_data(\[|$)=top:180-292' --pin-region '^werr$=top:380-386' --pin-region '^(w_oh|w_a|b1_d)(\[|$)=bottom:8-150' --pin-region '^x_d(\[|$)=bottom:152-300' --pin-region '^(lk_hqv|lk_hqa|lk_hqt|lk_hr)(\[|$)=bottom:305-386' --pin-region '^f_hr(\[|$)=left:60-118' --pin-region '^t_hq(\[|$)=left:2-14' --pin-region '^(ck|rst)$=right:108-118')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*wa0*'
PD=0.45
NC=16
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
