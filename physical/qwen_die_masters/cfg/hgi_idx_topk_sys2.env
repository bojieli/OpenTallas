# redesign-hbm 2026-10-09: SYSTOLIC top-k core (ot_hgi_idx_topk_sys.sv, TS=2), outline sized from the measured 175.5k um2 (e442d85c4) x 1.5 at ~50% util.
TOP=ot_hgi_idx_topk_full
SRCS='physical/hgi_idx_topk_20261009/topk_sys_ts2_define.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_sys.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_registered.sv physical/hgi_idx_topk_20261009/ot_hgi_idx_topk_full.sv'
PARAMS=()
FW=760
FH=760
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-750' --pin-region '^in_.*(\[|$)=left:8-750' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-750')
INTER='*'
REFGLOB='*q_id*'
PD=0.50
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=()
EXTRA=()
STAGES=synth,pnr
