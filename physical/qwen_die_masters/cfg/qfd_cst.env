# orphans-2 2026-10-08: qfd_cst (die corridor station, qfd_cst_n/_s, 1,536 copies) moved from jobs/route_station.sh KIND=cst
# onto the generic master flow (route_master.sh: TC + link budget + mm FF hold).  ot_qwen_die_station DW 508 TAP 1 SPLIT 0,
# r20c frame 52.68 x 103.656, a N / b S / tap W.  RTL unchanged (every boundary register-to-register).
TOP=ot_qwen_die_station
SRCS='rtl/physical/ot_qwen_die_station.sv'
PARAMS=(--param DW=508 --param TAP=1 --param SPLIT=0)
FW=52.68
FH=103.656
PINS=(--pin-region '^(a_d|a_r)(\[|$)=top:4-48' --pin-region '^(b_d|b_r)(\[|$)=bottom:4-48' --pin-region '^(t_d|t_r|c_d|c_r|clk|rst_n)(\[|$)=left:8-96')
INTER='a_d*,a_r,b_d*,b_r'
REFGLOB='*br_q*'
SDCF=station_die_p770.sdc
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
