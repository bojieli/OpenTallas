# hbm-hcvm [ll] LANE-LOCAL hfd_hc_eng lane (ot_hgi_hc_lane_ll: HC_POST / HC_PRE_NORM arithmetic in the lane, 32 a slot); was: lane slice (hgi-1010 b, 2026-10-11; hbm-phys: the hardened, replicated element of the FUSED HC engine, 32 a slot):
# VM bank lane (read credits / response router / quad FIFO / P1 buffer / write FIFO), one 64x512 SRAM (the write FIFO).
TOP=ot_hgi_hc_lane_ll
SRCS='rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/v41x/ot_hdc_v41x_vec_red.sv rtl/hdc/v41x/ot_hdc_v41x_sfu.sv rtl/hdc/v41/ot_hdc_fsqrt.sv rtl/hdc/v41/ot_hdc_fdiv.sv rtl/hdc/v41/ot_hdc_actquant.sv rtl/hdc/v41x/ot_dsrom_aq12.sv rtl/hdc/v41x/ot_dsrom_divc.sv rtl/hdc/v41x/ot_dsrom_fp32_add_l6.sv rtl/hdc/v41x/ot_dsrom_su_add6.sv rtl/hdc/v41x/ot_dsrom_su_norm.sv rtl/hdc/v41x/ot_dsrom_su_hcpost.sv rtl/hbm_accel/generic/peers/ot_hgi_hc_eng_ll.sv rtl/hbm_accel/generic/peers/ot_hgi_hc_eng.sv rtl/lib/ot_rst_relay.sv rtl/link/ot_fifo_sram_fwft.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param D=5120 --param LQ=32 --param FD=64 --param MUT=0)
FW=648.0
FH=648.0
PINS=(--pin-region '^(clk|rst_n|lid)(\[|$)=top' --pin-region '^(wrq|wrq_cr)(\[|$)|^wrr\[([0-9]|[1-9][0-9]|1[01][0-9]|12[0-7])\]$=bottom' --pin-region '^wrr\[(12[89]|1[3-9][0-9]|2[0-9][0-9])\]$=bottom' --pin-region '^(wwq_cr|wwq_done)$|^wwq\[([0-9]|[1-9][0-9]|1[0-3][0-9])\]$=right' --pin-region '^wwq\[(1[4-9][0-9]|2[0-7][0-9])\]$=right' --pin-region '^(dn_v|dn_op|dn_x|dn_d)(\[|$)=left' --pin-region '^(up_v|up_t|up_x)(\[|$)|^up_d\[([0-9]|[1-9][0-9]|1[01][0-9]|12[0-7])\]$=left' --pin-region '^(wdone|fin|flt)$|^up_d\[(12[89]|1[3-9][0-9]|2[0-9][0-9])\]$=left')
PIN_H='M4 M6'
PIN_V='M5 M7'
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM=''
CLKPORT=clk
PD=0.45
NC=8
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_hc_lane_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
