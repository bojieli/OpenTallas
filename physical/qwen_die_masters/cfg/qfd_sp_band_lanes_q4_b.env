# redesign-qwen 2026-10-09: band-lane QUARTER tile (ot_qfd_band_lanes NL 4: 4 lanes of levels 8-10 over the band's 8 positions; lanes never
# mix, so the band block is 4 of these side by side, each with its own tw / ty / pw / tt_ty spans). qfd_sp_band_lanes (NL 16, 777.6 x 1131.8)
# stalls CTS hold at -27 with 17 k endpoints; the quarter tile is the same RTL. Variant b: 388.8 x 648.0.
TOP=ot_qfd_band_lanes
SRCS='rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=(--param NL=4 --param LNK=0 --param TREE_LAT=7)
FW=388.8
FH=648.0
PINS=(--pin-region '^(clk)$=top:190-199' --pin-region '^(rst_n|b0)$=top:150-170' --pin-region '^(sel_e|tv_e|fault)(\[|$)=top:16-136' --pin-region '^(tw)(\[|$)=bottom' --pin-region '^(ty|tt_ty|tt_use|tt_v)(\[|$)=left' --pin-region '^(pw|pw_v)(\[|$)=right')
INTER='*'
REFGLOB='*tin_q*'
FALSE_FROM='rst_n,b0'
CLKPORT=clk
PD=0.45
NC=16
MACROS=()
STAGES=synth,pnr
PIN_H="M4 M6"
PIN_V="M5 M7"
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
export OT_MULTI_VT=lvt
# qwen-1010/c 2026-10-10: q4_{a,b}-3b6caa6b2-tc-hm0 both ended DRC 1 = the same M5 spacing clk / sel_e[13] at x 194.42 on the top
# face (the IO placer seated sel_e[13] beside the mid-face clock pin, the clock net's wide M5 then clashes).  The clock pin now owns
# top:190-199 alone, rst_n / b0 sit at 150-170 and the 29 sel_e / tv_e / fault pins at 16-136 (mid-face clock kept).  The sign-off
# SDC is regenerated from the current io_ref_skew (REFGLOB *tin_q* -> median tin_q flop, as the route kit), so the FF hold-repair
# scene and the verdict no longer read the stale first-match tin_q[0] reference.  Layout / constraint only, 0 cycles.
