# mtp-lead 2026-10-09: clk and rst_n in separate top-edge regions (both 4bffda75f routes ended DRC 1 = M5 Metal Spacing rst_n vs clk at (124.92,139.91), pins adjacent in one region); 0 cycles.
# Generic HGI-1 token18 full endpoint; fixed top avoids parameterized-top assertion.
TOP=hgi_mtp_accept18_route
SRCS='rtl/hbm_accel/generic/hgi_mtp18_route_tops.sv rtl/hbm_accel/generic/ot_hgi_mtp_accept18.sv rtl/hdc/ot_hdc_accept.sv'
PARAMS=()
FW=180
FH=140
PINS=(--pin-region '^clk$=top:85-95' --pin-region '^rst_n$=top:30-40' --pin-region '^(start_v|tokx_v|amax_v|acc_v|start_tok|tokx_tok|amax_tok|tokx_slot|amax_slot|acc_g)(\[|$)=left:5-135' --pin-region '^(stok|ttok|acc_done|acc_any|acc_a|n_emit|bonus)(\[|$)=right:5-135')
INTER='*'
REFGLOB='*u_accept*t*'
FALSE_FROM='rst_n'
PIN_H='M4 M6'
PIN_V='M5 M7'
PD=0.48
NC=8
MACROS=()
EXTRA=()
STAGES=pnr
