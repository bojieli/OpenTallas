# redesign-qwen 2026-10-09: option 4 SU side (ot_qfd_seq_su, generated by tools/redesign_qwen/split_ctrl.py emit-seq-su):
# the sequencer (tp_seq + program / descriptor stores) with the SU-side controller and the SU issue shell, placed BY the
# stream unit (2 + 2 stations).  No ME issue / status pins (the ME side runs in qfd_tt_ctlm); the ME snapshot (x_*)
# arrives over the SU <-> tree-top relays.  Pin flops at the pins.  Variant a: 518.4 x 518.4.
TOP=ot_qfd_seq_su
SRCS='rtl/qwen_sys/redesign_qwen/ot_qfd_seq_su.sv rtl/rom/ot_qwen_tp_seq_w12.sv rtl/rom/ot_rom_pkg_link.sv rtl/rom/ot_rom_pkg_ctrl.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv'
PARAMS=()
FW=518.4
FH=518.4
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(pi_|h_start|tp_|kv_|vm_rq|c_ready|r_|pw_|dw_|x_o|x_f).*=left' --pin-region '^(po_|s_|seq_|core_|coll_|su_|vm_|c_|rom_).*=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

