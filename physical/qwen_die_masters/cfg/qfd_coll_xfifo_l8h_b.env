# el1011-q-coll 2026-10-11: qfd_coll_xfifo_l8_b.env + IO hold-delay stage (HDLI / HDLO HB4xp67 per data/valid/credit/fault bit, ot_hdly, dont_touch from
# PRE_FLOORPLAN).  The routed l8 misses are FF hold on the IO class only (reg2reg passes; TT IO setup +146..+205 ps), so the
# boundary gets a deterministic delay stage instead of a ~49.6k-buffer hold ECO.  HDLO is overridable from the job (OT_HDLO).
# sys-takeover lever: CR 8 / ENG_IB 8 / LCR 8 (AR256 318 vs 436 cycles); pin regions widened + per-pin layer balance (acb615a21 PPL-0107)
# sys-takeover 2026-10-09 master qfd_coll_xfifo_b (variant b outline 324 x 540, same RTL / kit): ot_qwen_die_coll_xfifo, the Qwen ROM die's native collective local
# port (registry qfd_native_collective_binding): sq sequencer (ckd) -> collective (ck) 546 b + valid / credits, cq
# collective -> sequencer 516 b + valid / credits, ckd return-space credit gate.  Instantiated by ot_qwen_die_io_xfifo
# NCOLL = 1 (die-top: inside the IO-band CDC slot); routed standalone here.  Multi-clock kit mc/qfd_coll_xfifo.
TOP=ot_qwen_die_coll_xfifo
SRCS='rtl/physical/ot_qwen_die_coll_xfifo.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/physical/ot_qwen_async_fifo_w.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv rtl/lib/ot_hdly.sv'
PARAMS=(--param CR=8 --param ENG_IB=8 --param LCR=8 --param HDLI=${OT_HDLI:-1} --param HDLO=${OT_HDLO:-1})
FW=324.0
FH=540.0
PINS=(--pin-region '^(i_seq_coll|i_seq_coll_v|i_seq_coll_cr)(\[|$)=left:10-264.0' --pin-region '^(o_coll_seq|o_coll_seq_v|o_coll_seq_cr)(\[|$)=left:276.0-530.0' --pin-region '^(o_seq_coll|o_seq_coll_v|o_seq_coll_cr)(\[|$)=right:10-264.0' --pin-region '^(i_coll_seq|i_coll_seq_v)(\[|$)=right:276.0-530.0' --pin-region '^(ck|ckd|rst_n|fault_ck|fault_ckd)$=top:10-314.0')
INTER='*'
REFGLOB='*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_coll_xfifo
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_FLOORPLAN=physical/qwen_die_masters/hdly_dont_touch.tcl)
# el1011-q-coll: the host Yosys screen reads no liberty, so the instantiated HB4xp67 hold-delay cells fail it; ORFS synthesis
# (with the libraries) is the real mapped synthesis -> pnr only, as qfd_io_collective.
STAGES=pnr
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=1
export OT_PIN_BALANCE_H="M4 M6"
export OT_PIN_BALANCE_V="M5 M7"
