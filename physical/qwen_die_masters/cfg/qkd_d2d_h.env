# el1011-q-kvd 2026-10-11: KV end (ot_qkvd_kv_end, HT=1) built from hardened link-buffer tiles: 4 x ot_qkvd_sbuf
# (TX RES/EMBD 48, RX Q/KVN 32) + 3 x ot_qkvd_fbuf8 (TX HCTL 4, RX CTL 4 / EMBQ 8); the parent keeps the link logic
# (~7k flops, one short clock tree), outline 561.6 um (<= 600, was 777.6 x 518.4 at 17 % util), tiles in data-flow
# rows (qkd_d2d_h_place.tcl), PDN pdn_qkvd_parent_m7.tcl (M7 onto the tiles' M6 straps).
TOP=ot_qkvd_kv_end
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_end.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_d2d.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo_sb.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_buf_tiles_bb.v'
PARAMS=(--param QD=48 --param UCX=48 --param HT=1)
FW=561.6
FH=561.6
PINS=(--pin-region '^(t_v|t_d|t_cr|r_v|r_d|r_cr)(\[|$)=bottom' --pin-region '^(tx_up|tx_v|tx_flit|rx_v|rx_flit)(\[|$)=top' --pin-region '^(clk|rst_n|fault|fault_cause)(\[|$)=left')
INTER='t_*,r_*,fault*'
REFGLOB='*ci_v*'
SDCF=die_p770.sdc
PD=0.55
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/qwen_die_masters/views/ot_qkvd_sbuf physical/qwen_die_masters/views/ot_qkvd_fbuf8)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_qkvd_sbuf=physical/qwen_die_masters/views/ot_qkvd_sbuf --macro-view ot_qkvd_fbuf8=physical/qwen_die_masters/views/ot_qkvd_fbuf8 --macro-place-halo 10.8 10.8 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_parent_m7.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkd_d2d_h_place.tcl)
