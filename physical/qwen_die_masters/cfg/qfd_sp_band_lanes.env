# qwen-lane-band 2026-10-08: r21m die master qfd_sp_band_lanes = one band's 16 spine lanes, tree levels 8..10 over the
# band's 8 level-7 positions (rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv ot_qfd_band_lanes, NL 16, LNK 0):
# 112 FP32 tree adders (LAT 7), the level holds, the 20-edge round-trip ring wait, the band-0 tree-top mux (b0 strap:
# one netlist for all 6 bands), pin flops on every input, stations on every output.  r21m slot (BL_H).
TOP=ot_qfd_band_lanes
SRCS='rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=(--param NL=16 --param LNK=0 --param TREE_LAT=7)
FW=777.6
FH=1131.84
PINS=(--pin-region '^(clk|rst_n|b0)$=top' --pin-region '^(sel_e|tv_e|fault)(\[|$)=top' --pin-region '^(tw|ty)(\[|$)=bottom' --pin-region '^(tt_ty|tt_use|tt_v)(\[|$)=left' --pin-region '^(pw|pw_v)(\[|$)=right')
INTER='*'
REFGLOB='*tin_q*'
FALSE_FROM='rst_n,b0'
CLKPORT=clk
PD=0.50
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
