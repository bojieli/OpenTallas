# Independent pin spread / lower-density variant, unchanged fullK2048 RTL.
TOP=ot_hgi_idx_topk_full
SRCS='rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_registered.sv physical/hgi_idx_topk_20261009/ot_hgi_idx_topk_full.sv'
PARAMS=()
FW=640
FH=640
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-630' --pin-region '^in_.*(\[|$)=left:8-630' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-630')
INTER='*'
REFGLOB='*q_id*'
PD=0.55
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=()
EXTRA=()
STAGES=synth,pnr
