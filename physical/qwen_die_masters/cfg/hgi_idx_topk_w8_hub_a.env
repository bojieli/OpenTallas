# el1011-hbm-idx 2026-10-11 r6: hgi_idx_topk_w8_hub -- the glue of the 8-wide IDX.TOPK engine as one hard element (owner:
# two-level hierarchy; the 8 heap tiles ot_hgi_topk_heap_tile sit outside on the north/south faces).  Every seam registered
# both sides; lane relays (phase/k/clear/push) 2 deep, registered status AND tree, merge tree with a relay node on every
# edge, registered reverse-buffer ports + capture flop, result credit skid.  1250 x 440 um, SRAMs 103.7 um inside the lane
# pin edges, 20+ um channels.  Leaf layer contract: signals M2-M6, PG = M7 straps (pdn_hier.tcl), pins M4/M6 + M5.
TOP=ot_hgi_idx_topk_w8_hub
SRCS='physical/hgi_idx_topk_w8h/ot_hgi_topk_heap_tile_bb.v rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_w8_hub.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=()
FW=1250
FH=440
PINS=(--pin-region '^(clk|rst_n|cmd_.*|in_.*)(\[|$)=left:16-424' --pin-region '^(out_.*|done|error)(\[|$)=right:16-424' --pin-region '^t0_.*(\[|$)=bottom:16.00-295.00' --pin-region '^t4_.*(\[|$)=top:16.00-295.00' --pin-region '^t1_.*(\[|$)=bottom:327.04-606.04' --pin-region '^t5_.*(\[|$)=top:327.04-606.04' --pin-region '^t2_.*(\[|$)=bottom:638.08-917.08' --pin-region '^t6_.*(\[|$)=top:638.08-917.08' --pin-region '^t3_.*(\[|$)=bottom:949.12-1228.12' --pin-region '^t7_.*(\[|$)=top:949.12-1228.12')
PIN_H='M4 M6'
PIN_V='M5'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
INTER='*'
REFGLOB='*q_r*'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/hgi_idx_hier/pdn_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/hgi_idx_topk_w8_hub/place.tcl --routing-layers M2 M6)
STAGES=synth,pnr
