# fe-push-hgi-1010 2026-10-10: hgi_idx_t4_join MEM=1 FE=1, variant b: 500 x 420 outline, PD 0.45, queue macros 40 um in from the tap face so the tap pin flops sit FIRM at the pins (io_flop_at_pins).
TOP=hfd_idx_t4_join
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_t4_join.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv rtl/lib/ot_rst_relay.sv rtl/link/ot_fifo_sram_fwft.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param MEM=1 --param FE=1)
FW=500
FH=420
PINS=(--pin-region '^(taps)(\[|$)=left:10-350' --pin-region '^(tap_credit)(\[|$)=left:10-350' --pin-region '^(s|sc|fault)(\[|$)=right:10-350' --pin-region '^(ck|rst)$=bottom:200-220')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='sv sd* tap_credit*'
CLKPORT=ck
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 6 6 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/variant_fill/hgi_idx_t4_join-fe/macro_place_b.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
FALSE_FROM='rst'
