# el1011-q-coll 2026-10-11 22:50 pr2s = pr2c floorplan + IBH 1 (registered look-ahead IB head: the ir -> mux -> 400 ps wire -> u_txk hop is wire only) + FPIPE 2 (agree/ovf faults registered); clock = balanced spine with slice-insertion targets (icoll_spine.tcl via OT_CTS_FIX_HOOKS, job spec).
# el1011-q-coll 2026-10-11 ~20:00 PDT COMPACT CLUSTER (pr2c; owner GLUE PLACEMENT item 2: io_collective is ONE hardened
# hierarchical cluster).  pr2h-8d0cb6a8b-r2 textbook lint: glue clock root 11,318 flops over a 516 x 836 outline (> 600 um),
# util 44.8 %, slice channels 19.8 um (< 20).  pr2c: 529.2 x 642.6 (util ~57 %): slices 2 x 2 -- left column MY (src E,
# sum W), right column R0 (src W, sum E) -- around a 120 um central glue channel (heads / s0 / control), 24 um channels
# everywhere; the 4 FIFO macros 2 x 2 above the slices under the rx pins (top face).  out_data lanes 0-255 leave on the
# left face beside slices 0-1, 256-511 on the right beside slices 2-3; in / clk / fault bottom-centre under the glue.
# Reach: FIFO -> head <= ~400 um, head -> slice src <= ~130 um, slice sum -> od_q <= ~40 um, s0 -> gather -> od_q <= ~300 um.
# el1011-q-coll 2026-10-11 HIERARCHICAL PARENT of qfd_io_collective (pr2h = pr2m + FSL 1): the all-reduce fold is four
# hardened lane slices (ot_coll_fold_slice, closed as qfd_io_collective_fs-b760fc991: TT +231.10 / FF +2.85), consumed as
# macros (abstract LEF + TT/SS/FF timing models in physical/qwen_die_masters/hard/ot_coll_fold_slice); each slice has its
# own clock tree, the parent tree drives ~10k head / s0 / pin registers + 8 macro clock pins (was ~120k sinks flat).
# Outline 520 x 840, slice stack left (MY), 100 um channel, FIFO column right (icoll_h_place.tcl).
TOP=ot_rom_oneshot_die_m
SRCS='rtl/rom/ot_rom_oneshot_die_m.sv rtl/rom/ot_coll_rst_leaf.sv rtl/lib/ot_hdly.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1/ot_sram_1r1w_32x546_m1_bb.v physical/qwen_die_masters/hard/ot_coll_fold_slice/ot_coll_fold_slice_bb.v'
PARAMS=(--param N=4 --param RANK=0 --param LANES=16 --param TAGW=32 --param DEPTH=32 --param ADD_LAT=7 --param IB=4 --param PR=2 --param TXK=1 --param FPIPE=2 --param HDLO=${OT_HDLO:-0} --param MEMM=1 --param FSL=1 --param IBH=1)
FW=529.2
FH=642.6
PINS=(--pin-region '^(out_valid|out_last|out_rank|out_err)(\[|$)=left:30-80' --pin-region '^out_data\[([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\]$=left:90-400' --pin-region '^out_data\[(25[6-9]|2[6-9][0-9]|[34][0-9][0-9]|50[0-9]|51[01])\]$=right:30-400' --pin-region '^(in_valid|in_cr|in_data|in_last|in_mode|in_tag)(\[|$)=bottom:130-240' --pin-region '^(clk|rst_n)$=bottom:250-280' --pin-region '^(fault|fault_code)(\[|$)=bottom:290-320' --pin-region '^(tx_valid|tx_rec|tx_ready|cr_in|cr_out)(\[|$)=right:430-620' --pin-region '^(rx_valid|rx_rec)(\[|$)=top:20-510')
INTER='*'
REFGLOB='*s0_v*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1 physical/qwen_die_masters/hard/ot_coll_fold_slice)
EXTRA=()
STAGES=pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
EXTRA=(--macro-view ot_coll_fold_slice=physical/qwen_die_masters/hard/ot_coll_fold_slice --macro-view ot_sram_1r1w_32x546_m1=physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_icoll_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/icoll_c_place.tcl --step-tcl PRE_FLOORPLAN=physical/qwen_die_masters/hdly_dont_touch.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
