# el1011-q-coll 2026-10-11 TEXTBOOK REBUILD (class 1 residual of qfd_io_collective): the hardened all-reduce LANE SLICE
# ot_coll_fold_slice (rtl/rom/ot_coll_fold_slice.sv rtl/rom/ot_coll_rst_leaf.sv; 4 x 32-bit lanes = 128 bits of each of the N = 4 source words): its
# own skew lines, 3 x 4 LAT-7 binary32 adders, valid chain, partial error OR and reset leaf; registered seams (pin flops
# in, flops out).  ~9.3k registers (the flat engine put ~50k fold registers on one root); the parent (qfd_io_collective,
# FSL = 1) instantiates FW / 128 = 4 of them.  Physical spec: 180 x 180 um at ~50 %, sources in on the left face, the sum
# out on the right, clock / reset top; no path longer than ~180 um; adders are 4 independent lanes.
TOP=ot_coll_fold_slice
SRCS='rtl/rom/ot_coll_fold_slice.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param N=4 --param ADD_LAT=7 --param SEAM=1)
FW=180.0
FH=180.0
PINS=(--pin-region '^(src|red_in)(\[|$)=left:10-170' --pin-region '^(sum|v_out|e_out)(\[|$)=right:30-150' --pin-region '^(clk|rst_n)$=top:60-120')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=()
STAGES=pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
