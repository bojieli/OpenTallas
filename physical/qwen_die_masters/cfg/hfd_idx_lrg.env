# hbm-phys-1010 [idx] (R25GQ 12-lane grid): the stack's line regroup (8 svc line ports -> 6 tap lines a beat, FIFO 64 a
# port, zero-line padding) as the W column of the slot: ik / ikc / q on the W face (die nets from the svc / selector),
# lo / loc / qx on the E face abutting the three stacked taps.  Slot plan: physical/hbm_accel_die_views/index/native_g12.
TOP=hfd_idx_lrg
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_lrg.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv'
PARAMS=(--param FA=6 --param FT=4)
FW=237.6
FH=2419.2
PINS=(--pin-region '^(ik|ikc|q)(\[|$)=left:10-2409' --pin-region '^(lo|loc|qx)(\[|$)=right:10-2409' --pin-region '^(ck|rst|st)(\[|$)=bottom:100-140')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*'
CLKPORT=ck
PD=0.50
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
