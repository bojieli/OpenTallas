# el1011-hbm-hcvm/vm 2026-10-11: ot_hgi_vm_tunit (the HGI VM rebuilt as a floorplanned tile array: hub arbiter + relay
# trees + per-bank tiles + regional reset; rtl/hbm_accel/generic/vm/ot_hgi_vm_btile.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_tunit.sv header has the physical spec).
# Slot 1399.656 x 1080 unchanged, same pin faces as hgi_vm_fba (+ wq_rdy with its lane face, ap_* bottom); macro grid
# hgi_vm_place_ta.tcl (bank lo/hi in one column, banks follow the wq lane faces, channels >= 20 um).
TOP=ot_hgi_vm_tunit
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_btile.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_tunit.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param NC=8 --param WP=32 --param WDIRECT=1)
FW=1399.656
FH=1080.0
PINS=(--pin-region '^(cq|cr|status)(\[|$)=top:20-1379' --pin-region '^(wq\[([0-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-3][0-9][0-9][0-9]|4[0-3][0-9][0-9]|44[0-7][0-9])\]|(wq_done|wq_rdy)\[([0-9]|1[0-5])\])$=left:20-1060' --pin-region '^(wq\[(44[89][0-9]|4[5-9][0-9][0-9]|[5-7][0-9][0-9][0-9]|8[0-8][0-9][0-9]|89[0-5][0-9])\]|(wq_done|wq_rdy)\[(1[6-9]|2[0-9]|3[01])\])$=right:20-1060' --pin-region '^(rq|rq_cr|rr|ap_cr|ap_done)(\[|$)=bottom:20-660' --pin-region '^(w2q|w2q_cr|w2q_done|ap_q)(\[|$)=bottom:740-1379' --pin-region '^(clk|rst_n)$=bottom:680-720')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*q0_v*'
SDCF=die_p770.sdc
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_vm_place_ta.tcl)
STAGES=pnr

# PPL-0107 (submit lint, 0cbe85eef refused: ordered cq|cr|status group 1,855 pins): bounded groups on two layers; layout only
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
PIN_H='M4 M6'
PIN_V='M5 M7'
