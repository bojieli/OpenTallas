# drive-1128 2026-10-08: PINREG=1 variant (r_v / r_d leave through a register at the die-RX pins, +1 cycle a word, OCRED + 1):
# rxd512 failed TT -37.1 only on 7 r_d output ports (flop -> ~440 ps of wire to the right face).
# gaps-design 2026-10-08: qfd_io_serdes adapter at line rate.  RXD 128 -> 512 (credit round trip ~460 FDI cycles at the
# 223-cycle KP4+PCS one-way latency; rate sweep tb_qfd_link_adapter RATE=1: 128 -> 0.290, 256 -> 0.591, 512 -> 1.000
# words/cycle).  The 512 x 1,024 b receive buffer is 8 x ot_sram_1r1w_512x128_m4_r2c2 (SRAM=1) with a capture flop at
# the macro outputs and a 4-entry skid; +3 receive cycles.  Same footprint / pin sides as qfd_io_serdes_adapter.
TOP=ot_qfd_link_adapter
SRCS='rtl/qwen_sys/missing_masters_20261007/ot_qfd_link_adapter.sv rtl/dsrom_sys/s81_ph/ot_s81ph_mem1r1w.sv physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2/ot_sram_1r1w_512x128_m4_r2c2_bb.v'
PARAMS=(--param W=1024 --param RXD=512 --param SRAM=1 --param PINREG=1)
FW=600.048
FH=600.048
PINS=(--pin-region '^(clk|rst_n|fault)$=top' --pin-region '^c_.*=left' --pin-region '^r_.*=right' --pin-region '^(tx_|rx_).*=bottom')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_512x128_m4_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_512x128_m4_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/serdes_rxd512_place.tcl)
STAGES=synth,pnr
