# Full G8 native interface, no tieoffs, replicas=1, exact latency23/II1.
TOP=ot_hgi_quant_decode
SRCS='rtl/hbm_accel/generic/ot_hgi_quant_decode.sv physical/hbm_accel_die_views/common/ot_hfd_oreg1.sv physical/hbm_accel_die_views/quant/rtl/ot_hfd_actquant_m.sv rtl/hdc/v41/ot_hdc_fp4qdq.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat_f12.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=()
FW=1800
FH=600
PINS=(--pin-region '^x\[=left:20-580' --pin-region '^header\[=bottom:20-1780' --pin-region '^y\[=right:20-580' --pin-region '^(clk|rst_n|v|generic_enable|legacy_fp4|vo|fault|decode_fault)$=top:20-1780')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*valid_pipe*'
CLKPORT=clk
PD=0.50
NC=12
MACROS=()
EXTRA=()
STAGES=synth,pnr
