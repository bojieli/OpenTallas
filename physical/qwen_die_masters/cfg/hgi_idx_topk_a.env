# Full K2048 HGI generic topk; FW/FH from prebuild model, final fit pending synthesis.
TOP=ot_hgi_idx_topk_full
SRCS='rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk.sv physical/hgi_idx_topk_20261009/ot_hgi_idx_topk_full.sv'
PARAMS=()
FW=1200
FH=1000
PINS=(--pin-region '^(clk|rst_n)$=top:8-1190' --pin-region '^(cmd_.*|in_.*)(\[|$)=left:8-990' --pin-region '^(out_.*|done|error)(\[|$)=right:8-990')
INTER='*'
REFGLOB='*cells*'
PD=0.45
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=()
EXTRA=()
STAGES=synth,pnr
