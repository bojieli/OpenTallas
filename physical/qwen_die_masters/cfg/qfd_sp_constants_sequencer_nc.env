# sys-takeover 2026-10-09 (registry qfd_native_collective_binding): the generated sequencer master with the NATIVE
# collective face, ot_qfd_sp_constants_sequencer_nc (tools/qwen_missing/emit_partition.py --native-coll; core ctrl
# unchanged, ot_qwen_tp_seq_w12_nc: c_cr / r_cr credits, VM read by returned valid vm_qv).  Recipe = the fqh master
# (FQ_HEAD = 1, die_p770 kit, balanced pins); pin regions follow the face change (c_ready -> c_cr, + vm_qv in, + r_cr out).
TOP=ot_qfd_sp_constants_sequencer_nc
SRCS='rtl/qwen_sys/missing_masters_20261007/gen/ot_qfd_sp_constants_sequencer_nc.sv rtl/qwen_sys/missing_masters_20261007/gen/ot_qwen_rom_core_ctrl.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/rom/ot_qwen_tp_seq_w12_nc.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv rtl/hdc/ot_hdc_delay.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv'
PARAMS=(--param FQ_HEAD=1)
FW=777.6
FH=1000.08
PINS=(--pin-region '^(clk|rst_n|po_me_clk)$=top' --pin-region '^(pi_|h_start|tp_|kv_|me_mem|vm_rq|vm_qv|c_cr|r_valid|r_data|r_last|r_rank|r_err|pw_|dw_).*=left' --pin-region '^(?!(c_cr|vm_rq|vm_qv|po_me_clk))(po_|s_|seq_|core_|coll_|su_|kvd_|me_clk_en|vm_|c_|rom_|r_cr).*=right')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
QDMD=/src/physical/qwen_die_masters/mc/qfd_sp_constants_sequencer_fqh
SDCF=die_p770.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
