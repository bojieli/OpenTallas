# qwen-vm-me 2026-10-08: qfd_sp_vector_memory_bv AGGRESSIVE area variant (777.6 x 7,776, PD 0.42): same RTL, 25 % more slot height
# token bench's behavioural VM has (rtl/qwen_sys/vm_me_20261008/ot_qfd_sp_vector_memory_bv.sv): copy 0 (64 row banks x 2
# ot_sram_1r1w_256x256, the parallel ME x service of qwen-rtl-finish), 3 SU replica copies (16 banks x 2
# ot_sram_1r1w_1024x256 each: the SU's 3 x 64 lanes as fixed-latency descriptor reads, VL = 7), the bank-write arbiter
# (SU lane rows, reducer / sequencer / maxima skid queues, the result merge), the 6:1 ME result merge (CRB 16 credits a
# band), land_cnt / me_ok.  Column M slot 777.6 x 6,220.8 (r21m).
TOP=ot_qfd_sp_vector_memory_bv
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_sp_vector_memory_bv.sv rtl/qwen_sys/vm_me_20261008/ot_qfd_res_path.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_vector_memory.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param USE_MACRO=1 --param XVM=15 --param CRB=16)
FW=777.6
FH=7776.0
PINS=(--pin-region '^(clk|rst_n|me_en)$=top' --pin-region '^(x_dv|x_dc|x_dcs|x_dsp|x_rdy|x_fault|x_hazard|mx_|land_cnt|me_ok)(\[|$)=top' --pin-region '^x_q\[[0-9]*[02468]\]$=left' --pin-region '^x_q\[[0-9]*[13579]\]$=right' --pin-region '^(s_|sw_|rd_|w_|r_|w_fault|w_hazard)(\[|$)=bottom' --pin-region '^rb_(v|end|nul|row|mask|cr|ok)(\[|$)=right' --pin-region '^rb_data\[[0-9]*[02468]\]$=right' --pin-region '^rb_data\[[0-9]*[13579]\]$=left')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.42
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0')
STAGES=synth,pnr
