# hgi-1010/att 2026-10-11: R25 ATT entry stager (lead-approved P1), one per active attention entry on the svc ks<g> ->
# hfd_attn_half_lo.ks route: 2 block buffers x 32 row-words x 576 b (36,864 b flops), tag-addressed writes, row / column
# (transpose) read, arrival-order credit FIFO.  ks_i W face (from the svc), ks_o E face (to the entry tile).
TOP=ot_hgi_att_stager
SRCS='rtl/hbm_accel/generic/att/ot_hgi_att_stager.sv rtl/common/ot_fwd_link_stage.sv'
PARAMS=()
FW=300
FH=300
PINS=(--pin-region '^(ks_i)(\[|$)=left:10-290' --pin-region '^(ks_o)(\[|$)=right:10-290' --pin-region '^(kq_o|bt_i|flt)(\[|$)=top:100-200' --pin-region '^(clk|rst_n)$=bottom:140-160')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='rv* rrow* tv*'
CLKPORT=clk
PD=0.55
NC=16
MACROS=()
EXTRA=(--orfs-var SYNTH_MEMORY_MAX_BITS=40000)
STAGES=synth,pnr
