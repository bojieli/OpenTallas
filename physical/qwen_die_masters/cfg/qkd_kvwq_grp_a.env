# redesign-qwen 2026-10-09: KV-die landing write queue QUARTER-GROUP tile (ot_qkvd_kv_wq_grp, x 4 along the landing beside
# its 8 PCs): feed pin flops (W, from the ctl tile), group head, room / write-done of its PCs (pin flops), the 8 PCs'
# output flops (w_data E; w_sec / w_tag / w_v / room / done N and S), registered return report.  Variant a: 172.8 x 324.0.
TOP=ot_qkvd_kv_wq_grp
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_wq_tiles.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=()
FW=172.8
FH=324.0
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(f_v|f_d|f_sec|f_lane|f_tag|r_v|r_bad)(\[|$)=left' --pin-region '^(w_data)(\[|$)=right' --pin-region '^(w_sec|w_v)(\[|$)=top' --pin-region '^(w_tag|w_room|wd_v|wd_tag)(\[|$)=bottom')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.40
NC=8
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

