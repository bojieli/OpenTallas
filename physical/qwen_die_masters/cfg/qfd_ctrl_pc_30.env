# Full JEDEC scheduler PC30; other qfd_ctrl services are separate, unclosed leaves.
TOP=ot_qwen_ctrl_pc
SRCS='rtl/physical/ot_qwen_ctrl_pc.sv rtl/model_ready_hbm_r14/ot_hbm_r14_stream_pc.sv'
PARAMS=(--param ENABLE=1 --param PC=30)
FW=247.536
FH=370.44
PINS=(--pin-region '^cmd(_v)?(\[|$)=left:8-180' --pin-region '^(read_credit|cmd_credit)(\[|$)=left:185-360' --pin-region '^(row|col)_.*=right:8-360' --pin-region '^(clk|rst_n|busy|fault)$=top:8-240')
INTER='*'
REFGLOB='*cmd_q*'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
