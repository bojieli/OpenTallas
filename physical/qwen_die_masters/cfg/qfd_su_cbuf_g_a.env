# redesign-qwen 2026-10-09: ONE 8-lane group of the SU-local constant buffer (ot_qfd_su_cbuf_g: its SRAM 30 um under the N fill face,
# its lanes' answer pipeline, its own copy of the deterministic prefetcher, lane-base strap), replicated x 8 along the SU's
# N face.  Exact as 8 copies (tb_qfd_crom_lbuf GRPS=1).  Variant a: 194.4 x 216.0.
TOP=ot_qfd_su_cbuf_g
SRCS='rtl/qwen_sys/redesign_qwen/ot_qfd_crom_lbuf.sv rtl/hdc/ot_hdc_delay.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=()
FW=194.4
FH=216.0
PINS=(--pin-region '^(clk|rst_n)$=left' --pin-region '^(crom_re|crom_addr|crom_stage|crom_q)(\[|$)=bottom' --pin-region '^(f_re|f_addr|f_stage|f_q|f_fault)(\[|$)=top' --pin-region '^(stage|tok_start|tpos|grp|st_rdy|st_rdy_stage|fault|fault_code)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/su_cbuf_g_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr

