# el1011-ds-misc/engram 2026-10-11: ALL-TILE dsfd_engram_c (textbook class 1: no top-level register; physical spec in
# el1011-ds-misc.log 'PHYSICAL SPEC dsfd_engram_c ALL-TILE').  T_WIN = window / all-gather tile above the lookup (S face pins at the lookup N pin x + 5.616), die pins N (t_ag at the top-left end: the sink blocks the W face below y409), T_IO seams E.
# Variant b: PD 0.6.  Own clock tree (clock port ck), every input a pin flop, every output a flop.
TOP=ot_engc_t_win
SRCS='rtl/dsrom_sys/engram/tiles/ot_engc_t_win.sv'
PARAMS=()
FW=327.888
FH=47.52
CLKPORT=ck
SDCF=die_p770_ck.sdc
PINS=(--pin-region '^lk_wv$=bottom:20-30' --pin-region '^lk_wid(\[|$)=bottom:45-76' --pin-region '^lk_wcred$=bottom:82-92' --pin-region '^lk_rel(\[|$)=bottom:92-104' --pin-region '^lk_ov$=bottom:105-113' --pin-region '^lk_oc(\[|$)=bottom:114-124' --pin-region '^lk_ob(\[|$)=bottom:124-131' --pin-region '^lk_os(\[|$)=bottom:131-140' --pin-region '^lk_od(\[|$)=bottom:190-250' --pin-region '^lk_ocred$=bottom:300-310' --pin-region '^lk_stv$=bottom:310-315' --pin-region '^lk_sts(\[|$)=bottom:315-321' --pin-region '^lk_stb$=bottom:321-326' --pin-region '^(lk_fault|cfg_o|rn_lk|werr_i)(\[|$)=bottom:1-14' --pin-region '^f_win(\[|$)=top:28-48' --pin-region '^t_collective$=top:55-62' --pin-region '^f_agc$=top:25-27' --pin-region '^ck$=top:186-192' --pin-region '^rst$=top:193-198' --pin-region '^t_ag(\[|$)=top:1-24' --pin-region '^(s_rdy|s_perr|vrel_o|rn_sk)(\[|$)=left:39-46' --pin-region '^(rdy_o|perr_o|vrel_i|cfg_i|jn_i|wn_o|jf_o|werr_o)(\[|$)=right:4-44')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*wid_q*'
PD=0.6
NC=16
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
