# el1011-ds-misc/pqc 2026-10-11: hardened sub-tile of the DS-ROM PQ spine screen (v15 hierarchical spine,
# physical/s81_pq_hier).  T_IX: BF16 x-buffer partition kl in [4g,4g+3] + 16 read lanes (~5.6k flops); xw on top, controls left, bt_d bottom.
# Variant a: 96 x 96 um.  Own clock tree and reset relay; datapath unreset; seams register to register.
TOP=ot_v41_pqc_ix
SRCS='physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv'
PARAMS=(--param KMAX=256 --param VRD=64)
FW=96
FH=96
PINS=(--pin-region '^(xw)(\[|$)=top:4-92' --pin-region '^(par|ba_v|ba_blk|h_hi|hw7|clk|rst_n)(\[|$)=left:4-92' --pin-region '^(bt_d)(\[|$)=bottom:4-92')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*ba_hi*'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
