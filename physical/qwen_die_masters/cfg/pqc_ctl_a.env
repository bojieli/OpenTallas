# el1011-ds-misc/pqc 2026-10-11: hardened sub-tile of the DS-ROM PQ spine screen (v15 hierarchical spine,
# physical/s81_pq_hier).  T_CTL: op slots, loader, stream-ROM reader, streamer, beat control, row totals, return config master (R16 screen params).
# Variant a: 130 x 130 um.  Own clock tree and reset relay; datapath unreset; seams register to register.
TOP=ot_v41_pqc_ctl
SRCS='physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_spine_pqc_w17w10.sv'
PARAMS=(--param PHW=6 --param SAW=8 --param R=16 --param VAW=19 --param VRD=64 --param KMAX=256 --param BST=2 --param PQ=1 --param XRV=1 --param XCAP=16)
FW=130
FH=130
PINS=(--pin-region '^(go|i_ph|i_np|i_xbase|i_xps|i_obase|i_ops|i_fmt|x_rv|f_fault|clk|rst_n|ready|idle|x_re|x_addr|fault|phase_cycles|ev_go|ev_end|ev_tag)(\[|$)=top:4-126' --pin-region '^(rom_pa0|rom_pa1|rom_pq0|rom_pq1|rom_sa|rom_sq)(\[|$)=left:4-126' --pin-region '^(aq_vin|aqf|aqi_o|ba_v_o|ba_blk_o|hw_o|h_hi_o|h_b0_o|h_b1_o)(\[|$)=right:4-126' --pin-region '^(mdr_o|q2f_i|ga_i|bc_hr_o)(\[|$)=bottom:4-126')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*ld_run*'
PD=0.55
NC=16
MACROS=()
EXTRA=(--orfs-var 'VERILOG_DEFINES=-DSYNTHESIS -DOT_PQ_ROM_PORTS')
STAGES=synth,pnr
