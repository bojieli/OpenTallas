# safe-qwen S-D1 (2026-10-08, REVIEW_20261008 addendum ~21:20): qfd_sp_tree_top_b + AMR=1: the argmax tree's top word and its tag / clear
# registered AT the accumulator (spctl), so am_idx -> 50-b compare -> update is local (d95c2ebddtt: 2,228 ps, 6 logic + ~40
# wire buffers over two ~1 mm legs).  +1 edge on the argmax result (am_any / am_idx / am_val); idle waits for it.
# qwen-band-integrate 2026-10-08: qfd_sp_tree_top_b = ot_qfd_sp_tree_top LANDED 1 + BAND 1: the control element with
# RX = 5 + 2 LNK (element tags / scale requests / results move with the band round trip) and BANDF (band-local result
# positions), plus ot_qfd_band_upper (tree levels 11 / 12 over the 6 band words: 64 FP32 adders LAT 7, pin flops on the
# 6 x 513 band-word bits, the station on the 1,538-bit return to band 0).  LNK / CLNK 0 here (relay stages on the band
# word / control links are die parameters: DLY = OS + CLNK + 2 + LNK).  Replaces qfd_sp_tree_top(_l) in r21m.
TOP=ot_qfd_sp_tree_top
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_tree_top.sv rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_qwen_w12_arith.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv'
PARAMS=(--param W=16 --param IL=8 --param AW=24 --param NW=18 --param GT=6144 --param TG=4 --param SMIN=7 --param SMAX=11 --param TCUT=7 --param XD=105 --param XVM=15 --param ORD=7 --param ACC_LAT=7 --param TREE_LAT=7 --param MUL_LAT=6 --param FAST_ISSUE=1 --param KV_PREP=3 --param SCALE_LAT=6 --param IS=1 --param OS=1 --param LANDED=1 --param BAND=1 --param LNK=0 --param CLNK=0 --param AMR=1)
FW=777.6
FH=3732.48
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(go|ready|idle|i_\w+|wrom_\w+|kv_re|progress|ov|am_\w+|fault|fab_fault)(\[|$)=right' --pin-region '^(x_\w+|mx_\w+|land_cnt)(\[|$)=bottom' --pin-region '^(t_sel_e|t_tv_e|tr_fault|p_\w+|scale_\w+)(\[|$)=left' --pin-region '^(b_pw|b_pv|b_lf)(\[|$)=left' --pin-region '^(tt_ty|tt_use|tt_v)(\[|$)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
