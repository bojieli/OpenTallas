# qwen-1010/b 2026-10-10: the KV-die engine control tile, variant e = c with DQ 128 (64 -> 128 outstanding rows an engine for the
# HBM latency) and the TWO-LEVEL row FIFO: 4 x ot_sram_1r1w_128x256 macros (128 rows x 1,024 b) in front of the 8-row flop level
# (ot_nhb_fifo_rows2_h); K pass in the KV-die stream order (map v2).  Bench: tools/qwen_kv_die/bench_gate.sh with DQ=128.
TOP=ot_qwen_nearhbm_ectl_h
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_stack_h.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param HD=128 --param R=8 --param E=0 --param DQ=128)
FW=648.0
FH=172.8
PINS=(--pin-region '^(t0_|ts0_)[a-z]*(\[|$)=bottom' --pin-region '^(t1_|ts1_)[a-z]*(\[|$)=top' --pin-region '^(req_|rsp_|clk|rst_n)[a-z_]*(\[|$)=left' --pin-region '^(start_in|T_in|cyc8_in|q_valid_in|q_beat_in|q_data_in|exp_done|er_|sc_|lmax|nb_|k_done|v_done|fault|ev_)[a-z_0-9]*(\[|$)=right')
INTER='*'
REFGLOB='*start_in*'
SDCF=die_p770.sdc
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var SYNTH_MEMORY_MAX_BITS=262144 --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl --macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
PIN_H='M4'
PIN_V='M5'
STAGES=pnr
PIN_MIN_TRACKS=2
