# Raw selection then conversion successor: +1 matvec fill edge.
# qwen-tile 2026-10-08: qfd_tile_rp1 + ROM capture registers placed AT the macro pins (rom_cap_at_pins.tcl PRE_GLOBAL_PLACE FIRM, released for DPL by rom_cap_release.tcl). Fixes TT -369 (place) / -284 (CTS) ROM rd_out -> cap with ~460 ps of wire. Placement only, 0 cycles vs qfd_tile_rp1.
# qwen-blocks qfd_tile_rp1: ROM_PIPE=1 ROM_ARELAY=1 LRST=1 (ROM read pipeline: request relays, enable-free capture at the pins, BF16 expansion + group OR stage, relay), ROM clock pin landed 250 ps early by CTS (CTS-only liberty insertion view), macros clustered per pair at CTS.
# r21 master qfd_tile (1,536 tiles in all): ot_qwen_rom_tile_die = W12 ROM tile (10 x ot_rom_4096x266_m8 + 2 x KV SRAM,
# margin RTL MUL_LAT 8 / KV_PREP 4 on ACC 7 / TREE 7 / FAST_ISSUE 1) + landing hop (li left face -> lo right face) + landing
# merge.  Frame 266.952 x 1291.656 (r21 elements.lef), M2-M7 (die M8/M9 over the top).
TOP=ot_qwen_rom_tile_die
SRCS='rtl/hdc/ot_qwen_rom_raw_group.sv rtl/physical/ot_qwen_rom_tile_die.sv rtl/hdc/kv/ot_qwen_kv_land_merge.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_matvec.sv rtl/hdc/ot_qwen_me_array_w12.sv rtl/hdc/ot_qwen_rom_tile_w12.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_qwen_w12_arith.sv rtl/proto/ot_fp32_add_rne_pipe.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param GT=6144 --param NW=18 --param SMIN=7 --param CODE_BANKS=5 --param KV_VB=131072 --param KV_NH=2 --param MEM_EXTRA=1 --param ACC_LAT=7 --param TREE_LAT=7 --param MUL_LAT=8 --param FAST_ISSUE=1 --param KV_PREP=4 --param ROM_RAW_GROUP=1 --param ROM_PIPE=1 --param ROM_ARELAY=1 --param LRST=1)
FW=266.952
FH=1291.656
PINS=(--pin-region '^(n_a|n_b|n_va)(\[|$)=left:300-600' --pin-region '^(t_out|t_vout|n_y|n_vy)(\[|$)=left:600-880' --pin-region '^li(\[|$)=left:900-1100' --pin-region '^lo(\[|$)=right:900-1100' --pin-region '^(ib|ib_go|xl|tile_id|fault|rst_n|clk)(\[|$)=right:450-850')
INTER='n_a*,n_b*,n_va,n_y*,n_vy,t_out*,t_vout,li*,lo*'
REFGLOB='*go_q*'
FALSE_FROM='tile_id*'
SDCF=tile_die_p770.sdc
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_rom_4096x266_m8 physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8_skew250 --macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/macro_place_tile.tcl --orfs-var QDM_MACRO_PREFIX=u_tile. --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0' --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/rom_raw_group_place.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/rom_raw_group_release.tcl)
STAGES=pnr
CTSA='-sink_clustering_enable -repair_clock_nets -delay_buffer_derate 0.75 -macro_clustering_size 2 -macro_clustering_max_diameter 150'
