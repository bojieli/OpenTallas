# Partial DS-history evidence, not generic dynamic-B conformance.
TOP=ot_hbm_idx_ehash_ds
SRCS='rtl/hdc/v41/ot_hdc_engram_tables_shipped_pkg.sv rtl/hdc/v41/ot_hdc_engram_hash_shipped.sv rtl/hbm_accel/generic_20261009/ot_hbm_idx_ehash_ds.sv'
PARAMS=(--param ENABLE_GENERIC=1 --param NSLOT=8 --param MUTANT=0)
FW=400
FH=300
PINS=(--pin-region '^b_mult(\[|$)=left:20-70' --pin-region '^b_prime(\[|$)=left:85-240' --pin-region '^b_offset(\[|$)=right:20-240' --pin-region '^(clk|rst_n|token_begin|accept_valid|accept_slot|cmd_valid|cmd_ready|cmd_op|cmd_layer|cmd_slot|cmd_cid|cmd_first)(\[|$)=bottom:20-180' --pin-region '^(row_valid|row_ready|row_id|row_column|done|fault)(\[|$)=top:20-180')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*row_head*'
CLKPORT=clk
PD=0.35
NC=8
MACROS=()
EXTRA=()
STAGES=pnr
# Preserve WC/BC scene names required by OT_HOLD_MM; Option B maps WC
# libraries to TT through the supported driver overlay. FF remains BC.
CORNER=WC
export OT_ORFS_CORNER_OVERRIDE=TC

# drive-0849: PPL-0107 (ordered 768 / 768 / 256-pin groups placed in fallback mode, 95f75fa1e a+b at 3_2_place_iop):
# bounded groups on both admitted layers (as hgi_coll_row_formatter b4e2a11be / G12 630558368). Layout only, 0 cycles.
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
