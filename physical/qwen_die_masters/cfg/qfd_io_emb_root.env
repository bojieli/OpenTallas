# qwen-rtl-finish 2026-10-07: qfd_io_embedding_rom root (ot_qfd_emb_root: die-face request FIFO + credits, bank decode,
# one-bank-at-a-time in-order issue to 8 column chains, response merge), the block's die-face element.
TOP=ot_qfd_emb_root
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_io_embedding_rom.sv'
PARAMS=(--param NCOL=8 --param NTAP=297)
FW=259.2
FH=259.2
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(ea_|eq_|fault)(\[|$)=right' --pin-region '^(c_v|c_tap|c_line)(\[|$)=bottom' --pin-region '^(r_v|r_data)(\[|$)=left')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
