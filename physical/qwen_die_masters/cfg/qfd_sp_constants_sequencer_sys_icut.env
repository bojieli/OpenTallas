# struct-close 2026-10-09 (REVIEW_20261009 Q3 successor, A6 re-cut): qfd_sp_constants_sequencer_sys + ICUT=1 (ot_qwen_rom_core_ctrl: registered bad-instruction fault term, +1 status edge; registered issue readiness ready_q evaluated one edge ahead against the predicted post-edge status). d06ab7a00 pre-route -872.7 was chase compare -> issue -> load enables / fault.  Exact (ordered vs the reference master, 2 cases x 38 stages, 440 ME / 1448 SU / 146 collectives, 0 mismatches; bounds fault code 2); NOPRED mutant fails on the legality assertion.  Token: 43,612 vs 42,886 cycles (+726, +1.7 %).
TOP=ot_qfd_sp_constants_sequencer_sys
SRCS='rtl/qwen_sys/system_20261008/ot_qfd_sp_constants_sequencer_sys.sv rtl/qwen_sys/system_20261008/ot_qfd_dctl.sv rtl/qwen_sys/missing_masters_20261007/gen/ot_qwen_rom_core_ctrl.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/rom/ot_qwen_tp_seq_w12.sv rtl/rom/ot_qwen_tp_seq_w12_fs.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv rtl/hdc/ot_hdc_delay.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv'
PARAMS=(--param SYS_ENABLE=1 --param DIE_RANK=0 --param ICUT=1)
FW=777.6
FH=1000.08
PINS=(--pin-region '^(clk|rst_n|po_me_clk)$=top' --pin-region '^(pi_|d_start|d_token|d_pos|d_gen|kv_|me_mem|vm_rq|c_ready|r_).*=left' --pin-region '^(?!(c_ready|vm_rq|po_me_clk))(po_|s_|seq_|core_|coll_|su_|kvd_|me_clk_en|vm_|c_|rom_|d_done|d_drained|d_fault|d_next|d_cycles|stage|st_).*=right')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
QDMD=/src/physical/qwen_die_masters/mc/qfd_sp_constants_sequencer_sys
SDCF=die_p770.sdc
PD=0.55
NC=16
MACROS=()
# drive-0849: pin flops anchored at their pins (io_flop_at_pins.tcl): ICUT 155370387 failed only on IO pin-flop wires at ~1 % util
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
# ORFS synthesis only: host Yosys 0.68 asserts (modules_.count) re-deriving the top under -chparam FQ_HEAD (1d3c576bbtc attempt 1)
STAGES=pnr
# safe-qwen SQ-9 (reviewer 2026-10-08 ~22:20): two-layer pin spread (route_master PIN_H/PIN_V, be5b56d78): the faces hit
# FLOORPLAN_MARGIN at 20.5-20.8 b/um on M4 alone; M4+M6 / M5+M7 halve the per-layer density.  Layout only, 0 cycles.
PIN_H='M4 M6'
PIN_V='M5 M7'

# Reuse committed a66978536 balanced pin generator; original faces, zero RTL edges.
export OT_PIN_GROUP_MAX=64
export OT_PIN_BALANCE_H="M4 M6"
export OT_PIN_BALANCE_V="M5 M7"
