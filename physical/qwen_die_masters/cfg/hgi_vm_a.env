# hgi-takeover 2026-10-09: the HGI-1 vector memory hard view (ot_hgi_vm_unit NC 8: ECC VM core, 64 macros, 8 packet
# 2026-10-10: WP 32 + WDIRECT 1 (the DMA front: 32 lanes x 280 b, lane b -> bank b); the 8,960 + 32 wq pins on the left and right faces
# client stations) in its 1399.656 x 1080 low spine slot (r2: was 885.6, util 65.7 % > 60 % at FLOORPLAN_MARGIN; NC 8 = the full single-CP client set) (tools/hgi_die_dispatch.py HGI_VM_SLOT).
# hgi-1010/vm 2026-10-10: --pin-regions-exhaustive (route_master.sh) refused the floorplan: wq/wq_done matched BOTH the
# left and right regions and the RP/W2 wide-lane ports (rq/rq_cr/rr, w2q/w2q_cr/w2q_done; 1 lane at RP 0 / W2 0) matched none
# (9,548 ports). wq lanes 0-15 (bits 0..4479) + wq_done[0..15] -> left, lanes 16-31 -> right; RP/W2 ports on the bottom face.
TOP=ot_hgi_vm_unit
SRCS='rtl/hbm_accel/generic/vm/ot_hgi_vm_unit.sv rtl/hbm_accel/generic/vm/ot_hgi_vm_core.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param NC=8 --param WP=32 --param WDIRECT=1)
FW=1399.656
FH=1080.0
PINS=(--pin-region '^(cq|cr|status)(\[|$)=top:20-1379' --pin-region '^(wq\[([0-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-3][0-9][0-9][0-9]|4[0-3][0-9][0-9]|44[0-7][0-9])\]|wq_done\[([0-9]|1[0-5])\])$=left:20-1060' --pin-region '^(wq\[(44[89][0-9]|4[5-9][0-9][0-9]|[5-7][0-9][0-9][0-9]|8[0-8][0-9][0-9]|89[0-5][0-9])\]|wq_done\[(1[6-9]|2[0-9]|3[01])\])$=right:20-1060' --pin-region '^(rq|rq_cr|rr)(\[|$)=bottom:20-660' --pin-region '^(w2q|w2q_cr|w2q_done)(\[|$)=bottom:740-1379' --pin-region '^(clk|rst_n)$=bottom:680-720')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*h_v*'
SDCF=die_p770.sdc
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_vm_place.tcl)
STAGES=pnr

# PPL-0107 (submit lint, 0cbe85eef refused: ordered cq|cr|status group 1,855 pins): bounded groups on two layers; layout only
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
PIN_H='M4 M6'
PIN_V='M5 M7'
