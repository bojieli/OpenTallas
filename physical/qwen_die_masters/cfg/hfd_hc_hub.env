# conservative-1011 TWO-LEVEL (owner 10-11 21:00): hfd_hc_hub = band glue of the tiled hfd_hc quarter as its own hard
# element (the die places it at the E port band beside the 88 hfd_hc_tile_xl; band <-> chain-head relays are die seams).
# Physical spec: 120 x 330 um, pin-limited (2,048 die-side pins E face, 1,672 tile-side pins W face, M4/M6 at 2 tracks
# ~6.9 pins/um/face -> 297 / 243 um); one clock root (~3.7k flops); every boundary registered (fi pin flops, hbr out
# flops, hqi pin flops, to out flops); one logic stage = 7-way XOR fold (3 levels) with <= ~330 um vertical spread
# (fold bits are 161 apart in pin order); width 120 um gives ~2,400 vertical tracks for the ~1,000-net fold cut.
# Utilisation is pin-bound (~10-15 %), not logic-bound.  PDN = view contract (M7 PG pins; die M8 straps).
TOP=hfd_hc_hub
SRCS='physical/hbm_accel_die_views/hcp/rtl_hub/hfd_hc_hub.sv'
PARAMS=()
FW=120
FH=330
PINS=(--pin-region '^(f_sfu|t_sfu)(\[|$)=right:4-326' --pin-region '^(hb0|hb1|hb2|hb3|hq0|hq1|hq2|hq3)(\[|$)=left:4-326' --pin-region '^(clk|rst)(\[|$)=top:50-70')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*'
PD=0.30
NC=16
MACROS=()
EXTRA=( --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
