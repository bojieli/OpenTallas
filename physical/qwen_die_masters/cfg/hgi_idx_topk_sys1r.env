# RESET-APPLY (drive-1010 2026-10-10): hgi_idx_topk_sys1 + opt-in RST_RELAY (rst_n -> rtl/lib/ot_rst_relay -> per-leaf kept relay flops) and OUT_SKID (out_ready only selects the output register load). Same outline / pins / density as sys1.
TOP=ot_hgi_idx_topk_full
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_sys.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_registered.sv physical/hgi_idx_topk_20261009/ot_hgi_idx_topk_full.sv'
PARAMS=(--param RST_RELAY=1 --param OUT_SKID=1)
FW=900
FH=900
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-890' --pin-region '^in_.*(\[|$)=left:8-890' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-890')
INTER='*'
REFGLOB='*q_id*'
PD=0.50
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=()
EXTRA=()
STAGES=synth,pnr
