# el1011-q-kvd 2026-10-11: hardened KV-die link-buffer tile ot_qkvd_fbuf8 (8-deep x 528 b as 8 x 66 b slices with own
# control copies, pin flops, reset relay; ~5.3k flops).  Layer contract: routes M2-M6, power on M6 (parent owns M7).
TOP=ot_qkvd_fbuf8
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_buf_tiles.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo_sl.sv rtl/lib/ot_rst_relay.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=()
FW=81.0
FH=81.0
PINS=(--pin-region '^(din|push)(\[|$)=bottom' --pin-region '^(dout|empty)(\[|$)=top' --pin-region '^(clk|rst_n|pop)(\[|$)=left')
INTER='none_*'
REFGLOB='*push_q*'
SDCF=die_p770.sdc
PD=0.55
NC=8
PIN_H='M4 M6'
PIN_V='M5'
STAGES=pnr
PIN_MIN_TRACKS=2
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_tile_m6.tcl --routing-layers M2 M6)
