# New distinct RSO master. Existing closed WIN cfg/view stays intact.
# These are intrinsic source0 child candidates, not native phase/pin adoption.
source physical/qwen_die_masters/cfg/engc_win_b.env
TOP=ot_engc_t_win_rso
SRCS='rtl/dsrom_sys/engram/rso_candidate/ot_engc_t_win_rso.sv'
PINS+=(--pin-region '^rso$=top:199-204')
QDMD=/src/physical/s81_engc_tiles/rso_closure
SDCF=child_mean.sdc
ROUTE_PERIOD_NS=0.833333
