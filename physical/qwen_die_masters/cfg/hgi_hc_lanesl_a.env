# hbm-hcvm [ll] 2026-10-11 TEXTBOOK REBUILD (class 1): ot_hgi_hc_lane_sl = ONE hardened element slice of ot_hgi_hc_lane_ll
# (HSL=1): element e's HC_POST pipeline + PRE mix/square + phase-C scale, ~12k flops, its own clock tree and reset relay;
# every input pin-flopped, every output registered.  The flat lane was one 114,651-flop clock root (CTS hold -86 ps,
# 30k endpoints).  8 per lane.  Signal routing M2-M6 (M7 free for the parent's straps onto the M6 power pins), default PDN.
TOP=ot_hgi_hc_lane_sl
SRCS='rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/v41x/ot_hdc_v41x_vec_red.sv rtl/hdc/v41x/ot_hdc_v41x_sfu.sv rtl/hdc/v41/ot_hdc_fsqrt.sv rtl/hdc/v41/ot_hdc_fdiv.sv rtl/hdc/v41/ot_hdc_actquant.sv rtl/hdc/v41x/ot_dsrom_aq12.sv rtl/hdc/v41x/ot_dsrom_divc.sv rtl/hdc/v41x/ot_dsrom_fp32_add_l6.sv rtl/hdc/v41x/ot_dsrom_su_add6.sv rtl/hdc/v41x/ot_dsrom_su_norm.sv rtl/hdc/v41x/ot_dsrom_su_hcpost.sv rtl/hbm_accel/generic/peers/ot_hgi_hc_eng_ll.sv rtl/hbm_accel/generic/peers/ot_hgi_hc_eng.sv rtl/lib/ot_rst_relay.sv'
PARAMS=()
FW=140.4
FH=140.4
PINS=(--pin-region '^i_op(\[|$)=left' --pin-region '^i_cf(\[|$)=left' --pin-region '^(clk|rst_n|i_sw|i_mx|i_xov|i_wov)$|^i_pre(\[|$)=top' --pin-region '^(i_xo|i_rh|i_wo)(\[|$)=top' --pin-region '^(o_ho|o_xl|o_hv|o_hf|o_mf)(\[|$)=right' --pin-region '^(o_sq|o_qq|o_sf|o_f1|o_f2)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5'
RLAYERS='M2 M6'
INTER=''
REFGLOB='*'
FALSE_FROM=''
CLKPORT=clk
PD=0.55
NC=16
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr
