# qwen-blocks qfd_sp_tree_lane_credit_ps: lane pin stations, registered FIFO write, enable-free reads with kept pointer copies, output pin stations (PS=1, +3 cycles)
# Full TCUT7/SMIN7 lane: 48 input positions and 48 output positions; 16 replicas.
TOP=ot_qwen_spine_lane_credit
SRCS='rtl/physical/ot_qwen_spine_lane_credit.sv rtl/physical/ot_qwen_spine_lane.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=(--param PS=1)
FW=600.048
FH=600.048
PINS=(--pin-region '^in_data(\[|$)=left:15-585' --pin-region '^out_data(\[|$)=right:15-585' --pin-region '^(clk|rst_n|in_v|in_split|in_tag|in_cr|out_v|out_tag|out_cr|fault)(\[|$)=bottom:50-550')
INTER='*'
REFGLOB='*tin_q*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=pnr
