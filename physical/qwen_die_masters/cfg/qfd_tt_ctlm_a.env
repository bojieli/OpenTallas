# redesign-qwen 2026-10-09: tree-top CONTROL tile WITH the ME-side controller (ot_qfd_tt_ctlm, generated by
# tools/redesign_qwen/split_ctrl.py emit-tile): ot_qfd_tt_ctl (AMR / SPRE) + ot_qwen_rom_core_ctrl_x OWN 1 + a 64 x 1,024-b
# program-store copy + the in-tile issue shell (DCU_M = DUC_M = 2).  The r22k 380-b issue / 98-b status bus over 37 relays
# each way is inside the tile; the die carries the token start, program writes, the SU / ME status snapshots, kvd_*.
# Sequencer / SU / VM-facing pins S, selects to the upper tiles N, port-element faces W / E.  Variant a: 777.6 x 1814.4.
TOP=ot_qfd_tt_ctlm
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_tree_top.sv rtl/qwen_sys/redesign_qwen/ot_qfd_tt_split.sv rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_qwen_w12_arith.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/qwen_sys/redesign_qwen/ot_qfd_tt_ctlm.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv'
PARAMS=(--param DCU_M=2 --param DUC_M=2 --param XW=24 --param IS=1 --param OS=1)
FW=777.6
FH=1814.4
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(h_start|token|pos|prog_base|pw_\w+|x_o\w+|kv_ok|kv_write_drained|me_mem_ok|me_acc_o|me_idle_o|me_prog_o|m_f\w+|kvd_\w+|me_clk_en|c_fault|x_rdy|x_dv|x_dc|x_dcs|x_dsp|mx_\w+|land_cnt|ov)(\[|$)=bottom' --pin-region '^(t_sel_e|t_tv_e|tr_fault|up_fault)(\[|$)=top' --pin-region '^(p_\w+|fab_fault)(\[|$)=left' --pin-region '^(scale_\w+)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr

