# el1011-ds-misc/engram 2026-10-11: ALL-TILE dsfd_engram_c (textbook class 1: no top-level register; physical spec in
# el1011-ds-misc.log 'PHYSICAL SPEC dsfd_engram_c ALL-TILE').  T_IO = endpoint / VM tile: die pins N (t_vm at the left end under x711-762), T_WIN seams W, bank read seams S (band via the lkp-R0 channel, R0 / R1 above their N faces).
# Variant a: PD 0.45.  Own clock tree (clock port ck), every input a pin flop, every output a flop.
TOP=ot_engc_t_io
SRCS='rtl/dsrom_sys/engram/tiles/ot_engc_t_io.sv rtl/dsrom_sys/s81_ctrl/ot_s81_secded.sv rtl/lib/ot_reset_sync.sv rtl/lib/ot_async_fifo.sv rtl/dsrom_sys/s81_ctrl/ot_s81_engine_adapter.sv rtl/dsrom_sys/s81_ctrl/ot_s81_slab_ep.sv'
PARAMS=()
FW=448.416
FH=38.88
CLKPORT=ck
SDCF=die_p770_ck.sdc
PINS=(--pin-region '^t_vm(\[|$)=top:2-62' --pin-region '^f_vm(\[|$)=top:66-80' --pin-region '^c_cmd(\[|$)=top:150-186' --pin-region '^c_done(\[|$)=top:195-210' --pin-region '^c_st(\[|$)=top:212-218' --pin-region '^f_cfg(\[|$)=top:258-268' --pin-region '^(ck|rst)$=left:32-37' --pin-region '^(rdy_i|perr_i|vrel_o|cfg_o|jn_o|wn_i|jf_i|werr_i)(\[|$)=left:3-31' --pin-region '^(r1_oh|r1_a)(\[|$)=bottom:1-4' --pin-region '^rd1(\[|$)=bottom:4-26' --pin-region '^(r0_oh|r0_a)(\[|$)=bottom:27-42' --pin-region '^rd0(\[|$)=bottom:43-207' --pin-region '^(r2_oh|r2_a)(\[|$)=bottom:247-262' --pin-region '^rd2(\[|$)=bottom:263-305')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*vra_q*'
PD=0.45
NC=16
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
