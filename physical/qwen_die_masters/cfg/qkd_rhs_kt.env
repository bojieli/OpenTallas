# el1011-q-kvd-head 2026-10-11: HARDENED SUB-TILE ot_qkh_ktree of the hierarchical head ot_qwen_nearhbm_head_hs (1 a
# head): K levels 4-7 (15 dedicated FP32 adders in the original pairing) + the scale multiply + the fault OR; 529 pin
# flops in, registered out, own reset relay.  151.2 x 129.6 um.  Routes M2-M6, power pins M6 (pdn_qkh_sub.tcl).
TOP=ot_qkh_ktree
SRCS='rtl/lib/ot_rst_relay.sv rtl/hdc/nearhbm/ot_qkh_subtiles.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param ADD_LAT=7 --param MUL_LAT=6)
FW=151.2
FH=129.6
PINS=(--pin-region '^(kp_in|kpv_in|gf_in)(\[|$)=top' --pin-region '^(sc_d|sc_f|g_f)(\[|$)=bottom' --pin-region '^(clk|rst_n)(\[|$)=left')
INTER='*'
REFGLOB='*kv_r*'
SDCF=die_p770.sdc
PD=0.55
NC=16
PIN_H='M4'
PIN_V='M5'
STAGES=synth,pnr
PIN_MIN_TRACKS=1
MACROS=()
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var GPL_TIMING_DRIVEN=0 --orfs-var MAX_ROUTING_LAYER=M6 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkh_sub.tcl)
