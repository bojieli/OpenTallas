# safe-qwen S-D2 (2026-10-08, REVIEW_20261008 D2): qfd_sp_res_ser with TSR=1: the beat's slot select t2_s comes from a
# registered copy per 64-bit output slice (keep_hierarchy leaves registered from t1_s with t2_s; 0 added cycles).  Routed
# d95c2ebddtt was killed post-CTS at TT -1,142.6: t2_s[0] -> o_data[400], 30 of 34 cells buffers (class D).
# qwen-vm-me 2026-10-08: r21m die master qfd_sp_res_ser = the band result serializer (rtl/qwen_sys/vm_me_20261008/
# ot_qfd_res_path.sv ot_qfd_res_ser): 8 slots captured on engine edges into 8 x ot_sram_1r1w_64x512 (DB = 64 bursts),
# row / mask / header flops, one beat a cycle to the VM merge under CRB = 16 credits, rok at RS = 40 (stall loop).
TOP=ot_qfd_res_ser
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_res_path.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param USE_MACRO=1 --param DB=64 --param RS=40 --param CRB=16 --param TSR=1)
FW=777.6
FH=518.4
PINS=(--pin-region '^(clk|rst_n|me_en)$=top' --pin-region '^(i_ov|i_we|i_addr|i_mask)(\[|$)=left' --pin-region '^i_data\[[0-9]*[02468]\]$=left' --pin-region '^i_data\[[0-9]*[13579]\]$=right' --pin-region '^(o_\w+|rok|fault)(\[|$)=bottom')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=8
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
# --macro-view is a pnr-only option (run_abi3_physical refuses host synth with macro views)
STAGES=pnr
# safe-qwen SQ-9 (reviewer 2026-10-08 ~22:20): two-layer pin spread (route_master PIN_H/PIN_V, be5b56d78): the faces hit
# FLOORPLAN_MARGIN at 20.5-20.8 b/um on M4 alone; M4+M6 / M5+M7 halve the per-layer density.  Layout only, 0 cycles.
PIN_H='M4 M6'
PIN_V='M5 M7'
