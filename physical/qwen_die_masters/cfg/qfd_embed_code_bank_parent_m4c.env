# qwen-missing 2026-10-07 RE-HARDEN variant of qfd_embed_code_bank_parent: the ingress macro view is the child
# re-routed by physical/qwen_embedding_parent/jobs/reharden.sh in this job (cfg qfd_embed_ingress_code_m4pin: PDN pins
# on M4, routing M2-M4), exported at SS/TT/FF into physical/qwen_embedding_parent/m4c/code/qfd_embed_ingress_code of the
# job's source snapshot, with its measured internal valid_q clock insertion in m4c/code/clock_reference.tcl.
TOP=ot_qwen_embed_code_bank_parent
SRCS='physical/qwen_embedding_parent/code/ingress_bb.v rtl/physical/ot_qwen_embed_code_bank_parent.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v'
PARAMS=(--param OCRED=4)
FW=270
FH=120.42
PINS=(--pin-region '^(i_(v|addr|cr)|o_cr)(\[|$)=left' --pin-region '^o_(v|data)(\[|$)=right' --pin-region '^(clk|rst_n|fault)$=bottom')
INTER='i_*,o_*,fault'
REFGLOB='*iv_q*'
SDCF=embed_bank_p770.sdc
PD=0.55
NC=8
MACROS=(physical/qwen_embedding_parent/m4c/code/qfd_embed_ingress_code physical/asap7_memory_macros/ot_rom_4096x266_m8)
EXTRA=(--macro-view qfd_embed_ingress_code=physical/qwen_embedding_parent/m4c/code/qfd_embed_ingress_code --macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_embedding_parent/code/place.tcl)
STAGES=pnr
QDMD=/src/physical/qwen_embedding_parent/m4c/code
