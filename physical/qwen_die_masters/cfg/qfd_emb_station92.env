# V19 approved after real four-outstanding gate; standalone one-stage leaf.
TOP=ot_qfd_emb_station_pair
SRCS='rtl/qwen_sys/emb_hbm_20261008/ot_qfd_emb_station_pair.sv'
PARAMS=(--param STAGES=1)
FW=92.016
FH=36.72
PINS=(--pin-region '^(cmd_i|ret_o)=left' --pin-region '^(cmd_o|ret_i)=right' --pin-region '^(clk|rst_n)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.55
NC=4
MACROS=()
EXTRA=()
STAGES=synth,pnr
ROUTE_PERIOD_NS=0.770
QDMD=/src/physical/qwen_die_masters/mc/qfd_emb_station92
SDCF=plain.sdc
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2
# Alternate each pin across both explicit layers over its entire face.
# Layer-local separation 2*36.72/548=.134um >=2*.048um; no packed one-layer group.
export OT_PIN_GROUP_MAX=1
export OT_PIN_BALANCE_H="M4 M6"
export OT_PIN_BALANCE_V="M5 M7"
