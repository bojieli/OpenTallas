# redesign-qwen 2026-10-09: qfd_link_rx128_rxp = qfd_link_rx128_o302_afw + RXP=1 (sys-takeover far92 receive buffer: one-hot write/read pointer copies per 32-b slice, registered 2-stage AND-OR read into a 4-entry staging FIFO; +2 wclk a word, full rate) on a 345.6 um frame (RXP adds ~7k flops: pointer copies 17 x 2 x 128, staging 4 x 523, region partials 8 x 523). afw route TT -29.3: iv_q -> ib write enable (14 lv), ir -> 128:1 read mux -> FIFO write (18-19 lv) -- both removed by RXP.
TOP=ot_qwen_die_cdc_ch
SRCS='rtl/physical/ot_qwen_die_cdc_ch.sv rtl/physical/ot_qwen_async_fifo_w.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=(--param W=523 --param IBUF=128 --param OCRED=8 --param AD=8 --param AFW=1 --param RXP=1)
FW=345.6
FH=345.6
PINS=(--pin-region '^(i_v|i_d|i_cr)(\[|$)=left:4-341' --pin-region '^(o_v|o_d|o_cr)(\[|$)=right:4-341' --pin-region '^(wclk|rclk|wrst_n|rrst_n|w_fault|r_fault)$=top:60-285')
INTER='*'
REFGLOB='*od_q*'
CLKPORT=rclk
QDMD=/src/physical/qwen_die_masters/mc/qfd_link_rx128
SDCF=plain.sdc
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=pnr
export OT_SYNTH_MEMORY_MAX_BITS=262144
