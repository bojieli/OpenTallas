# el1011-hbm-idx 2026-10-11: ONE IDX.TOPK heap as a hardened tile (ot_hgi_topk_heap_tile, MAX_K 2,048): levels 7..10 in four
# 1R1W macros (3 x 128x256, 1 x 256x256) with registered write ports (flop -> wd_in / mask / addr), registered grandchild
# word capture, replicated per-level clear, pin flops + 2-entry op FIFO + credit return, registered ext / idle / root,
# 10-11 ~21:55 LAYER CONTRACT r2: PG = full M6 stripes (pdn_tile_m6.tcl), signals/pins M2-M6, M7 free for the hub/die straps (r1 closed with PG M5 + M6/M7 signals).
# rst_n through ot_rst_relay.  W copies place in the w8 engine (hierarchical).  300 x 220 um (~47% incl. macros: textbook audit class 6 -- 440/360 were 16/24%), 20.16-um macro channels.
TOP=ot_hgi_topk_heap_tile
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
PARAMS=(--param MAX_K=2048)
FW=300
FH=220
PINS=(--pin-region '^(clk|rst_n|k|clr_go|op_v|op_ext|op_x)(\[|$)=left:8-212' --pin-region '^(ext_.*|root_key|idle|op_cr)(\[|$)=right:8-212')
PIN_H='M4 M6'
PIN_V='M5'
INTER='*'
REFGLOB='*d_p*'
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/hgi_idx_hier/pdn_tile_m6.tcl)
STAGES=pnr
RLAYERS='M2 M6'
