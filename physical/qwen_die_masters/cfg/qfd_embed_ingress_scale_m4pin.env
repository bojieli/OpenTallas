# qwen-missing 2026-10-07: the qualified ingress child (ot_qwen_embedding_ingress_numeric, same RTL / pad retention as
# qfd_embed_ingress_scale_numeric) re-hardened for the M1-M5 parent: PDN pins on M4 (physical/qwen_embedding_parent/
# pdn_ingress_m4pin.tcl) and signal routing on M2-M4 only, so the parent's M5 straps pass over it (PDN-0233 fix).
TOP=ot_qwen_embedding_ingress_numeric
SRCS='rtl/physical/ot_qwen_embedding_ingress_numeric.sv'
PARAMS=(--param AW=18)
FW=15.12
FH=15.12
PINS=(--pin-region '^(address|valid|credit)(\[|$)=left' --pin-region '^(address_[qn]|valid_[qn]|credit_[qn])(\[|$)=right' --pin-region '^(clk|rst_n)$=bottom')
INTER='address*,valid*,credit*'
REFGLOB='*valid_q*'
SDCF=die_p770.sdc
PD=0.55
NC=8
RLAYERS='M2 M4'
MACROS=()
EXTRA=(--step-tcl PRE_FLOORPLAN=physical/qwen_embedding_padded/preserve.tcl --orfs-var EMBED_PAD_CELLS=210 --orfs-var PDN_TCL=/src/physical/qwen_embedding_parent/pdn_ingress_m4pin.tcl --orfs-var MIN_CLK_ROUTING_LAYER=M3)
STAGES=pnr
