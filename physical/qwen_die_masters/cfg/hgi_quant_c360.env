# hgi-takeover (Claude, 2026-10-09): COMPACT floorplan. pd50 at 1800x600 was 2.4% utilised (23.2k um2 cells in 1.07 mm2): cells spread -> 27-deep clock tree, FF boundary insertion 804..1172 ps (368 ps spread) -> input-capture hold -386 (aq.s0_x) and wire-dominated internal setup -565 (bq.s5_c). 360x150 ~45% util; fits the 1814x276 die slot.
# Full G8 native interface, no tieoffs, replicas=1, exact latency23/II1.
TOP=ot_hgi_quant_decode
SRCS='rtl/hbm_accel/generic/ot_hgi_quant_decode.sv physical/hbm_accel_die_views/common/ot_hfd_oreg1.sv physical/hbm_accel_die_views/quant/rtl/ot_hfd_actquant_m.sv rtl/hbm_accel/generic/ot_hgi_fp4qdq.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat_f12.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=()
FW=360
FH=150
PINS=(--pin-region '^x\[=left:5-145' --pin-region '^header\[=bottom:10-350' --pin-region '^y\[=right:5-145' --pin-region '^(clk|rst_n|v|generic_enable|legacy_fp4|vo|fault|decode_fault)$=top:10-350')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*valid_pipe*'
CLKPORT=clk
PD=0.55
NC=12
MACROS=()
EXTRA=()
STAGES=synth,pnr
