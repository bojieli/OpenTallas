# qwen-rtl-finish 2026-10-07: r21 die master qfd_sp_vector_memory = banked VM with the parallel ME x service
# (rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_vector_memory.sv): 64 row banks x 2 ot_sram_1r1w_256x256 macros (128),
# capture flops at the macros, beat rotate / shift / stride-decimation stages, assembly line + x seats (2,048 x 32 b),
# row read / write ports.  XVM = 15 (x network stages BD - XVM - 1 = 25).  Area grows from the r21 0.725 mm2 slab.
TOP=ot_qfd_sp_vector_memory
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_vector_memory.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
PARAMS=(--param USE_MACRO=1 --param XVM=15)
FW=777.6
FH=3110.4
PINS=(--pin-region '^(clk|rst_n|me_en)$=top' --pin-region '^(x_dv|x_dc|x_dcs|x_dsp|x_rdy|w_|r_v|r_rdy|r_row|x_fault|x_hazard)(\[|$)=right' --pin-region '^x_q\[[0-9]*[02468]\]$=left' --pin-region '^x_q\[[0-9]*[13579]\]$=right' --pin-region '^(r_q|r_qv)(\[|$)=bottom')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0')
STAGES=synth,pnr
