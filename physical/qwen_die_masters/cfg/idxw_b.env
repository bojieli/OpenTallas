# el1011-hbm-idxs 2026-10-11: IDX.INDEX wide-lane frame adapter ot_hgi_idx_index_w (hgi_idx unit, IXW=1) as a hardened
# tile, variant b.  Pin-bound outline: VM wide READ group on the left face (8.8k pins), wide WRITE group on the right
# face (9.0k), selector ports on top, frame command / status on the bottom; every port lands in / leaves a flop (pin
# flops placed at the pins).  Layer contract (leaf tile): signals M2-M6, VDD/VSS M6 stripes (parent / die owns M7).
TOP=ot_hgi_idx_index_w
SRCS='rtl/hbm_accel/generic/idx/ot_hgi_idx_index_w.sv'
PARAMS=()
FW=440
FH=600
PINS=(--pin-region '^(wrr|wrq|wrq_cr|rg_req|rg_gnt)(\[|$)=left:8-592' --pin-region '^(wwq|wwq_cr|wwq_done|wg_req|wg_gnt)(\[|$)=right:8-592' --pin-region '^(fs|qb|qbr|kin|to|toc|co|coc|ev)(\[|$)=top' --pin-region '^(clk|rst_n|go_i|k_i|cand_en_i|keep_en_i|n_i|rank_i|pos_i|a_base_i|b_base_i|c_base_i|o_base_i|r_base_i|d_base_i|d_stride_i|c_stride_i|c_n_i|has_r_i|done|fault)(\[|$)=bottom')
PIN_H='M4 M6'
PIN_V='M5'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
INTER='*'
REFGLOB='*rcr_q*'
SDCF=die_p770.sdc
PD=0.40
NC=16
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_tile_m6.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl --routing-layers M2 M6)
STAGES=synth,pnr
