# orphans-2 2026-10-08: qfd_chead (column head, qfd_chead_e/_w, 64 copies) moved from jobs/route_station.sh KIND=chead
# onto the generic master flow (route_master.sh: TC + link budget + mm FF hold).  ot_qwen_die_station DW 508 TAP 1 SPLIT 1,
# r20c frame 52.68 x 103.656, a E / b W / t N / c S.  RTL unchanged (every boundary register-to-register).
TOP=ot_qwen_die_station
SRCS='rtl/physical/ot_qwen_die_station.sv'
PARAMS=(--param DW=508 --param TAP=1 --param SPLIT=1)
FW=52.68
FH=103.656
PINS=(--pin-region '^(a_d|a_r|clk|rst_n)(\[|$)=right:8-96' --pin-region '^(b_d|b_r)(\[|$)=left:8-96' --pin-region '^(t_d|t_r)(\[|$)=top:4-48' --pin-region '^(c_d|c_r)(\[|$)=bottom:4-48')
INTER='a_d*,a_r,b_d*,b_r,t_d*,t_r,c_d*,c_r'
REFGLOB='*br_q*'
SDCF=station_die_p770.sdc
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
