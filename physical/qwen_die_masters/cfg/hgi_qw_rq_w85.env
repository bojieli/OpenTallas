# el1011-hbm-fq (2026-10-11): ot_hgi_quant_wide_h hardened sub-tile ot_hgi_qw_rq (85x100); layer contract: routing M2-M6, PDN pdn_block.tcl (<= M6), parent owns M7.
TOP=ot_hgi_qw_rq
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic/qw/ot_hgi_qw_rq.sv'
PARAMS=()
FW=85
FH=100
PINS=(--pin-region '^(wrr|wrq|wrq_cr)\[=left:4-96' --pin-region '^(gq|e_push|e_rcr|c_hit_r|c_sec|c_hit_p|c_slot)\[=right:4-96' --pin-region '^(clk|rst_n)$=top:4-20')
PIN_H='M4 M6'
PIN_V='M5'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*p_v*'
CLKPORT=clk
PD=0.5
NC=16
RLAYERS='M2 M6'
MACROS=()
EXTRA=(--orfs-var PDN_TCL=/src/tools/chip_assembly/tcl/pdn_block.tcl)
STAGES=synth,pnr
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5'
