# Fail before synthesis/route on absent, stale or unqualified component views.
python3 tools/qwen_embedding_parent_binding.py --kind code \
  --view physical/qwen_embedding_parent/bindings/code/qfd_embed_ingress_code \
  --receipt physical/qwen_embedding_parent/bindings/code/receipt --verify || exit $?
TOP=ot_qwen_embed_code_bank_parent
SRCS='physical/qwen_embedding_parent/code/ingress_bb.v rtl/physical/ot_qwen_embed_code_bank_parent.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v'
PARAMS=(--param OCRED=4)
FW=270
FH=120.42
PINS=(--pin-region '^(i_(v|addr|cr)|o_cr)(\[|$)=left' --pin-region '^o_(v|data)(\[|$)=right' --pin-region '^(clk|rst_n|fault)$=bottom')
INTER='i_*,o_*,fault'
REFGLOB='*iv_q*'
SDCF=embed_bank_p770.sdc
PD=0.55
NC=8
MACROS=(physical/qwen_embedding_parent/bindings/code/qfd_embed_ingress_code physical/asap7_memory_macros/ot_rom_4096x266_m8)
EXTRA=(--macro-view qfd_embed_ingress_code=physical/qwen_embedding_parent/bindings/code/qfd_embed_ingress_code --macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_embedding_parent/code/place.tcl)
STAGES=pnr
QDMD=/src/physical/qwen_embedding_parent/code
