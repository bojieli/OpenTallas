# Codex native finite elastic successor; unqualified, opt-in ENABLE1.
# Model: tools/qwen_system/native_credit_successor.py; source/credit pins own flops.
# 833.333ps TT setup/FF hold under unchanged60/25ps uncertainty. SS retained sensitivity.
TOP=ot_qwen_native_elastic_relay
SRCS='rtl/physical/ot_qwen_native_elastic_relay.sv rtl/physical/ot_qwen_die_station.sv rtl/common/ot_link_credit.sv rtl/lib/ot_reset_sync.sv'
PARAMS=(--param W=516 --param DEPTH=4 --param OCRED=4 --param ENABLE=1)
FW=52.704
FH=86.4
PINS=(--pin-region '^(i_v|i_d|i_cr)(\[|$)=left:4-82' --pin-region '^(o_v|o_d|o_cr)(\[|$)=right:4-82' --pin-region '^(clk|rst_n|fault)$=top:8-44')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='i_v,i_d*,i_cr,o_v,o_d*,o_cr'
REFGLOB='*g_elastic*tx*l_data*'
SDCF=station_die_p770.sdc
PD=0.50
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
