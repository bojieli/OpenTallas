# drive-0158 "-cl" of qfd_sysctl_stn_pb2: PKG_DONE_REG=1 (registered package-done reductions, +1 edge per step); otherwise identical to a3e585f3f.
TOP=ot_qfd_sysctl_stn_pb2
SRCS='rtl/qwen_sys/system_20261008/ot_qfd_sysctl_stn_pb2.sv rtl/qwen_sys/system_20261008/ot_qfd_sysctl_pb2.sv rtl/qwen_sys/system_20261008/ot_qfd_prompt_sram_pb2.sv rtl/qwen_sys/system_20261008/ot_qfd_pkgctl.sv rtl/qwen_sys/system_20261008/ot_host_if_pb2.sv rtl/qwen_sys/ot_qwen_sys_csr.sv rtl/qwen_sys/ot_qwen_sys_rst_seq.sv rtl/lib/ot_reset_sync.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param PKG_DONE_REG=1 --param PROMPT_SRAM=1 --param BOUNDARY_STATIONS=1 --param PROMPT_READ_STATION=1)
FW=500
FH=300
PINS=(--pin-region '^(s_|m_|irq)=left' --pin-region '^(c_|crom_fault|fault_src)=right' --pin-region '^(clk|por_n|link_up|boot_|host_rst_n|link_rst_n|hbm_rst_n|die_rst_n|sys_ready)=bottom')
INTER='c_*'
REFGLOB='*u_host*eng_start*'
SDCF=die_p770.sdc
PD=0.55
NC=16
PIN_H='M4 M6'
PIN_V='M5 M7'
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/sysctl_stn_pb2_place.tcl)
EXTRA+=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/sram_cap_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/rom_cap_release.tcl)
STAGES=pnr
