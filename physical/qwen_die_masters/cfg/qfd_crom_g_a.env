# redesign-qwen 2026-10-09: ONE 8-lane group of the constant ROM (ot_qfd_crom_g = ot_qfd_crom SW 8: 2 wide + 1 narrow macro
# columns x 2 deep = 6 x ot_rom_4096x266_m8), x 8 along the constant buffer's N face (each fills its qfd_su_cbuf_g below).
# Replaces qfd_crom48 (777.6 x 1,000, 5.6 k pins on one face, DRT-0255 pin access, decode 12 lv + 500 um).  The constant
# buffer makes its latency free, so the pipeline keeps the ROM's 5 edges.  Macros in one E column 50 um above the S lane
# face (crom_g_place.tcl).  Exact: 8 tiles == the 64-lane ROM (tb_qfd_crom_g).  Variant a: 194.4 x 518.4.
TOP=ot_qfd_crom_g
SRCS='rtl/qwen_sys/system_20261008/ot_qfd_crom.sv rtl/hdc/ot_hdc_delay.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v'
PARAMS=()
FW=194.4
FH=518.4
PINS=(--pin-region '^(clk|rst_n)$=left' --pin-region '^(crom_re|crom_addr|crom_q)(\[|$)=bottom' --pin-region '^(crom_stage|fault|fault_code)(\[|$)=left')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=8
MACROS=(physical/asap7_memory_macros/ot_rom_4096x266_m8)
EXTRA=(--macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/crom_g_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr

