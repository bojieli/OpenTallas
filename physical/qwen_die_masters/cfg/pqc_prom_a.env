# el1011-ds-misc/pqc 2026-10-11: hardened sub-tile of the DS-ROM PQ spine screen (v15 hierarchical spine,
# physical/s81_pq_hier).  T_PROM: the screen phase-ROM stand-in (128 x 64 register file, two-cycle read; die: ROM macro).
# Variant a: 110 x 110 um.  Own clock tree and reset relay; datapath unreset; seams register to register.
# PDN = the view contract (s81_ph_views/common/pdn_view.tcl: M7 PG pins) so the composition's M8 grid connects M7-M8.
TOP=ot_pqc_t_prom
SRCS='physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv physical/s81_pq_hier/pinned/physical/dsrom_field_spine/ot_v41_pqc_tile_tops.sv physical/s81_pq_hier/pinned/physical/dsrom_field_spine/ot_v41_pqc_spine_screen.sv'
PARAMS=()
FW=110
FH=110
PINS=(--pin-region '^(we|wa|wd|clk|rst_n)(\[|$)=left:4-106' --pin-region '^(ra)(\[|$)=top:4-106' --pin-region '^(q)(\[|$)=right:4-106')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*g_a*'
PD=0.55
NC=16
MACROS=()
EXTRA=( --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view.tcl)
STAGES=synth,pnr
