# el1011-hbm-idx 2026-10-11: one hardened tile of the TOPK_MERGE chain (ot_hgi_coll_tkm_tile, PT 64 positions x 85 b (r2: replicated block copies, log-depth compares),
# ~7k flops, own clock tree; textbook audit rebuild of the flat 2,048-entry array).  North: insert block in + top cell
# out (to the tile above); south: overflow out + conveyor in (from the tile below); west: control / tau.  240 x 240 um.
TOP=ot_hgi_coll_tkm_tile
SRCS='rtl/hbm_accel/generic/collective/tkm/ot_hgi_coll_tkm.sv'
PARAMS=(--param EW=85 --param PT=64 --param TW=6 --param LW=7)
FW=240
FH=240
PINS=(--pin-region '^(ins_v|ins_b|up_out)(\[|$)=top:8-232' --pin-region '^(ovf_v|ovf_b|up_in)(\[|$)=bottom:8-232' --pin-region '^(clk|tid|clr|conv|tau_t|tau_l|tau_o|busy)(\[|$)=left:8-232')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*p_b*'
PD=0.50
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
