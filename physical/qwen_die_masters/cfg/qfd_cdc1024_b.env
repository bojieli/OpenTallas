# redesign-qwen 2026-10-10 (coordinator: qfd_io_xfifo): the IO-band CDC slot as FOUR hardened single-crossing tiles
# (ot_qwen_die_cdc_ch W 1024, one clock pair each: ut ck->cku, ur cku->ck, st ck->cks, sr cks->ck) + the collective
# channel already closed separately (qfd_coll_xfifo).  qfd_io_xfifo (400 x 1,564, five channels, four clocks in one block)
# stalls FF hold at -88.7 with reg->output hold -331 (outputs of several clock domains against one IO reference).  One
# clock pair per tile = one write-side and one read-side reference (the qfd_link_rx128 kit, closed at TT +34 / FF +2.9).
# Variant b: AFW 1 (wide FIFO slice read copies), LVT.
TOP=ot_qwen_die_cdc_ch
SRCS='rtl/physical/ot_qwen_die_cdc_ch.sv rtl/physical/ot_qwen_async_fifo_w.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=(--param W=1024 --param IBUF=4 --param OCRED=4 --param AD=8 --param AFW=1)
FW=302.4
FH=388.8
PINS=(--pin-region '^(i_v|i_d|i_cr)(\[|$)=left:4-384' --pin-region '^(o_v|o_d|o_cr)(\[|$)=right:4-384' --pin-region '^(wclk|rclk|wrst_n|rrst_n|w_fault|r_fault)$=top:60-240')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*od_q*'
CLKPORT=rclk
QDMD=/src/physical/qwen_die_masters/mc/qfd_link_rx128
SDCF=plain.sdc
PD=0.50
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
export OT_SYNTH_MEMORY_MAX_BITS=262144
export OT_MULTI_VT=lvt
