# hgi-takeover: clk / rst_n each in an isolated top region (pd55 f6d441b6a ended DRC 1 = M5 spacing in_bias_en vs clk at the top face; TT +58.86 / FF +13.36). RTL unchanged.
TOP=ot_hgi_argmax18_m
SRCS='rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/gpu/ot_gpu_fadd.sv physical/hbm_mtp/rtl/ot_dshbm_argmax_m.sv physical/hbm_generic/argmax18/rtl/ot_hgi_argmax18_value_m.sv physical/hbm_generic/argmax18/rtl/ot_hgi_argmax18_m.sv'
PARAMS=(--param LP=8 --param FLAT=7 --param FAST=1 --param GENERIC18=1)
FW=180
FH=140
PINS=(--pin-region '^in_(vals|bias)(\[|$)=left:4-136' --pin-region '^clk$=top:86-94' --pin-region '^rst_n$=top:130-140' --pin-region '^(in_v|in_last|in_bias_en|in_mask)(\[|$)=top:4-70' --pin-region '^cfg_(rank|imm_a)(\[|$)=bottom:4-176' --pin-region '^out_(v|idx|nan|range_fault|value)(\[|$)=right:4-136' --pin-region '^fault$=right:4-136')
INTER='*'
REFGLOB='*out*'
CLKPORT=clk
PIN_H='M4 M6'
PIN_V='M5 M7'
PD=${PD:-0.55}
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
