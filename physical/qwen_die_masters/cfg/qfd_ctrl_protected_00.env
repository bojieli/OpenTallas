# Two full retained PC replicas and central guard. Candidate expanded frame; parent die placement and final pin-station distances remain unqualified.
# Full JEDEC scheduler PC0; other qfd_ctrl services are separate, unclosed leaves.
TOP=ot_qwen_ctrl_protected_pc00
SRCS='rtl/physical/ot_qwen_ctrl_pc_protected.sv rtl/physical/ot_qwen_ctrl_protected_pc00.sv rtl/physical/ot_qwen_ctrl_pc_shift.sv rtl/physical/ot_hbm_r14_stream_pc_shift.sv'
PARAMS=()
FW=559.072
FH=370.44
PINS=(--pin-region '^cmd(_v)?(\[|$)=left:8-180' --pin-region '^(read_credit|cmd_credit)(\[|$)=left:185-360' --pin-region '^(row|col)_.*=top:247.536-311.536' --pin-region '^(clk|rst_n|busy|fault)$=bottom:247.536-311.536')
INTER='*'
REFGLOB='*cmd_q*'
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
