# hgi-1010/k 2026-10-11: the hardware COLL.TOPK_MERGE merge sink ot_hgi_coll_tkm (KMAX 2,048): 4 delivery-lane SRAM FIFOs
# (12 1R1W 128x256 macros), survivor filter + 4-wide select, broadcast-insertion array (2,048 x 84 b reset-free flops, entry
# block replicated every 32 positions), block odd-even transposition for the id order, one 16-word line an edge out.
TOP=ot_hgi_coll_tkm
SRCS='rtl/hbm_accel/generic/collective/tkm/ot_hgi_coll_tkm.sv rtl/lib/ot_rst_relay.sv rtl/hbm_accel/tu/ot_hcoll_sram_prims.sv rtl/hbm_accel/ha2_ar/ot_ha2_prims.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param KMAX=2048 --param DEL=4)
FW=1800
FH=1800
PINS=(--pin-region '^(clk|rst_n|start|cfg_.*|busy|done|fault|stat_.*)(\[|$)=top:8-1790' --pin-region '^del_.*(\[|$)=left:8-1790' --pin-region '^w_.*(\[|$)=bottom:8-1790')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*d1_v*'
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
STAGES=pnr
