# One full-capacity protected publisher lane; raw PI before ECC, coded PO flops.
TOP=ot_hgi_coll_publish_tile
SRCS='rtl/hbm_accel/generic/collective/ot_hgi_coll_publish_tile.sv rtl/hbm_accel/generic/collective/ot_hgi_coll_publish_fifo.sv rtl/hbm_accel/tu/ot_hcoll_sram_prims.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param ENABLE=1 --param W=544 --param MUT=0)
FW=360
FH=220
PINS=(--pin-region '^(din|push)(\[|$)=left:8-212' --pin-region '^(encoded|valid|pop)(\[|$)=right:8-212' --pin-region '^(fault|occupancy)(\[|$)=top:8-352' --pin-region '^clk$=bottom:178-182' --pin-region '^rst_n$=bottom:190-194')
INTER='din*,push,encoded*,valid,pop'
REFGLOB='*encoded_p*'
SDCF=die_p770.sdc
PD=0.45
NC=8
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 6 6)
STAGES=pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
