# el1011-q-kvd 2026-10-11: hardened KV-die link-buffer tile ot_qkvd_sbuf (64 x 512 SRAM body + 8 x 66 b head-queue
# slices, pin flops, reset relay; ~7.6k flops).  Layer contract: routes M2-M6, power on M6 (parent owns M7).
TOP=ot_qkvd_sbuf
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_buf_tiles.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo_sl.sv rtl/lib/ot_rst_relay.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=()
FW=237.6
FH=151.2
PINS=(--pin-region '^(din|push)(\[|$)=bottom' --pin-region '^(dout|empty)(\[|$)=top' --pin-region '^(clk|rst_n|pop)(\[|$)=left')
INTER='none_*'
REFGLOB='*push_q*'
SDCF=die_p770.sdc
PD=0.50
NC=8
PIN_H='M4 M6'
PIN_V='M5'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_tile_m6.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkd_sbuf_place.tcl --routing-layers M2 M6)
# el1011-q-kvd 2026-10-11: route_master's --routing-layers ${RLAYERS:-M2 M7} came after EXTRA and overrode its 'M2 M6', so the
# first views routed signals on M7 (parent strap layer). Layer contract via RLAYERS; PINKO = pin-access keepout.
RLAYERS='M2 M6'
PINKO=1
