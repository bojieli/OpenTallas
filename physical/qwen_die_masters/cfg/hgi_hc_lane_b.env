# (b: larger outline, PD .40) hfd_hc_eng lane slice (hgi-1010 b, 2026-10-11; hbm-phys: the hardened, replicated element of the FUSED HC engine, 32 a slot):
# VM bank lane (read credits / response router / quad FIFO / P1 buffer / write FIFO), one 64x512 SRAM (the write FIFO).
TOP=ot_hgi_hc_lane
SRCS='rtl/hbm_accel/generic/peers/ot_hgi_hc_eng.sv rtl/link/ot_fifo_sram_fwft.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param LQ=32 --param QD=4 --param FD=64 --param NR=20 --param NB=80)
FW=302.4
FH=345.6
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(wrq|wrq_cr|wrr|wwq|wwq_cr|wwq_done)(\[|$)=bottom' --pin-region '^(clr|post|p1n|wg_q|iss|iss_sec|iss_j0|sc_set|sc_ix|popq|pb_re|pb_ra|push|pdat)(\[|$)=left' --pin-region '^(pb_q|q_head|q_nz|q_full|cr_nz|p1_full|sc_pend|sc_v|sc_vix|sc_d|pop|occ_o|quiet|ovf)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM=''
CLKPORT=clk
PD=0.40
NC=8
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_hc_lane_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
