# New distinct RSO master. Existing closed IO cfg/view stays intact.
# These are intrinsic source0 child candidates, not native phase/pin adoption.
source physical/qwen_die_masters/cfg/engc_io_b.env
TOP=ot_engc_t_io_rso_r1
SRCS='rtl/dsrom_sys/engram/rso_candidate/ot_engc_t_io_rso_r1.sv rtl/dsrom_sys/s81_ctrl/ot_s81_secded.sv rtl/lib/ot_reset_sync.sv rtl/dsrom_sys/engram/rso_candidate/ot_async_fifo_rso.sv rtl/dsrom_sys/engram/rso_candidate/ot_s81_engine_adapter_rso.sv rtl/dsrom_sys/engram/rso_candidate/ot_s81_slab_ep_rso.sv'
PINS+=(--pin-region '^rso$=left:32-37')
QDMD=/src/physical/s81_engc_tiles/rso_closure
SDCF=child_mean.sdc
ROUTE_PERIOD_NS=0.833333
