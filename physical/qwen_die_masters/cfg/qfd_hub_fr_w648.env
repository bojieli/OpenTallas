# FULL-RATE successor of qfd_hub (gate link_credit_rtt, claude/qwen-contracts-20261007): ot_qwen_die_hub_fr_top =
# the r21 hub with link credits CR=128 (remote receive buffer 128 x 523 b a link, >= the measured 117/119-cycle credit
# round trip of the 54/55-station forwarded link), per-link 8-word output FIFOs, 8-word x3 skid, 6-bit native fault
# cause.  Same pins/order as qfd_hub (E face, scaled to the frame) + fault_cause on the top face; same multi-clock kit.
# Frame 648.0 x 648.0 (predecessor 412.536: +0.2497 mm2) for ~0.27 M added flops at <= 55-60 % util.
TOP=ot_qwen_die_hub_fr_top
SRCS='rtl/physical/ot_qwen_die_hub_fr.sv rtl/physical/ot_qwen_die_cdc_ch.sv rtl/lib/ot_async_fifo.sv rtl/lib/ot_reset_sync.sv'
PARAMS=()
FW=648.0
FH=648.0
PINS=(--pin-region '^l2_(i|o)(\[|$)=right:6.3-97.4' --pin-region '^x3_(v|d|tag|cr)(\[|$)=right:100.5-188.5' --pin-region '^ar_(v|d|cr)(\[|$)=right:191.6-279.6' --pin-region '^l3_(i|o)(\[|$)=right:282.7-373.8' --pin-region '^l0_(i|o)(\[|$)=right:377.0-507.4' --pin-region '^l1_(i|o)(\[|$)=right:510.5-640.9' --pin-region '^(ck|fck0|fck1|fck2|fck3|rst_n|fault|fault_cause.*)$=top:157.1-471.2')
INTER='*'
REFGLOB='*ard_q*'
CLKPORT=ck
QDMD=/src/physical/qwen_die_masters/mc/qfd_hub_fr
SDCF=plain.sdc
PD=0.5
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
# the 128 x 523 receive buffer (66,944 bits) is a flop memory by design: lift the ORFS synth memory cap
export OT_SYNTH_MEMORY_MAX_BITS=262144
