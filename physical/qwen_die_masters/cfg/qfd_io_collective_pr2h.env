# el1011-q-coll 2026-10-11 HIERARCHICAL PARENT of qfd_io_collective (pr2h = pr2m + FSL 1): the all-reduce fold is four
# hardened lane slices (ot_coll_fold_slice, closed as qfd_io_collective_fs-b760fc991: TT +231.10 / FF +2.85), consumed as
# macros (abstract LEF + TT/SS/FF timing models in physical/qwen_die_masters/hard/ot_coll_fold_slice); each slice has its
# own clock tree, the parent tree drives ~10k head / s0 / pin registers + 8 macro clock pins (was ~120k sinks flat).
# Outline 520 x 840, slice stack left (MY), 100 um channel, FIFO column right (icoll_h_place.tcl).
TOP=ot_rom_oneshot_die_m
SRCS='rtl/rom/ot_rom_oneshot_die_m.sv rtl/rom/ot_coll_rst_leaf.sv rtl/lib/ot_hdly.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1/ot_sram_1r1w_32x546_m1_bb.v physical/qwen_die_masters/hard/ot_coll_fold_slice/ot_coll_fold_slice_bb.v'
PARAMS=(--param N=4 --param RANK=0 --param LANES=16 --param TAGW=32 --param DEPTH=32 --param ADD_LAT=7 --param IB=4 --param PR=2 --param TXK=1 --param FPIPE=1 --param HDLO=${OT_HDLO:-0} --param MEMM=1 --param FSL=1)
FW=520.0
FH=840.0
PINS=(--pin-region '^(out_valid|out_data|out_last|out_rank|out_err)(\[|$)=left:40-810' --pin-region '^(in_valid|in_cr|in_data|in_last|in_mode|in_tag)(\[|$)=bottom:20-500' --pin-region '^(tx_valid|tx_rec|tx_ready|cr_in|cr_out)(\[|$)=right:20-200' --pin-region '^(rx_valid|rx_rec)(\[|$)=right:220-820' --pin-region '^(clk|rst_n|fault|fault_code)(\[|$)=top:150-370')
INTER='*'
REFGLOB='*s0_v*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1 physical/qwen_die_masters/hard/ot_coll_fold_slice)
EXTRA=()
STAGES=pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
EXTRA=(--macro-view ot_coll_fold_slice=physical/qwen_die_masters/hard/ot_coll_fold_slice --macro-view ot_sram_1r1w_32x546_m1=physical/asap7_memory_macros/ot_sram_1r1w_32x546_m1 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_icoll_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/icoll_h_place.tcl --step-tcl PRE_FLOORPLAN=physical/qwen_die_masters/hdly_dont_touch.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
