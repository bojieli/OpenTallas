# hgi-takeover 2026-10-09 (die gap 7): the native index scorer's hardened ELEMENT = one L4 column tap (hfd_idx_score
# L=4: one NK4 slice, 2 key-line ports; FA 6 / CRED 128 as the native L16 grid). The L16 native grid (2000 x 3000 um,
# ~3.05 mm2 of cells, ~16M cells flat) is composed of 4 taps (T = 4 path of tb_hfd_idx_die) rather than routed flat.
TOP=hfd_idx_score
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_score.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv rtl/hdc/v41x/ot_hdc_v41x_idx_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith_lat.sv rtl/hdc/v41x/ot_hdc_v41x_idx_arith.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hbm_accel/service/ot_hbm_accel_cdc_fifo.sv'
PARAMS=(--param L=4 --param FA=6 --param CRED=128 --param LANE0=0 --param FWD=0)
FW=1400
FH=1250
PINS=(--pin-region '^(ik|ikf|ikc)(\[|$)=left:10-1240' --pin-region '^q(\[|$)=top:10-1390' --pin-region '^(qx|s|sc|st)(\[|$)=right:10-1240' --pin-region '^(ck|rst)$=bottom:680-720')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='*_q*'
CLKPORT=ck
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
