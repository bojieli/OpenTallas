# Full TCUT7/SMIN7 lane: 48 input positions and 48 output positions; 16 replicas.
TOP=ot_qwen_spine_lane
SRCS='rtl/physical/ot_qwen_spine_lane.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=(--param TREE_LAT=7)
FW=600.048
FH=600.048
PINS=(--pin-region '^t_in(\[|$)=left:15-585' --pin-region '^y(\[|$)=right:15-585' --pin-region '^(clk|rst_n|sel_e|tv_e|fault)(\[|$)=bottom:50-550')
INTER='*'
REFGLOB='*tin_q*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=pnr
