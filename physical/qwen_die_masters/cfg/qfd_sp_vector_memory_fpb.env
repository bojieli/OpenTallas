# fe-push-qwen-1010 (2026-10-10): qfd_sp_vector_memory_bv with XQT=1 and a fixed macro placement.  (1) No bv route ever got
# past floorplan: the floorplan worst was -2,429 ps on x_dsp -> span_n = ((1 << x_dsp) - 1) * x_dcs -> span_n / 1,008 (a
# 37-bit constant divide) -> h_b[0]; XQT = 1 makes the span a shift-subtract and the beat count a table over the legal
# descriptor set (0 cycles; exact for every legal descriptor; illegal -> x_fault as before; Verilator ports + landed
# benches exact, table-off-by-one mutant FAILS).  (2) RTLMP failed MPL-0003 (mixed-cluster tiling) on every outline:
# MACRO_PLACEMENT_TCL vm_bv_place.tcl places the 224 SRAMs in columns (SU copies at the SU face, copy 0 above, pairs
# adjacent, even std-cell channels).  Variant b: 1,036.8 x 6,220.8 (fill-5's wider outline), 4 macro columns.
TOP=ot_qfd_sp_vector_memory_bv
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_sp_vector_memory_bv.sv rtl/qwen_sys/vm_me_20261008/ot_qfd_res_path.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_vector_memory.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param XQT=1 --param USE_MACRO=1 --param XVM=15 --param CRB=16)
FW=1036.8
FH=6220.8
PINS=(--pin-region '^(clk|rst_n|me_en)$=top' --pin-region '^(x_dv|x_dc|x_dcs|x_dsp|x_rdy|x_fault|x_hazard|mx_\w+|land_cnt|me_ok)(\[|$)=top' --pin-region '^x_q\[[0-9]*[02468]\]$=left' --pin-region '^x_q\[[0-9]*[13579]\]$=right' --pin-region '^(s_\w+|sw_\w+|rd_\w+|w_\w+|r_\w+|w_fault|w_hazard)(\[|$)=bottom' --pin-region '^rb_(v|end|nul|row|mask|cr|ok)(\[|$)=right' --pin-region '^rb_data\[[0-9]*[02468]\]$=right' --pin-region '^rb_data\[[0-9]*[13579]\]$=left')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/vm_bv_place.tcl --orfs-var 'GLOBAL_ROUTE_ARGS=-congestion_report_iter_step 5 -verbose -critical_nets_percentage 0')
STAGES=pnr
