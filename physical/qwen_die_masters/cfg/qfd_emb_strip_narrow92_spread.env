# Separate 92.256x2000um shoreline-column candidate; preserves 26mm outline dimension. Actual placement and occupancy remain OPEN.
# Narrow/tall standalone alternative matches96.768um concentrator width; existing concentrator occupancy and die relay hops remain OPEN.
# Standalone enlarged pin-access vehicle: model qwen_embedding_hbm_closure_model; 8288 return pins need two-layer access. Die slot allocation remains OPEN.
# emb-hbm 2026-10-08 (r21c, NOT YET ROUTED: design review first): the per-stack strip embedding engine (ot_qfd_emb_strip,
# core clock) as a stand-alone route vehicle; on the die it sits in the qfd_kvc frame beside the strip-end link endpoint
# and taps the 32 PC landing words there.  ~41 k flops (32 x 4 x 258-b return FIFOs dominate).  Its 32 x 258-b return
# inputs (8.3 k pins) set the frame: two faces, M4/M5.
TOP=ot_qfd_emb_strip
SRCS='rtl/qwen_sys/emb_hbm_20261008/synth/ot_qfd_emb_strip.sv'
PARAMS=()
FW=92.256
FH=2000.0
PINS=(--pin-region '^(e_v|e_d)(\[|$)=left' --pin-region '^(s_m|s_we|s_bank|s_col|s_row|s_cr|w_m|w_d)(\[|$)=right' --pin-region '^(i_v|i_d|i_cr|o_v|o_d|o_cr)(\[|$)=bottom' --pin-region '^(clk|rst_n|fault|fault_code|ce_cnt|ue_info)(\[|$)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr

# Qualified against the actual implemented clock domain; async FIFOs are instantiated in the die/bench.
ROUTE_PERIOD_NS=0.770
QDMD=/src/physical/qwen_die_masters/mc/qfd_emb_strip_narrow92_spread
SDCF=plain.sdc

# Bind the two planned access layers and prevent one-track local clustering.
PIN_H="M4 M6"
PIN_V="M5 M7"
PIN_MIN_TRACKS=2
