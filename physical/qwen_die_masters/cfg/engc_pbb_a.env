# el1011-ds-misc/engram 2026-10-11: ALL-TILE dsfd_engram_c (textbook class 1: no top-level register; physical spec in
# el1011-ds-misc.log 'PHYSICAL SPEC dsfd_engram_c ALL-TILE').  T_PBB = prefetch bank 1 (6 SRAM 3x2 at 43.2 um channels / edge margins, 691.2 x 120.96 for ~53% util, write transit {bank2, bank0} N face -> E face; read out E face top).
# Variant a: PD 0.45.  Own clock tree (clock port ck), every input a pin flop, every output a flop.
TOP=ot_engc_t_pbb
SRCS='rtl/dsrom_sys/engram/tiles/ot_engc_pbank.sv rtl/v41rom/ot_v41_kreg.sv physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v'
PARAMS=()
FW=691.2
FH=120.96
CLKPORT=ck
SDCF=die_p770_ck.sdc
PINS=(--pin-region '^(w_oh|w_a|w_d)(\[|$)=top:8-150' --pin-region '^x_d(\[|$)=top:152-300' --pin-region '^(ck|rst)$=top:392-400' --pin-region '^(x_oh|x_a)(\[|$)|^x_do\[([0-9]|[1-5][0-9]|6[0-3])\]=right:4-30' --pin-region '^x_do\[(6[4-9]|[7-9][0-9]|[1-3][0-9][0-9])\]=right:30-88' --pin-region '^(r_oh|r_a|r_d)(\[|$)=right:90-118')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*wa_p*'
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/s81_ph_views/common/pdn_view_sram.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/s81_engc_tiles/pbb_place.tcl)
STAGES=pnr
