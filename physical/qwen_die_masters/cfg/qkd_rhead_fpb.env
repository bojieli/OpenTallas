# fe-push-qwen-1010 2026-10-10: qkd_rhead fallback fpb = variant c pins / mirror rules + FP=1 (ANR lane adders, quad reset
# leaves, per-group node-slice select; 0 cycles; tb_rhead_fp lockstep vs FP=0).  rhead_b/c: floorplan -1,799 / place -596..-717 on
# the reset-leaf -> adder cut-bundle RESETN and g_s3[0].u_ltd -> nb_d classes.  Frame 648 x 518.4 (+64.8 um tall, PD 0.45: util headroom; die plan must grow the head row by 64.8 um).
# kv-die 2026-10-09 re-cut H: one HEAD tile of the near-HBM row engine (ot_qwen_nearhbm_head_h: 128 lanes + K tree + scale + the
# local P.V lanes + the head's q rows), a hard sub-tile; 4 a engine above / below the engine control tile.  Variant c (648 wide: a head pair one tile from the control tile stays inside the wire reach; one hard tile for all four heads via the hid strap).
TOP=ot_qwen_nearhbm_head_h
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_stack_h.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param HD=128 --param H=0 --param FP=1)
FW=648.0
FH=518.4
PINS=(--pin-region '^(c_in|row_in|e_in|lt_in|hid|q_valid_in|q_beat_in|q_data_in|sc_d|sc_f|g_f)(\[|$)=bottom' --pin-region '^(nb_d)(\[|$)=right' --pin-region '^(clk|rst_n)(\[|$)=left')
INTER='*'
REFGLOB='*q_valid_in*'
SDCF=die_p770.sdc
PD=0.45
NC=16
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var SYNTH_MEMORY_MAX_BITS=262144 --orfs-var GPL_TIMING_DRIVEN=0)
PIN_H='M4'   # mirror-legal: the die places heads 0 / 1 MX (M6 pins have no legal MX origin together with M4 / M8)
PIN_V='M5'   # mirror-legal: col-1 engines are MY / R180 (M7 pins have no legal MY origin together with M5)
STAGES=pnr
PIN_MIN_TRACKS=2
