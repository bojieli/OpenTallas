# redesign-qwen 2026-10-10 (kv-die 04:35, option 4 r22k): qfd_sp_su64_sfu_bv with its issue / status pins (go, i_*, a_src, tok, ready,
# idle, obs_*, progress*, fault) on the E face, toward qfd_seq_su in the free E slot at the SU top (x 12,455): the SU<->TT snapshot
# path then starts 6.2 mm from the tree-top tile (~15 instead of ~21 stations a way).  Pin plan only, no RTL change.  Variant a.
TOP=ot_qfd_sp_su64_sfu_bv
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_su_master_bv.sv rtl/qwen_sys/rtl_finish_20261007/ot_qfd_su_master.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/ot_hdc_vstream_lane.sv rtl/hdc/ot_hdc_vreduce.sv rtl/hdc/ot_hdc_vstream.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv'
PARAMS=(--param IS=1 --param OS=1 --param VL=7)
FW=777.6
FH=2058.48
PINS=(--pin-region '^(clk|rst_n)$=left' --pin-region '^(crom_\w+|ea_\w+|eq_\w+|kv_\w+|wrom_fault)(\[|$)=left' --pin-region '^(i_\w+|go|a_src|tok|ready|idle|obs_\w+|progress|progress_rows|fault)(\[|$)=right' --pin-region '^(s_\w+|sw_\w+|red_\w+)(\[|$)=top')
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
PD=0.55
NC=16
MACROS=()
EXTRA=()
STAGES=synth,pnr
PIN_H='M4 M6'
PIN_V='M5 M7'

