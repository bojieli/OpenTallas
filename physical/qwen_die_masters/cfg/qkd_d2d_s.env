# el1011-q-kvd 2026-10-11: qkd_d2d_s = qkd_d2d_b with the deep link buffers SRAM-bodied (SBD=16: TX RES/EMBD 48 and RX Q/KVN 32 in 4 ot_sram_1r1w_64x512 macros, ot_qkvd_fifo_sb), 20 um macro channels, macro PDN.
TOP=ot_qkvd_kv_end
SRCS='rtl/qwen_sys/kv_die_20261009/ot_qkvd_kv_end.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_d2d.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo.sv rtl/qwen_sys/kv_die_20261009/ot_qkvd_fifo_sb.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param QD=48 --param UCX=48 --param SBD=16)
FW=777.6
FH=518.4
PINS=(--pin-region '^(t_v|t_d|t_cr|r_v|r_d|r_cr)(\[|$)=bottom' --pin-region '^(tx_up|tx_v|tx_flit|rx_v|rx_flit)(\[|$)=top' --pin-region '^(clk|rst_n|fault|fault_cause)(\[|$)=left')
INTER='t_*,r_*,fault*'
REFGLOB='*ci_v*'
SDCF=die_p770.sdc
PD=0.45
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros_v2/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkd_d2d_sb_place.tcl)
