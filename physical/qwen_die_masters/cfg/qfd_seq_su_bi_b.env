# qwen-1010/a: ot_qfd_seq_su_bi = the boundary successor + ICUT (registered readiness) + station resets from the registered tile reset.
# Old route inputs unchanged; adoption also needs E issue/status/S constant-port SU acceptance successor.
# stream unit (2 + 2 stations).  No ME issue / status pins (the ME side runs in qfd_tt_ctlm); the ME snapshot (x_*)
# arrives over the SU <-> tree-top relays.  Pin flops at the pins.  Variant b: 648.0 x 432.0.
# 2026-10-10: program store (64 x 1,024 b) in two 64 x 512 SRAM macros (was 65,536 flops; tb_prog_store cycle-identical).
TOP=ot_qfd_seq_su_bi
SRCS='rtl/qwen_sys/redesign_qwen/ot_qfd_seq_su_bi.sv rtl/rom/ot_qwen_tp_seq_w12.sv rtl/rom/ot_rom_pkg_link.sv rtl/rom/ot_rom_pkg_ctrl.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_split_exact.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_dyn_ttiles.sv rtl/hdc/ot_hdc_qwen_int8_embed_decode.sv rtl/hdc/ot_hdc_cg.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=()
FW=648.0
FH=432.0
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(pi_su_|po_su_|su_tok|su_asrc).*=left' --pin-region '^(x_|me_.*_o|su_.*_o).*=top' --pin-region '^(h_start|tp_|kv_|vm_rq|c_ready|r_|pw_|dw_).*=bottom' --pin-region '^(?!(c_ready|vm_rq|su_.*_o))(s_|seq_|core_|coll_|vm_|c_|rom_).*=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
export OT_MULTI_VT=lvt
