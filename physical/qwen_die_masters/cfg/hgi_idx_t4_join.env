# Full128-credit atomic four-tap join sized before physical implementation.
TOP=hfd_idx_t4_join
SRCS='physical/hbm_accel_die_views/index/rtl/hfd_idx_t4_join.sv physical/hbm_accel_die_views/index/rtl/hfd_idx_lib.sv'
PARAMS=()
FW=420
FH=360
PINS=(--pin-region '^(taps)(\[|$)=left:10-350' --pin-region '^(tap_credit)(\[|$)=left:10-350' --pin-region '^(s|sc|fault)(\[|$)=right:10-350' --pin-region '^(ck|rst)$=bottom:200-220')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER='*'
REFGLOB='sv sd* tap_credit*'
CLKPORT=ck
PD=0.55
NC=16
MACROS=()
EXTRA=(--orfs-var SYNTH_MEMORY_MAX_BITS=19584)
STAGES=synth,pnr
SDCF=die_p770_ck.sdc
