# el1011-ds-misc/pqc 2026-10-11: COMPOSITION of the DS-ROM PQ spine screen ot_v41_pqc_spine_screen (R 16, XRV 1, v15
# hierarchical spine, TT 1) from 17 hardened tiles (views under physical/s81_pq_hier/views/<name>/: LEF + SS/FF/TT liberty, installed
# by physical/s81_pq_hier/compose/install_views.sh from the adopted el1011-pqc-<tile>-* routes):
#   T_AQ x2 (ot_dsrom_aq12t), T_IX x4, T_QB, T_CTL (ot_pqc_t_ctl16, holds the scalar pin / out registers), T_RET x2,
#   T_BC x4 (broadcast relays), T_SROM, T_PROM x2.  Top level keeps only the q_x pin flops (2048) and o_bus (1630).
# Floorplan: compose/macro_place.tcl (bands: top AQ0|IX0 IX2 IX1 IX3|AQ1 under the x_q pins; middle CTL|QB|BC0..3 -> E;
# bottom RET0/1 on the region pins, ROM tiles SW).  PDN: compose/pdn_pqc_h.tcl (engram_c_h recipe: M8 straps + tile
# grid M7-M8, halo 2).  Die 1123.2 x 738.72 um.
TOP=ot_v41_pqc_spine_screen
SRCS='physical/s81_pq_hier/compose/ot_pqc_tiles_bb.v physical/s81_pq_hier/pinned/rtl/common/ot_prefix.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_delay.sv physical/s81_pq_hier/pinned/rtl/hdc/ot_hdc_prefix.sv physical/s81_pq_hier/pinned/rtl/ot_rst_relay.sv physical/s81_pq_hier/pinned/rtl/v41rom/ot_v41_kreg.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_pqc_tiles.sv physical/s81_pq_hier/pinned/rtl/v41die/ot_v41_spine_pqc_w17w10.sv physical/s81_pq_hier/pinned/physical/dsrom_field_spine/ot_v41_pqc_spine_screen.sv'
PARAMS=(--param XRV=1 --param XCAP=16 --param TT=1)
FW=1123.2
FH=738.72
PINS=(--pin-region '^(x_q|x_rv|o_x_re|o_x_addr)(\[|$)=top:8-1115' --pin-region '^(clk|rst_n|go|i_ph|i_np|i_xbase|i_xps|i_obase|i_ops|i_fmt|f_fault|rw_ph|rw_st|rw_a|rw_d|o_ready|o_idle|o_fault|o_ev)(\[|$)=left:8-730' --pin-region '^(r_v|r_row|r_pos|r_fp32|r_bf16|r_e|o_w_we|o_w_addr|o_w_data)(\[|$)=bottom:300-823' --pin-region '^(o_bus)(\[|$)=right:8-730')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*q_x*'
PD=0.55
NC=16
MACROS=(physical/s81_pq_hier/views/ot_dsrom_aq12t physical/s81_pq_hier/views/ot_pqc_t_ix physical/s81_pq_hier/views/ot_pqc_t_qb physical/s81_pq_hier/views/ot_pqc_t_ret physical/s81_pq_hier/views/ot_pqc_t_bc physical/s81_pq_hier/views/ot_pqc_t_ctl16 physical/s81_pq_hier/views/ot_pqc_t_srom physical/s81_pq_hier/views/ot_pqc_t_prom physical/s81_pq_hier/views/ot_pqc_t_xin)
EXTRA=(--macro-view ot_dsrom_aq12t=physical/s81_pq_hier/views/ot_dsrom_aq12t --macro-view ot_pqc_t_ix=physical/s81_pq_hier/views/ot_pqc_t_ix --macro-view ot_pqc_t_qb=physical/s81_pq_hier/views/ot_pqc_t_qb --macro-view ot_pqc_t_ret=physical/s81_pq_hier/views/ot_pqc_t_ret --macro-view ot_pqc_t_bc=physical/s81_pq_hier/views/ot_pqc_t_bc --macro-view ot_pqc_t_ctl16=physical/s81_pq_hier/views/ot_pqc_t_ctl16 --macro-view ot_pqc_t_srom=physical/s81_pq_hier/views/ot_pqc_t_srom --macro-view ot_pqc_t_prom=physical/s81_pq_hier/views/ot_pqc_t_prom --macro-view ot_pqc_t_xin=physical/s81_pq_hier/views/ot_pqc_t_xin --macro-place-halo 2 2 --orfs-var PDN_TCL=/src/physical/s81_pq_hier/compose/pdn_pqc_h.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/s81_pq_hier/compose/macro_place.tcl)
STAGES=pnr
# no boundary registers at the top: IO against a virtual clock (compose/sdc/io_vclk.sdc), CTS balances the tile clock
# pins on their liberty insertion delays at the full difference (delay_buffer_derate 1.0)
QDMD=/src/physical/s81_pq_hier/compose/sdc
SDCF=screen_p770.sdc
CTSA='-sink_clustering_enable -repair_clock_nets -delay_buffer_derate 1.0'
