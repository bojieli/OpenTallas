# redesign-qwen 2026-10-09: tree-top UPPER sub-tile (one of 4 stacked along the old tree top's tall axis): ot_qfd_band_upper
# NL 4 = levels 11 / 12 for 4 lanes over the 6 band words (16 FP32 adders LAT 7), pin flops on its 768 band-word bits,
# its own 384-b level-12 return station.  The select / valid arrive through CR = 1 relay from the control tile (DLY 1).
# Pins spread over two faces and two layers per face (band words W, returns E; ~1 b/um/layer).  Variant b: 345.6 x 388.8.
TOP=ot_qfd_band_upper
SRCS='rtl/qwen_sys/rtl_finish_20261007/ot_qfd_sp_tree_top.sv rtl/qwen_sys/redesign_qwen/ot_qfd_tt_split.sv rtl/qwen_sys/lane_band_20261008/ot_qfd_band_lanes.sv rtl/qwen_sys/missing_masters_20261007/ot_qfd_spine_masters.sv rtl/hdc/ot_qwen_me_spine_h_w12.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_qwen_w12_arith.sv rtl/hdc/ot_qwen_w12_matvec.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_sfu.sv'
PARAMS=(--param NL=4 --param NB=6 --param LNK=0 --param DLY=1 --param TREE_LAT=7 --param TCUT=7 --param LG=13)
FW=345.6
FH=388.8
PINS=(--pin-region '^(clk|rst_n)$=top' --pin-region '^(pw|pw_v|lf)(\[|$)=left' --pin-region '^(tt_ty|tt_use|tt_v|fault)(\[|$)=right' --pin-region '^(sel_e|tv_e)(\[|$)=bottom')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=16
MACROS=()
EXTRA=(--step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=synth,pnr
export OT_MULTI_VT=lvt
