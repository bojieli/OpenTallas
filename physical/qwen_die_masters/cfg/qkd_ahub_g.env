# qwen-1010/b 2026-10-11: qkd_ahub_g = qkd_ahub_fe (hardcore-1010 fe-h ANR adders) + PSRAM 1: the P.V beat buffer pb (256 x 512 b)
# in 8 ot_sram_1r1w_128x256 macros (two per stack) and the Z store zm packed as one vector (flops by design), so the
# SYNTH_MEMORY_MAX_BITS=262144 override is gone.  Bit-identical, 0 cycles (layer bench HPS=1 exact; PBMUT caught).
TOP=ot_qwen_nearhbm_attn_hub_p
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_hub_p.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_delay.sv physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v'
PARAMS=(--param HD=128 --param ANR=1 --param PSRAM=1)
FW=648
FH=648
PINS=(--pin-region '^(si_|pi_)[a-z_]*(\[|$)=bottom' --pin-region '^(mo_)[a-z_]*(\[|$)=left' --pin-region '^(out_|start|fault|ev)[a-z_]*(\[|$)=top' --pin-region '^(clk|rst_n)(\[|$)=right')
INTER='si_*,pi_*,mo_*,out_*,start,fault,ev*'
REFGLOB='*_b*'
SDCF=die_p770.sdc
PD=0.50
NC=16
MACROS=(physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros_v2/ot_sram_1r1w_128x256_m1_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
