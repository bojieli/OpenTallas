# Fail before synthesis/route on absent, stale or unqualified component views.
python3 tools/qwen_embedding_parent_binding.py --kind scale \
  --view physical/qwen_embedding_parent/bindings/scale/qfd_embed_ingress_scale \
  --receipt physical/qwen_embedding_parent/bindings/scale/receipt --verify || exit $?
TOP=ot_qwen_embed_scale_bank_parent
SRCS='physical/qwen_embedding_parent/scale/ingress_bb.v rtl/physical/ot_qwen_embed_scale_bank_parent.sv physical/asap7_memory_macros/ot_rom_4096x266_m8/ot_rom_4096x266_m8_bb.v'
PARAMS=(--param OCRED=4 --param BANK_ID=2)
FW=160
FH=100.44
PINS=(--pin-region '^(i_(v|row|cr)|o_cr)(\[|$)=left' --pin-region '^o_(v|data)(\[|$)=right' --pin-region '^(clk|rst_n|fault)$=bottom')
INTER='i_*,o_*,fault'
REFGLOB='*iv_q*'
SDCF=embed_scale_p770.sdc
PD=0.55
NC=8
MACROS=(physical/qwen_embedding_parent/bindings/scale/qfd_embed_ingress_scale physical/asap7_memory_macros/ot_rom_4096x266_m8)
EXTRA=(--macro-view qfd_embed_ingress_scale=physical/qwen_embedding_parent/bindings/scale/qfd_embed_ingress_scale --macro-view ot_rom_4096x266_m8=physical/asap7_memory_macros/ot_rom_4096x266_m8 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_embedding_parent/scale/place.tcl)
STAGES=pnr
QDMD=/src/physical/qwen_embedding_parent/scale
