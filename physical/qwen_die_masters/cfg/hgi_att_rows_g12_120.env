# HGI-1 G12; exact physical wrapper with registered command/ID boundaries.
TOP=ot_hgi_att_row_sources_p
SRCS='rtl/hbm_accel/generic/g12/ot_hgi_att_row_sources.sv rtl/hbm_accel/generic/g12/ot_hgi_att_row_sources_p.sv'
PARAMS=()
FW=120
FH=120
PINS=(--pin-region '^(cmd_v|cmd_r|ring|pos1|b_n|b_m|c_n)(\[|$)=left:4-116' --pin-region '^(c_id_v|c_id_r|c_id)(\[|$)=bottom:4-116' --pin-region '^(row_v|row_r|row_source|row_last|row_index|row_ordinal)(\[|$)=right:4-116' --pin-region '^(clk|rst_n|busy|done|fault)$=top:4-116')
INTER='*'
REFGLOB='*index_q*'
CLKPORT=clk
PD=0.55
NC=8
MACROS=()
EXTRA=()
STAGES=synth,pnr
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
