TOP=ot_qwen_nearhbm_row_engine_d
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_stack_d.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_prod.sv rtl/hdc/ot_hdc_sfu_q.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/proto/ot_fp32_add_rne_pipe.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv'
PARAMS=(--param HD=128 --param R=8 --param E=0)
FW=590.4
FH=1998.0
PINS=(--pin-region '^(start_in|T_in|cyc8_in|q_valid_in|q_beat_in|q_data_in|exp_done|er_|sc_|lmax|nb_|k_done|v_done|fault|ev_)[a-z_0-9]*(\[|$)=right' --pin-region '^(req_|rsp_)[a-z_]*(\[|$)=left' --pin-region '^(clk|rst_n)(\[|$)=top')
INTER='req_*,rsp_*'
REFGLOB='*req_valid*'
SDCF=die_p770.sdc
PD=0.45
NC=16
EXTRA=(--orfs-var ADDER_MAP_FILE= --orfs-var SYNTH_MEMORY_MAX_BITS=262144 --orfs-var GPL_TIMING_DRIVEN=0)
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
