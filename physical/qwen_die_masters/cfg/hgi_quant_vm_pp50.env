# hgi-1010/d5 2026-10-10: ot_hgi_quant_vm_transport_p, the pipelined quant VM transport (result FIFO on one 64x512 SRAM,
# precomputed request descriptors, R1/R2 response lanes, unreset payloads) as a compact hardened element.  The historical
# 1,800 x 275.6 strip spread a ~29k um2 block over 496k um2 (6 %) with cmd pins along 1,780 um: every cone was a wire.
TOP=ot_hgi_quant_vm_transport_p
SRCS='rtl/hbm_accel/generic/ot_hgi_quant_vm_transport_p.sv rtl/link/ot_fifo_sram_fwft.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v rtl/hbm_accel/generic/ot_hgi_quant_decode.sv physical/hbm_accel_die_views/common/ot_hfd_oreg1.sv physical/hbm_accel_die_views/quant/rtl/ot_hfd_actquant_m.sv rtl/hbm_accel/generic/ot_hgi_fp4qdq.sv rtl/hdc/ot_hdc_delay.sv rtl/hdc/ot_hdc_fpu.sv rtl/hdc/ot_hdc_fp32_mul_pipe.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_fastfp_lat_f12.sv rtl/hdc/ot_hdc_fp32_f12.sv rtl/hdc/ot_hdc_prefix.sv'
PARAMS=(--param ENABLE=1 --param DEPTH=32)
FW=432.0
FH=259.2
PINS=(--pin-region '^rsp\[=left:10-150' --pin-region '^cmd\[=bottom:10-422' --pin-region '^req\[=right:10-150' --pin-region '^(clk|rst_n|ready|done|fault|drained|req_v|req_r|rsp_v|rsp_r|provider_fault)$=top:10-120')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
INTER='*'
REFGLOB='*seat*'
CLKPORT=clk
PD=0.50
NC=12
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/hgi_quant_vm_pp_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
