# NS8 full result serializer, hardened one-slot element; replicated eight/band.
TOP=ot_qfd_res_slot_tile
SRCS='rtl/qwen_sys/vm_me_20261008/ot_qfd_res_tiles.sv rtl/qwen_sys/vm_me_20261008/ot_qfd_res_path.sv physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2/ot_sram_1r1w_64x512_m1_r2c2_bb.v'
PARAMS=(--param USE_MACRO=1)
FW=259.2
FH=324.0
PINS=(--pin-region '^(clk|rst_n|me_en|i_ov|slot_id)(\[|$)=top' --pin-region '^i_(we|last|empty|addr|mask|data)(\[|$)=bottom' --pin-region '^(rq_v|rq_slot|rq_ptr|rv|rd)(\[|$)=left' --pin-region '^(rqf_v|rqf_slot|rqf_ptr|ov|od|fault)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM=''
CLKPORT=clk
PD=0.45
NC=8
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_64x512_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_64x512_m1_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/res_slot_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
