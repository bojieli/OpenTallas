# el1011-q-kvd 2026-10-11 (GLUE PLACEMENT rule, item 2): attention-hub CLUSTER = ot_qwen_nearhbm_attn_hub_t over its 12
# hardened tiles (4 x ot_nhb_pbst, 4 x ot_nhb_pvlg, 4 x ot_nhb_zh as views, no parameters on hard children).  The parent
# keeps the coupled hub logic (si_* boundary regs, max, Z control in a 1-cycle RAW loop with the zh tiles, reciprocal,
# rz, P.V control, sr relay band, output regs; ~7k flops, one short tree).  Outline 810 um (fits a- or b-size tiles),
# rows S->N pbst / pvlg / zh (qkd_ahub_t_place.tcl); PDN pdn_qkvd_parent_m7.tcl (tiles M2-M6 + PG M6, parent M7).
TOP=ot_qwen_nearhbm_attn_hub_t
SRCS='rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_hub_t.sv rtl/hdc/nearhbm/ot_nhb_tiles_bb.v rtl/hdc/nearhbm/ot_qwen_nearhbm_attn_hub_p.sv rtl/hdc/nearhbm/ot_qwen_nearhbm_sfu_p.sv rtl/hdc/ot_hdc_sfu.sv rtl/hdc/ot_hdc_fp32_add_lat.sv rtl/hdc/ot_hdc_fp32_add_lat_nr.sv rtl/hdc/ot_hdc_fp32_mul_lat.sv rtl/hdc/ot_hdc_prefix.sv rtl/hdc/ot_hdc_fastfp.sv rtl/hdc/ot_hdc_delay.sv rtl/lib/ot_rst_relay.sv'
PARAMS=()
FW=810.0
FH=810.0
PINS=(--pin-region '^(si_valid|si_type|si_g|si_hh|si_k|si_any|si_data|pi_valid|pi_g|pi_beat|pi_data|start)(\[|$)=bottom' --pin-region '^(out_valid|out_g|out_beat|out_data)(\[|$)=top' --pin-region '^(mo_valid|mo_g|mo_hh|mo_data|fault|ev)(\[|$)=left' --pin-region '^(clk|rst_n)(\[|$)=right')
INTER='none_*'
REFGLOB='*siv_b*'
SDCF=die_p770.sdc
PD=0.55
NC=8
PIN_H='M4 M6'
PIN_V='M5 M7'
STAGES=pnr
PIN_MIN_TRACKS=2
MACROS=(physical/qwen_die_masters/views/ot_nhb_pbst physical/qwen_die_masters/views/ot_nhb_pvlg physical/qwen_die_masters/views/ot_nhb_zh)
EXTRA=(--orfs-var ADDER_MAP_FILE= --macro-view ot_nhb_pbst=physical/qwen_die_masters/views/ot_nhb_pbst --macro-view ot_nhb_pvlg=physical/qwen_die_masters/views/ot_nhb_pvlg --macro-view ot_nhb_zh=physical/qwen_die_masters/views/ot_nhb_zh --macro-place-halo 10.8 10.8 --orfs-var PDN_TCL=/src/physical/qwen_die_masters/pdn_qkvd_parent_m7.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/qkd_ahub_t_place.tcl)
