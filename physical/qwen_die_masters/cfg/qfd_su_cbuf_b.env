# redesign-qwen 2026-10-09: SU-local constant buffer (ot_qfd_crom_lbuf SRAM 1): 8 x ot_sram_1r1w_1024x256 (one per 8-lane
# group: stage banks 0 / 1 + HEAD), rope rows in flops, the prefetcher to the far constant ROM.  Abuts the SU's N face:
# the SU's constant port (crom_*) on S, the far ROM port (f_*) on N toward the relay channel, context pins E.  Answers
# with ot_qfd_crom's 5-edge timing, so the SU runs at ML 7 with the ROM 3 + 3 relays away.  Variant b: 1503.36 x 518.4 LVT (8 lane-group slices, macros in one mid row).
TOP=ot_qfd_su_cbuf
SRCS='rtl/qwen_sys/redesign_qwen/ot_qfd_crom_lbuf.sv rtl/hdc/ot_hdc_delay.sv physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=()
FW=1503.36
FH=518.4
PINS=(--pin-region '^(clk|rst_n)$=right' --pin-region '^(crom_re|crom_addr|crom_stage|crom_q)(\[|$)=bottom' --pin-region '^(f_re|f_addr|f_stage|f_q|f_fault)(\[|$)=top' --pin-region '^(stage|tok_start|tpos|st_rdy|fault|fault_code)(\[|$)=right')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*'
FALSE_FROM='rst_n'
CLKPORT=clk
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 2.16 2.16 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/qwen_die_masters/su_cbuf_place.tcl --step-tcl PRE_GLOBAL_PLACE=physical/qwen_die_masters/io_flop_at_pins.tcl --step-tcl PRE_DETAIL_PLACE=physical/qwen_die_masters/out_flop_release.tcl)
STAGES=pnr
export OT_MULTI_VT=lvt
