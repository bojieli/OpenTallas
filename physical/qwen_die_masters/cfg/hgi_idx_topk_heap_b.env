# hgi-1010/g2 2026-10-10: IDX.TOPK as banked-SRAM pipelined heaps (rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv,
# drop-in core W 2 heaps behind the die's ot_hgi_idx_topk_registered): structural successor of the 2,048-cell flop
# insertion / systolic arrays (feasibility 67b2d0326 item (e)).  Per heap: levels 7-9 in 128x256, level 10 in 256x256,
# the reverse run buffer in 1024x256 1R1W macros (10 macros); every select is a registered 2-way compare.
TOP=ot_hgi_idx_topk_registered
SRCS='rtl/lib/ot_rst_relay.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_heap_dropin.sv rtl/hbm_accel/generic_20261009/ot_hgi_idx_topk_registered.sv physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2/ot_sram_1r1w_128x256_m1_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2/ot_sram_1r1w_256x256_m2_r2c2_bb.v physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2/ot_sram_1r1w_1024x256_m2_r2c2_bb.v'
PARAMS=(--param ENABLE=1)
FW=820
FH=820
PINS=(--pin-region '^(clk|rst_n|cmd_.*)(\[|$)=top:8-810' --pin-region '^in_.*(\[|$)=left:8-810' --pin-region '^(out_.*|done|error)(\[|$)=bottom:8-810')
PIN_H='M4 M6'
PIN_V='M5 M7'
INTER='*'
REFGLOB='*q_id*'
PD=0.45
NC=16
MACROS=(physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2)
EXTRA=(--macro-view ot_sram_1r1w_128x256_m1_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_128x256_m1_r2c2 --macro-view ot_sram_1r1w_256x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_256x256_m2_r2c2 --macro-view ot_sram_1r1w_1024x256_m2_r2c2=physical/asap7_memory_macros/ot_sram_1r1w_1024x256_m2_r2c2 --macro-place-halo 12.96 12.96 --orfs-var PDN_TCL=/src/physical/qwen_slab_m5/pdn_m5.tcl)
STAGES=pnr
