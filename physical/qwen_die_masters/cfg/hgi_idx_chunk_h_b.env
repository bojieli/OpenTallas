# el1011-hbm-idx 2026-10-11: the indexer 8-head chunk, HIERARCHICAL (textbook audit classes 1+2): 32 closed hardened
# slices ot_hdc_v41x_idx_hslice (hgi-idx-hslice-b-a791d4196: TT +90.21 / FF +1.10 ps; 180 x 110 um, own clock tree) as
# 4 north->south systolic columns of 8 + input registers, head straps and the valid line.  1100 x 1350 um, deliberate macro floorplan (place.tcl, 8.64-um grid).
TOP=ot_hdc_v41x_idx_chunk_el
SRCS='physical/hgi_idx_chunk_h/ot_hdc_v41x_idx_hslice_bb.v rtl/hdc/v41x/ot_hdc_v41x_idx_chunk_el.sv rtl/lib/ot_rst_relay.sv rtl/hdc/ot_hdc_delay.sv'
PARAMS=(--param NB=4 --param NKT=4 --param FPL=7 --param FML=5 --param QL=5)
FW=1100
FH=1350
PINS=(--pin-region '^(k_v|k_kv|k_key|ql_v|ql_head|ql_codes|ql_sc|ql_w|hb)(\[|$)=top:10-1090' --pin-region '^(c_v|c_kv|c_sum|c_fault)(\[|$)=bottom:10-1090' --pin-region '^(clk|rst_n)$=left:655-695')
PIN_H='M4 M6'
PIN_V='M5 M7'
PIN_MIN_TRACKS=2
export OT_PIN_GROUP_MAX=32
export OT_PIN_BALANCE_H='M4 M6'
export OT_PIN_BALANCE_V='M5 M7'
INTER=''
REFGLOB='*rkey*'
PD=0.50
NC=16
MACROS=(physical/hgi_idx_chunk_h/views/ot_hdc_v41x_idx_hslice)
EXTRA=(--macro-view ot_hdc_v41x_idx_hslice=physical/hgi_idx_chunk_h/views/ot_hdc_v41x_idx_hslice --macro-place-halo 20.16 20.16 --orfs-var PDN_TCL=/src/physical/hgi_idx_hier/pdn_hier.tcl --orfs-var MACRO_PLACEMENT_TCL=/src/physical/hgi_idx_chunk_h/place.tcl)
STAGES=pnr
