# qfd_emb_pc_00: multi-clock kit (jobs/mk_mc_kit.py); route over-constrained at 770 ps
create_clock -name clk -period 770 [get_ports {clk}]
create_clock -name hclk -period 960 [get_ports {hclk}]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
# unrelated-clock crossings: one period minus the setup uncertainty, both directions; hold: non-negative
set_max_delay -ignore_clock_latency 900.000 -from [get_clocks clk] -to [get_clocks hclk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks clk] -to [get_clocks hclk]
set_max_delay -ignore_clock_latency 710.000 -from [get_clocks hclk] -to [get_clocks clk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks hclk] -to [get_clocks clk]
set_input_delay 166.667 -clock clk [get_ports {s_v w_v s_we s_bank[*] s_col[*] s_row[*] w_d[*]}]
set_output_delay 166.667 -clock clk [get_ports {s_credit e_v e_d[*] fault_core}]
set_input_delay 204.8 -clock hclk [get_ports {cmd_v cmd[*] read_credit[*] r_v r_d[*]}]
set_output_delay 204.8 -clock hclk [get_ports {cmd_credit row_v row_op[*] row_bank[*] row_row[*] col_v col_we col_sr col_bank[*] col_col[*] busy wd[*] kv_v kv_d[*] fault_hbm}]
set_false_path -from [get_ports {rst_n hrst_n}]
set_max_fanout 32 [current_design]
# die-wire context (r21 die STA): one <= 430.56 um hop + receiver pin
set_load 80 [all_outputs]
set_input_transition 150 [all_inputs -no_clocks]
set_max_transition 260 [current_design]
