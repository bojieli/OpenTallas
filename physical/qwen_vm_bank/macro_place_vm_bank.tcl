# Macro placement of the protected Qwen VM bank element (ot_qwen_checked_vm_bank_direct_readback, stream qwen-contracts):
# 256 data macros (4 banks x 16 groups x 4 columns) as 2x2 group clusters in 8 columns (bank b -> columns 2b, 2b+1),
# 32 check macros (16 groups x 2) in column 8 beside their group rows; a 149.9 um logic channel between columns 3 and 4
# (codec / FSM / bank reduction).  Pitch 184.896 x 40.392 um (10.8 um / 10.692 um stdcell gaps), all R0.
set ot_block [ord::get_db_block]
set ot_lut [dict create]
foreach ot_inst [$ot_block getInsts] {
  if {[[$ot_inst getMaster] isBlock]} { dict set ot_lut [string map {"\\" ""} [$ot_inst getName]] [$ot_inst getName] }
}
proc ot_place {name x y} {
  global ot_lut
  if {![dict exists $ot_lut $name]} { error "ot_place: no macro instance $name" }
  place_macro -macro_name [dict get $ot_lut $name] -location [list $x $y] -orientation R0
}
