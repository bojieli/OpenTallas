# mtp-lead 2026-10-09: FF hold IO credit of hfd_cmdproc_s_mtp_native_mx1 (CP-south AR + native MTP, REGB=1).
# AR ports: io_min_hfd_cmdproc_s.sdc verbatim (spine_io_min.py; MX1 keeps AR's outline 1399.656 x 701.976 and every
# AR pin position).  MTP ports (no r16g die path in the generator): the stations model's floor for a connected
# pin-launch flop at gap 0 -- inputs clk->Q 32.2 ps (stn_io_min CLKQ_FF_PS), outputs 0 -- never larger than the
# real R25G die path.  Read after vclk_corner_true.sdc, FF session only (as the AR file).
# generated by physical/hbm_accel_die_views/common/spine_io_min.py for hfd_cmdproc_s (die master hfd_cmdproc):
# FF hold credit of the connected die path per port (read after vclk_corner_true.sdc; FF session only)
if {[llength [get_libs -quiet *_FF_*]] && [llength [get_clocks -quiet vclk]]} {
  sta::redirect_string_begin
  report_clock_latency -clocks core_clk
  set ot_s [sta::redirect_string_end]
  if {[regexp {rise -> rise.*?([0-9.]+)\s+([0-9.]+)\s+latency} $ot_s -> ot_lo ot_hi]} {
    foreach ot_q [get_ports -quiet {cSE cSE[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 172.43}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 140.23 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {cSW cSW[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 172.48}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 140.28 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_loader f_loader[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 141.84}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 109.64 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_router f_router[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 68.78}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 36.58 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SE t_su_SE[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 171.3}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SW t_su_SW[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 171.3}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xb xb[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 32.2}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xl xl[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 32.2}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xt xt[*]}] { set ot_d [ot_port_dir $ot_q]; if {$ot_d in {input bidirect}} { set_input_delay -min [expr {0.0 + 32.2}] -clock vclk $ot_q }; if {$ot_d in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_mtp f_mtp[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_host f_host[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_provider f_provider[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_emit_host f_emit_host[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_am f_am[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_backend f_backend[*]}] { if {[ot_port_dir $ot_q] in {input bidirect}} { set_input_delay -min 32.2 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_mtp t_mtp[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_host t_host[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_emit t_emit[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_provider t_provider[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_emit_host t_emit_host[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_abort t_abort[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_drained t_drained[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_backend t_backend[*]}] { if {[ot_port_dir $ot_q] in {output bidirect}} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    puts "OT_IOMIN: per-port die-path hold credit applied"
  }
}
