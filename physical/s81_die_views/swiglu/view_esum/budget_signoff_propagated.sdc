# generated by tools/budgets/make_block_sdc.py sdc ot_dsrom_su_swiglu_lane --mode signoff from its budget sheet
# vclk at the sheet insertion 430 ps (measured: closure-loop calibrate s81-swiglu-esum-05d995e9b (ot-epyc1tb:/srv/opentallas-scratch/claude/closure-loop/s81-swiglu-esum-05d995e9b)); target 616.7 ps; die entry target SS None
create_clock -name vclk -period [get_property [get_clocks core_clk] period]
set_clock_uncertainty -setup 60 [get_clocks {core_clk vclk}]
set_clock_uncertainty -hold 25 [get_clocks {core_clk vclk}]
set_clock_latency 430 [get_clocks vclk]
set ot_in [all_inputs -no_clocks]
unset_input_delay -clock core_clk $ot_in
unset_output_delay -clock core_clk [all_outputs]
# v input 1b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_input_delay 346.3 -clock vclk [get_ports -quiet {v v[*]}]
set_input_delay -min 46.1 -clock vclk [get_ports -quiet {v v[*]}]
# g input 32b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_input_delay 346.3 -clock vclk [get_ports -quiet {g g[*]}]
set_input_delay -min 46.1 -clock vclk [get_ports -quiet {g g[*]}]
# u input 32b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_input_delay 346.3 -clock vclk [get_ports -quiet {u u[*]}]
set_input_delay -min 46.1 -clock vclk [get_ports -quiet {u u[*]}]
# w input 32b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_input_delay 346.3 -clock vclk [get_ports -quiet {w w[*]}]
set_input_delay -min 46.1 -clock vclk [get_ports -quiet {w w[*]}]
# lim input 32b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_input_delay 346.3 -clock vclk [get_ports -quiet {lim lim[*]}]
set_input_delay -min 46.1 -clock vclk [get_ports -quiet {lim lim[*]}]
# a output 32b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_output_delay 287.3 -clock vclk [get_ports -quiet {a a[*]}]
set_output_delay -min -1.1 -clock vclk [get_ports -quiet {a a[*]}]
# vo output 1b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_output_delay 287.3 -clock vclk [get_ports -quiet {vo vo[*]}]
set_output_delay -min -1.1 -clock vclk [get_ports -quiet {vo vo[*]}]
# fault output 1b: L 124.5 um (su partition pin hop (same as dsfd_sp_su_n f_vm)), intra skew 75
set_output_delay 287.3 -clock vclk [get_ports -quiet {fault fault[*]}]
set_output_delay -min -1.1 -clock vclk [get_ports -quiet {fault fault[*]}]
# reset release (rst_mcp2, as make_io_vclk.sh)
set ot_rst {}
foreach ot_c [get_cells *] { if {[string match {rst_s\[1\]*} [get_full_name $ot_c]]} { lappend ot_rst $ot_c } }
if {[llength $ot_rst]} { set_multicycle_path -setup 2 -from $ot_rst; set_multicycle_path -hold 1 -from $ot_rst }
# sign-off times the routed clock tree: keep the real clock propagated after this post-SDC
set_propagated_clock [get_clocks {core_clk}]
