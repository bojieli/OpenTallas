# RULE H1 (h1_patch): outputs vs the FF mean leaf + 50 (sender), inputs launch at the FF mean leaf, 25 (receiver)
if {[llength [get_libs -quiet *_FF_*]]} {
# generated by tools/budgets/make_block_sdc.py ff ot_dsrom_su_swiglu_lane: FF hold sign-off post-SDC (sheet insertion FF min 255 / max 281, 50 ps hold IO uncertainty)
set_clock_latency 268 [get_clocks vclk]
create_clock -name vclki -period [get_property [get_clocks core_clk] period]
set_clock_latency 268 [get_clocks vclki]
unset_input_delay -clock vclk [get_ports -quiet {v v[*]}]
set_input_delay 346.3 -clock vclki [get_ports -quiet {v v[*]}]
set_input_delay -min 46.1 -clock vclki [get_ports -quiet {v v[*]}]
unset_input_delay -clock vclk [get_ports -quiet {g g[*]}]
set_input_delay 346.3 -clock vclki [get_ports -quiet {g g[*]}]
set_input_delay -min 46.1 -clock vclki [get_ports -quiet {g g[*]}]
unset_input_delay -clock vclk [get_ports -quiet {u u[*]}]
set_input_delay 346.3 -clock vclki [get_ports -quiet {u u[*]}]
set_input_delay -min 46.1 -clock vclki [get_ports -quiet {u u[*]}]
unset_input_delay -clock vclk [get_ports -quiet {w w[*]}]
set_input_delay 346.3 -clock vclki [get_ports -quiet {w w[*]}]
set_input_delay -min 46.1 -clock vclki [get_ports -quiet {w w[*]}]
unset_input_delay -clock vclk [get_ports -quiet {lim lim[*]}]
set_input_delay 346.3 -clock vclki [get_ports -quiet {lim lim[*]}]
set_input_delay -min 46.1 -clock vclki [get_ports -quiet {lim lim[*]}]
set_clock_uncertainty -hold 25 -from [get_clocks vclki] -to [get_clocks core_clk]
set_clock_uncertainty -hold 50 -from [get_clocks core_clk] -to [get_clocks vclk]
}
