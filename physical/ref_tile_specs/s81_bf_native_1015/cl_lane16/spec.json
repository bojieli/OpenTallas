 "inter": [],
 "structural_change": "S-ELEM BF column hardened cluster r4 (parent 604.8 x 198.72, all parent pins W/E): the four lane groups as ONE 4-root hardened child (ot_v41_bf_lane16_cl = 4 x ot_v41_bf_lane4_cl, one same-PLL phase-0 root per group), 164.16 x 194.4, all pins W (operands, clocks, reset) / E (results to red). RTL = the closed lane4_cl x4; column cycles unchanged (BF16 +3). r4b: per-group ports (<name><g>) so each root owns its pins (gate OT_MULTI_ROOT: shared t_p captured by four roots). r4c: per-group EXCLUSIVE band regions (group_bands.tcl, PRE_GLOBAL_PLACE): r4b mixed the 4 groups over the outline (CTS avg sink wire 166-186 um vs lane4_cl 106; FF hold -66 ps on 18k endpoints, stalled repair).",
 "pin_regs": {
  "enable": false,
  "reason": "RTL registers every child input at the pin (gen_bf_column_cluster.py); outputs come from arithmetic pipeline registers."
 },
 "reroute_reason": {
  "kind": "rtl_change",
  "why": "parent 583.2 infeasible under 20 um channel/edge rules",
  "fix": "S-ELEM BF column hardened cluster r4 (parent 604.8 x 198.72, all parent pins W/E): the four lane groups as ONE 4-root hardened child (ot_v41_bf_lane16_cl = 4 x ot_v41_bf_lane4_cl, one same-PLL phase-0 root per group), 164.16 x 194.4, all pins W (operands, clocks, reset) / E (results to red). RTL = the closed lane4_cl x4; column cycles unchanged (BF16 +3)."
 },
