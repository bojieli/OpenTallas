library(ot_pdie_serdes) {
    technology (cmos);
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1uA";
    leakage_power_unit : "1uW";
    pulling_resistance_unit : "1kohm";
    capacitive_load_unit (1,pf);
    nom_process : 1;
    nom_temperature : 100.000;
    nom_voltage : 0.63;
    operating_conditions(ss_0p63_100) { process : 1; temperature : 100.000; voltage : 0.63; tree_type : balanced_tree; }
    default_operating_conditions : ss_0p63_100;
    default_max_transition : 0.320;
    default_fanout_load : 1;
    default_input_pin_cap : 0.0;
    default_output_pin_cap : 0.0;
    default_inout_pin_cap : 0.0;
    default_cell_leakage_power : 0;
    default_leakage_power_density : 0.0;
    slew_lower_threshold_pct_rise : 20.000;
    slew_upper_threshold_pct_rise : 80.000;
    slew_lower_threshold_pct_fall : 20.000;
    slew_upper_threshold_pct_fall : 80.000;
    input_threshold_pct_rise : 50.000;
    input_threshold_pct_fall : 50.000;
    output_threshold_pct_rise : 50.000;
    output_threshold_pct_fall : 50.000;
    lu_table_template(ot_pdie_serdes_delay) { variable_1 : input_net_transition; variable_2 : total_output_net_capacitance; index_1 ("1000, 1001"); index_2 ("1000, 1001"); }
    lu_table_template(ot_pdie_serdes_slew) { variable_1 : input_net_transition; variable_2 : total_output_net_capacitance; index_1 ("1000, 1001"); index_2 ("1000, 1001"); }
    lu_table_template(ot_pdie_serdes_check) { variable_1 : related_pin_transition; variable_2 : constrained_pin_transition; index_1 ("1000, 1001"); index_2 ("1000, 1001"); }
    type (ot_pdie_serdes_bus512) { base_type : array; data_type : bit; bit_width : 512; bit_from : 511; bit_to : 0; downto : true; }
    cell(ot_pdie_serdes) {
        area : 562680.012;
        interface_timing : true;
        dont_use : true;
        dont_touch : true;
        pin(clk) { direction : input; capacitance : 0.020; clock : true; }
        bus(tx) { bus_type : ot_pdie_serdes_bus512;
            direction : input;
            capacitance : 0.0020;
            timing() {
                related_pin : "clk";
                timing_type : setup_rising;
            rise_constraint(ot_pdie_serdes_check) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0671, 0.0671", "0.0671, 0.0671");
            }
            fall_constraint(ot_pdie_serdes_check) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0671, 0.0671", "0.0671, 0.0671");
            }
            }
            timing() {
                related_pin : "clk";
                timing_type : hold_rising;
            rise_constraint(ot_pdie_serdes_check) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0681, 0.0681", "0.0681, 0.0681");
            }
            fall_constraint(ot_pdie_serdes_check) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0681, 0.0681", "0.0681, 0.0681");
            }
            }
        }
        bus(rx) { bus_type : ot_pdie_serdes_bus512;
            direction : output;
            max_capacitance : 0.500;
            timing() {
                related_pin : "clk";
                timing_type : rising_edge;
                timing_sense : non_unate;
            cell_rise(ot_pdie_serdes_delay) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.2982, 0.2982", "0.2982, 0.2982");
            }
            cell_fall(ot_pdie_serdes_delay) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.2982, 0.2982", "0.2982, 0.2982");
            }
            rise_transition(ot_pdie_serdes_slew) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0258, 0.0258", "0.0258, 0.0258");
            }
            fall_transition(ot_pdie_serdes_slew) {
                index_1 ("0.005, 0.500");
                index_2 ("0.001, 0.500");
                values ("0.0258, 0.0258", "0.0258, 0.0258");
            }
            }
        }
    }
}
