library (qkd_pll_analog_model_ff) {
  comment : "DIE-KV-94 11-08: KV die PLL reservation (analog hard IP): pins only, no timing";
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ps";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, ff);
  nom_process : 1;
  nom_voltage : 0.77;
  nom_temperature : 0;
  operating_conditions (PVT_ff) { process : 1; voltage : 0.77; temperature : 0; }
  default_operating_conditions : PVT_ff;
  voltage_map (VDD, 0.77);
  voltage_map (VSS, 0);
  default_max_transition : 320;
  cell (qkd_pll_analog_model) {
    area : 29859.8400;
    dont_use : true;
    dont_touch : true;
    pg_pin (VDD) { pg_type : primary_power; voltage_name : VDD; }
    pg_pin (VSS) { pg_type : primary_ground; voltage_name : VSS; }
    pin (refclk) { direction : input; capacitance : 1.0; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (por_n) { direction : input; capacitance : 1.0; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (locked) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_WS) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_WN) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_ES) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_EN) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_c) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_fwd) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_hbm_WS) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_hbm_WN) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_hbm_ES) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_hbm_EN) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_host) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_ingest) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
    pin (pll_phy) { direction : output; max_capacitance : 200; related_power_pin : VDD; related_ground_pin : VSS; }
  }
}
