# KIT-SYNTH-TARGET-1119 kit-owned ABC recipe (gen_phys abc_recipe "kit"); @D@ = delay target in ps (OT_ABC_TARGET_PS, default 600).
# Two rounds of &dch + delay-optimal SOP balancing (&if -g) before mapping (FABLE-FIX-S81-GLUE: 24 -> 16 levels on one cone),
# then &nf with a delay target so cones that can beat @D@ are not area-recovered up to the module's worst cone.
# Same ABC pass, same keep_hierarchy / ot_dp_dly_keep modules: only the script text differs from ORFS abc_speed.script.
&get -n
&st
&dch
&if -g -K 6
&dch
&if -g -K 6
&nf -D @D@
&put
buffer -c
topo
stime -c
upsize -c
dnsize -c
