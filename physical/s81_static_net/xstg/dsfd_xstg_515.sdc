# S-NET: the crossing is ot_s81_static_lane_end (fixed offset 4 of 8; write-to-read >= 2.5 T), bounded here at 1.5 T - 60 = 1190 ps like the d8g1 meso it replaces
create_clock -name core_clk -period 833.333 [get_ports {ck[0]}]
create_clock -name wclk -period 833.333 [get_ports {cw[0]}]
create_clock -name vclk -period 833.333
create_clock -name ot_lb_v_wclk -period 833.333
set_clock_latency 0 [get_clocks {vclk ot_lb_v_wclk}]
set_clock_uncertainty -setup 123 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_max_delay -ignore_clock_latency 1190.0 -from [get_clocks wclk] -to [get_clocks core_clk]
set_max_delay -ignore_clock_latency 1190.0 -from [get_clocks core_clk] -to [get_clocks wclk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks wclk] -to [get_clocks core_clk]
set_min_delay -ignore_clock_latency 0 -from [get_clocks core_clk] -to [get_clocks wclk]
set_false_path -from [get_clocks ot_lb_v_wclk] -to [get_clocks {core_clk vclk}]
set_false_path -from [get_clocks vclk] -to [get_clocks {wclk ot_lb_v_wclk}]
set_false_path -from [get_clocks wclk] -to [get_clocks vclk]
set_false_path -from [get_clocks core_clk] -to [get_clocks ot_lb_v_wclk]
set_input_delay 166.667 -clock ot_lb_v_wclk [get_ports {i*}]
set_input_delay -min 0 -clock ot_lb_v_wclk [get_ports {i*}]
set_output_delay 316.667 -clock vclk [get_ports {o*}]
set_output_delay -min 0 -clock vclk [get_ports {o*}]
set_max_fanout 32 [current_design]
