# Q-CLUSTER qfd_c_b16_dv: the three non-core quadrant roots (generated by tools/qwen_cluster/qc_kit.py; DO NOT EDIT).
# Same period / phase as core_clk (related, neighbour-relative die delivery); each boundary port is timed against the
# clock of the quadrant that holds its pin register (0.2 T in / out, as core_clk's ports).
set ot_q_per [get_property [get_clocks core_clk] period]
create_clock -name ck_se -period $ot_q_per [get_ports ck_se]
create_clock -name ck_nw -period $ot_q_per [get_ports ck_nw]
create_clock -name ck_ne -period $ot_q_per [get_ports ck_ne]
set_clock_uncertainty -setup 60 [get_clocks {ck_se ck_nw ck_ne}]
set_clock_uncertainty -hold 25 [get_clocks {ck_se ck_nw ck_ne}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_se [get_ports {bc2*}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_se [get_ports {bc3*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_nw [get_ports {bco0*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_nw [get_ports {bco1*}]
set_input_delay [expr {0.2 * $ot_q_per}] -clock ck_nw [get_ports {rs_i*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_ne [get_ports {bco2*}]
set_output_delay [expr {0.2 * $ot_q_per}] -clock ck_ne [get_ports {bco3*}]
if {!$::ot_ref_pre_cts} { set_propagated_clock [get_clocks {ck_se ck_nw ck_ne}] }
