# Q-CLUSTER5 (coordinator 0ea (4), 10-18): CENTRE-FED regional clocks for qfd_c_b16_dv (fallback (a) of the owner's
# option-(b) ruling 10-17).  PRE_CTS: every regional clock port ck_<q> becomes an interior AREA pin at its region centre
# (the die / parent drops the regional clock there from above), so the regional tree (spine or TritonCTS) starts at the
# middle of its sinks instead of a face 0.6-1.3 mm away.  The face pin regions in kit.env only seed the IO placer; this
# hook moves the clock bterms before the tree is built.  Placement only; netlist unchanged.
# Q-CLUSTER16 10-18: '[moved ...]' in the format string was a Tcl command substitution ("invalid command name moved"),
# which failed CTS of the diagc / diagct gates (cts.log line 472); the brackets are escaped now.
# Env: OT_QC_CK_CENTRES = "ck_w0:x:y,ck_w1:x:y,..." (um, cluster origin; generated by tools/qwen_cluster/qc_kit.py from
# the region's two A0 tiles: x = centre of the corridor between them, y = tile-row centre), OT_QC_CK_LAYER (default M7,
# the top signal layer of the cluster_level-2 contract: above the A0 / station OBS in the corridors).
set ot_qcf_layer [expr {[info exists ::env(OT_QC_CK_LAYER)] && $::env(OT_QC_CK_LAYER) ne "" ? $::env(OT_QC_CK_LAYER) : "M7"}]
set ot_qcf_tech [ord::get_db_tech]
set ot_qcf_l [$ot_qcf_tech findLayer $ot_qcf_layer]
if {$ot_qcf_l eq "NULL"} { error "qfd_c_b16_dv_centre_feed: no layer $ot_qcf_layer" }
set ot_qcf_dbu [$ot_qcf_tech getDbUnitsPerMicron]
# pin shape: 2x the layer's min width square-ish, on track (place_pin snaps to the layer's track grid)
set ot_qcf_w [expr {2.0 * [$ot_qcf_l getWidth] / double($ot_qcf_dbu)}]
set ot_qcf_out [open [file join $::env(RESULTS_DIR) ot_qc_centre_feed.txt] w]
# OT_QC_CK_CENTRES_FILE (Q-CLUSTER16): the same entries one per line in a file (16 entries overflow an env value)
if {[info exists ::env(OT_QC_CK_CENTRES_FILE)] && $::env(OT_QC_CK_CENTRES_FILE) ne ""} {
  set ot_qcf_fh [open $::env(OT_QC_CK_CENTRES_FILE)]
  set ot_qcf_ents [lsearch -all -inline -not -exact [split [string trim [read $ot_qcf_fh]] "\n"] ""]
  close $ot_qcf_fh
} else {
  set ot_qcf_ents [split $::env(OT_QC_CK_CENTRES) ","]
}
puts "OT_QC_CENTRE_FEED [llength $ot_qcf_ents] regional clock pins"
foreach ent $ot_qcf_ents {
  lassign [split $ent ":"] port x y
  set bt [[ord::get_db_block] findBTerm $port]
  if {$bt eq "NULL"} { error "qfd_c_b16_dv_centre_feed: no port $port" }
  set pb [$bt getBBox]
  set ox [expr {([$pb xMin] + [$pb xMax]) / 2.0 / $ot_qcf_dbu}]; set oy [expr {([$pb yMin] + [$pb yMax]) / 2.0 / $ot_qcf_dbu}]
  place_pin -pin_name $port -layer $ot_qcf_layer -location [list $x $y] -pin_size [list $ot_qcf_w $ot_qcf_w]
  set pb [$bt getBBox]
  set nx [expr {([$pb xMin] + [$pb xMax]) / 2.0 / $ot_qcf_dbu}]; set ny [expr {([$pb yMin] + [$pb yMax]) / 2.0 / $ot_qcf_dbu}]
  set msg [format "OT_QC_CENTRE_FEED %s %s face (%.2f, %.2f) -> area pin (%.2f, %.2f) \[moved %.0f um\]" $port $ot_qcf_layer $ox $oy $nx $ny [expr {abs($nx - $ox) + abs($ny - $oy)}]]
  puts $msg; puts $ot_qcf_out $msg
}
close $ot_qcf_out
