# GENERATED by gen_kit_repin.py: post-route STA of the routed core at one corner (env OT_CORNER = TT | FF):
# 6_final.odb + 6_final.spef (ORFS RCX), kit SDC, propagated clocks.  Writes /work/sta_<corner>.json (WNS / TNS / hold,
# CTS insertion = max CK arrival over all register clock pins, leaf spread = max - min) and the timing model
# /work/views/<module>_<corner>.lib (write_timing_model, source latency zeroed as in ORFS generate_abstract).
set C $::env(OT_CORNER)
set c [string tolower $C]
set L /OpenROAD-flow-scripts/flow/platforms/asap7/lib/NLDM
read_db $::env(ODB)
foreach f [lsort [glob $L/asap7sc7p5t_*_RVT_${C}_nldm_*.lib*]] { read_liberty $f }
foreach f [glob -nocomplain /work/macros/*_${c}.lib] { read_liberty $f }
read_sdc /work/constraint.sdc
read_spef $::env(SPEF)
set_propagated_clock [get_clocks clk]
set per [get_property [get_clocks clk] period]
proc ot_ck {pin} { global per; if {[catch {set a [get_property $pin arrival_max_rise]}] || $a eq ""} { return "" }
  if {$a >= $per / 2.0 && $a < $per} { set a [expr {$a - $per / 2.0}] }; return $a }
set arr {}
foreach p [all_registers -clock_pins] { set a [ot_ck $p]; if {$a ne ""} { lappend arr $a } }
set arr [lsort -real $arr]
set ws [expr {[sta::worst_slack_cmd max] * 1e12}]
set hs [expr {[sta::worst_slack_cmd min] * 1e12}]
set tns [expr {[sta::total_negative_slack_cmd max] * 1e12}]
set htns [expr {[sta::total_negative_slack_cmd min] * 1e12}]
set nv 0; set nh 0
foreach e [sta::endpoint_violation_count max] { set nv $e }
foreach e [sta::endpoint_violation_count min] { set nh $e }
set fh [open /work/sta_${c}.json w]
puts $fh [format "{\"corner\": \"%s\", \"setup_wns_ps\": %.2f, \"setup_tns_ps\": %.2f, \"setup_viol\": %d, \"hold_wns_ps\": %.2f, \"hold_tns_ps\": %.2f, \"hold_viol\": %d, \"ck_sinks\": %d, \"ck_min_ps\": %.1f, \"ck_max_ps\": %.1f, \"ck_spread_ps\": %.1f}" \
  $C $ws $tns $nv $hs $htns $nh [llength $arr] [lindex $arr 0] [lindex $arr end] [expr {[lindex $arr end] - [lindex $arr 0]}]]
close $fh
report_checks -path_delay max -group_path_count 3 -format full_clock_expanded -fields {slew cap fanout} > /work/sta_${c}_max.rpt
report_checks -path_delay min -group_path_count 3 -format full_clock_expanded > /work/sta_${c}_min.rpt
file mkdir /work/views
set_clock_latency -source 0 [all_clocks]
write_timing_model /work/views/$::env(DESIGN_NAME)_${c}.lib
puts "OT_CORNER_DONE $C"
