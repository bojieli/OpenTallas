set fk_n 0
set fk_re {^(ck|rst)$}
foreach bt [[ord::get_db_block] getBTerms] {
  if {[regexp $fk_re [$bt getName]]} continue
  set n [$bt getNet]
  if {$n eq "NULL"} continue
  set todo [list $n]
  for {set d 0} {$d < 3 && [llength $todo]} {incr d} {
    set nx {}
    foreach m $todo { foreach it [$m getITerms] {
      set i [$it getInst]
      if {[[$i getMaster] isSequential]} { if {[$i isDoNotTouch] != 1} { $i setDoNotTouch 1; incr fk_n }; continue }
      # QN flops reach the pin through an inverter / buffer: follow single-output INV / BUF cells (<= 2 deep)
      if {[regexp {^(INV|BUF|HB)} [[$i getMaster] getName]]} { $i setDoNotTouch 1
        foreach o [$i getITerms] { if {[$o getNet] ne "NULL" && [$o getNet] ne $m && [[$o getMTerm] getSigType] ni {POWER GROUND}} { lappend nx [$o getNet] } } }
    } }
    set todo $nx
  }
}
puts "OT_FACE_KEEP dont_touch $fk_n pin registers"
