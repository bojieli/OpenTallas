# PATH-S81 10-25: no TritonCTS dummy loads.  fan24 carried 1038 clkload* cells (109 BUFx24) padding leaf nets so the
# placement-estimate balance looked flat; under GRT the late leaves sat at the RC tail of 10-12-load level-7 nets
# (wire 1.6 -> 9.6 ps, slew 20 -> 36 ps) and 9 short FF paths lost hold.  ORFS cts.tcl reads CTS_ARGS after PRE_CTS, so the
# flag is added here (config.mk is hash-bound by IMMUTABLE_COHORT and unchanged).
# grt_prepare.tcl also sources this file at the GRT stage, where ORFS does not export CTS_ARGS: edit it only when present.
if {[info exists ::env(CTS_ARGS)]} {
  if {[string first -dont_use_dummy_load $::env(CTS_ARGS)] < 0} { set ::env(CTS_ARGS) "$::env(CTS_ARGS) -dont_use_dummy_load" }
  puts "OT_CTS_ARGS $::env(CTS_ARGS)"
}
# GENERATED by gen_kit_repin.py: repair_timing may add buffers up to max_buffer_percent (area-checked)
if {![llength [info commands kr_default_repair_timing_helper]]} {
 rename repair_timing_helper kr_default_repair_timing_helper
 proc repair_timing_helper {args} {kr_default_repair_timing_helper -max_buffer_percent 100 {*}$args}
}
