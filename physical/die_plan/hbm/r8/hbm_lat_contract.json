    "CAL_{q}",
    "C_rq_{q}0",
    "C_rq_{q}1",
    "C_rq_{q}2",
    "C_rq_{q}3",
    "H_rq_{q}0",
    "H_rq_{q}1",
    "H_rq_{q}2",
    "H_rq_{q}3"
   ]
  },
  {
   "name": "HCR_x",
   "why": "hc_eng XRD / XRU are one scalar per direction for both quadrants",
   "members": [
    "HCR_xrd"
   ]
  }
 ],
 "families": [
  {
   "for": {
    "q": [
     "NW",
     "NE"
    ]
   },
   "name": "SFU_VM_{q}",
   "consumer": "sfucore_{q}.__cut_ctl (ot_hgi_sfu_vm_static_bridge)",
   "params": [
    "READ_RETURN",
    "WRITE_RETURN"
   ],
   "loops_for": {
    "k": [
     0,
     1,
     2,
     3
    ]
   },
   "env": {
    "q": "{q}"
   },
   "loop": {
    "name": "LG{k}",
    "legs": [
     "C_rq_{q}{k}",
     "N_rq_{q}{k}",
     "N_rr_{q}{k}",
     "C_rr_{q}{k}"
