    "pad": "C_rr_{q}{k}"
   }
  },
  {
   "for": {
    "q": [
     "NW",
     "NE"
    ]
   },
   "name": "HC_Q_{q}",
   "consumer": "hc_{q}.u_q (ot_hbm_hc_q_static)",
   "params": [
    "RD_CAPTURE",
    "GATHER_PHASE",
    "DONE_LAT"
   ],
   "loops_for": {
    "k": [
     0,
     1,
     2,
     3
    ]
   },
   "env": {
    "q": "{q}"
   },
   "loop": {
    "name": "LG{k}",
    "legs": [
     "H_rq_{q}{k}",
     "N_rq_{q}{k}",
     "N_rr_{q}{k}",
     "H_rr_{q}{k}"
    ],
    "pad": "H_rr_{q}{k}"
   }
  }
 ],
 "splits": [
  {
   "name": "cal",
   "why": "calendar lg_local_read/write is its own as-built bus (one calendar word), not part of the hub's VM return / request buses into the same tap",
   "sel": {
    "sink": ".*",
    "port": ".*",
    "src": "calendar_N[EW]"
   }
  }
 ]
}