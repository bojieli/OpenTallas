read_verilog -sv fragB_gold.sv
hierarchy -top fragB

proc; flatten; opt_clean
rename fragB gold
design -stash gold
read_verilog -sv fragB_mut.sv
hierarchy -top fragB

setattr -mod -unset keep_hierarchy ot_hbm_svc_skid_popg
setattr -unset keep a:keep
proc; flatten; opt_clean; opt_merge -share_all; opt_clean
rename fragB gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
async2sync
equiv_make gold gate equiv
hierarchy -top equiv
opt_clean
equiv_simple -seq 4
equiv_induct -seq 4
equiv_status -assert
