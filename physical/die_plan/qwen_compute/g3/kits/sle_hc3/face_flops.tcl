# GENERATED by tools/die_plan/gen.py phys (PRE_GLOBAL_PLACE hook): every partition pin register sits AT its pin.
# Why (CP1 10-23): a wirelength-driven GPL put the boundary flops of the u_bin_/u_bout_/u_ft_ stations up to ~1 mm
# from their face pins (seam path c0 u_bout_xo_o0 -> c1 u_bin_xo_i0: 17 placement buffers, ~950 ps of wire inside the
# capture partition, setup -1.27 ns at 833 ps) although the plan budgets pin_reg_p90_um.  Here every flop that is
# reached from a signal port through at most 2 buffer/inverter cells is placed FIRM in a band along its face, at the
# row / column nearest its pin; face_flops_release.tcl (PRE_DETAIL_PLACE) releases them to PLACED for DPL.
# ft slots (COORD 10-23 R3): station 0 is the in-port face flop; station j (j >= 1) of k sits FIRM at L*j/k along the
# slot's planned route (G0 lane_geometry/check.zroute: L for a turning slot, else Z through the midpoint) or at its
# regs_um site; the out port is NOT face-registered here (the neighbour's station 0 registers it).  Table:
# ft_stations.txt (slot k in_face out_face [x y ...]).
# ORFS sources hooks inside a proc: run at global scope so the helper procs below can use `global`
uplevel #0 {
set ff_blk [ord::get_db_block]
set ff_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set ff_core [$ff_blk getCoreArea]
set ff_x0 [$ff_core xMin]; set ff_y0 [$ff_core yMin]; set ff_x1 [$ff_core xMax]; set ff_y1 [$ff_core yMax]
set ff_rows [$ff_blk getRows]
set ff_site [[lindex $ff_rows 0] getSite]
set ff_sw [$ff_site getWidth]; set ff_rh [$ff_site getHeight]
set ff_orient {}
foreach r $ff_rows { dict set ff_orient [lindex [$r getOrigin] 1] [$r getOrient] }
set ff_skip_re {^(clk(_t[0-9]+|_c[0-9]+)?|arst_n)$}
# ft slots: name -> {k in_face regs}
set ff_ft {}
if {[file exists /work/ft_stations.txt]} {
  set fh [open /work/ft_stations.txt r]
  foreach ln [split [read $fh] "\n"] {
    if {$ln eq "" || [string index $ln 0] eq "#"} continue
    dict set ff_ft [lindex $ln 0] [list [lindex $ln 1] [lindex $ln 2] [lindex $ln 3] [lrange $ln 4 end]]
  }
  close $fh
}
proc ff_slot_of {nm sfx} {
  global ff_ft
  if {[regexp "^(.*)${sfx}(\\\[\[0-9\]+\\\])?\$" $nm -> base]} { if {[dict exists $ff_ft $base]} { return $base } }
  return ""
}
# column pitch along the depth of an E/W band and along an N/S face (a DFFHQNx1 is 20 sites wide; the rest is room for its INV / port buffer)
set ff_cpitch [expr {$ff_sw * 40}]
proc ff_is_ff {inst} { return [string match "*DFF*" [[$inst getMaster] getName]] }
proc ff_is_buf {inst} {
  set m [[$inst getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "INV*" $m] || [string match "HB*" $m]}]
}
proc ff_sig_iterms {inst io} {
  set r {}
  foreach it [$inst getITerms] {
    if {[$it getSigType] ne "SIGNAL"} continue
    set mt [$it getMTerm]
    if {$io eq "in" && [$mt getIoType] eq "INPUT"} { lappend r $it }
    if {$io eq "out" && [$mt getIoType] eq "OUTPUT"} { lappend r $it }
  }
  return $r
}
# input port: loads, through <= 2 buffers, to a flop D
proc ff_from_in {net depth} {
  if {$net eq "NULL" || $net eq ""} { return "" }
  foreach it [$net getITerms] {
    set i [$it getInst]
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    if {[ff_is_ff $i]} { return $i }
  }
  if {$depth >= 2} { return "" }
  foreach it [$net getITerms] {
    set i [$it getInst]
    if {[[$it getMTerm] getIoType] ne "INPUT" || ![ff_is_buf $i]} continue
    foreach o [ff_sig_iterms $i out] { set f [ff_from_in [$o getNet] [expr {$depth + 1}]]; if {$f ne ""} { return $f } }
  }
  return ""
}
# output port: driver, through <= 2 buffers, back to a flop
proc ff_from_out {net depth} {
  if {$net eq "NULL" || $net eq ""} { return "" }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "OUTPUT"} continue
    set i [$it getInst]
    if {[ff_is_ff $i]} { return $i }
    if {$depth < 2 && [ff_is_buf $i]} {
      foreach n [ff_sig_iterms $i in] { set f [ff_from_out [$n getNet] [expr {$depth + 1}]]; if {$f ne ""} { return $f } }
    }
  }
  return ""
}
# the same, returning the cell chain [port driver ... flop]
proc ff_chain_out {net depth} {
  if {$net eq "NULL" || $net eq ""} { return "" }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "OUTPUT"} continue
    set i [$it getInst]
    if {[ff_is_ff $i]} { return [list $i] }
    if {$depth < 2 && [ff_is_buf $i]} {
      foreach n [ff_sig_iterms $i in] { set c [ff_chain_out [$n getNet] [expr {$depth + 1}]]; if {$c ne ""} { return [linsert $c 0 $i] } }
    }
  }
  return ""
}
# CP1 r6: yosys merges identical boundary flops of DIFFERENT buses (u_bout_x_o0.q[718] also drove frame_int_o0[892]
# on the N face; the W-face x path then ran 1 mm, TT -90 ps).  A pin register already claimed by another port is
# duplicated with its <= 2 buffer chain, and this port moves onto the copy (logically identical: same D / clock).
set ff_ndup 0
proc ff_clone_for {bt chain} {
  global ff_blk ff_ndup
  set prev ""
  foreach i [lreverse $chain] {
    incr ff_ndup
    set c [odb::dbInst_create $ff_blk [$i getMaster] "[$i getName]_otdup$ff_ndup"]
    set onet [odb::dbNet_create $ff_blk "otdup_net$ff_ndup"]
    foreach it [$i getITerms] {
      set mt [$it getMTerm]
      if {[$mt getSigType] in {POWER GROUND}} continue
      set ct [$c findITerm [$mt getName]]
      if {[$mt getIoType] eq "INPUT"} {
        if {$prev ne "" && ![ff_is_ff $i]} { $ct connect $prev } elseif {[$it getNet] ne "NULL"} { $ct connect [$it getNet] }
      } elseif {[$mt getIoType] eq "OUTPUT"} {
        # the signal output of the chain (a flop has QN only in this library)
        if {[$it getNet] ne "NULL"} { $ct connect $onet }
      }
    }
    set prev $onet
    if {[ff_is_ff $i]} { set newff $c }
  }
  $bt disconnect
  $bt connect $prev
  return $newff
}
set ff_done {}
set ff_occ {}
set ff_n 0; set ff_miss 0
set ff_out [open $::env(RESULTS_DIR)/ot_face_flops.txt w]
# inputs first: a 1-station ft slot's only flop registers its input face
foreach pass {INPUT OUTPUT} {
  foreach bt [$ff_blk getBTerms] {
    if {[$bt getSigType] ne "SIGNAL" || [$bt getIoType] ne $pass} continue
    set nm [$bt getName]
    if {[regexp $ff_skip_re $nm]} continue
    # ft out ports: registered by the neighbour's station 0; the last station is placed by the station pass
    if {$pass eq "OUTPUT" && [ff_slot_of $nm _o] ne ""} continue
    set f [expr {$pass eq "INPUT" ? [ff_from_in [$bt getNet] 0] : [ff_from_out [$bt getNet] 0]}]
    if {$f eq ""} { incr ff_miss; continue }
    if {[dict exists $ff_done [$f getName]]} {
      if {$pass ne "OUTPUT"} continue
      set f [ff_clone_for $bt [ff_chain_out [$bt getNet] 0]]
    }
    dict set ff_done [$f getName] 1
    set bb [$bt getBBox]
    set px [expr {([$bb xMin] + [$bb xMax]) / 2}]; set py [expr {([$bb yMin] + [$bb yMax]) / 2}]
    set w [[$f getMaster] getWidth]
    # face = nearest core edge
    set d [list [list [expr {$px - $ff_x0}] W] [list [expr {$ff_x1 - $px}] E] [list [expr {$py - $ff_y0}] S] [list [expr {$ff_y1 - $py}] N]]
    set face [lindex [lsort -integer -index 0 $d] 0 1]
    if {$face in {E W}} {
      set row [expr {max(0, min(([llength $ff_rows] - 1), ($py - $ff_y0) / $ff_rh))}]
      # nearest free (row, column) slot: columns inward, alternate rows around the pin row
      set placed 0
      for {set c 0} {$c < 400 && !$placed} {incr c} {
        foreach dr {0 1 -1 2 -2} {
          set r [expr {$row + $dr}]
          if {$r < 0 || $r >= [llength $ff_rows] || [dict exists $ff_occ "$face,$r,$c"]} continue
          dict set ff_occ "$face,$r,$c" 1
          set cy [expr {$ff_y0 + $r * $ff_rh}]
          set cx [expr {$face eq "W" ? $ff_x0 + $c * $ff_cpitch : $ff_x1 - $c * $ff_cpitch - $w}]
          set placed 1; break
        }
      }
    } else {
      set col [expr {($px - $ff_x0) / $ff_cpitch}]
      set placed 0
      for {set r 0} {$r < 400 && !$placed} {incr r} {
        foreach dc {0 1 -1} {
          set c [expr {$col + $dc}]
          if {$c < 0 || [dict exists $ff_occ "$face,$r,$c"]} continue
          dict set ff_occ "$face,$r,$c" 1
          set cx [expr {min($ff_x0 + $c * $ff_cpitch, $ff_x1 - $w)}]
          set cy [expr {$face eq "S" ? $ff_y0 + $r * $ff_rh : $ff_y1 - ($r + 1) * $ff_rh}]
          set placed 1; break
        }
      }
    }
    if {!$placed} { incr ff_miss; continue }
    set cx [expr {$ff_x0 + (($cx - $ff_x0) / $ff_sw) * $ff_sw}]
    # orient BEFORE location: dbInst::setOrient keeps the bbox, so a later MX flip moved the flop one row down (onto
    # its neighbour: KV-P5 10-23, two FIRM flops in one site -> DPL-0033)
    if {[dict exists $ff_orient $cy]} { $f setOrient [dict get $ff_orient $cy] }
    $f setLocation $cx $cy
    $f setPlacementStatus FIRM
    puts $ff_out "[$f getName]\t$face\t[expr {$cx / double($ff_dbu)}]\t[expr {$cy / double($ff_dbu)}]\t$nm"
    incr ff_n
  }
}
# ---- ft stations j >= 1 (R3)
proc ff_zroute {ax ay bx by fin fout} {
  if {abs($ax - $bx) < 1 || abs($ay - $by) < 1} { return [list $ax $ay $bx $by] }
  # turning slot: L (check.zroute)
  if {($fin in {E W}) != ($fout in {E W})} {
    if {$fin in {E W}} { return [list $ax $ay $bx $ay $bx $by] }
    return [list $ax $ay $ax $by $bx $by]
  }
  if {$fin in {E W}} { set xm [expr {($ax + $bx) / 2}]; return [list $ax $ay $xm $ay $xm $by $bx $by] }
  set ym [expr {($ay + $by) / 2}]; return [list $ax $ay $ax $ym $bx $ym $bx $by]
}
proc ff_point_at {pts t} {
  set n [expr {[llength $pts] / 2}]
  for {set i 0} {$i < $n - 1} {incr i} {
    lassign [lrange $pts [expr {2*$i}] [expr {2*$i+3}]] px py qx qy
    set d [expr {abs($px - $qx) + abs($py - $qy)}]
    if {$t <= $d} { set f [expr {$d == 0 ? 0.0 : double($t) / $d}]; return [list [expr {$px + $f*($qx-$px)}] [expr {$py + $f*($qy-$py)}]] }
    set t [expr {$t - $d}]
  }
  return [lrange $pts end-1 end]
}
if {[file exists /work/ft_bit_sites.tcl]} { source /work/ft_bit_sites.tcl }
set ff_gocc {}
proc ff_put_near {f x y} {
  # nearest free (column, row) cell of the global station grid around (x, y), spiral search
  global ff_gocc ff_x0 ff_y0 ff_x1 ff_y1 ff_rh ff_sw ff_cpitch ff_orient
  set w [[$f getMaster] getWidth]
  set c0 [expr {int(($x - $ff_x0) / $ff_cpitch)}]; set r0 [expr {int(($y - $ff_y0) / $ff_rh)}]
  set cmax [expr {int(($ff_x1 - $ff_x0 - $w) / $ff_cpitch)}]; set rmax [expr {int(($ff_y1 - $ff_y0) / $ff_rh) - 1}]
  for {set rad 0} {$rad < 200} {incr rad} {
    for {set dr [expr {-$rad}]} {$dr <= $rad} {incr dr} {
      foreach dc [lsort -unique [list [expr {$rad - abs($dr)}] [expr {abs($dr) - $rad}]]] {
        set c [expr {$c0 + $dc}]; set r [expr {$r0 + $dr}]
        if {$c < 0 || $r < 0 || $c > $cmax || $r > $rmax || [dict exists $ff_gocc "$c,$r"]} continue
        dict set ff_gocc "$c,$r" 1
        set cx [expr {$ff_x0 + $c * $ff_cpitch}]; set cy [expr {$ff_y0 + $r * $ff_rh}]
        if {[dict exists $ff_orient $cy]} { $f setOrient [dict get $ff_orient $cy] }
        $f setLocation $cx $cy
        $f setPlacementStatus FIRM
        return [list $cx $cy]
      }
    }
  }
  return ""
}
set ff_st 0; set ff_st_miss 0
foreach bt [$ff_blk getBTerms] {
  if {[$bt getSigType] ne "SIGNAL" || [$bt getIoType] ne "INPUT"} continue
  set nm [$bt getName]
  set slot [ff_slot_of $nm _i]
  if {$slot eq ""} continue
  lassign [dict get $ff_ft $slot] k fin fout regs
  set onm [string map [list "${slot}_i" "${slot}_o"] $nm]
  set ob [$ff_blk findBTerm $onm]
  set f [ff_from_in [$bt getNet] 0]
  if {$f eq "" || $ob eq "NULL" || $ob eq ""} { incr ff_st_miss; continue }
  set bb [$bt getBBox]; set ab [$ob getBBox]
  set ax [expr {([$bb xMin] + [$bb xMax]) / 2}]; set ay [expr {([$bb yMin] + [$bb yMax]) / 2}]
  set bx [expr {([$ab xMin] + [$ab xMax]) / 2}]; set by [expr {([$ab yMin] + [$ab yMax]) / 2}]
  set pts [ff_zroute $ax $ay $bx $by $fin $fout]
  set L 0
  for {set i 0} {$i + 3 < [llength $pts]} {incr i 2} { set L [expr {$L + abs([lindex $pts $i] - [lindex $pts $i+2]) + abs([lindex $pts $i+1] - [lindex $pts $i+3])}] }
  for {set j 1} {$j < $k} {incr j} {
    set q ""
    foreach o [ff_sig_iterms $f out] { set q [ff_from_in [$o getNet] 0]; if {$q ne ""} break }
    if {$q eq "" || [dict exists $ff_done [$q getName]]} { incr ff_st_miss; break }
    set f $q
    dict set ff_done [$f getName] 1
    if {[llength $regs] >= 2 * $k} {
      set xy [list [expr {round([lindex $regs [expr {2*$j}]] * $ff_dbu)}] [expr {round([lindex $regs [expr {2*$j+1}]] * $ff_dbu)}]]
    } else {
      set xy [ff_point_at $pts [expr {$L * double($j) / $k}]]
    }
    if {[info exists ff_bit_site_cells] && [dict exists $ff_bit_site_cells $slot]} {
      if {![regexp {\[([0-9]+)\]$} $nm -> ff_bit]} { error "FT bit index missing: $nm" }
      set key "$slot,$j,$ff_bit"
      if {![dict exists $ff_bit_sites $key]} { error "explicit FT site missing: $key" }
      lassign [dict get $ff_bit_sites $key] xx yy
      lassign [dict get $ff_bit_site_cells $slot] fw fh
      set cx [expr {round($xx*$ff_dbu)}]; set cy [expr {round($yy*$ff_dbu)}]
      if {![dict exists $ff_orient $cy] || ($cx-$ff_x0)%$ff_sw != 0} { error "explicit FT site is not on a row/site: $key $xx $yy" }
      set fm [$f getMaster]
      if {[$fm getWidth] > $fw*$ff_dbu+1 || [$fm getHeight] > $fh*$ff_dbu+1} { error "FT cell exceeds allocated footprint: [$f getName]" }
      if {$cx < $ff_x0 || $cy < $ff_y0 || $cx+[$fm getWidth] > $ff_x1 || $cy+[$fm getHeight] > $ff_y1} { error "explicit FT site outside core: $key" }
      $f setOrient [dict get $ff_orient $cy]
      $f setLocation $cx $cy
      $f setPlacementStatus FIRM
      set got [list $cx $cy]
    } else {
      set got [ff_put_near $f [lindex $xy 0] [lindex $xy 1]]
    }
    if {$got eq ""} { incr ff_st_miss; continue }
    puts $ff_out "[$f getName]\tst$j\t[expr {[lindex $got 0] / double($ff_dbu)}]\t[expr {[lindex $got 1] / double($ff_dbu)}]\t$nm"
    incr ff_st
  }
}
close $ff_out
puts "OT_FACE_FLOPS placed $ff_n pin registers FIRM at their faces ($ff_miss signal ports without a flop within 2 buffers; $ff_ndup cells duplicated for output ports sharing a merged flop); $ff_st ft stations j>=1 FIRM on their routes ($ff_st_miss missing)"
# KV-G3 10-24: FIRM plan internal stations + plan-cell sites of a bound kit (tools/die_plan/kit_istations.py)
if {[file exists /work/istations.tcl]} { source /work/istations.tcl }
# OWNER RESET RULE 10-24: FIRM reset entry stage + synchronous relay tree (tools/die_plan/reset_tree.py, kit_rsync)
if {[file exists /work/reset_tree.tcl]} { source /work/reset_tree.tcl }
# per-tap reset synchronisers (gen_rtl ot_dp_rsync_s<N>): place them at their taps, re-point FIRM flops (reset_taps.tcl)
if {[file exists /work/reset_taps.tcl]} { source /work/reset_taps.tcl }
}
# S81-P8 10-23: soft relay stations on their source-sink lines (kits with hard cores; gen_phys copies relay_mid.tcl)
if {[file exists /work/relay_mid.tcl] && [info exists ::env(OT_RELAY_MID_RE)]} { source /work/relay_mid.tcl }
