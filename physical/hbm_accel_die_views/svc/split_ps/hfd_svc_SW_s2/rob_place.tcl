# hfd_svc_SW_s2: per-PC ROB macro placement (gen_svc_seg.py, tputx-svc); halo = MACRO_PLACE_HALO
set b [ord::get_db_block]
set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
proc ot_rob_strip {n} { return [string map {\\ {}} $n] }
set nrob 0
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc9?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(69.12 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 69.12 25.92" } }; if {$hit != 1} { error "rob_place: u_pc9.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc10?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(334.8 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 334.8 25.92" } }; if {$hit != 1} { error "rob_place: u_pc10.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc11?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(600.48 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 600.48 25.92" } }; if {$hit != 1} { error "rob_place: u_pc11.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc12?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(866.16 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 866.16 25.92" } }; if {$hit != 1} { error "rob_place: u_pc12.u_rob matched $hit instances" }
set nm 0; foreach i [$b getInsts] { if {[[$i getMaster] isBlock]} { incr nm } }; if {$nm != 4} { error "rob_place: expected 4 macros, netlist has $nm" }
