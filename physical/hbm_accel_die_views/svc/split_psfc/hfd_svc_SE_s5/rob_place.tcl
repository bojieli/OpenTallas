# hfd_svc_SE_s5: per-PC ROB macro placement (gen_svc_seg.py, tputx-svc); halo = MACRO_PLACE_HALO
set b [ord::get_db_block]
set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
proc ot_rob_strip {n} { return [string map {\\ {}} $n] }
set nrob 0
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc22?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(73.872 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 73.872 25.92" } }; if {$hit != 1} { error "rob_place: u_pc22.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc23?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(339.552 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 339.552 25.92" } }; if {$hit != 1} { error "rob_place: u_pc23.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc24?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(605.232 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 605.232 25.92" } }; if {$hit != 1} { error "rob_place: u_pc24.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc25?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(870.912 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 870.912 25.92" } }; if {$hit != 1} { error "rob_place: u_pc25.u_rob matched $hit instances" }
set nm 0; foreach i [$b getInsts] { if {[[$i getMaster] isBlock]} { incr nm } }; if {$nm != 4} { error "rob_place: expected 4 macros, netlist has $nm" }
