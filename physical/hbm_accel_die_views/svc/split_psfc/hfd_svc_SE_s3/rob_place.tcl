# hfd_svc_SE_s3: per-PC ROB macro placement (gen_svc_seg.py, tputx-svc); halo = MACRO_PLACE_HALO
set b [ord::get_db_block]
set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
proc ot_rob_strip {n} { return [string map {\\ {}} $n] }
set nrob 0
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc13?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(74.736 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 74.736 25.92" } }; if {$hit != 1} { error "rob_place: u_pc13.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc14?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(340.416 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 340.416 25.92" } }; if {$hit != 1} { error "rob_place: u_pc14.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc15?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(605.664 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 605.664 25.92" } }; if {$hit != 1} { error "rob_place: u_pc15.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc16?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(871.344 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 871.344 25.92" } }; if {$hit != 1} { error "rob_place: u_pc16.u_rob matched $hit instances" }
set hit 0; foreach i [$b getInsts] { if {[[$i getMaster] getName] eq "ot_sram_1r1w_128x256_m1_r2c2" && [string match "*u_pc17?u_rob*" [ot_rob_strip [$i getName]]]} { $i setOrient R0; $i setLocation [expr {round(1137.024 * $dbu)}] [expr {round(25.92 * $dbu)}]; $i setPlacementStatus FIRM; incr hit; incr nrob; puts "ROB place: [$i getName] at 1137.024 25.92" } }; if {$hit != 1} { error "rob_place: u_pc17.u_rob matched $hit instances" }
set nm 0; foreach i [$b getInsts] { if {[[$i getMaster] isBlock]} { incr nm } }; if {$nm != 5} { error "rob_place: expected 5 macros, netlist has $nm" }
