# generated by physical/hbm_accel_die_views/common/spine_io_min.py for hfd_cmdproc_s (die master hfd_cmdproc):
# FF hold credit of the connected die path per port (read after vclk_corner_true.sdc; FF session only)
if {[llength [get_libs -quiet *_FF_*]] && [llength [get_clocks -quiet vclk]]} {
  sta::redirect_string_begin
  report_clock_latency -clocks core_clk
  set ot_s [sta::redirect_string_end]
  if {[regexp {rise -> rise.*?([0-9.]+)\s+([0-9.]+)\s+latency} $ot_s -> ot_lo ot_hi]} {
    foreach ot_q [get_ports -quiet {cSE cSE[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 172.43}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 140.23 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {cSW cSW[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 172.48}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 140.28 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_loader f_loader[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 141.84}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 109.64 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {f_router f_router[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 68.78}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 36.58 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SE t_su_SE[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 171.3}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SW t_su_SW[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 171.3}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xb xb[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 32.2}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xl xl[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 32.2}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {xt xt[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 32.2}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 0.0 -clock vclk $ot_q } }
    puts "OT_IOMIN: per-port die-path hold credit applied"
  }
}
