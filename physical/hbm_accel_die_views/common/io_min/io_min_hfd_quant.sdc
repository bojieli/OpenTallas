# generated by physical/hbm_accel_die_views/common/spine_io_min.py for hfd_quant (die master hfd_quant):
# FF hold credit of the connected die path per port (read after vclk_corner_true.sdc; FF session only)
if {[llength [get_libs -quiet *_FF_*]] && [llength [get_clocks -quiet vclk]]} {
  sta::redirect_string_begin
  report_clock_latency -clocks core_clk
  set ot_s [sta::redirect_string_end]
  if {[regexp {rise -> rise.*?([0-9.]+)\s+([0-9.]+)\s+latency} $ot_s -> ot_lo ot_hi]} {
    foreach ot_q [get_ports -quiet {f_vm f_vm[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 84.85}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 52.65 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_NE t_su_NE[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 171.3}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_NW t_su_NW[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 171.3}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 139.1 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SE t_su_SE[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 557.75}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 525.55 -clock vclk $ot_q } }
    foreach ot_q [get_ports -quiet {t_su_SW t_su_SW[*]}] { if {[get_property $ot_q direction] eq "input"} { set_input_delay -min [expr {$ot_hi - $ot_lo + 557.75}] -clock vclk $ot_q } elseif {[get_property $ot_q direction] eq "output"} { set_output_delay -min 525.55 -clock vclk $ot_q } }
    puts "OT_IOMIN: per-port die-path hold credit applied"
  }
}
