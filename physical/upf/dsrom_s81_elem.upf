# Power intent for ot_v41_rom_elem_q_pg_w10, PG=1, NB=2, NSUB=4,
# DOM_CG=0. Scope is the element, not an S81 die or a new clock architecture.
# The retained RTL supplies the switches' controls, isolation and replay.
# Loading this file must not insert a second set of RTL clamps or shadow flops.

create_power_domain PD_AO -elements {.}
create_power_domain PD_ELEM -elements {u_pg/u_elem}

# VDD/VSS are the real R4 route's M7 supply names. VDD_ELEM is the logical
# switched rail required by this intent, NOT a claim that R4 has a segmented
# grid: the historical R4 PDN connects every cell to VDD. Header-cell mapping
# and separate switched-grid implementation remain physical qualification.
# A full UPF implementation can construct the supplies. OpenROAD's limited
# reader accepts domain/switch/isolation objects but has no supply commands;
# report that import limitation explicitly instead of installing Tcl stubs.
if {[llength [info commands create_supply_net]] &&
    [llength [info commands create_supply_port]] &&
    [llength [info commands connect_supply_net]] &&
    [llength [info commands set_domain_supply_net]]} {
    create_supply_port VDD -domain PD_AO -direction in
    create_supply_port VSS -domain PD_AO -direction in
    create_supply_net VDD -domain PD_AO
    create_supply_net VSS -domain PD_AO
    connect_supply_net VDD -ports {VDD}
    connect_supply_net VSS -ports {VSS}
    create_supply_net VDD -domain PD_ELEM -reuse
    create_supply_net VSS -domain PD_ELEM -reuse
    create_supply_net VDD_ELEM -domain PD_ELEM
    set_domain_supply_net PD_AO -primary_power_net VDD -primary_ground_net VSS
    set_domain_supply_net PD_ELEM -primary_power_net VDD_ELEM -primary_ground_net VSS
    set dsrom_s81_upf_supply_import full
} else {
    set dsrom_s81_upf_supply_import reference_only
    puts "UPF_IMPORT_LIMITATION: supply commands unavailable; VDD/VSS/VDD_ELEM references only, no physical switched-grid claim"
}

# Four existing staggered header groups. sw_ack remains the real external
# acknowledgement consumed by u_ao/u_sched; no ideal ACK source is invented.
for {set i 0} {$i < 4} {incr i} {
    create_power_switch HEADER_$i -domain PD_ELEM \
        -input_supply_port {VIN VDD} \
        -output_supply_port {VOUT VDD_ELEM} \
        -control_port [list EN [format {sw_en[%d]} $i]] \
        -on_state {ON VIN EN}
}

# All nine element output families (128 bits for NB=2) cross to the AO
# wrapper. iso_n=0 clamps each to zero BEFORE the AO fault aggregation.
# u_ao.fault also ORs late/ctl_fault: those AO diagnostics remain live.
set_isolation ELEM_OUTPUT_ZERO -domain PD_ELEM -applies_to outputs \
    -clamp_value 0 -isolation_signal {u_pg/g_pg/u_ao/iso_n} \
    -isolation_sense low -location parent

# Retention is implemented by existing AO storage, not switched-domain
# retention cells. The switched element's registers really lose state in
# tools/rom_stage_pg_sim.py; retaining them would contradict that contract.
# Keep u_pg/g_pg/u_ao (scheduler, clamps, replay and shadow) on PD_AO/VDD.
# Shadow g_sh[0..7].r = 8*43 bits; [8..15] = 8*23; [16] = 20;
# [17..24] = 8*16. Total 676 bits. Host cfg writes clock u_sh_cg while asleep;
# after wake dirty entries replay through rp_v/rp_a/rp_d before pg_ready.
set dsrom_s81_upf_retention_implementation always_on_shadow_and_replay
set dsrom_s81_upf_retained_bits 676
set dsrom_s81_upf_shadow_instances {}
for {set i 0} {$i < 25} {incr i} {
    lappend dsrom_s81_upf_shadow_instances [format {u_pg/g_pg/u_ao/g_sh[%d]/r} $i]
}
# No set_retention on PD_ELEM, no save/restore handshake, backup voltage,
# supply-good latency or level-shifter cells are fabricated by this file.
