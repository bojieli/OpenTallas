# generated by physical/dsrom_fh_safe/cl_route.sh (glue): insertion SS 330 / FF 208 ps
create_clock -name core_clk -period 833.333 [get_ports clk]
set_propagated_clock [all_clocks]
set_clock_uncertainty -setup 60 [all_clocks]
set_clock_uncertainty -hold 25 [all_clocks]
set_input_delay -max 580 -clock core_clk [all_inputs -no_clocks]
set_input_delay -min 208 -clock core_clk [all_inputs -no_clocks]
set_output_delay -max -80 -clock core_clk [all_outputs]
set_output_delay -min -258 -clock core_clk [all_outputs]
set_load 3.898 [all_outputs]
set_false_path -from [get_ports rst_n]

