 "token_patterns": [
  {
   "re": "w(\\d+)d(\\d+)(?:g(\\d+))?",
   "name": "width {0} depth {1}"
  },
  {
   "re": "d(\\d+)g(\\d+)",
   "name": "depth {0} gap {1}"
  },
  {
   "re": "m(\\d+)h(\\d+)q",
   "name": "m{0}h{1}q"
  },
  {
   "re": "(\\d+)x(\\d+)",
   "name": "{0} x {1}"
  },
  {
   "re": "ew(\\d+)",
   "name": "east-west {0}"
  },
  {
   "re": "sn(\\d+)",
   "name": "south-north {0}"
  },
  {
   "re": "ii(\\d+)",
   "name": "II={0}"
  },
  {
   "re": "NO(\\d+)",
   "name": "north output {0}"
  },
  {
   "re": "([EW])(\\d+)",
   "name": "{0}{1}"
  },
  {
   "re": "s(\\d+)",
   "name": "segment {0}"
  },
  {
   "re": "r(\\d+)([a-z]?)",
   "name": "role {0}{1}"
  },
  {
   "re": "b(\\d+)",
   "name": "band {0}"
  },
  {
   "re": "w(\\d+)",
   "name": "width {0}"
  },
  {
   "re": "d(\\d+)",
   "name": "depth {0}"
  },
  {
   "re": "c(\\d+)",
   "name": "c{0}"
  },
  {
   "re": "(\\d+)",
   "name": "#{0}"
  }
 ],
 "roles": [
  {
   "re": "(^hfd_|^ot_hbm3e|^dsfd_).*phy|ot_hbm3e_phy",
   "role": "HBM3E PHY: weight / KV bytes enter the die here every token"
  },
  {
   "re": "hfd_svc|dsfd_svc|svc_stn",
   "role": "service column: per-stack HBM stream service, feeds the field / attention tiles from the PHY"
  },
  {
   "re": "hfd_sm\\b|hfd_sm$|smh_|ot_hbm_accel_smh",
   "role": "SM tile: the matrix engines that run the token's dense layers"
  },
  {
   "re": "hfd_su|ot_su12|ot_su64|qfd_sp_su64|dsrom_su",
   "role": "SU: vector / scalar unit at the hub; norms, residuals and per-token elementwise ops"
  },
  {
   "re": "sfu|softmax|fdiv|exp",
   "role": "special functions: exponentials, divides and softmax on the token path"
  },
  {
   "re": "hfd_hc|sinkhorn|hquad|v41_fh",
   "role": "hyper-connection mixer (mHC / Sinkhorn) between layers"
  },
  {
   "re": "attn",
   "role": "attention: scores and weighted sum over the KV of every user"
  },
  {
   "re": "index_q|indexer",
   "role": "sparse-attention indexer: selects the KV positions each token attends to"
  },
  {
   "re": "hfd_vm|qfd_sp_vector_memory|qfd_vm|dsfd_vm|vector_memory",
   "role": "vector memory: the token's activations between operators"
  },
  {
   "re": "coll|tp_seq|collective|ha2_|hcoll",
   "role": "collective: all-reduce / all-gather between dies each layer"
  },
  {
   "re": "cmdproc|sequencer|ctrl|ctl",
   "role": "control: issues the per-layer instruction stream"
  },
  {
   "re": "loader|router|quant",
   "role": "hub service: loads, routes and quantises operands for the engines"
  },
  {
   "re": "stn|station|meso|gath|mcast|cdist|rly|relay|lst|cst|chead|wstg|delay|m2l|r2l|l2r|_hl_|_hr_",
   "role": "die interconnect: register stations / clock-crossing FIFOs that carry token data across the die within one clock"
  },
  {
   "re": "serdes|ucie|io_|link|pdie",
   "role": "die IO: carries the token to the next die / stage"
  },
  {
   "re": "qfd_tile|rom_elem|bf_native|dsfd_bf|dsfd_q|rom_core",
   "role": "ROM field: weights stored in ROM, multiplied with the token's activations in place"
  },
  {
   "re": "tree|retn|spine|band|slab|port_group",
   "role": "field reduction / return tree: sums field partials back to the hub"
  },
  {
   "re": "embed|emb",
   "role": "embedding: token id to vector at the start of the decode step"
  },
  {
   "re": "kvc|kv|stream4|ctrl_pc|ctrl_shift|cdc_pc",
   "role": "KV path: streams past-position KV from HBM to attention"
  },
  {
   "re": "capt|capture|colt|selt|collector|selector|cfifo|window|pq",
   "role": "DeepSeek ROM hub: capture / select / collect field results per stage"
  },
  {
   "re": "host",
   "role": "host interface"
  }
 ]
}