read_rtlil /w/gold.il; rename ot_v41_rom_elem_q_qxpq_w10_gb gold; design -stash g
read_rtlil /w/gate2.il; rename ot_v41_rom_elem_q_qxpq_w10_gb gate; design -stash h
design -copy-from g -as gold gold
design -copy-from h -as gate gate
equiv_make gold gate equiv
hierarchy -top equiv
opt_clean
equiv_simple -seq 3
equiv_induct -seq 3
tee -o /w/eq_status.txt equiv_status
equiv_status -assert
