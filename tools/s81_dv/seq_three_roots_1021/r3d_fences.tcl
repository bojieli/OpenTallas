# STW-S81c-COLLB r3d: one landing fence per region band on the child face its seam pins use;
# release exclusive regions before DPL/CTS (lp_fence_release.tcl). Generated by build_kits_r3cd.py.
set ::lpf_blk [ord::get_db_block]
set ::lpf_dbu [$::lpf_blk getDbUnitsPerMicron]
array set ::lpf_g {}
array set ::lpf_n {}
array set ::lpf_c {}
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_lk"]
odb::dbBox_create $::lpf_r [expr {round(43.200000*$::lpf_dbu)}] [expr {round(507.600000*$::lpf_dbu)}] [expr {round(469.800000*$::lpf_dbu)}] [expr {round(604.800000*$::lpf_dbu)}]
set ::lpf_g(lk) [odb::dbGroup_create $::lpf_r "lp_fence_grp_lk"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_sqS"]
odb::dbBox_create $::lpf_r [expr {round(43.200000*$::lpf_dbu)}] [expr {round(626.400000*$::lpf_dbu)}] [expr {round(469.800000*$::lpf_dbu)}] [expr {round(723.600000*$::lpf_dbu)}]
set ::lpf_g(sqS) [odb::dbGroup_create $::lpf_r "lp_fence_grp_sqS"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_sqN"]
odb::dbBox_create $::lpf_r [expr {round(43.200000*$::lpf_dbu)}] [expr {round(896.400000*$::lpf_dbu)}] [expr {round(469.800000*$::lpf_dbu)}] [expr {round(1004.400000*$::lpf_dbu)}]
set ::lpf_g(sqN) [odb::dbGroup_create $::lpf_r "lp_fence_grp_sqN"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_vc"]
odb::dbBox_create $::lpf_r [expr {round(43.200000*$::lpf_dbu)}] [expr {round(1026.000000*$::lpf_dbu)}] [expr {round(469.800000*$::lpf_dbu)}] [expr {round(1155.600000*$::lpf_dbu)}]
set ::lpf_g(vc) [odb::dbGroup_create $::lpf_r "lp_fence_grp_vc"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_lk_rst"]
odb::dbBox_create $::lpf_r [expr {round(475.200000*$::lpf_dbu)}] [expr {round(507.600000*$::lpf_dbu)}] [expr {round(507.600000*$::lpf_dbu)}] [expr {round(604.800000*$::lpf_dbu)}]
set ::lpf_g(lk_rst) [odb::dbGroup_create $::lpf_r "lp_fence_grp_lk_rst"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_sq_rst"]
odb::dbBox_create $::lpf_r [expr {round(351.000000*$::lpf_dbu)}] [expr {round(739.800000*$::lpf_dbu)}] [expr {round(469.800000*$::lpf_dbu)}] [expr {round(880.200000*$::lpf_dbu)}]
set ::lpf_g(sq_rst) [odb::dbGroup_create $::lpf_r "lp_fence_grp_sq_rst"]
set ::lpf_r [odb::dbRegion_create $::lpf_blk "lp_fence_vc_rst"]
odb::dbBox_create $::lpf_r [expr {round(475.200000*$::lpf_dbu)}] [expr {round(1026.000000*$::lpf_dbu)}] [expr {round(507.600000*$::lpf_dbu)}] [expr {round(1155.600000*$::lpf_dbu)}]
set ::lpf_g(vc_rst) [odb::dbGroup_create $::lpf_r "lp_fence_grp_vc_rst"]
array set ::lpf_own {u_lpl_0_w sqS u_lpl_0_r lk u_lpl_1_w sqS u_lpl_1_r lk u_lpl_2_w sqS u_lpl_2_r lk u_lpl_3_w sqS u_lpl_3_r lk u_lpl_4_w sqS u_lpl_4_r lk u_lpl_5_w lk u_lpl_5_r sqS u_lpl_6_w lk u_lpl_6_r sqS u_lpl_7_w lk u_lpl_7_r sqS u_lpl_8_w lk u_lpl_8_r sqS u_lpl_9_w lk u_lpl_9_r sqS u_lpl_10_w lk u_lpl_10_r sqS u_lpl_11_w lk u_lpl_11_r sqS u_lpl_12_w vc u_lpl_12_r sqN u_lpl_13_w vc u_lpl_13_r sqN u_lpl_14_w vc u_lpl_14_r sqN u_lpl_15_w sqN u_lpl_15_r vc u_lpl_16_w sqN u_lpl_16_r vc u_lpl_17_w sqN u_lpl_17_r vc u_lpl_18_w sqN u_lpl_18_r vc u_lpl_19_w sqN u_lpl_19_r vc u_lpl_20_w sqN u_lpl_20_r vc u_lpr_lk_p lk_rst u_lpr_lk_c0 lk_rst u_lpr_lk_c1 lk_rst u_lpr_lk_c2 lk_rst u_lpr_lk_c3 lk_rst u_lprc_u_l0 lk_rst u_lpr_sq_p sq_rst u_lpr_sq_c0 sq_rst u_lpr_sq_c1 sq_rst u_lpr_sq_c2 sq_rst u_lpr_sq_c3 sq_rst u_lpr_sq_c4 sq_rst u_lpr_sq_c5 sq_rst u_lpr_sq_c6 sq_rst u_lpr_sq_c7 sq_rst u_lprc_u_l1 sq_rst u_lpr_vc_p vc_rst u_lpr_vc_c0 vc_rst u_lpr_vc_c1 vc_rst u_lpr_vc_c2 vc_rst u_lpr_vc_c3 vc_rst u_lprc_u_l2 vc_rst}
proc lpf_seq {m} {
  foreach mt [$m getMTerms] { if {[$mt getSigType] eq "CLOCK"} { return 1 } }
  return 0
}
set ::lpf_reads {}
foreach i [$::lpf_blk getInsts] {
  if {[[$i getMaster] isBlock] || [[$i getMaster] getType] ne "CORE"} continue
  regsub -all {\\} [$i getName] {} n
  if {![regexp {(?:^|[./])(u_lpl_[0-9]+_[wr]|u_lpr_(?:lk|sq|vc)_(?:p|c[0-9]+)|u_lprc_u_l[0-2])[./]} $n -> h]} continue
  if {![info exists ::lpf_own($h)]} { error "LP_FENCE: $n has no landing owner" }
  if {[$i getGroup] ne "NULL"} continue
  set r $::lpf_own($h)
  $::lpf_g($r) addInst $i
  incr ::lpf_n($r)
  if {[string match *_r $h] && [lpf_seq [$i getMaster]]} { lappend ::lpf_reads [list $i $r] }
}
# read-mux cone: walk back from every read-half register's data inputs through ungrouped combinational cells
foreach ir $::lpf_reads {
  lassign $ir i r
  set front [list $i]
  for {set d 0} {$d < 16 && [llength $front]} {incr d} {
    set nxt {}
    foreach x $front {
      foreach it [$x getITerms] {
        if {![$it isInputSignal] || [[$it getMTerm] getSigType] eq "CLOCK"} continue
        set net [$it getNet]
        if {$net eq "NULL" || [$net getSigType] ne "SIGNAL"} continue
        foreach dt [$net getITerms] {
          if {![$dt isOutputSignal]} continue
          set di [$dt getInst]
          set dm [$di getMaster]
          if {[$dm isBlock] || [$dm getType] ne "CORE" || [$di getGroup] ne "NULL" || [lpf_seq $dm]} continue
          $::lpf_g($r) addInst $di
          incr ::lpf_c($r)
          lappend nxt $di
        }
      }
    }
    set front $nxt
  }
}


foreach r {lk sqS sqN vc lk_rst sq_rst vc_rst} {
  if {![info exists ::lpf_n($r)] || $::lpf_n($r) < 1} { error "LP_FENCE: region $r got no landing cells" }
  if {![info exists ::lpf_c($r)]} { set ::lpf_c($r) 0 }
  puts "LP_FENCE $r cells=$::lpf_n($r) read_cone=$::lpf_c($r)"
}
