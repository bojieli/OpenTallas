{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "M6 signal edge-contact permission with M5 routing and power cap",
 "type": "object", "additionalProperties": false,
 "required": ["schema", "master", "granted_by", "reason", "source_commit", "source_spec_sha256", "ports"],
 "properties": {
  "schema": {"const": "opentallas.m6_pin_grant.v1"},
  "master": {"type": "string", "minLength": 1},
  "granted_by": {"type": "string", "minLength": 1},
  "reason": {"type": "string", "minLength": 1},
  "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "source_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "ports": {"type": "array", "minItems": 1, "items": {
   "type": "object", "additionalProperties": false,
   "required": ["name", "face", "span_um", "max_depth_um", "max_area_um2"],
   "properties": {
    "name": {"type": "string", "minLength": 1, "pattern": "^[^*?]+$"},
    "face": {"enum": ["N", "S", "E", "W"]},
    "span_um": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
    "max_depth_um": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "max_area_um2": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
   }
  }}
 }
}
