{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opentallas.hier_contract.v1",
  "title": "Per-die top-down hierarchy contract (results/arch/hier_contract_1011/<die>.json)",
  "type": "object",
  "required": ["schema", "die", "version", "clock_period_ps", "slots"],
  "properties": {
    "schema": {"const": "opentallas.hier_contract.v1"},
    "die": {"type": "string", "description": "die name, e.g. qwen_rom, hbm_accel, ds_rom"},
    "version": {"type": "integer", "minimum": 1, "description": "bumped on every contract change (lead log entry)"},
    "updated": {"type": "string", "description": "ISO time of the last change"},
    "owner": {"type": "string", "description": "die lead tag"},
    "clock_period_ps": {"type": "number", "default": 833.333},
    "layer_defaults": {"$ref": "#/$defs/layers"},
    "changelog": {"type": "array", "items": {"type": "object", "required": ["version", "change"],
      "properties": {"version": {"type": "integer"}, "when": {"type": "string"}, "change": {"type": "string"}}}},
    "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}
  },
  "$defs": {
    "layer": {"type": "string", "pattern": "^M[1-9]$"},
    "layers": {
      "type": "object",
      "properties": {
        "pg_layer": {"$ref": "#/$defs/layer", "description": "the child's top layer: full-length VDD/VSS stripes"},
        "strap_layer": {"$ref": "#/$defs/layer", "description": "the parent strap layer = pg_layer + 1; child keeps it empty"},
        "signal_max_layer": {"$ref": "#/$defs/layer", "description": "highest layer a child signal pin / route may use"}
      }
    },
    "pin": {
      "type": "object",
      "required": ["name", "face", "layer"],
      "properties": {
        "name": {"type": "string", "description": "pin or bus 'name[msb:lsb]' (bus entries are checked for face/layer only)"},
        "face": {"enum": ["N", "S", "E", "W"]},
        "layer": {"$ref": "#/$defs/layer"},
        "offset": {"type": "number", "description": "um along the face from the slot's lower-left corner (pin centre)"},
        "width": {"type": "number", "description": "um; also the offset tolerance"},
        "direction": {"enum": ["INPUT", "OUTPUT", "INOUT"]}
      }
    },
    "slot": {
      "type": "object",
      "required": ["name", "parent", "outline", "origin", "io_budget", "clock_entry", "pg_layer", "strap_layer",
                   "signal_max_layer", "version"],
      "properties": {
        "name": {"type": "string", "description": "slot (instance) name, unique in the die"},
        "cell": {"type": "string", "description": "LEF MACRO / module name built for the slot"},
        "m6_pin_grant": {"$ref": "m6_pin_grant.schema.json"},
        "kind": {"enum": ["die", "parent", "element", "tile"]},
        "parent": {"type": ["string", "null"], "description": "enclosing slot name; null for the die top"},
        "outline": {"type": "object", "required": ["w", "h"],
          "properties": {"w": {"type": "number"}, "h": {"type": "number"}}},
        "origin": {"type": "object", "required": ["x", "y"], "description": "um, lower-left in the parent frame",
          "properties": {"x": {"type": "number"}, "y": {"type": "number"},
                         "orient": {"enum": ["R0", "MX", "MY", "R180"], "default": "R0"}}},
        "pins": {"type": "array", "items": {"$ref": "#/$defs/pin"}},
        "io_budget": {"type": "object", "required": ["in_delay_frac", "out_delay_frac"],
          "description": "fraction of clock_period_ps the parent consumes outside the slot (default 0.2 T each side)",
          "properties": {"in_delay_frac": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2},
                         "out_delay_frac": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.2},
                         "registered_in": {"type": "boolean", "default": true},
                         "registered_out": {"type": "boolean", "default": true}}},
        "clock_entry": {"type": "object", "required": ["pin", "face", "layer"],
          "properties": {"pin": {"type": "string"}, "face": {"enum": ["N", "S", "E", "W"]},
                         "offset": {"type": "number"}, "layer": {"$ref": "#/$defs/layer"}}},
        "target_insertion_ps": {"type": "number",
          "description": "clock-pin insertion delay the parent CTS balances against; child_lint (g) warns > 100 ps off"},
        "pg_layer": {"$ref": "#/$defs/layer"},
        "strap_layer": {"$ref": "#/$defs/layer"},
        "signal_max_layer": {"$ref": "#/$defs/layer"},
        "channel_um": {"type": "number", "description": "min channel to neighbours inside the parent (>= 20)"},
        "util_target": {"type": "number", "description": "placement utilisation the outline was sized for (0.5-0.6)"},
        "version": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    }
  }
}
