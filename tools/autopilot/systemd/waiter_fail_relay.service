[Unit]
Description=OpenTallas WAITER-FAIL RELAY (PLAN-GATE-PRE-1115, r196): a waiter RESULT FAIL/REFUSE/Traceback line -> NEEDS-ACTION to the die owner + COORD, keyed by line hash

[Service]
Type=oneshot
WorkingDirectory=%h/coord
# repo copy (hub-git-sync keeps ~/OpenTallas at origin/main); state ~/.local/state/waiter-fail-relay.json
ExecStart=/bin/sh -c 'exec /usr/bin/flock -n /tmp/waiter-fail-relay.lock /usr/bin/timeout 300 /usr/bin/python3 -I %h/OpenTallas/tools/autopilot/waiter_fail_relay.py >> %h/.local/state/waiter-fail-relay.log 2>&1'
Nice=10
TimeoutStartSec=400
