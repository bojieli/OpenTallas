[Unit]
Description=OpenTallas AUTOPILOT: kit queue -> ot-run -> classify -> archive / review / structural (no design changes)

[Service]
Type=oneshot
WorkingDirectory=%h/coord
Environment=AP_DIR=%h/coord/autopilot
Environment=AP_COORD=%h/coord
# repo copy once merged to main (hub-git-sync keeps ~/OpenTallas at origin/main); until then the installed copy
ExecStart=/bin/sh -c 'f=%h/OpenTallas/tools/autopilot/autopilot.py; [ -f "$f" ] || f=%h/.local/lib/autopilot/autopilot/autopilot.py; exec /usr/bin/python3 -I "$f" tick'
Nice=10
TimeoutStartSec=3000
