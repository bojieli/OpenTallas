[Unit]
Description=OpenTallas NO-PROGRESS WATCHDOG (OWNER 11-14): a running openroad/yosys/LEC job whose progress metric did not improve by 2 percent from its best in 6 h is cancelled (ot-heavy-stop); never judged by elapsed time

[Service]
Type=oneshot
Environment=OT_HUB_NAME=intel2
# the same file on every host (deployed by copy + mv); `tick` = scan --act on this host, plus the hub half where ~/coord exists
ExecStart=/usr/bin/python3 -I %h/.local/bin/ot-noprog-watchdog tick
Nice=10
KillMode=process
TimeoutStartSec=1500
