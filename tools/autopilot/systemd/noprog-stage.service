[Unit]
Description=OpenTallas NOPROG stage advisor (NOPROG-FIX-1115): per-stage progress class of every running flow job, advisory only (never cancels)

[Service]
Type=oneshot
Environment=OT_HUB_NAME=intel2
# hub only: pushes noprog_watchdog.py + noprog_stage.py to ~/.local/lib/noprog on every host, scans each, writes lanes/NOPROG.tsv, posts hourly
ExecStart=/usr/bin/python3 -I %h/.local/lib/noprog/noprog_stage.py tick
Nice=10
KillMode=process
TimeoutStartSec=900
