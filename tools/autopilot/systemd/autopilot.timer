[Unit]
Description=OpenTallas AUTOPILOT tick: next tick 2 minutes after the previous one ends

[Timer]
# FABLE-FLOW-0445 #7: ticks take 76-226 s, so a fixed 10-minute calendar saw a fail up to 10 minutes late.  OnUnitInactiveSec counts from
# the moment autopilot.service went inactive (a oneshot: when the tick exited), so the next tick starts 2 minutes after the last one ends,
# never overlaps it (systemd starts one instance of a unit; the tick also holds .tick.lock) and never queues a missed tick.
# OnActiveSec starts the first tick 30 s after the timer is enabled / started, because OnUnitInactiveSec needs a first run to count from.
OnActiveSec=30
OnUnitInactiveSec=120
AccuracySec=1s

[Install]
WantedBy=timers.target
