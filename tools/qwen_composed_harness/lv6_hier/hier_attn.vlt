`verilator_config
// Hierarchical units for the near-HBM attention service (whole-token round 3):
// the RTL binary32 units replace the C-DPI stand-ins sim_nhb_fp_lat_dpi.sv and
// sim_hdc_v41x_fastfp_dpi.sv. Hier blocks at the stack / PV-slice level keep
// the parent small (an FP-unit-level cut alone needed > 120 GB to verilate).
hier_block -module "ot_qwen_nearhbm_attn_stack_h"
hier_block -module "ot_qwen_tp8_pv256_slice"
hier_block -module "ot_hdc_fp32_add_lat"
hier_block -module "ot_hdc_fp32_mul_lat"
hier_block -module "ot_hdc_fp32_add_fast"
hier_block -module "ot_hdc_fp32_mul_fast"
