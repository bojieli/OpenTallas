`verilator_config
// Hierarchical Verilation units for the LV6 core (whole-token round 3).
// Every binary32/BF16 arithmetic unit is verilated and compiled once and
// instanced ~150k times, so the parent model no longer flattens their
// internals (the 1.46 GB root header that forced -O0).
hier_block -module "ot_hdc_fp32_add_fast"
hier_block -module "ot_hdc_fp32_mul_fast"
hier_block -module "ot_hdc_fadd"
hier_block -module "ot_hdc_fmul"
hier_block -module "ot_hdc_bmul"
