{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-only NEW-kit SAFE prototype (not a production gate)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "enabled", "new_kit", "production_activation", "top", "sources", "netlist", "libraries"],
  "properties": {
    "schema": {"const": "opentallas.safe_source_contract.prototype.v1"},
    "enabled": {"const": true},
    "new_kit": {"const": true},
    "production_activation": {"const": false},
    "top": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "netlist": {"$ref": "#/$defs/artifact"},
    "libraries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "max_loads": {"type": "integer", "minimum": 1, "maximum": 32, "default": 32}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
