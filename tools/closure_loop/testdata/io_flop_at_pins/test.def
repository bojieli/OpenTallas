VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 100000 20000 ) ;
ROW row0 site 0 0 N DO 100 BY 1 STEP 1000 0 ;
ROW row1 site 0 1000 N DO 100 BY 1 STEP 1000 0 ;
ROW row2 site 0 2000 N DO 100 BY 1 STEP 1000 0 ;
ROW row3 site 0 3000 N DO 100 BY 1 STEP 1000 0 ;
ROW row4 site 0 4000 N DO 100 BY 1 STEP 1000 0 ;
ROW row5 site 0 5000 N DO 100 BY 1 STEP 1000 0 ;
ROW row6 site 0 6000 N DO 100 BY 1 STEP 1000 0 ;
ROW row7 site 0 7000 N DO 100 BY 1 STEP 1000 0 ;
ROW row8 site 0 8000 N DO 100 BY 1 STEP 1000 0 ;
ROW row9 site 0 9000 N DO 100 BY 1 STEP 1000 0 ;
ROW row10 site 0 10000 N DO 100 BY 1 STEP 1000 0 ;
ROW row11 site 0 11000 N DO 100 BY 1 STEP 1000 0 ;
ROW row12 site 0 12000 N DO 100 BY 1 STEP 1000 0 ;
ROW row13 site 0 13000 N DO 100 BY 1 STEP 1000 0 ;
ROW row14 site 0 14000 N DO 100 BY 1 STEP 1000 0 ;
ROW row15 site 0 15000 N DO 100 BY 1 STEP 1000 0 ;
ROW row16 site 0 16000 N DO 100 BY 1 STEP 1000 0 ;
ROW row17 site 0 17000 N DO 100 BY 1 STEP 1000 0 ;
ROW row18 site 0 18000 N DO 100 BY 1 STEP 1000 0 ;
ROW row19 site 0 19000 N DO 100 BY 1 STEP 1000 0 ;
COMPONENTS 7 ;
- single DFF_TEST + PLACED ( 10000 10000 ) N ;
- dup_a DFF_TEST + PLACED ( 10000 10000 ) N ;
- dup_b DFF_TEST + PLACED ( 10000 10000 ) N ;
- rr ASYNC_DFF_TEST + PLACED ( 10000 10000 ) N ;
- reset_load DFF_TEST + PLACED ( 10000 10000 ) N ;
- obstacle DFF_TEST + FIXED ( 0 9000 ) N ;
- branch_buffer BUF_TEST + PLACED ( 10000 10000 ) N ;
END COMPONENTS
PINS 3 ;
- single_in + NET single_in + DIRECTION INPUT + USE SIGNAL + LAYER M1 ( 0 -20 ) ( 20 20 ) + FIXED ( 0 5000 ) N ;
- dup_in + NET dup_in + DIRECTION INPUT + USE SIGNAL + LAYER M1 ( 0 -20 ) ( 20 20 ) + FIXED ( 0 10000 ) N ;
- rst_in + NET rst_in + DIRECTION INPUT + USE SIGNAL + LAYER M1 ( 0 -20 ) ( 20 20 ) + FIXED ( 0 15000 ) N ;
END PINS
NETS 4 ;
- single_in ( PIN single_in ) ( single D ) ;
- dup_in ( PIN dup_in ) ( branch_buffer A ) ( dup_b D ) ;
- rst_in ( PIN rst_in ) ( rr D ) ( reset_load RESETN ) ;
- dup_branch ( branch_buffer Y ) ( dup_a D ) ;
END NETS
END DESIGN
