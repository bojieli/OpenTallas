 "pin_regs": {
  "enable": false,
  "reason": "the RTL registers every input and every output at its pin (qfd_dv_s5_vm8: p* input registers, answer / fault output registers; +1 in / +1 out priced in the slice2 schedule, bench tb_vm8 proves the edges); a flow pin register would add a second, unpriced edge"
 },
 "reset_landing": {
  "enable": false,
  "reason": "the RTL lands rst_n in two registered stages (rl0 -> rl1 on ck_wr) and rl1 resets only the sticky fault register"
 },
 "safe_design_checklist": {
  "1_pins": "PASS: RTL registers every input and every output at its pin (pin regs on 3 roots); rst_n lands rl0 -> rl1 (2 registered stages) and resets only the sticky fault; no combinational pin arc",
  "2_reach": "PASS (by floorplan): VM macros rows 0-2 <= 381 um from the S write band; table writes land twice (pin + group copy); read faces <= 259 um (W) / 216 um (E) from their pins; gate wire_reach checks 405 um",
  "3_fanout": "PASS: pre-gate mapped census (results/arch/qw_suvm8_1020/vm8/native*): kept per-(replica, bank) write registers, kept one-hot read selects, pin registers <= 20 loads",
  "4_depth": "PASS: no logic before any macro pin except the 2-register read-collision compare (10-b eq); answer path capture -> kept one-hot 2:1 x 8:1 -> answer pin register",
  "5_storage": "PASS: all > 2 kb state in 18 SRAM macros; flops are pin / capture / landing / write-stage registers",
  "6_floorplan": "PASS: x on the 43.2 lattice, y on the 8.64 track lattice, every macro channel >= 20 um (no abutted stacks), full-width S band 86.4, aspect 1.07, pin faces W 3.2 / E 1.2 / S 3.0 pins/um",
  "7_clock": "a: three regional related roots (ck_wr S band, ck_rd W + VM/CROM, ck_su E + PROG/BTAB), each < 8k flops and judged on pin-flop spread <= 80 TT+FF; b: one S-centre root (fallback); io_hold_margin 0.03",
  "8_schedule": "static, no credits/backpressure; PRICED: reads +2 (answer 2 -> 4 edges), VM writes +3 vs suvm (write->read distance 1 -> 3), table writes +2 (table write->read distance 1 -> 2), fault +1"
 },
 "structural_change": "QW-SUVM8: VM split out of suvm7 as its own hardened block; every pin registered; registered write stage at the macros; table writes landed per group; three regional related CTS roots; 3 columns, all macro channels >= 20 um",
