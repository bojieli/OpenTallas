  "record_to": "results/rtl/ref_tile/qdq_fr_ref",
  "purpose": "QDQ B2 quarter q8b (coordinator option B after q7 EARLY_FAIL: 14.3k cluster flops on a spine that diverged to 1.79 ns): one of four face-anchored M5 leaves under the wires-only ot_hgi_qdq_q, a flop at every pin; composition bench = the production QDQ bench on the B2 slice (183 cycles vs 168 priced, 1.089x) built from this commit. ot_hgi_qdq_fr: rec pin flops -> record binding -> S1 -> 7-stage span pipe -> S3 (4.3k flops); S face under the cluster rec pins, N face = registered S3 bundle to the core leaf.",
  "extra_paths": [
   "compiler",
   "results/rtl/tput_map_1011/ds_qdq_b2"
  ],
  "benches": [
   {
    "name": "descriptor_span_equivalence",
    "cmd": "bash tools/hgi_unit_tput/run_qdq_span_equiv.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/span_eq; cat {RUN}/span_eq/run.log",
    "expect": "pass",
    "pass_regex": "PASS HGI_QDQ_SPAN_EQ",
    "min_count_regex": "checked=([1-9][0-9]*)",
    "threads": 8,
    "peak_ram_gb": 16
   },
   {
    "name": "descriptor_span_mutant",
    "cmd": "SPAN_MUT=1 bash tools/hgi_unit_tput/run_qdq_span_equiv.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/span_mut; cat {RUN}/span_mut/run.log",
    "expect": "fail",
    "fail_regex": "SPAN_EQ mismatch",
    "threads": 8,
    "peak_ram_gb": 16
   },
   {
    "name": "production_qdq_m0",
    "cmd": "S=3 MUT=0 QDQ_G='-GSPANPIPE=1 -GPIN4=1' bash tools/hgi_unit_tput/run_qdq_case.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/qdq_m0 && grep -q 'cycles=183 priced=168 S=3' {RUN}/qdq_m0/run.log",
    "expect": "pass",
    "threads": 8,
    "peak_ram_gb": 16,
    "pass_regex": "PASS HGI_QDQ_Q_TPUT",
    "min_count_regex": "records=([1-9][0-9]*) words=3328"
   },
   {
    "name": "production_qdq_m1",
    "cmd": "S=3 MUT=1 QDQ_G='-GSPANPIPE=1 -GPIN4=1' bash tools/hgi_unit_tput/run_qdq_case.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/qdq_m1",
    "expect": "fail",
    "threads": 8,
    "peak_ram_gb": 16,
    "fail_regex": "FATAL: fault after 0 dones"
   },
   {
    "name": "production_qdq_m2",
    "cmd": "S=3 MUT=2 QDQ_G='-GSPANPIPE=1 -GPIN4=1' bash tools/hgi_unit_tput/run_qdq_case.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/qdq_m2",
    "expect": "fail",
