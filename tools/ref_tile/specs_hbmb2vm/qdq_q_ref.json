  ],
  "benches": [
   {
    "name": "production_qdq_exact_mutants",
    "cmd": "set -o pipefail; S=3 QDQ_G=-GSPANPIPE=1 bash tools/hgi_unit_tput/run_qdq_q.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/qdq_s3; grep -q 'FATAL: fault after 0 dones' {RUN}/qdq_s3/m1.log; grep -q 'FATAL: 2898 of 3328 words mismatch' {RUN}/qdq_s3/m2.log; grep -q 'cycles=178 priced=168 S=3' {RUN}/qdq_s3/m0.log; cat {RUN}/qdq_s3/m0.log",
    "expect": "pass",
    "pass_regex": "PASS HGI_QDQ_Q_TPUT",
    "min_count_regex": "records=([1-9][0-9]*) words=3328",
    "threads": 24,
    "peak_ram_gb": 32
   },
   {
    "name": "descriptor_span_equivalence",
    "cmd": "bash tools/hgi_unit_tput/run_qdq_span_equiv.sh results/rtl/tput_map_1011/ds_qdq_b2/lq_pair_vectors {RUN}/span_eq; cat {RUN}/span_eq/run.log",
    "expect": "pass",
    "pass_regex": "PASS HGI_QDQ_SPAN_EQ",
    "min_count_regex": "checked=([1-9][0-9]*)",
    "threads": 8,
    "peak_ram_gb": 16
   }
  ]
 },
