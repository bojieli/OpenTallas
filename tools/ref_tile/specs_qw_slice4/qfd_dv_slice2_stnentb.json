 "safe_design_checklist": {
  "1_pins": "PASS: every parent input lands on a child pin register (PIN_IN=1, in the child's own clock) or a landing ring (shared cfg / rs_s_c / rs_n_c / nb_c ring in r0, one read half per region); every output is a child flop Q; rst_n -> lp reset runs (u_lpr_*) -> each child's own 2-stage face landing",
  "2_reach": "PASS: the only plain crossings are the 1-bit reset runs; ring -> read hops are E=2 multicycle landings (<= ~700 um); fault-ring hops are neighbour landings (<= ~260 um); parent pins <= ~115 um from their child pins",
  "3_fanout": "PASS: per region one read half per landed net; reset run per region feeds <= ~8 landing halves + 1 child pin",
  "4_depth": "PASS: landing read = 4:1 registered slot select; no combinational parent path (wires-only lp parent)",
  "5_storage": "PASS: ring banks are D=4 fixed-latency landings; station storage is SRAM inside the closed children (5 each)",
  "6_floorplan": "PASS: 8 children on the 43.2 lattice (pitch 216 x 302.4), 64.8-um gaps, 151.2-um channel; outline 885.6 x 540.0 (aspect 1.64); fill ~38% children + glue; parent pins <= 3.7/um per segment",
  "7_clock": "PASS: 8 regional roots ck_r0..7, one per child, entry beside the child's ck pin; children are closed with their own trees (TT/FF insertion 277.5/231.9, spread 55/54); landed crossings between every region pair; io_hold_margin 0.03",
