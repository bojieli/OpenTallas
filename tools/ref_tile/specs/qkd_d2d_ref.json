  "owner": "Claude:el1011-q-kvd",
  "branch": "claude/el1011-q-kvd",
  "tag": "q9",
  "purpose": "q-kvd d2d-io2 q9: KV end cluster TX/RX pop timing (q8-aeca40e24 TT -611 = up_q -> 647 ps TX arbitration -> sbuf pop pin, ~660 ps internal pop cone). RTL ot_qkvd_d2d PQ (HT builds): every hard-buffer pop from a kept flop decided one cycle ahead from registered shadow occupancy (exact mirror of sbuf/fbuf8 control); kit anchors that flop at the pop pin (io_flop_at_pins.macro_pins). +1 cycle TX slot / RX face. Benches ht_layer_exact PASS / ht_layer_mut FAIL.",
  "benches": [
   {
    "name": "ht_layer_exact",
    "cmd": "HT=1 bash tools/qwen_kv_die/bench_gate.sh pos {RUN}/bench/ht_pos",
    "expect": "pass",
    "threads": 16,
    "peak_ram_gb": 128,
    "needs": [
     "verilator"
    ]
   },
   {
    "name": "ht_layer_mut",
    "cmd": "HT=1 bash tools/qwen_kv_die/bench_gate.sh neg {RUN}/bench/ht_neg 2",
    "expect": "fail",
    "threads": 16,
    "peak_ram_gb": 96,
    "needs": [
     "verilator"
    ]
   }
  ],
  "views_to": "physical/ref_tile/qkd_d2d_ref/views",
  "record_to": "results/rtl/ref_tile/qkd_d2d_ref"
 },
 "floorplan_note": "q8 (el1011-q-kvd 2026-10-12): link buffers at their INPUT faces -- TX buffers R0 on the S row under t_d (east half of S), RX buffers MX (din up) on the N rows under rx_flit (east half of N); RTL IRL/ORL relays (HT=1): one kept relay register per receive buffer next to its din, output relays toward r_d (S west) / tx_flit (N west); every parent hop <= ~480 um by pin/din geometry (q5b: rq_f -> sbuf din 814 ps of wire, RX sbufs had been placed at the S face)",
 "io_flop_at_pins": {
  "cols": 12,
  "macro_pins": [
   "pop"
  ]
 }
}
