[Unit]
Description=OpenTallas flow canary trigger (FLOW-CANARY): run die canaries when main changes flow tools

[Service]
Type=oneshot
# OT_CANARY_SRC: detached sparse main worktree the canaries build from (trigger checks it out at each new main).
# OT_CANARY_TOOL: the canary tool copy that runs (main's tools/flow_canary once merged; before that a staged copy).
Environment=OT_CANARY_SRC=/srv/opentallas-scratch2/claude/wt/flow-canary
Environment=OT_CANARY_TOOL=/srv/opentallas-scratch2/claude/flow-canary/tool/flow_canary
ExecStart=/usr/bin/python3 -I ${OT_CANARY_TOOL}/trigger.py --src ${OT_CANARY_SRC}
