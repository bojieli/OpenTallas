[Unit]
Description=OpenTallas flow canary trigger (FLOW-CANARY): run die canaries when main changes flow tools

[Service]
Type=oneshot
# OT_CANARY_SRC: persistent control repo; trigger only fetches/reads and creates isolated pinned source snapshots.
# OT_CANARY_TOOL: the canary tool copy that runs (main's tools/flow_canary once merged; before that a staged copy).
Environment=OT_CANARY_SRC=/home/ubuntu/OpenTallas
Environment=OT_CANARY_TOOL=/home/ubuntu/OpenTallas/tools/flow_canary
ExecStart=/usr/bin/python3 -I ${OT_CANARY_TOOL}/trigger.py --src ${OT_CANARY_SRC}
