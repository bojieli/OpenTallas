+        if mm and mm.group(1) in W_:
+            cen[(int(mm.group(2)) // W_[mm.group(1)], 'kr' if mm.group(1).startswith('kr') else 'k')].append((r_[0] + r_[2]) / 2)
+    snap = lambda x: 0.012 + round((x - 0.012) / 0.048) * 0.048
+    xs = {p_: [None] * b for p_, b in (('rd', HBM_RD_BITS), ('rq', PH_NPC * PH_RQ_BITS), ('rk', PH_NPC), ('wd', PH_NPC),
