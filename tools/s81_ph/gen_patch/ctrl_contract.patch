+        for i_, (p_, b_) in enumerate(bits):
+            xs[p_][b_] = round(x0 + i_ * 0.096, 4)
+    for c in range(PH_NPC):
+        lay([('rq', c * PH_RQ_BITS + i_) for i_ in range(PH_RQ_BITS)] + [('rk', c), ('wd', c)],
+            sum(cen[(c, 'k')]) / len(cen[(c, 'k')]))
+        lay([('rd', c * 256 + i_) for i_ in range(256)] + [('rd', 8192 + c * 17 + i_) for i_ in range(17)]
+            + [('rd', 8736 + c * 4 + i_) for i_ in range(4)] + [('rd', 8864 + c)], sum(cen[(c, 'kr')]) / len(cen[(c, 'kr')]))
+    gap = (max(cen[(PH_NPC // 2 - 1, 'kr')]) + min(cen[(PH_NPC // 2, 'k')])) / 2
+    lay([('ckh', 0), ('cks', 0), ('rst', 0), ('st', 0), ('st', 1)], gap)
+    assert all(v is not None for l_ in xs.values() for v in l_)
+    return xs
