+def ph_ctrl_xs():
+    """CLAUDE S81-PH ctrl contract: per-port pin x (master coordinates, M5 tracks 0.012 + n 0.048, 2-track pitch) of the
+    ctrl N face / svc S face.  PC p's request group (rq bits p*341.., rk[p], wd[p]) sits over the centroid of the PHY's
+    K pins of PC p, its response group (rd data, tag, beat, valid of PC p) over the centroid of the PHY's KR pins of PC p,
+    so every PC is a local column of the ctrl (PHY pins of PC p span ~120 um at a 265.6 um PC pitch).  Clock, reset and
+    status pins sit in the gap between PC 15 and PC 16."""
+    ph = real_lef(PHY_LEF)
+    W_ = dict(k_v=1, k_rdy=1, k_addr=30, k_len=4, k_tag=17, k_we=1, k_wdata=256, k_wstrb=32, k_wr_done=1, kr_v=1,
+              kr_rdy=1, kr_tag=17, kr_beat=4, kr_data=256)
+    cen = defaultdict(list)
+    for n_, (lay_, r_) in ph['pins'].items():
