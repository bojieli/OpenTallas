#!/usr/bin/env python3
"""ot-docker-prune [--apply]: remove UNUSED docker images that are not flow images (FLEET-OPS-R, COORD 11-17).  Never `docker image prune -a`: it removed
opentallas/orfs:asap7lock-grtoff on epyc7.  Names in tools/fleet/flow_images.txt (require + keep) and every image a container (running or not) uses are kept,
and so is any image id that a kept name points to (a second tag of the same id is not removed either).  Dry run unless --apply."""
import os, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))


def keep_names(path=os.path.join(HERE, "flow_images.txt")):
    out = set()
    for l in open(path).read().splitlines():
        p = l.split(None, 1)
        if len(p) == 2 and p[0] in ("require", "keep"):
            out.add(p[1].strip())
    return out


def plan(images, used_ids, keep):
    """images: [(ref, id)] -> ([refs to remove], [refs kept])"""
    keep_ids = {i for r, i in images if r in keep}
    rm, kept = [], []
    for r, i in images:
        (kept if (r in keep or i in used_ids or i in keep_ids) else rm).append(r)
    return rm, kept


def docker(*a):
    r = subprocess.run(["docker", *a], capture_output=True, text=True)
    if r.returncode:
        r = subprocess.run(["sudo", "-n", "docker", *a], capture_output=True, text=True)
    return r.stdout


def main(argv):
    imgs = [tuple(l.split()) for l in docker("images", "--no-trunc", "--format", "{{.Repository}}:{{.Tag}} {{.ID}}").splitlines() if len(l.split()) == 2]
    used = set(docker("ps", "-a", "--no-trunc", "--format", "{{.Image}}").split())
    ids = {i for r, i in imgs if r in used or i in used}
    rm, kept = plan(imgs, ids, keep_names())
    for r in rm:
        print(("REMOVE " if "--apply" in argv else "WOULD-REMOVE ") + r)
        if "--apply" in argv:
            docker("rmi", r)
    print("kept", len(kept), "images (flow images + in use)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
