#!/bin/bash
# ot-heavy-trim (2026-10-13 owner: reservations must not block jobs).  Every 2 min: lower the reservation of each
# RUNNING ot-heavy unit that is >= 5 min old to its observed memory + max(50 % of observed peak, 4 GB)
# (>= 30 min: + max(25 %, 2 GB)); a younger unit is charged half its original request (orig.<unit>), never below
# observed + 4 GB; never raises (ot-heavy-reconcile raises when RSS nears the reservation), never
# touches MemoryMax.  Works for waiters of every ot-heavy version because it rewrites /var/tmp/ot-heavy/res.*.
plenty=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END {print (a*100 >= t*35) ? 1 : 0}' /proc/meminfo)
D=/var/tmp/ot-heavy; up=$(awk '{print int($1)}' /proc/uptime); freed=0
for o in "$D"/orig.*; do [ -e "$o" ] || continue; [ -e "$D/res.${o##*/orig.}" ] || rm -f "$o"; done
for f in "$D"/res.*; do
  [ -e "$f" ] || continue
  read -r u m < "$f" || continue
  case "$m" in ''|*[!0-9]*) continue;; esac
  systemctl --user is-active --quiet "$u.scope" 2>/dev/null || continue
  cg=""; aem=""; cur=0
  eval "$(systemctl --user show "$u.scope" -p ControlGroup -p ActiveEnterTimestampMonotonic -p MemoryCurrent 2>/dev/null | sed -n 's/^ControlGroup=\(.*\)$/cg="\1"/p; s/^ActiveEnterTimestampMonotonic=\([0-9]*\)$/aem=\1/p; s/^MemoryCurrent=\([0-9]*\)$/cur=\1/p')"
  case "$aem" in ''|*[!0-9]*) continue;; esac
  age=$(( up - aem / 1000000 ))
  [ -f "$D/orig.$u" ] || echo "$m" > "$D/orig.$u"; read -r orig < "$D/orig.$u"; case "$orig" in ''|*[!0-9]*) orig=$m;; esac
  use=0; [ -f "$D/use.$u" ] && read -r use < "$D/use.$u"; case "$use" in ''|*[!0-9]*) use=0;; esac
  pk=0; [ -n "$cg" ] && [ -r "/sys/fs/cgroup$cg/memory.peak" ] && pk=$(( $(cat "/sys/fs/cgroup$cg/memory.peak") / 1073741824 ))
  now=$(( cur / 1073741824 + use )); obs=$now; [ $pk -gt $obs ] && obs=$pk
  if [ $age -ge 1800 ]; then cap=$(( obs / 4 )); [ $cap -lt 2 ] && cap=2; new=$(( obs + cap + 1 ))
  elif [ $age -ge 300 ]; then cap=$(( obs / 2 )); [ $cap -lt 4 ] && cap=4; new=$(( obs + cap + 1 ))
  elif [ $plenty = 1 ]; then new=$(( obs + 8 ))   # host has >= 35 % of RAM really free: a young unit is charged observed + 8 GB
  else new=$(( (orig + 1) / 2 )); [ $new -lt $(( obs + 4 )) ] && new=$(( obs + 4 )); fi   # young (< 5 min): half the request, never below observed + 4 GB
  if [ $new -lt $m ]; then
    echo "$u $new" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"
    echo "$(date -Is) TRIM $u ${m}G -> ${new}G (now ${now}G peak ${pk}G age ${age}s)" >> "$D/admit.log"
    freed=$(( freed + m - new ))
  fi
done
[ "${1:-}" = "-v" ] && echo "freed ${freed} GB"
exit 0
