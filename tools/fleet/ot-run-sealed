SCAN_PY = r"""
import json, os, re, sys
K = os.path.realpath(sys.argv[1])
rx = re.compile(r"/(?:srv|home|mnt|archive|media)/[A-Za-z0-9_.+@%=,:-]+(?:/[A-Za-z0-9_.+@%=,:-]+)*")
SKIP = {"run", "logs", "objects", "reports", "results", "__pycache__", ".git", "lec", "signoff", "geom", "tmp"}
EXT = (".mk", ".tcl", ".sdc", ".sh", ".ys", ".f")
refs = {}
for dp, dns, fns in os.walk(K):
    dns[:] = [d for d in dns if d not in SKIP and not d.startswith(("eco_", "signoff_"))]   # earlier runs' outputs
    for fn in fns:
        if not fn.endswith(EXT):
            continue
        p = os.path.join(dp, fn)
        try:
            if os.path.getsize(p) > 4 << 20:
                continue
            lines = open(p, errors="replace").read().splitlines()
        except OSError:
            continue
        for ln in lines:
            s = ln.strip()
            if s.startswith(("#", "//")):
                continue
            for m in rx.finditer(ln):
