def conf_gen_call(cmd, conf):
    """gen_call(cmd) when conf turns sealed gen on for this item, else None.  conf "gen_items" limits it to the named wave
    items (COORD 11-09: prove sealed gen on one real retry row before every row); absent = every item."""
    if not conf.get("gen"):
