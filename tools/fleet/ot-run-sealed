def decide_gen(o, flags, cmd, gc, conf, passthru, check=None, exclude=()):
    src, W = gc
    if not any(W.startswith(d.rstrip("/") + "/") for d in conf.get("dirs", [])):
        return passthru, "not a pilot dir"
    sealed_hosts = conf.get("hosts") or []
    cands = [h for h in (o.get("hosts") or "").split(",") if h in sealed_hosts] if o.get("hosts") else list(sealed_hosts)
    if not cands:
        return passthru, f"gen: none of the gen hosts {o.get('hosts')} is a sealed host"
    roots = wave_roots(W, conf["wave_conf"]) if conf.get("wave_conf") else []
    paths = gen_paths(cmd[2], src, W, roots)
    check = check or conf.get("gen_check") or gen_ok
    import concurrent.futures as cf
    with cf.ThreadPoolExecutor(max(len(cands), 1)) as ex:
        res = dict(zip(cands, ex.map(lambda h: check(h, src, W, paths), cands)))
    oks = {h: v for h, (okh, v) in res.items() if okh}
    if not oks:
        return passthru, f"gen: W/src/ot-job/bwrap not ready on {','.join(cands)}"
    backend = backend_of(conf)
    rows = status_rows(backend)
    if rows is not None:
        free = {h: v for h, v in oks.items() if h not in exclude} or oks
        host = pick_host(rows, free, o["mem"])
        if host is None and conf.get("gen_capacity_passthru"):
            return passthru, f"capacity: none of {','.join(oks)} admits {o['mem']} GB now (gen unsealed)"
        if host is None:        # gen never spills (--hosts pins it): wait SEALED where the queue is shortest; rehand re-places
            hn = lambda h: h if h != os.environ.get("OT_HUB_NAME", "intel2") else "localhost"
            host = max(free, key=lambda h: (lambda r: (r["admit"] - r["waiting_gb"]) if r and not r["held"] else -1e9)(rows.get(hn(h))))
    else:
        host = next((h for h in cands if h in oks and h not in exclude), next(h for h in cands if h in oks))
    root = (conf.get("job_root_of") or job_root)(host) if conf.get("job_roots") else None
    if conf.get("job_roots") and not root:
        return passthru, f"gen: no job root with {FETCH_DISK_GB} GB free off the root fs on {host} (gen unsealed)"
    fd, sp = tempfile.mkstemp(prefix="sealed-gen-", suffix=".json", dir=conf.get("spec_dir") or None)
    with os.fdopen(fd, "w") as fh:
        s = gen_spec(src, W, oks[host])
        if root:
            s["root"] = root
        json.dump(s, fh)
    out = [conf["sealed_backend"], "--mem", o["mem"], "--threads", o.get("threads", "2"), "--hosts", host, "--job", sp]
    if root:
        out += ["--dir", root]
    out += [f for f in flags if f != "--no-spill"]
    for k in ("priority", "max-wait"):
        if k in o:
            out += ["--" + k, o[k]]
    return out + ["--"] + cmd, f"SEALED gen on {host}: {W}"


def decide(argv, conf, check=remote_ok, fetch=None, exclude=(), source=None):
    """-> (argv to exec, why)"""
    backend = backend_of(conf)
    passthru = [backend] + list(argv)
    if not conf.get("enabled"):
        return passthru, "disabled"
    p = parse(argv)
    if not p:
        return passthru, "not a plain ot-run call"
    o, flags, cmd = p
    gc = conf_gen_call(cmd, conf)
    if gc and "mem" in o:
        return decide_gen(o, flags, cmd, gc, conf, passthru, exclude=exclude)
    pc = place_call(cmd, conf.get("stages"))
    ac = None if pc else ap_call(cmd, conf.get("ap_goals") or ())
    if not (pc or ac) or "mem" not in o:
        return passthru, "not a place call"
    if ac:
        runner, K, goal, meta = ac
        rest = [goal]
        if conf.get("ap_pilot") and not any(s in K for s in conf["ap_pilot"]):
            return passthru, "not an ap pilot kit"
        if o["stage"] and o["stage"][0].rstrip("/") != K:
            return passthru, "not a pilot dir"
    else:
        runner, K, rest = pc
    kdir = o.get("dir") or (o["stage"][0] if o["stage"] else "")
    if kdir.rstrip("/") != K or not any(K.startswith(d.rstrip("/") + "/") for d in conf.get("dirs", [])):
        return passthru, "not a pilot dir"
    hosts = conf.get("hosts") or [conf.get("host", "epyc7")]
    # REHOST-1 11-09: every sealed host that holds K + runner + ot-job/bwrap (parallel checks), not only the first
    import concurrent.futures as cf
    bundle = (meta["dir"].rstrip("/"), meta["sha256"]) if ac else None
    chk = (lambda h: check(h, runner, K, bundle)) if ac else (lambda h: check(h, runner, K))
    with cf.ThreadPoolExecutor(max(len(hosts), 1)) as ex:
        res = dict(zip(hosts, ex.map(chk, hosts)))
    oks = {h: kd for h, (okh, kd) in res.items() if okh}
    srcs = {}
    if not oks and (ac or pc) and conf.get("ap_fetch_hosts") and conf.get("ap_source_hosts"):
        # K is held only on a source host (the hub): every input is fetched from it to a sealed fetch host
        sc = source or source_ok
        srcs = {h: kd for h in conf["ap_source_hosts"] for okh, kd in [sc(h, runner, K)] if okh}
    if not oks and not srcs:
        return passthru, f"kit/runner/ot-job/bwrap not ready on {','.join(hosts)}"
    if oks:
        host = next((h for h in hosts if h in oks and h not in exclude), next(h for h in hosts if h in oks))
        kids = oks[host]
    else:
        host = next(iter(srcs))
        kids = srcs[host]
    rows, src = None, None
    fetch = fetch or fetch_ok
    if (ac or pc and conf.get("place_fetch")) and conf.get("ap_fetch_hosts"):
        # KW-FIX-44 (COORD 13:0x): when no holder of K admits the job now, run it sealed on a ready host that does,
        # with every input fetched from the holder (ot-job tar fetch into its store), and copy K back after
        rows = status_rows(backend)
        held = pick_host(rows, {h: kd for h, kd in oks.items() if h not in exclude}, o["mem"]) if rows is not None else None
        if held:                       # a holder of K admits it now: run there (the first configured host may not)
            host, kids = held, oks[held]
        elif rows is not None:
            cand = [h for h in conf["ap_fetch_hosts"] if h not in oks and h not in exclude]
            with cf.ThreadPoolExecutor(max(len(cand), 1)) as ex:
                fr = dict(zip(cand, ex.map(lambda h: fetch(h, bundle, K), cand)))
            best = pick_host(rows, {h: kd for h, (okh, kd) in fr.items() if okh}, o["mem"])
            if best:
                src, host, kids = host, best, [k for k in kids if k != "BUNDLE_OK"] + fr[best][1]
                if "K_PRESENT" in kids:                     # HUB-FETCH: K exists there; return into a private stage
                    kids = [k for k in kids if k != "K_PRESENT"]
                    STAGE[:] = [None]
    if not src and conf.get("capacity_passthru", True):
        rows = status_rows(backend)
        if rows is not None:
            best = pick_host(rows, {h: kd for h, kd in oks.items() if h not in exclude}, o["mem"])
            if best is None:
                return passthru, f"capacity: none of {','.join(oks)} admits {o['mem']} GB now (spill unsealed)"
            host, kids = best, oks[best]
    if not src and conf.get("capacity_passthru", True) and rows is None and not admits(backend, host, o["mem"]):
        # COORD 08:1x capacity: a sealed job cannot SPILL; when K's host cannot admit it now, run it unsealed so
        # ot-run can spill it to a host that admits (epyc4).  Logged as PASS capacity; it is not an ISOLATE gap.
        return passthru, f"capacity: {host} does not admit {o['mem']} GB now (spill unsealed)"
    if pc and conf.get("declare") in ("warn", "enforce"):
        refs = (conf.get("scan_of") or kit_refs)(src or host, K)        # on the host that HOLDS K
        if refs is None:
            bad, extra = [("?", "kit scan failed on " + host, False)], []
        else:
            extra, bad = declared_inputs(refs, runner, kids, conf,
                                         wave_roots(K, conf["wave_conf"]) if conf.get("wave_conf") else ())
        if bad and conf["declare"] == "enforce":
            msg = "; ".join(f"{r} (named in {f}{'' if e else ', missing'})" for r, f, e in bad[:8])
            return [REFUSE, K, rest[0], json.dumps(bad[:50])], f"REFUSED {K}: undeclared input path(s): {msg}"
        if bad:
            DECLARE_WARN[:] = bad
        kids = list(kids) + [x["path"] for x in extra]
    if not oks and not src:
        # a source-only holder cannot run the sealed job itself; no fetch host qualifies -> unsealed, as before
        return passthru, f"kit held only on {host} (no ot-job) and no fetch host admits {o['mem']} GB now"
    root = (conf.get("job_root_of") or job_root)(host) if ((ac or pc) and conf.get("job_roots")) else None
    fd, sp = tempfile.mkstemp(prefix="sealed-", suffix=".json", dir=conf.get("spec_dir") or None)
    with os.fdopen(fd, "w") as fh:
        if ac:
            bok = "BUNDLE_OK" in kids
            s = ap_spec(runner, K, rest[0], meta, [k for k in kids if k != "BUNDLE_OK"], bok)
            if src:
                s = fetched(s, src)
                s["copy_back"] = {"from": host, "to": src, "path": K}
                stage_return(s, root, K)
            if root:
                s["root"] = root
            json.dump(s, fh)
        else:
            s = spec_for(runner, K, kids, rest[0])
            if src:
                s = fetched(s, src)
                s["copy_back"] = {"from": host, "to": src, "path": K}
                stage_return(s, root, K)
            if root:
                s["root"] = root
            json.dump(s, fh)
    out = [conf["sealed_backend"], "--mem", o["mem"], "--threads", o.get("threads", "16"), "--hosts", otrun_host(host),
           "--job", sp]
    if root:
        out += ["--dir", root]         # ot-run's placement / disk guard / cd use the job root (its default is scratch2)
    out += [f for f in flags if f != "--no-spill"]
    if "priority" in o:
        out += ["--priority", o["priority"]]
    if "max-wait" in o:
        out += ["--max-wait", o["max-wait"]]
    return out + ["--"] + cmd, f"SEALED on {host}: {K}" + (f" (inputs fetched from {src})" if src else "")


ENOENT = re.compile(r"No such file or directory|FileNotFoundError|ENOENT|not found: /|missing\b")
APATH = re.compile(r"(/(?:srv|home|mnt|archive|tmp|var/tmp|media)/[^\s'\":,;()\[\]]+)")


def gaps_in(text, K, job_root="/srv/opentallas-scratch2/claude/ot-jobs/"):
    """-> [(path, tool line)] for missing-input errors on paths outside the sealed job (K, the job root)"""
    out, seen = [], set()
    for ln in text.splitlines():
        if not ENOENT.search(ln):
            continue
        for p in APATH.findall(ln):
            p = p.rstrip(".")
            if p == K or p.startswith(K + "/") or p.startswith(job_root) or p in seen:
                continue
            seen.add(p)
            out.append((p, ln.strip()[:200]))
    return out


def gap_row(conf, K, stage, path, tool):
    """one ISOLATE-GAPS.tsv row: time, die, type, stage, path, tool line"""
    die = K.split("/runs/", 1)[1].split("/", 1)[0] if "/runs/" in K else "?"
    typ = K.split("/items/", 1)[1].split("/", 1)[0] if "/items/" in K else os.path.basename(K)
    row = "\t".join([time.strftime("%Y-%m-%d %H:%M:%S %Z"), die, typ, stage, path, tool.replace("\t", " ")])
    try:
        with open(os.path.expanduser(conf.get("gaps", "~/.local/lib/fleet/isolate-1/ISOLATE-GAPS.tsv")), "a") as fh:
            fh.write(row + "\n")
    except OSError:
        pass


LAST_OUT = []


def not_admitted(out):
    """the sealed client ended without its job ever starting: ot-heavy gave up waiting (--max-wait) -> NOT RUN"""
    text = "".join(out)
    return "ot-heavy: admitted" not in text and "ot-job: SEALED" not in text and bool(
        re.search(r"ot-run: NOT RUN on \S+: ot-heavy exit 75", text))


def with_max_wait(argv, s):
    """the sealed backend argv with --max-wait S (before '--'), replacing any given one"""
    i = argv.index("--")
    head, tail = argv[:i], argv[i:]
    if "--max-wait" in head:
        j = head.index("--max-wait")
        head = head[:j] + head[j + 2:]
    return head + ["--max-wait", str(int(s))] + tail


def run_sealed(argv, conf, orig):
    """run the sealed job, streaming its output; on a missing undeclared input outside the job, log the gap(s) and
    rerun ONCE unsealed (OWNER 11-09 08:2x fallback) -> exit code"""
    p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):    # the wave stops a client: stop the job client too
        signal.signal(sig, lambda n, f: (p.send_signal(n), sys.exit(128 + n)))
    buf = []
    for ln in p.stdout:
        sys.stdout.write(ln)
        sys.stdout.flush()
        buf.append(ln)
        if len(buf) > 20000:
            del buf[:5000]
    rc = p.wait()
    LAST_OUT[:] = buf[-200:]
    if rc == 0 or not conf.get("fallback_unsealed", True):
        return rc
    po = parse(orig)
    tg = sealed_target(po[2], conf) if po else None
    if not tg:
        return rc
    K, stage = tg
    gaps = gaps_in("".join(buf), K)
    if not gaps and stage == "gen" and rc not in (75, 96) and "ot-run: NOT RUN" not in "".join(buf[-50:]):
        gaps = [("(sealed gen rc %d)" % rc, (LAST_OUT[-1].strip() if LAST_OUT else "")[:300])]
    if not gaps:
        return rc
    for path, tool in gaps:
        gap_row(conf, K, stage, path, tool)
    log(conf, f"GAP {len(gaps)} {K} {stage}: rerun unsealed once ({gaps[0][0]})")
    print(f"ot-run-sealed: ISOLATE-GAP {len(gaps)} path(s) outside the job (first {gaps[0][0]}); rerun UNSEALED once",
          file=sys.stderr, flush=True)
    backend = backend_of(conf)
    return subprocess.call([backend] + list(orig))


def sealed_ap(argv, conf):
    """is this a sealed autopilot job (spec with tools_sha256), i.e. one whose inputs are declared / fetchable"""
    try:
        s = json.load(open(argv[argv.index("--job") + 1])) if "--job" in argv else {}
        return "tools_sha256" in s or s.get("schema") == "opentallas.ot_job.v1"
    except (OSError, ValueError):
        return False


def rehand(argv, conf, why):
    """KW-FIX-44 COORD 15:5x (load imbalance class): a sealed autopilot job waits at most conf rehand_after_s (600) on
    its host; when ot-heavy has not admitted it by then the client is cancelled there (never started: NOT RUN, exit 75)
    and the job is placed again on another qualifying host -- a holder that admits now, or a fetch host -- (the host it
    waited on is excluded for that pick; with no other host it waits there again).  At most rehand_max rounds
    (default 12), then the last placement waits without a bound, as before.  -> (rc, argv of the last round)"""
    after, rounds, tried = int(conf.get("rehand_after_s") or 0), int(conf.get("rehand_max", 12)), []
    n = 0
    while True:
        bounded = after > 0 and sealed_ap(argv, conf) and n < rounds
        a = with_max_wait(argv, after) if bounded else argv
        rc = run_sealed(a, conf, sys.argv[1:])
        if not (bounded and rc and not_admitted(LAST_OUT)):
            return rc, argv
        host = argv[argv.index("--hosts") + 1]
        tried.append(host)
        n += 1
        argv2, why2 = decide(sys.argv[1:], conf, exclude=(host,) + (tuple(HUB_LOCAL) if host in HUB_LOCAL else ()))
        if argv2[0] == backend_of(conf):          # never fall back to unsealed on a re-hand: wait sealed where it was
            argv2, why2 = argv, why
        if argv2[argv2.index("--hosts") + 1] == host:
            n = rounds          # no other host qualifies: wait there without a bound (each round costs queue seniority)
        log(conf, f"REHAND {n}: not admitted on {host} in {after} s -> {why2} pid {os.getpid()}")
        print(f"ot-run-sealed: REHAND {n}: not admitted on {host} in {after} s -> {why2}", file=sys.stderr, flush=True)
        argv, why = argv2, why2


def main():
    conf = load_conf()
    argv, why = decide(sys.argv[1:], conf)
    if argv[0] == REFUSE:
        # fail closed at submit (COORD 17:3x step 2): nothing ran; the reason names every undeclared path
        log(conf, f"{why} pid {os.getpid()}")
        if json.loads(argv[3])[:1] and json.loads(argv[3])[0][0] == "?":
            # the scan itself did not run (ssh): an infra NOT RUN the caller retries, never a design refusal
            print(f"ot-run: NOT RUN: ot-run-sealed {why}", file=sys.stderr, flush=True)
            sys.exit(75)
        for r, f, _e in json.loads(argv[3]):
            gap_row(conf, argv[1], argv[2], r, f"REFUSED at submit: named in {f}")
        print(f"ot-run-sealed: {why}", file=sys.stderr, flush=True)
        sys.exit(96)
    if DECLARE_WARN:
        k = argv[argv.index("--job") + 1] if "--job" in argv else "?"
        for r, f, _e in DECLARE_WARN:
            gap_row(conf, (parse(sys.argv[1:]) or [{}])[0].get("dir", "?"), "declare-warn", r, f"WARN undeclared, named in {f} ({k})")
        print(f"ot-run-sealed: WARN {len(DECLARE_WARN)} undeclared input path(s) (declare=warn): "
              + "; ".join(r for r, _f, _e in DECLARE_WARN[:5]), file=sys.stderr, flush=True)
    if argv[0] != backend_of(conf):
        log(conf, f"{why} pid {os.getpid()}")
        print(f"ot-run-sealed: {why}", file=sys.stderr, flush=True)
        rc, argv = rehand(argv, conf, why)
        try:
            cb = json.load(open(argv[argv.index("--job") + 1])).get("copy_back") if "--job" in argv else None
        except (OSError, ValueError):
            cb = None
        if cb:
            crc = copy_back(cb["from"], cb["to"], cb["path"], cb.get("stage"))
            log(conf, f"COPY-BACK {cb['path']} {cb['from']} -> {cb['to']} rc {crc}")
            print(f"ot-run-sealed: copy-back {cb['from']} -> {cb['to']} rc {crc}", file=sys.stderr, flush=True)
            if crc and not rc:
                rc = 97
        sys.exit(rc)
    elif why in ("not a pilot dir",) or why.startswith("kit/runner") or why.startswith("capacity"):
        p = parse(sys.argv[1:])
        k = (p[0].get("dir") or "?") if p else "?"
        if why.startswith(("kit/runner", "capacity")) or any(k.startswith(d) for d in conf.get("dirs", [])) or "/runs/qwen_kvsys/" in k:
            log(conf, f"PASS place {k}: {why}")             # a pilot-die place call that ran unsealed, and why
    os.execv(argv[0], argv)


if __name__ == "__main__":
    main()
