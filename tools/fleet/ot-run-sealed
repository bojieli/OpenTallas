#!/usr/bin/python3 -I
"""ot-run-sealed: drop-in ot-run for the kit wave (kit_wave.json "ot_run") that runs the PLACE stage of pilot rows as a
SEALED JOB (ISOLATE-1 pilot, OWNER 2026-11-09 "yes, isolate the jobs. simply delete the finished job folder").

Every other call is passed unchanged to the configured backend (the wave's current ot-run).  A call is sealed when
  - the config is enabled, and the kit dir (--dir, or the first --stage) lies under one of its "dirs" prefixes;
  - the command is the wave's place command: bash -c "bash <runner> <K> place <mem> <threads>";
  - the kit and its runner exist on the pilot host (checked over ssh), and the host's ot-job is installed.
The sealed job: work dir = a private copy of K, seen by the job at K's own path; runner = read-only input;
everything else on the host invisible.  At exit: run/ is published to the host store (artifact record with
producer), the whole work dir is copied back to K on the pilot host (so the wave reads K exactly as before), and
the job dir is deleted.  The client prints ot-run's own "ot-run: RAN on <host>" line, which the wave already parses.

Config (JSON; $OT_RUN_SEALED_CONF, default ~/.local/lib/fleet/isolate-1/sealed.json):
  {"enabled": true, "host": "epyc7", "dirs": ["/srv/.../runs/qwen_kvsys/"], "backend": "/home/ubuntu/.local/lib/kw23/ot-run",
   "sealed_backend": "/home/ubuntu/.local/lib/fleet/isolate-1-<sha>/ot-run", "log": "~/.local/lib/fleet/isolate-1/sealed.log"}
A missing or unreadable config, or "enabled": false, passes everything to the backend.  Revert = kit_wave.json ot_run back.
KW-FIX-42 11-09 (OWNER 08:2x all dies / all stages): conf "stages" (runner stage words sealed, default ["place"]),
"hosts" (the first that holds K + runner + ot-job/bwrap), and the fallback: a sealed job that fails on a missing input
outside the job dir is logged to conf "gaps" (ISOLATE-GAPS.tsv: time die type stage path tool) and rerun ONCE unsealed.
KW-FIX-44 11-09 (COORD KW44-5, OWNER legacy-delete goal: no job reads another job's files): the stages AFTER place.
autopilot submit() runs route / finish (signoff_chain.py: route, sign-off, the late ECO, the routed LEC) as
  ot-run --mem M --threads T --dir K --stage K [--stage R] [--priority die --crit] -- python3 -c <ADMISSION_BOOTSTRAP>
         <b64 meta> [--no-late-eco] R K <goal> M T
Such a call is sealed when conf "ap_goals" names the goal (opt-in; absent = every autopilot call passes through as
before) and, while conf "ap_pilot" is a non-empty list, K contains one of its strings.  Declared inputs: the runner (when
outside K), the admission tool bundle pinned by sha (meta dir; BUNDLE.json sha256 must equal meta sha256 on the host,
else the bundle is fetched from the hub into the job's store and the bootstrap's own sha check still gates it), and the
KWCHILD records.  Work = a private copy of K (the sealed place output that was returned to K).  run/ and signoff*/ go
to the store; the work dir is returned to K, so autopilot classifies K exactly as before.  $OT_RUN_SEALED_BACKEND
overrides conf "backend" for the passthrough, so autopilot keeps its own ot-run (kw10) for every call not sealed.
"""
import base64
import json
import os
import re
import signal
import shlex
import subprocess
import sys
import tempfile
import time

DEFAULT_BACKEND = "/home/ubuntu/.local/lib/kw23/ot-run"


def backend_of(conf):
    """the passthrough ot-run: $OT_RUN_SEALED_BACKEND (autopilot's own), else conf "backend" (the wave's)"""
    return os.environ.get("OT_RUN_SEALED_BACKEND") or conf.get("backend") or DEFAULT_BACKEND
CONF = os.environ.get("OT_RUN_SEALED_CONF", os.path.expanduser("~/.local/lib/fleet/isolate-1/sealed.json"))


def load_conf():
    try:
        with open(CONF) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def parse(argv):
    """-> (opts dict, flags list, cmd list) of an ot-run argv, or None"""
    if "--" not in argv:
        return None
    pre, cmd = argv[:argv.index("--")], argv[argv.index("--") + 1:]
    o, flags, i = {"stage": []}, [], 0
    while i < len(pre):
        x = pre[i]
        if x in ("--mem", "--threads", "--dir", "--hosts", "--max-wait", "--disk", "--priority"):
            o[x[2:]] = pre[i + 1]
            i += 2
        elif x == "--stage":
            o["stage"] += pre[i + 1].split(",")
            i += 2
        elif x in ("--crit", "--direct", "--no-spill"):
            flags.append(x)
            i += 1
        else:
            return None                                  # an option this wrapper does not know: never guess
    return o, flags, cmd


STAGES = ("place",)


def place_call(cmd, stages=None):
    """bash -c "bash <runner> <K> <stage> <mem> <threads>" -> (runner, K, rest) or None (stage in conf "stages")"""
    if len(cmd) != 3 or cmd[:2] != ["bash", "-c"]:
        return None
    try:
        w = shlex.split(cmd[2])
    except ValueError:
        return None
    if len(w) >= 4 and w[0] == "bash" and w[3] in (stages or STAGES) and os.path.isabs(w[1]) and os.path.isabs(w[2]):
        return w[1], w[2].rstrip("/"), w[3:]
    return None


AP_MARK = "ADMISSION_TOOLS READY"     # a line only autopilot's ADMISSION_BOOTSTRAP prints


def ap_call(cmd, goals=()):
    """autopilot's bootstrap command -> (runner, K, goal, meta) when its goal is in `goals`, else None"""
    if len(cmd) < 9 or cmd[0] not in ("python3", "/usr/bin/python3") or cmd[1] != "-c" or AP_MARK not in cmd[2]:
        return None
    try:
        meta = json.loads(base64.b64decode(cmd[3]))
    except (ValueError, TypeError):
        return None
    rest = cmd[4:]
    while rest and rest[0].startswith("--"):            # chain flags before the runner (--no-late-eco)
        rest = rest[1:]
    if len(rest) != 5 or not isinstance(meta, dict) or not meta.get("dir") or not meta.get("sha256"):
        return None
    runner, K, goal = rest[0], rest[1].rstrip("/"), rest[2]
    if goal not in goals or not (os.path.isabs(runner) and os.path.isabs(K) and os.path.isabs(meta["dir"])):
        return None
    return runner, K, goal, meta


def sealed_target(cmd, conf):
    """(K, stage) of a call this wrapper seals (place or autopilot), else None"""
    pc = place_call(cmd, conf.get("stages"))
    if pc:
        return pc[1], pc[2][0]
    ac = ap_call(cmd, conf.get("ap_goals") or ())
    return (ac[1], ac[2]) if ac else None


def ap_spec(runner, K, goal, meta, children=(), bundle_ok=True):
    """route/finish job: work = K; inputs = runner (outside K), the sha-pinned tool bundle, child records"""
    s = spec_for(runner, K, children, goal)
    b = {"path": meta["dir"].rstrip("/"), "at": meta["dir"].rstrip("/")}
    if not bundle_ok:           # not (or not this sha) on the host: fetched from the hub into the job store
        b["host"] = meta.get("source_host") or "hub"
    s["inputs"].insert(0, b)
    s["publish"].append({"name": f"kit-wave/{os.path.basename(K)}/{goal}-signoff", "path": "signoff", "when": "always"})
    s["tools_sha256"] = meta["sha256"]
    return s


def spec_for(runner, K, children=(), stage="place"):
    name = os.path.basename(K) + "-" + stage
    inputs = [] if (runner == K or runner.startswith(K + "/")) else [{"path": runner}]
    inputs += [{"path": c} for c in children]           # KWCHILD signed child records, read-only at their own paths
    return {"schema": "opentallas.ot_job.v1", "name": name, "inputs": inputs,
            "work": {"at": K, "seed": [{"path": K}]},
            "publish": [{"name": f"kit-wave/{os.path.basename(K)}/{stage}-run", "path": "run", "when": "always"}],
            "return": {"to": K, "paths": ["."]}}


# the same selection run_kit.sh's KWCHILD block makes (macros/*.provenance.json -> signed record dir + its lec dir)
KWCHILD_PY = r"""
import json, os, sys
from pathlib import Path
K = Path(sys.argv[1]); out = set()
for pf in sorted((K / 'macros').glob('*.provenance.json')):
    try:
        prov = json.loads(pf.read_text())
    except (OSError, ValueError):
        continue
    so = (prov.get('export') or {}).get('signoff')
    if not so:
        continue
    if not os.path.isabs(so):
        so = str((pf.parent / so).resolve())
    rec = Path(so).parent.parent
    if rec.is_dir():
        out.add(str(rec))
    try:
        lec = json.loads((rec / 'PROVENANCE.json').read_text()).get('lec')
    except (OSError, ValueError, AttributeError):
        lec = None
    if lec and os.path.isabs(lec) and Path(lec).exists():
        out.add(str(Path(lec).parent))
k = os.path.realpath(K)
for p in sorted(out):
    r = os.path.realpath(p)
    if r != k and not r.startswith(k + '/') and ':' not in p:
        print('CHILD ' + p)
"""


BUNDLE_PY = r"""
import json, sys
try:
    ok = json.load(open(sys.argv[1] + '/BUNDLE.json'))['sha256'] == sys.argv[2]
except (OSError, ValueError, KeyError, TypeError):
    ok = False
print('BUNDLE_OK' if ok else 'BUNDLE_MISSING')
"""


def remote_ok(host, runner, K, bundle=None):
    """-> (ok, child record dirs) from one ssh to the pilot host; bundle=(dir, sha): a 'BUNDLE_OK' child entry says the
    sha-pinned tool bundle is on the host already"""
    sh = (f"test -d {shlex.quote(K)} && test -f {shlex.quote(runner)} && test -x $HOME/.local/bin/ot-job "
          f"&& bwrap --ro-bind / / --dev /dev true && echo SEALED_OK && python3 -I -c {shlex.quote(KWCHILD_PY)} {shlex.quote(K)}")
    if bundle:
        sh += f" && python3 -I -c {shlex.quote(BUNDLE_PY)} {shlex.quote(bundle[0])} {shlex.quote(bundle[1])}"
    try:
        p = subprocess.run(["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", host, sh],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return False, []
    kids = [ln[6:] for ln in p.stdout.splitlines() if ln.startswith("CHILD ")]
    if bundle and "BUNDLE_OK" in p.stdout.split():
        kids.append("BUNDLE_OK")
    return "SEALED_OK" in p.stdout and p.returncode == 0, kids


FETCH_JOBS = "/srv/opentallas-scratch2/claude/ot-jobs"      # ot-run --dir of a sealed job (it is skipped where absent)
FETCH_DISK_GB = 60      # ot-run refuses a scratch disk under its 50 GB floor (kv 98b92a196255 a3 13:4x on epyc2: 43 GB -> NOT RUN)


def fetch_ok(host, bundle=None, K=None):
    """KW-FIX-44 (COORD 13:0x cross-host): a host that does NOT hold K but can run a sealed job that fetches its inputs:
    ot-job + bwrap there.  -> (ok, ['BUNDLE_OK'] when the sha-pinned bundle is already on it)"""
    # K must be ABSENT there: the returned copy is then ours alone and is removed after the copy-back
    sh = (f"test ! -e {shlex.quote(K)} && " if K else "") + f"test -d {shlex.quote(FETCH_JOBS)} && test $(df --output=avail -BG {shlex.quote(os.path.dirname(os.path.dirname(FETCH_JOBS)))} | tail -1 | tr -dc 0-9) -ge {FETCH_DISK_GB} && test -x $HOME/.local/bin/ot-job && bwrap --ro-bind / / --dev /dev true && echo SEALED_OK"
    if bundle:
        sh += f" && python3 -I -c {shlex.quote(BUNDLE_PY)} {shlex.quote(bundle[0])} {shlex.quote(bundle[1])}"
    try:
        p = subprocess.run(["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", host, sh],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return False, []
    return "SEALED_OK" in p.stdout and p.returncode == 0, (["BUNDLE_OK"] if "BUNDLE_OK" in p.stdout.split() else [])


def fetched(spec, src):
    """the spec with every input / work seed fetched from `src` (the host that holds K), not read on the job host"""
    for i in spec["inputs"]:
        i.setdefault("host", src)
    for s in spec["work"]["seed"]:
        s.setdefault("host", src)
    return spec


def copy_back(host, src, K):
    """after a fetched job: the returned K on `host` goes back to K on `src` (where the wave and autopilot read it),
    as ot-run's spill copy-back does; the marker is never copied.  -> rc"""
    par, base = os.path.dirname(K), os.path.basename(K)
    try:            # the job never ran there (NOT RUN): nothing came back, nothing to copy
        if subprocess.run(["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", host, f"test -d {shlex.quote(K)}"],
                          timeout=60).returncode:
            return 0
    except (OSError, subprocess.TimeoutExpired):
        return 98
    pull = ["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", host,
            f"tar -C {shlex.quote(par)} --exclude=.ot-run-spill-copy -cf - {shlex.quote(base)}"]
    push = ["ssh", "-o", "ControlPath=none", "-o", "BatchMode=yes", src, f"tar -C {shlex.quote(par)} -xf -"]
    a = subprocess.Popen(pull, stdout=subprocess.PIPE)
    b = subprocess.run(push, stdin=a.stdout)
    a.stdout.close()
    rc = a.wait() or b.returncode
    if not rc:      # K was absent on `host` before the job (fetch_ok), so this copy is ours alone
        subprocess.run(["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", host,
                        f"rm -rf --one-file-system -- {shlex.quote(K.rstrip('/'))}"], timeout=1800)
    return rc


def log(conf, msg):
    try:
        with open(os.path.expanduser(conf.get("log", "~/.local/lib/fleet/isolate-1/sealed.log")), "a") as fh:
            fh.write(time.strftime("%Y-%m-%d %H:%M:%S %Z ") + msg + "\n")
    except OSError:
        pass


def status_rows(backend):
    """-> {host: {"admit", "waiting_gb", "load", "ncpu", "capped", "held"}} from one ot-run --status, or None"""
    try:
        p = subprocess.run([backend, "--status"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    out = {}
    for seg in (p.stdout or "").replace("ot-run status: ", "", 1).split(" | "):
        f = seg.split()
        if not f:
            continue
        h = f[0]
        if len(f) > 1 and f[1] in ("HELD", "REFUSED", "unreachable"):
            out[h] = dict(admit=0, waiting_gb=0.0, load=0.0, ncpu=1, capped=False, held=True)
            continue
        m = re.match(r"\S+ admits (-?\d+) GB", seg)
        if not m:
            continue
        ld = re.search(r" load (\d+(?:\.\d+)?)/(\d+)", seg)
        w = re.search(r" waiters \d+:(\d+(?:\.\d+)?) GB", seg)
        out[h] = dict(admit=int(m.group(1)), waiting_gb=float(w.group(1)) if w else 0.0,
                      load=float(ld.group(1)) if ld else 0.0, ncpu=max(int(ld.group(2)), 1) if ld else 1,
                      capped=" LOADCAP" in seg, held=False)
    return out


def row_admits(r, mem):
    return bool(r) and not r["held"] and not r["capped"] and r["admit"] - r["waiting_gb"] >= int(float(mem))


def pick_host(rows, oks, mem):
    """among the hosts that hold the inputs (oks: host -> kids), those that admit MEM now; the lowest load/cores,
    then the most memory left after the queued waiters.  -> host or None"""
    fit = [h for h in oks if row_admits((rows or {}).get(h if h != os.environ.get("OT_HUB_NAME", "intel2") else "localhost"), mem)]
    if not fit:
        return None
    key = lambda h: (lambda r: (round(r["load"] / r["ncpu"], 2), -(r["admit"] - r["waiting_gb"])))(
        rows[h if h != os.environ.get("OT_HUB_NAME", "intel2") else "localhost"])
    return min(fit, key=key)


def admits(backend, host, mem):
    """True when ot-run --status says HOST admits >= MEM GB now (unknown -> True, the pilot behaviour)"""
    try:
        p = subprocess.run([backend, "--status"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return True
    h = "localhost" if host == os.environ.get("OT_HUB_NAME", "intel2") else host
    m = re.search(r"(?:^|\| )" + re.escape(h) + r" admits (-?\d+) GB", p.stdout or "")
    if not m:
        return not re.search(r"(?:^|\| )" + re.escape(h) + r" (?:REFUSED|HELD)", p.stdout or "")
    # REHOST-1 11-09 (COORD 09:2x): "admits N GB" is memory only.  A sealed job is pinned (--hosts, no spill, no
    # re-place), so it must not be pinned to a host whose ot-heavy holds it on the load cap (status says LOADCAP) or
    # whose queued waiters already claim that memory (epyc7 09:2x: admits 104, waiters 45:1950 GB, load 186/96 ->
    # 12 sealed PLACE jobs pinned behind the queue).  Such a call runs unsealed, so ot-run can spill it.
    seg = (p.stdout or "")[m.start():].split(" | ", 1)[0]
    if " LOADCAP" in seg:
        return False
    w = re.search(r" waiters \d+:(\d+(?:\.\d+)?) GB", seg)
    try:
        return int(m.group(1)) - (float(w.group(1)) if w else 0.0) >= int(float(mem))
    except ValueError:
        return True


def decide(argv, conf, check=remote_ok, fetch=None):
    """-> (argv to exec, why)"""
    backend = backend_of(conf)
    passthru = [backend] + list(argv)
    if not conf.get("enabled"):
        return passthru, "disabled"
    p = parse(argv)
    if not p:
        return passthru, "not a plain ot-run call"
    o, flags, cmd = p
    pc = place_call(cmd, conf.get("stages"))
    ac = None if pc else ap_call(cmd, conf.get("ap_goals") or ())
    if not (pc or ac) or "mem" not in o:
        return passthru, "not a place call"
    if ac:
        runner, K, goal, meta = ac
        rest = [goal]
        if conf.get("ap_pilot") and not any(s in K for s in conf["ap_pilot"]):
            return passthru, "not an ap pilot kit"
        if o["stage"] and o["stage"][0].rstrip("/") != K:
            return passthru, "not a pilot dir"
    else:
        runner, K, rest = pc
    kdir = o.get("dir") or (o["stage"][0] if o["stage"] else "")
    if kdir.rstrip("/") != K or not any(K.startswith(d.rstrip("/") + "/") for d in conf.get("dirs", [])):
        return passthru, "not a pilot dir"
    hosts = conf.get("hosts") or [conf.get("host", "epyc7")]
    # REHOST-1 11-09: every sealed host that holds K + runner + ot-job/bwrap (parallel checks), not only the first
    import concurrent.futures as cf
    bundle = (meta["dir"].rstrip("/"), meta["sha256"]) if ac else None
    chk = (lambda h: check(h, runner, K, bundle)) if ac else (lambda h: check(h, runner, K))
    with cf.ThreadPoolExecutor(max(len(hosts), 1)) as ex:
        res = dict(zip(hosts, ex.map(chk, hosts)))
    oks = {h: kd for h, (okh, kd) in res.items() if okh}
    if not oks:
        return passthru, f"kit/runner/ot-job/bwrap not ready on {','.join(hosts)}"
    host = next(h for h in hosts if h in oks)
    kids = oks[host]
    rows, src = None, None
    fetch = fetch or fetch_ok
    if ac and conf.get("ap_fetch_hosts"):
        # KW-FIX-44 (COORD 13:0x): when no holder of K admits the job now, run it sealed on a ready host that does,
        # with every input fetched from the holder (ot-job tar fetch into its store), and copy K back after
        rows = status_rows(backend)
        if rows is not None and pick_host(rows, oks, o["mem"]) is None:
            cand = [h for h in conf["ap_fetch_hosts"] if h not in oks]
            with cf.ThreadPoolExecutor(max(len(cand), 1)) as ex:
                fr = dict(zip(cand, ex.map(lambda h: fetch(h, bundle, K), cand)))
            best = pick_host(rows, {h: kd for h, (okh, kd) in fr.items() if okh}, o["mem"])
            if best:
                src, host, kids = host, best, [k for k in kids if k != "BUNDLE_OK"] + fr[best][1]
    if not src and conf.get("capacity_passthru", True):
        rows = status_rows(backend)
        if rows is not None:
            best = pick_host(rows, oks, o["mem"])
            if best is None:
                return passthru, f"capacity: none of {','.join(oks)} admits {o['mem']} GB now (spill unsealed)"
            host, kids = best, oks[best]
    if not src and conf.get("capacity_passthru", True) and rows is None and not admits(backend, host, o["mem"]):
        # COORD 08:1x capacity: a sealed job cannot SPILL; when K's host cannot admit it now, run it unsealed so
        # ot-run can spill it to a host that admits (epyc4).  Logged as PASS capacity; it is not an ISOLATE gap.
        return passthru, f"capacity: {host} does not admit {o['mem']} GB now (spill unsealed)"
    fd, sp = tempfile.mkstemp(prefix="sealed-", suffix=".json", dir=conf.get("spec_dir") or None)
    with os.fdopen(fd, "w") as fh:
        if ac:
            bok = "BUNDLE_OK" in kids
            s = ap_spec(runner, K, rest[0], meta, [k for k in kids if k != "BUNDLE_OK"], bok)
            if src:
                s = fetched(s, src)
                s["copy_back"] = {"from": host, "to": src, "path": K}
            json.dump(s, fh)
        else:
            json.dump(spec_for(runner, K, kids, rest[0]), fh)
    out = [conf["sealed_backend"], "--mem", o["mem"], "--threads", o.get("threads", "16"), "--hosts", host, "--job", sp]
    out += [f for f in flags if f != "--no-spill"]
    if "priority" in o:
        out += ["--priority", o["priority"]]
    if "max-wait" in o:
        out += ["--max-wait", o["max-wait"]]
    return out + ["--"] + cmd, f"SEALED on {host}: {K}" + (f" (inputs fetched from {src})" if src else "")


ENOENT = re.compile(r"No such file or directory|FileNotFoundError|ENOENT|not found: /|missing\b")
APATH = re.compile(r"(/(?:srv|home|mnt|archive|tmp|var/tmp|media)/[^\s'\":,;()\[\]]+)")


def gaps_in(text, K, job_root="/srv/opentallas-scratch2/claude/ot-jobs/"):
    """-> [(path, tool line)] for missing-input errors on paths outside the sealed job (K, the job root)"""
    out, seen = [], set()
    for ln in text.splitlines():
        if not ENOENT.search(ln):
            continue
        for p in APATH.findall(ln):
            p = p.rstrip(".")
            if p == K or p.startswith(K + "/") or p.startswith(job_root) or p in seen:
                continue
            seen.add(p)
            out.append((p, ln.strip()[:200]))
    return out


def gap_row(conf, K, stage, path, tool):
    """one ISOLATE-GAPS.tsv row: time, die, type, stage, path, tool line"""
    die = K.split("/runs/", 1)[1].split("/", 1)[0] if "/runs/" in K else "?"
    typ = K.split("/items/", 1)[1].split("/", 1)[0] if "/items/" in K else os.path.basename(K)
    row = "\t".join([time.strftime("%Y-%m-%d %H:%M:%S %Z"), die, typ, stage, path, tool.replace("\t", " ")])
    try:
        with open(os.path.expanduser(conf.get("gaps", "~/.local/lib/fleet/isolate-1/ISOLATE-GAPS.tsv")), "a") as fh:
            fh.write(row + "\n")
    except OSError:
        pass


def run_sealed(argv, conf, orig):
    """run the sealed job, streaming its output; on a missing undeclared input outside the job, log the gap(s) and
    rerun ONCE unsealed (OWNER 11-09 08:2x fallback) -> exit code"""
    p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):    # the wave stops a client: stop the job client too
        signal.signal(sig, lambda n, f: (p.send_signal(n), sys.exit(128 + n)))
    buf = []
    for ln in p.stdout:
        sys.stdout.write(ln)
        sys.stdout.flush()
        buf.append(ln)
        if len(buf) > 20000:
            del buf[:5000]
    rc = p.wait()
    if rc == 0 or not conf.get("fallback_unsealed", True):
        return rc
    po = parse(orig)
    tg = sealed_target(po[2], conf) if po else None
    if not tg:
        return rc
    K, stage = tg
    gaps = gaps_in("".join(buf), K)
    if not gaps:
        return rc
    for path, tool in gaps:
        gap_row(conf, K, stage, path, tool)
    log(conf, f"GAP {len(gaps)} {K} {stage}: rerun unsealed once ({gaps[0][0]})")
    print(f"ot-run-sealed: ISOLATE-GAP {len(gaps)} path(s) outside the job (first {gaps[0][0]}); rerun UNSEALED once",
          file=sys.stderr, flush=True)
    backend = backend_of(conf)
    return subprocess.call([backend] + list(orig))


def main():
    conf = load_conf()
    argv, why = decide(sys.argv[1:], conf)
    if argv[0] != backend_of(conf):
        log(conf, f"{why} pid {os.getpid()}")
        print(f"ot-run-sealed: {why}", file=sys.stderr, flush=True)
        rc = run_sealed(argv, conf, sys.argv[1:])
        try:
            cb = json.load(open(argv[argv.index("--job") + 1])).get("copy_back") if "--job" in argv else None
        except (OSError, ValueError):
            cb = None
        if cb:
            crc = copy_back(cb["from"], cb["to"], cb["path"])
            log(conf, f"COPY-BACK {cb['path']} {cb['from']} -> {cb['to']} rc {crc}")
            print(f"ot-run-sealed: copy-back {cb['from']} -> {cb['to']} rc {crc}", file=sys.stderr, flush=True)
            if crc and not rc:
                rc = 97
        sys.exit(rc)
    elif why in ("not a pilot dir",) or why.startswith("kit/runner") or why.startswith("capacity"):
        p = parse(sys.argv[1:])
        k = (p[0].get("dir") or "?") if p else "?"
        if why.startswith(("kit/runner", "capacity")) or any(k.startswith(d) for d in conf.get("dirs", [])) or "/runs/qwen_kvsys/" in k:
            log(conf, f"PASS place {k}: {why}")             # a pilot-die place call that ran unsealed, and why
    os.execv(argv[0], argv)


if __name__ == "__main__":
    main()
