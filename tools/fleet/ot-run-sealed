def fetch_ok(host, bundle=None, K=None):
    """KW-FIX-44 (COORD 13:0x cross-host): a host that does NOT hold K but can run a sealed job that fetches its inputs:
    ot-job + bwrap there.  -> (ok, ['BUNDLE_OK'] when the sha-pinned bundle is already on it)"""
    # HUB-FETCH 11-10: a host that already holds a copy of K (the hub's sync_hub copy) reports K_PRESENT; the job then
    # returns into a private stage dir (decide), so that copy is never overwritten and never removed by the copy-back
    sh = (f"{{ test -e {shlex.quote(K)} && echo K_PRESENT; true; }} && " if K else "") + f"{{ {JOB_ROOT_SH}; }} | grep -q JOBROOT= && test -x $HOME/.local/bin/ot-job && bwrap --ro-bind / / --dev /dev true && echo SEALED_OK"
    if bundle:
        sh += f" && python3 -I -c {shlex.quote(BUNDLE_PY)} {shlex.quote(bundle[0])} {shlex.quote(bundle[1])}"
    try:
        p = subprocess.run(on(host, sh), capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return False, []
    w = p.stdout.split()
    return "SEALED_OK" in p.stdout and p.returncode == 0, ([x for x in ("BUNDLE_OK", "K_PRESENT") if x in w])


def fetched(spec, src):
    """the spec with every input / work seed fetched from `src` (the host that holds K), not read on the job host"""
    for i in spec["inputs"]:
        i.setdefault("host", src)
    for s in spec["work"]["seed"]:
        s.setdefault("host", src)
    return spec


def copy_back(host, src, K, stage=None):
    """after a fetched job: the returned K on `host` goes back to K on `src` (where the wave and autopilot read it),
    as ot-run's spill copy-back does; the marker is never copied.  stage (HUB-FETCH): the job returned into this
    private dir on `host` (basename = basename K) instead of K; it is sent and then removed, K there is untouched.
    -> rc"""
    par, base = os.path.dirname(K), os.path.basename(K)
    got = stage.rstrip("/") if stage else K
    if stage and os.path.basename(got) != base:
        return 99
    try:            # the job never ran there (NOT RUN): nothing came back, nothing to copy
        if subprocess.run(on(host, f"test -d {shlex.quote(got)}", timeout_flag=False), timeout=60).returncode:
            return 0
    except (OSError, subprocess.TimeoutExpired):
        return 98
    pull = on(host, f"tar -C {shlex.quote(os.path.dirname(got))} --exclude=.ot-run-spill-copy -cf - {shlex.quote(base)}",
              timeout_flag=False)
    push = on(src, f"tar -C {shlex.quote(par)} -xf -", n=False, timeout_flag=False)
    a = subprocess.Popen(pull, stdout=subprocess.PIPE)
    b = subprocess.run(push, stdin=a.stdout)
    a.stdout.close()
    rc = a.wait() or b.returncode
    if not rc:      # K was absent on `host` before the job (fetch_ok), so this copy is ours alone
        subprocess.run(on(host, f"rm -rf --one-file-system -- {shlex.quote(os.path.dirname(got) if stage else K.rstrip('/'))}",
                          timeout_flag=False), timeout=1800)
    return rc


