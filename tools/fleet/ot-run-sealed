def under(p, roots):
    return any(p == r.rstrip("/") or p.startswith(r.rstrip("/") + "/") for r in roots)


def declared_inputs(refs, runner, kids, conf, extra_roots=()):
    """-> (extra inputs [{"path"}], undeclared [(path, file, exists)]).  Declared: the runner, the KWCHILD records, the
    conf "declared_roots" (tool / admission bundles).  A declared, existing path the kit names becomes a read-only input."""
    roots = [runner] + [k for k in kids if k != "BUNDLE_OK"] + list(conf.get("declared_roots") or ()) + list(extra_roots)
    extra, bad = [], []
    for r in sorted(refs):
        f, e = refs[r]
        if e and under(r, roots):
            if not under(r, [runner] + kids) and not any(under(r, [x["path"]]) for x in extra):
                extra.append({"path": r})
        else:
            bad.append((r, f, e))
    return extra, bad


REFUSE = "ot-run-sealed-REFUSE"
WAVE_KEYS = ("src", "plan", "kit_rtl", "item_inputs", "prov_view_sources", "core_kit", "bind", "bind_out")


def wave_roots(K, wave_conf):
    """the inputs the kit wave DECLARES for K's die (kit_wave.json dies[die]: src tree, plan dir, bind / kit_rtl dirs,
    item inputs, provenance view sources, core kits) + K's own item dir (its other attempts, its prov views)"""
    roots = []
    if "/items/" in K:
        roots.append(K.split("/items/", 1)[0] + "/items/" + K.split("/items/", 1)[1].split("/", 1)[0])
    die = K.split("/runs/", 1)[1].split("/", 1)[0] if "/runs/" in K else None
    try:
        cfg = json.load(open(os.path.expanduser(wave_conf)))
    except (OSError, ValueError, TypeError):
        return roots
    d = (cfg.get("dies") or {}).get(die) or {}

    def walk(v):
        if isinstance(v, str):
            if v.startswith("/srv/") or v.startswith("/home/"):
                yield v.split(":", 1)[-1]
        elif isinstance(v, dict):
            for x in v.values():
                yield from walk(x)
        elif isinstance(v, list):
            for x in v:
                yield from walk(x)
    for k in WAVE_KEYS:
        for v in walk(d.get(k)):
            roots.append(os.path.dirname(v) if k == "plan" or v.endswith((".json", ".v", ".sv")) else v)
    return roots


