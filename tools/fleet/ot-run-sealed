    work = next((i["_work"] for i in inputs if isinstance(i, dict) and "_work" in i), None)
    inputs = [i for i in inputs if not (isinstance(i, dict) and "_work" in i)]
    return {"schema": "opentallas.ot_job.v1", "name": T + "-gen",
            "inputs": ([] if any((i.get("at") or i.get("path")) == src for i in inputs if isinstance(i, dict)) else [{"path": src}])
            + [i if isinstance(i, dict) else {"path": i} for i in inputs],
            "work": {"at": W, "seed": work["seed"] if work else [{"path": W}]},
