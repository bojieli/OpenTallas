out = {}
for r, f in refs.items():
    if r == K or r.startswith(K + "/"):
        continue
    e = os.path.exists(r)
    rr = os.path.realpath(r) if e else r
    if rr == K or rr.startswith(K + "/"):
        continue
    out[r] = [f, e]
print("SCAN " + json.dumps(out))
"""


