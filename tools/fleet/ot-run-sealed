HUB_LOCAL = {os.environ.get("OT_HUB_NAME", "intel2"), "localhost"}


def on(host, sh, n=True, timeout_flag=True):
    """argv that runs shell `sh` on host; the hub runs it itself (it cannot ssh to its own name)"""
    if host in HUB_LOCAL:
        return ["bash", "-c", sh]
    return (["ssh"] + (["-n"] if n else []) + ["-o", "ControlPath=none", "-o", "BatchMode=yes"]
            + (["-o", "ConnectTimeout=20"] if timeout_flag else []) + [host, sh])


def otrun_host(host):
    """the name ot-run knows a host by (the hub is localhost there)"""
    return "localhost" if host in HUB_LOCAL else host


FETCH_DISK_GB = 60      # ot-run refuses a scratch disk under its 50 GB floor (kv 98b92a196255 a3 13:4x on epyc2: 43 GB -> NOT RUN)
# KW-FIX-44 COORD 14:3x (OWNER 11-05 every disk is scratch): the job dir (ot-job spec "root", ot-run --dir) is the first of
# these roots with >= FETCH_DISK_GB free on that host; scratch2 first, scratch3 when scratch2 is under the floor
JOB_ROOTS = ("/srv/opentallas-scratch2/claude/ot-jobs", "/srv/opentallas-scratch3/claude/ot-jobs")
# KW-FIX-44 11-09 18:5x: a scratch3 that IS the root fs is skipped (ot-run refuses a root-fs --dir: "no host qualifies";
# the sealed gen pilot on epyc2, scratch2 54 GB, fell to scratch3 = root and was NOT RUN)
JOB_ROOT_SH = ("for r in " + " ".join(JOB_ROOTS) + "; do c=$(dirname $r); [ -d $c ] || continue; "
               "[ \"$(stat -c %d $c)\" = \"$(stat -c %d /)\" ] && continue; "
               "f=$(df --output=avail -BG $c | tail -1 | tr -dc 0-9); "
               f"if [ \"${{f:-0}}\" -ge {FETCH_DISK_GB} ]; then mkdir -p $r && echo JOBROOT=$r; break; fi; done")


def job_root(host):
    """-> the job root to use on `host` (JOB_ROOTS order, >= FETCH_DISK_GB free), or None"""
    try:
        p = subprocess.run(on(host, JOB_ROOT_SH), capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = [w[len("JOBROOT="):] for w in p.stdout.split() if w.startswith("JOBROOT=")]
    return m[0] if m else None


