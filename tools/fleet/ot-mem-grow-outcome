#!/usr/bin/env python3
"""ot-mem-grow-outcome (ADMIT-TUNE-1 11-14, COORD): `docker run --rm` hides how a container ended.  This watcher (a systemd service) follows `docker events`
for die / oom events and, for every container ot-mem-grow raised (raised.json), appends one line to /var/tmp/ot-mem-grow/log:
    <time> OUTCOME <name> <id> exit=<code> <finished|oom-killed|signal N|failed>
exit 0 = finished, 137 with an oom event = memory-cgroup kill (cap or host), 143 / 15 = SIGTERM (earlyoom, ot-heavy-stop), anything else = failed.
  ot-mem-grow-outcome [--since SECONDS_AGO]"""
import argparse, json, os, subprocess, sys, time

DIR = "/var/tmp/ot-mem-grow"


def classify(exit_code, oomed):
    if exit_code == 0:
        return "finished"
    if oomed or exit_code == 137:
        return "oom-killed" if oomed else "killed (137: SIGKILL)"
    if exit_code in (143, 15):
        return "signal 15 (SIGTERM: earlyoom or a stop)"
    return "failed"


def outcome_line(ev, raised, oomed, now=None):
    """ev: a docker event dict (Type container, Action die); raised: {12-char id: {name}} -> a log line, or None when the container was not raised"""
    cid = (ev.get("id") or ev.get("Actor", {}).get("ID") or "")[:12]
    if ev.get("Action") != "die" or cid not in raised:
        return None
    attrs = ev.get("Actor", {}).get("Attributes", {})
    try:
        code = int(attrs.get("exitCode", "-1"))
    except ValueError:
        code = -1
    return f"{time.strftime('%F %T', time.localtime(now or time.time()))} OUTCOME {raised[cid].get('name', attrs.get('name', '?'))} {cid} exit={code} {classify(code, oomed)}"


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--since", type=int, default=0)
    a = ap.parse_args(argv)
    cmd = ["docker", "events", "--filter", "type=container", "--filter", "event=die", "--filter", "event=oom", "--format", "{{json .}}"]
    if a.since:
        cmd += ["--since", str(int(time.time()) - a.since)]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    oom = set()
    for ln in p.stdout:
        try:
            ev = json.loads(ln)
        except ValueError:
            continue
        cid = (ev.get("id") or ev.get("Actor", {}).get("ID") or "")[:12]
        if ev.get("Action") == "oom":
            oom.add(cid)
            continue
        try:
            raised = json.load(open(DIR + "/raised.json"))
        except (OSError, ValueError):
            raised = {}
        line = outcome_line(ev, raised, cid in oom)
        oom.discard(cid)
        if line:
            open(DIR + "/log", "a").write(line + "\n")
            print(line, flush=True)
    return 1


if __name__ == "__main__":
    sys.exit(main())
