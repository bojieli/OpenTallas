#!/usr/bin/env python3
"""ot-heavy-stop (ADMIT-TUNE-1 11-14, COORD): stop an admitted ot-heavy job AND its docker containers.  Killing the ot-run client (on intel2)
after admission leaves the remote scope and its dockerd-owned container running (ot-run's own cancel only cancels WAITERS: "started commands keep
running"); run this on the build host, or `ssh HOST ot-heavy-stop ...`:
  ot-heavy-stop [--dry-run] --unit oth-ubuntu-123-456 | --match SUBSTR
--match SUBSTR selects the active oth-* scopes in which any process has SUBSTR in its command line or working directory (a kit dir, an item name).
A container belongs to a scope when the pid in its name (dpkit-<item>-<pid>[-lec], kqc-..., otc-<pid>-<n>) is a process of that scope.
Containers are stopped first (docker stop -t 20), then the scope; nothing else is touched."""
import argparse, os, re, subprocess, sys


def sh(*a, timeout=120):
    return subprocess.run(list(a), capture_output=True, text=True, timeout=timeout).stdout


def owner_pid(name):
    """the pid a container name carries: otc-<pid>-<random> (ot-heavy docker shim), else the trailing -<pid> or -<pid>-lec of dpkit-/kqc-/klegacy- names"""
    m = re.match(r"otc-(\d+)-\d+$", name) or re.search(r"-(\d+)(?:-lec)?$", name)
    return int(m[1]) if m else None


def select_containers(names, pids):
    """container names whose owner pid is one of the scope's pids"""
    pids = set(pids)
    return [n for n in names if owner_pid(n) in pids]


LABEL_FMT = '{{.Names}}|{{.Label "ot.unit"}}|{{.Label "ot.tag"}}'


def labelled(rows, unit=None, tag=None):
    """CANCEL-LABEL-1120: container names whose ot.unit label is EXACTLY unit, or whose ot.tag label starts with tag (the client's otrun-<host>-<pid>- prefix).  rows = 'name|unit|tag' lines.
    An empty selector selects nothing (never every container)."""
    out = []
    for r in rows:
        n, u, t = (r.split("|") + ["", ""])[:3]
        if n and ((unit and u == unit) or (tag and t and t.startswith(tag))):
            out.append(n)
    return out


def running(names):
    live = set(sh("docker", "ps", "--format", "{{.Names}}").split())
    return [n for n in names if n in live]


def stop_labelled(unit=None, tag=None, dry=False):
    """stop the labelled containers, re-check, docker kill what is still up, re-check.  -> (found, still_running)"""
    if not (unit or tag):
        return [], []
    found = labelled(sh("docker", "ps", "--format", LABEL_FMT).splitlines(), unit, tag)
    if dry or not found:
        return found, []
    for c in found:
        subprocess.run(["docker", "stop", "-t", "20", c], capture_output=True)
    left = running(found)
    for c in left:
        subprocess.run(["docker", "kill", c], capture_output=True)
    return found, running(found)


def env_tag(pid):
    """OT_HEAVY_TAG of a process (the ot-run tag every container of its job is labelled with), '' when unreadable"""
    try:
        for kv in open(f"/proc/{pid}/environ", "rb").read().split(b"\0"):
            if kv.startswith(b"OT_HEAVY_TAG="):
                return kv.split(b"=", 1)[1].decode(errors="replace")
    except OSError:
        pass
    return ""


def unit_tags(unit, pids, rows, envtag=env_tag):
    """TAG-CANCEL-1124 (KV-PV-CAP: `ot-run --cancel oth-ubuntu-3730999-...` on E11 stopped the batch script, and 2 yosys containers of its xargs -P fan-out ran on
    until ot-heavy-stop --tag): the ot-run tags of a unit = the ot.tag labels of the containers labelled with the unit, plus OT_HEAVY_TAG of the scope's processes.
    Containers of nested ot-heavy calls carry a child unit but the parent's tag, so the tag finds them."""
    tags = set()
    for r in rows:
        n, u, t = (r.split("|") + ["", ""])[:3]
        if n and u == unit and t:
            tags.add(t)
    for p in pids:
        t = envtag(p)
        if t:
            tags.add(t)
    return sorted(tags)


def scope_pids(unit):
    out = []
    for base in ("/sys/fs/cgroup/user.slice",):
        for root, dirs, files in os.walk(base):
            if os.path.basename(root) == unit + ".scope":
                try:
                    out += [int(x) for x in open(os.path.join(root, "cgroup.procs")).read().split()]
                except OSError:
                    pass
                dirs[:] = []
    return out


def own_pids():
    """this process and its ancestors: their cmdlines carry the --match text itself, and run from inside an oth-* scope (a gate, a lane shell) the tool would otherwise
    match, and stop, the scope it runs in (test_dry_run_on_a_live_scope failed only inside a gate scope)"""
    out, pid = set(), os.getpid()
    while pid and pid not in out:
        out.add(pid)
        try:
            pid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return out


def proc_text(pid):
    try:
        return open(f"/proc/{pid}/cmdline").read().replace("\0", " ") + " " + os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def units():
    return [l.split()[0][:-6] for l in sh("systemctl", "--user", "list-units", "--type=scope", "--state=active", "--no-legend", "--plain", "oth-*").splitlines() if l.split()]


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--unit")
    ap.add_argument("--match")
    ap.add_argument("--tag", help="ot-run tag prefix otrun-<host>-<pid>-: stop every container labelled with it (no scope needed)")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    if not (a.unit or a.match or a.tag):
        ap.error("--unit, --match or --tag required")
    if not os.environ.get("XDG_RUNTIME_DIR"):
        os.environ["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
    names = sh("docker", "ps", "--format", "{{.Names}}").split()
    rows0 = sh("docker", "ps", "--format", LABEL_FMT).splitlines()      # TAG-CANCEL-1124: label snapshot before anything is stopped
    hit = 0
    own = own_pids()
    if a.unit or a.tag:       # CANCEL-LABEL-1120: containers found by their label, whatever started them
        found, left = stop_labelled(a.unit, a.tag, a.dry_run)
        print(f"ot-heavy-stop: labelled containers {'found' if a.dry_run else 'stopped'}: {' '.join(found) or 'none'}")
        if left:
            print(f"ot-heavy-stop: STILL RUNNING after docker stop and kill: {' '.join(left)}")
            return 3
        hit += len(found)
        if a.tag and not a.unit:
            return 0 if hit else 1
    for u in ([a.unit] if a.unit else units()):
        pids = scope_pids(u)
        if not pids:
            continue
        if a.match and not any(a.match in proc_text(p) for p in pids if p not in own):
            continue
        hit += 1
        cs = select_containers(names, pids)
        if cs and (a.unit or a.tag) and not a.dry_run:
            cs = running(cs)                 # the labelled pass above may have stopped them already
        tags = unit_tags(u, pids, rows0)
        print(f"ot-heavy-stop: {u}: {len(pids)} processes, containers {cs or '-'}, tags {' '.join(tags) or '-'}" + (" (dry run)" if a.dry_run else ""))
        if a.dry_run:
            continue
        for c in cs:
            subprocess.run(["docker", "stop", "-t", "20", c], capture_output=True)
        subprocess.run(["systemctl", "--user", "stop", u + ".scope"], capture_output=True)
        # TAG-CANCEL-1124: after the scope is gone (no process left to start another), every container still labelled with the unit or one of its tags
        for t in tags:
            found, left = stop_labelled(None, t)
            if found:
                print(f"ot-heavy-stop: {u}: containers of tag {t} stopped: {' '.join(found)}")
            if left:
                print(f"ot-heavy-stop: STILL RUNNING after docker stop and kill: {' '.join(left)}")
                return 3
    print(f"ot-heavy-stop: {hit} scope(s) {'matched' if a.dry_run else 'stopped'}")
    return 0 if hit else 1


if __name__ == "__main__":
    sys.exit(main())
