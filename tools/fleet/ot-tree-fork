FICLONE = 0x40049409
FORK_JSON = ".fork.json"
MANIFEST = ".src-manifest.json"
HASHFILE = ".src-manifest.sha256"
LOG = os.path.expanduser("~/.local/state/ot-tree-fork/forks.jsonl")
COPY_LOCK_DIR = os.environ.get("OT_TREE_COPY_LOCK_DIR", "/var/tmp/ot-tree-copy")
TREE_INDEX = os.path.expanduser(os.environ.get("OT_TREE_INDEX", "~/.local/state/ot-tree-copy/trees.jsonl"))
# FLOW-FLEET-R2 11-22 (FABLE-FLOW-0800): the HROOT fork fetched epyc8 -> epyc7 at about 1.6 GB/h: ONE tar stream over a default-cipher ssh.  Now (1) a host that already holds a
# same-manifest tree is asked first (HOLDER_HOSTS, their trees.jsonl index), and (2) the fetch runs STREAMS parallel tar streams over a fast cipher, files balanced by size.
SSH = os.environ.get("OT_TREE_FORK_SSH", "ssh -o BatchMode=yes -o ControlPath=none -o Compression=no -c aes128-gcm@openssh.com").split()
STREAMS = int(os.environ.get("OT_TREE_FORK_STREAMS", "4"))
HOLDER_HOSTS = [h for h in os.environ.get("OT_TREE_FORK_HOLDERS", "intel1,intel2,epyc2,epyc7,epyc8,epyc9,epyc10").split(",") if h]
VERSION = 1


class Refused(Exception):
    code = 3


class NoRoom(Exception):
    code = 5


def inside(p, root):
    """p == root or p below root (both realpaths)"""
    root = root.rstrip("/") or "/"
    return p == root or p.startswith(root + "/")


def extra_roots():
    return [os.path.realpath(r) for r in os.environ.get("OT_EVENT_TREE_ROOTS", "").split(":") if r]


def event_root(path):
    """the event tree that realpath(path) lies in, '' when none.  Event tree = a dir directly under a kw45/ dir, a src_manifest tree
    that is read-only (published / sealed), or a dir listed in $OT_EVENT_TREE_ROOTS.  A fork (has .fork.json, writable) is not one."""
    rp = os.path.realpath(path)
    for r in extra_roots():
        if inside(rp, r):
            return r
    parts = rp.split("/")
    for i in range(len(parts) - 1):
        if parts[i] == "kw45" and i + 1 < len(parts) and parts[i + 1]:
            return "/".join(parts[:i + 2])
    d = rp if os.path.isdir(rp) else os.path.dirname(rp)
    while d and d != "/":
        if os.path.isfile(os.path.join(d, MANIFEST)):
            try:
                ro = not (os.lstat(d).st_mode & 0o222)
            except OSError:
                ro = False
            if ro and not os.path.isfile(os.path.join(d, FORK_JSON)):
                return d
        d = os.path.dirname(d)
    return ""


def link_target(p):
    """(text, resolved realpath) of symlink p"""
    t = os.readlink(p)
    return t, os.path.realpath(os.path.join(os.path.dirname(p), t))


def src_identity(src):
    out = {"src_manifest_hash": "", "src_main_sha": "", "src_sealed": False}
    try:
        out["src_manifest_hash"] = open(os.path.join(src, HASHFILE)).read().strip()
    except OSError:
        pass
    try:
        m = json.load(open(os.path.join(src, MANIFEST)))
        out["src_main_sha"] = m.get("main_sha") or ""
        out["src_manifest_hash"] = out["src_manifest_hash"] or m.get("manifest_hash") or ""
    except (OSError, ValueError):
        pass
    try:
        out["src_sealed"] = bool(out["src_manifest_hash"]) and not (os.lstat(src).st_mode & 0o222)
    except OSError:
        pass
    try:
        fk = json.load(open(os.path.join(src, FORK_JSON)))
        out["src_fork_of"] = fk.get("src_real", "")
    except (OSError, ValueError):
        pass
    return out


class Busy(Exception):
    code = 6


class CopySlot:
    """hold one of n flock slots (slot-<i>.lock in the lock dir) for a tree copy on this host; the shell side (src_manifest.slot_sh) takes the same files"""
    def __init__(self, n=None, lock_dir=None, wait_s=None, poll_s=15, out=print, what="copy"):
        self.n = n or max(1, int(os.environ.get("OT_TREE_COPY_SLOTS", "2") or 2))
        self.dir = lock_dir or COPY_LOCK_DIR
        self.wait_s = float(os.environ.get("OT_TREE_COPY_WAIT_S", "21600")) if wait_s is None else wait_s
        self.poll_s, self.out, self.what, self.fd, self.slot = poll_s, out, what, None, None

    def __enter__(self):
        os.makedirs(self.dir, exist_ok=True)
        try:
            os.chmod(self.dir, 0o1777)
        except OSError:
            pass
        t0, said = time.time(), False
        while True:
            for i in range(self.n):
                fd = os.open(os.path.join(self.dir, f"slot-{i}.lock"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o666)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    self.fd, self.slot = fd, i
                    return self
                except OSError:
                    os.close(fd)
            if time.time() - t0 > self.wait_s:
                raise Busy(f"no free tree-copy slot ({self.n} busy in {self.dir}) after {self.wait_s:.0f} s")
            if not said:
                self.out(f"TREE-FORK WAIT all {self.n} tree-copy slots of {socket.gethostname()} busy ({self.dir}); {self.what} waits")
                said = True
            time.sleep(self.poll_s)

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        return False


def hash_lock(h, lock_dir=None):
    """blocking per-manifest lock: two forks of the same remote tree fetch it once.  -> fd (close to release)"""
    d = lock_dir or COPY_LOCK_DIR
    os.makedirs(d, exist_ok=True)
    fd = os.open(os.path.join(d, f"hash-{h[:32]}.lock"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o666)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def manifest_core_hash(m):
    import hashlib
    core = {k: m[k] for k in ("main_sha", "scope", "overlay", "files")}
    return hashlib.sha256(json.dumps(core, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def file_hash(p):
    import hashlib
    if os.path.islink(p):
        return "link:" + hashlib.sha256(os.readlink(p).encode()).hexdigest()
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def same_manifest(path, h, full=False):
    """-> '' when PATH is a manifest tree with hash h (self-consistent) whose listed files all exist (full: with their sha256) and, unless full
    is used on a fresh fetch, read-only; else why not"""
    try:
        m = json.load(open(os.path.join(path, MANIFEST)))
    except (OSError, ValueError):
        return "no manifest"
    try:
        if m.get("manifest_hash") != h or manifest_core_hash(m) != h:
            return "other manifest hash"
    except KeyError:
        return "manifest incomplete"
    if not full and os.lstat(path).st_mode & 0o222:
        return "tree dir writable"
    for rel, want in (m.get("files") or {}).items():
        q = os.path.join(path, rel)
        try:
            st = os.lstat(q)
        except OSError:
            return f"missing {rel}"
        if full:
            if file_hash(q) != want:
                return f"modified {rel}"
        elif not stat.S_ISLNK(st.st_mode) and st.st_mode & 0o222:
            return f"writable {rel}"
    return ""


def index_add(path, h, index=None):
    index = index or TREE_INDEX
    try:
        os.makedirs(os.path.dirname(index), exist_ok=True)
        with open(index, "a") as f:
            f.write(json.dumps({"path": os.path.realpath(path), "hash": h, "t": int(time.time())}) + "\n")
    except OSError:
        pass


def same_tree(h, index=None):
    """a verified read-only tree with manifest hash h on this host (tree index, newest first), '' when none"""
    try:
        lines = open(index or TREE_INDEX).read().splitlines()
    except OSError:
        return ""
    seen = set()
    for ln in reversed(lines[-20000:]):
        try:
            e = json.loads(ln)
        except ValueError:
            continue
        pth = e.get("path") or ""
        if e.get("hash") != h or pth in seen or pth.endswith(".part"):
            continue
        seen.add(pth)
        if os.path.isdir(pth) and not same_manifest(pth, h):
            return pth
    return ""


def cache_root(dst):
    """<scratch>/claude/tree-cache on DST's disk (same filesystem: a reflink fork from it is free); $OT_TREE_CACHE_ROOT overrides"""
    if os.environ.get("OT_TREE_CACHE_ROOT"):
        return os.environ["OT_TREE_CACHE_ROOT"]
    rp = os.path.realpath(os.path.dirname(os.path.abspath(dst)))
    parts = rp.split("/")
    if "claude" in parts:
        return "/".join(parts[:parts.index("claude") + 1]) + "/tree-cache"
    return os.path.join(os.path.dirname(rp), "tree-cache")


def ssh_out(host, cmd, timeout=600):
    p = subprocess.run(["timeout", str(timeout)] + SSH + [host, cmd], capture_output=True, text=True)
    return p.returncode, p.stdout


def parse_holder_index(text, h):
    """trees.jsonl text of a host -> paths of trees with manifest hash h, newest first"""
    out = []
    for ln in reversed(text.splitlines()[-20000:]):
        try:
            e = json.loads(ln)
        except ValueError:
            continue
        if e.get("hash") == h and e.get("path") and e["path"] not in out and not e["path"].endswith(".part"):
            out.append(e["path"])
    return out


def find_holder(h, skip=(), hosts=None, ask=None):
    """-> (host, path) of another fleet host that holds a verified tree of manifest hash h (its tree index names it and the tree's own hash file agrees), else None"""
    ask = ask or ssh_out
    here = socket.gethostname().split(".")[0]
    for host in (HOLDER_HOSTS if hosts is None else hosts):
        if host == here or host in skip:
            continue
        rc, txt = ask(host, "tail -n 20000 ~/.local/state/ot-tree-copy/trees.jsonl 2>/dev/null", timeout=60)
        if rc != 0:
            continue
        for pth in parse_holder_index(txt, h)[:3]:
            rc, got = ask(host, f"cat {shlex.quote(pth + '/' + HASHFILE)} 2>/dev/null", timeout=60)
            if rc == 0 and got.strip() == h:
                return host, pth
    return None


def partition(entries, k):
    """entries [(size, relpath)] -> k lists of relpaths with about equal bytes (largest first onto the lightest list)"""
    bins = [[0, []] for _ in range(max(1, k))]
    for size, rel in sorted(entries, key=lambda e: -e[0]):
        b = min(bins, key=lambda x: x[0])
        b[0] += size; b[1].append(rel)
    return [b[1] for b in bins if b[1]]


def list_remote(src_host, src):
    """-> ([dirs], [(size, relpath)] of every non-directory entry), without FORK_JSON"""
    rc, txt = ssh_out(src_host, f"cd {shlex.quote(src)} && find . -mindepth 1 -printf '%y %s %P\\n'", timeout=1800)
    if rc != 0:
        raise SystemExit(f"TREE-FORK FETCH FAILED {src_host}:{src}: listing rc {rc}")
    dirs, files = [], []
    for ln in txt.splitlines():
        t, sz, rel = ln.split(" ", 2)
        if rel == FORK_JSON:
            continue
        (dirs if t == "d" else files).append(rel if t == "d" else (int(sz), rel))
    return dirs, files


def fetch_parallel(src_host, src, into, streams, out=print):
    """directories first (one small stream), then STREAMS tar streams of size-balanced file lists; any failing stream fails the fetch"""
    dirs, files = list_remote(src_host, src)
    q = shlex.quote
    base = " ".join(q(x) for x in ["timeout", "86400"] + SSH + [src_host])
    procs = []
    if dirs:
        p = subprocess.Popen(["bash", "-c", f"set -o pipefail; {base} {q(f'tar -C {q(src)} --no-recursion -cf - -T -')} | tar -C {q(into)} -xpf -"], stdin=subprocess.PIPE, text=True)
        p.communicate("\n".join(dirs) + "\n")
        if p.returncode:
            raise SystemExit(f"TREE-FORK FETCH FAILED {src_host}:{src} -> {into}: directories rc {p.returncode} (partial copy kept: delete it with ot-delete {into})")
    for i, lst in enumerate(partition(files, streams)):
        p = subprocess.Popen(["bash", "-c", f"set -o pipefail; {base} {q(f'tar -C {q(src)} --no-recursion -cf - -T -')} | tar -C {q(into)} -xpf -"], stdin=subprocess.PIPE, text=True)
        p.stdin.write("\n".join(lst) + "\n"); p.stdin.close()
        procs.append(p)
    out(f"TREE-FORK FETCH {src_host}:{src}: {len(files)} files, {len(dirs)} dirs in {len(procs)} parallel stream(s)")
    bad = [p.wait() for p in procs]
    if any(bad):
        raise SystemExit(f"TREE-FORK FETCH FAILED {src_host}:{src} -> {into} rc {max(bad)} (partial copy kept: delete it with ot-delete {into})")


def fetch(src_host, src, into, out=print):
    """tar SRC from src_host into the fresh dir INTO under a copy slot of this host.  -> bytes fetched (du of INTO)"""
    os.makedirs(into)
    if STREAMS > 1:
        with CopySlot(out=out, what=f"fetch {src_host}:{src}"):
            fetch_parallel(src_host, src, into, STREAMS, out)
        return sum(os.lstat(os.path.join(dp, f)).st_size for dp, _dn, fn in os.walk(into) for f in fn)
    with CopySlot(out=out, what=f"fetch {src_host}:{src}"):
        remote = f"tar -C {shlex.quote(src)} --exclude=./{FORK_JSON} -cf - ."
        cmd = " ".join(shlex.quote(x) for x in ["timeout", "86400"] + SSH + [src_host, remote]) + f" | tar -C {shlex.quote(into)} -xpf -"
        p = subprocess.run(["bash", "-c", "set -o pipefail; " + cmd])
    if p.returncode:
        raise SystemExit(f"TREE-FORK FETCH FAILED {src_host}:{src} -> {into} rc {p.returncode} (partial copy kept: delete it with ot-delete {into})")
    return sum(os.lstat(os.path.join(dp, f)).st_size for dp, _dn, fn in os.walk(into) for f in fn)


def make_ro_tree(root):
    for dp, dn, fn in os.walk(root, topdown=False):
        for f in fn:
            q = os.path.join(dp, f)
            if not os.path.islink(q):
                os.chmod(q, os.lstat(q).st_mode & ~0o222)
        os.chmod(dp, os.lstat(dp).st_mode & ~0o222)


def fork_remote(src_host, src, dst, jobs=0, materialize=False, dry=False, out=print, no_manifest=False):
    """SRC on src_host -> DST here: reuse a same-manifest tree of this host, else fetch once into the tree cache, then a local fork"""
    why = check_dst("/nonexistent-src-of-a-remote-fork", dst)
    if why:
        raise Refused(why)
    rc, h = ssh_out(src_host, f"cat {shlex.quote(src.rstrip('/') + '/' + HASHFILE)} 2>/dev/null", timeout=120)
    h = h.strip() if rc == 0 else ""
    if no_manifest and h:
        # FABLE-FIX-KV-PV-SINKSPREAD 11-22: a private fork EDITED after its manifest (tools re-pinned, a candidate plan installed)
        # still carries the parent manifest hash; the manifest route fetched 372,605 files and then refused them
        # ("FETCH CHECK FAILED: modified physical/common_flow/clk_leaf_repeat.tcl"), so such a tree could not move hosts.
        # --no-manifest: the plain fetch below (no cache, no reuse); the copy is checked nlink-1 / no event links as always.
        out(f"TREE-FORK NO-MANIFEST {src_host}:{src}: manifest {h[:12]} ignored (edited private fork), plain fetch")
        h = ""
    if h and len(h) == 64:
        fd = hash_lock(h) if not dry else None
        try:
            local = same_tree(h)
            how = "reused"
            if not local:
                local = os.path.join(cache_root(dst), h[:16])
                if dry:
                    out(f"TREE-FORK DRY {src_host}:{src} manifest {h[:12]}: no same-manifest tree here; would fetch into {local} then fork to {dst}")
                    return None
                if os.path.isdir(local) and not same_manifest(local, h):
                    how = "cache"
                else:
                    tmp = f"{local}.fetch-{os.getpid()}"
                    os.makedirs(os.path.dirname(local), exist_ok=True)
                    hold = find_holder(h, skip=(src_host,))             # a host that already holds this manifest tree: fetch from it first
                    fsrc = (hold[0], hold[1]) if hold else (src_host, src)
                    if hold:
                        out(f"TREE-FORK HOLDER {hold[0]}:{hold[1]} holds manifest {h[:12]}; fetching from it instead of {src_host}")
                    try:
                        n = fetch(fsrc[0], fsrc[1], tmp, out)
                    except SystemExit:
                        if not hold:
                            raise
                        out(f"TREE-FORK HOLDER fetch failed; falling back to {src_host}:{src}")
                        n = fetch(src_host, src, tmp + ".b", out); tmp = tmp + ".b"
                    bad = same_manifest(tmp, h, full=True)
                    if bad:
                        raise SystemExit(f"TREE-FORK FETCH CHECK FAILED {tmp}: {bad} (not the manifest {h[:12]} of {src_host}:{src}; delete it with ot-delete {tmp})")
                    make_ro_tree(tmp)
                    os.rename(tmp, local)
                    how = f"fetched {n / 2**30:.2f} GB"
                index_add(local, h)
            elif dry:
                out(f"TREE-FORK DRY {src_host}:{src} manifest {h[:12]}: same-manifest tree {local} here; would fork it to {dst}")
                return None
            out(f"TREE-FORK SOURCE {src_host}:{src} manifest {h[:12]} -> local {local} ({how})")
        finally:
            if fd is not None:
                os.close(fd)
        rec = fork(local, dst, jobs, materialize, dry, out, remote_src=f"{src_host}:{src}", reuse=how)
        return rec
    # no manifest: one fetch straight into the fork's staging dir
    if dry:
        out(f"TREE-FORK DRY {src_host}:{src} (no manifest): would fetch into {dst}.forking-<pid>")
        return None
    dst = os.path.join(os.path.realpath(os.path.dirname(os.path.abspath(dst))), os.path.basename(dst.rstrip("/")))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.forking-{os.getpid()}"
    t0 = time.time()
    n = fetch(src_host, src, tmp, out)
    src_real = src.rstrip("/")
    for dp, dn, fn in os.walk(tmp):               # absolute links into SRC -> the same place inside DST (relative)
        for name in dn + fn:
            q = os.path.join(dp, name)
            if os.path.islink(q):
                t = os.readlink(q)
                if os.path.isabs(t) and inside(t, src_real):
                    os.unlink(q)
                    os.symlink(os.path.relpath(os.path.join(tmp, os.path.relpath(t, src_real)), dp), q)
    errs = verify(tmp)
    if errs:
        raise SystemExit(f"TREE-FORK CHECK FAILED {tmp}: " + "; ".join(errs[:10]) + f" (partial copy kept: delete it with ot-delete {tmp})")
    rec = {"version": VERSION, "src": f"{src_host}:{src}", "src_real": src_real, "src_host": src_host, "dst": dst, "lane": os.environ.get("OT_LANE", ""),
           "time_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "time_epoch": int(time.time()), "method": "fetch", "bytes": n,
           "check": {"shared_inodes": 0, "event_links": 0}, "seconds": round(time.time() - t0, 1), "src_manifest_hash": "", "reuse": "fetched (no manifest)"}
    with open(os.path.join(tmp, FORK_JSON), "w") as f:
        json.dump(rec, f, indent=1, sort_keys=True)
        f.write("\n")
    os.rename(tmp, dst)
    out(f"TREE-FORK OK {src_host}:{src} -> {dst}: fetched {n / 2**30:.2f} GB in {rec['seconds']} s (no manifest), nlink-1 checked")
    return rec


def plan_rel(rel):
    """True for physical, physical/die_plan and anything below it: the plan side a bind / R8 refresh writes into"""
    rel = rel.strip("/")
    return rel in ("physical", "physical/die_plan") or rel.startswith("physical/die_plan/")


def plan(src, dst, materialize=False):
    """walk SRC (realpath) -> dict(dirs=[(rel, mode)], files=[(abs_src, rel, mode, size)], links=[(rel, text)], external=[...],
    refused=[...], specials=[...], bytes).  rel paths are relative to the fork root.  Pure read; nothing written."""
    src = os.path.realpath(src)
    P = {"dirs": [], "files": [], "links": [], "external": [], "refused": [], "specials": [], "bytes": 0, "materialized": []}

    def walk(root, base_rel, seen):
        for dp, dn, fn in os.walk(root):
            rel_dp = os.path.normpath(os.path.join(base_rel, os.path.relpath(dp, root)))
            rel_dp = "" if rel_dp == "." else rel_dp
            P["dirs"].append((rel_dp, os.lstat(dp).st_mode))
            for name in sorted(dn + fn):
                p = os.path.join(dp, name)
                rel = os.path.join(rel_dp, name) if rel_dp else name
                st = os.lstat(p)
                if stat.S_ISLNK(st.st_mode):
                    text, res = link_target(p)
                    if inside(res, src):
                        if os.path.isabs(text):          # absolute link into SRC: the same place inside DST
                            text = os.path.relpath(os.path.join(dst, os.path.relpath(res, src)), os.path.dirname(os.path.join(dst, rel)))
                        P["links"].append((rel, text))
                        continue
                    ev = event_root(res) or (f"{res} (a symlinked plan dir {rel} outside SRC)" if plan_rel(rel) else "")
                    if ev:
                        if materialize and os.path.exists(res) and res not in seen:
                            P["materialized"].append((rel, res))
                            if os.path.isdir(res):
                                walk(res, rel, seen | {res})
                            else:
                                s2 = os.stat(res)
                                P["files"].append((res, rel, s2.st_mode, s2.st_size))
                                P["bytes"] += s2.st_size
                        else:
                            P["refused"].append(f"{rel} -> {text} (resolves into event tree {ev})")
                        continue
                    P["links"].append((rel, text))
                    P["external"].append(f"{rel} -> {text}")
                    continue
                if stat.S_ISDIR(st.st_mode):
                    continue                              # os.walk descends (it never follows dir symlinks: those are handled above)
                if stat.S_ISREG(st.st_mode):
                    P["files"].append((p, rel, st.st_mode, st.st_size))
                    P["bytes"] += st.st_size
                else:
                    P["specials"].append(rel)
            dn[:] = [d for d in dn if not os.path.islink(os.path.join(dp, d))]

    walk(src, "", {src})
    return P


def check_dst(src, dst):
    """refusal text or '' for DST"""
    src = os.path.realpath(src)
    if os.path.lexists(dst):
        return f"DST {dst} exists (a fork never writes into an existing dir)"
    parent = os.path.realpath(os.path.dirname(os.path.abspath(dst)) or ".")
    anc = parent
    while not os.path.exists(anc) and anc != "/":
        anc = os.path.dirname(anc)
    if not os.path.isdir(anc):
        return f"DST parent {parent} is not a directory"
    full = os.path.join(parent, os.path.basename(dst.rstrip("/")))
    if inside(full, src):
        return f"DST {dst} resolves to {full}, inside SRC {src}"
    ev = event_root(full) or event_root(parent) or event_root(anc)
    if ev:
        return f"DST {dst} resolves into event tree {ev} ({full}); forks go in your lane dir"
    return ""


def clone_or_copy(s, d, mode, use_reflink):
    """-> 'reflink' | 'copy'.  A new inode either way."""
    if use_reflink:
        try:
            with open(s, "rb") as fi, open(d, "wb") as fo:
                fcntl.ioctl(fo.fileno(), FICLONE, fi.fileno())
            os.chmod(d, (mode & 0o7777) | stat.S_IWUSR)
            st = os.stat(s)
            os.utime(d, ns=(st.st_atime_ns, st.st_mtime_ns))
            return "reflink"
        except OSError as e:
            if e.errno not in (errno.EOPNOTSUPP, errno.EXDEV, errno.EINVAL, errno.ENOTTY, errno.EBADF):
                raise
    shutil.copyfile(s, d, follow_symlinks=True)
    os.chmod(d, (mode & 0o7777) | stat.S_IWUSR)
    st = os.stat(s)
    os.utime(d, ns=(st.st_atime_ns, st.st_mtime_ns))
    return "copy"


def reflink_ok(src_file, dst_dir):
    probe = os.path.join(dst_dir, f".reflink-probe.{os.getpid()}")
    try:
        with open(src_file, "rb") as fi, open(probe, "wb") as fo:
            fcntl.ioctl(fo.fileno(), FICLONE, fi.fileno())
        return True
    except OSError:
        return False
    finally:
        try:
            os.unlink(probe)
        except OSError:
            pass


def verify(dst, src=""):
    """-> list of problems: regular files with nlink > 1, symlinks into an event tree, symlinks back into SRC (realpath)."""
    src = os.path.realpath(src) if src else ""
    if not os.path.isdir(dst):
        return [f"MISSING {dst} (not a directory)"]
    errs = []
    for dp, dn, fn in os.walk(dst):
        for name in dn + fn:
            p = os.path.join(dp, name)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            rel = os.path.relpath(p, dst)
            if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
                errs.append(f"SHARED-INODE {rel} (nlink {st.st_nlink})")
            elif stat.S_ISLNK(st.st_mode):
                text, res = link_target(p)
                ev = event_root(res)
                if ev and not inside(os.path.realpath(dst), ev):
                    errs.append(f"EVENT-LINK {rel} -> {text} (into event tree {ev})")
                elif plan_rel(rel) and not inside(res, os.path.realpath(dst)):
                    errs.append(f"PLAN-LINK {rel} -> {text} (a plan dir outside the tree: writes to it land in {res})")
                elif src and inside(res, src) and not inside(res, os.path.realpath(dst)):
                    errs.append(f"SRC-LINK {rel} -> {text} (back into SRC {src})")
    return errs


def free_gb(path):
    s = os.statvfs(path)
    return s.f_bavail * s.f_frsize / 2**30


def fork(src, dst, jobs=0, materialize=False, dry=False, out=print, remote_src="", reuse=""):
    t0 = time.time()
    src_given = src
    if not os.path.isdir(src):
        raise Refused(f"SRC {src} is not a directory")
    src = os.path.realpath(src)
    why = check_dst(src, dst)
    if why:
        raise Refused(why)
    dst = os.path.join(os.path.realpath(os.path.dirname(os.path.abspath(dst))), os.path.basename(dst.rstrip("/")))
    if not dry:
        os.makedirs(os.path.dirname(dst), exist_ok=True)      # e.g. <lane>/trees/ on first use
    P = plan(src, dst, materialize)
    if P["refused"]:
        raise Refused(f"{len(P['refused'])} symlink(s) in SRC resolve into an event tree or are plan dirs outside SRC (a write through them lands there): "
                      + "; ".join(P["refused"][:5]) + ("; ..." if len(P["refused"]) > 5 else "")
                      + ".  Fork that tree on its own, or pass --materialize to copy the targets in.")
    n, gb = len(P["files"]), P["bytes"] / 2**30
    if dry:
        out(f"TREE-FORK DRY {src} -> {dst}: {n} files {gb:.2f} GB, {len(P['dirs'])} dirs, {len(P['links'])} links "
            f"({len(P['external'])} external kept), {len(P['materialized'])} materialized, {len(P['specials'])} specials skipped")
        return None
    tmp = f"{dst}.forking-{os.getpid()}"
    os.mkdir(tmp, 0o755)
    use_reflink = bool(P["files"]) and reflink_ok(P["files"][0][0], tmp)
    floor = float(os.environ.get("OT_TREE_FORK_FLOOR_GB", "50"))
    have = free_gb(tmp)
    if not use_reflink and have < gb + floor:
        os.rmdir(tmp)
        raise NoRoom(f"plain copy of {gb:.1f} GB needs {gb + floor:.1f} GB free on {os.path.dirname(dst)} (floor {floor:g}), have {have:.1f}")
    for rel, mode in P["dirs"]:
        if rel:
            os.makedirs(os.path.join(tmp, rel), exist_ok=True)
    jobs = jobs or min(32, (os.cpu_count() or 4))
    methods = {"reflink": 0, "copy": 0}
    slot = CopySlot(out=out, what=f"plain copy of {gb:.1f} GB") if not use_reflink and P["bytes"] > 2**30 else None
    if slot:
        slot.__enter__()
    try:
        with CF.ThreadPoolExecutor(max_workers=jobs) as ex:
            futs = [ex.submit(clone_or_copy, s, os.path.join(tmp, rel), mode, use_reflink) for s, rel, mode, _ in P["files"]]
            for f in CF.as_completed(futs):
                methods[f.result()] += 1
    finally:
        if slot:
            slot.__exit__()
    for rel, text in P["links"]:
        os.symlink(text, os.path.join(tmp, rel))
    for rel, mode in sorted(P["dirs"], key=lambda x: -len(x[0])):
        os.chmod(os.path.join(tmp, rel) if rel else tmp, (mode & 0o7777) | stat.S_IRWXU)
    errs = verify(tmp, src)               # rewritten links are relative inside the tree, so they resolve the same in tmp and in DST
    if errs:
        raise SystemExit(f"TREE-FORK CHECK FAILED {tmp}: " + "; ".join(errs[:10]) + f" (partial copy kept: delete it with ot-delete {tmp})")
    rec = {"version": VERSION, "src": src_given, "src_real": src, "src_host": socket.gethostname(), "dst": dst,
           "lane": os.environ.get("OT_LANE", ""), "time_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "time_epoch": int(time.time()),
           "method": "reflink" if methods["reflink"] and not methods["copy"] else ("copy" if not methods["reflink"] else "mixed"),
           "files": n, "bytes": P["bytes"], "dirs": len(P["dirs"]), "links": len(P["links"]),
           "external_links": P["external"][:50], "external_links_n": len(P["external"]),
           "materialized": [f"{r} <- {t}" for r, t in P["materialized"]][:50], "specials_skipped": P["specials"][:50],
           "check": {"shared_inodes": 0, "event_links": 0}, "seconds": round(time.time() - t0, 1)}
    rec.update(src_identity(src))
    if remote_src:
        rec.update(src_remote=remote_src, reuse=reuse)
    with open(os.path.join(tmp, FORK_JSON), "w") as f:
        json.dump(rec, f, indent=1, sort_keys=True)
        f.write("\n")
    os.rename(tmp, dst)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(json.dumps({k: rec[k] for k in ("src_real", "dst", "lane", "time_utc", "method", "files", "src_manifest_hash")}) + "\n")
    except OSError:
        pass
    out(f"TREE-FORK OK {src} -> {dst}: {n} files {gb:.2f} GB {rec['method']} in {rec['seconds']} s, nlink-1 checked, "
        f"{len(P['external'])} external links kept, src manifest {rec['src_manifest_hash'][:12] or '-'}")
    return rec


def remote(host, argv):
    script = open(os.path.realpath(__file__)).read()
    cmd = "python3 -I - " + " ".join(shlex.quote(a) for a in argv)     # --src-host travels in argv: the fetch runs on HOST
    env = os.environ.get("OT_LANE", "")
    if env:
        cmd = f"OT_LANE={shlex.quote(env)} " + cmd
    p = subprocess.run(["timeout", "86400", "ssh", "-o", "ControlPath=none", "-o", "BatchMode=yes", host, cmd], input=script, text=True)
    return p.returncode


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(prog="ot-tree-fork", description=__doc__.split("\n")[0])
    ap.add_argument("src", nargs="?")
    ap.add_argument("dst", nargs="?")
    ap.add_argument("--host", default="", help="run the fork on this host (SRC and DST are paths there)")
    ap.add_argument("--src-host", default="", help="SRC lives on this host (DST on --host or here): reuse a same-manifest tree of the DST host, else fetch once")
    ap.add_argument("--jobs", type=int, default=0, help="parallel copy workers (default min(32, ncpu))")
    ap.add_argument("--materialize", action="store_true", help="copy the content of symlinks into event trees instead of refusing")
    ap.add_argument("--no-manifest", action="store_true", help="with --src-host: SRC is a private fork edited after its manifest: "
                    "fetch it straight into DST (no same-manifest reuse, no tree cache)")
    ap.add_argument("--dry", action="store_true")
    ap.add_argument("--verify", metavar="DST", help="only check an existing tree: no nlink>1 file, no symlink into an event tree")
    ap.add_argument("--src-of-verify", dest="vsrc", default="", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    if a.host:
        i = argv.index("--host")
        return remote(a.host, argv[:i] + argv[i + 2:])
    if a.verify:
        errs = verify(a.verify, a.vsrc)
        for e in errs[:40]:
            print("TREE-FORK " + e)
        if len(errs) > 40:
            print(f"TREE-FORK ... and {len(errs) - 40} more")
        print(f"TREE-FORK VERIFY {'OK' if not errs else 'FAIL'} {a.verify}: {len(errs)} problem(s)")
        return 0 if not errs else 4
    if not (a.src and a.dst):
        ap.print_usage(sys.stderr)
        return 2
    try:
        here = socket.gethostname().split(".")[0]
        if a.src_host and a.src_host not in (here, "localhost"):
            fork_remote(a.src_host, a.src, a.dst, a.jobs, a.materialize, a.dry, no_manifest=a.no_manifest)
        else:
            fork(a.src, a.dst, a.jobs, a.materialize, a.dry)
    except (Refused, NoRoom, Busy) as e:
        print(f"TREE-FORK REFUSED: {e}", file=sys.stderr)
        return e.code
    except SystemExit as e:
        print(str(e), file=sys.stderr)
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main())
