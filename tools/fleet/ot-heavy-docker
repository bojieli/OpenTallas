#!/bin/bash
# ot-heavy docker shim (ROOT 2026-10-16, coordinator: ENFORCE the declared memory on docker).
# A container started under an ot-heavy unit runs in dockerd's cgroup, NOT the unit's systemd scope, so the scope's
# MemoryMax never bound it: S-DIE fwd_die3 GRT declared 12 GB and peaked 80-91 GB on AGIdock, and earlyoom SIGTERMed
# four closure routes (21:56-21:59).  ot-heavy exports OT_HEAVY_MEM_GB and puts this directory first on PATH:
# `docker run` / `docker container run` / `docker create` get --memory=<declared>g --memory-swap=<same> (no swap);
# an explicit larger --memory/-m is lowered to the declaration, a smaller one is kept.  Everything else passes through.
REAL=/usr/bin/docker
MEM=${OT_HEAVY_MEM_GB:-}
case "$MEM" in ''|*[!0-9.]*) exec "$REAL" "$@";; esac
sub=; i=0; args=("$@")
for a in "$@"; do
  case "$a" in run|create) sub=$i; break;; container) ;; -*) ;; *) break;; esac
  i=$((i+1))
done
[ -z "$sub" ] && exec "$REAL" "$@"
pre=("${args[@]:0:$((sub+1))}"); rest=("${args[@]:$((sub+1))}")
out=(); have=; lim=
to_gb() { local v=${1,,}; case "$v" in *g|*gb) echo "${v%%g*}";; *m|*mb) awk "BEGIN{print ${v%%m*}/1024}";; *k|*kb) awk "BEGIN{print ${v%%k*}/1048576}";; *b) awk "BEGIN{print ${v%b}/1073741824}";; *) awk "BEGIN{print $v/1073741824}";; esac; }
cap() { local g; g=$(to_gb "$1"); awk "BEGIN{exit !($g > $MEM)}" && echo "${MEM}g" || echo "$1"; }
# OOMADJ_999_1022: a non-die container never runs below oom_score_adj 0
hshares=
hadj=; oadj() { case "$1" in -*) echo 0;; *) echo "$1";; esac; }
j=0; n=${#rest[@]}
while [ $j -lt $n ]; do
  a=${rest[$j]}
  case "$a" in
    --oom-score-adj=*) hadj=1; [ "${OT_HEAVY_PRIO:-}" = die ] || out+=("--oom-score-adj=$(oadj "${a#--oom-score-adj=}")");;
    --oom-score-adj) hadj=1; [ "${OT_HEAVY_PRIO:-}" = die ] || out+=("$a" "$(oadj "${rest[$((j+1))]}")"); j=$((j+1));;
    --cpu-shares=*) hshares=1; out+=("$a");;
    --cpu-shares|-c) hshares=1; out+=("$a" "${rest[$((j+1))]}"); j=$((j+1));;
    --memory=*) have=1; lim=$(cap "${a#--memory=}"); out+=("--memory=$lim");;
    --memory|-m) have=1; j=$((j+1)); lim=$(cap "${rest[$j]}"); out+=("$a" "$lim");;
    --memory-swap=*|--memory-swap) [ "$a" = --memory-swap ] && j=$((j+1));;   # replaced below: no swap above the cap
    -v|-e|-w|-u|-p|-l|-h|--name|--network|--net|--entrypoint|--env|--env-file|--mount|--volume|--workdir|--user|--cpus|\
    --shm-size|--ulimit|--label|--hostname|--ipc|--pid|--gpus|--device|--add-host|--cap-add|--cap-drop|--security-opt|\
    --tmpfs|--cidfile|--platform|--runtime|--log-driver|--log-opt|--restart|--volumes-from|--cpuset-cpus|--stop-signal|\
    --group-add|--dns|--publish|--expose|--userns|--uts|--cgroupns|--pull|--oom-score-adj|--cpu-shares|--sysctl)
        out+=("$a" "${rest[$((j+1))]}"); j=$((j+1));;
    -*) out+=("$a");;
    *) out+=("${rest[@]:$j}"); break;;
  esac
  j=$((j+1))
done
[ -z "$have" ] && lim="${MEM}g"
[ -z "$have" ] && out=("--memory=$lim" "${out[@]}")
# OOMADJ_999_1022: Docker daemon starts outside the caller scope, so the adjustment is explicit: a die container -999
# (never -1000: that also exempts it from its own --memory cgroup OOM, a livelock at the cap), anything else >= 0.
if [ "${OT_HEAVY_PRIO:-}" = die ]; then out=("--oom-score-adj=-999" "--label=opentallas.priority=die" "${out[@]}")
elif [ -z "$hadj" ]; then out=("--oom-score-adj=0" "${out[@]}"); fi
# CANCEL-LABEL-1120 (FLEET-WATCH-1015): every container carries its admitting unit and ot-run tag as labels; ot-heavy-stop / ot-run --cancel find it by them (no client needed).
[ -n "${OT_HEAVY_UNIT:-}" ] && out=("--label=ot.unit=$OT_HEAVY_UNIT" "${out[@]}")
[ -n "${OT_HEAVY_TAG:-}" ] && out=("--label=ot.tag=$OT_HEAVY_TAG" "${out[@]}")
# CRIT_1101 (FLOW-21, COORD 11-01 09:1x/09:2x): a crit job's container competes where the volume runs, as a sibling of
# the kit containers in system.slice: --cpu-shares 17600 = cpu.weight ~1000 (Docker 29 cgroup v2 mapping; default 100).
# An explicit --cpu-shares is kept.
if [ "${OT_HEAVY_CPU:-}" = crit ] && [ -z "$hshares" ]; then out=("--cpu-shares=17600" "${out[@]}"); fi
# ORPHANSTOP_1114 (ADMIT-TUNE-1, COORD 11-14): a foreground `docker run` client that dies (its scope is stopped, ot-run is cancelled)
# leaves the CONTAINER running (dockerd owns it) with its root openroad holding memory: 9 orphans / ~90 GB found on 11-14 on one host,
# a 14 GB GRT for 8 h.  Run the client as a child instead of exec, name the container, and stop it when this shim gets TERM/INT/HUP
# (a scope stop sends SIGTERM first).  Not for -d, -i, -t, create, or when OT_HEAVY_DOCKER_TRAP=0 (exec as before).
if [ "${OT_HEAVY_DOCKER_TRAP:-1}" != 0 ]; then
  _isrun=; for _x in "${pre[@]}"; do [ "$_x" = run ] && _isrun=1; done
  _skip=; _name=; _k=0
  for _x in "${out[@]}"; do
    case "$_x" in -d|--detach|-i|-t|-it|-ti|--interactive|--tty|--cidfile|--cidfile=*|--rm=false) _skip=1;; --name=*) _name=${_x#--name=};; --name) _name=${out[$((_k+1))]};; esac
    _k=$((_k+1))
  done
  if [ -n "$_isrun" ] && [ -z "$_skip" ]; then
    [ -n "$_name" ] || { _name="otc-$$-$RANDOM"; out=("--name=$_name" "${out[@]}"); }
    "$REAL" "${pre[@]}" "--memory-swap=$lim" "${out[@]}" <&0 &
    _cp=$!
    trap '"$REAL" stop -t "${OT_HEAVY_STOP_S:-20}" "$_name" >/dev/null 2>&1; kill -TERM $_cp 2>/dev/null; wait $_cp 2>/dev/null; exit 143' TERM INT HUP
    wait $_cp; _rc=$?
    trap - TERM INT HUP
    exit $_rc
  fi
fi
exec "$REAL" "${pre[@]}" "--memory-swap=$lim" "${out[@]}"
