#!/usr/bin/env python3
"""ot-git-mirror: the lanes' git origin, a bare repo on intel2 that relays claude/* branches to GitHub (FABLE-FLOW-1000 class 8).

Build hosts have no GitHub key; only intel2 has one.  Lanes therefore cloned the OWNER checkout (hub:OpenTallas) and pushed
68 claude/* refs into it on 11-15.  This bare repo replaces it:

  /srv/opentallas-scratch2/git/OpenTallas.git   (OT_GIT_MIRROR)
    - main + claude/* fetched from GitHub every 2 min (ot-git-mirror.timer -> `ot-git-mirror sync`); tags are not mirrored
    - accepts pushes of refs/heads/claude/* only (pre-receive): no main, no deletes, no non-fast-forward
    - post-receive forwards each pushed claude/* ref to GitHub at once (no force); `sync` re-forwards any claude/* ref the
      mirror has ahead of GitHub (a forward that failed), so nothing pushed here stays off GitHub
    - claude/* is fetched WITHOUT force: a GitHub fetch never rewinds a lane push that is not forwarded yet
    - daily `git gc` (gc.auto=0 so a push never pays for it)

usage: ot-git-mirror sync | fetch | fetch-all | install | status
Clones: tools/fleet/ot-lane-clone (never ~/OpenTallas).
"""
import fcntl
import json
import os
import subprocess as S
import sys
import time
from pathlib import Path

MIRROR = Path(os.environ.get("OT_GIT_MIRROR", "/srv/opentallas-scratch2/git/OpenTallas.git"))
UPSTREAM = os.environ.get("OT_GIT_UPSTREAM", "git@github.com:bojieli/OpenTallas.git")
GC_EVERY = int(os.environ.get("OT_GIT_MIRROR_GC_S", str(24 * 3600)))
LANE_PREFIX = "refs/heads/claude/"
BUDGET_S = int(os.environ.get("OT_GIT_MIRROR_BUDGET_S", "100"))   # a sync run stays under the 2-min timer interval
REJECT_LIMIT = int(os.environ.get("OT_GIT_MIRROR_REJECT_LIMIT", "2"))   # pushes GitHub rejects this often for the same sha are skipped

PRE_RECEIVE = r"""#!/bin/bash
# lanes push claude/* branches AND fast-forward main (OWNER 11-18: one shared version, no branches/gates/approvals).  A push to main is
# relayed to GitHub (no force) inside this hook; only if GitHub accepts does the mirror's main move, so the two never diverge.
rc=0
while read -r old new ref; do
  case "$ref" in
    refs/heads/claude/*) ;;
    refs/heads/main)
      if [ "$new" = 0000000000000000000000000000000000000000 ]; then echo "ot-git-mirror: REFUSED delete of main"; rc=1; continue; fi
      exec 8> main-push.lock; flock -w 300 8
      if out=$(env -u GIT_DIR timeout 600 git push -q origin "$new:refs/heads/main" 2>&1); then
        echo "ot-git-mirror: main -> ${new:0:11} on GitHub"
        echo "$(date '+%F %T') OK main $new" >> forward.log
      else
        env -u GIT_DIR -u GIT_QUARANTINE_PATH -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES timeout 120 git fetch -q origin +refs/heads/main:refs/heads/main >/dev/null 2>&1
        echo "ot-git-mirror: main NOT pushed: GitHub refused (main moved or a size/secret rule): $(echo "$out" | tail -2 | tr '\n' ' ')"
        echo "ot-git-mirror: fetch origin main, rebase on it and push again (ot-push-main does this)."
        echo "$(date '+%F %T') FAIL main $new $(echo "$out" | tail -1)" >> forward.log
        rc=1
      fi
      continue;;
    *) echo "ot-git-mirror: REFUSED $ref: push claude/* branches or main only"; rc=1; continue;;
  esac
  if [ "$new" = 0000000000000000000000000000000000000000 ]; then
    echo "ot-git-mirror: REFUSED delete of $ref"; rc=1
  fi
done
exit $rc
"""

POST_RECEIVE = r"""#!/bin/bash
# ot-git-mirror: forward the pushed claude/* refs to GitHub now, in ONE push (no force); per ref when the batch fails;
# `ot-git-mirror sync` retries a failed one
unset GIT_QUARANTINE_PATH
specs=()
while read -r old new ref; do
  case "$ref" in refs/heads/claude/*) specs+=("$new:$ref");; esac
done
[ ${#specs[@]} -eq 0 ] && exit 0
if out=$(timeout 1800 git push -q origin "${specs[@]}" 2>&1); then
  for s in "${specs[@]}"; do
    echo "ot-git-mirror: forwarded ${s#*:refs/heads/} @${s:0:11} to GitHub"
    echo "$(date '+%F %T') OK ${s#*:} ${s%%:*}" >> forward.log
  done
  exit 0
fi
for s in "${specs[@]}"; do
  if out=$(timeout 300 git push -q origin "$s" 2>&1); then
    echo "ot-git-mirror: forwarded ${s#*:refs/heads/} @${s:0:11} to GitHub"
    echo "$(date '+%F %T') OK ${s#*:} ${s%%:*}" >> forward.log
  else
    echo "ot-git-mirror: FORWARD FAILED ${s#*:refs/heads/} @${s:0:11}: $(echo "$out" | tail -2 | tr '\n' ' ')"
    echo "ot-git-mirror: the branch is in the mirror; sync retries every 2 min. Non-fast-forward on GitHub = push a new branch."
    echo "$(date '+%F %T') FAIL ${s#*:} ${s%%:*} $(echo "$out" | tail -1)" >> forward.log
  fi
done
exit 0
"""


def git(*a, check=True, timeout=600):
    p = S.run(["git", "-C", str(MIRROR), *a], capture_output=True, text=True, timeout=timeout)
    if check and p.returncode:
        raise SystemExit(f"git {' '.join(a)[:120]}: rc={p.returncode} {(p.stderr or p.stdout).strip()[-400:]}")
    return p


def install():
    """create or re-configure the bare repo and its hooks (idempotent)"""
    if not (MIRROR / "HEAD").is_file():
        MIRROR.parent.mkdir(parents=True, exist_ok=True)
        S.run(["git", "init", "-q", "--bare", str(MIRROR)], check=True)
    cfg = [("remote.origin.url", UPSTREAM), ("remote.origin.tagopt", "--no-tags"),
           ("uploadpack.allowFilter", "true"), ("uploadpack.allowAnySHA1InWant", "true"),
           ("receive.denyDeletes", "true"), ("receive.denyNonFastForwards", "true"),
           ("gc.auto", "0"), ("core.logAllRefUpdates", "false")]
    for k, v in cfg:
        git("config", k, v)
    git("config", "--unset-all", "remote.origin.fetch", check=False)
    git("config", "--add", "remote.origin.fetch", "+refs/heads/main:refs/heads/main")
    git("config", "--add", "remote.origin.fetch", "refs/heads/claude/*:refs/heads/claude/*")   # no '+': never rewind a lane push
    for name, body in (("pre-receive", PRE_RECEIVE), ("post-receive", POST_RECEIVE)):
        h = MIRROR / "hooks" / name
        tmp = h.with_suffix(".tmp")
        tmp.write_text(body)
        tmp.chmod(0o755)
        os.replace(tmp, h)
    print(f"installed {MIRROR} (upstream {UPSTREAM})")


def upstream_heads():
    p = S.run(["git", "ls-remote", UPSTREAM, LANE_PREFIX + "*"], capture_output=True, text=True, timeout=300)
    if p.returncode:
        return None
    return {r: s for s, r in (l.split("\t") for l in p.stdout.splitlines() if "\t" in l)}


def load_rejected():
    try:
        return json.loads((MIRROR / "rejected.json").read_text())
    except (OSError, ValueError):
        return {}


def save_rejected(rej):
    tmp = MIRROR / "rejected.json.tmp"
    tmp.write_text(json.dumps(rej, indent=1, sort_keys=True))
    os.replace(tmp, MIRROR / "rejected.json")


def reject_reason(stderr):
    """the GitHub reason line of a refused push (file size limit etc.), else the last line"""
    lines = [l.replace("remote: error:", "").replace("remote:", "").strip() for l in (stderr or "").splitlines()]
    for l in lines:
        if "exceeds" in l or "GH0" in l or "secret" in l.lower():
            return l[:300]
    return (lines[-1] if lines else "")[:300]


def mirror_heads():
    out = git("for-each-ref", "--format=%(objectname) %(refname)", LANE_PREFIX).stdout
    return {r: s for s, r in (l.split(" ", 1) for l in out.splitlines() if " " in l)}


def is_ancestor(a, b):
    return git("merge-base", "--is-ancestor", a, b, check=False).returncode == 0


def sync(fetch_only=False, forward=True):
    """fetch main + claude/* from GitHub, then re-forward claude/* refs the mirror has ahead of GitHub -> exit code.
    11-17: a ref GitHub rejected REJECT_LIMIT times at the same sha is skipped (logged once, listed in rejected.json, retried
    only when its sha changes), and the forward step stops at BUDGET_S so the run stays under its timer interval."""
    t_start = time.time()
    lockf = open(MIRROR / ("fetch.lock" if fetch_only else "sync.lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                                           # the previous sync still runs
    f = git("fetch", "-q", "origin", check=False, timeout=900)
    rc = 0
    if f.returncode:
        # a rejected non-forced claude/* update (GitHub moved a branch the mirror holds differently) is reported, not fatal
        print(f"fetch rc={f.returncode}: {f.stderr.strip()[-600:]}")
        rc = 1
    up = upstream_heads() if forward and not fetch_only else None
    rej = load_rejected()
    if up is not None:
        todo = []
        hub_only = set()
        try:                                               # refs GitHub refuses (file > 100 MB): kept on the hub, never retried
            hub_only = {ln.strip() for ln in (MIRROR / "hub-only.txt").read_text().splitlines() if ln.strip()}
        except OSError:
            pass
        for ref, sha in sorted(mirror_heads().items()):
            if ref in hub_only or ref[len("refs/heads/"):] in hub_only:
                continue
            r0 = rej.get(ref)
            if r0 and r0.get("sha") == sha and r0.get("n", 0) >= REJECT_LIMIT:
                continue
            u = up.get(ref)
            if u == sha:
                continue
            if u is None or (git("cat-file", "-e", u, check=False).returncode == 0 and is_ancestor(u, sha)):
                todo.append((ref, sha))
        try:
            batch = bool(todo) and time.time() - t_start < BUDGET_S and git("push", "-q", "origin", *[f"{s}:{r}" for r, s in todo], check=False,
                                       timeout=3600).returncode == 0
        except S.TimeoutExpired:
            batch = False
        if batch:
            for ref, sha in todo:
                print(f"re-forward {ref[len('refs/heads/'):]} @{sha[:11]}: ok")
            todo = []
        for ref, sha in todo:                              # the batch failed: one by one, so one bad ref blocks only itself
            if time.time() - t_start > BUDGET_S:
                print(f"budget {BUDGET_S} s used; {len(todo)} ref(s) left for the next run")
                break
            try:
                p = git("push", "-q", "origin", f"{sha}:{ref}", check=False, timeout=min(300, max(30, int(BUDGET_S - (time.time() - t_start)))))
                why = "ok" if p.returncode == 0 else "FAILED " + reject_reason(p.stderr)
            except S.TimeoutExpired:                       # 16:29 11-15: one timed-out ref killed the whole sync
                p, why = None, "FAILED push timed out"
            if p is not None and p.returncode == 0:
                rej.pop(ref, None)
            elif p is not None and "rejected" in (p.stderr or ""):
                r0 = rej.get(ref) if rej.get(ref, {}).get("sha") == sha else {"sha": sha, "n": 0}
                r0["n"] += 1; r0["why"] = reject_reason(p.stderr); r0["at"] = time.strftime("%F %T")
                rej[ref] = r0
                if r0["n"] >= REJECT_LIMIT:
                    print(f"SKIPPING {ref[len('refs/heads/'):]} @{sha[:11]} from now on (GitHub rejected it {r0['n']}x: {r0['why']}); "
                          f"retried when the branch moves; list in rejected.json")
            print(f"re-forward {ref[len('refs/heads/'):]} @{sha[:11]}: {why}")
            rc |= 0 if p is not None and p.returncode == 0 else 1
        save_rejected(rej)
    if fetch_only:
        return rc
    stamp = MIRROR / "gc.stamp"
    if not stamp.exists() or time.time() - stamp.stat().st_mtime > GC_EVERY:
        stamp.touch()
        git("gc", "--quiet", check=False, timeout=7200)
    return rc


def fetch_main():
    """11-17: refresh refs/heads/main from GitHub alone.  The full `sync` fetch walks every claude/* ref (minutes); a lane gate needs
    the new main within seconds of a merge (measured lag of the mirror's main behind GitHub: up to one 3.5-min sync cycle)."""
    lockf = open(MIRROR / "fetch-main.lock", "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    f = git("fetch", "-q", "origin", "+refs/heads/main:refs/heads/main", check=False, timeout=120)
    if f.returncode:
        print(f"fetch main rc={f.returncode}: {f.stderr.strip()[-300:]}")
    return f.returncode


def status():
    h = mirror_heads()
    main = git("rev-parse", "-q", "--verify", "refs/heads/main", check=False).stdout.strip()
    log = MIRROR / "forward.log"
    fails = [l for l in (log.read_text().splitlines() if log.exists() else []) if " FAIL " in l]
    print(f"{MIRROR}: main {main[:11] or '-'}, {len(h)} claude/* refs, forward failures logged: {len(fails)}")
    for l in fails[-5:]:
        print("  " + l)
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "install":
        install()
        return 0
    if cmd == "sync":
        return sync()
    if cmd == "fetch":                                     # own 30 s timer: main only (0.5 s), never blocked by a slow sync
        return fetch_main()
    if cmd == "fetch-all":
        return sync(fetch_only=True)
    if cmd == "status":
        return status()
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
