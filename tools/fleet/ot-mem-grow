#!/usr/bin/env python3
"""ot-mem-grow (ADMIT-TUNE-1 11-14, COORD): build containers die at their docker memory cap (= the --mem request): slice_station t28 form c was
killed at 28.7 / 32 GB in post-GRT hold repair, t30 c at 29.2 / 32, t8 c at 28 / 32.  Run every minute as root: a container above GROW_AT (85 %)
of its cap gets its cap raised by GROW_BY (50 %), up to MAX_MULT (2x) of the cap it first had (its request), when this host's MemAvailable minus
INV_HEADROOM_GB (/etc/ot-heavy.conf) covers the increase.  That turns a cap kill into growth, which admission already prices from measured RSS.
  ot-mem-grow [--dry-run] [--passes N] [--interval S]     (the timer starts one run a minute; --passes 4 --interval 15 polls every 15 s)
Also covers the ot-heavy systemd scopes (oth-*.scope MemoryMax = --mem): memory.max is raised the same way for jobs that are not in a container."""
import argparse, glob, json, os, re, subprocess, sys, time

GROW_AT, GROW_BY, MAX_MULT = 0.75, 0.5, 2.0      # 0.75 + 15 s polling: a GRT step of several GB per minute outran 0.85 + 60 s (TL-SERDEST14 B2, 50.3 of 48 GB, intel1 14:50)
DIR = "/var/tmp/ot-mem-grow"
GB = 1 << 30


def decide(cap, req, usage, avail_gb, headroom_gb, grow_at=GROW_AT, grow_by=GROW_BY, max_mult=MAX_MULT):
    """-> new cap in bytes, or None.  cap, req, usage in bytes; avail_gb / headroom_gb in GB"""
    if cap <= 0 or usage < grow_at * cap:
        return None
    new = min(int(cap * (1 + grow_by)), int(req * max_mult))
    if new <= cap:
        return None                                    # already at 2x the request
    if avail_gb - headroom_gb < (new - cap) / GB:
        return None
    return new


def refusal(cap, req, usage, avail_gb, headroom_gb, grow_at=GROW_AT, grow_by=GROW_BY, max_mult=MAX_MULT):
    """-> the wanted new cap in bytes when the container is over the trigger and not yet at 2x but the host cannot fund it (the headroom guard said no), else None"""
    if cap <= 0 or usage < grow_at * cap:
        return None
    new = min(int(cap * (1 + grow_by)), int(req * max_mult))
    if new > cap and avail_gb - headroom_gb < (new - cap) / GB:
        return new
    return None


def sh(*a):
    return subprocess.run(list(a), capture_output=True, text=True, timeout=120).stdout


def conf_headroom():
    try:
        m = re.search(r"^INV_HEADROOM_GB=([0-9.]+)", open("/etc/ot-heavy.conf").read(), re.M)
        return float(m[1]) if m else 32.0
    except OSError:
        return 32.0


def avail_gb():
    for ln in open("/proc/meminfo"):
        if ln.startswith("MemAvailable"):
            return int(ln.split()[1]) / 1048576
    return 0.0


def usage_of(cid):
    for p in (f"/sys/fs/cgroup/system.slice/docker-{cid}.scope/memory.current", f"/sys/fs/cgroup/docker/{cid}/memory.current"):
        try:
            return int(open(p).read())
        except OSError:
            pass
    return None


def scope_rows():
    """[(cgroup dir, cap bytes, usage bytes)] of the active oth-*.scope cgroups that carry a numeric memory.max"""
    out = []
    for d in glob.glob("/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/*/oth-*.scope"):
        try:
            mx = open(d + "/memory.max").read().strip()
            if mx.isdigit():
                out.append((d, int(mx), int(open(d + "/memory.current").read())))
        except OSError:
            pass
    return out


def grow_scopes(orig, hr, dry):
    raised = 0
    for d, cap, use in scope_rows():
        req = orig.setdefault(d, cap)
        new = decide(cap, req, use, avail_gb(), hr)
        if new:
            line = f"{time.strftime('%F %T')} SCOPE {os.path.basename(d)} usage {use / GB:.1f} GB of MemoryMax {cap / GB:.1f} GB -> {new / GB:.1f} GB (request {req / GB:.1f}, avail {avail_gb():.0f}, headroom {hr:g})"
            if not dry:
                try:
                    open(d + "/memory.max", "w").write(str(new))
                    raised += 1
                except OSError as e:
                    line += f" FAILED {e}"
            print(line)
            open(DIR + "/log", "a").write(line + "\n")
    return raised


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--passes", type=int, default=1)
    ap.add_argument("--interval", type=float, default=15.0)
    a = ap.parse_args(argv)
    for i in range(max(1, a.passes)):
        if i:
            time.sleep(a.interval)
        one_pass(a.dry_run)
    return 0


def one_pass(dry_run):
    a = argparse.Namespace(dry_run=dry_run)
    os.makedirs(DIR, exist_ok=True)
    try:
        orig = json.load(open(DIR + "/orig.json"))
    except (OSError, ValueError):
        orig = {}
    ids = sh("docker", "ps", "-q", "--no-trunc").split()
    info = json.loads(sh("docker", "inspect", *ids) or "[]") if ids else []
    live, raised, seen = set(), 0, 0
    try:
        refused = json.load(open(DIR + "/refused.json"))
    except (OSError, ValueError):
        refused = {}
    hr = conf_headroom()
    for c in info:
        cid, name, cap = c["Id"], c["Name"].lstrip("/"), c["HostConfig"].get("Memory", 0)
        live.add(cid)
        if cap <= 0:
            continue
        req = orig.setdefault(cid, cap)               # the first cap seen is the request
        use = usage_of(cid)
        seen += 1
        if use is None:
            continue
        new = decide(cap, req, use, avail_gb(), hr)
        if not new:
            want = refusal(cap, req, use, avail_gb(), hr)
            if want and time.time() - refused.get(cid, 0) > 600:        # REFUSED lines: at most one per container per 10 min
                refused[cid] = time.time()
                line = f"{time.strftime('%F %T')} REFUSED {name} {cid[:12]} usage {use / GB:.1f} GB of cap {cap / GB:.1f} GB, wanted {want / GB:.1f} GB: avail {avail_gb():.0f} - headroom {hr:g} < {(want - cap) / GB:.0f} GB"
                print(line)
                open(DIR + "/log", "a").write(line + "\n")
        if new:
            line = f"{time.strftime('%F %T')} {name} {cid[:12]} usage {use / GB:.1f} GB of cap {cap / GB:.1f} GB -> {new / GB:.1f} GB (request {req / GB:.1f}, avail {avail_gb():.0f}, headroom {hr:g})"
            if not a.dry_run:
                r = subprocess.run(["docker", "update", f"--memory={new}", f"--memory-swap={new}", cid], capture_output=True, text=True)
                if r.returncode:
                    line += " FAILED " + r.stderr.strip()[:100]
                else:
                    raised += 1
            print(line)
            open(DIR + "/log", "a").write(line + "\n")
    raised += grow_scopes(orig, hr, a.dry_run)
    live |= {d for d, _, _ in scope_rows()}
    orig = {k: v for k, v in orig.items() if k in live}
    refused = {k: v for k, v in refused.items() if k in live}
    if not a.dry_run:
        json.dump(refused, open(DIR + "/refused.json.tmp", "w")); os.replace(DIR + "/refused.json.tmp", DIR + "/refused.json")
    if not a.dry_run:
        json.dump(orig, open(DIR + "/orig.json.tmp", "w")); os.replace(DIR + "/orig.json.tmp", DIR + "/orig.json")
    print(f"ot-mem-grow: {seen} capped containers, {raised} raised (containers + scopes)")


if __name__ == "__main__":
    sys.exit(main())
