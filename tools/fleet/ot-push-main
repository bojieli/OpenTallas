#!/usr/bin/env python3
"""ot-push-main: land the commits of this lane clone on main in ONE command (OWNER 11-18: one shared version, no branches, no gate
records, no READY / APPROVED lines).

  cd <lane clone> && python3 -I /srv/opentallas-scratch2/claude/rt/current/tools/fleet/ot-push-main [--no-test] [--dry-run] [--max N]

Steps: fetch origin main -> rebase the clone's commits onto it (never a merge of main into the lane, never a force push) -> run only the
tests of the touched files (touched test_*.py, plus test_<stem>*.py next to a touched source; seconds) -> push HEAD to origin main.
Non-fast-forward (someone pushed first): fetch, rebase, retry (up to --max, default 8); the tests rerun only when the new upstream
commits touched files this push touches.  A rebase conflict aborts the rebase (clone unchanged) and exits 3: resolve by hand,
`git rebase origin/main`, then run again.  Failing tests exit 4 and push nothing.  Exit 0 = main contains your commits.
KIT-STAGE-IMPORT-1124: a push that makes a kit-staged tools/die_plan module import a sibling kit staging does not copy exits 6
(static, delta vs main, also with --no-test; tools/fleet/kit_stage_imports.py).
PUSH-FIX-2300: (1) a lane clone is a sparse worktree, so before testing the clone's cone is auto-widened (git sparse-checkout add, never
a full checkout) to the repo paths the selected tests name, and again for any tracked path a failing run reports missing, then the run
repeats (max 4 rounds); (2) after a rebase onto a moved main only the tests whose touched file (or the test file itself) overlaps the
moved files re-run, none when nothing overlaps; (3) the default --test-timeout is 3000 s scaled by host load (load1/ncpu, 1x..3x).
Lane line: bash+python3 -I ot-push-main, nothing else (no branch, gate record, READY or APPROVED line).
PUSH-TRAIN-0100: tests run with pytest-xdist (-n min(16, ncpu/2), --dist loadfile; OT_PUSH_XDIST=N overrides, 0 = serial); a rebase
conflict lists its files; after a moved main only the affected test files re-run, at most 3 times.
origin is the lane mirror on the hub: it relays the push to GitHub before accepting it, so a GitHub refusal is reported here."""
import argparse
import os
import re
import shlex
import subprocess as S
import sys
import threading
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))     # python3 -I drops the script dir from sys.path
try:
    import ot_status as _OTS     # WAITER-STD-1600: exit-status file + DONE/DIED post per push
except ImportError:
    _OTS = None

REPUSH_RETEST = 3        # PUSH-TRAIN-0100: re-run only the affected tests up to 3 times when main moves under the test
VENV_PY = "/srv/opentallas-scratch2/claude/mq-gate/venv/bin/python"


def git(*a, check=False, timeout=900):
    return S.run(["git", *a], capture_output=True, text=True, timeout=timeout, check=check)


def out(*a):
    return git(*a).stdout.strip()


def touched(base):
    return [l for l in out("diff", "--name-only", "--no-renames", f"{base}..HEAD").splitlines() if l]


def select_tests(files, root="."):
    """touched test files + test_<stem>*.py in the dir of a touched source (and its tests/ dir); only files that exist"""
    found = []
    for f in files:
        p = Path(root, f)
        if not f.endswith((".py", ".sh", ".sv", ".v")) and "/ot-" not in "/" + f:
            continue
        name = p.name
        if name.startswith("test_") and name.endswith(".py"):
            cands = [p]
        else:
            stem = name[:-3] if name.endswith(".py") else name
            cands = sorted(p.parent.glob(f"test_{stem}*.py")) + sorted((p.parent / "tests").glob(f"test_{stem}*.py")) \
                + sorted(p.parent.glob(f"test_{stem.replace('-', '_')}*.py"))
        for c in cands:
            if c.is_file() and str(c) not in found:
                found.append(str(c))
    return found


def default_timeout(base=3000, load=None, ncpu=None):
    """test timeout in s: base x clamp(load1/ncpu, 1, 3)"""
    try:
        load = os.getloadavg()[0] if load is None else load
        ncpu = (os.cpu_count() or 1) if ncpu is None else ncpu
    except OSError:
        return base
    return int(base * min(3.0, max(1.0, load / max(1, ncpu))))


_TOK = re.compile(r"/?[\w.+@%-]+(?:/[\w.+@%-]+)+")


def sparse_on():
    return out("config", "--get", "core.sparseCheckout") == "true"


def widen_for(text, root="."):
    """auto-widen the sparse cone: every repo path named in `text` (test source or failure output) that is tracked in HEAD but
    absent on disk -> `git sparse-checkout add` of its directory (the path itself when it is a tracked dir).  -> [dirs added]"""
    if not sparse_on():
        return []
    root = os.path.abspath(root)
    cand = set()
    for tok in _TOK.findall(text):
        t = tok
        if t.startswith(root + "/"):
            t = t[len(root) + 1:]
        t = t.strip("/.")
        if not t or t.startswith(("..", "/")):
            continue
        parts = t.split("/")
        for n in range(len(parts), 0, -1):          # longest tracked prefix
            cand.add("/".join(parts[:n]))
    if not cand:
        return []
    cl = sorted(cand)
    r = S.run(["git", "cat-file", "--batch-check"], input="".join(f"HEAD:{c}\n" for c in cl), capture_output=True, text=True)
    kinds = {}
    for c, line in zip(cl, r.stdout.splitlines()):
        f = line.split()
        if len(f) >= 2 and f[1] in ("tree", "blob"):
            kinds[c] = f[1]
    add = set()
    for c, k in kinds.items():
        d = c if k == "tree" else os.path.dirname(c)
        if not d:
            continue
        # only the deepest tracked prefix of a token counts (a shorter one is its parent)
        if any(o != c and o.startswith(c + "/") for o in kinds):
            continue
        if os.path.exists(os.path.join(root, c)):
            continue
        add.add(d)
    add = sorted(add)
    if add:
        r = git("sparse-checkout", "add", *add)
        if r.returncode:
            print("ot-push-main: sparse-checkout add failed: " + (r.stderr or r.stdout).strip()[-200:])
            return []
        print("ot-push-main: widened sparse cone (+" + " ".join(add) + ")")
    return add


def test_sources(tests):
    txt = []
    for t in tests:
        try:
            txt.append(Path(t).read_text(errors="replace"))
        except OSError:
            pass
    return "\n".join(txt)


def run_tests_once(cmd, timeout):
    """-> (rc, output); streams the output; 124 on timeout"""
    pr = S.Popen(cmd, stdout=S.PIPE, stderr=S.STDOUT, text=True, errors="replace")
    hit = []
    tm = threading.Timer(timeout, lambda: (hit.append(1), pr.kill()))
    tm.start()
    buf = []
    try:
        for line in pr.stdout:
            sys.stdout.write(line); buf.append(line)
        pr.wait()
    finally:
        tm.cancel()
    sys.stdout.flush()
    if hit:
        print(f"ot-push-main: tests timed out after {timeout} s")
        return 124, "".join(buf)
    return pr.returncode, "".join(buf)


def xdist_workers(py, ntests, ncpu=None, env=None):
    """PUSH-TRAIN-0100: pytest-xdist worker count, 0 = serial.  OT_PUSH_XDIST=N overrides (0 = off); default min(16, ncpu/2, ntests);
    one test file or no xdist -> serial.  --dist loadfile keeps each test file on one worker (files may share module state)."""
    env = os.environ if env is None else env
    ncpu = (os.cpu_count() or 2) if ncpu is None else ncpu
    try:
        n = int(env["OT_PUSH_XDIST"]) if env.get("OT_PUSH_XDIST", "").strip() else min(16, max(1, ncpu // 2))
    except ValueError:
        n = min(16, max(1, ncpu // 2))
    n = min(n, ntests)
    if n < 2:
        return 0
    if S.run([py, "-c", "import xdist"], capture_output=True).returncode:
        return 0
    return n


def run_tests(tests, timeout, rounds=4):
    py = VENV_PY if os.access(VENV_PY, os.X_OK) else sys.executable
    if S.run([py, "-c", "import pytest"], capture_output=True).returncode:
        print("ot-push-main: no pytest here; tests SKIPPED (run them where pytest exists)")
        return 0
    widen_for(test_sources(tests))
    nw = xdist_workers(py, len(tests))
    par = ["-n", str(nw), "--dist", "loadfile"] if nw else []
    cmd = [py, "-m", "pytest", "-q", "-x", "-p", "no:cacheprovider", *par, *tests]
    for n in range(1, rounds + 1):
        print("ot-push-main: " + shlex.join(cmd[2:]))
        rc, o = run_tests_once(cmd, timeout)
        if rc == 0 or rc == 124 or n == rounds:
            return rc
        if not widen_for(o):
            return rc
        print(f"ot-push-main: cone widened after failure; re-running (round {n + 1}/{rounds})")
    return rc


def affected_tests(tests, files, moved):
    """after a rebase onto moved main: the tests whose own file moved or that select for a touched file that moved"""
    mv = set(moved)
    hot = {t for t in tests if t in mv}
    for f in set(files) & mv:
        hot.update(select_tests([f]))
    return [t for t in tests if t in hot]


def kit_stage_refusal(files, base):
    """KIT-STAGE-IMPORT-1124 (COORD, FLOW-CANARY-R2): refuse (exit 6, nothing pushed, also with --no-test) a push that makes a module kit
    staging copies import a tools/die_plan sibling staging does not copy (da4562fcf7 -> every kit died at preflight until b1462d16b4).
    Delta vs main only; static, seconds; runs when a touched file is a tools/die_plan .py.  -> refusal text or ''."""
    if not any(f.startswith("tools/die_plan/") and f.endswith(".py") for f in files):
        return ""
    try:
        import kit_stage_imports as KSI
        new = KSI.new_pairs(".", base, "HEAD")
    except Exception as e:  # noqa: BLE001 - the checker itself failing never blocks a push; it says so
        print(f"ot-push-main: WARN kit staging import check not run: {type(e).__name__}: {str(e)[:200]}")
        return ""
    if not new:
        return ""
    return ("ot-push-main: REFUSED KIT-STAGE-IMPORT: a module staged into kits would import a sibling the kit does not have; "
            "nothing pushed\n  " + "\n  ".join(new))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--no-test", action="store_true")
    ap.add_argument("--dry-run", action="store_true", help="rebase + test, no push")
    ap.add_argument("--max", type=int, default=8, help="push attempts; main-moved test re-runs are capped at 3 (REPUSH_RETEST)")
    ap.add_argument("--test-timeout", type=int, default=None, help="s; default 3000 scaled by host load")
    a = ap.parse_args()
    if a.test_timeout is None:
        a.test_timeout = default_timeout()
    top = out("rev-parse", "--show-toplevel")
    if not top:
        print("ot-push-main: not in a git clone"); return 2
    os.chdir(top)
    if out("status", "--porcelain", "--untracked-files=no"):
        print("ot-push-main: uncommitted changes to tracked files; commit them first (no stash)"); return 2
    tested_files = None
    retests = 0
    for attempt in range(1, a.max + 1):
        f = git("fetch", "-q", "origin", "+refs/heads/main:refs/remotes/origin/main", timeout=900)
        if f.returncode:
            print("ot-push-main: fetch failed: " + (f.stderr or f.stdout).strip()[-300:]); return 1
        base = out("rev-parse", "refs/remotes/origin/main")
        head = out("rev-parse", "HEAD")
        if git("merge-base", "--is-ancestor", head, base).returncode == 0:
            print(f"ot-push-main: nothing to push; main {base[:11]} already contains HEAD {head[:11]}"); return 0
        old_base = out("merge-base", "HEAD", base)
        if old_base != base:
            r = git("rebase", "--rebase-merges", base, timeout=1800)
            if r.returncode:
                files = " ".join(sorted(set(out("diff", "--name-only", "--diff-filter=U").split() +
                                           [l[3:] for l in out("status", "--porcelain").splitlines() if l[:2] in ("UU", "AA", "DU", "UD", "AU", "UA", "DD")])))
                git("rebase", "--abort")
                print(f"ot-push-main: REBASE CONFLICT on main {base[:11]} in: {files.replace(chr(10), ' ')}\n"
                      f"  clone unchanged; resolve by hand: git rebase origin/main, fix, git rebase --continue, run again"); return 3
        files = touched(base)
        if not files:
            print("ot-push-main: no file differs from main; nothing to push"); return 0
        stage = kit_stage_refusal(files, base)
        if stage:
            print(stage); return 6
        moved = set(out("diff", "--name-only", f"{old_base}..{base}").split()) if old_base != base else set()
        first = tested_files is None
        if not a.no_test:
            if first:
                tests = select_tests(files)
            else:      # rebased onto a moved main: re-run only what the moved files can affect (none when nothing overlaps)
                tests = affected_tests(tested_files, files, moved)
                retests += bool(tests)
                if tests and retests > REPUSH_RETEST:
                    print(f"ot-push-main: main moved and touched the pushed files {retests} times; stop retesting, run again"); return 5
                if tests:
                    print(f"ot-push-main: main moved; re-running {len(tests)} affected of {len(tested_files)} test file(s)")
                else:
                    print("ot-push-main: main moved but no moved file overlaps the pushed files or their tests; tests not re-run")
            if first:
                tested_files = tests
            if tests:
                rc = run_tests(tests, a.test_timeout)
                if rc:
                    print(f"ot-push-main: TESTS FAILED rc={rc}; nothing pushed"); return 4
            elif first:
                print(f"ot-push-main: no test file selects for {len(files)} touched file(s); pushing")
        if a.dry_run:
            print(f"ot-push-main: dry run ok; would push {out('rev-parse', 'HEAD')[:11]} onto main {base[:11]}"); return 0
        p = git("push", "origin", "HEAD:refs/heads/main", timeout=1800)
        msg = ((p.stderr or "") + (p.stdout or "")).strip()
        if p.returncode == 0:
            print(f"ot-push-main: PUSHED main @{out('rev-parse', 'HEAD')} (on main {base[:11]}, attempt {attempt})"); return 0
        print(f"ot-push-main: push refused (attempt {attempt}/{a.max}): {msg[-400:]}")
        if "NOT pushed" not in msg and "non-fast-forward" not in msg and "rejected" not in msg and "fetch first" not in msg:
            return 1
    print("ot-push-main: main kept moving; gave up after %d attempts, run again" % a.max)
    return 5


if __name__ == "__main__":
    sys.exit(_OTS.run_recorded("push", main, "ot-push-main " + " ".join(sys.argv[1:])) if _OTS else main())
