#!/usr/bin/env python3
"""ot-sizes-sync: merge every host's measured size table into one fleet table (localhost cron, every 10 min).

Each host's ot-heavy-reconcile learns class -> measured peak from the jobs that ran THERE (/var/tmp/ot-heavy/sizes.json).
This pulls the four tables, merges them (peak, request: max; counts: sum) and writes /var/tmp/ot-heavy/sizes.fleet.json
on every host and on localhost, so a class measured on one host sizes its admission on all of them (ot-heavy v4).
A fleet row is never dropped: a host that cannot be reached keeps its last contribution through the previous fleet table.
  ot-sizes-sync            one pass          ot-sizes-sync --print     the merged table, largest first
"""
import json, math, os, subprocess, sys

HOSTS = ["ot-epyc4", "ot-epyc7", "ot-epyc8", "ot-epyc9", "ot-gold2", "ot-gold1", "ot-pve1", "ot-agidock128"]   # epyc5 was missing (10-18); epyc6/7 FLEET-NEW 2026-10-19
D = "/var/tmp/ot-heavy"
SSH = ["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]


def merge(tables, prev):
    t = {}
    for d in tables:
        for c, e in d.items():
            o = t.setdefault(c, dict(n=0, live=0, proved=0, peak_gb=0.0, req_gb=0))
            for k in ("n", "live", "proved"):
                o[k] += e.get(k, 0)
            o["peak_gb"] = max(o["peak_gb"], e.get("peak_gb", 0))
            o["req_gb"] = max(o["req_gb"], e.get("req_gb", 0))
    for c, e in prev.items():                    # history: keep the largest peak and the finished count ever seen
        o = t.setdefault(c, dict(n=0, live=0, proved=0, peak_gb=0.0, req_gb=0))
        o["n"], o["peak_gb"], o["req_gb"] = max(o["n"], e.get("n", 0)), max(o["peak_gb"], e.get("peak_gb", 0)), max(o["req_gb"], e.get("req_gb", 0))
    for e in t.values():
        e["suggest_gb"] = math.ceil(max(e["peak_gb"] * 1.25, e["peak_gb"] + 4))
    return t


def main():
    os.makedirs(D, exist_ok=True)
    try:
        prev = json.load(open(f"{D}/sizes.fleet.json"))
    except (OSError, ValueError):
        prev = {}
    if "--print" in sys.argv:
        for c, e in sorted(prev.items(), key=lambda kv: -kv[1]["peak_gb"]):
            print(f"{e['peak_gb']:8.1f} GB peak  suggest {e['suggest_gb']:4d}  requested {e['req_gb']:4d}  n={e['n']} proved={e['proved']} live={e['live']}  {c}")
        return
    tables = []
    for h in HOSTS:
        try:
            r = subprocess.run(SSH + [h, f"cat {D}/sizes.json"], capture_output=True, text=True, timeout=40)
            tables.append(json.loads(r.stdout))
        except Exception:
            pass
    if not tables:
        sys.exit("ot-sizes-sync: no host table read")
    blob = json.dumps(merge(tables, prev), indent=0, sort_keys=True)
    open(f"{D}/sizes.fleet.json.tmp", "w").write(blob)
    os.replace(f"{D}/sizes.fleet.json.tmp", f"{D}/sizes.fleet.json")
    for h in HOSTS:
        try:
            subprocess.run(SSH + [h, f"cat > {D}/.sizes.fleet.tmp && mv {D}/.sizes.fleet.tmp {D}/sizes.fleet.json"], input=blob,
                           text=True, timeout=40)
        except Exception:
            pass


if __name__ == "__main__":
    main()
