#!/usr/bin/env python3
"""ot-vl-jcap: cap the build parallelism of Verilator C++ builds run under ot-heavy (VL_JCAP_1022).

Why (fleet incident 2026-10-22 10:40): Verilator `*_classes` C++ compiles peak at ~30 GB per cc1plus.  Lanes built them
at -j8 (make -j / verilator -j / --build-jobs) under 64-96 GB ot-heavy caps, so every build OOMed repeatedly; the
OOM-killer task dumps filled / on ot-epyc5 (syslog + kern.log 343 GB each), ot-epyc7 and ot-epyc9 likewise.

How: ot-heavy runs `ot-vl-jcap --env MEM -- CMD...` just before it launches the job and evals its output, which
  * computes CAP = max(1, floor(MEM / PER_JOB_GB)),
      PER_JOB_GB = min(30 (VL_JCAP_PER_GB in env or /etc/ot-heavy.conf), measured peak of the command's class)
      when ot-heavy-reconcile has a measured class peak (a whole job's peak bounds each of its cc1plus), floored at 4 GB;
  * exports OT_VL_JCAP_N / OT_VL_JCAP_WHY and puts SHIM_DIR (holding `make` -> this file) first on PATH;
  * says so on stderr when the top-level command itself is a Verilator build asking for more than CAP jobs.
Every `make` the job runs (directly, from a script, from `verilator --build`, or recursively via $(MAKE)) then goes
through this file.  A make RECOGNISED AS A VERILATOR BUILD --
      -f/--file/--makefile <dir>/<P>.mk with <dir>/<P>_classes.mk next to it, or V*.mk, or
      no -f and the make directory (cwd + -C) holds a *_classes.mk (a make inside an obj_dir)
-- whose effective -j (argv -j/-jN/--jobs[=N]/-kj8, else MAKEFLAGS -jN or an inherited jobserver; bare -j = unlimited)
exceeds CAP gets its -j options replaced by -jCAP and a stderr line
      ot-heavy: verilator build -j8 capped to -j2 (64 GB / 30 GB per cc1plus)
Any other make, a Verilator make already at <= CAP, a serial one, or OT_VL_JCAP=0 is exec'd unchanged (same argv).
Any error inside the shim falls through to the real make unchanged: the shim never fails a build by itself.
Opt-out: OT_VL_JCAP=0 (ot-heavy then neither arms the cap nor puts the shim on PATH; an armed shim also obeys it).
Capping (not refusing) was chosen: most lanes launch scripts (run_*_vl.sh) whose -j is invisible to ot-heavy, so a
refusal could only see a few commands, and it would stop work that runs correctly (slower) once capped.

  ot-vl-jcap --env MEM -- CMD...   shell lines for ot-heavy to eval (empty when OT_VL_JCAP=0)
  ot-vl-jcap --selftest            detection, cap arithmetic, opt-out, non-Verilator pass-through, real exec via a fake make
"""
import glob
import math
import os
import re
import shlex
import sys

DEFAULT_PER_GB = 30.0
MIN_PER_GB = 4.0
SHIM_DIR = "/usr/local/lib/ot-heavy/vljcap"
RECONCILE = "/usr/local/bin/ot-heavy-reconcile"
MARK = "VL_JCAP_1022"
INF = 10 ** 9

# GNU make short options that take an argument (separate or attached) and those that take none
ARG_OPTS = set("CfIoW")
NOARG = set("BbdeiknpqrSstvwLR")
LONG_ARG = ("--directory", "--file", "--makefile", "--include-dir", "--old-file", "--assume-old", "--what-if",
            "--new-file", "--assume-new", "--eval")


def conf_per_gb():
    v = os.environ.get("VL_JCAP_PER_GB")
    if v is None:
        try:
            m = re.search(r"^VL_JCAP_PER_GB=([0-9.]+)", open("/etc/ot-heavy.conf").read(), re.M)
            v = m[1] if m else None
        except OSError:
            v = None
    try:
        return float(v) if v else DEFAULT_PER_GB
    except ValueError:
        return DEFAULT_PER_GB


def class_peak(argv, reconcile=RECONCILE):
    """measured peak (GB) of the command's ot-heavy class, or None (no table / unmeasured / reconcile missing)"""
    try:
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("ot_heavy_reconcile", reconcile)
        spec = importlib.util.spec_from_loader("ot_heavy_reconcile", loader)
        mod = importlib.util.module_from_spec(spec)
        saved = sys.argv
        sys.argv = [reconcile]
        try:
            loader.exec_module(mod)
        finally:
            sys.argv = saved
        return mod.class_peak(mod.classify(argv), mod.sizes())
    except Exception:
        return None


def per_job_gb(peak, default=None):
    d = conf_per_gb() if default is None else default
    per = min(d, peak) if peak and peak > 0 else d
    return max(MIN_PER_GB, per)


def cap_for(mem_gb, per_gb):
    return max(1, int(math.floor(float(mem_gb) / per_gb)))


def fmt_gb(x):
    return f"{x:g}"


# ---------------------------------------------------------------- make argv
def parse_make(args):
    """(jobs, files, dirs, jtoken_idx) from a make argv (without argv[0]); jobs None = no -j, INF = bare -j"""
    jobs, files, dirs, jidx = None, [], [], []
    i = 0
    while i < len(args):
        a = args[i]
        nxt = args[i + 1] if i + 1 < len(args) else None
        if a == "--":
            break
        if a.startswith("--"):
            if a == "--jobs" or a.startswith("--jobs="):
                if "=" in a:
                    v = a.split("=", 1)[1]
                    jobs = int(v) if v.isdigit() else INF
                    jidx.append(i)
                elif nxt is not None and nxt.isdigit():
                    jobs = int(nxt)
                    jidx += [i, i + 1]
                    i += 1
                else:
                    jobs = INF
                    jidx.append(i)
            else:
                name, eq, val = a.partition("=")
                if name in LONG_ARG:
                    if not eq and nxt is not None:
                        val = nxt
                        i += 1
                    if name in ("--file", "--makefile"):
                        files.append(val)
                    elif name == "--directory":
                        dirs.append(val)
            i += 1
            continue
        if a.startswith("-") and len(a) > 1:
            k = 1
            while k < len(a):
                c = a[k]
                if c in ARG_OPTS:
                    val = a[k + 1:]
                    if not val and nxt is not None:
                        val = nxt
                        i += 1
                    if c == "f":
                        files.append(val)
                    elif c == "C":
                        dirs.append(val)
                    break
                if c == "j":
                    num = a[k + 1:]
                    if num.isdigit():
                        jobs = int(num)
                        jidx.append(i)
                    elif num:
                        break                      # not a form we understand: leave the token alone
                    elif nxt is not None and nxt.isdigit():
                        jobs = int(nxt)
                        jidx += [i, i + 1]
                        i += 1
                    else:
                        jobs = INF
                        jidx.append(i)
                    break
                if c in ("l", "O"):               # optional attached/next numeric argument
                    if not a[k + 1:] and c == "l" and nxt is not None and re.fullmatch(r"[0-9.]+", nxt):
                        i += 1
                    break
                if c not in NOARG:
                    break
                k += 1
        i += 1
    return jobs, files, dirs, jidx


def makeflags_jobs(mf):
    """effective parallelism inherited through MAKEFLAGS: N, INF (bare -j or a jobserver), or None"""
    if not mf:
        return None
    words = mf.split(" -- ")[0].split()
    if words and not words[0].startswith("-") and "=" not in words[0]:
        words[0] = "-" + words[0]                   # first word = bundled single-letter flags without a dash
    jobs = None
    for w in words:
        m = re.fullmatch(r"-[a-zA-Z]*j(\d*)", w)
        if m and not w.startswith("--"):
            jobs = int(m[1]) if m[1] else INF
        elif w == "--jobs" or w.startswith("--jobs="):
            v = w.partition("=")[2]
            jobs = int(v) if v.isdigit() else INF
    if jobs is None and re.search(r"--jobserver-(auth|fds)=", mf):
        jobs = INF
    return jobs


def strip_j(args, jidx):
    """args without the -j tokens; a bundled '-kj8' keeps '-k'"""
    out = []
    for i, a in enumerate(args):
        if i not in jidx:
            out.append(a)
            continue
        if a.startswith("--") or a.isdigit():
            continue
        m = re.fullmatch(r"-([a-zA-Z]*?)j\d*", a)
        if m and m[1]:
            out.append("-" + m[1])
    return out


def is_verilator_make(args, cwd):
    _, files, dirs, _ = parse_make(args)
    d = cwd
    for x in dirs:
        d = os.path.join(d, x)
    for f in files:
        p = os.path.join(d, f)
        stem = os.path.basename(p)[:-3] if p.endswith(".mk") else None
        if stem is None:
            continue
        if os.path.exists(os.path.join(os.path.dirname(p), stem + "_classes.mk")):
            return True
        if re.fullmatch(r"V\w+", stem) and not stem.endswith("_classes"):
            return True
    if not files:
        return bool(glob.glob(os.path.join(glob.escape(d), "*_classes.mk")))
    return False


def decide(args, cwd, env):
    """(new_args or None, message or None) for a make argv under the armed cap"""
    if env.get("OT_VL_JCAP", "1") == "0":
        return None, None
    try:
        cap = int(env.get("OT_VL_JCAP_N", ""))
    except ValueError:
        return None, None
    if cap < 1 or not is_verilator_make(args, cwd):
        return None, None
    jobs, _, _, jidx = parse_make(args)
    src = "argv"
    if jobs is None:
        jobs, src = makeflags_jobs(env.get("MAKEFLAGS", "")), "MAKEFLAGS"
    if jobs is None or jobs <= cap:
        return None, None
    asked = "-j" if jobs >= INF else f"-j{jobs}"
    why = env.get("OT_VL_JCAP_WHY", "")
    msg = f"ot-heavy: verilator build {asked}{'' if src == 'argv' else ' (from ' + src + ')'} capped to -j{cap}" + \
          (f" ({why})" if why else "")
    return ["-j" + str(cap)] + strip_j(args, jidx), msg


def real_make(env_path, self_dirs):
    for d in env_path.split(os.pathsep):
        if not d:
            continue
        try:
            if os.path.realpath(d) in self_dirs:
                continue
        except OSError:
            continue
        p = os.path.join(d, "make")
        if os.path.isfile(p) and os.access(p, os.X_OK) and os.path.realpath(p) != os.path.realpath(__file__):
            return p
    return "/usr/bin/make"


def shim_main(argv):
    args = argv[1:]
    here = os.path.dirname(os.path.abspath(argv[0])) if os.sep in argv[0] else None
    self_dirs = {os.path.realpath(SHIM_DIR)} | ({os.path.realpath(here)} if here else set())
    extra = os.environ.get("OT_VL_JCAP_SHIM_DIR")
    if extra:
        self_dirs.add(os.path.realpath(extra))
    real = real_make(os.environ.get("PATH", ""), self_dirs)
    new = None
    try:
        new, msg = decide(args, os.getcwd(), os.environ)
        if msg:
            sys.stderr.write(msg + "\n")
            sys.stderr.flush()
    except Exception:
        new = None
    os.execv(real, ["make"] + (new if new is not None else args))


# ---------------------------------------------------------------- ot-heavy side
def unwrap(argv):
    a = list(argv)
    while a:
        b = os.path.basename(a[0])
        if b in ("env", "nice", "stdbuf", "nohup", "setsid") or ("=" in a[0] and not a[0].startswith("/")):
            a = a[1:]
        elif b in ("time", "timeout"):
            a = a[1:]
            while a and (a[0].startswith("-") or re.fullmatch(r"\d+[smh]?", a[0])):
                a = a[1:]
        else:
            break
    return a


def verilator_build_jobs(argv):
    """requested build jobs when the top-level command is `verilator ... --build`, else None (0 = all cores)"""
    a = unwrap(argv)
    if not a or not os.path.basename(a[0]).startswith("verilator") or "--build" not in a:
        return None
    jobs = 1
    for i, x in enumerate(a):
        nxt = a[i + 1] if i + 1 < len(a) else ""
        if x in ("-j", "--build-jobs", "-build-jobs"):
            jobs = int(nxt) if nxt.isdigit() else 0
        elif re.fullmatch(r"-j\d+", x):
            jobs = int(x[2:])
    for i, x in enumerate(a):            # --build-jobs wins over -j for the build
        nxt = a[i + 1] if i + 1 < len(a) else ""
        if x in ("--build-jobs", "-build-jobs"):
            jobs = int(nxt) if nxt.isdigit() else 0
    return jobs


def env_lines(mem, argv, peak=None, ncpu=None):
    """the shell lines ot-heavy evals (and the stderr note); '' when opted out"""
    if os.environ.get("OT_VL_JCAP", "1") == "0":
        return "", None
    per = per_job_gb(peak)
    cap = cap_for(mem, per)
    src = f"class peak {fmt_gb(peak)} GB" if peak and peak > 0 and per < conf_per_gb() else f"{fmt_gb(per)} GB per cc1plus"
    why = f"{fmt_gb(float(mem))} GB / {fmt_gb(per)} GB per cc1plus" + (f", {src}" if "class" in src else "")
    note = None
    vj = verilator_build_jobs(argv)
    if vj is not None:
        asked = vj if vj > 0 else (ncpu or os.cpu_count() or INF)
        if asked > cap:
            note = f"ot-heavy: verilator build -j{vj} capped to -j{cap} ({why}; applied to its make)"
    lines = [f"export OT_VL_JCAP_N={cap}", f"export OT_VL_JCAP_WHY={shlex.quote(why)}"]
    if os.path.isdir(SHIM_DIR):
        lines.append(f'export PATH={shlex.quote(SHIM_DIR)}:"$PATH"')
    return "\n".join(lines) + "\n", note


# ---------------------------------------------------------------- selftest
def selftest():
    import subprocess
    import tempfile
    n, bad = [0], []

    def ck(name, got, want):
        n[0] += 1
        if got != want:
            bad.append(f"{name}: got {got!r} want {want!r}")

    # cap arithmetic
    ck("64/30", cap_for(64, per_job_gb(None, 30)), 2)
    ck("96/30", cap_for(96, per_job_gb(None, 30)), 3)
    ck("20/30 floor 1", cap_for(20, per_job_gb(None, 30)), 1)
    ck("class peak 13", cap_for(64, per_job_gb(13.0, 30)), 4)
    ck("class peak 145 > default", cap_for(160, per_job_gb(144.8, 30)), 5)
    ck("class peak tiny floored", per_job_gb(0.5, 30), MIN_PER_GB)
    # make argv parsing
    ck("-j8", parse_make(["-j8", "-f", "Vtop.mk"])[0], 8)
    ck("-j 8", parse_make(["-j", "8"])[0], 8)
    ck("bare -j", parse_make(["-j", "all"])[0], INF)
    ck("--jobs=6", parse_make(["--jobs=6"])[0], 6)
    ck("-kj12", parse_make(["-kj12"])[0], 12)
    ck("-C obj -f V.mk", parse_make(["-C", "obj_dir", "-f", "Vt.mk"])[1:3], (["Vt.mk"], ["obj_dir"]))
    ck("-fVt.mk", parse_make(["-fVt.mk"])[1], ["Vt.mk"])
    ck("strip -kj12", strip_j(["-kj12", "all"], parse_make(["-kj12", "all"])[3]), ["-k", "all"])
    ck("MAKEFLAGS -j8 jobserver", makeflags_jobs(" -j8 --jobserver-auth=fifo:/tmp/x"), 8)
    ck("MAKEFLAGS jobserver only", makeflags_jobs("--jobserver-auth=3,4"), INF)
    ck("MAKEFLAGS k", makeflags_jobs("k"), None)
    ck("MAKEFLAGS kj", makeflags_jobs("kj -- X=1"), INF)
    ck("top verilator -j8 --build", verilator_build_jobs(["verilator", "--cc", "--build", "-j", "8", "t.v"]), 8)
    ck("top verilator --build-jobs 0", verilator_build_jobs(["env", "A=1", "verilator", "--build", "-j", "2", "--build-jobs", "0"]), 0)
    ck("top non-verilator", verilator_build_jobs(["python3", "x.py", "-j", "8"]), None)

    with tempfile.TemporaryDirectory() as t:
        obj = os.path.join(t, "obj_dir")
        os.makedirs(obj)
        for f in ("Vtop.mk", "Vtop_classes.mk"):
            open(os.path.join(obj, f), "w").close()
        other = os.path.join(t, "plain")
        os.makedirs(other)
        open(os.path.join(other, "Makefile"), "w").close()
        env = {"OT_VL_JCAP_N": "2", "OT_VL_JCAP_WHY": "64 GB / 30 GB per cc1plus"}
        # detection
        ck("detect -f Vtop.mk", is_verilator_make(["-f", "Vtop.mk"], obj), True)
        ck("detect -C obj_dir -f Vtop.mk", is_verilator_make(["-C", "obj_dir", "-f", "Vtop.mk"], t), True)
        ck("detect make inside obj_dir", is_verilator_make(["-j8"], obj), True)
        ck("detect -C obj_dir no -f", is_verilator_make(["-C", obj, "-j8"], t), True)
        ck("plain Makefile not verilator", is_verilator_make(["-j8"], other), False)
        ck("other .mk not verilator", is_verilator_make(["-f", "build.mk"], other), False)
        # decisions
        new, msg = decide(["-C", "obj_dir", "-f", "Vtop.mk", "-j", "8", "all"], t, env)
        ck("cap argv", new, ["-j2", "-C", "obj_dir", "-f", "Vtop.mk", "all"])
        ck("cap message", msg, "ot-heavy: verilator build -j8 capped to -j2 (64 GB / 30 GB per cc1plus)")
        ck("at cap unchanged", decide(["-f", "Vtop.mk", "-j2"], obj, env), (None, None))
        ck("serial unchanged", decide(["-f", "Vtop.mk"], obj, env), (None, None))
        ck("jobserver capped", decide(["-f", "Vtop.mk"], obj, dict(env, MAKEFLAGS=" -j16 --jobserver-auth=fifo:/x"))[0],
           ["-j2", "-f", "Vtop.mk"])
        ck("opt-out", decide(["-f", "Vtop.mk", "-j8"], obj, dict(env, OT_VL_JCAP="0")), (None, None))
        ck("unarmed", decide(["-f", "Vtop.mk", "-j8"], obj, {}), (None, None))
        ck("non-verilator make unchanged", decide(["-j8", "all"], other, env), (None, None))
        # ot-heavy side
        os.environ.pop("OT_VL_JCAP", None)
        lines, note = env_lines(64, ["verilator", "--cc", "--build", "-j", "8", "t.v"], peak=None)
        ck("env cap", "export OT_VL_JCAP_N=2" in lines, True)
        ck("env note", note, "ot-heavy: verilator build -j8 capped to -j2 (64 GB / 30 GB per cc1plus; applied to its make)")
        lines, note = env_lines(64, ["bash", "run.sh"], peak=13.0)
        ck("env class peak cap", "export OT_VL_JCAP_N=4" in lines, True)
        ck("env non-verilator no note", note, None)
        os.environ["OT_VL_JCAP"] = "0"
        ck("env opt-out", env_lines(64, ["verilator", "--build", "-j", "8"]), ("", None))
        del os.environ["OT_VL_JCAP"]

        # real exec through a fake make: argv must arrive rewritten / unchanged
        shim = os.path.join(t, "shim")
        realbin = os.path.join(t, "realbin")
        os.makedirs(shim)
        os.makedirs(realbin)
        os.symlink(os.path.abspath(__file__), os.path.join(shim, "make"))
        fake = os.path.join(realbin, "make")
        with open(fake, "w") as f:
            f.write('#!/bin/sh\necho "ARGS $*"\n')
        os.chmod(fake, 0o755)
        base = dict(os.environ, PATH=f"{shim}:{realbin}:/usr/bin:/bin", OT_VL_JCAP_SHIM_DIR=shim, **env)
        base.pop("MAKEFLAGS", None)

        def run(args, cwd, **kw):
            r = subprocess.run(["make"] + args, cwd=cwd, env=dict(base, **kw), capture_output=True, text=True)
            return r.returncode, r.stdout.strip(), r.stderr.strip()

        ck("exec capped", run(["-j8", "-f", "Vtop.mk"], obj),
           (0, "ARGS -j2 -f Vtop.mk", "ot-heavy: verilator build -j8 capped to -j2 (64 GB / 30 GB per cc1plus)"))
        ck("exec non-verilator unchanged", run(["-j8", "all"], other), (0, "ARGS -j8 all", ""))
        ck("exec opt-out unchanged", run(["-j8", "-f", "Vtop.mk"], obj, OT_VL_JCAP="0"), (0, "ARGS -j8 -f Vtop.mk", ""))
    print(f"ot-vl-jcap selftest: {'FAIL' if bad else 'PASS'} ({n[0]} checks)")
    for b in bad:
        print("  FAIL " + b)
    return 1 if bad else 0


def main(argv):
    if os.path.basename(argv[0]) == "make":
        shim_main(argv)
        return 0
    if argv[1:2] == ["--selftest"]:
        return selftest()
    if argv[1:2] == ["--env"] and len(argv) >= 4 and argv[3] == "--":
        mem, cmd = argv[2], argv[4:]
        try:
            float(mem)
        except ValueError:
            return 0
        lines, note = env_lines(mem, cmd, peak=class_peak(cmd))
        if note:
            sys.stderr.write(note + "\n")
        sys.stdout.write(lines)
        return 0
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
