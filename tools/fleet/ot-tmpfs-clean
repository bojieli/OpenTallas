#!/usr/bin/env python3
"""ot-tmpfs-clean (ADMIT-TUNE-1 11-14, COORD): a ROOT-MERGE-57 test ramdisk, /dev/shm/rm57, sat idle since 11-11/12 holding 240 GB of RAM on epyc8
(62 GB epyc9, 7 GB intel2): epyc8 MemAvailable fell to 48 GB and earlyoom SIGTERMed two openroad builds.  Hourly (root timer): remove top-level
DIRECTORIES of /dev/shm (and of /tmp when it is a tmpfs) that nothing wrote to for MAX_IDLE_S (24 h) and that no process uses (cwd, open file,
mapped file inside).  Each removal is logged to /var/tmp/ot-tmpfs-clean/log; removing more than STATE_GB (5 GB) in one run appends a STATE line
to the coordination queue on intel2 (best effort).
  ot-tmpfs-clean [--dry-run] [--max-idle-s N] [--root PATH ...]"""
import argparse, os, re, shutil, subprocess, sys, time

MAX_IDLE_S, STATE_GB = 24 * 3600, 5.0
LOG = "/var/tmp/ot-tmpfs-clean/log"
KEEP = re.compile(r"^(systemd-private-|snap[-.]|tmux-|ssh-|\.X11-unix|\.ICE-unix|\.font-unix|\.XIM-unix|\.Test-unix|hsperfdata_|dbus-|lost\+found|docker|containerd|pulse|user$|lock$|\.)")


def tmpfs_roots():
    roots = ["/dev/shm"]
    for ln in open("/proc/mounts"):
        f = ln.split()
        if len(f) > 2 and f[1] == "/tmp" and f[2] == "tmpfs":
            roots.append("/tmp")
    return roots


def newest_mtime(path):
    best = os.lstat(path).st_mtime
    for root, dirs, files in os.walk(path):
        for n in dirs + files:
            try:
                best = max(best, os.lstat(os.path.join(root, n)).st_mtime)
            except OSError:
                pass
    return best


def tree_size(path):
    tot = 0
    for root, dirs, files in os.walk(path):
        for n in files:
            try:
                tot += os.lstat(os.path.join(root, n)).st_size
            except OSError:
                pass
    return tot


def used_prefixes(paths, proc="/proc", budget_s=120.0):
    """the subset of paths (directories) that some process uses -- cwd, open file, or mapped file inside -- from ONE pass over /proc.  Past budget_s
    (a host with thousands of processes) every remaining path is reported as in use: fail closed."""
    prefixes = {p: os.path.realpath(p).rstrip("/") + "/" for p in paths}
    used, t0 = set(), time.time()
    for pid in os.listdir(proc):
        if not pid.isdigit():
            continue
        if time.time() - t0 > budget_s:
            return set(paths)
        cands = []
        try:                                  # QUEUED jobs hold no open file: a path named in any command line (an ot-heavy / ot-run waiter) counts as used
            text = open(f"{proc}/{pid}/cmdline").read().replace("\0", " ")
            for p in paths:
                if p not in used and p in text:
                    used.add(p)
        except OSError:
            pass
        try:
            cands.append(os.readlink(f"{proc}/{pid}/cwd"))
        except OSError:
            pass
        try:
            for fd in os.listdir(f"{proc}/{pid}/fd"):
                try:
                    cands.append(os.readlink(f"{proc}/{pid}/fd/{fd}"))
                except OSError:
                    pass
        except OSError:
            pass
        try:
            with open(f"{proc}/{pid}/maps") as fh:
                for ln in fh:
                    k = ln.find("/")
                    if k >= 0:
                        cands.append(ln[k:].strip())
        except OSError:
            pass
        for c in cands:
            c = c.replace(" (deleted)", "")
            for p, pre in prefixes.items():
                if p not in used and (c.rstrip("/") + "/").startswith(pre):
                    used.add(p)
        if len(used) == len(paths):
            break
    return used


def in_use(path, proc="/proc"):
    return path in used_prefixes([path], proc)


def named_in_units(path, dirs=("/etc/systemd/system", "/etc/systemd/user", "/run/systemd/transient", "/run/user")):
    """True when a systemd unit file (static or transient, system or user) mentions path"""
    for d in dirs:
        for root, _, files in os.walk(d):
            for n in files:
                if n.endswith((".service", ".timer", ".socket", ".mount", ".path")):
                    try:
                        if path in open(os.path.join(root, n), errors="replace").read():
                            return True
                    except OSError:
                        pass
    return False


def candidates(roots, now, max_idle_s):
    """[(path, idle_s)] top-level directories older than max_idle_s that are not protected names"""
    out = []
    for r in roots:
        try:
            names = os.listdir(r)
        except OSError:
            continue
        for n in names:
            p = os.path.join(r, n)
            if KEEP.match(n) or os.path.islink(p) or not os.path.isdir(p):
                continue
            try:
                idle = now - newest_mtime(p)
            except OSError:
                continue
            if idle >= max_idle_s:
                out.append((p, idle))
    return out


def post_state(msg):
    line = f"- {time.strftime('%F %H:%M')} PST STATE ADMIT-TUNE-1 TMPFS-CLEAN {os.uname().nodename}: {msg}"
    cmd = f"cd ~/coord && printf '%s\\n' {subprocess.list2cmdline([line])} >> lanes/COORD-REVIEW-QUEUE.md && bash bin/coord-commit.sh 'tmpfs-clean state' lanes/COORD-REVIEW-QUEUE.md >/dev/null 2>&1"
    try:
        if os.uname().nodename == "tolerant-swine":
            subprocess.run(["bash", "-c", cmd], timeout=120)
        else:
            subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "intel2", cmd], timeout=120)
    except (OSError, subprocess.SubprocessError):
        pass


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--max-idle-s", type=float, default=MAX_IDLE_S)
    ap.add_argument("--root", nargs="*")
    a = ap.parse_args(argv)
    now, freed, n = time.time(), 0, 0
    cands = candidates(a.root or tmpfs_roots(), now, a.max_idle_s)
    busy = used_prefixes([p for p, _ in cands]) if cands else set()
    for p, idle in cands:
        if p in busy or named_in_units(p):
            continue
        sz = tree_size(p)
        line = f"{time.strftime('%F %T')} {'WOULD REMOVE' if a.dry_run else 'REMOVED'} {p} {sz / 2**30:.2f} GB idle {idle / 3600:.0f} h"
        if not a.dry_run:
            shutil.rmtree(p, ignore_errors=True)
            os.makedirs(os.path.dirname(LOG), exist_ok=True)
            open(LOG, "a").write(line + "\n")
        print(line)
        freed += sz
        n += 1
    print(f"ot-tmpfs-clean: {n} director{'y' if n == 1 else 'ies'}, {freed / 2**30:.2f} GB")
    if not a.dry_run and freed > STATE_GB * 2**30:
        post_state(f"removed {n} idle tmpfs dir(s), {freed / 2**30:.1f} GB RAM freed (see /var/tmp/ot-tmpfs-clean/log)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
