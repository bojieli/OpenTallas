#!/bin/bash
# ot-docker (FLEET-OPS-R, COORD 11-17): installed as /usr/local/bin/docker (sudo's secure_path finds it first).  Flow images are PINNED and NEVER PULLED:
#  * `docker run|create ...` that names a pinned image: adds --pull=never (unless the caller named a --pull policy) and rewrites an argument that is exactly a pinned NAME
#    (tools/fleet/flow_images.txt `pin NAME ID`, e.g. openroad/orfs:latest or the bare openroad/orfs) to its image ID.  A host without that id fails at once
#    ("No such image") instead of pulling a newer upstream image into a running flow.
#  * `docker pull NAME` of a flow image (openroad/orfs*, opentallas/orfs*, verilator/verilator*) is refused: load it from a host that has it
#    (docker save | ssh HOST docker load).  OT_DOCKER_ALLOW_PULL=1 overrides for a deliberate update.
# Every other command, and every run/create that names no pinned image, goes to the real docker with the arguments unchanged.  OT_REAL_DOCKER = the real binary (default /usr/bin/docker).
REAL=${OT_REAL_DOCKER:-/usr/bin/docker}
PINS=${OT_DOCKER_PINS:-/srv/opentallas-scratch2/claude/rt/current/tools/fleet/flow_images.txt}
sub=""; for a in "$@"; do case "$a" in -*) ;; *) sub=$a; break;; esac; done
case "$sub" in
  pull)
    if [ "${OT_DOCKER_ALLOW_PULL:-}" != 1 ]; then
      for a in "$@"; do case "$a" in openroad/orfs*|opentallas/orfs*|verilator/verilator*) echo "ot-docker: REFUSED: flow images are never pulled ($a): docker save on a host that has it | ssh HOST docker load" >&2; exit 78;; esac; done
    fi;;
  run|create)
    declare -A PIN
    if [ -r "$PINS" ]; then while read -r k n i _; do [ "$k" = pin ] && PIN[$n]=$i; done < "$PINS"; fi
    # only a command that names a PINNED image is touched; every other docker run/create (the owner's non-OpenTallas work) is passed through byte for byte
    hit=0; haspull=0
    for a in "$@"; do [ -n "${PIN[$a]:-}" ] && hit=1; case "$a" in --pull|--pull=*) haspull=1;; esac; done
    if [ $hit = 1 ]; then
      out=(); seen=0
      for a in "$@"; do
        if [ -n "${PIN[$a]:-}" ]; then out+=("${PIN[$a]}"); else out+=("$a"); fi
        if [ $seen = 0 ] && [ "$a" = "$sub" ]; then seen=1; [ $haspull = 0 ] && out+=("--pull=never"); fi
      done
      exec "$REAL" "${out[@]}"
    fi;;
esac
exec "$REAL" "$@"
