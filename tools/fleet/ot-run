# dir-aware by default ("*"), so the root floor refuses only a job whose --dir / job root is ON the root fs; a job on a
# separate scratch disk meets that disk's own floor (SCRATCH_DISK_FLOOR_GB).  intel1 was refused 11-10 05:25 with
# scratch2 at 109 GB because the root floor was read against it.  A host list in the env narrows it again.
ROOTFS_DIR_AWARE_HOSTS = set(x.strip() for x in os.environ.get("OT_RUN_ROOTFS_DIR_AWARE_HOSTS", "*").split(",") if x.strip())


def dir_aware(host):
    return "*" in ROOTFS_DIR_AWARE_HOSTS or host in ROOTFS_DIR_AWARE_HOSTS


def host_refusal(row):
    """v13 (FLEET-DISK 2026-10-24): why this host admits no new job, or '' -- root fs > ROOTFS_MAX_PCT % full, or its
    separate scratch disk below SCRATCH_DISK_FLOOR_GB (the root fs is never the fallback).  Rows of older probes: ''."""
    if not isinstance(row, dict):
        return ""
    if row.get("disk_refusal"):
        return row["disk_refusal"]
    pct = row.get("rootfs_pct")
    lim = ROOTFS_MAX_PCT_SCRATCH if row.get("scratch_disk") else ROOTFS_MAX_PCT
    if row.get("scratch_second") and row.get("scratch_disk_gb", 0) < SCRATCH_SECOND_FLOOR_GB:
        return (f"second scratch root {row['scratch_disk']} (root fs) has {row['scratch_disk_gb']} GB usable < floor "
                f"{SCRATCH_SECOND_FLOOR_GB} GB after keeping {row.get('root_floor_gb', ROOT_SCRATCH_FLOOR_GB)} GB free on the root fs (ROOTSCR_1101)")
    fl = row.get("rootfs_floor_gb")
    # KW-FIX-44 11-09 COORD loopgap-181x (A): the free-GB root guard refuses a job only when its --dir / job root is ON the
    # root fs; a job whose dir is on the host's separate scratch disk writes nothing to root and is admitted (the owner's
    # 150 GB floor still protects root).  Hosts in OT_RUN_ROOTFS_DIR_AWARE_HOSTS (epyc4, epyc7: scratch2 is its own device).
    dir_off_root = (row.get("dir_onroot") is False and row.get("scratch_disk") and not row.get("scratch_second")
                    and dir_aware(row.get("host_name")))
    if fl is not None and row.get("rootfs_free_gb") is not None and not dir_off_root:     # DISK-URGENT-4: free GB, not %
        if row["rootfs_free_gb"] < fl:
            return (f"ROOT FS {row['rootfs_free_gb']} GB free < floor {fl} GB (DISK GUARD, owner floor 150 GB 11-06; "
                    f"free the root fs, OT_RUN_ROOTFS_MIN_FREE_GB_HOSTS overrides)")
    elif pct is not None and pct > lim and not dir_off_root:
        return (f"ROOT FS {pct}% full > {lim}% (DISK GUARD, owner 2026-10-24: never use root disks for work; "
                f"move data to the scratch disk, OT_RUN_ROOTFS_MAX_PCT overrides)")
    fl = row.get("scratch_floor_gb", SCRATCH_DISK_FLOOR_GB)
    if row.get("scratch_disk") and not row.get("scratch_second") and row.get("scratch_disk_gb", 0) < fl:
        return (f"scratch disk {row['scratch_disk']} has {row['scratch_disk_gb']} GB free < floor {fl} GB "
                f"(the root fs is never a fallback; free the scratch disk, OT_RUN_SCRATCH_DISK_FLOOR_GB overrides)")
    return ""


