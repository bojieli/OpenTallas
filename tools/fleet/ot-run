    state = dict(started=False, rc=None, nocd=False, unit="?", refused=None, connfail=False)
    LAST_RUN["connfail"] = False
    unblock = lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK, SIGS)

    def stop(sig, who):
        log_signal(f"signal {sig} from {who} -> ot-run pid {os.getpid()} host {host} tag {tag} "
                   f"{'STARTED unit ' + state['unit'] if state['started'] else 'WAITING'} dir {d}: {' '.join(cmd)[:200]}")
        if state["started"]:
            say(f"ot-run: interrupted (signal {sig} from {who}); the command is STILL RUNNING on {host} (unit {state['unit']}): NOT COMPLETED")
        else:      # cancel the waiter, or it would start the command later with nobody listening
            subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", host,
                            f"pkill -TERM -f -- '[-]-tag {tag} '"], capture_output=True, timeout=40, preexec_fn=unblock)
            say(f"ot-run: interrupted (signal {sig} from {who}); cancellation requested on {host}: START STATE UNKNOWN; verify canonical remote unit/payload before any successor")
        p.kill()
        os._exit(128 + sig)

