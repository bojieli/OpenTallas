def retryable_queued_probe_failures(first, previously_qualified, notes):
    """Only known transport loss may keep an already-unstarted request queued."""
    if first:
        return []
    transport = re.compile(r"kex_exchange_identification|Connection (?:reset|closed|timed out)|timed out after|SSH probe returned no admission JSON", re.I)
    return [h for h in previously_qualified if transport.search(notes.get(h, ""))]


def probe(host, d, spill_ok=False):
    """spill_ok=False: a --dir that is a SPILL copy (marker in its lane root) does not qualify (stale data)"""
    q = shlex.quote(d or "/")
    marks = " ".join(shlex.quote(a + "/" + SPILL_MARK) for a in mark_ancestors(d)) if d else "/nonexistent-ot-run-mark"
    # --dir carries source/build locality. A lane root or sibling run cannot stand in
    # for the exact working directory; SCRATCH2 may place NEW mkdir output dirs later.
    test = f"test -d {q} || {{ echo NODIR; exit 0; }}; t={q}; "
    cmd = test + ("" if spill_ok else f"for m in {marks}; do test -e $m && {{ echo NODIR; exit 0; }}; done; ") + SCRATCH_FREE_SH \
        + LOADCAP_SH + "/usr/local/bin/ot-heavy-reconcile --free $t"
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", host, cmd], capture_output=True,
                           text=True, timeout=40)
        if r.returncode:
            return host, {"error": f"SSH probe exit {r.returncode}: {r.stderr.strip()[-160:]}"}
        if "NODIR" in r.stdout:
            return host, None
        lines = r.stdout.strip().splitlines()
        if not lines:
            return host, {"error": "SSH probe returned no admission JSON"}
        row = json.loads(lines[-1])
        lc = loadcap_of(r.stdout)
        if lc is not None and isinstance(row, dict):
            row["load_cap_factor"] = lc
        return host, scratch_disk(row, d, r.stdout, host)
    except Exception as e:
        return host, {"error": str(e)[:80]}


