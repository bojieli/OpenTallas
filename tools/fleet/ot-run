def memory_charge_note(row):
    """Separate the owner's growth reserve from fresh-start and observed-peak gaps."""
    terms = row.get("inv_terms")
    if isinstance(terms, dict) and all(k in terms for k in ("reserve", "fresh", "peak_gap")):
        return f"reserve {terms['reserve']:g}, fresh {terms['fresh']:g}, peak {terms['peak_gap']:g}"
    return f"growth {row['growth_gb']}"


def status(hosts):
    """one line an agent can read before choosing where to launch: memory nobody has claimed, per host"""
    held = held_hosts() if not os.environ.get("OT_RUN_INCLUDE_HELD") else {}
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, None), hosts))
    out = []
    for h in hosts:
        if h in held:
            out.append(f"{h} HELD ({held[h]})")
            continue
        r = res[h]
        if not r or r.get("error"):
            out.append(f"{h} unreachable")
            continue
        if host_refusal(r):
            out.append(f"{h} REFUSED ({host_refusal(r)})")
            continue
        out.append(f"{h} admits {r.get('admit_gb', r['free_gb'])} GB (avail {r['avail_gb']}, {memory_charge_note(r)}) load "
                   f"{load1(r):.0f}/{r.get('ncpu', 0)}" + (f" waiters {r['waiting']}:{r['waiting_gb']} GB" if r["waiting"] else "")
                   + f" run {r['running']}" + (f" root {r['rootfs_pct']}%" if "rootfs_pct" in r else "")
                   + (f" scratch {r['scratch_disk_gb']} GB" if "scratch_disk" in r else ""))
    live = {h: r for h, r in res.items() if h not in held and r and not r.get("error") and r.get("ncpu")
            and r["disk_gb"] >= 20 and physically_capable(r, 32) and not host_refusal(r)}
    best, queue = choose(live, 32)
    next_job = (f" | next 16-thread 32 GB job -> {best}" + (" (would queue)" if queue else "")) if best else " | next 16-thread 32 GB job: no eligible host"
    print("ot-run status: " + " | ".join(out) + next_job)


SIGS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
SIGNAL_LOG = os.path.expanduser("~/.local/state/ot-run/signals.log")


def proc_args(pid):
    try:
        return [x.decode(errors="replace") for x in open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0") if x]
    except OSError:
        return []


def sender(pid):
    """who sent the signal: pid + command line (the culprit of a cross-lane pattern kill)"""
    try:
        pp = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        par = f"; parent {pp} ({' '.join(proc_args(pp))[-300:]})"
    except (OSError, ValueError, IndexError):
        par = ""
    return f"pid {pid} ({' '.join(proc_args(pid))[:300] or 'exited'}{par})"


def log_signal(line):
    try:
        os.makedirs(os.path.dirname(SIGNAL_LOG), exist_ok=True)
        with open(SIGNAL_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + line + "\n")
    except OSError:
        pass


def clients():
    """local ot-run job clients: pid -> (args after ot-run, --dir or None)"""
    out = {}
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == os.getpid():
            continue
        a = proc_args(p)
        i = next((k for k, x in enumerate(a[:3]) if os.path.basename(x) == "ot-run"), None)
        if i is None or "--" not in a or "--cancel" in a[i + 1:i + 2]:
            continue
        rest = a[i + 1:]
        opts = rest[:rest.index("--")]
        out[int(p)] = (rest, opts[opts.index("--dir") + 1] if "--dir" in opts[:-1] else None)
    return out


def cancel(sub, all_dirs):
    hit = {p: v for p, v in clients().items() if sub in " ".join(v[0])}
    dirs = sorted({str(v[1]) for v in hit.values()})
    for p, (rest, d) in sorted(hit.items()):
        print(f"ot-run --cancel: pid {p} dir {d}: {' '.join(rest)[:200]}")
    if not hit:
        print(f"ot-run --cancel: no local ot-run client matches {sub!r}")
        return 1
    if len(dirs) > 1 and not all_dirs:
        print(f"ot-run --cancel: REFUSED: {sub!r} matches {len(hit)} clients in {len(dirs)} different --dir values "
              f"({', '.join(dirs)[:400]}); other lanes' jobs would die.  Use a substring unique to your job (its --dir or "
              f"script path), kill your exact pid, or pass --all-dirs after reading the list.  Nothing killed.")
        return 2
    for p in hit:
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    print(f"ot-run --cancel: SIGTERM sent to {len(hit)} client(s); waiters are cancelled on their hosts, started commands keep running")
    log_signal(f"--cancel {sub!r} by pid {os.getpid()} parent {sender(os.getppid())}: {sorted(hit)}")
    return 0


# OT_SCRATCH (FLEET-NEW2 2026-10-19, coordinator: EPYC4/5 have two 2.9 TB scratch volumes; EPYC5's scratch2 sat empty
# while scratch was at 47 %, EPYC4's scratch at 79 % vs scratch2 36 %): every job gets OT_SCRATCH = the
# /srv/opentallas-scratch* mount with the most free space on its host.  New job / lane / die-chain directories belong
# under $OT_SCRATCH/claude/<lane>; existing directories stay where they are (never move a live job dir).
# v13 SCRATCH-DISK (FLEET-DISK 2026-10-24): roots whose claude/ is on the ROOT fs are skipped whenever another root is
# on a separate disk (intel1/intel2/epyc2: always /srv/opentallas-scratch2, even when the root fs has more free space);
# hosts with only the root fs (localhost/epyc3 md0) keep the most-free rule.
SCRATCH_ENV = ("export OT_SCRATCH=$(rd=$(stat -c %d /); for r in /srv/opentallas-scratch /srv/opentallas-scratch2; do "
               "test -d $r/claude || continue; o=0; [ \"$(stat -L -c %d $r/claude)\" = \"$rd\" ] && o=1; "
               "echo $o $(df -BG --output=avail $r/claude/ | tail -1 | tr -dc 0-9) $r; done | "
               "awk '{k[NR]=$0; if ($1==0) d=1} END {for (i in k) {split(k[i],f,\" \"); if (!d || f[1]==0) print f[2], f[3]}}' "
               "| sort -n | tail -1 | awk '{print $2}'); OT_SCRATCH=${OT_SCRATCH:-/srv/opentallas-scratch}; ")
# v13 DISK GUARD on the job host (the client checked the probe; this re-checks at submission, so a stale probe or an
# old client cannot start work on a full root fs, nor on a scratch-disk host whose disk is below its floor).
def disk_guard_sh(tag):
    return (f"p=$(df --output=pcent / | tail -1 | tr -dc 0-9); if [ \"${{p:-0}}\" -gt {ROOTFS_MAX_PCT} ]; then "
            f"echo \"ot-run: DISK GUARD: root fs $p% full > {ROOTFS_MAX_PCT}% on $(hostname -s); no new job admitted "
            f"(owner 2026-10-24: never use root disks for work)\" >&2; echo OT_RUN_ROOTFULL {tag} >&2; exit 97; fi; "
            f"if sd=$(stat -L -c %d \"$OT_SCRATCH/claude\" 2>/dev/null) && [ \"$sd\" != \"$(stat -c %d /)\" ]; then "
            f"f=$(df -BG --output=avail $OT_SCRATCH/claude/ | tail -1 | tr -dc 0-9); if [ \"${{f:-0}}\" -lt {SCRATCH_DISK_FLOOR_GB} ]; then "
            f"echo \"ot-run: scratch disk $OT_SCRATCH has ${{f}} GB free < floor {SCRATCH_DISK_FLOOR_GB} GB on $(hostname -s); "
            f"the root fs is never a fallback\" >&2; echo OT_RUN_SCRATCHLOW {tag} >&2; exit 98; fi; fi; ")


