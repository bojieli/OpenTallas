def spill_is_eco(cmd):
    """a --stage job that runs an ECO (eco_loop or an eco dir in its command)"""
    return bool(STAGE) and bool(SPILL_ECO_RE.search(" ".join(cmd or ())))


def spill_dst_full(host, row, roots=(), cmd=()):
    """the disk a spill of these lane roots would write on host is below its floor"""
    if not isinstance(row, dict):
        return False
    floor = SPILL_DST_ROOT_FLOOR.get(host)
    if floor is not None and "rootfs_free_gb" in row and row["rootfs_free_gb"] < floor:
        if not roots or spill_lands_on_root(host, roots):
            return True
    floor = SPILL_DST_SCRATCH_FLOOR.get(host)
    if spill_is_eco(cmd):
        floor = SPILL_DST_SCRATCH_FLOOR_ECO.get(host, floor)
    return floor is not None and "scratch_disk_gb" in row and row["scratch_disk_gb"] < floor


def spill_lands_on_root(host, roots):
    """any lane root (/srv/opentallas-scratch*/claude/<lane>) that resolves to the host's root fs; unknown = True"""
    lanes = sorted({m.group(1) if (m := SCRATCH_RE.match(r)) else r for r in roots})
    q = " ".join(shlex.quote(x) for x in lanes)
    try:
        r = ssh_sh(host, f"rd=$(stat -c %d /); for l in {q}; do p=$l; [ -e $p ] || p=$(dirname $p); "
                         f"[ \"$(stat -L -c %d $p)\" = \"$rd\" ] && echo ONROOT; done; echo OK", timeout=30)
        return r.returncode != 0 or "OK" not in r.stdout or "ONROOT" in r.stdout
    except Exception:
        return True
NO_AVX512 = {"epyc2", "epyc7", "epyc8", "epyc9", "ot-epyc7", "ot-epyc9"}                         # Zen 3: a -march=native build from Zen 4/5 would SIGILL there
SCRATCH_RE = re.compile(r"^(/srv/opentallas-scratch[^/]*/claude/[^/]+)(/|$)")


def load_spill_wanted(r, threads):
    """v11: a CPU-heavy job whose best --dir host would be past LOAD_SPILL_RATIO x cores"""
    return (not os.environ.get("OT_RUN_NO_LOAD_SPILL") and threads >= LOAD_SPILL_MIN_THREADS
            and ratio(r, threads) > LOAD_SPILL_RATIO)


def load_spill_neg(root, why=None):
    """v11 negative cache: why=None -> True when root was found unspillable in the last LOAD_SPILL_NEG_S; else record it"""
    f = os.path.join(LOAD_SPILL_NEG, re.sub(r"[^A-Za-z0-9_.+-]", "_", root.strip("/")))
    if why is None:
        try:
            return time.time() - os.path.getmtime(f) < LOAD_SPILL_NEG_S
        except OSError:
            return False
    try:
        os.makedirs(LOAD_SPILL_NEG, exist_ok=True)
        open(f, "w").write(why + "\n")
    except OSError:
        pass
    return True


STAGE = []   # v14 --stage: the job's exact input paths (absolute, normalised); empty = lane-root SPILL as before


def mark_ancestors(d):
    """v14: d and its ancestors up to its lane root (just the lane root when d is not inside one; d itself when it is
    not under a scratch lane) -- a SPILL / STAGE marker in any of them makes d a copy"""
    d = os.path.normpath(d)
    root = spill_root(d)
    if root == d or not d.startswith(root + "/"):
        return [root]
    out, a = [], d
    while a != root:
        out.append(a)
        a = os.path.dirname(a)
    return out + [root]


def under(p, roots):
    p = os.path.normpath(p)
    return any(p == r or p.startswith(r.rstrip("/") + "/") for r in roots)


def spill_root(d):
    """the unit a spill copies: the lane directory under a scratch root's claude/, else --dir itself"""
    d = os.path.normpath(d)
    m = SCRATCH_RE.match(d)
    return m.group(1) if m else d


def ssh_sh(host, cmd, timeout=120):
    return subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", host, cmd],
                          capture_output=True, text=True, timeout=timeout)


SHARED_LANES = {"git-mirror", "flowhold", "ttbatch", "ttviews"}   # provisioned on every host: never copied
LANE_RE = re.compile(r"/srv/opentallas-scratch[^/\s'\";|&()<>]*/claude/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*")


def command_srv_paths(cmd):
    """Host paths, recognizing only Docker run/create volume flags before its image.

    A Docker bind argument is host:container[:mode], not one host filename. Never
    split arbitrary colon paths, other commands, or the container command after the
    image. Compound shell scripts keep the original conservative path scan.
    """
    args = list(cmd)
    if len(args) == 3 and os.path.basename(args[0]) in ("bash", "sh") and args[1] in ("-c", "-lc", "-ec", "-euc"):
        if not any(c in args[2] for c in ";&|\n"):
            try:
                args = shlex.split(args[2])
            except ValueError:
                pass
    start = 0
    if args[:1] == ["sudo"]:
        start = 2 if args[1:2] == ["-n"] else 1
    if args[start:start+1] == ["exec"]:
        start += 1
    is_docker = (len(args) > start+1 and os.path.basename(args[start]) == "docker"
                 and args[start+1] in ("run", "create"))
    if is_docker:
        modes = {"ro", "rw", "z", "Z", "cached", "delegated", "consistent", "private", "rprivate",
                 "shared", "rshared", "slave", "rslave", "nocopy"}
        values = {"--cpus", "--memory", "--memory-swap", "--name", "--entrypoint", "--user", "-u",
                  "--workdir", "-w", "--env", "-e", "--env-file", "--network", "--hostname", "-h",
                  "--label", "-l", "--gpus", "--device", "--shm-size", "--ulimit"}
        flags = {"--rm", "--init", "--privileged", "--read-only", "--detach", "-d", "--interactive",
                 "--tty", "-i", "-t", "-it", "-ti"}
        i = start+2
        while i < len(args):
            a = args[i]
            if a in ("-v", "--volume") and i+1 < len(args):
                at, prefix = i+1, ""
                step = 2
            elif a.startswith("--volume="):
                at, prefix, step = i, "--volume=", 1
            elif a.startswith("-v") and len(a) > 2:
                at, prefix, step = i, "-v", 1
            elif a in values:
                i += 2
                continue
            elif a in flags or (a.startswith("--") and "=" in a):
                i += 1
                continue
            else:
                break  # image, --, or an unknown option: never guess its arity
            spec = args[at][len(prefix):]
            parts = spec.split(":")
            if (len(parts) in (2, 3) and parts[0].startswith("/") and parts[1].startswith("/")
                    and (len(parts) == 2 or (parts[2] and set(parts[2].split(",")) <= modes))):
                args[at] = prefix + parts[0]
            i += step
    return re.findall(r"/srv/[^\s'\";|&()<>]*", " ".join(args))


def ro_source_binds(cmd):
    """Mount git source trees read-only: a `docker run/create -v <host>:<target>` with no mode whose host path is the root of
    a checkout gets :ro, so a root container cannot write through hard-linked source files (STORE-1 test 11-08).
    Only the root of a checkout, never a directory below it (a kit dir inside a lane repo stays writable); an explicit mode
    stays as given; compound shell scripts are left alone.  Applies to `docker` run directly or through one `bash -c`."""
    args, shell = list(cmd), None
    if len(args) == 3 and os.path.basename(args[0]) in ("bash", "sh") and args[1] in ("-c", "-lc", "-ec", "-euc"):
        if any(c in args[2] for c in ";&|\n"):
            return list(cmd)
        try:
            args, shell = shlex.split(args[2]), args[:2]
        except ValueError:
            return list(cmd)
    start = 0
    if args[:1] == ["sudo"]:
        start = 2 if args[1:2] == ["-n"] else 1
    if args[start:start+1] == ["exec"]:
        start += 1
    if not (len(args) > start+1 and os.path.basename(args[start]) == "docker" and args[start+1] in ("run", "create")):
        return list(cmd)
    i, changed = start+2, False
    values = {"--cpus", "--memory", "--memory-swap", "--name", "--entrypoint", "--user", "-u", "--workdir", "-w", "--env", "-e",
              "--env-file", "--network", "--hostname", "-h", "--label", "-l", "--gpus", "--device", "--shm-size", "--ulimit"}
    flags = {"--rm", "--init", "--privileged", "--read-only", "--detach", "-d", "--interactive", "--tty", "-i", "-t", "-it", "-ti"}
    while i < len(args):
        a = args[i]
        if a in ("-v", "--volume") and i+1 < len(args):
            at, prefix, step = i+1, "", 2
        elif a.startswith("--volume="):
            at, prefix, step = i, "--volume=", 1
        elif a.startswith("-v") and len(a) > 2:
            at, prefix, step = i, "-v", 1
        elif a in values:
            i += 2
            continue
        elif a in flags or (a.startswith("--") and "=" in a):
            i += 1
            continue
        else:
            break
        parts = args[at][len(prefix):].split(":")
        if len(parts) == 2 and parts[0].startswith("/") and os.path.lexists(os.path.join(parts[0], ".git")):
            args[at] = args[at] + ":ro"
            changed = True
        i += step
    if not changed:
        return list(cmd)
    return shell + [shlex.join(args)] if shell else args


def spill_paths_ok(cmd, d, root):
    """-> (reason, extra lane roots).  /srv paths the command names must lie in a lane root (copied with it);
    '../' only when --dir is below its root"""
    j, extra = " ".join(cmd), set()
    for p in command_srv_paths(cmd):
        p = os.path.normpath(p)
        if p == root or p.startswith(root + "/"):
            continue
        m = SCRATCH_RE.match(p)
        if not m:
            return f"command names {p} outside a scratch lane", set()
        if m.group(1).rsplit("/", 1)[-1] not in SHARED_LANES:
            extra.add(m.group(1))
    if "../" in j and os.path.normpath(d) == root:
        return f"command uses ../ above {root}", set()
    return "", extra


def spill_scan(src, roots, strict=False):
    """one ssh: size, absolute symlinks out of the roots, -march=native, scratch lanes named by lane scripts (depth <= 2:
    lane scripts and filelists, not a repo clone under the lane)"""
    qs = " ".join(shlex.quote(r) for r in roots)
    inside = " ".join(f"! -lname {shlex.quote(r + '/*')}" for r in roots)
    scripts = (f"find {qs} -maxdepth 2 -size -2M -type f \\( -name 'Makefile*' -o -name '*.mk' -o -name '*.sh' -o -name '*.py' "
               f"-o -name '*.f' -o -name '*.tcl' -o -name '*.json' -o -name '*.yaml' -o -name '*.cfg' \\) -print0 | "
               f"timeout 90 xargs -0r grep -hoIs -E ")
    r = ssh_sh(src, f"for r in {qs}; do test -e $r || echo MISSING $r; done; du -scb {qs} | tail -1 | cut -f1; "
                    f"find {qs} -type l -lname '/*' {inside} -printf '%p\\t%l\\n' | head -50; echo ==; {scripts} 'march=native' | head -1; echo ==; "
                    f"{scripts} {shlex.quote(LANE_RE.pattern)} | sort -u | head -50", timeout=300)
    head, tail, ext = (r.stdout.split("==\n") + ["", ""])[:3]
    lines = [x for x in head.split("\n") if x.strip()]
    missing = [x.split(None, 1)[1] for x in lines if x.startswith("MISSING ")]
    lines = [x for x in lines if not x.startswith("MISSING ")]
    lanes = {SCRATCH_RE.match(x).group(1) for x in ext.split() if SCRATCH_RE.match(x)}
    lanes = {x for x in lanes if x.rsplit("/", 1)[-1] not in SHARED_LANES}
    sym = ""
    names = {r.rsplit("/", 1)[-1] for r in roots}
    for x in lines[1:]:          # v12 SCRATCH2: a symlink into the lane's twin root (same lane, other scratch root) adds it
        p, _, t = x.partition("\t")
        m = SCRATCH_RE.match(os.path.normpath(t)) if t else None
        if m and m.group(1).rsplit("/", 1)[-1] in names and not strict:
            lanes.add(m.group(1))
        elif not sym:
            sym = p
    return missing, int(lines[0]) / 1e9, sym, bool(tail.strip()), lanes


def spill_dest_rows(h, roots, bases):
    """KW-FIX-37 11-08 (COORD 18:49: epyc4 27 waiters while the hub had 250 GB of scratch): the copy lands at the lane's
    own path, and a host may keep that lane on another disk through a symlink (epyc5, hub).  Probing the bare scratch root
    measured the root fs there and refused the host.  Probe each lane that exists on h (spill copies of it count), else
    the scratch root as before."""
    lanes = sorted({spill_root(r) for r in roots if SCRATCH_RE.match(r)})
    rows = []
    for b in bases:
        got = [r for r in (probe(h, l, spill_ok=True)[1] for l in lanes if l.startswith(b + "/")) if r and not r.get("error")]
        rows += got or [probe(h, b)[1]]
    return rows


def spill_plan(src, d, cmd, mem, threads, die, disk, held, say, max_ratio=None):
    """-> ((dst, roots, size_gb), "", False) or (None, reason, permanent).  The roots are --dir's lane root plus every
    scratch lane the command or the lane's scripts name (closed under that relation, <= 4 lanes)"""
    if STAGE:                    # v14 STAGE: exactly the caller's paths, no lane-root closure
        if not under(d, STAGE):
            return None, f"--dir {d} is not inside a --stage path", True
        for p in command_srv_paths(cmd):
            m = SCRATCH_RE.match(os.path.normpath(p))
            if not under(p, STAGE) and not (m and m.group(1).rsplit("/", 1)[-1] in SHARED_LANES):
                return None, f"command names {p} outside the --stage paths", True
        roots = set(STAGE)
        try:
            r = ssh_sh(src, "for p in " + " ".join(shlex.quote(x) for x in STAGE) + "; do test -f $p && echo $p; done; true", timeout=60)
            STAGE_FILES.clear()
            STAGE_FILES.update(os.path.normpath(x) for x in r.stdout.split())
            missing, size_gb, sym, native, lanes = spill_scan(src, sorted(roots), strict=True)
        except Exception as e:
            return None, f"cannot scan {sorted(roots)} on {src}: {str(e)[:80]}", True
        try:
            if proof_away(src, STAGE):       # SPILL-PROOF-1: runs on src until the proof's verdict is back
                return None, "its proof still runs on another host (hand-off)", False
        except subprocess.SubprocessError as e:
            return None, f"cannot check {src} for a proof hand-off: {str(e)[:80]}", False
        other = sorted(x for x in lanes if not under(x, STAGE) and not any(under(r, [x]) for r in STAGE))
        if other:
            say(f"ot-run: STAGE: the staged scripts name other lane(s) {', '.join(other[:4])}; not copied (--stage says the inputs are complete)")
    else:
        root = spill_root(d)
        why, extra = spill_paths_ok(cmd, d, root)
        if why:
            return None, why, True
        roots = {root} | extra
        try:
            for _ in range(3):
                missing, size_gb, sym, native, lanes = spill_scan(src, sorted(roots))
                if lanes <= roots:
                    break
                roots |= lanes
            else:
                return None, f"lane references keep growing ({len(roots)} lanes)", True
        except Exception as e:
            return None, f"cannot scan {sorted(roots)} on {src}: {str(e)[:80]}", True
    if missing:
        return None, f"{src} lacks {', '.join(missing[:3])} (data not on the queue host)", True
    if len(roots) > 4 and not STAGE:
        return None, f"{len(roots)} lanes referenced ({', '.join(sorted(roots)[:5])})", True
    cap = SPILL_MAX_DIE_GB if die else SPILL_MAX_GB
    if size_gb > cap:
        return None, f"{', '.join(sorted(roots))} total {size_gb:.0f} GB > {'OT_RUN_SPILL_MAX_DIE_GB' if die else 'OT_RUN_SPILL_MAX_GB'} {cap}", True
    if sym:
        return None, f"absolute symlink out of the {'--stage path(s)' if STAGE else 'lane(s)'}: {sym[:120]}", True
    bases = sorted({r.rsplit("/claude/", 1)[0] if SCRATCH_RE.match(r) else os.path.dirname(r) for r in roots})
    cands = [h for h in HOSTS if h != src and h not in SPILL_HOSTS_EXCLUDE and h not in held
             and not (native and h in NO_AVX512)]
    if not cands:
        return None, "no spill host", False
    with cf.ThreadPoolExecutor(len(cands)) as ex:
        res = dict(ex.map(lambda h: (h, spill_dest_rows(h, roots, bases)), cands))
    ok = {h: rs[0] for h, rs in res.items() if all(r and not r.get("error") for r in rs) and rs[0].get("ncpu")
          and min(r["disk_gb"] for r in rs) >= disk + size_gb and physically_capable(rs[0], mem) and not host_refusal(rs[0])
          and not spill_dst_full(h, rs[0], roots, cmd)
          and (max_ratio is None or ratio(rs[0], threads) <= max_ratio)}
    noroom = []
    if ok:
        with cf.ThreadPoolExecutor(len(ok)) as ex:
            room = dict(ex.map(lambda h: (h, spill_room(h, sorted(roots), size_gb + disk, SPILL_ROOM_MARGIN_GB)), list(ok)))
        for h, (fits, why) in room.items():
            if fits is not True:                 # unknown is not room: another host, or the next re-place
                del ok[h]
                noroom.append(why)
    dst, queue = choose(drop_low_disk(ok, die, disk + size_gb), mem, threads, die)
    if not dst or queue:
        return None, ("no spill host has room: " + "; ".join(noroom)[:300]) if noroom and not ok else "no spill host admits it now", False
    return (dst, sorted(roots), size_gb), "", False


SPILL_PENDING = os.path.expanduser("~/.local/state/ot-run/spill_pending")
SPILL_STUCK_LOG = os.path.expanduser("~/.local/state/ot-run/spill_stuck.log")
SPILL_COPY_TRIES, SPILL_BACK_TRIES = 3, 4
SWEEP_STAMP, SWEEP_EVERY_S = "/tmp/ot-run-spill-sweep.stamp", 600


def spill_lock(roots):
    """one flock file per lane-root set on a host: concurrent spills of the same lane (MU-SLICE-GATE 10-19 04:0x: b2 and
    faces0 spilled the same lane ot-epyc5 -> ot-epyc6 at once) must not extract into the same tree together -- two
    concurrent `tar --keep-newer-files -x` fail with 'Unexpected inconsistency when making directory'"""
    import hashlib
    return "/tmp/ot-run-spill-lock." + hashlib.sha1(" ".join(sorted(roots)).encode()).hexdigest()[:16]


# TAR 1.35 (OTRUN-SPILL 2026-10-19, the real cause of the MU-SLICE-GATE "SPILL copy FAILED"): GNU tar 1.35 (every fleet
# EPYC) with --keep-newer-files fails EVERY directory member that already exists ("tar: DIR: Unexpected inconsistency when
# making directory", exit 2) although it updates/keeps the files correctly -- so every spill of a lane to a host that
# already held a copy of it (a second job of the lane, a re-place) "failed".  --overwrite-dir / --no-overwrite-dir are
# refused together with --keep-newer-files, so the extraction filters exactly that error: it counts only for a path that
# is NOT a directory after the run; any other tar or zstd error still fails the copy.
# FLEET-NEW3 2026-10-24: Ubuntu 26.04 GNU tar 1.35 prefixes its messages "/usr/bin/tar: " (was "tar: "), so the
# forgiven existing-directory errors were not recognised and every re-spill FAILED (test_ot_run_spill 5 failures); the
# real tar now emits them itself, so the directory test is relative to the extraction root (cd /, as tar -C /).
TAR_X = ("cd / || exit 97; e=$(mktemp); zstd -q -d | tar -C / \"${OT_TAR_TRANSFORMS[@]}\" --keep-newer-files --warning=no-ignore-newer -xf - 2>$e; s=(${PIPESTATUS[@]}); "
         "if [ ${s[0]} -ne 0 ]; then cat $e >&2; rm -f $e; exit ${s[0]}; fi; rc=${s[1]}; "
         "if grep -q 'Warning: Cannot stat:' $e; then cat $e >&2; rm -f $e; exit 97; fi; "
         "if [ $rc -ne 0 ]; then bad=$(grep -v -x -E '(/usr/bin/)?tar: Exiting with failure status due to previous errors' $e | "
         "while IFS= read -r l; do p=${l#tar: }; p=${p#/usr/bin/tar: }; q=${p%: Unexpected inconsistency when making directory}; "
         "if [ \"$q\" = \"$p\" ] || ! { [ -d \"$q\" ] || [ -d \"/$q\" ]; }; then echo \"$l\"; fi; done); "
         "if [ -z \"$bad\" ]; then rc=0; else echo \"$bad\" >&2; fi; fi; rm -f $e; exit $rc")


def tar_x(roots):
    """the extraction command (stdin = zstd tar stream) under the per-lane flock"""
    # GNU tar's keep-newer stat can silently skip files below an absolute directory
    # symlink (scratch2 -> /home/...): warning + exit 0. Rewrite member names to
    # the receiver's actual root, retaining the existing keep-newer semantics.
    code = """import os, sys
for root in sys.argv[1:]:
    real = os.path.realpath(root)
    if root != real:
        source = root.lstrip('/').translate(str.maketrans({c: chr(92)+c for c in '.^$*[' + chr(92)}))
        target = real.lstrip('/').replace(chr(92), chr(92)*2).replace('&', chr(92)+'&')
        print('--transform=flags=rh;s|^'+source+'/|'+target+'/|;s|^'+source+'$|'+target+'|')
"""
    canonical = "python3 -c " + shlex.quote(code) + " " + " ".join(map(shlex.quote, roots))
    setup = (f"ot_xforms=$({canonical}) || exit 97; OT_TAR_TRANSFORMS=(); "
             'if [ -n "$ot_xforms" ]; then mapfile -t OT_TAR_TRANSFORMS <<< "$ot_xforms"; fi; ')
    return f"flock {spill_lock(roots)} bash -c {shlex.quote(setup + TAR_X)}"


STAGE_FILES = set()   # v14: --stage paths that are files on the source host (no marker inside; parent dir created and marked)


def stage_pre(src, r):
    """v14 STAGE: dst-side preparation of one staged path below a lane root.  Refused (exit 3, OT_SPILL_REAL) when it
    exists on dst and neither it nor an ancestor up to the lane root carries the marker (real data there); a lane root it
    creates is marked (so a later lane SPILL / normal placement treats it as a copy); a staged dir gets its own marker."""
    r = os.path.normpath(r)
    q, lane = shlex.quote(r), spill_root(r)
    chain = mark_ancestors(os.path.dirname(r) if r in STAGE_FILES else r)
    marks = " ".join(shlex.quote(a + "/" + SPILL_MARK) for a in chain)
    s = (f"if test -e {q}; then k=0; for m in {marks}; do test -e $m && k=1; done; "
         f"[ $k = 1 ] || {{ echo OT_SPILL_REAL {q} >&2; exit 3; }}; fi; ")
    if lane != r:
        s += (f"if ! test -e {shlex.quote(lane)}; then mkdir -p {shlex.quote(lane)} && "
              f"echo {src} > {shlex.quote(lane + '/' + SPILL_MARK)} || exit 4; fi; ")
    if r in STAGE_FILES:
        # KW-FIX-8 11-04: a parent this spill creates holds only copies, so it carries the marker; without one the next
        # spill to this host read the copied file as real data (47 rows refused).  A parent that already exists is never
        # marked, whatever it holds: real data stays real and a file there still refuses as above.
        d = shlex.quote(os.path.dirname(r))
        return s + f"if ! test -e {d}; then mkdir -p {d} && echo {src} > {shlex.quote(os.path.dirname(r) + '/' + SPILL_MARK)} || exit 4; fi;"
    return s + f"mkdir -p {q} && echo {src} > {shlex.quote(r + '/' + SPILL_MARK)} || exit 4;"


# Seed-input metadata must return even when cp -a retains an old timestamp.
SPILL_REQUIRED_METADATA = ("freeze.json", "config.mk", "core.json", "pins.json",
                           "kit_rtl.f", "rtl_manifest.json", "source_overlay.json", "kit_assembly.json")
SPILL_SELECT_PY = r'''import json, os, sys
stamp = sys.argv[1]
try:
    with open(stamp + ".inputs", "rb") as stream:
        before = set(stream.read().split(b"\0"))
except FileNotFoundError:
    before = None  # Existing pending records retain their original timestamp contract.
threshold = os.stat(stamp).st_mtime_ns
required = {os.fsencode(x) for x in sys.argv[2:]}
try:
    with open(stamp + ".scope") as stream:
        scopes = [os.fsencode(p.lstrip("/")) for p in json.load(stream)]
except FileNotFoundError:
    scopes = []  # Legacy pending records do not force-copy old seed inputs.

for path in sys.stdin.buffer.read().split(b"\0"):
    if not path:
        continue
    try:
        modified = os.lstat(path).st_mtime_ns > threshold
    except FileNotFoundError:
        continue
    if modified or (before is not None and path not in before) or (path.rsplit(b"/", 1)[-1] in required and any(path == p or path.startswith(p + b"/") for p in scopes)):
        sys.stdout.buffer.write(path + b"\0")
