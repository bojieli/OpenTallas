# One record per active scope or unstarted launcher, never a second charge for its
# closure-daemon state. Legacy scopes can carry an owner-verified disk.UNIT file
# containing their declared lifetime scratch GB; unknown declarations retain 60 GB.
# DIEDEV (FLOW-31): device of each DIEDIR; "unknown" unless the dir is on a scratch root and stats.
# DIEAGE (FLOW-32): seconds an active scope has run; no line (and every waiter) means charged in full.
DIE_DISK_UNITS_SH = r"""# Snapshot launchers first: if one admits during the probe, its PID-derived
# scope below represents it; an exec transition cannot disappear between lists.
die_dev() { case "$1" in /srv/opentallas-scratch*) stat -L -c %d "$1" 2>/dev/null || echo unknown;; *) echo unknown;; esac; }
waiters=$(pgrep -f '^(/(usr/)?bin/)?bash /usr/local/bin/ot-heavy ')
units=$(systemctl --user list-units --type=scope --state=active --no-legend --plain 'oth-*') || exit 1
for u in $(printf '%s\n' "$units" | awk '{print $1}'); do
    cg=$(systemctl --user show -p ControlGroup --value "$u") || exit 1
    prio=; disk=; dirs=
    for p in $(head -3 "/sys/fs/cgroup$cg/cgroup.procs" 2>/dev/null); do
        v=$(readlink "/proc/$p/cwd" 2>/dev/null)
        [ -z "$v" ] || dirs="$dirs
DIEDIR $u $v
DIEDEV $u $(die_dev "$v")"
        e=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null)
        printf '%s\n' "$e" | grep -qx OT_HEAVY_PRIO=die && prio=die
        v=$(printf '%s\n' "$e" | sed -n 's/^OT_HEAVY_DISK_GB=//p' | head -1)
        case "$v" in ''|*[!0-9]*) ;; *) disk=$v;; esac
    done
    [ "$prio" = die ] || continue
    if [ -z "$disk" ]; then
        v=$(cat "/var/tmp/ot-heavy/disk.${u%.scope}" 2>/dev/null)
        case "$v" in ''|*[!0-9]*) ;; *) disk=$v;; esac
    fi
    echo "DIEDISK $u ${disk:-unknown}"
    printf '%s\n' "$dirs"
    v=$(systemctl --user show -p ActiveEnterTimestampMonotonic --value "$u" 2>/dev/null)
    up=; { read -r up _ <"/proc/uptime"; } 2>/dev/null; up=${up%.*}
    case "$v:$up" in *[!0-9:]*|:*|*:|0:*) ;; *) echo "DIEAGE $u $((up - v / 1000000))";; esac
done
for p in $waiters; do
    represented=
    for u in $(printf '%s\n' "$units" | awk '{print $1}'); do
        # ot-heavy sets UNIT=oth-$(id -un)-$$-$(date +%s). An unstarted
        # nested waiter may share its PARENT scope; cgroup membership alone
        # must never erase that waiter's independent scratch commitment.
        case "$u" in oth-*-$p-*.scope) represented=1; break;; esac
    done
    [ -z "$represented" ] || continue
    e=$(tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null)
    printf '%s\n' "$e" | grep -qx OT_HEAVY_PRIO=die || continue
    disk=$(printf '%s\n' "$e" | sed -n 's/^OT_HEAVY_DISK_GB=//p' | head -1)
    case "$disk" in ''|*[!0-9]*) disk=unknown;; esac
    echo "DIEDISK waiter-$p $disk"
    v=$(readlink "/proc/$p/cwd" 2>/dev/null)
    [ -z "$v" ] || { echo "DIEDIR waiter-$p $v"; echo "DIEDEV waiter-$p $(die_dev "$v")"; }
done
echo DIEDISK_DONE
"""


def die_disk_reserved(host, dev=None):
    """Declared GB budgeted to active die scopes and queued launchers; None if the probe failed.

    Existing output already reduces df free space. FLOW-32: a scope that has run
    RUNNING_FULL_CHARGE_S keeps 1/RUNNING_CHARGE_DIV of its declaration as the future-write
    budget; younger scopes, queued launchers and scopes of unknown age keep all of it.
    This rule does not walk the run dirs (no du): dirs are shared between scopes and the
    probe runs every 120 s per client. The real-free floor is in drop_low_disk.
    FLOW-31: with dev (device of the job's scratch root) a unit whose dirs all lie on
    other devices is not charged. A unit with no dir or an unknown one, and any
    daemon job without a scope, is charged as before; so is every unit without dev.
    """
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", host, DIE_DISK_UNITS_SH],
                           capture_output=True, text=True, timeout=40)
        if r.returncode or "DIEDISK_DONE" not in r.stdout.splitlines():
            return None
        units, dirs, devs, ages = {}, {}, {}, {}
        for line in r.stdout.splitlines():
            fields = line.split()
            if fields and fields[0] == "DIEDISK":
                if len(fields) != 3:
                    return None
                unit, value = fields[1:]
                gb = int(value) if value.isascii() and value.isdigit() else DIE_DISK_GB
                units[unit] = max(units.get(unit, 0), gb)
            elif fields and fields[0] == "DIEDIR":
                parts = line.split(maxsplit=2)
                if len(parts) == 3:
                    dirs.setdefault(parts[1], []).append(parts[2])
            elif fields and fields[0] == "DIEDEV" and len(fields) == 3:
                devs.setdefault(fields[1], []).append(fields[2])
            elif fields and fields[0] == "DIEAGE" and len(fields) == 3 and fields[2].isascii() and fields[2].isdigit():
                ages[fields[1]] = int(fields[2])
        # Daemon jobs can use a standalone docker path outside an ot-heavy scope.
        # Keep their conservative budget unless a charged scope or queued launcher actually
        # has a process under that exact job run directory.
        extra = 0
        try:
            names = [f for f in os.listdir(DAEMON_JOBS) if f.endswith(".json") and DIE_RE.search(f[:-5])]
        except OSError:
            names = []
        for name in names:
            try:
                with open(os.path.join(DAEMON_JOBS, name)) as state_file:
                    j = json.load(state_file)
            except (OSError, ValueError):
                continue
            if j.get("host") != host or j.get("status") not in DAEMON_PLACED:
                continue
            root = j.get("run")
            represented = isinstance(root, str) and bool(root) and any(
                d == root or d.startswith(root.rstrip("/") + "/")
                for u in units for d in dirs.get(u, []))
            if not represented:
                extra += DIE_DISK_GB
        return extra + sum((-(-gb // RUNNING_CHARGE_DIV) if ages.get(u, 0) >= RUNNING_FULL_CHARGE_S else gb)
                           for u, gb in units.items()
                           if dev is None or not devs.get(u) or any(x in (dev, "unknown") for x in devs[u]))
    except (subprocess.SubprocessError, OSError, ValueError):
        return None


def drop_low_disk(ok, die, need, say=None):
    """Reserve active die scopes and queued launchers once; unknowns use 60 GB.

    Hosts below DISK_RESERVE_BELOW_GB retain this future-write budget in addition
    to the new request. If the declaration probe fails, retain the legacy count
    budget. Other jobs: place() already checks --disk. FLOW-32: at any free figure the
    job must leave DIE_FREE_FLOOR_GB real free, whatever the reservations come to.
    """
    if not die:
        return ok
    out = dict(ok)
    for h, r in ok.items():
        free = r.get("disk_gb", 0)
        if free - need < DIE_FREE_FLOOR_GB:
            out.pop(h)
            if say:
                say(f"ot-run: {h} skipped for this die job: DISK {free} GB free - {need} GB this job < {DIE_FREE_FLOOR_GB} GB real-free floor")
            continue
        reserve = 0
        if free < DISK_RESERVE_BELOW_GB:
            reserve = die_disk_reserved(h, r.get("disk_dev"))
            if reserve is None:
                reserve = (die_running(h) or 0) * DIE_DISK_GB
        if free - reserve < need:
            out.pop(h)
            if say:
                say(f"ot-run: {h} skipped for this die job: DISK {free} GB free - {reserve} GB running/queued die reservations{' on its root' if r.get('disk_dev') else ''} < {need} GB")
    return out


drop_die_capped = lambda ok, die, say=None: drop_low_disk(ok, die, DIE_DISK_GB, say)   # v9 name


def load1(r):
    return r.get("cpu_load1", r.get("load1", 0))


def die_like(cmd, d):
    """die-level by name: die STA / GEN / GRT / chain scripts (owner 2026-10-18: die jobs go ahead of tile gates)"""
    return bool(DIE_RE.search(" ".join(cmd) + " " + (d or "")))


def ratio(r, threads):
    """projected CPU load of a host with this job on it, in units of its cores (load1 lags a launch by ~1 min, so the
    units started in the last 90 s are counted at THREADS each)"""
    return (load1(r) + THREADS * r.get("fresh", 0) + threads) / r["ncpu"]


def physically_capable(row, mem):
    """Do not queue a request on a host that cannot admit it even when idle.

    Unknown totals retain compatibility with older probes; remote admission
    remains authoritative. Both existing headroom rules still apply.
    """
    total = row.get("total_gb")
    return total is None or mem <= total - max(row.get("headroom_gb", 0), row.get("floor_gb", 0))


MEM_W_GB = 8.0          # v10 COMPLEMENTARY: GB per thread at which memory and CPU headroom weigh equally
TPUT_BONUS = 0.10       # a throughput host (Zen 3) takes tile work first while it has cores (ratio <= 1)


def score(r, mem, threads):
    """v10 COMPLEMENTARY PLACEMENT (FLEET-PLACE 2026-10-19, owner: epyc5/7 CPU-busy with idle RAM while epyc6/8 sat at
    ~35/128): both headrooms count, weighted by the job's shape.  w = (GB per thread) / (GB per thread + MEM_W_GB):
    a 64 GB 1-thread Verilator build / GRT / STA (w 0.89) goes where RAM is idle even when the CPU is busy; a 32 GB
    48-thread job (w 0.08) goes where cores are idle.  cpu = 1 - projected load / cores; mem = (admits - request) / RAM.
    Placement only orders hosts that admit now -- nothing is ever held."""
    gpt = mem / max(threads, 1)
    w = gpt / (gpt + MEM_W_GB)
    cpu = 1.0 - ratio(r, threads)
    memh = (r.get("admit_gb", r["free_gb"]) - mem) / max(r.get("total_gb") or 1000, 1)
    return (1 - w) * cpu + w * memh


def reserved(h, r):
    """HOST_RESERVE: the row as placement sees it (threads and GB kept back for the agents on that host)"""
    t, g = HOST_RESERVE.get(h, (0, 0))
    if not (t or g) or not isinstance(r, dict) or r.get("error") or not r.get("ncpu"):
        return r
    r = dict(r, ncpu=max(1, r["ncpu"] - t), reserve_threads=t, reserve_gb=g)
    for k in ("admit_gb", "free_gb", "die_admit_gb", "total_gb"):
        if isinstance(r.get(k), (int, float)):
            r[k] = r[k] - g
    return r


LOAD_GATE_FACTOR = float(os.environ.get("OT_RUN_LOAD_GATE_FACTOR", "1.25"))   # = ot-heavy LOADGATE_1110 (0 = off)
# CRITGATE_1112: a --crit / --direct job is held by the load gate only at LOAD_GATE_CRIT_FACTOR x nproc (= ot-heavy, default 2.0;
# ot-heavy also caps the bypassing crit jobs at CRIT_BYPASS_MAX = 4 per host, which placement cannot see)
LOAD_GATE_CRIT_FACTOR = float(os.environ.get("OT_RUN_LOAD_GATE_CRIT_FACTOR", "2.0"))


def load_gated(r):
    """LOADGATE_1110 (KW-FIX-44, COORD 11-10: epyc8 load1 507 / 96 threads): ot-heavy holds EVERY job (crit, direct,
    short too) while load1 + fresh admits >= LOAD_GATE_FACTOR x nproc.  Placement sees the same: the fresh units of the
    --free row count at THREADS each (as ratio()), nproc = the row's cores before HOST_RESERVE."""
    if LOAD_GATE_FACTOR <= 0:
        return False
    gf = LOAD_GATE_CRIT_FACTOR if (crit_job() or direct_job()) else LOAD_GATE_FACTOR
    if gf <= 0:
        return False
    n = (r.get("ncpu") or 0) + (r.get("reserve_threads") or 0)
    return n > 0 and load1(r) + THREADS * (r.get("fresh") or 0) >= gf * n


def load_capped(r, mem, threads):
    """QUEUE-BAL-1: ot-heavy on this host would hold this job on its load cap now (LOADCAP_1101): load1 >=
    LOAD_CAP_FACTOR x nproc (nproc = the row's cores before HOST_RESERVE), for a non-crit job outside the short pool;
    LOADGATE_1110: or on its load gate, for any job"""
    if load_gated(r):
        return True
    f = host_load_cap(r)
    if f <= 0 or crit_job() or (mem <= SHORT_MAX_GB and threads <= SHORT_MAX_THREADS):
        return False
    n = (r.get("ncpu") or 0) + (r.get("reserve_threads") or 0)
    return n > 0 and int(load1(r)) >= int(f * n)


DIRECT_HEADROOM_GB = 32   # = ot-heavy DIRECT_1107: real MemAvailable must stay this far above the job's --mem


def direct_job():
    """DIRECT_1107: ot-run --direct, see the usage text"""
    return os.environ.get("OT_RUN_DIRECT") == "1"


def choose(res, mem, threads=THREADS, die=False):
    """res: host -> --free row (hosts that qualify by disk/dir only).  Returns (host, will_queue).
    die: prefer normal hosts among those admitting now, otherwise keep every admitting host eligible; any other job gets
    TPUT_BONUS on a throughput host that stays <= 1.0 x cores.  Among the hosts that admit it now: the best score()."""
    res = {h: reserved(h, r) for h, r in res.items()}
    ok = {h: r for h, r in res.items() if r and not r.get("error") and r.get("ncpu") and physically_capable(r, mem)}
    if not ok:
        return None, False
    if direct_job():    # DIRECT_1107: the host with the most real free memory; only MemAvailable >= mem + headroom counts
        fit = [h for h in ok if ok[h].get("avail_gb", 0) >= mem + DIRECT_HEADROOM_GB and not load_gated(ok[h])]
        return max(fit or ok, key=lambda h: ok[h].get("avail_gb", 0)), not fit
    if die:     # v16 MEASURED RESERVE (coordinator 10-22): a die job is admitted on MemAvailable - 64 GB (die_admit_gb)
        ok = {h: (dict(r, admit_gb=max(r.get("admit_gb", r["free_gb"]), r["die_admit_gb"])) if "die_admit_gb" in r else r)
              for h, r in ok.items()}
    tput = lambda h: HOST_ROLE.get(h) == "throughput"
    nodie = lambda h: HOST_ROLE.get(h) in ("throughput", "smalldisk")
    coord = lambda h: HOST_ROLE.get(h) == "coord"
    if any(not coord(h) for h in ok) and any(not coord(h) and ok[h].get("admit_gb", ok[h]["free_gb"]) >= mem for h in ok):
        ok = {h: r for h, r in ok.items() if not coord(h)}   # FLEET-NEW3: the shared coordinator host only as a last resort
    fits = [h for h in ok if ok[h].get("admit_gb", ok[h]["free_gb"]) >= mem and not load_capped(ok[h], mem, threads)]
    if not fits:                                   # nobody admits it now: queue where the most memory is free
        if any(not coord(h) for h in ok):
            ok = {h: r for h, r in ok.items() if not coord(h)}
        if die and any(not nodie(h) for h in ok):
            ok = {h: r for h, r in ok.items() if not nodie(h)}
        return max(ok, key=lambda h: ok[h]["free_gb"]), True
    if die and any(not nodie(h) for h in fits):
        fits = [h for h in fits if not nodie(h)]
    big = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES and ratio(ok[h], threads) <= 1.0]
    if threads > SMALL_THREADS and big:
        fits = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES]
    bonus = lambda h: TPUT_BONUS if (not die and tput(h) and ratio(ok[h], threads) <= 1.0) else 0.0
    return max(fits, key=lambda h: (round(score(ok[h], mem, threads) + bonus(h), 3), ok[h].get("admit_gb", ok[h]["free_gb"]))), False


