#!/usr/bin/env python3
"""ot-run: run a heavy command on the least CPU-loaded fleet host that can admit it (admission is by memory only).

  ot-run --mem GB [--threads N] [--dir REMOTE_DIR] [--disk GB] [--hosts a,b] [--pick] -- <command...>
  ot-run --selftest [HOST]   proves on HOST (default: every host) that a command runs and returns ITS exit status, and
                             that a request that cannot be admitted fails non-zero with NOT RUN (never a silent 0)
  ot-run --status          one line: per host, the largest request it admits now, MemAvailable, load1/cores, waiters;
                           and the host the next 16-thread job would get

Asks every host for `ot-heavy-reconcile --free` (free_gb = the largest request `ot-heavy` admits there now, by the same
arithmetic; queued waiters are reported separately), drops hosts with less than --disk GB (default 20) free under --dir (or
where --dir does not exist), and among the hosts that can admit --mem takes the one with the lowest
(load1 + threads of the units started in the last 90 s + this job's threads) / cores  (v4, owner 2026-10-13 17:55: the
128-core hosts fill evenly before either passes 1.0 x cores).  A host with fewer than 48 cores never gets a job of more
than 8 threads (--threads, default 16) while a larger host that can admit it still has cores.  Then it runs
ssh <host> "cd DIR && ot-heavy --mem GB -- <command>".
It syncs nothing: the inputs must already be on the host (name them with --dir so only hosts that have them qualify).
--pick prints an eligible host and the table and runs nothing.  stdin/stdout/exit status are the remote command's.
NO LOAD HOLD (v6, owner 2026-10-18 ~01:05 "NEVER hold jobs on CPU load; keep the fleet busy"; memory is the only
admission limit): CPU load only ORDERS the hosts that admit a request now (least loaded first); it never holds, delays or
excludes a job.  The v5 client-side hold (load1 > 1.5 x cores) is gone; OT_RUN_NO_LOAD_HOLD is accepted and ignored.
Probes report load as cpu_load1 (load1 from older probes is read too).
REBALANCE (v6): when no host admits the request now and more than one host qualifies (by --dir / --disk / --hosts),
the job waits on the host with the most planned free memory (or on the chosen host, when it lost an admission race)
for at most REQUEUE_S (300 s), then is cancelled there
(never started) and placed again on whichever qualifying host admits it, so a queue on one host drains into memory
freed on another.  Data locality is kept: only hosts that have --dir qualify; --hosts pins.  --max-wait bounds the whole.
Immediate eligibility uses admit_gb (the actual atomic ot-heavy admission capacity), not free_gb after subtracting
unstarted waiters. When no host can admit now, planned free_gb still chooses the memory queue.
Queue candidates must have enough total physical RAM after mandatory headroom for the request.
--priority die: a die-level job (die STA / GEN / GRT / die chain; owner 2026-10-15 23:50, 2026-10-18). On the host it
                 waits with OT_HEAVY_PRIO=die and is admitted AHEAD of tile gates and benches: a non-die request yields
                 only while a waiting die job fits the host NOW (it starts within seconds); a die job that does not fit
                 never holds memory idle (DIE-FIRST v2, ot-heavy-reconcile).  ot-run also sets it for commands matching
                 DIE_RE (see die_like()).
--max-wait SEC: give up (exit 75, NOT RUN) when the host has not admitted the command after SEC seconds.

Exit status (v2, 2026-10-13, after a bench was reported "EXIT 0" although nothing had run): ot-run returns the command's
status ONLY when the remote side reported both the start (ot-heavy "admitted ... OT_RUN_START") and the exit of the
command.  Anything else -- ssh dropped, waiter killed, cd failed, no memory within --max-wait -- is a non-zero status and
a last stderr line "ot-run: NOT RUN ..." / "ot-run: NOT COMPLETED ...".  The last stderr line of a real run is
"ot-run: RAN on <host>: exit <n>".  Read that line when the call sits in a pipe (`| tail` hides the status).
A killed ot-run (timeout, Ctrl-C) cancels its waiter on the host, so the command cannot start later with nobody
listening; a command that already started is left running and the message says so.
SIGNAL SENDER (v7, FLEET-143 2026-10-18: two agent `pkill -f 'ot-run --mem 24'`-style kills at 23:58 and 00:22 PDT
cancelled ~30 gates of OTHER lanes, which reported "ot-run exit 143"): every SIGTERM/SIGINT/SIGHUP is taken with
sigtimedwait, so the message names the SENDER (pid + command line), and one line goes to ~/.local/state/ot-run/signals.log.
  ot-run --cancel SUBSTR [--all-dirs]   SIGTERMs the local ot-run clients whose arguments contain SUBSTR -- the ONLY way an
                         agent stops its own ot-run jobs besides `kill <exact pid>`.  It refuses (lists, kills nothing,
                         exit 2) when the matches span more than one --dir, so a flag pattern such as '--mem 24' cannot
                         take other lanes' jobs; --all-dirs overrides after reading the list.  Never `pkill -f` ot-run.
"""
import concurrent.futures as cf, json, os, re, shlex, signal, subprocess, sys, threading, time

HOSTS = ["ot-epyc4", "ot-epyc5", "ot-pve1", "ot-agidock128"]   # ot-epyc5 added 2026-10-18 (FLEET-EPYC5)


def probe(host, d):
    q = shlex.quote(d or "/")
    cmd = f"test -d {q} || {{ echo NODIR; exit 0; }}; /usr/local/bin/ot-heavy-reconcile --free {q}"
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", host, cmd], capture_output=True,
                           text=True, timeout=40)
        return host, (None if "NODIR" in r.stdout else json.loads(r.stdout.strip().splitlines()[-1]))
    except Exception as e:
        return host, {"error": str(e)[:80]}


THREADS, SMALL_CORES, SMALL_THREADS = 16, 48, 8
REQUEUE_S = 300                    # v6 REBALANCE: a queued (unstarted) waiter is re-placed after this long
DIE_RE = re.compile(r"(?i)(die[_-]?(sta|gen\d*|grt\d*|chain|trial|place|bind)|(sta|gen\d*|grt\d*)[_-]die\b)")


def load1(r):
    return r.get("cpu_load1", r.get("load1", 0))


def die_like(cmd, d):
    """die-level by name: die STA / GEN / GRT / chain scripts (owner 2026-10-18: die jobs go ahead of tile gates)"""
    return bool(DIE_RE.search(" ".join(cmd) + " " + (d or "")))


def ratio(r, threads):
    """projected CPU load of a host with this job on it, in units of its cores (load1 lags a launch by ~1 min, so the
    units started in the last 90 s are counted at THREADS each)"""
    return (load1(r) + THREADS * r.get("fresh", 0) + threads) / r["ncpu"]


def physically_capable(row, mem):
    """Do not queue a request on a host that cannot admit it even when idle.

    Unknown totals retain compatibility with older probes; remote admission
    remains authoritative. Both existing headroom rules still apply.
    """
    total = row.get("total_gb")
    return total is None or mem <= total - max(row.get("headroom_gb", 0), row.get("floor_gb", 0))


def choose(res, mem, threads=THREADS):
    """res: host -> --free row (hosts that qualify by disk/dir only).  Returns (host, will_queue)."""
    ok = {h: r for h, r in res.items() if r and not r.get("error") and r.get("ncpu") and physically_capable(r, mem)}
    if not ok:
        return None, False
    fits = [h for h in ok if ok[h].get("admit_gb", ok[h]["free_gb"]) >= mem]
    if not fits:                                   # nobody admits it now: queue where the most memory is free
        return max(ok, key=lambda h: ok[h]["free_gb"]), True
    big = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES and ratio(ok[h], threads) <= 1.0]
    if threads > SMALL_THREADS and big:
        fits = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES]
    # hosts within 0.1 x cores of each other are equal: the one that admits more memory takes the job
    return min(fits, key=lambda h: (round(ratio(ok[h], threads), 1), -ok[h].get("admit_gb", ok[h]["free_gb"]))), False


def choose_selftest():
    row = lambda free, load, ncpu=128, fresh=0: dict(free_gb=free, load1=load, ncpu=ncpu, fresh=fresh)
    cases = [
        ("the idle EPYC before the loaded one", dict(e1=row(200, 259), e4=row(580, 47), pve=row(140, 3, 28)), 48, 16, "e4"),
        ("never the 28-core host for 16 threads while an EPYC has cores", dict(e1=row(200, 100), e4=row(580, 90), pve=row(140, 0, 28)), 48, 16, "e4"),
        ("... but for a 4-thread job the least loaded host", dict(e1=row(200, 100), e4=row(580, 90), pve=row(140, 0, 28)), 8, 4, "pve"),
        ("both EPYCs past 1.0 x cores: the small host takes it", dict(e1=row(200, 259), e4=row(580, 140), pve=row(140, 3, 28)), 48, 16, "pve"),
        ("memory decides admission: the loaded host when only it fits", dict(e1=row(400, 120), e4=row(30, 5), pve=row(20, 1, 28)), 300, 16, "e1"),
        ("nobody fits: queue on the most free", dict(e1=row(40, 10), e4=row(90, 100), pve=row(20, 1, 28)), 300, 16, "e4"),
        ("equal load (within 0.1 x cores): the host that admits more", dict(e1=row(100, 40), e4=row(500, 38), agi=row(50, 9, 64)), 32, 16, "e4"),
        ("a burst spreads: units started in the last 90 s count", dict(e1=row(500, 40), e4=row(500, 30, fresh=3)), 48, 16, "e1"),
    ]
    bad = [f"{n}: got {choose(r, m, t)[0]}, want {w}" for n, r, m, t, w in cases if choose(r, m, t)[0] != w]
    for b in bad:
        print("FAIL " + b)
    print(f"ot-run choose selftest: {'FAIL' if bad else 'PASS'} ({len(cases)} cases)")
    return 1 if bad else 0


def status(hosts):
    """one line an agent can read before choosing where to launch: memory nobody has claimed, per host"""
    held = held_hosts() if not os.environ.get("OT_RUN_INCLUDE_HELD") else {}
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, None), hosts))
    out = []
    for h in hosts:
        if h in held:
            out.append(f"{h} HELD ({held[h]})")
            continue
        r = res[h]
        if not r or r.get("error"):
            out.append(f"{h} unreachable")
            continue
        out.append(f"{h} admits {r.get('admit_gb', r['free_gb'])} GB (avail {r['avail_gb']}, growth {r['growth_gb']}) load "
                   f"{load1(r):.0f}/{r.get('ncpu', 0)}" + (f" waiters {r['waiting']}:{r['waiting_gb']} GB" if r["waiting"] else "")
                   + f" run {r['running']}")
    live = {h: r for h, r in res.items() if h not in held and r and not r.get("error") and r.get("ncpu")
            and r["disk_gb"] >= 20 and physically_capable(r, 32)}
    best, queue = choose(live, 32)
    next_job = (f" | next 16-thread 32 GB job -> {best}" + (" (would queue)" if queue else "")) if best else " | next 16-thread 32 GB job: no eligible host"
    print("ot-run status: " + " | ".join(out) + next_job)


SIGS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
SIGNAL_LOG = os.path.expanduser("~/.local/state/ot-run/signals.log")


def proc_args(pid):
    try:
        return [x.decode(errors="replace") for x in open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0") if x]
    except OSError:
        return []


def sender(pid):
    """who sent the signal: pid + command line (the culprit of a cross-lane pattern kill)"""
    try:
        pp = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        par = f"; parent {pp} ({' '.join(proc_args(pp))[-300:]})"
    except (OSError, ValueError, IndexError):
        par = ""
    return f"pid {pid} ({' '.join(proc_args(pid))[:300] or 'exited'}{par})"


def log_signal(line):
    try:
        os.makedirs(os.path.dirname(SIGNAL_LOG), exist_ok=True)
        with open(SIGNAL_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + line + "\n")
    except OSError:
        pass


def clients():
    """local ot-run job clients: pid -> (args after ot-run, --dir or None)"""
    out = {}
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == os.getpid():
            continue
        a = proc_args(p)
        i = next((k for k, x in enumerate(a[:3]) if os.path.basename(x) == "ot-run"), None)
        if i is None or "--" not in a or "--cancel" in a[i + 1:i + 2]:
            continue
        rest = a[i + 1:]
        opts = rest[:rest.index("--")]
        out[int(p)] = (rest, opts[opts.index("--dir") + 1] if "--dir" in opts[:-1] else None)
    return out


def cancel(sub, all_dirs):
    hit = {p: v for p, v in clients().items() if sub in " ".join(v[0])}
    dirs = sorted({str(v[1]) for v in hit.values()})
    for p, (rest, d) in sorted(hit.items()):
        print(f"ot-run --cancel: pid {p} dir {d}: {' '.join(rest)[:200]}")
    if not hit:
        print(f"ot-run --cancel: no local ot-run client matches {sub!r}")
        return 1
    if len(dirs) > 1 and not all_dirs:
        print(f"ot-run --cancel: REFUSED: {sub!r} matches {len(hit)} clients in {len(dirs)} different --dir values "
              f"({', '.join(dirs)[:400]}); other lanes' jobs would die.  Use a substring unique to your job (its --dir or "
              f"script path), kill your exact pid, or pass --all-dirs after reading the list.  Nothing killed.")
        return 2
    for p in hit:
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    print(f"ot-run --cancel: SIGTERM sent to {len(hit)} client(s); waiters are cancelled on their hosts, started commands keep running")
    log_signal(f"--cancel {sub!r} by pid {os.getpid()} parent {sender(os.getppid())}: {sorted(hit)}")
    return 0


def run(host, mem, cmd, d=None, max_wait=None, env="", quiet=False, quiet_notrun=False):
    """run cmd under ot-heavy on host; return (status, ran).  status is the command's only when ran is True."""
    tag = "otrun-%s-%d-%d" % (os.uname().nodename, os.getpid(), int(time.time() * 1000) % 10 ** 9)
    say = (lambda m: None) if quiet else (lambda m: print(m, file=sys.stderr, flush=True))
    env = os.environ.get("OT_RUN_PRIO_ENV", "") + env
    inner = f"{env}/usr/local/bin/ot-heavy --mem {mem} --tag {tag}" + (f" --max-wait {int(max_wait)}" if max_wait else "") \
        + " -- " + " ".join(shlex.quote(x) for x in cmd)
    remote = (f"cd {shlex.quote(d)} || {{ echo OT_RUN_NOCD {tag} >&2; exit 96; }}; " if d else "") \
        + inner + f'; rc=$?; echo "OT_RUN_EXIT {tag} $rc" >&2; exit $rc'
    p = subprocess.Popen(["ssh", "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=6", host, remote], stderr=subprocess.PIPE)
    state = dict(started=False, rc=None, nocd=False, unit="?")
    unblock = lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK, SIGS)

    def stop(sig, who):
        log_signal(f"signal {sig} from {who} -> ot-run pid {os.getpid()} host {host} tag {tag} "
                   f"{'STARTED unit ' + state['unit'] if state['started'] else 'WAITING'} dir {d}: {' '.join(cmd)[:200]}")
        if state["started"]:
            say(f"ot-run: interrupted (signal {sig} from {who}); the command is STILL RUNNING on {host} (unit {state['unit']}): NOT COMPLETED")
        else:      # cancel the waiter, or it would start the command later with nobody listening
            subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", host,
                            f"pkill -TERM -f -- '[-]-tag {tag} '"], capture_output=True, timeout=40, preexec_fn=unblock)
            say(f"ot-run: interrupted (signal {sig} from {who}) while waiting for memory on {host}; waiter cancelled: NOT RUN")
        p.kill()
        os._exit(128 + sig)

    # v7: block the signals in every thread and take them with sigtimedwait, which tells who sent them
    done = threading.Event()
    signal.pthread_sigmask(signal.SIG_BLOCK, SIGS)

    def watch():
        while not done.is_set():
            info = signal.sigtimedwait(SIGS, 0.5)
            if info is not None:
                stop(info.si_signo, sender(info.si_pid))
    w = threading.Thread(target=watch, daemon=True)
    w.start()
    for raw in p.stderr:
        ln = raw.decode(errors="replace")
        if tag in ln and "OT_RUN_EXIT" in ln:
            try:
                state["rc"] = int(ln.split()[-1])
            except ValueError:
                pass
            continue
        if "OT_RUN_NOCD" in ln and tag in ln:
            state["nocd"] = True
            continue
        if "OT_RUN_START" in ln and tag in ln:
            state["started"] = True
            state["unit"] = next((w for w in ln.split() if w.startswith("oth-")), "?")
            ln = ln.split(" OT_RUN_START")[0] + "\n"
        if not quiet:
            sys.stderr.write(ln)
            sys.stderr.flush()
    ssh_rc = p.wait()
    done.set()
    w.join()
    unblock()
    if state["started"] and state["rc"] is not None:
        say(f"ot-run: RAN on {host} (unit {state['unit']}): exit {state['rc']}")
        return state["rc"], True
    if state["started"]:
        say(f"ot-run: NOT COMPLETED: the command started on {host} (unit {state['unit']}) but the connection ended (ssh status "
            f"{ssh_rc}) before it reported an exit status; it may still be running there")
        return (ssh_rc or 255), False
    why = f"cannot cd to {d}" if state["nocd"] else f"ot-heavy exit {state['rc']}" if state["rc"] is not None \
        else f"ssh ended with status {ssh_rc} before the command was admitted"
    if not (quiet_notrun and state["rc"] == 75):
        say(f"ot-run: NOT RUN on {host}: {why}")
    return (state["rc"] or ssh_rc or 255), False


def selftest(hosts):
    """a command runs and its status comes back; a request that cannot be admitted is a loud non-zero NOT RUN"""
    bad = 0
    for h in hosts:
        m = f"/tmp/ot-run-selftest.{os.getpid()}"
        rc1, ran1 = run(h, 1, ["bash", "-c", f"echo ran > {m}.a; exit 7"], quiet=True)
        rc2, ran2 = run(h, 1, ["bash", "-c", f"echo ran > {m}.b"], max_wait=1, env="REAL_FLOOR_GB=99999999 ", quiet=True)
        rc3, ran3 = run(h, 1, ["true"], d="/nonexistent-ot-run-selftest", quiet=True)
        ls = subprocess.run(["ssh", "-o", "ControlPath=none", h, f"ls {m}.a {m}.b 2>/dev/null; rm -f {m}.a {m}.b"],
                            capture_output=True, text=True, timeout=60).stdout.split()
        ok = (rc1, ran1) == (7, True) and ls == [f"{m}.a"] and (rc2, ran2) == (75, False) and (rc3, ran3) == (96, False)
        bad += not ok
        print(f"ot-run selftest {h}: {'PASS' if ok else 'FAIL'}  run->status {rc1} ran={ran1} (want 7 True); "
              f"no-memory->status {rc2} ran={ran2} (want 75 False); bad dir->status {rc3} ran={ran3} (want 96 False); "
              f"markers {[x.rsplit('.', 1)[-1] for x in ls]} (want ['a'])")
    return 1 if bad else 0


# HELD HOSTS (ROOT 2026-10-15, coordinator: AGIdock reset 3x in one day): a host listed in HELD_FILE ("<host> <reason>"
# per line) admits no new ot-run job (pick, run, explicit --hosts alike); jobs already running there are untouched.
# Reversible: delete the line.  OT_RUN_INCLUDE_HELD=1 overrides for one call (diagnostics).
HELD_FILE = os.path.expanduser("~/.config/ot-run/held_hosts")


def held_hosts():
    try:
        return {ln.split()[0]: (ln.split(None, 1)[1].strip() if len(ln.split()) > 1 else "held")
                for ln in open(HELD_FILE) if ln.strip() and not ln.startswith("#")}
    except OSError:
        return {}


def main():
    a = sys.argv[1:]
    if a[:1] == ["--selftest"]:
        sys.exit(choose_selftest() if a[1:2] == ["choose"] else choose_selftest() | selftest(a[1].split(",") if len(a) > 1 else HOSTS))
    if a[:1] == ["--status"]:
        return status(HOSTS)
    if a[:1] == ["--cancel"] and len(a) >= 2:
        sys.exit(cancel(a[1], "--all-dirs" in a[2:]))
    mem, d, disk, hosts, pick, max_wait, threads = None, None, 20, HOSTS, False, None, THREADS
    while a and a[0] != "--":
        o = a.pop(0)
        if o == "--mem": mem = int(a.pop(0))
        elif o == "--dir": d = a.pop(0)
        elif o == "--disk": disk = int(a.pop(0))
        elif o == "--hosts": hosts = a.pop(0).split(",")
        elif o == "--pick": pick = True
        elif o == "--max-wait": max_wait = int(a.pop(0))
        elif o == "--threads": threads = int(a.pop(0))
        elif o == "--priority":
            prio = a.pop(0)
            if prio != "die": sys.exit("ot-run: --priority takes only 'die' (owner 2026-10-15 23:50: die-level trials)")
            os.environ["OT_RUN_PRIO_ENV"] = "OT_HEAVY_PRIO=die "
        else: sys.exit(__doc__)
    cmd = a[1:]
    if mem is None or not (cmd or pick):
        sys.exit(__doc__)
    held = held_hosts()
    if held and not os.environ.get("OT_RUN_INCLUDE_HELD"):
        kept = [h for h in hosts if h not in held]
        if not kept:
            print(f"ot-run: NOT RUN: every requested host is held ({'; '.join(f'{h}: {held[h]}' for h in hosts)}); "
                  f"edit {HELD_FILE} to release", file=sys.stderr)
            sys.exit(75 if pick else 1)
        hosts = kept
    if os.environ.get("OT_RUN_PRIO_ENV") is None and die_like(cmd, d):
        os.environ["OT_RUN_PRIO_ENV"] = "OT_HEAVY_PRIO=die "
        print("ot-run: die-level command (DIE_RE): --priority die", file=sys.stderr)
    t0 = time.time()
    first = True
    while True:
        ok = place(hosts, d, disk, mem, quiet=not first)
        best, queue = choose(ok, mem, threads)
        if not best:
            sys.exit("ot-run: no host qualifies")
        print(f"ot-run: -> {best}" + (f" (will queue: admits {ok[best].get('admit_gb', ok[best]['free_gb'])} GB < {mem} GB)" if queue else ""),
              file=sys.stderr)
        if pick:
            print(best)
            return
        left = None if max_wait is None else max(1, int(max_wait - (time.time() - t0) + 0.999))
        wait = left
        if len(ok) > 1:                    # REBALANCE: an unstarted waiter is re-placed after REQUEUE_S
            wait = REQUEUE_S if left is None else min(REQUEUE_S, left)
        rc, ran = run(best, mem, cmd, d, wait, quiet_notrun=(wait != left))
        if ran or rc != 75 or wait == left:
            sys.exit(rc if ran else (rc or 255))
        print(f"ot-run: REBALANCE: not admitted on {best} within {wait} s; placing again", file=sys.stderr)
        first = False


REAPER = os.path.expanduser("~/bin/ot-reaper.py")
REAP_STAMP = "/tmp/ot-run-reap-{host}.stamp"
REAP_EVERY_S = 1800


def trigger_reaper(host, why):
    """(ROOT-2130 2026-10-18, FLEET-DISK P6) a host refused for low disk starts `ot-reaper.py --host H` once (detached,
    flock; at most every REAP_EVERY_S per host) instead of only refusing: the cron run is every 30 min and EPYC4 sat at
    14-16 GB free (refused) with 444 GB of reapable gate bulk."""
    if not os.path.exists(REAPER):
        return False
    stamp = REAP_STAMP.format(host=host)
    try:
        if time.time() - os.path.getmtime(stamp) < REAP_EVERY_S:
            return False
    except OSError:
        pass
    try:
        open(stamp, "w").write(f"{why}\n")
        subprocess.Popen(["flock", "-n", f"/tmp/ot-run-reap-{host}.lock", sys.executable, REAPER, "--host", host],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        return False
    return True


def place(hosts, d, disk, mem, quiet=False):
    """probe the hosts; return host -> row for every host that qualifies (dir, disk, physical RAM).  No load test."""
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, d), hosts))
    ok = {}
    for h, r in res.items():
        note = "no " + str(d) if r is None else r.get("error") or ("disk %d GB < %d" % (r["disk_gb"], disk) if r["disk_gb"] < disk else "")
        if r and not r.get("error") and not note and not r.get("ncpu"):
            note = "probe without ncpu"
        if r and not r.get("error") and not physically_capable(r, mem):
            note = "request %d GB exceeds physical RAM after mandatory headroom" % mem
        if r and not r.get("error") and r["disk_gb"] < disk and trigger_reaper(h, note):
            note += " (ot-reaper started for this host)"
        if r and not r.get("error"):
            if not quiet:
                print(f"ot-run: {h:14s} admits {r.get('admit_gb', r['free_gb']):5d} GB (avail {r['avail_gb']}, growth {r['growth_gb']}, headroom "
                      f"{r['headroom_gb']}, waiters {r['waiting']}/{r['waiting_gb']} GB) load {load1(r):.0f}/{r.get('ncpu', 0)} "
                      f"running {r['running']} disk {r['disk_gb']} GB {note}", file=sys.stderr)
            if not note:
                ok[h] = r
        elif not quiet:
            print(f"ot-run: {h:14s} skipped: {note}", file=sys.stderr)
    return ok


