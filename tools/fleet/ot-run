#!/usr/bin/env python3
"""ot-run: run a heavy command on the least CPU-loaded fleet host that can admit it (admission is by memory only).

  ot-run --mem GB [--threads N] [--dir REMOTE_DIR] [--disk GB] [--hosts a,b] [--pick] -- <command...>
  ot-run --selftest [HOST]   proves on HOST (default: every host) that a command runs and returns ITS exit status, and
                             that a request that cannot be admitted fails non-zero with NOT RUN (never a silent 0)
  ot-run --status          one line: per host, the largest request it admits now, MemAvailable, load1/cores, waiters;
                           and the host the next 16-thread job would get

Asks every host for `ot-heavy-reconcile --free` (free_gb = the largest request `ot-heavy` admits there now, by the same
arithmetic; queued waiters are reported separately), drops hosts with less than --disk GB (default 20) free under --dir (or
where --dir does not exist), and among the hosts that can admit --mem takes the one with the lowest
(load1 + threads of the units started in the last 90 s + this job's threads) / cores  (v4, owner 2026-10-13 17:55: the
128-core hosts fill evenly before either passes 1.0 x cores).  A host with fewer than 48 cores never gets a job of more
than 8 threads (--threads, default 16) while a larger host that can admit it still has cores.  Then it runs
ssh <host> "cd DIR && ot-heavy --mem GB -- <command>".
It syncs nothing: the inputs must already be on the host (name them with --dir so only hosts that have them qualify).
--pick prints an eligible host and the table and runs nothing. It applies the same load hold as a run;
if all qualifying hosts are load-held it returns 75 immediately with no host on stdout (never sleeps).  stdin/stdout/exit status are the remote command's.
Load hold (v5, owner 2026-10-14 ~18:40 "1.5 times cores is fine ... there needs to be a queue of tasks"): a hand-run
job is held on THIS side (re-probing every 60 s) while every host that qualifies has load1 > 1.5 x cores, then goes to
a host under that line.  Memory remains the only admission limit on the hosts; closure-loop routes (which call
ot-heavy directly) are not held.  OT_RUN_NO_LOAD_HOLD=1 disables the hold.  --max-wait also bounds the hold.
Immediate eligibility uses admit_gb (the actual atomic ot-heavy admission capacity), not free_gb after subtracting
unstarted waiters. When no host can admit now, planned free_gb still chooses the memory queue; waiting jobs do not
reserve physical RAM or prevent a smaller job using otherwise idle capacity. ot-heavy rechecks admission atomically.
The CPU hold considers memory-admissible hosts first; if none admits the request, it considers the hosts eligible
for a memory queue. An underloaded host without enough memory cannot release a hold on memory-admissible hosts.
--max-wait SEC: give up (exit 75, NOT RUN) when the host has not admitted the command after SEC seconds.

Exit status (v2, 2026-10-13, after a bench was reported "EXIT 0" although nothing had run): ot-run returns the command's
status ONLY when the remote side reported both the start (ot-heavy "admitted ... OT_RUN_START") and the exit of the
command.  Anything else -- ssh dropped, waiter killed, cd failed, no memory within --max-wait -- is a non-zero status and
a last stderr line "ot-run: NOT RUN ..." / "ot-run: NOT COMPLETED ...".  The last stderr line of a real run is
"ot-run: RAN on <host>: exit <n>".  Read that line when the call sits in a pipe (`| tail` hides the status).
A killed ot-run (timeout, Ctrl-C) cancels its waiter on the host, so the command cannot start later with nobody
listening; a command that already started is left running and the message says so.
"""
import concurrent.futures as cf, json, os, shlex, signal, subprocess, sys, time

HOSTS = ["ot-epyc1tb", "ot-epyc4", "ot-pve1", "ot-agidock128"]


def probe(host, d):
    q = shlex.quote(d or "/")
    cmd = f"test -d {q} || {{ echo NODIR; exit 0; }}; /usr/local/bin/ot-heavy-reconcile --free {q}"
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", host, cmd], capture_output=True,
                           text=True, timeout=40)
        return host, (None if "NODIR" in r.stdout else json.loads(r.stdout.strip().splitlines()[-1]))
    except Exception as e:
        return host, {"error": str(e)[:80]}


THREADS, SMALL_CORES, SMALL_THREADS = 16, 48, 8
LOAD_HOLD, HOLD_POLL = 1.5, 60


def ratio(r, threads):
    """projected CPU load of a host with this job on it, in units of its cores (load1 lags a launch by ~1 min, so the
    units started in the last 90 s are counted at THREADS each)"""
    return (r.get("load1", 0) + THREADS * r.get("fresh", 0) + threads) / r["ncpu"]


def physically_capable(row, mem):
    """Do not queue a request on a host that cannot admit it even when idle.

    Unknown totals retain compatibility with older probes; remote admission
    remains authoritative. Both existing headroom rules still apply.
    """
    total = row.get("total_gb")
    return total is None or mem <= total - max(row.get("headroom_gb", 0), row.get("floor_gb", 0))


def choose(res, mem, threads=THREADS):
    """res: host -> --free row (hosts that qualify by disk/dir only).  Returns (host, will_queue)."""
    ok = {h: r for h, r in res.items() if r and not r.get("error") and r.get("ncpu") and physically_capable(r, mem)}
    if not ok:
        return None, False
    fits = [h for h in ok if ok[h].get("admit_gb", ok[h]["free_gb"]) >= mem]
    if not fits:                                   # nobody admits it now: queue where the most memory is free
        return max(ok, key=lambda h: ok[h]["free_gb"]), True
    big = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES and ratio(ok[h], threads) <= 1.0]
    if threads > SMALL_THREADS and big:
        fits = [h for h in fits if ok[h]["ncpu"] >= SMALL_CORES]
    # hosts within 0.1 x cores of each other are equal: the one that admits more memory takes the job
    return min(fits, key=lambda h: (round(ratio(ok[h], threads), 1), -ok[h].get("admit_gb", ok[h]["free_gb"]))), False


def choose_selftest():
    row = lambda free, load, ncpu=128, fresh=0: dict(free_gb=free, load1=load, ncpu=ncpu, fresh=fresh)
    cases = [
        ("the idle EPYC before the loaded one", dict(e1=row(200, 259), e4=row(580, 47), pve=row(140, 3, 28)), 48, 16, "e4"),
        ("never the 28-core host for 16 threads while an EPYC has cores", dict(e1=row(200, 100), e4=row(580, 90), pve=row(140, 0, 28)), 48, 16, "e4"),
        ("... but for a 4-thread job the least loaded host", dict(e1=row(200, 100), e4=row(580, 90), pve=row(140, 0, 28)), 8, 4, "pve"),
        ("both EPYCs past 1.0 x cores: the small host takes it", dict(e1=row(200, 259), e4=row(580, 140), pve=row(140, 3, 28)), 48, 16, "pve"),
        ("memory decides admission: the loaded host when only it fits", dict(e1=row(400, 120), e4=row(30, 5), pve=row(20, 1, 28)), 300, 16, "e1"),
        ("nobody fits: queue on the most free", dict(e1=row(40, 10), e4=row(90, 100), pve=row(20, 1, 28)), 300, 16, "e4"),
        ("equal load (within 0.1 x cores): the host that admits more", dict(e1=row(100, 40), e4=row(500, 38), agi=row(50, 9, 64)), 32, 16, "e4"),
        ("a burst spreads: units started in the last 90 s count", dict(e1=row(500, 40), e4=row(500, 30, fresh=3)), 48, 16, "e1"),
    ]
    bad = [f"{n}: got {choose(r, m, t)[0]}, want {w}" for n, r, m, t, w in cases if choose(r, m, t)[0] != w]
    for b in bad:
        print("FAIL " + b)
    print(f"ot-run choose selftest: {'FAIL' if bad else 'PASS'} ({len(cases)} cases)")
    return 1 if bad else 0


def status(hosts):
    """one line an agent can read before choosing where to launch: memory nobody has claimed, per host"""
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, None), hosts))
    out = []
    for h in hosts:
        r = res[h]
        if not r or r.get("error"):
            out.append(f"{h} unreachable")
            continue
        out.append(f"{h} admits {r.get('admit_gb', r['free_gb'])} GB (avail {r['avail_gb']}, growth {r['growth_gb']}) load "
                   f"{r.get('load1', 0):.0f}/{r.get('ncpu', 0)}" + (f" waiters {r['waiting']}:{r['waiting_gb']} GB" if r["waiting"] else "")
                   + f" run {r['running']}")
    best, queue = choose(res, 32)
    print("ot-run status: " + " | ".join(out) + (f" | next 16-thread 32 GB job -> {best}" + (" (would queue)" if queue else "") if best else ""))


def run(host, mem, cmd, d=None, max_wait=None, env="", quiet=False):
    """run cmd under ot-heavy on host; return (status, ran).  status is the command's only when ran is True."""
    tag = "otrun-%s-%d-%d" % (os.uname().nodename, os.getpid(), int(time.time() * 1000) % 10 ** 9)
    say = (lambda m: None) if quiet else (lambda m: print(m, file=sys.stderr, flush=True))
    inner = f"{env}/usr/local/bin/ot-heavy --mem {mem} --tag {tag}" + (f" --max-wait {int(max_wait)}" if max_wait else "") \
        + " -- " + " ".join(shlex.quote(x) for x in cmd)
    remote = (f"cd {shlex.quote(d)} || {{ echo OT_RUN_NOCD {tag} >&2; exit 96; }}; " if d else "") \
        + inner + f'; rc=$?; echo "OT_RUN_EXIT {tag} $rc" >&2; exit $rc'
    p = subprocess.Popen(["ssh", "-o", "ServerAliveInterval=30", "-o", "ServerAliveCountMax=6", host, remote], stderr=subprocess.PIPE)
    state = dict(started=False, rc=None, nocd=False, unit="?")

    def stop(sig, _frame):
        if state["started"]:
            say(f"ot-run: interrupted (signal {sig}); the command is STILL RUNNING on {host} (unit {state['unit']}): NOT COMPLETED")
        else:      # cancel the waiter, or it would start the command later with nobody listening
            subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", host,
                            f"pkill -TERM -f -- '[-]-tag {tag} '"], capture_output=True, timeout=40)
            say(f"ot-run: interrupted (signal {sig}) while waiting for memory on {host}; waiter cancelled: NOT RUN")
        p.kill()
        os._exit(128 + sig)

    for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sg, stop)
    for raw in p.stderr:
        ln = raw.decode(errors="replace")
        if tag in ln and "OT_RUN_EXIT" in ln:
            try:
                state["rc"] = int(ln.split()[-1])
            except ValueError:
                pass
            continue
        if "OT_RUN_NOCD" in ln and tag in ln:
            state["nocd"] = True
            continue
        if "OT_RUN_START" in ln and tag in ln:
            state["started"] = True
            state["unit"] = next((w for w in ln.split() if w.startswith("oth-")), "?")
            ln = ln.split(" OT_RUN_START")[0] + "\n"
        if not quiet:
            sys.stderr.write(ln)
            sys.stderr.flush()
    ssh_rc = p.wait()
    for sg in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sg, signal.SIG_DFL)
    if state["started"] and state["rc"] is not None:
        say(f"ot-run: RAN on {host} (unit {state['unit']}): exit {state['rc']}")
        return state["rc"], True
    if state["started"]:
        say(f"ot-run: NOT COMPLETED: the command started on {host} (unit {state['unit']}) but the connection ended (ssh status "
            f"{ssh_rc}) before it reported an exit status; it may still be running there")
        return (ssh_rc or 255), False
    why = f"cannot cd to {d}" if state["nocd"] else f"ot-heavy exit {state['rc']}" if state["rc"] is not None \
        else f"ssh ended with status {ssh_rc} before the command was admitted"
    say(f"ot-run: NOT RUN on {host}: {why}")
    return (state["rc"] or ssh_rc or 255), False


def selftest(hosts):
    """a command runs and its status comes back; a request that cannot be admitted is a loud non-zero NOT RUN"""
    bad = 0
    for h in hosts:
        m = f"/tmp/ot-run-selftest.{os.getpid()}"
        rc1, ran1 = run(h, 1, ["bash", "-c", f"echo ran > {m}.a; exit 7"], quiet=True)
        rc2, ran2 = run(h, 1, ["bash", "-c", f"echo ran > {m}.b"], max_wait=1, env="REAL_FLOOR_GB=99999999 ", quiet=True)
        rc3, ran3 = run(h, 1, ["true"], d="/nonexistent-ot-run-selftest", quiet=True)
        ls = subprocess.run(["ssh", "-o", "ControlPath=none", h, f"ls {m}.a {m}.b 2>/dev/null; rm -f {m}.a {m}.b"],
                            capture_output=True, text=True, timeout=60).stdout.split()
        ok = (rc1, ran1) == (7, True) and ls == [f"{m}.a"] and (rc2, ran2) == (75, False) and (rc3, ran3) == (96, False)
        bad += not ok
        print(f"ot-run selftest {h}: {'PASS' if ok else 'FAIL'}  run->status {rc1} ran={ran1} (want 7 True); "
              f"no-memory->status {rc2} ran={ran2} (want 75 False); bad dir->status {rc3} ran={ran3} (want 96 False); "
              f"markers {[x.rsplit('.', 1)[-1] for x in ls]} (want ['a'])")
    return 1 if bad else 0


def main():
    a = sys.argv[1:]
    if a[:1] == ["--selftest"]:
        sys.exit(choose_selftest() if a[1:2] == ["choose"] else choose_selftest() | selftest(a[1].split(",") if len(a) > 1 else HOSTS))
    if a[:1] == ["--status"]:
        return status(HOSTS)
    mem, d, disk, hosts, pick, max_wait, threads = None, None, 20, HOSTS, False, None, THREADS
    while a and a[0] != "--":
        o = a.pop(0)
        if o == "--mem": mem = int(a.pop(0))
        elif o == "--dir": d = a.pop(0)
        elif o == "--disk": disk = int(a.pop(0))
        elif o == "--hosts": hosts = a.pop(0).split(",")
        elif o == "--pick": pick = True
        elif o == "--max-wait": max_wait = int(a.pop(0))
        elif o == "--threads": threads = int(a.pop(0))
        else: sys.exit(__doc__)
    cmd = a[1:]
    if mem is None or not (cmd or pick):
        sys.exit(__doc__)
    t0, held = time.time(), False
    while True:
        with cf.ThreadPoolExecutor(len(hosts)) as ex:
            res = dict(ex.map(lambda h: probe(h, d), hosts))
        live = {h: r for h, r in res.items() if r and not r.get("error") and r.get("ncpu") and r["disk_gb"] >= disk and physically_capable(r, mem)}
        # A host that cannot admit this request cannot release the CPU hold:
        # otherwise an idle, memory-full EPYC filters out a loaded PVE that
        # actually has memory, then choose() queues on the full EPYC forever.
        fits = {h: r for h, r in live.items() if r.get("admit_gb", r["free_gb"]) >= mem}
        qualifying = fits or live
        under = {h: r for h, r in qualifying.items() if r.get("load1", 0) <= LOAD_HOLD * r["ncpu"]}
        bypass = os.environ.get("OT_RUN_NO_LOAD_HOLD") == "1"
        if bypass or not live or under:
            if held:
                print(f"ot-run: load hold released after {time.time() - t0:.0f} s", file=sys.stderr)
            if not bypass:
                res = {h: (r if h in under or h not in qualifying else {"error": "load hold: load1 > %.1f x cores" % LOAD_HOLD})
                       for h, r in res.items()}
            break
        if pick:
            sys.exit(print("ot-run: NOT RUN: load hold: every qualifying host above %.1f x cores; --pick is read-only, retry later" %
                           LOAD_HOLD, file=sys.stderr) or 75)
        if max_wait is not None and time.time() - t0 > max_wait:
            sys.exit(print("ot-run: NOT RUN: load hold: every qualifying host above %.1f x cores for %d s" %
                           (LOAD_HOLD, time.time() - t0), file=sys.stderr) or 75)
        if not held:
            print("ot-run: load hold: every qualifying host has load1 > %.1f x cores (%s); waiting" % (LOAD_HOLD, ", ".join(
                f"{h} {r.get('load1', 0):.0f}/{r['ncpu']}" for h, r in qualifying.items())), file=sys.stderr)
        held = True
        time.sleep(HOLD_POLL)
    ok = {}
    for h, r in res.items():
        note = "no " + str(d) if r is None else r.get("error") or ("disk %d GB < %d" % (r["disk_gb"], disk) if r["disk_gb"] < disk else "")
        if r and not r.get("error") and not physically_capable(r, mem):
            note = "request %d GB exceeds physical RAM after mandatory headroom" % mem
        if r and not r.get("error"):
            print(f"ot-run: {h:14s} admits {r.get('admit_gb', r['free_gb']):5d} GB (avail {r['avail_gb']}, growth {r['growth_gb']}, headroom "
                  f"{r['headroom_gb']}, waiters {r['waiting']}/{r['waiting_gb']} GB) load {r.get('load1', 0):.0f}/{r.get('ncpu', 0)} "
                  f"running {r['running']} disk {r['disk_gb']} GB {note}", file=sys.stderr)
            if not note:
                ok[h] = r
        else:
            print(f"ot-run: {h:14s} skipped: {note}", file=sys.stderr)
    best, queue = choose(ok, mem, threads)
    if not best:
        sys.exit("ot-run: no host qualifies")
    print(f"ot-run: -> {best}" + (f" (will queue: admits {ok[best]['free_gb']} GB < {mem} GB)" if queue else ""), file=sys.stderr)
    if pick:
        print(best)
        return
    rc, ran = run(best, mem, cmd, d, max_wait)
    sys.exit(rc if ran else (rc or 255))


if __name__ == "__main__":
    main()
