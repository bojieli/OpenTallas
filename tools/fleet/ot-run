    tag = "otrun-%s-%d-%d" % (os.uname().nodename, os.getpid(), int(time.time() * 1000) % 10 ** 9)
    say = (lambda m: None) if quiet else (lambda m: print(m, file=sys.stderr, flush=True))
    env = os.environ.get("OT_RUN_PRIO_ENV", "") + ("OT_HEAVY_CPU=crit " if crit_job() else "") + ("OT_HEAVY_DIRECT=1 " if direct_job() else "") + env
    env = f"OT_HEAVY_SHORT_SLOTS={16 if host in ('epyc2', 'epyc4', 'epyc5', 'epyc6') else 12} OT_HEAVY_THREADS={int(os.environ.get('OT_RUN_THREADS', THREADS))} OT_HEAVY_WAIT_SINCE={int(RUN_T0)} " + env
    if disk is None:
        disk = DIE_DISK_GB if "OT_HEAVY_PRIO=die" in env else 20
    env += f"OT_HEAVY_DISK_GB={int(disk)} "
    inner = f"{env}/usr/local/bin/ot-heavy --mem {mem} --tag {tag}" + (f" --max-wait {int(max_wait)}" if max_wait else "") \
        + " -- " + " ".join(shlex.quote(x) for x in cmd)
