def scratch_place_sh(d, cmd, dry=False, tag="otrun", host=None):
    """the remote shell snippet that places new run dirs on the emptiest scratch root ('' when disabled).  v13: on a host
    with a separate scratch disk a new run dir that cannot go to that disk stops the job (OT_RUN_SCRATCHLOW, exit 98)."""
    if not scratch2_on():
        return ""
    import base64
    code = base64.b64encode(SCRATCH_PLACE_PY.encode()).decode()
    arg = base64.b64encode(json.dumps(list(cmd)).encode()).decode()
    if len(arg) > 32000:          # the whole remote command is ONE argv string to the remote shell (<= 128 KiB)
        arg = base64.b64encode(json.dumps([x for x in cmd if len(x) < 4000]).encode()).decode()
    pe = (f'OT_RUN_PLACE_ROOTS={shlex.quote(" ".join(SCRATCH_ROOTS))} OT_RUN_PLACE_SECOND={shlex.quote(" ".join(ROOT_SCRATCH_ROOTS))} '
          f'OT_RUN_PLACE_RFLOOR={root_floor(host)} OT_RUN_PLACE_SFLOOR={SCRATCH_SECOND_FLOOR_GB} OT_RUN_PLACE_PIN={shlex.quote(SCRATCH_PIN)} ')
    return (f'pl=$({pe}OT_RUN_SCRATCH_DISK_FLOOR_GB={sfloor(host)} timeout 60 python3 -c "$(echo {code} | base64 -d)" '
            f'{shlex.quote(d or "")} {arg}' + (" dry" if dry else "") + ' 2>&1 >/dev/null); prc=$?; '
            '[ -n "$pl" ] && printf "%s\n" "$pl" | head -20 >&2; '
            f'[ $prc = 3 ] && {{ echo OT_RUN_SCRATCHLOW {tag} >&2; exit 98; }}; ')


def crit_job():
    """CRIT_1101: ot-run --crit (or OT_RUN_CRIT=1): the job's scope and containers get CPU weight 1000 and it bypasses
    the host load cap (LOADCAP_1101 in ot-heavy).  Memory admission is unchanged."""
    return os.environ.get("OT_RUN_CRIT", "") not in ("", "0")


# FLOW-21 SSHRETRY 11-01 (COORD 09:2x (3)): sshd resets new connections under load (intel2 load 380: "kex_exchange_
# identification: read: Connection reset by peer"); the request never reached ot-heavy, yet ot-run ended NOT RUN 255 and
# canary clients died.  A connection that failed before any remote output is retried with backoff, then fails as before.
SSH_CONNFAIL = ("kex_exchange_identification", "Connection reset by", "Connection timed out", "Connection refused",
                "Connection closed by", "banner exchange", "ssh_exchange_identification")
SSH_RETRY_BACKOFF_S = tuple(int(x) for x in os.environ.get("OT_RUN_SSH_BACKOFF", "5,15,45").split(",") if x)
LAST_RUN = dict(connfail=False)
# DIE_RESERVE_1101 (FLOW-21): the waiter learns when this request was first made, so a REBALANCE re-try (a new ot-heavy
# process every REQUEUE_S) keeps its age for the hub die reservation (ot-reserve / ot-heavy-reconcile --die-waiters).
RUN_T0 = time.time()


def admission_unit(line, tag):
 if 'OT_RUN_START' in line and tag in line:
  m=re.search(r'\both-[A-Za-z0-9_-]+\b',line)
  return m.group(0) if m else '?'
 m=re.fullmatch(r'ot-heavy: admitted on [^\s]+ as (oth-[A-Za-z0-9_-]+) after [0-9]+ s(?: OT_RUN_START [^\s]+)?\s*',line)
 return m.group(1) if m else None


def run(host, mem, cmd, d=None, max_wait=None, env="", quiet=False, quiet_notrun=False, on_start=None, disk=None):
