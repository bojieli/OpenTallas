SIGNAL_LOG = os.path.expanduser("~/.local/state/ot-run/signals.log")


def proc_args(pid):
    try:
        return [x.decode(errors="replace") for x in open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0") if x]
    except OSError:
        return []


def sender(pid):
    """who sent the signal: pid + command line (the culprit of a cross-lane pattern kill)"""
    try:
        pp = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        par = f"; parent {pp} ({' '.join(proc_args(pp))[-300:]})"
    except (OSError, ValueError, IndexError):
        par = ""
    return f"pid {pid} ({' '.join(proc_args(pid))[:300] or 'exited'}{par})"


def log_signal(line):
    try:
        os.makedirs(os.path.dirname(SIGNAL_LOG), exist_ok=True)
        with open(SIGNAL_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + line + "\n")
    except OSError:
        pass


def clients():
    """local ot-run job clients: pid -> (args after ot-run, --dir or None)"""
    out = {}
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == os.getpid():
            continue
        a = proc_args(p)
        i = next((k for k, x in enumerate(a[:3]) if os.path.basename(x) == "ot-run"), None)
        if i is None or "--" not in a or "--cancel" in a[i + 1:i + 2]:
            continue
        rest = a[i + 1:]
        opts = rest[:rest.index("--")]
        out[int(p)] = (rest, opts[opts.index("--dir") + 1] if "--dir" in opts[:-1] else None)
    return out


def cancel(sub, all_dirs):
    hit = {p: v for p, v in clients().items() if sub in " ".join(v[0])}
    dirs = sorted({str(v[1]) for v in hit.values()})
    for p, (rest, d) in sorted(hit.items()):
        print(f"ot-run --cancel: pid {p} dir {d}: {' '.join(rest)[:200]}")
    if not hit:
        print(f"ot-run --cancel: no local ot-run client matches {sub!r}")
        return 1
    if len(dirs) > 1 and not all_dirs:
        print(f"ot-run --cancel: REFUSED: {sub!r} matches {len(hit)} clients in {len(dirs)} different --dir values "
              f"({', '.join(dirs)[:400]}); other lanes' jobs would die.  Use a substring unique to your job (its --dir or "
              f"script path), kill your exact pid, or pass --all-dirs after reading the list.  Nothing killed.")
        return 2
    for p in hit:
        try:
            os.kill(p, signal.SIGTERM)
        except OSError:
            pass
    print(f"ot-run --cancel: SIGTERM sent to {len(hit)} client(s); waiters are cancelled on their hosts, started commands keep running")
    log_signal(f"--cancel {sub!r} by pid {os.getpid()} parent {sender(os.getppid())}: {sorted(hit)}")
    return 0


def cancel_dir(path, reason=""):
    """COORD 11-11 15:5x: a queue job whose client is already gone (killed by exact pid, no `ot-run --cancel`) stays ORPHAN for
    ORPHAN_IDLE_S = 3 h before the autopilot classifies it.  This writes the ONE line autopilot.signals_cancel() accepts for
    the job's kit path: ' signal N from <sender incl. "ot-run --cancel"> ... dir <path>: <text>'.  No process is signalled."""
    p = path.split(":", 1)[1] if re.match(r"^[A-Za-z0-9_.-]+:/", path) else path
    p = os.path.normpath(p)
    if not p.startswith("/"):
        print(f"ot-run --cancel-dir: {path!r} is not an absolute kit path")
        return 2
    live = {pid: v for pid, v in clients().items() if v[1] and os.path.normpath(v[1]) == p}
    if live:
        print(f"ot-run --cancel-dir: REFUSED: live local ot-run client(s) {sorted(live)} still have --dir {p}; use `ot-run --cancel` for them.  Nothing written.")
        return 2
    why = " ".join((reason or "client already gone").split())[:200]
    # the sender text names this command itself ("ot-run --cancel-dir"), not whatever argv this process was started with, so the
    # line is accepted by autopilot.signals_cancel() whether this runs from the CLI or as a library
    # one physical line: the parent command line may hold newlines (a heredoc or a multi-line ssh command), and signals_cancel()
    # reads signals.log line by line, so a split record would never match
    who = " ".join(f"pid {os.getpid()} (ot-run --cancel-dir {p}; invoked by {sender(os.getppid())})".split())
    log_signal(f"signal 15 from {who} -> ot-run pid 0 host - tag cancel-dir DEAD-CLIENT dir {p}: {why}")
    print(f"ot-run --cancel-dir: wrote the cancel record for {p} to {SIGNAL_LOG}; the autopilot classifies the job CANCELLED at its next poll")
    return 0


