def spill_written_listing(roots, stamp, held=""):
    """New paths, ordinary writes and required seed metadata; no payload hashing."""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    finder = f"find {rels} ! -name {SPILL_MARK} {held} \\( -type f -o -type l \\) -print0"
    args = " ".join(shlex.quote(x) for x in (stamp,) + SPILL_REQUIRED_METADATA)
    return finder + " | python3 -c " + shlex.quote(SPILL_SELECT_PY) + " " + args


def spill_fwd_cmd(src, dst, roots, stamp, listed=False, metadata_scope=None):
    """src -> dst copy.  v10: on dst the marker is written BEFORE extraction, so a failed or partial copy is never a
    'real' data host for normal placement (v8 wrote it after a successful tar: a failed copy left an UNMARKED tree, the next
    re-place ran the job there as a normal job and nothing copied its outputs back); a lane root that exists unmarked on
    dst is real lane data there -> exit 3 (refused, never marked/overwritten); extraction holds the per-lane flock."""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    pre = " ".join(f"if test -e {shlex.quote(r)} && ! test -e {shlex.quote(r + '/' + SPILL_MARK)}; then echo OT_SPILL_REAL "
                   f"{shlex.quote(r)} >&2; exit 3; fi; mkdir -p {shlex.quote(r)} && echo {src} > {shlex.quote(r + '/' + SPILL_MARK)} || exit 4;"
                   if spill_root(r) == os.path.normpath(r) else stage_pre(src, r)
                   for r in sorted(roots, key=lambda x: os.path.normpath(x) not in STAGE_FILES))   # files first: a staged dir's mkdir -p must not create a file's parent
    scopes = [os.path.normpath(metadata_scope)] if metadata_scope else roots
    scope_json = shlex.quote(json.dumps(scopes))
    dcmd = (f"{pre} {tar_x(roots)} && cd / && "
            f"find {rels} ! -name {SPILL_MARK} \\( -type f -o -type l \\) -print0 > {shlex.quote(stamp + '.inputs')} "
            f"&& printf %s {scope_json} > {shlex.quote(stamp + '.scope')} && touch {stamp}")
    stc = "cd / && tar --null --no-recursion -T - -cf - | zstd -q -1 -T8" if listed else f"tar -C / -cf - {rels} | zstd -q -1 -T8"
    return (f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(stc)}" + (f" < {shlex.quote(listed)}" if listed else "") + " | "
            f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(dcmd)}")


def spill_manifest(host, roots):
    """{relpath: (type, size, mtime)} of the roots on host (missing roots: nothing)"""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    r = subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "BatchMode=yes", host,
                        f"cd / && for r in {rels}; do test -e $r && find $r -printf '%y %s %T@ %p\\0'; done; true"],
                       capture_output=True, timeout=3600)
    if r.returncode:
        raise RuntimeError(f"manifest on {host}: {r.stderr.decode(errors='replace')[-160:]}")
    out = {}
    for e in r.stdout.split(b"\0"):
        if e:
            y, sz, mt, path = e.split(b" ", 3)
            out[path] = (y, int(sz), int(float(mt)))
    return out


def spill_delta(srcm, dstm):
    """v10 INCREMENTAL SPILL: what src must send = directories dst lacks + files/links dst lacks or holds older (tar keeps
    whole seconds, so compare seconds; same second but another size counts as changed).  Existing directories are never
    sent, which also keeps tar 1.35 away from its existing-directory error."""
    send = []
    for p, (y, sz, mt) in srcm.items():
        d = dstm.get(p)
        if y == b"d":
            if d is None:
                send.append(p)
        elif d is None or mt > d[2] or (mt == d[2] and sz != d[1]):
            send.append(p)
    return sorted(send)


def spill_copy_fwd(src, dst, roots, stamp, metadata_scope=None):
    """-> subprocess.CompletedProcess-like (returncode, stderr, sent).  v10: only the delta travels (a die lane re-spilled
    to a host that holds its copy sends what changed), through the same marked/locked dst extraction as spill_fwd_cmd."""
    import tempfile
    try:
        delta = spill_delta(spill_manifest(src, roots), spill_manifest(dst, roots))
    except (RuntimeError, subprocess.SubprocessError, ValueError) as e:
        return subprocess.CompletedProcess([], 97, "", f"OT_SPILL_MANIFEST {str(e)[-200:]}")
    with tempfile.NamedTemporaryFile("wb", prefix="ot-run-spill-list.", delete=False) as f:
        f.write(b"".join(p + b"\0" for p in delta))
    try:
        cmd = spill_fwd_cmd(src, dst, roots, stamp, listed=f.name, metadata_scope=metadata_scope)
        r = subprocess.run(["bash", "-o", "pipefail", "-c", cmd], capture_output=True, text=True)
    finally:
        os.unlink(f.name)
    r.sent = len(delta)
    return r


def spill_back_cmd(src, dst, roots, stamp, only=None):
    """dst -> src: written/new paths and required seed metadata.  The stamp is removed only after src extracted it
    (v8 removed it on dst even when the src side failed, so a retry had nothing to compare against).
    only (SPILL-PROOF-1, after a hand-off): exactly these paths, whatever their age; nothing else ever comes back."""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    listing = (f"{{ {handoff_paths_listing(only)}; }}" if only else
               spill_written_listing(roots, stamp))
    dcmd = (f"test -e {stamp} || {{ echo OT_SPILL_NOSTAMP >&2; exit 5; }}; cd / && {listing} | tar --null -T - -cf - | zstd -q -1 -T8")
    scmd = tar_x(roots)
    return (f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(dcmd)} | "
            f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(scmd)}")


def pending_write(rec):
    try:
        os.makedirs(SPILL_PENDING, exist_ok=True)
        tmp = os.path.join(SPILL_PENDING, rec["tag"] + ".tmp")
        with open(tmp, "w") as f:
            json.dump(rec, f)
        os.replace(tmp, os.path.join(SPILL_PENDING, rec["tag"] + ".json"))
    except OSError:
        pass


# AUTOCLEAN-3 11-07: tar --keep-newer-files treats a partial left by a dead back-copy as newer than its source, so a retry skipped it
# and the record went .done with truncated results (t36 6_1_fill.odb 1678 of 2683 MB, t43 6_final.odb, found by hand).  After the
# copy: a file on src that is SHORTER and NEWER than dst, and is an exact prefix of it, is such a partial and is copied again.
# A file that differs in any other way was written on src on purpose and stays.
SPILL_STAT_PY = r"""
import json, os, sys
for p in sys.stdin.buffer.read().split(b"\0"):
    if p:
        try:
            st = os.lstat(p)
        except OSError:
            continue
        print(json.dumps([os.fsdecode(p), st.st_size, int(st.st_mtime)]))
"""
SPILL_SHORTER_PY = r"""
import json, os, sys
for line in sys.stdin:
    p, size, mtime = json.loads(line)
    try:
        st = os.lstat(p)
    except OSError:
        continue
    if st.st_size < size and int(st.st_mtime) > mtime:
        print(json.dumps([p, st.st_size]))
"""


def spill_find_partials(src, dst, roots, stamp, only=None):
    """-> paths (relative to /) that are partials on src"""
    listing = f"{{ {handoff_paths_listing(only)}; }}" if only else spill_written_listing(roots, stamp)
    dcmd = f"cd / && {listing} | python3 -I -c {shlex.quote(SPILL_STAT_PY)}"
    scmd = f"cd / && python3 -I -c {shlex.quote(SPILL_SHORTER_PY)}"
    r = subprocess.run(["bash", "-o", "pipefail", "-c",
                        f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(dcmd)} | "
                        f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(scmd)}"], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(f"partial check: {r.stderr.strip()[-160:]}")
    out = []
    for ln in r.stdout.splitlines():
        rel, n = json.loads(ln)
        q = shlex.quote(rel)
        want = f"cd / && head -c {int(n)} {q} | sha256sum"
        a, b = ssh_sh(src, want, timeout=1800), ssh_sh(dst, want, timeout=1800)
        if a.returncode == 0 and a.stdout.split()[:1] == b.stdout.split()[:1]:
            out.append(rel)
    return out


def spill_repair_partials(src, dst, roots, stamp, only=None, say=lambda m: None):
    """-> "" when no partial is left on src, else the error"""
    try:
        bad = spill_find_partials(src, dst, roots, stamp, only)
        if not bad:
            return ""
        say(f"ot-run: SPILL back-copy {dst} -> {src}: {len(bad)} partial file(s) from an earlier copy, copying again: {bad[0][-80:]}")
        files = " ".join(shlex.quote(x) for x in bad)
        scmd = tar_x(roots).replace("--keep-newer-files ", "")
        c = subprocess.run(["bash", "-o", "pipefail", "-c",
                            f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(f'cd / && tar -cf - {files} | zstd -q -1 -T8')} | "
                            f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(scmd)}"], capture_output=True, text=True)
        if c.returncode:
            return f"{SPILL_PARTIAL} {c.stderr.strip()[-160:]}"
        left = spill_find_partials(src, dst, roots, stamp, only)
        return f"{SPILL_PARTIAL} still short: {left[0][-80:]}" if left else ""
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as e:
        return f"{SPILL_PARTIAL} {str(e)[-160:]}"


def spill_back_reserve(src, dst, roots, stamp, tag, only, wait_s, say):
    """-> "" when the back-copy may start, else the reason.  Waits up to wait_s for room; an unknown answer never holds results back."""
    need = spill_back_size_gb(dst, roots, stamp, only)
    if need is None:
        return ""
    t0, said = time.time(), False
    while True:
        fits, why = spill_room(src, roots, need, SPILL_BACK_MARGIN_GB, tag=tag)
        if fits is not False:
            return ""
        if time.time() - t0 >= wait_s:
            return f"{SPILL_NOROOM} {why}"
        if not said:
            say(f"ot-run: SPILL back-copy {dst} -> {src} waits for room ({need:.1f} GB): {why}")
            said = True
        time.sleep(SPILL_BACK_ROOM_POLL_S)


def spill_copy_back(src, dst, roots, stamp, say=lambda m: None, only=None, wait_s=0):
    """-> (ok, error).  Retries; removes the dst stamp only after a successful copy.  No room on src: no writer starts, the error
    holds SPILL_NOROOM, the stamp and pending record stay and the sweep retries."""
    tag = "back-" + os.path.basename(stamp)
    noroom = spill_back_reserve(src, dst, roots, stamp, tag, only, wait_s, say)
    if noroom:
        return False, noroom
    try:
        return spill_copy_back_tries(src, dst, roots, stamp, say, only)
    finally:
        spill_room_release(src, tag)


def spill_copy_back_tries(src, dst, roots, stamp, say, only):
    err = ""
    for k in range(SPILL_BACK_TRIES):
        b = subprocess.run(["bash", "-o", "pipefail", "-c", spill_back_cmd(src, dst, roots, stamp, only)], capture_output=True, text=True)
        if not b.returncode:
            err = spill_repair_partials(src, dst, roots, stamp, only, say)
            if err:              # the stamp and the pending record stay: not completed
                say(f"ot-run: SPILL back-copy {dst} -> {src}: {err[-160:]}")
                return False, err
            ssh_sh(dst, f"rm -f {stamp} {stamp}.next {stamp}.inputs {stamp}.scope", timeout=60)
            return True, ""
        err = b.stderr.strip()[-300:]
        if "OT_SPILL_NOSTAMP" in err:
            break
        if k + 1 < SPILL_BACK_TRIES:
            say(f"ot-run: SPILL back-copy {dst} -> {src} failed (try {k + 1}/{SPILL_BACK_TRIES}): {err[-160:]}; retrying")
            time.sleep(10 * (k + 1))
    return False, err


# SPILL-PROOF-1 2026-11-04 (DIE-HBM-62/FLOW class SPILL-PROOF): a spilled PLACE client ends only when its proof-owner
# container ends, so the place receipt (K/physical_completion, lec_async.sh phase_done) reached the gen host 5-14 h late and
# route waited behind the pre-route LEC.  OT_RUN_SPILL_HANDOFF=<goal> (kit_wave PLACE; an old ot-run ignores it): the client
# watches the spill copy for a fresh rc 0 receipt of that goal with its proof still pending and hands the PHYSICAL result to
# the source host while the proof stays where it runs, admitted, in its own container:
#   1. dst: touch stamp.next (before the copy, so nothing written during it is lost)
#   2. every written file except the proof's own files and the receipts goes back, sub-second mtimes kept (--format=posix:
#      the receipt binds the checkpoint's mtime_ns)
#   3. src: K/.ot-run-proof-away, lec_async.pid removed (that pid is on dst; lec_async.sh finish then waits for lec_async.done
#      instead of testing a foreign pid); the pending record gets late = the proof's files; dst: stamp.next -> stamp
#   4. the receipts go last: their arrival is what releases the wave, so everything they name is already there
# From then on the source copy is the kit's one physical /work and the spill copy holds only the proof.  The final back-copy
# (client end or --spill-sweep) carries ONLY the proof's files, so it can never meet a route running on the source host.
# While K/.ot-run-proof-away stands and K/lec_async.done has not come back, spill_plan refuses to move K: the route of this kit
# runs on the source host (a spill to dst would be a second flow on the proof's /work; one elsewhere would never see the
# verdict).  LEC identity, sign-off and the routed LEC are untouched; lec_async.sh start on the source host reuses the proof by
# identity as on one host.  A proof that stops NOT EQUIVALENT reaches the source host at client end: the route is not stopped
# mid-run, but lec_async.sh finish returns the stop rc and no sign-off follows.  `ot-run --spill-handoff TAG` does the same
# hand-off once for a client already running (older code, same stamp semantics).
HANDOFF_ENV = "OT_RUN_SPILL_HANDOFF"
HANDOFF_POLL_S = float(os.environ.get("OT_RUN_SPILL_HANDOFF_POLL_S", "60"))
HANDOFF_TRIES = 3
PROOF_AWAY = ".ot-run-proof-away"
PROOF_FILES = ("lec", "lec_run.log", "lec_async.log", "lec_async.rc", "lec_async.stop", "lec_async.done", "FAIL_PREFLOOR")
HANDOFF_RECEIPTS = "physical_completion"
HANDOFF_HELD = PROOF_FILES + ("lec_async.pid", "lec_async.lock", HANDOFF_RECEIPTS)
HANDOFF_STOPS = ("lec_async.stop", "FAIL_PREFLOOR", "FAIL_POSTCTS")
PAX_TAR = "tar --format=posix --pax-option=delete=atime,delete=ctime --null -T - -cf -"


def handoff_state_cmd(kit, stamp):
    """dst: NOSTAMP / STOP markers + every receipt of this run (newer than the stamp), one JSON document per line"""
    q = shlex.quote(kit)
    return (f"test -e {shlex.quote(stamp)} || echo OT_NOSTAMP; "
            + "".join(f"test -e {q}/{m} && echo OT_STOP; " for m in HANDOFF_STOPS)
            + f"test -d {q}/{HANDOFF_RECEIPTS} && find {q}/{HANDOFF_RECEIPTS} -maxdepth 1 -name '*.json' -newer {shlex.quote(stamp)} "
              "-exec sh -c 'for f; do tr -d \"\\n\" < \"$f\"; echo; done' sh {} +; true")


def handoff_due(out, goal):
    """the hand-off is due: a fresh rc 0 receipt of goal with its proof still running, and nothing has stopped the kit.  A
    finished proof means the client ends by itself and copies back as usual."""
    due = False
    for ln in (out or "").splitlines():
        if ln.strip() in ("OT_NOSTAMP", "OT_STOP"):
            return False
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        if (isinstance(r, dict) and r.get("schema") == "opentallas.physical_completion.v1" and r.get("goal") == goal
                and r.get("rc") == 0 and r.get("proof_pending") is True):
            due = True
    return due


def handoff_files_cmd(src, dst, roots, listing):
    """dst -> src under the per-lane flock; listing prints NUL-separated paths relative to /.  pipefail on dst too: a file that
    cannot be read fails this step instead of being left out silently."""
    dcmd = f"set -o pipefail; cd / && {{ {listing}; }} | {PAX_TAR} | zstd -q -1 -T8"
    return (f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote('bash -c ' + shlex.quote(dcmd))} | "
            f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(tar_x(roots))}")


def handoff_physical_listing(roots, kit, stamp):
    """every file the run wrote, without the proof's files and the receipts"""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    k = kit.lstrip("/")
    held = " ".join(f"! -path {shlex.quote(k + '/' + h)} ! -path {shlex.quote(k + '/' + h + '/*')}" for h in HANDOFF_HELD)
    return spill_written_listing(roots, stamp, held)


def handoff_paths_listing(paths, older_than=None):
    """the files below paths (absolute); older_than: only those not changed since that stamp"""
    age = f"! -newer {shlex.quote(older_than)} " if older_than else ""
    return "; ".join(f"if test -e {shlex.quote(p.lstrip('/'))}; then find {shlex.quote(p.lstrip('/'))} {age}! -name {SPILL_MARK} "
                     "\\( -type f -o -type l \\) -print0; fi" for p in paths) + "; true"


def handoff_pipe(cmd, what, say, tries=HANDOFF_TRIES):
    err = ""
    for k in range(tries):
        b = subprocess.run(["bash", "-o", "pipefail", "-c", cmd], capture_output=True, text=True)
        if not b.returncode:
            return True
        err = b.stderr.strip()[-200:]
        if k + 1 < tries:
            time.sleep(10 * (k + 1))
    say(f"ot-run: SPILL hand-off: {what} failed: {err}")
    return False


def spill_handoff(src, dst, roots, kit, stamp, rec, say, snapshot=False):
    """steps 1-4 above -> True when the receipts are on src.  False before step 3: src holds extra physical files only, no
    receipt, nothing released, and the usual full back-copy still happens at client end.  snapshot (--spill-handoff, a client
    whose final back-copy is 'newer than the stamp' only): the proof's files so far travel now as well."""
    nxt, q = stamp + ".next", shlex.quote(kit)
    if not rec.get("late"):
        r = ssh_sh(dst, f"test -e {shlex.quote(stamp)} && touch {shlex.quote(nxt)}", timeout=120)
        if r.returncode:
            say(f"ot-run: SPILL hand-off: no stamp on {dst}: {r.stderr.strip()[-160:]}")
            return False
        if not handoff_pipe(handoff_files_cmd(src, dst, roots, handoff_physical_listing(roots, kit, stamp)), "physical copy", say):
            return False
        late = [os.path.join(kit, f) for f in PROOF_FILES]
        if snapshot and not handoff_pipe(handoff_files_cmd(src, dst, roots, handoff_paths_listing(late, older_than=nxt)),
                                         "proof snapshot", say):
            return False
        r = ssh_sh(src, f"echo {shlex.quote(dst)} > {q}/{PROOF_AWAY} && rm -f {q}/lec_async.pid", timeout=120)
        if r.returncode:
            say(f"ot-run: SPILL hand-off: cannot mark {kit} on {src}: {r.stderr.strip()[-160:]}")
            return False
        rec.update(late=late, kit=kit, handoff=int(time.time()))
        pending_write(rec)
        r = ssh_sh(dst, f"mv -f {shlex.quote(nxt)} {shlex.quote(stamp)}", timeout=120)
        if r.returncode:
            say(f"ot-run: SPILL hand-off: stamp not advanced on {dst}: {r.stderr.strip()[-160:]}")
            return False
    if not handoff_pipe(handoff_files_cmd(src, dst, roots, handoff_paths_listing([os.path.join(kit, HANDOFF_RECEIPTS)])),
                        "receipt copy", say):
        return False
    say(f"ot-run: SPILL hand-off: physical result of {kit} on {src}; the proof stays on {dst}, its files follow at client end")
    log_signal(f"SPILL-HANDOFF {kit} {dst} -> {src} pid {os.getpid()}")
    return True


def handoff_watch(src, dst, roots, kit, goal, stamp, rec, stop, say):
    """client thread beside run(): at most HANDOFF_TRIES hand-off attempts; any doubt leaves the full back-copy at client end"""
    tries = 0
    while not stop.wait(HANDOFF_POLL_S):
        try:
            r = ssh_sh(dst, handoff_state_cmd(kit, stamp), timeout=120)
            if r.returncode or not handoff_due(r.stdout, goal):
                continue
            if spill_handoff(src, dst, roots, kit, stamp, rec, say):
                return
            tries += 1
            if tries >= HANDOFF_TRIES:
                return
        except Exception as e:
            say(f"ot-run: SPILL hand-off check: {str(e)[:160]}")


def proof_away(src, paths):
    """a staged kit whose proof still runs on another host: never moved (fail closed on an unreachable source)"""
    r = ssh_sh(src, "for p in " + " ".join(shlex.quote(x) for x in paths) + f"; do test -e $p/{PROOF_AWAY} && ! test -e $p/lec_async.done "
                    "&& { cat $p/" + PROOF_AWAY + "; echo AWAY; }; done; echo OK", timeout=60)
    return r.returncode != 0 or "OK" not in r.stdout or "AWAY" in r.stdout


def spill_handoff_cli(tag, goal="place", dry=False, say=print):
    """ot-run --spill-handoff TAG [--goal G] [--dry-run]: one hand-off for a running spilled client (its pending record on this
    host).  Touches no unit and no container.  Only with the proof running and a fresh receipt; repeating it only re-sends the
    receipts."""
    p = os.path.join(SPILL_PENDING, tag + ".json")
    try:
        with open(p) as fh:
            rec = json.load(fh)
    except (OSError, ValueError) as e:
        say(f"ot-run --spill-handoff: no record {tag}: {e}")
        return 2
    if not pid_alive(rec["pid"]):
        say(f"ot-run --spill-handoff: client {rec['pid']} is gone: --spill-sweep owns this record")
        return 2
    src, dst, roots, stamp = rec["src"], rec["dst"], rec["roots"], rec["stamp"]
    kit = rec.get("kit") or next((r for r in roots if not r.endswith(".sh")), roots[0])
    r = ssh_sh(dst, handoff_state_cmd(kit, stamp), timeout=120)
    if not rec.get("late") and (r.returncode or not handoff_due(r.stdout, goal)):
        say(f"ot-run --spill-handoff: {tag}: not due on {dst} (no fresh rc 0 {goal} receipt with a pending proof, or a stop mark)")
        return 3
    if dry:
        listing = handoff_physical_listing(roots, kit, stamp).replace("-print0", "-printf '%s\\n'")
        c = ssh_sh(dst, f"cd / && {listing} | awk '{{n++; s+=$1}} END {{print n+0, s+0}}'", timeout=300)
        say(f"ot-run --spill-handoff: {tag}: DRY {dst} -> {src} {kit}: physical files/bytes {c.stdout.strip()}, already handed off: {bool(rec.get('late'))}")
        return 0
    return 0 if spill_handoff(src, dst, roots, kit, stamp, rec, say, snapshot=True) else 1


SPILL_REFUSED_REAL = False   # the last forward copy was refused with OT_SPILL_REAL


def spill_run(src, dst, roots, size_gb, mem, cmd, d, max_wait, say, disk=None):
    """copy the roots src->dst, run there, copy the files the run wrote back to src.  Returns the exit status, or None
    when the copy failed or (QUEUE-BAL-1) dst did not admit it within REQUEUE_S (nothing ran; the caller places again).  v10: the forward copy is marked first, serialised per lane and retried; a
    pending record (~/.local/state/ot-run/spill_pending) survives a killed client, and `ot-run --spill-sweep` copies the
    outputs back once the unit has ended; a back-copy that keeps failing is retried and logged to spill_stuck.log."""
    tag = "%d-%d" % (os.getpid(), int(time.time()))
    stamp = f"/tmp/ot-run-spill.{tag}"
    say(f"ot-run: SPILL: copying {', '.join(roots)} ({size_gb:.1f} GB) {src} -> {dst} (no host with --dir admits {mem} GB now)")
    t0 = time.time()
    fits, why = spill_room(dst, roots, size_gb + (disk or 0), SPILL_ROOM_MARGIN_GB, tag="fwd-" + tag)
    if fits is False:            # lost the race for that disk since spill_plan looked: nothing copied, the caller places again
        say(f"ot-run: SPILL to {dst} not started, no room: {why}")
        return None
    try:
        for k in range(SPILL_COPY_TRIES):
            r = spill_copy_fwd(src, dst, roots, stamp, metadata_scope=d)
            if not r.returncode or "OT_SPILL_REAL" in r.stderr:
                break
            if k + 1 < SPILL_COPY_TRIES:
                say(f"ot-run: SPILL copy {src} -> {dst} failed (try {k + 1}/{SPILL_COPY_TRIES}): {r.stderr.strip()[-160:]}; retrying")
                time.sleep(5 * (k + 1))
    finally:
        spill_room_release(dst, "fwd-" + tag)
    global SPILL_REFUSED_REAL
    SPILL_REFUSED_REAL = "OT_SPILL_REAL" in r.stderr
    if r.returncode:
        say(f"ot-run: SPILL copy {src} -> {dst} FAILED ({r.stderr.strip()[-200:]}); NOT RUN there (the partial copy on {dst} "
            f"is marked {SPILL_MARK}, so no job is placed on it)")
        log_signal(f"SPILL-COPY-FAILED {roots} {src} -> {dst} pid {os.getpid()}: {r.stderr.strip()[-160:]}")
        return None
    say(f"ot-run: SPILL: copied {r.sent} changed entries in {time.time() - t0:.0f} s; running on {dst}; written files go back to {src} after the run")
    log_signal(f"SPILL {roots} {src} -> {dst} pid {os.getpid()}: {' '.join(cmd)[:200]}")
    rec = dict(tag=tag, pid=os.getpid(), src=src, dst=dst, roots=roots, stamp=stamp, unit=None, t=int(time.time()),
               cmd=" ".join(cmd)[:300])
    pending_write(rec)

    def on_start(unit):
        rec["unit"] = unit
        pending_write(rec)
    stop_watch, watch = threading.Event(), None
    goal = os.environ.get(HANDOFF_ENV)
    if goal and d and under(d, roots):           # SPILL-PROOF-1: physical result to src while the proof stays here
        watch = threading.Thread(target=handoff_watch, args=(src, dst, roots, os.path.normpath(d), goal, stamp, rec, stop_watch, say),
                                 daemon=True)
        watch.start()
    # QUEUE-BAL-1: the spilled waiter is bounded by REQUEUE_S like any other (it waited unbounded: 96 waiters stuck on
    # intel1 up to 9.6 h); not admitted in time -> None, and the caller places the job again (a re-spill is incremental)
    wait = REQUEUE_S if max_wait is None else min(REQUEUE_S, max_wait)
    rc, ran = run(dst, mem, cmd, d, wait, on_start=on_start, disk=disk, quiet_notrun=(wait != max_wait))
    if watch:                                    # a hand-off in progress finishes before any back-copy
        stop_watch.set()
        watch.join()
    if not ran and rec["unit"] is None:          # never started: nothing to copy back
        ssh_sh(dst, f"rm -f {stamp}", timeout=60)
        try:
            os.unlink(os.path.join(SPILL_PENDING, tag + ".json"))
        except OSError:
            pass
        if rc == 75 and wait != max_wait:
            say(f"ot-run: REBALANCE: spilled job not admitted on {dst} within {wait} s; placing again")
            return None
        return rc or 255
    if not ran:                                  # started, connection lost: it may still run; the sweep copies back later
        say(f"ot-run: SPILL: outputs stay on {dst} until the unit ends; `ot-run --spill-sweep` copies them back to {src}")
        return rc or 255
    ok, err = spill_copy_back(src, dst, roots, stamp, say, only=rec.get("late"), wait_s=SPILL_BACK_ROOM_WAIT_S)
    if not ok:
        say(f"ot-run: SPILL back-copy {dst} -> {src} FAILED ({err[-200:]}); outputs are on {dst}: NOT COMPLETED "
            f"(recorded in {SPILL_STUCK_LOG}; `ot-run --spill-sweep` retries)")
        try:
            with open(SPILL_STUCK_LOG, "a") as f:
                f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + json.dumps(rec) + " " + err[-200:].replace("\n", " ") + "\n")
        except OSError:
            pass
        return rc or 98
    try:
        os.unlink(os.path.join(SPILL_PENDING, tag + ".json"))
    except OSError:
        pass
    say(f"ot-run: SPILL: outputs copied back {dst} -> {src}; RAN on {dst}: exit {rc}")
    spill_drop_stage(dst, roots, say)
    return rc


def spill_stage_protected(r):
    """True when PROTECTED-DBS.txt names r, a path inside r or a parent of r.  Unreadable list = protected (keep the copy)."""
    try:
        lines = open(os.path.expanduser("~/coord/PROTECTED-DBS.txt")).read().splitlines()
    except OSError:
        return True
    base = r.rstrip("/")
    for ln in lines:
        for w in ln.split():
            w = w.split(":", 1)[1] if re.match(r"^[A-Za-z0-9_.-]+:/", w) else w
            if w.startswith("/") and (w.rstrip("/") == base or w.startswith(base + "/") or base.startswith(w.rstrip("/") + "/")):
                return True
    return False


# KW-FIX-5 11-04 (DIE-KV-65 read in the code): two jobs can --stage the same dir (a shared tools dir).  Keep the copy while any other
# process names it in its command line or runs inside it, or a container mounts it; a docker that cannot answer keeps it too.
SPILL_BUSY_PY = r"""
import os, shutil, subprocess, sys
r = sys.argv[1].rstrip("/")
me, p = set(), os.getpid()
while p > 1:
    me.add(p)
    try:
        p = int(open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        break
for d in os.listdir("/proc"):
    if not d.isdigit() or int(d) in me:
        continue
    try:
        cmd = open(f"/proc/{d}/cmdline", "rb").read()
        cwd = os.readlink(f"/proc/{d}/cwd")
    except OSError:
        continue
    if r.encode() in cmd or cwd == r or cwd.startswith(r + "/"):
        sys.exit(1)
if shutil.which("docker"):
    q = subprocess.run(["docker", "ps", "-q"], capture_output=True, text=True)
    if q.returncode:
        sys.exit(1)
    if q.stdout.split():
        m = subprocess.run(["docker", "inspect", "-f", "{{range .Mounts}}{{.Source}}\\n{{end}}", *q.stdout.split()], capture_output=True, text=True)
        if m.returncode or any(x == r or x.startswith(r + "/") for x in m.stdout.split()):
            sys.exit(1)
"""


def spill_drop_cmd(r, mk, mk2):
    """the remote command: no depth limit (ECO records sit at K/eco_<stamp>/i<n>/signoff/signoff.json), any .keep or SIGNED
    signoff.json anywhere keeps the copy, and a find that fails keeps it too (fail closed)."""
    q = shlex.quote(r)
    return (f"test -d {q} && {{ test -e {mk} || test -e {mk2}; }} && "
            f"o=$(find {q} \\( -name .keep -print \\) -o \\( -name signoff.json -exec sh -c 'grep -l SIGNED \"$@\"; test $? -le 1' sh {{}} + \\)) && test -z \"$o\" "
            f"&& python3 -I -c {shlex.quote(SPILL_BUSY_PY)} {q} && rm -rf {q} && echo DROPPED")


def spill_drop_stage(dst, roots, say=lambda m: None):
    """KW-FIX-5 2026-11-03: a --stage copy is scratch once its outputs are back (kit-wave left ~2-30 GB per spilled kit on the
    destination, COORD disk order).  Only --stage directories below a lane root that carries the spill marker, never one
    holding a SIGNED signoff.json or a .keep at any depth, and never a PROTECTED-DBS entry (COORD 00:0x)."""
    if not STAGE:
        return
    for r in roots:
        m = SCRATCH_RE.match(r)
        if not m or not m.group(2) or r.rstrip("/") == m.group(1) or spill_stage_protected(r):
            continue
        mk, mk2 = shlex.quote(m.group(1) + "/" + SPILL_MARK), shlex.quote(r + "/" + SPILL_MARK)
        try:
            if "DROPPED" in ssh_sh(dst, spill_drop_cmd(r, mk, mk2), timeout=300).stdout:
                say(f"ot-run: SPILL: dropped the stage copy {r} on {dst}")
                log_signal(f"SPILL-DROP {r} on {dst}")
        except Exception:
            pass


def pid_alive(pid):
    return any(os.path.basename(x) == "ot-run" for x in proc_args(pid)[:3])


def spill_sweep(dry=False, say=print):
    """copy back the outputs of spilled runs whose client is gone (killed agent, session limit, failed back-copy) once
    their unit has ended on dst.  Returns the number of records still pending."""
    try:
        names = sorted(f for f in os.listdir(SPILL_PENDING) if f.endswith(".json"))
    except OSError:
        names = []
    left = 0
    for f in names:
        p = os.path.join(SPILL_PENDING, f)
        try:
            with open(p) as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        if pid_alive(rec["pid"]):
            left += 1
            continue
        if rec.get("unit"):
            a = ssh_sh(rec["dst"], f"systemctl --user is-active {shlex.quote(rec['unit'])}", timeout=60).stdout.strip()
            if a in ("active", "activating", "deactivating", "reloading"):
                say(f"ot-run --spill-sweep: {rec['tag']} unit {rec['unit']} still {a} on {rec['dst']}")
                left += 1
                continue
        say(f"ot-run --spill-sweep: {rec['tag']} {rec['roots']} {rec['dst']} -> {rec['src']} (unit {rec.get('unit')})"
            + (" DRY" if dry else ""))
        if dry:
            left += 1
            continue
        ok, err = spill_copy_back(rec["src"], rec["dst"], rec["roots"], rec["stamp"], only=rec.get("late"))
        if ok or "OT_SPILL_NOSTAMP" in err:
            os.replace(p, p[:-5] + (".done" if ok else ".nostamp"))
            say(f"ot-run --spill-sweep: {rec['tag']} " + ("copied back" if ok else "no stamp on dst (copied before?)"))
        else:
            left += 1
            say(f"ot-run --spill-sweep: {rec['tag']} back-copy FAILED: {err[-200:]}")
    return left


def trigger_sweep():
    """every ot-run job client starts a detached --spill-sweep at most every SWEEP_EVERY_S when records are pending"""
    try:
        if not any(f.endswith(".json") for f in os.listdir(SPILL_PENDING)):
            return
        if time.time() - os.path.getmtime(SWEEP_STAMP) < SWEEP_EVERY_S:
            return
    except OSError:
        pass
    try:
        open(SWEEP_STAMP, "w").write("sweep\n")
        subprocess.Popen(["flock", "-n", SWEEP_STAMP + ".lock", sys.executable, os.path.realpath(__file__), "--spill-sweep"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


PLACE_NOTES = {}      # host -> why place() dropped it ('' = qualified); for the NOT RUN message
# QUEUE-BAL-2 11-05 (REFUSED-SOURCE SPILL): host -> probe row for every host that HAS --dir but was refused only for its
# disk (host_refusal: scratch floor / DISK GUARD, or --disk).  At 20:4x epyc4 (scratch2 100%, 11-26 GB) held the only copy
# of most kit-wave kits: place() dropped it, main() said 'NOT RUN: no host qualifies' and never tried SPILL, while
# epyc5/epyc6 (1.4 TB admit) sat idle.  Such a host is still a valid spill SOURCE (the copy only reads it).
REFUSED_SRC = {}
REFUSED_SRC_MIN_GB = int(os.environ.get("OT_RUN_REFUSED_SRC_MIN_GB", "5"))   # room left there for the back-copy


def place(hosts, d, disk, mem, quiet=False):
    """probe the hosts; return host -> row for every host that qualifies (dir, disk, physical RAM).  No load test."""
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, d), hosts))
    ok = {}
    REFUSED_SRC.clear()
    for h, r in res.items():
        note = "no " + str(d) if r is None else r.get("error") or ("disk %d GB < %d" % (r["disk_gb"], disk) if r["disk_gb"] < disk else "")
        if r and not r.get("error") and not note and not r.get("ncpu"):
            note = "probe without ncpu"
        if r and not r.get("error") and not physically_capable(r, mem):
            note = "request %d GB exceeds physical RAM after mandatory headroom" % mem
        if r and not r.get("error") and host_refusal(r):
            note = host_refusal(r)                      # v13 DISK GUARD / scratch-disk floor: refused, never queued here
        elif r and not r.get("error") and not note and dir_disk_full(r):
            note = dir_disk_full(r)                     # QUEUE-BAL-2: the host takes new work on scratch3, not this --dir
        if r and not r.get("error") and r["disk_gb"] < disk and trigger_reaper(h, note):
            note += " (ot-reaper started for this host)"
        if r and not r.get("error") and r.get("dir_onroot") and r.get("scratch_disk") and d and not quiet:
            print(f"ot-run: WARNING: {h}: --dir {d} is on the ROOT filesystem; move it to {r['scratch_disk']}/claude/<lane> "
                  f"(owner 2026-10-24: never use root disks for work)", file=sys.stderr)
        PLACE_NOTES[h] = note
        if r and not r.get("error"):
            if not quiet:
                print(f"ot-run: {h:14s} admits {r.get('admit_gb', r['free_gb']):5d} GB (avail {r['avail_gb']}, {memory_charge_note(r)}, headroom "
                      f"{r['headroom_gb']}, waiters {r['waiting']}/{r['waiting_gb']} GB) load {load1(r):.0f}/{r.get('ncpu', 0)} "
                      f"running {r['running']} disk {r['disk_gb']} GB {note}", file=sys.stderr)
            if not note:
                ok[h] = r
            elif d and r.get("ncpu") and note.startswith((host_refusal(r) or "\0", "disk ", DIR_FULL_NOTE)):
                REFUSED_SRC[h] = r                      # QUEUE-BAL-2: has the data, refused for disk only
        elif not quiet:
            print(f"ot-run: {h:14s} skipped: {note}", file=sys.stderr)
    return ok


