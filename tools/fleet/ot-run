def spill_back_size_gb(dst, roots, stamp, only=None):
    """GB the back-copy would write: the same listing the copy uses, summed on the spill host.  None = could not tell."""
    listing = f"{{ {handoff_paths_listing(only)}; }}" if only else spill_written_listing(roots, stamp)
    try:
