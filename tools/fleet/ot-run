def job_wrap(cmd, spec_path):
    """ISOLATE-1: the command as ot-job runs it on the host: ot-job run --spec-b64 <spec> -- <command>"""
    import base64
    try:
        with open(spec_path) as fh:
            spec = json.load(fh)
    except (OSError, ValueError) as e:
        sys.exit(f"ot-run: --job {spec_path}: {e}")
    if not isinstance(spec, dict) or spec.get("schema", JOB_SCHEMA) != JOB_SCHEMA or not spec.get("name"):
        sys.exit(f"ot-run: --job {spec_path}: not an {JOB_SCHEMA} spec with a name")
    if not cmd:
        sys.exit("ot-run: --job needs a command")
    b64 = base64.b64encode(json.dumps(spec, sort_keys=True, separators=(",", ":")).encode()).decode()
    return [JOB_BIN, "run", "--spec-b64", b64, "--"] + list(cmd)


