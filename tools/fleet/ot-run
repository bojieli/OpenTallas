                    say(f"ot-run: SPILL not possible: {why}")
                if os.environ.get("OT_RUN_SPILL_ONLY"):      # move tool: never queue a second waiter
                    say("ot-run: NOT RUN (OT_RUN_SPILL_ONLY and no spill)")
                    sys.exit(75)
                spill = spill and not permanent
        if not best:
            why = "; ".join(f"{h}: {PLACE_NOTES[h]}" for h in hosts if PLACE_NOTES.get(h)) or "no reachable host"
            sys.exit(f"ot-run: NOT RUN: no host qualifies ({why})")
        print(f"ot-run: -> {best}" + (f" (will queue: admits {ok[best].get('admit_gb', ok[best]['free_gb'])} GB < {mem} GB)" if queue else ""),
              file=sys.stderr)
        if pick:
            print(best)
            return
        left = None if max_wait is None else max(1, int(max_wait - (time.time() - t0) + 0.999))
        wait = left
        # REBALANCE: an unstarted waiter is re-placed after REQUEUE_S (v8: also to retry SPILL; v9: whenever the hosts
        # are not pinned, since the host table is re-read and memory may free up on a host that did not qualify before)
        if len(ok) > 1 or (spill and d) or not pinned:
            wait = REQUEUE_S if left is None else min(REQUEUE_S, left)
        rc, ran = run(best, mem, cmd, d, wait, quiet_notrun=(wait != left), disk=disk)
        if ran or rc != 75 or wait == left:
            sys.exit(rc if ran else (rc or 255))
        print(f"ot-run: REBALANCE: not admitted on {best} within {wait} s; placing again", file=sys.stderr)
        first = False


REAPER = os.path.expanduser("~/bin/ot-reaper.py")
REAP_STAMP = "/tmp/ot-run-reap-{host}.stamp"
REAP_EVERY_S = 1800


def trigger_reaper(host, why):
    """(ROOT-2130 2026-10-18, FLEET-DISK P6) a host refused for low disk starts `ot-reaper.py --host H` once (detached,
    flock; at most every REAP_EVERY_S per host) instead of only refusing: the cron run is every 30 min and EPYC4 sat at
    14-16 GB free (refused) with 444 GB of reapable gate bulk."""
    if not os.path.exists(REAPER):
        return False
    stamp = REAP_STAMP.format(host=host)
    try:
        if time.time() - os.path.getmtime(stamp) < REAP_EVERY_S:
            return False
    except OSError:
        pass
    try:
        open(stamp, "w").write(f"{why}\n")
        subprocess.Popen(["flock", "-n", f"/tmp/ot-run-reap-{host}.lock", sys.executable, REAPER, "--host", host],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        return False
    return True


SPILL_MARK = ".ot-run-spill-copy"
SPILL_HOSTS_EXCLUDE = {"localhost", "ot-pve1", "ot-agidock128"}          # small / shared hosts never receive spills
NO_AVX512 = {"epyc2", "epyc3", "ot-epyc7", "ot-epyc9"}                         # Zen 3: a -march=native build from Zen 4/5 would SIGILL there
SCRATCH_RE = re.compile(r"^(/srv/opentallas-scratch[^/]*/claude/[^/]+)(/|$)")


def load_spill_wanted(r, threads):
    """v11: a CPU-heavy job whose best --dir host would be past LOAD_SPILL_RATIO x cores"""
    return (not os.environ.get("OT_RUN_NO_LOAD_SPILL") and threads >= LOAD_SPILL_MIN_THREADS
            and ratio(r, threads) > LOAD_SPILL_RATIO)


def load_spill_neg(root, why=None):
    """v11 negative cache: why=None -> True when root was found unspillable in the last LOAD_SPILL_NEG_S; else record it"""
    f = os.path.join(LOAD_SPILL_NEG, re.sub(r"[^A-Za-z0-9_.+-]", "_", root.strip("/")))
    if why is None:
        try:
            return time.time() - os.path.getmtime(f) < LOAD_SPILL_NEG_S
        except OSError:
            return False
    try:
        os.makedirs(LOAD_SPILL_NEG, exist_ok=True)
        open(f, "w").write(why + "\n")
    except OSError:
        pass
    return True


def spill_root(d):
    """the unit a spill copies: the lane directory under a scratch root's claude/, else --dir itself"""
    d = os.path.normpath(d)
    m = SCRATCH_RE.match(d)
    return m.group(1) if m else d


def ssh_sh(host, cmd, timeout=120):
    return subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", host, cmd],
                          capture_output=True, text=True, timeout=timeout)


SHARED_LANES = {"git-mirror", "flowhold", "ttbatch", "ttviews"}   # provisioned on every host: never copied
LANE_RE = re.compile(r"/srv/opentallas-scratch[^/\s'\";|&()<>]*/claude/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*")


def spill_paths_ok(cmd, d, root):
    """-> (reason, extra lane roots).  /srv paths the command names must lie in a lane root (copied with it);
    '../' only when --dir is below its root"""
    j, extra = " ".join(cmd), set()
    for p in re.findall(r"/srv/[^\s'\";|&()<>]*", j):
        p = os.path.normpath(p)
        if p == root or p.startswith(root + "/"):
            continue
        m = SCRATCH_RE.match(p)
        if not m:
            return f"command names {p} outside a scratch lane", set()
        if m.group(1).rsplit("/", 1)[-1] not in SHARED_LANES:
            extra.add(m.group(1))
    if "../" in j and os.path.normpath(d) == root:
        return f"command uses ../ above {root}", set()
    return "", extra


def spill_scan(src, roots):
    """one ssh: size, absolute symlinks out of the roots, -march=native, scratch lanes named by lane scripts (depth <= 2:
    lane scripts and filelists, not a repo clone under the lane)"""
    qs = " ".join(shlex.quote(r) for r in roots)
    inside = " ".join(f"! -lname {shlex.quote(r + '/*')}" for r in roots)
    scripts = (f"find {qs} -maxdepth 2 -size -2M -type f \\( -name 'Makefile*' -o -name '*.mk' -o -name '*.sh' -o -name '*.py' "
               f"-o -name '*.f' -o -name '*.tcl' -o -name '*.json' -o -name '*.yaml' -o -name '*.cfg' \\) -print0 | "
               f"timeout 90 xargs -0r grep -hoIs -E ")
    r = ssh_sh(src, f"for r in {qs}; do test -d $r || echo MISSING $r; done; du -scb {qs} | tail -1 | cut -f1; "
                    f"find {qs} -type l -lname '/*' {inside} -printf '%p\\t%l\\n' | head -50; echo ==; {scripts} 'march=native' | head -1; echo ==; "
                    f"{scripts} {shlex.quote(LANE_RE.pattern)} | sort -u | head -50", timeout=300)
    head, tail, ext = (r.stdout.split("==\n") + ["", ""])[:3]
    lines = [x for x in head.split("\n") if x.strip()]
    missing = [x.split(None, 1)[1] for x in lines if x.startswith("MISSING ")]
    lines = [x for x in lines if not x.startswith("MISSING ")]
    lanes = {SCRATCH_RE.match(x).group(1) for x in ext.split() if SCRATCH_RE.match(x)}
    lanes = {x for x in lanes if x.rsplit("/", 1)[-1] not in SHARED_LANES}
    sym = ""
    names = {r.rsplit("/", 1)[-1] for r in roots}
    for x in lines[1:]:          # v12 SCRATCH2: a symlink into the lane's twin root (same lane, other scratch root) adds it
        p, _, t = x.partition("\t")
        m = SCRATCH_RE.match(os.path.normpath(t)) if t else None
        if m and m.group(1).rsplit("/", 1)[-1] in names:
            lanes.add(m.group(1))
        elif not sym:
            sym = p
    return missing, int(lines[0]) / 1e9, sym, bool(tail.strip()), lanes


def spill_plan(src, d, cmd, mem, threads, die, disk, held, say, max_ratio=None):
    """-> ((dst, roots, size_gb), "", False) or (None, reason, permanent).  The roots are --dir's lane root plus every
    scratch lane the command or the lane's scripts name (closed under that relation, <= 4 lanes)"""
    root = spill_root(d)
    why, extra = spill_paths_ok(cmd, d, root)
    if why:
        return None, why, True
    roots = {root} | extra
    try:
        for _ in range(3):
            missing, size_gb, sym, native, lanes = spill_scan(src, sorted(roots))
            if lanes <= roots:
                break
            roots |= lanes
        else:
            return None, f"lane references keep growing ({len(roots)} lanes)", True
    except Exception as e:
        return None, f"cannot scan {sorted(roots)} on {src}: {str(e)[:80]}", True
    if missing:
        return None, f"{src} lacks {', '.join(missing[:3])} (data not on the queue host)", True
    if len(roots) > 4:
        return None, f"{len(roots)} lanes referenced ({', '.join(sorted(roots)[:5])})", True
    cap = SPILL_MAX_DIE_GB if die else SPILL_MAX_GB
    if size_gb > cap:
        return None, f"{', '.join(sorted(roots))} total {size_gb:.0f} GB > {'OT_RUN_SPILL_MAX_DIE_GB' if die else 'OT_RUN_SPILL_MAX_GB'} {cap}", True
    if sym:
        return None, f"absolute symlink out of the lane(s): {sym[:120]}", True
    bases = sorted({r.rsplit("/claude/", 1)[0] if SCRATCH_RE.match(r) else os.path.dirname(r) for r in roots})
    cands = [h for h in HOSTS if h != src and h not in SPILL_HOSTS_EXCLUDE and h not in held
             and not (native and h in NO_AVX512)]
    if not cands:
        return None, "no spill host", False
    with cf.ThreadPoolExecutor(len(cands)) as ex:
        res = dict(ex.map(lambda h: (h, [probe(h, b)[1] for b in bases]), cands))
    ok = {h: rs[0] for h, rs in res.items() if all(r and not r.get("error") for r in rs) and rs[0].get("ncpu")
          and min(r["disk_gb"] for r in rs) >= disk + size_gb and physically_capable(rs[0], mem) and not host_refusal(rs[0])
          and (max_ratio is None or ratio(rs[0], threads) <= max_ratio)}
    dst, queue = choose(drop_low_disk(ok, die, disk + size_gb), mem, threads, die)
    if not dst or queue:
        return None, "no spill host admits it now", False
    return (dst, sorted(roots), size_gb), "", False


SPILL_PENDING = os.path.expanduser("~/.local/state/ot-run/spill_pending")
SPILL_STUCK_LOG = os.path.expanduser("~/.local/state/ot-run/spill_stuck.log")
SPILL_COPY_TRIES, SPILL_BACK_TRIES = 3, 4
SWEEP_STAMP, SWEEP_EVERY_S = "/tmp/ot-run-spill-sweep.stamp", 600


def spill_lock(roots):
    """one flock file per lane-root set on a host: concurrent spills of the same lane (MU-SLICE-GATE 10-19 04:0x: b2 and
    faces0 spilled the same lane ot-epyc5 -> ot-epyc6 at once) must not extract into the same tree together -- two
    concurrent `tar --keep-newer-files -x` fail with 'Unexpected inconsistency when making directory'"""
    import hashlib
    return "/tmp/ot-run-spill-lock." + hashlib.sha1(" ".join(sorted(roots)).encode()).hexdigest()[:16]


# TAR 1.35 (OTRUN-SPILL 2026-10-19, the real cause of the MU-SLICE-GATE "SPILL copy FAILED"): GNU tar 1.35 (every fleet
# EPYC) with --keep-newer-files fails EVERY directory member that already exists ("tar: DIR: Unexpected inconsistency when
# making directory", exit 2) although it updates/keeps the files correctly -- so every spill of a lane to a host that
# already held a copy of it (a second job of the lane, a re-place) "failed".  --overwrite-dir / --no-overwrite-dir are
# refused together with --keep-newer-files, so the extraction filters exactly that error: it counts only for a path that
# is NOT a directory after the run; any other tar or zstd error still fails the copy.
# FLEET-NEW3 2026-10-24: Ubuntu 26.04 GNU tar 1.35 prefixes its messages "/usr/bin/tar: " (was "tar: "), so the
# forgiven existing-directory errors were not recognised and every re-spill FAILED (test_ot_run_spill 5 failures); the
# real tar now emits them itself, so the directory test is relative to the extraction root (cd /, as tar -C /).
TAR_X = ("cd / || exit 97; e=$(mktemp); zstd -q -d | tar -C / \"${OT_TAR_TRANSFORMS[@]}\" --keep-newer-files --warning=no-ignore-newer -xf - 2>$e; s=(${PIPESTATUS[@]}); "
         "if [ ${s[0]} -ne 0 ]; then cat $e >&2; rm -f $e; exit ${s[0]}; fi; rc=${s[1]}; "
         "if grep -q 'Warning: Cannot stat:' $e; then cat $e >&2; rm -f $e; exit 97; fi; "
         "if [ $rc -ne 0 ]; then bad=$(grep -v -x -E '(/usr/bin/)?tar: Exiting with failure status due to previous errors' $e | "
         "while IFS= read -r l; do p=${l#tar: }; p=${p#/usr/bin/tar: }; q=${p%: Unexpected inconsistency when making directory}; "
         "if [ \"$q\" = \"$p\" ] || ! { [ -d \"$q\" ] || [ -d \"/$q\" ]; }; then echo \"$l\"; fi; done); "
         "if [ -z \"$bad\" ]; then rc=0; else echo \"$bad\" >&2; fi; fi; rm -f $e; exit $rc")


def tar_x(roots):
    """the extraction command (stdin = zstd tar stream) under the per-lane flock"""
    # GNU tar's keep-newer stat can silently skip files below an absolute directory
    # symlink (scratch2 -> /home/...): warning + exit 0. Rewrite member names to
    # the receiver's actual root, retaining the existing keep-newer semantics.
    code = """import os, sys
for root in sys.argv[1:]:
    real = os.path.realpath(root)
    if root != real:
        source = root.lstrip('/').translate(str.maketrans({c: chr(92)+c for c in '.^$*[' + chr(92)}))
        target = real.lstrip('/').replace(chr(92), chr(92)*2).replace('&', chr(92)+'&')
        print('--transform=flags=rh;s|^'+source+'/|'+target+'/|;s|^'+source+'$|'+target+'|')
"""
    canonical = "python3 -c " + shlex.quote(code) + " " + " ".join(map(shlex.quote, roots))
    setup = (f"ot_xforms=$({canonical}) || exit 97; OT_TAR_TRANSFORMS=(); "
             'if [ -n "$ot_xforms" ]; then mapfile -t OT_TAR_TRANSFORMS <<< "$ot_xforms"; fi; ')
    return f"flock {spill_lock(roots)} bash -c {shlex.quote(setup + TAR_X)}"


def spill_fwd_cmd(src, dst, roots, stamp, listed=False):
    """src -> dst copy.  v10: on dst the marker is written BEFORE extraction, so a failed or partial copy is never a
    'real' data host for normal placement (v8 wrote it after a successful tar: a failed copy left an UNMARKED tree, the next
    re-place ran the job there as a normal job and nothing copied its outputs back); a lane root that exists unmarked on
    dst is real lane data there -> exit 3 (refused, never marked/overwritten); extraction holds the per-lane flock."""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    pre = " ".join(f"if test -e {shlex.quote(r)} && ! test -e {shlex.quote(r + '/' + SPILL_MARK)}; then echo OT_SPILL_REAL "
                   f"{shlex.quote(r)} >&2; exit 3; fi; mkdir -p {shlex.quote(r)} && echo {src} > {shlex.quote(r + '/' + SPILL_MARK)} || exit 4;"
                   for r in roots)
    dcmd = f"{pre} {tar_x(roots)} && touch {stamp}"
    stc = "cd / && tar --null --no-recursion -T - -cf - | zstd -q -1 -T8" if listed else f"tar -C / -cf - {rels} | zstd -q -1 -T8"
    return (f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(stc)}" + (f" < {shlex.quote(listed)}" if listed else "") + " | "
            f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(dcmd)}")


def spill_manifest(host, roots):
    """{relpath: (type, size, mtime)} of the roots on host (missing roots: nothing)"""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    r = subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "BatchMode=yes", host,
                        f"cd / && for r in {rels}; do test -e $r && find $r -printf '%y %s %T@ %p\\0'; done; true"],
                       capture_output=True, timeout=3600)
    if r.returncode:
        raise RuntimeError(f"manifest on {host}: {r.stderr.decode(errors='replace')[-160:]}")
    out = {}
    for e in r.stdout.split(b"\0"):
        if e:
            y, sz, mt, path = e.split(b" ", 3)
            out[path] = (y, int(sz), int(float(mt)))
    return out


def spill_delta(srcm, dstm):
    """v10 INCREMENTAL SPILL: what src must send = directories dst lacks + files/links dst lacks or holds older (tar keeps
    whole seconds, so compare seconds; same second but another size counts as changed).  Existing directories are never
    sent, which also keeps tar 1.35 away from its existing-directory error."""
    send = []
    for p, (y, sz, mt) in srcm.items():
        d = dstm.get(p)
        if y == b"d":
            if d is None:
                send.append(p)
        elif d is None or mt > d[2] or (mt == d[2] and sz != d[1]):
            send.append(p)
    return sorted(send)


def spill_copy_fwd(src, dst, roots, stamp):
    """-> subprocess.CompletedProcess-like (returncode, stderr, sent).  v10: only the delta travels (a die lane re-spilled
    to a host that holds its copy sends what changed), through the same marked/locked dst extraction as spill_fwd_cmd."""
    import tempfile
    try:
        delta = spill_delta(spill_manifest(src, roots), spill_manifest(dst, roots))
    except (RuntimeError, subprocess.SubprocessError, ValueError) as e:
        return subprocess.CompletedProcess([], 97, "", f"OT_SPILL_MANIFEST {str(e)[-200:]}")
    with tempfile.NamedTemporaryFile("wb", prefix="ot-run-spill-list.", delete=False) as f:
        f.write(b"".join(p + b"\0" for p in delta))
    try:
        cmd = spill_fwd_cmd(src, dst, roots, stamp, listed=f.name)
        r = subprocess.run(["bash", "-o", "pipefail", "-c", cmd], capture_output=True, text=True)
    finally:
        os.unlink(f.name)
    r.sent = len(delta)
    return r


def spill_back_cmd(src, dst, roots, stamp):
    """dst -> src: every file the run wrote (newer than the stamp).  The stamp is removed only after src extracted it
    (v8 removed it on dst even when the src side failed, so a retry had nothing to compare against)."""
    rels = " ".join(shlex.quote(r.lstrip("/")) for r in roots)
    dcmd = (f"test -e {stamp} || {{ echo OT_SPILL_NOSTAMP >&2; exit 5; }}; cd / && find {rels} -newer {stamp} ! -name {SPILL_MARK} "
            f"\\( -type f -o -type l \\) -print0 | tar --null -T - -cf - | zstd -q -1 -T8")
    scmd = tar_x(roots)
    return (f"ssh -o ControlPath=none -o BatchMode=yes {dst} {shlex.quote(dcmd)} | "
            f"ssh -o ControlPath=none -o BatchMode=yes {src} {shlex.quote(scmd)}")


def pending_write(rec):
    try:
        os.makedirs(SPILL_PENDING, exist_ok=True)
        tmp = os.path.join(SPILL_PENDING, rec["tag"] + ".tmp")
        with open(tmp, "w") as f:
            json.dump(rec, f)
        os.replace(tmp, os.path.join(SPILL_PENDING, rec["tag"] + ".json"))
    except OSError:
        pass


def spill_copy_back(src, dst, roots, stamp, say=lambda m: None):
    """-> (ok, error).  Retries; removes the dst stamp only after a successful copy."""
    err = ""
    for k in range(SPILL_BACK_TRIES):
        b = subprocess.run(["bash", "-o", "pipefail", "-c", spill_back_cmd(src, dst, roots, stamp)], capture_output=True, text=True)
        if not b.returncode:
            ssh_sh(dst, f"rm -f {stamp}", timeout=60)
            return True, ""
        err = b.stderr.strip()[-300:]
        if "OT_SPILL_NOSTAMP" in err:
            break
        if k + 1 < SPILL_BACK_TRIES:
            say(f"ot-run: SPILL back-copy {dst} -> {src} failed (try {k + 1}/{SPILL_BACK_TRIES}): {err[-160:]}; retrying")
            time.sleep(10 * (k + 1))
    return False, err


def spill_run(src, dst, roots, size_gb, mem, cmd, d, max_wait, say, disk=None):
    """copy the roots src->dst, run there, copy the files the run wrote back to src.  Returns the exit status, or None
    when the copy failed (nothing ran).  v10: the forward copy is marked first, serialised per lane and retried; a
    pending record (~/.local/state/ot-run/spill_pending) survives a killed client, and `ot-run --spill-sweep` copies the
    outputs back once the unit has ended; a back-copy that keeps failing is retried and logged to spill_stuck.log."""
    tag = "%d-%d" % (os.getpid(), int(time.time()))
    stamp = f"/tmp/ot-run-spill.{tag}"
    say(f"ot-run: SPILL: copying {', '.join(roots)} ({size_gb:.1f} GB) {src} -> {dst} (no host with --dir admits {mem} GB now)")
    t0 = time.time()
    for k in range(SPILL_COPY_TRIES):
        r = spill_copy_fwd(src, dst, roots, stamp)
        if not r.returncode or "OT_SPILL_REAL" in r.stderr:
            break
        if k + 1 < SPILL_COPY_TRIES:
            say(f"ot-run: SPILL copy {src} -> {dst} failed (try {k + 1}/{SPILL_COPY_TRIES}): {r.stderr.strip()[-160:]}; retrying")
            time.sleep(5 * (k + 1))
    if r.returncode:
        say(f"ot-run: SPILL copy {src} -> {dst} FAILED ({r.stderr.strip()[-200:]}); NOT RUN there (the partial copy on {dst} "
            f"is marked {SPILL_MARK}, so no job is placed on it)")
        log_signal(f"SPILL-COPY-FAILED {roots} {src} -> {dst} pid {os.getpid()}: {r.stderr.strip()[-160:]}")
        return None
    say(f"ot-run: SPILL: copied {r.sent} changed entries in {time.time() - t0:.0f} s; running on {dst}; written files go back to {src} after the run")
    log_signal(f"SPILL {roots} {src} -> {dst} pid {os.getpid()}: {' '.join(cmd)[:200]}")
    rec = dict(tag=tag, pid=os.getpid(), src=src, dst=dst, roots=roots, stamp=stamp, unit=None, t=int(time.time()),
               cmd=" ".join(cmd)[:300])
    pending_write(rec)

    def on_start(unit):
        rec["unit"] = unit
        pending_write(rec)
    rc, ran = run(dst, mem, cmd, d, max_wait, on_start=on_start, disk=disk)
    if not ran and rec["unit"] is None:          # never started: nothing to copy back
        ssh_sh(dst, f"rm -f {stamp}", timeout=60)
        try:
            os.unlink(os.path.join(SPILL_PENDING, tag + ".json"))
        except OSError:
            pass
        return rc or 255
    if not ran:                                  # started, connection lost: it may still run; the sweep copies back later
        say(f"ot-run: SPILL: outputs stay on {dst} until the unit ends; `ot-run --spill-sweep` copies them back to {src}")
        return rc or 255
    ok, err = spill_copy_back(src, dst, roots, stamp, say)
    if not ok:
        say(f"ot-run: SPILL back-copy {dst} -> {src} FAILED ({err[-200:]}); outputs are on {dst}: NOT COMPLETED "
            f"(recorded in {SPILL_STUCK_LOG}; `ot-run --spill-sweep` retries)")
        try:
            with open(SPILL_STUCK_LOG, "a") as f:
                f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + json.dumps(rec) + " " + err[-200:].replace("\n", " ") + "\n")
        except OSError:
            pass
        return rc or 98
    try:
        os.unlink(os.path.join(SPILL_PENDING, tag + ".json"))
    except OSError:
        pass
    say(f"ot-run: SPILL: outputs copied back {dst} -> {src}; RAN on {dst}: exit {rc}")
    return rc


def pid_alive(pid):
    return any(os.path.basename(x) == "ot-run" for x in proc_args(pid)[:3])


def spill_sweep(dry=False, say=print):
    """copy back the outputs of spilled runs whose client is gone (killed agent, session limit, failed back-copy) once
    their unit has ended on dst.  Returns the number of records still pending."""
    try:
        names = sorted(f for f in os.listdir(SPILL_PENDING) if f.endswith(".json"))
    except OSError:
        names = []
    left = 0
    for f in names:
        p = os.path.join(SPILL_PENDING, f)
        try:
            with open(p) as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        if pid_alive(rec["pid"]):
            left += 1
            continue
        if rec.get("unit"):
            a = ssh_sh(rec["dst"], f"systemctl --user is-active {shlex.quote(rec['unit'])}", timeout=60).stdout.strip()
            if a in ("active", "activating", "deactivating", "reloading"):
                say(f"ot-run --spill-sweep: {rec['tag']} unit {rec['unit']} still {a} on {rec['dst']}")
                left += 1
                continue
        say(f"ot-run --spill-sweep: {rec['tag']} {rec['roots']} {rec['dst']} -> {rec['src']} (unit {rec.get('unit')})"
            + (" DRY" if dry else ""))
        if dry:
            left += 1
            continue
        ok, err = spill_copy_back(rec["src"], rec["dst"], rec["roots"], rec["stamp"])
        if ok or "OT_SPILL_NOSTAMP" in err:
            os.replace(p, p[:-5] + (".done" if ok else ".nostamp"))
            say(f"ot-run --spill-sweep: {rec['tag']} " + ("copied back" if ok else "no stamp on dst (copied before?)"))
        else:
            left += 1
            say(f"ot-run --spill-sweep: {rec['tag']} back-copy FAILED: {err[-200:]}")
    return left


def trigger_sweep():
    """every ot-run job client starts a detached --spill-sweep at most every SWEEP_EVERY_S when records are pending"""
    try:
        if not any(f.endswith(".json") for f in os.listdir(SPILL_PENDING)):
            return
        if time.time() - os.path.getmtime(SWEEP_STAMP) < SWEEP_EVERY_S:
            return
    except OSError:
        pass
    try:
        open(SWEEP_STAMP, "w").write("sweep\n")
        subprocess.Popen(["flock", "-n", SWEEP_STAMP + ".lock", sys.executable, os.path.realpath(__file__), "--spill-sweep"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


PLACE_NOTES = {}      # host -> why place() dropped it ('' = qualified); for the NOT RUN message


def place(hosts, d, disk, mem, quiet=False):
    """probe the hosts; return host -> row for every host that qualifies (dir, disk, physical RAM).  No load test."""
    with cf.ThreadPoolExecutor(len(hosts)) as ex:
        res = dict(ex.map(lambda h: probe(h, d), hosts))
    ok = {}
    for h, r in res.items():
        note = "no " + str(d) if r is None else r.get("error") or ("disk %d GB < %d" % (r["disk_gb"], disk) if r["disk_gb"] < disk else "")
        if r and not r.get("error") and not note and not r.get("ncpu"):
            note = "probe without ncpu"
        if r and not r.get("error") and not physically_capable(r, mem):
            note = "request %d GB exceeds physical RAM after mandatory headroom" % mem
        if r and not r.get("error") and host_refusal(r):
            note = host_refusal(r)                      # v13 DISK GUARD / scratch-disk floor: refused, never queued here
        if r and not r.get("error") and r["disk_gb"] < disk and trigger_reaper(h, note):
            note += " (ot-reaper started for this host)"
        if r and not r.get("error") and r.get("dir_onroot") and r.get("scratch_disk") and d and not quiet:
            print(f"ot-run: WARNING: {h}: --dir {d} is on the ROOT filesystem; move it to {r['scratch_disk']}/claude/<lane> "
                  f"(owner 2026-10-24: never use root disks for work)", file=sys.stderr)
        PLACE_NOTES[h] = note
        if r and not r.get("error"):
            if not quiet:
                print(f"ot-run: {h:14s} admits {r.get('admit_gb', r['free_gb']):5d} GB (avail {r['avail_gb']}, {memory_charge_note(r)}, headroom "
                      f"{r['headroom_gb']}, waiters {r['waiting']}/{r['waiting_gb']} GB) load {load1(r):.0f}/{r.get('ncpu', 0)} "
                      f"running {r['running']} disk {r['disk_gb']} GB {note}", file=sys.stderr)
            if not note:
                ok[h] = r
        elif not quiet:
            print(f"ot-run: {h:14s} skipped: {note}", file=sys.stderr)
    return ok


