ROOTS = ("/srv/opentallas-scratch", "/srv/opentallas-scratch2")
MARK, MARGIN = ".ot-run-spill-copy", 50 << 30
LANE = re.compile(r"^(/srv/opentallas-scratch[^/]*)/claude/([A-Za-z0-9_+-][A-Za-z0-9_.+-]*)(?:/(.*))?$")
SAFE = re.compile(r"^/srv/opentallas-scratch[^\s$*?{}\[\]`~\\'\"]*$")
say = lambda m: print("ot-run: SCRATCH2: " + m, file=sys.stderr)
d, cmd, dry = sys.argv[1], json.loads(base64.b64decode(sys.argv[2])), len(sys.argv) > 3
FLOOR = int(os.environ.get("OT_RUN_SCRATCH_DISK_FLOOR_GB") or 50) << 30
free, devs, onroot = {}, set(), set()
