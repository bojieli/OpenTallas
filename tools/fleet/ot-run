ROOTFS_MAX_PCT = int(os.environ.get("OT_RUN_ROOTFS_MAX_PCT", "85"))


def scratch2_on():
    return not os.environ.get("OT_RUN_NO_SCRATCH2")


def scratch_disk(row, d, out):
    """v12 SCRATCH2: a scratch --dir's disk_gb = the most free scratch root on the host (new run dirs go there), unless
    the named root itself is nearly full (< SCRATCH_OWN_FLOOR_GB: files written straight into an existing --dir land
    there).  The --dir's own figure is kept as disk_own_gb."""
    if not (isinstance(row, dict) and "disk_gb" in row):
        return row
    roots, onroot, extra = {}, set(), {}
    for ln in out.splitlines():
        f = ln.split()
        if len(f) in (3, 4) and f[0] == "OT_SCRATCH_FREE" and f[2].isdigit():
            roots[f[1]] = int(f[2])
            if f[3:] == ["1"]:
                onroot.add(f[1])
        elif len(f) == 3 and f[0] == "OT_ROOTFS" and f[1].isdigit() and f[2].isdigit():
            extra.update(rootfs_pct=int(f[1]), rootfs_free_gb=int(f[2]))
        elif len(f) == 2 and f[0] == "OT_DIR_ONROOT":
            extra["dir_onroot"] = f[1] == "1"
    # v13 SCRATCH-DISK: a root on a separate disk exists -> only those roots count (never the root fs, even if emptier)
    disk_roots = {r: v for r, v in roots.items() if r not in onroot}
    if disk_roots and onroot:
        extra.update(scratch_disk=max(disk_roots, key=disk_roots.get), scratch_disk_gb=max(disk_roots.values()))
        roots = disk_roots
    row = dict(row, **extra)
    if not (scratch2_on() and d and SCRATCH_RE.match(os.path.normpath(d))):
        return row
    own = row["disk_gb"]
    if "scratch_disk" in row and (row.get("dir_onroot") or max(roots.values()) > own):
        return dict(row, disk_own_gb=own, disk_gb=max(roots.values()))   # new run dirs go to the disk, never the root fs
    if roots and own >= SCRATCH_OWN_FLOOR_GB and max(roots.values()) > own:
        row = dict(row, disk_own_gb=own, disk_gb=max(roots.values()))
    return row


def host_refusal(row):
    """v13 (FLEET-DISK 2026-10-24): why this host admits no new job, or '' -- root fs > ROOTFS_MAX_PCT % full, or its
    separate scratch disk below SCRATCH_DISK_FLOOR_GB (the root fs is never the fallback).  Rows of older probes: ''."""
    if not isinstance(row, dict):
        return ""
    pct = row.get("rootfs_pct")
    if pct is not None and pct > ROOTFS_MAX_PCT:
        return (f"ROOT FS {pct}% full > {ROOTFS_MAX_PCT}% (DISK GUARD, owner 2026-10-24: never use root disks for work; "
                f"move data to the scratch disk, OT_RUN_ROOTFS_MAX_PCT overrides)")
    if row.get("scratch_disk") and row.get("scratch_disk_gb", 0) < SCRATCH_DISK_FLOOR_GB:
        return (f"scratch disk {row['scratch_disk']} has {row['scratch_disk_gb']} GB free < floor {SCRATCH_DISK_FLOOR_GB} GB "
                f"(the root fs is never a fallback; free the scratch disk, OT_RUN_SCRATCH_DISK_FLOOR_GB overrides)")
    return ""


