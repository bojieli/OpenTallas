            state["refused"] = ("actual working/output directory is on the ROOT filesystem without an exception" if "ROOTDIR" in ln else "root fs above %d%% (DISK GUARD)" % ROOTFS_MAX_PCT if "ROOTFULL" in ln
                                else "scratch disk below its floor / new run dir could not be placed on it (root fs never used)")
            continue
        if not state["started"] and any(k in ln for k in SSH_CONNFAIL):
            state["connfail"] = True
        if (seen_unit := admission_unit(ln, tag)) is not None:
            state["started"] = True
            state["unit"] = seen_unit
            if on_start:
                on_start(state["unit"])
            ln = ln.split(" OT_RUN_START")[0] + "\n"
        if not quiet:
            sys.stderr.write(ln)
            sys.stderr.flush()
    ssh_rc = p.wait()
    done.set()
    w.join()
    unblock()
    if state["started"] and state["rc"] is not None:
        say(f"ot-run: RAN on {host} (unit {state['unit']}): exit {state['rc']}")
        return state["rc"], True
    if state["started"]:
