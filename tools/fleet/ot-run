def scratch_disk(row, d, out, host=None):
    """v12 SCRATCH2: a scratch --dir's disk_gb = the most free scratch root on the host (new run dirs go there), unless
    the named root itself is nearly full (< SCRATCH_OWN_FLOOR_GB: files written straight into an existing --dir land
    there).  The --dir's own figure is kept as disk_own_gb.  disk_dev = device of the root disk_gb measures (FLOW-31),
    absent when the probe did not say."""
    if not (isinstance(row, dict) and "disk_gb" in row):
        return row
    roots, onroot, extra, devs = {}, set(), {}, {}
    for ln in out.splitlines():
        f = ln.split()
        if len(f) in (3, 4) and f[0] == "OT_SCRATCH_FREE" and f[2].isdigit():
            roots[f[1]] = int(f[2])
            if f[3:] == ["1"]:
                onroot.add(f[1])
        elif len(f) == 3 and f[0] == "OT_SCRATCH_DEV":
            devs[f[1]] = f[2]
        elif len(f) == 2 and f[0] == "OT_DIR_DEV":
            extra["disk_dev"] = f[1]
        elif len(f) == 3 and f[0] == "OT_ROOTFS" and f[1].isdigit() and f[2].isdigit():
            extra.update(rootfs_pct=int(f[1]), rootfs_free_gb=int(f[2]))
            if host in ROOTFS_MIN_FREE_GB_HOSTS:
                extra["rootfs_floor_gb"] = ROOTFS_MIN_FREE_GB_HOSTS[host]
            extra["host_name"] = host
        elif len(f) == 2 and f[0] == "OT_DIR_ONROOT":
            extra["dir_onroot"] = f[1] == "1"
        elif len(f) == 2 and f[0] == "OT_DIR_REAL":
            extra["dir_real"] = f[1]
    # ROOTSCR_1101: second roots (root fs, named in ROOT_SCRATCH_ROOTS) count with root free - ROOT_SCRATCH_FLOOR_GB
    rfl = root_floor(host)                                    # ROOTSCR-INTEL: per-host root floor
    second = {r: max(0, roots.pop(r) - rfl) for r in list(roots) if r in onroot and r in ROOT_SCRATCH_ROOTS}
    onroot -= set(second)
    # v13 SCRATCH-DISK: a root on a separate disk exists -> only those roots count (never the root fs, even if emptier)
    disk_roots = {r: v for r, v in roots.items() if r not in onroot}
    if disk_roots and (onroot or "rootfs_pct" in extra):     # v13 probe: every root off the root fs = scratch disk
        extra.update(scratch_disk=max(disk_roots, key=disk_roots.get), scratch_disk_gb=max(disk_roots.values()))
        roots = disk_roots
        sr = SCRATCH_PIN if SCRATCH_PIN in second else (max(second, key=second.get) if second else None)
        extra["scratch_floor_gb"] = sfloor(host)
        if sr and (sr == SCRATCH_PIN or (extra["scratch_disk_gb"] < sfloor(host)
                                         and second[sr] >= SCRATCH_SECOND_FLOOR_GB)):
            extra.update(scratch_disk=sr, scratch_disk_gb=second[sr], scratch_second=True, root_floor_gb=rfl)
            roots = {sr: second[sr]}                          # new run dirs go to the second root
    # Status measures the best eligible filesystem. A concrete --dir measures its
    # own device: output redirection is optional and cannot justify admission.
    row = dict(row, **extra)
    eligible = dict(disk_roots)
    if extra.get("scratch_second"):
        eligible = {extra["scratch_disk"]: extra["scratch_disk_gb"]}
    if not d:
        if eligible:
            best = max(eligible, key=eligible.get)
            return dict(row, disk_gb=eligible[best], disk_dev=devs.get(best))
        if roots or onroot or extra.get("dir_onroot"):
            row["disk_refusal"] = "no dedicated scratch filesystem or explicitly authorized root scratch"
        return row
    own = row["disk_gb"]
    row["disk_own_gb"] = own
    if row.get("dir_onroot"):
        # KW-FIX-43 ROOTREAL: the spelled path or its real path on the host (readlink -f) must lie under an authorized root
        authorized = next((r for r in second for p in {os.path.normpath(d), os.path.normpath(row.get("dir_real") or d)}
                           if p == r or p.startswith(r + "/")), None)
        if not authorized:
            row["disk_refusal"] = "--dir is on the ROOT filesystem without an explicit root scratch exception"
            return row
        usable = min(own, second[authorized])
        return dict(row, disk_gb=usable, scratch_disk=authorized,
                    scratch_disk_gb=usable, scratch_second=True, root_floor_gb=rfl)
    # Match device, including symlinked paths, rather than guessing from path names.
    matching = [r for r in disk_roots if devs.get(r) and devs[r] == row.get("disk_dev")]
    if matching:
        row.update(scratch_disk=matching[0], scratch_disk_gb=own, scratch_second=False)
    return row


