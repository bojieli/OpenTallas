# ot-heavy units started with OT_HEAVY_PRIO=die on the host, its queued die waiters, and closure-daemon die jobs placed there.  A die job never
# queues on a capped host that is full; it goes elsewhere (or waits elsewhere and is re-placed every REQUEUE_S).
HOST_MAX_DIE = {}   # v10 FLEET-PLACE 2026-10-19: the die COUNT cap is gone (ot-epyc8 1 -> the S81 MU die case waited
# ~90 min); replaced by DISK admission (drop_low_disk).  Kept (empty) so v9 clients that re-read it drop their caps.
DIE_DISK_GB = int(os.environ.get("OT_RUN_DIE_DISK_GB", "60"))   # estimated scratch of one die chain (measured 10-19:
# die case dirs 0.7 GB at start, die chains 16-40 GB per lane); the default --disk of a die job
DISK_RESERVE_BELOW_GB = 2000     # hosts with less free scratch than this also reserve DIE_DISK_GB per running die job


def probe(host, d, spill_ok=False):
    """spill_ok=False: a --dir that is a SPILL copy (marker in its lane root) does not qualify (stale data)"""
    q = shlex.quote(d or "/")
    mark = shlex.quote(spill_root(d) + "/" + SPILL_MARK) if d else "/nonexistent-ot-run-mark"
    cmd = f"test -d {q} || {{ echo NODIR; exit 0; }}; " + ("" if spill_ok else f"test -e {mark} && {{ echo NODIR; exit 0; }}; ") \
        + f"/usr/local/bin/ot-heavy-reconcile --free {q}"
    try:
        r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", host, cmd], capture_output=True,
                           text=True, timeout=40)
        return host, (None if "NODIR" in r.stdout else json.loads(r.stdout.strip().splitlines()[-1]))
    except Exception as e:
        return host, {"error": str(e)[:80]}


THREADS, SMALL_CORES, SMALL_THREADS = 16, 48, 8
REQUEUE_S = int(os.environ.get("OT_RUN_REQUEUE_S", "120"))   # v6 REBALANCE: a queued (unstarted) waiter is re-placed after
                                   # this long (v9: 120 s, was 300; every re-place re-reads HOSTS from this file)
SPILL_MAX_GB = int(os.environ.get("OT_RUN_SPILL_MAX_GB", "40"))   # v8 SPILL
SPILL_MAX_DIE_GB = int(os.environ.get("OT_RUN_SPILL_MAX_DIE_GB", "400"))   # v10: die lanes spill too (incremental copy)
DIE_RE = re.compile(r"(?i)(die[_-]?(sta|gen\d*|grt\d*|chain|trial|place|bind)|(sta|gen\d*|grt\d*)[_-]die\b|mu-die|die[_-]case|kvs14r-|dv2f\d)")  # COORD 10-19: MU die cases (mu-die-*, die-case, kvs14r-*, dv2f*) are die jobs (FLEET-DISK gap)


CONF_NAMES = ("HOSTS", "HOST_ROLE", "HOST_MAX_DIE", "NO_AVX512")


def reload_conf(path=None):
    """v9 RE-PLACE (FLEET-NEW2 2026-10-19): a waiting client re-reads the host table from the ot-run file on disk at
    every re-place, so hosts added (or roles/caps changed) after it started are used by its next placement -- before v9
    a client kept the host list it started with, and waiters sat on EPYC4/5 while new hosts were idle.  Returns the
    names whose value changed; a file that does not parse changes nothing."""
    import ast
    try:
        src = open(path or os.path.realpath(__file__)).read()
    except OSError:
        return []
    changed = []
    for name in CONF_NAMES:
        m = re.search(r"^%s\s*=\s*(.+?)(?:\s*#.*)?$" % name, src, re.M)
        if not m:
            continue
        try:
            v = ast.literal_eval(m.group(1).strip())
        except (ValueError, SyntaxError):
            continue
        if type(v) is type(globals()[name]) and v != globals()[name]:
            globals()[name] = v
            changed.append(name)
    return changed


DAEMON_JOBS = os.path.expanduser("~/.local/state/closure_loop/jobs")
DAEMON_PLACED = {"SYNC", "RUNNING", "ECO", "SUMMARY", "ECO_INSTALL", "MIGRATING"}
DIE_UNITS_SH = ("n=0; for u in $(systemctl --user list-units --type=scope --state=active --no-legend --plain 'oth-*' "
                "2>/dev/null | awk '{print $1}'); do cg=$(systemctl --user show -p ControlGroup --value $u); "
