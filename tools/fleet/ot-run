def reload_conf(path=None):
    """v9 RE-PLACE (FLEET-NEW2 2026-10-19): a waiting client re-reads the host table from the ot-run file on disk at
    every re-place, so hosts added (or roles/caps changed) after it started are used by its next placement -- before v9
    a client kept the host list it started with, and waiters sat on EPYC4/5 while new hosts were idle.  Returns the
    names whose value changed; a file that does not parse changes nothing."""
    import ast
    try:
        src = open(path or os.path.realpath(__file__)).read()
    except OSError:
        return []
    changed = []
    for name in CONF_NAMES:
        m = re.search(r"^%s\s*=\s*(.+?)(?:\s*#.*)?$" % name, src, re.M)
        if not m:
            continue
        try:
            v = ast.literal_eval(m.group(1).strip())
        except (ValueError, SyntaxError):
            continue
        if type(v) is type(globals()[name]) and v != globals()[name]:
            globals()[name] = v
            changed.append(name)
    return changed


