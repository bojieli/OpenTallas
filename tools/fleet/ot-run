def trigger_reaper(host, why):
    """(ROOT-2130 2026-10-18, FLEET-DISK P6) a host refused for low disk starts `ot-reaper.py --host H` once (detached,
    flock; at most every REAP_EVERY_S per host) instead of only refusing: the cron run is every 30 min and EPYC4 sat at
    14-16 GB free (refused) with 444 GB of reapable gate bulk."""
    if not os.path.exists(REAPER):
        return False
    stamp = REAP_STAMP.format(host=host)
    try:
        if time.time() - os.path.getmtime(stamp) < REAP_EVERY_S:
            return False
    except OSError:
        pass
    try:
        open(stamp, "w").write(f"{why}\n")
        subprocess.Popen(["flock", "-n", f"/tmp/ot-run-reap-{host}.lock", sys.executable, REAPER, "--host", host],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        return False
    return True


