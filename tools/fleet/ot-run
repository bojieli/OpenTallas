def spill_room(host, roots, need_gb, margin_gb, tag=None):
    """-> (True, "") room, (False, why) no room, (None, why) could not tell.  tag: also reserve the room on host for this copy."""
    args = ["reserve" if tag else "check", tag or "-", f"{need_gb:.3f}", str(margin_gb), SPILL_RESV_DIR, str(SPILL_RESV_TTL_S)] + list(roots)
    try:
        r = ssh_sh(host, "python3 -I -c " + shlex.quote(SPILL_ROOM_PY) + " " + " ".join(shlex.quote(x) for x in args), timeout=300)
    except (OSError, subprocess.SubprocessError) as e:
        return None, f"room check on {host}: {str(e)[:80]}"
    if "OT_ROOM_OK" in r.stdout:
        return True, ""
    if "OT_ROOM_NO" in r.stdout:
        return False, f"{host}: {r.stdout.strip().split('OT_ROOM_NO ')[-1][:120]}"
    return None, f"room check on {host}: rc {r.returncode} {r.stderr.strip()[-80:]}"


