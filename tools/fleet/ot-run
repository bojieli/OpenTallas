    # disappeared after the probe and then launch in an empty source tree.
    workdir_guard = (f"test -d {shlex.quote(d)} || {{ echo OT_RUN_NOCD {tag} >&2; exit 96; }}; " if d else "")
    remote = scratch_env(host) + workdir_guard + scratch_place_sh(d, cmd, tag=tag, host=host) \
        + (f"cd {shlex.quote(d)} || {{ echo OT_RUN_NOCD {tag} >&2; exit 96; }}; " if d else "") \
        + inner + f'; rc=$?; echo "OT_RUN_EXIT {tag} $rc" >&2; exit $rc'
