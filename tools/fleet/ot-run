def daemon_die_jobs(host):
    """closure-daemon die jobs (DIE_RE name) placed on host; only die-named state files are read"""
    n = 0
    try:
        names = [f for f in os.listdir(DAEMON_JOBS) if f.endswith(".json") and DIE_RE.search(f[:-5])]
