#!/bin/bash
# ot-heavy v13 (2026-10-22 TOKc-ADM: the command runs under ot-heavy-exit in its scope, which reports EARLYOOM / MEMCG-OOM kills); v12 (2026-10-18 FLEET-OOM: pinned Verilator 5.050 / yosys 0.68 first on PATH for every job); v11 (2026-10-18: die waiters re-try every 5 s; DIE-FIRST v2 in reconcile only orders, never holds idle memory; no load test anywhere); v9 (2026-10-16: docker run inherits the declared --memory via the ot-heavy-docker shim); v8 (2026-10-13 owner 17:55: admission, placement and the per-unit table use ONE arithmetic, `ot-heavy-reconcile --gate` = books(); see that file: a unit is charged what it can still grow into, bounded by its own observed peak and its class peak; no request waits while > 25 % of RAM is really available and the 20 % floor holds); v7 (2026-10-13: --tag LABEL (shown in ps; ot-run cancels its own waiter by it), --max-wait SEC (exit 75 'NOT RUN' instead of waiting for ever), an 'admitted' line on stderr after a wait); v6 (2026-10-13 owner: growth charged to a running unit is capped from its own observed peak after 5 min, plus a real-memory floor of 20 % of RAM); v5 (2026-10-13: /etc/ot-heavy.conf is re-read on every attempt, so a headroom change reaches queued waiters); v4 (2026-10-13 owner: an over-sized request is ADMITTED on its measured class size; v3 counts docker memory via use.<unit>; v2 2026-10-12, owner: any host takes any task as long as memory allows; no fixed slot counts).
# Runs a large build / bench under a hard memory cap and admits it only when the host's memory allows:
#   ot-heavy --mem <GB> [--slots-class big|small (ignored)] -- <command...>
# Admission (v10, owner 2026-10-17 "admit as soon as possible"): `ot-heavy-reconcile --gate`: MemAvailable - (growth
# charged to running units, each at most GROWTH_FACTOR=0.5 x its declared margin) >= NEED_FACTOR=0.7 x MEM, and
# MemAvailable - 0.7 x MEM >= MIN_AVAIL_FRAC=0.05 x RAM (factors in /etc/ot-heavy.conf; see ot-heavy-reconcile).
# HEADROOM_GB applies only to the bash fallback below, when the gate cannot answer.
# Each job runs in its own systemd user scope with MemoryMax=MEM (no swap), so it cannot exceed its request.
# v4: when MEM > 2x the measured peak of the command's class (ot-heavy-reconcile --sizes; local table merged with the
# fleet table), the RESERVATION charged for admission is ceil(max(1.5 x peak, peak + 8 GB)) instead of MEM.  MemoryMax
# stays MEM; ot-heavy-reconcile gives the unit its full request back when its RSS passes 80 % of the reservation.
# Unknown classes are charged their request.  The headroom is kept, so a job is never admitted beyond MemAvailable.
# The size is looked up again on every attempt, so a queued waiter picks up a class measured while it waits.
set -u
# USERBUS_1111 (KW-FIX-44, COORD 11-11 19:3x): an ssh session whose pam_systemd CreateSession failed (epyc4 03:10-03:24
# UTC, logind under load) has no XDG_RUNTIME_DIR, and the systemd-run --user below failed with 'Failed to connect to
# user scope bus' after admission (9 S81 rows).  Every host lingers ubuntu, so the user manager's bus is at
# /run/user/UID/bus: use it when the session did not set it.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -S "/run/user/$(id -u)/bus" ]; then export XDG_RUNTIME_DIR="/run/user/$(id -u)"; fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
MEM=""; TAG=""; MAXWAIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --mem) MEM="$2"; shift 2;;
    --slots-class) shift 2;;
    --tag) TAG="$2"; shift 2;;
    --max-wait) MAXWAIT="$2"; shift 2;;
    --) shift; break;;
    *) break;;
  esac
done
[ -n "$MEM" ] && [ $# -gt 0 ] || { echo "usage: ot-heavy --mem <GB> -- <command...>" >&2; exit 2; }
HEADROOM_GB=32
[ -f /etc/ot-heavy.conf ] && . /etc/ot-heavy.conf
D=/var/tmp/ot-heavy; mkdir -p $D 2>/dev/null; chmod 1777 $D 2>/dev/null
UNIT="oth-$(id -un)-$$-$(date +%s)"
waited=0; T0=$(date +%s)
LASTRES=""
# DIE_WATCHDOG_1021 (live since 10-21, restored to the repo 11-01 by FLOW-21: the 11:38 repo install dropped it): use the
# admission classifier for both priority and hard protection.
if /usr/local/bin/ot-heavy-reconcile --is-die -- "$@" || /usr/local/bin/ot-protect-die --is-die -- "$@"; then export OT_HEAVY_PRIO=die; fi
while :; do
  [ -f /etc/ot-heavy.conf ] && . /etc/ot-heavy.conf   # v5: every attempt, so a headroom change reaches queued waiters
  exec 8>>"$D/admit.lock"; flock 8
  # v8: the gate decides (class size of the request, charge of every running unit, the 25 % rule, the real floor)
  GATE=$(timeout 30 /usr/local/bin/ot-heavy-reconcile --gate "$MEM" -- "$@" 2>/dev/null)
  V=${GATE%% *}; R=${GATE#* }; RES=${R%% *}; R=${R#* }; CLS=${R%% *}; WHY=${GATE#*| }
  case "$RES" in ''|*[!0-9]*) V="";; esac
  if [ "$V" != OK ] && [ "$V" != NO ]; then
    # the gate did not answer (python or the size table broken): the plain rule, every unit charged its reservation
    RES=$MEM; CLS="?"; avail=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo); grow=0
    for f in "$D"/res.*; do
      [ -e "$f" ] || continue
      read -r u m < "$f" || continue
      systemctl --user is-active --quiet "$u.scope" 2>/dev/null || { [ $(( $(date +%s) - $(stat -c %Y "$f") )) -gt 120 ] && rm -f "$f"; continue; }
      cur=$(systemctl --user show "$u.scope" -p MemoryCurrent --value 2>/dev/null); case "$cur" in ''|*[!0-9]*) cur=0;; esac
      g=$(( m - cur / 1073741824 )); [ $g -gt 0 ] && grow=$((grow + g))
    done
    total=$(awk '/MemTotal/{print int($2/1048576)}' /proc/meminfo); REAL_FLOOR=${REAL_FLOOR_GB:-$(( total / 5 ))}
    V=NO; [ $((avail - grow)) -ge $((RES + HEADROOM_GB)) ] && [ $((avail - RES)) -ge $REAL_FLOOR ] && V=OK
    WHY="gate unavailable, plain rule: need ${RES}+${HEADROOM_GB} GB, available ${avail} GB, growth charged ${grow} GB (every unit at its reservation), real floor ${REAL_FLOOR} GB"
  fi
  # SHORT_POOL_1101 (COORD 11-01 20:24; widened to <=10 GB by COORD 11-02 so the default gen_lint 8+2 GB fits):
  # <=2-thread, <=OT_HEAVY_SHORT_MAX_GB (default 10) stages use a bounded
  # independent slot pool. Memory/die-reservation admission above is unchanged.
  # flock leases vanish on exit, including crashes; acquire under the admission lock.
  _short=0
  if [ "$V" = OK ] && [ "${OT_HEAVY_DIRECT:-}" != 1 ] && [ "${OT_HEAVY_SHORT_POOL:-1}" != 0 ] &&
     [[ "$MEM" =~ ^[0-9]+$ ]] && [ "$MEM" -le "${OT_HEAVY_SHORT_MAX_GB:-10}" ] &&
     [[ "${OT_HEAVY_THREADS:-}" =~ ^[12]$ ]]; then
    _slots=12; [ "${OT_HEAVY_SHORT_SLOTS:-}" = 16 ] && _slots=16
    _short=1; _lease=0
    for ((_slot=1; _slot<=_slots; _slot++)); do
      exec 9>>"$D/short.$_slot.lock"
      if flock -n 9; then _lease=1; break; fi
      exec 9>&-
    done
    if [ "$_lease" = 0 ]; then
      V=NO; WHY="short pool: all ${_slots} slots busy (memory admits)"
    fi
  fi
  # LOADCAP_1101 (FLOW-21, COORD 11-01 09:2x: intel1 load 545 on 112 cores reset sshd): a non-crit job that memory
  # admits still waits (stays queued, never fails) while load1 >= LOAD_CAP_FACTOR x nproc (default 1.5; 0 disables;
  # /etc/ot-heavy.conf).  OT_HEAVY_CPU=crit (ot-run --crit) bypasses the cap.
  if [ "$V" = OK ] && [ "${OT_HEAVY_CPU:-}" != crit ] && [ "$_short" = 0 ]; then
    _cap=$(awk -v f="${LOAD_CAP_FACTOR:-1.5}" -v n="$(nproc)" 'BEGIN{printf "%d", f * n}')
    _l1=$(awk '{printf "%d", $1}' /proc/loadavg)
    if [ "$_cap" -gt 0 ] && [ "$_l1" -ge "$_cap" ]; then V=NO; WHY="load cap: load1 ${_l1} >= ${LOAD_CAP_FACTOR:-1.5} x $(nproc) = ${_cap} (non-crit job waits; memory admits)"; fi
  fi
  # DIRECT_1107 (OWNER 11-07 "critical, blocking build tasks should bypass the queues and directly start running"; ot-run
  # --direct): the job starts on real memory alone, past the gate's past-peak/reservation charge, DIE-RESERVE and the load
  # cap, while MemAvailable minus what earlier direct jobs have not used yet >= MEM + 32 GB.  It is charged its full
  # request, so later admissions see it.  Under the admission lock, so a burst cannot count the same free memory twice.
  # DIRECT_MEMAVAIL_1110 (COORD 11-10: direct jobs on intel1 refused with 222 GB real MemAvailable because earlier
  # direct jobs' unused requests, 147-179 GB, were subtracted): the owner rule is real MemAvailable >= MEM + 32 GB.  A
  # started job's memory is already in MemAvailable, so an earlier direct record is charged its full request only while
  # it is young (DIRECT_FRESH_S, default 300 s: not started or still loading), so a burst cannot count the same free
  # memory twice; after that it counts at its measured use, which MemAvailable already holds.
  if [ "${OT_HEAVY_DIRECT:-}" = 1 ]; then
    _pend=0; _now=$(date +%s)
    for _f in "$D"/direct.*; do
      [ -e "$_f" ] || continue
      read -r _u _m < "$_f" || continue
      _age=$(( _now - $(stat -c %Y "$_f") ))
      if ! systemctl --user is-active --quiet "$_u.scope" 2>/dev/null && [ $_age -gt 120 ]; then rm -f "$_f"; continue; fi
      case "$_m" in ''|*[!0-9]*) continue;; esac
      [ $_age -lt "${DIRECT_FRESH_S:-300}" ] && _pend=$(( _pend + _m ))
    done
    _avail=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo)
    if [ $(( _avail - _pend )) -ge $(( MEM + 32 )) ]; then
      V=OK; RES=$MEM; _short=0; WHY="DIRECT_1107 available $_avail GB, fresh earlier direct $_pend GB, past gate: $WHY"
      echo "$UNIT $MEM" > "$D/direct.$UNIT"
    else
      V=NO; RES=$MEM; WHY="direct job: MemAvailable $_avail GB - fresh (<${DIRECT_FRESH_S:-300} s) earlier direct $_pend GB < $MEM + 32 GB"
    fi
  fi
  # LOADGATE_1110 (KW-FIX-44, COORD 11-10 18:3x: epyc8 load1 507 on 96 threads, every job ~5x slow, while ot-run showed
  # LOADCAP).  LOADCAP_1101 above holds only non-crit, non-short jobs, and DIRECT_1107 re-decides V after it, so --crit
  # and --direct jobs (12 FTRES-FIX grt_arm runs admitted 02:20-02:25 UTC, each -threads 8) and short-pool stages started
  # at any load.  load1 also lags a burst by about a minute.  The gate applies to EVERY job (crit, direct, short, die):
  # it waits while load1 + the declared threads of jobs admitted here in the last LOAD_FRESH_S (default 300 s, the
  # DIRECT_FRESH_S window, so a direct burst is counted before load1 shows it) >= LOAD_GATE_FACTOR (default 1.25) x nproc.
  # Running jobs are never touched.  LOAD_GATE_FACTOR=0 (/etc/ot-heavy.conf or env) disables it.
  if [ "$V" = OK ] && [ "${LOAD_GATE_FACTOR:-1.25}" != 0 ]; then
    _now=$(date +%s); _fr=0
    for _f in "$D"/thr.*; do
      [ -e "$_f" ] || continue
      if [ $(( _now - $(stat -c %Y "$_f" 2>/dev/null || echo 0) )) -gt "${LOAD_FRESH_S:-300}" ]; then rm -f "$_f"; continue; fi
      read -r _t < "$_f" || continue
      case "$_t" in ''|*[!0-9]*) continue;; esac
      _fr=$(( _fr + _t ))
    done
    _gl=$(awk -v f="${LOAD_GATE_FACTOR:-1.25}" -v n="$(nproc)" -v x="$_fr" \
      'NR==1{l=$1+x; c=f*n; printf "%s %.1f %.0f", (l < c ? "OK" : "NO"), $1, c}' /proc/loadavg)
    if [ "${_gl%% *}" = NO ]; then
      _g=(${_gl})
      [ "$_short" = 1 ] && { exec 9>&-; _short=0; }
      [ "${OT_HEAVY_DIRECT:-}" = 1 ] && rm -f "$D/direct.$UNIT"
      V=NO; WHY="load gate: load1 ${_g[1]} + fresh admits ${_fr} threads >= ${LOAD_GATE_FACTOR:-1.25} x $(nproc) = ${_g[2]} (every job waits, crit/direct/short too; running jobs untouched)"
    fi
  fi
  [ "$RES" != "$MEM" ] && [ "$RES" != "$LASTRES" ] && echo "ot-heavy: request ${MEM}G is charged ${RES}G (${WHY##*; }); the cap stays ${MEM}G" >&2
  LASTRES=$RES
  if [ "$V" = OK ]; then
    echo "$UNIT $RES" > "$D/res.$UNIT"
    echo "${OT_HEAVY_THREADS:-8}" > "$D/thr.$UNIT"   # LOADGATE_1110: counted as fresh load for LOAD_FRESH_S
    echo "$MEM $CLS" > "$D/meta.$UNIT"
    [ "$RES" != "$MEM" ] && echo "$(date -Is) $UNIT DOWNSIZE request ${MEM}G -> reserved ${RES}G (${WHY##*; })" >> "$D/admit.log"
    A=${WHY#*available }; G=${WHY#*growth charged }
    echo "$(date -Is) $UNIT mem ${MEM}G avail ${A%% *}G grow ${G%% *}G: $*" >> "$D/admit.log"
    flock -u 8; exec 8>&-
    # v7: say that the command starts NOW (after a wait, or for ot-run, which refuses to report an exit status of a
    # command it never saw start)
    { [ $waited = 1 ] || [ -n "$TAG" ]; } && echo "ot-heavy: admitted on $(hostname) as $UNIT after $(( $(date +%s) - T0 )) s${TAG:+ OT_RUN_START $TAG}" >&2
    # v9 (ROOT 2026-10-16, coordinator): docker containers live in dockerd's cgroup, outside this scope's MemoryMax;
    # the ot-heavy-docker shim (installed as /usr/local/lib/ot-heavy/bin/docker) gives every `docker run` the same
    # declared cap (--memory = --memory-swap = MEM).  A job that needs more must declare more.
    export OT_HEAVY_MEM_GB="$MEM"
    # v12 (FLEET-OOM 2026-10-18): every job gets the fleet's pinned tools first on PATH (Verilator 5.050, yosys 0.68),
    # the ones the closure-loop daemon's bench stages use; /usr/bin/verilator is Debian 5.032 (none on PVE1), so lane
    # benches run through ot-run and the daemon's job benches disagreed.  OT_HEAVY_SYSTEM_TOOLS=1 opts out.
    # FLEET-NEW3 2026-10-24: also ~/.local/opentallas-tools/bin (opensta `sta`; non-login ssh has no profile PATH).
    if [ -z "${OT_HEAVY_SYSTEM_TOOLS:-}" ]; then
      for _d in "$HOME/.local/opentallas-tools/bin" "$HOME/.local/opentallas-tools/yosys-0.68/bin" "$HOME/.local/opentallas-tools/verilator-5.050/bin"; do
        [ -d "$_d" ] && export PATH="$_d:$PATH"
      done
    fi
    # VL_JCAP_1022 (fleet 2026-10-22: ep5 / filled by OOM dumps): Verilator C++ builds peak ~30 GB per cc1plus, so
    # every Verilator make in this job runs at most floor(MEM / per-cc1plus GB) jobs (ot-vl-jcap). OT_VL_JCAP=0 opts out.
    if [ "${OT_VL_JCAP:-1}" != 0 ] && [ -x /usr/local/bin/ot-vl-jcap ]; then
      _jc=$(timeout 20 /usr/local/bin/ot-vl-jcap --env "$MEM" -- "$@") && eval "$_jc"; unset _jc
    fi
    [ -x /usr/local/lib/ot-heavy/bin/docker ] && export PATH="/usr/local/lib/ot-heavy/bin:$PATH"
    # EXIT_REPORT_1022 (v17 TOKc-ADM): ot-heavy-exit runs the command inside the scope and, on a non-zero exit, reports
    # EARLYOOM (host-level earlyoom kill of one of the job's processes) or MEMCG-OOM instead of a bare 143 / exit 2
    _OTX=(); if [ "${OT_HEAVY_EXIT_REPORT:-1}" != 0 ] && [ -x /usr/local/lib/ot-heavy/ot-heavy-exit ]; then _OTX=(/usr/local/lib/ot-heavy/ot-heavy-exit "$UNIT"); fi
    # CRIT_1101 (FLOW-21, COORD 11-01 09:1x): ot-run --crit -> OT_HEAVY_CPU=crit: the scope gets CPUWeight=1000 (default
    # 100) against its sibling user scopes, and the ot-heavy-docker shim gives its containers cpu.weight ~1000 against
    # the sibling (volume kit) containers in system.slice.  No admission change beyond bypassing LOADCAP_1101.
    _CW=(); [ "${OT_HEAVY_CPU:-}" = crit ] && _CW=(-p CPUWeight=1000)
    # DIE_WATCHDOG_1021: user scopes cannot set OOMScoreAdjust; set the launching PID as root (-999), then inherit.
    if [ "${OT_HEAVY_PRIO:-}" = die ]; then
      sudo -n /usr/local/bin/ot-protect-die --pid "$$" || { echo "ot-heavy: NOT RUN: die protection failed" >&2; exit 70; }
    fi
    # OOMADJ_999_1022: a non-die job starts at oom_score_adj 0 (its launcher may sit in a protected die tree at -999,
    # or a legacy -1000 one, which would make the job un-killable by its own scope's memcg OOM: livelock at the cap).
    if [ "${OT_HEAVY_PRIO:-}" != die ]; then echo 0 > /proc/self/oom_score_adj 2>/dev/null || true; fi
    if [ "$_short" = 1 ]; then
      # Keep the lease in this waiting parent: systemd may close inherited FDs.
      echo "$(date -Is) $UNIT SHORT_POOL slot $_slot/$_slots threads $OT_HEAVY_THREADS mem ${MEM}G" >> "$D/admit.log"
      systemd-run --user --scope -q --unit="$UNIT" -p MemoryMax=${MEM}G -p MemorySwapMax=0 "${_CW[@]}" -- "${_OTX[@]}" "$@"
      _rc=$?; exec 9>&-; exit "$_rc"
    fi
    exec systemd-run --user --scope -q --unit="$UNIT" -p MemoryMax=${MEM}G -p MemorySwapMax=0 "${_CW[@]}" -- "${_OTX[@]}" "$@"
  fi
  flock -u 8; exec 8>&-
  case "$WHY" in "load cap:"*|"load gate:"*) _wf=load;; "short pool:"*) _wf=short-slot;; *) _wf=memory;; esac
  [ $waited = 0 ] && echo "ot-heavy: waiting for $_wf on $(hostname): $WHY" >&2
  waited=1
  case "$MAXWAIT" in ''|*[!0-9]*) ;; *) [ $(( $(date +%s) - T0 )) -ge "$MAXWAIT" ] && { echo "ot-heavy: NOT RUN: no memory on $(hostname) within ${MAXWAIT} s ($WHY): $*" >&2; exit 75; };; esac
  if [ "${OT_HEAVY_PRIO:-}" = die ]; then sleep 5; else sleep 20; fi   # v11: a die waiter re-tries first (DIE-FIRST v2 = order)
done
echo "ot-heavy: NOT RUN: internal error, admission loop ended: $*" >&2; exit 70   # unreachable; never fall off the end with 0
