def sync_hosts(name, prev, hosts=None, fn=None, record=None):
    """PARALLEL-SYNC-1119 (COORD, FABLE-FLOW-0755 B: epyc8/9/10 sat 77 min behind across four promotions because the hosts were pushed one after another and one slow host held the rest):
    every host is pushed AT THE SAME TIME; one result line per host (with its duration) goes to the log as soon as it is known.  -> notes [h:ok | h:SKIP .. | h:FAIL ..] in HOSTS order."""
    import concurrent.futures as cf
    fn = fn or host_sync
    hs = list(HOSTS if hosts is None else hosts)

    def one(h):
        t0 = time.time()
        try:
            ok, note = fn(h, name, prev)
        except Exception as e:
            ok, note = False, f"{type(e).__name__}: {e}"
        log(f"{h}: {'ok' if ok else note[:160]} in {time.time() - t0:.0f}s")
        return h, ok, note
    with cf.ThreadPoolExecutor(max_workers=max(1, len(hs))) as ex:
        res = list(ex.map(one, hs))
    notes = []
    for h, ok, note in res:
        skipped = (not ok) and note.startswith("SKIP ")
        notes.append(f"{h}:{'ok' if ok else ('SKIP ' + note[5:] if skipped else 'FAIL ' + note)}")
        if record:
            record(h, ok, skipped, note)
        if skipped:
            log(f"WARNING {h} skipped, stays on its old rt/current: {note[5:]}")
    return notes


def prune_build_hosts(pins, hosts=None):
    """Prune independent host volumes concurrently, with at most three host scans at once."""
    from concurrent.futures import ThreadPoolExecutor

    hs = list(dict.fromkeys(HOSTS if hosts is None else hosts))
    if not hs:
        return

    # Each remote check looks for a 12-character lowercase hex snapshot name
    # anywhere in the input. Keep whole runs so embedded names still match.
    pins = "\n".join(sorted(set(re.findall(r"[0-9a-f]{12,}", pins))))

    def one(host):
        start = time.monotonic()
        try:
            result = run(SSH + [host, f"OT_RT_KEEP={KEEP} python3 -I {RT}/current/tools/fleet/ot-tools-sync prune"],
                         input=pins, timeout=900)
            note = (result.stdout or result.stderr).strip()[-120:]
            if result.returncode:
                note = f"rc={result.returncode} {note}"
        except Exception as exc:
            note = f"skipped: {type(exc).__name__}: {exc}"
        log(f"{host} prune ({time.monotonic() - start:.0f}s): {note}")

    with ThreadPoolExecutor(max_workers=min(3, len(hs))) as pool:
        list(pool.map(one, hs))


def sync(sha, hosts=True, tests=True):
    if not sha:
        git("fetch", "-q", REMOTE, "+refs/heads/main:refs/remotes/origin/main", timeout=300)
        sha = "origin/main"
    full = git("rev-parse", f"{sha}^{{commit}}").strip()
    prev = current()
    name = sha12(full)
    d = materialize(full)
    if prev != name:
        bad = smoke(d, tests=tests)
        if bad:
            log(f"{name}: smoke FAILED, current stays {prev or '-'}: {bad[:4]}")
            (RT / f"{name}.smoke-failed").write_text("\n".join(bad) + "\n")
            print(f"SMOKE-FAIL rt {name}: {bad[:3]}")
            return 3
        if hosts and GEN_SMOKE_HOSTS:                       # FABLE-FLOW-0600 D: smoke the gen-host copy BEFORE anything flips; red = nothing flips (revert)
            verdict, gnote, gh = "infra", "no gen smoke host", "-"
            for gh in GEN_SMOKE_HOSTS:
                ok, gnote = host_sync(gh, name, prev if prev and prev != name else "", do_flip=False, smoke_here=True)
                if ok:
                    verdict = "ok"
                    break
                if gnote.startswith("RED "):
                    verdict = "red"
                    break
                log(f"{name}: gen smoke on {gh} not run ({gnote[:160]}); next host")
            if verdict != "ok":
                log(f"{name}: GEN SMOKE {verdict.upper()} on {gh}, current stays {prev or '-'} on hub and hosts: {gnote}")
                (RT / f"{name}.smoke-failed").write_text(f"gen smoke {verdict} {gh}: {gnote}\n")
                print(f"GEN-SMOKE-{verdict.upper()} rt {name} {gh}: {gnote[:300]}")
                return 3 if verdict == "red" else 5
            log(f"{name}: gen smoke ok on {gh}")
        if hosts:
            sv, snote = spec_smoke(RT / name, (RT / prev) if prev and prev != name else None)
            if sv == "red":
                log(f"{name}: SPEC SMOKE RED, current stays {prev or '-'} on hub and hosts: {snote}")
                (RT / f"{name}.smoke-failed").write_text(f"spec smoke red: {snote}\n")
                print(f"SPEC-SMOKE-RED rt {name}: {snote[:300]}")
                return 3
            log(f"{name}: spec smoke {sv}: {snote[:300]}")
        flip(RT, name)
        with open(RT / "history.log", "a") as f:
            f.write(f"{now().isoformat(timespec='seconds')} hub current {prev or '-'} -> {name} ({full})\n")
    notes = []
    updated_hosts = []
    if hosts:
        def _rec(h, ok, skipped, note):
            if ok:
                updated_hosts.append(h)
            with open(RT / "history.log", "a") as f:
                f.write(f"{now().isoformat(timespec='seconds')} {h} {'current -> ' + name if ok else ('SKIPPED (low disk) ' + note[5:] if skipped else 'FAILED ' + note)}\n")
        notes = sync_hosts(name, prev if prev and prev != name else "", record=_rec)
    try:
        man_now = json.loads((RT / f"{name}.manifest.json").read_text()).get("files", {})
        # A deliberately skipped host keeps its previous runtime. Compare only
        # the hub and hosts that were expected to adopt this snapshot.
        diffs = installed_diffs(man_now, hosts=updated_hosts) if hosts else []
    except Exception as e:
        diffs = [f"installed-tools check failed: {type(e).__name__}: {e}"]
    if diffs:
        msg = "ALERT installed tools differ from rt/%s: %s" % (name, " ; ".join(diffs)[:1500])
        log(msg); print(msg)
        notes.append("ALERT installed != rt")
    if all(":ok" in n for n in notes) and KEEP > 0:
        prune_build_hosts(names_in_use_text())
    if all(":ok" in n for n in notes):
        try:
            prune_snapshots(RT, protect=(prev or "", name))
        except Exception as e:
            log(f"prune skipped: {type(e).__name__}: {e}")
    log(f"rt/current -> {name} (was {prev or '-'}); hosts {' '.join(notes) or 'skipped'}")
    print(f"rt/current -> {name} (was {prev or '-'}); hosts {' '.join(notes) or 'skipped'}")
    # FLOW-0800 (COORD 11-18): a host skipped for low disk is a WARNING (the follower retries it on the next change), not exit 4 for the whole sync
    return 0 if all(":ok" in n or ":SKIP " in n for n in notes) else 4


