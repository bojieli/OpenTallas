def private_spec_text(roots=None, now=None, max_age_h=None):
    """CLEAN-AGGR-R3: live private specs (autopilot/private_specs/**/*.json, modified within OT_RT_SPEC_MAX_AGE_H) name the rt their run-items use"""
    now = time.time() if now is None else now
