def free_gb(path):
    p = Path(path)
    while not p.exists() and p != p.parent:
        p = p.parent
    st = os.statvfs(p)
    return st.f_bavail * st.f_frsize / 2**30


SCRIPT_RE = re.compile(r"(?:^|\s)(/[^\s'\"]+\.(?:sh|py|tcl|json|cfg))(?=\s|$)")


def live_reference_text(proc="/proc", admit_logs=("/var/tmp/ot-heavy/admit.log",), max_script=2_000_000, tail_lines=800):
    """COORD 11-17 (S81-DIE-R3's D6z launch died: the epyc8 prune removed rt/24c7347cc887, which its launch script pinned): everything that can still NAME an rt/<sha> and run later --
    every process command line (queued ot-run clients, armed waiters `bash -c 'while pgrep ..; do sleep; done; python3 rt/<sha>/..'`, running jobs), their working directories, the
    targets of their open files, the CONTENT of the script files their command lines name (<= 2 MB), and the recent admission log (commands of ot-heavy units admitted or queued).
    Same reference rule as the cleaners' live-process check, widened to script bodies."""
    out = []
    for d in os.listdir(proc):
        if not d.isdigit():
            continue
        base = os.path.join(proc, d)
        try:
            cmd = open(os.path.join(base, "cmdline"), "rb").read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        out.append(cmd)
        try: out.append(os.readlink(os.path.join(base, "cwd")))
        except OSError: pass
        try:
            for f in os.listdir(os.path.join(base, "fd")):
                try: out.append(os.readlink(os.path.join(base, "fd", f)))
                except OSError: pass
        except OSError:
            pass
        for m in SCRIPT_RE.finditer(cmd):
            try:
                if os.path.getsize(m.group(1)) <= max_script:
                    out.append(open(m.group(1), errors="replace").read())
            except OSError:
                pass
    for lg in admit_logs:
        try: out += open(lg, errors="replace").read().splitlines()[-tail_lines:]
        except OSError: pass
    return "\n".join(out)


MIN_KEEP = 3          # the newest three snapshots stay whatever OT_RT_KEEP says (a rollback of the runtime must always be possible)


def names_in_use_text():
    """text in which a snapshot sha may be named: coord autopilot / handoff json, the crontab, user units (read-only, best effort)"""
    t = ""
    for pat in ("autopilot/*.json", "lanes/handoff/tree_switch_*.json"):
        for f in COORD.glob(pat):
            try: t += f.read_text(errors="replace")
            except OSError: pass
    for cmd in (["crontab", "-l"], ["systemctl", "--user", "cat", "*"]):
        try: t += S.run(cmd, capture_output=True, text=True, timeout=30).stdout
        except Exception: pass
    try: t += "\n" + live_reference_text()       # the hub's own queued / armed ot-run clients name the rt/<sha> a build host will run: sent to the hosts with the pins
    except Exception: pass
    return t


def prune_snapshots(root=RT, keep=None, protect=(), text=None, rm=None):
    """-> [removed names].  Snapshots are RT/<12 hex>; the newest `keep`, current, `protect`, any in_use() or named in `text` stay."""
    keep = KEEP if keep is None else keep
    if keep <= 0:
        return []
    keep = max(keep, MIN_KEEP)
    snaps = sorted((d for d in Path(root).iterdir() if re.fullmatch(r"[0-9a-f]{12}", d.name) and d.is_dir() and not d.is_symlink()),
                   key=lambda d: d.stat().st_mtime, reverse=True)
    cur = current(root)
    stay = {d.name for d in snaps[:keep]} | {cur, *protect}
    text = names_in_use_text() if text is None else text
    try: text = text + "\n" + live_reference_text()                    # this host's own processes, queued units and armed waiters too (on a build host `text` came from the hub)
    except Exception: pass
    gone = []
    for d in snaps:
        if d.name in stay or d.name in text or in_use(d):
            continue
        try:
            if rm: rm(d)
            else:
                run(["find", str(d), "-type", "d", "-exec", "chmod", "u+w", "{}", "+"])
                run(["rm", "-rf", "--one-file-system", "--", str(d)])
                (Path(root) / f"{d.name}.manifest.json").unlink(missing_ok=True)
            gone.append(d.name)
        except Exception as e:
            log(f"prune {d.name} failed: {e}")
    if gone:
        log(f"pruned {len(gone)} old snapshots (kept {keep} newest + current): {' '.join(gone[:6])}{' ...' if len(gone) > 6 else ''}")
    return gone


def now():
    return datetime.datetime.now().astimezone()


def log(msg):
    MQ.mkdir(parents=True, exist_ok=True)
    line = f"{now().strftime('%Y-%m-%d %H:%M:%S')} SYNC {msg}"
    print(line, flush=True)
    with open(MQ / "log", "a") as f:
        f.write(line + "\n")


def run(cmd, cwd=None, timeout=900, env=None, input=None):
    try:
        return S.run(cmd, cwd=str(cwd) if cwd else None, capture_output=True, text=True, timeout=timeout, env=env, input=input)
    except S.TimeoutExpired:
        return S.CompletedProcess(cmd, 124, "", "timeout")


def git(*a, cwd=REPO, timeout=600):
    p = run(["git", *a], cwd=cwd, timeout=timeout)
    if p.returncode:
        raise RuntimeError(f"git {' '.join(a)[:160]}: {(p.stderr or p.stdout).strip()[:300]}")
    return p.stdout


# ---------------------------------------------------------------- manifest (pure: also run on the hosts through ssh)

MANIFEST_PY = r'''
import hashlib, json, os, sys
SKIP = {".git", "__pycache__", ".pytest_cache"}
def manifest(root):
    out = {}
    for dp, dn, fn in os.walk(root):
        dn[:] = sorted(d for d in dn if d not in SKIP)
        for f in sorted(fn):
            p = os.path.join(dp, f)
            rel = os.path.relpath(p, root)
            if rel == ".git" or f.endswith(".pyc"):
                continue
            if os.path.islink(p):
                out[rel] = "link:" + os.readlink(p)
                continue
            h = hashlib.sha256()
            with open(p, "rb") as fh:
                for b in iter(lambda: fh.read(1 << 20), b""):
                    h.update(b)
            out[rel] = h.hexdigest()
    return out
def diff(have, want, paths=None):
    keep = lambda r: not paths or any(r == p or r.startswith(p.rstrip("/") + "/") for p in paths)
    changed = sorted(r for r in want if keep(r) and r in have and have[r] != want[r])
    missing = sorted(r for r in want if keep(r) and r not in have)
    extra = sorted(r for r in have if keep(r) and r not in want)
    return {"changed": changed, "missing": missing, "extra": extra}
'''
exec(MANIFEST_PY)


def sha12(s):
    return s[:12]


def in_use(path):
    """pids whose cmdline / cwd / open files name the dir (resolved)"""
    path = os.path.realpath(path)
    pids = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            cmd = open(f"/proc/{d}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
            cwd = os.path.realpath(f"/proc/{d}/cwd")
        except OSError:
            continue
        if path in cmd or cwd == path or cwd.startswith(path + "/"):
            pids.append(int(d))
    return pids


def flip(root, name):
    """RT/current -> name with one rename (atomic for readers)"""
    tmp = root / f".current.{os.getpid()}"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(name, tmp)
    os.replace(tmp, root / "current")


def current(root=RT):
    try:
        return os.readlink(root / "current")
    except OSError:
        return ""


