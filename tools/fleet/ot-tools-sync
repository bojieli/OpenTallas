def named_in(name, text):
    """a snapshot is named when its 12-hex name occurs in text, or an rt/<hex> / tools_sha / gen_tools_pin value of 8..40 hex is a prefix of it or
    starts with it (kit_wave tools_sha / gen_tools_pin may be a full 40-hex sha or a short one)"""
    if name in text:
        return True
    for tok in set(re.findall(r"(?:rt/|tools_sha\W{1,6}|gen_tools_pin\W{1,6}|tools_pin\W{1,6})([0-9a-f]{8,40})(?![0-9a-f])", text)):
        if tok.startswith(name) or name.startswith(tok):
            return True
    return False


MIN_KEEP = 3          # the newest three snapshots stay whatever OT_RT_KEEP says (a rollback of the runtime must always be possible)


def names_in_use_text():
    """text in which a snapshot sha may be named: coord autopilot / handoff json, the crontab, user units (read-only, best effort)"""
    t = ""
    for pat in ("autopilot/*.json", "lanes/handoff/tree_switch_*.json"):
        for f in COORD.glob(pat):
