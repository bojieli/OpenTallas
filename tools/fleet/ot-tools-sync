HOST_LOCK_WAIT_S = float(os.environ.get("OT_SYNC_HOST_LOCK_WAIT_S", "900"))


def host_sync(host, name, prev, do_flip=True, smoke_here=False, lock_dir=None, _inner=None):
    """HOST-LOCK-1119 (COORD, FABLE-FLOW-0035: three failed syncs in 45 min and epyc10 one revision behind: the follower, the catch-up timer and manual syncs pushed the same host's .partial dir at the
    same time): ONE push per host at a time, under a flock on RT/.hostsync.<host>.lock; a second pusher waits up to HOST_LOCK_WAIT_S (a push that finished meanwhile is then a no-op because the
    manifest is already there) and gives up with a 'busy' note instead of colliding."""
    import fcntl
    ld = Path(lock_dir) if lock_dir else RT
    try:
        ld.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass
    lf = open(ld / f".hostsync.{host}.lock", "w")
    t_end = time.time() + HOST_LOCK_WAIT_S
    while True:
        try:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() > t_end:
                return False, f"busy: another sync has been pushing {host} for over {HOST_LOCK_WAIT_S:.0f} s"
            time.sleep(1.0)
    try:
        return (_inner or _host_sync_unlocked)(host, name, prev, do_flip, smoke_here)
    finally:
        lf.close()


def host_links(D, name, rt=None):
    """RT-HOST-DATA-MAN-1124: shell that points RT/<name> and RT/<name>.manifest.json at a version installed on D (two small symlinks, each made
    beside the target name and renamed over it).  The manifest link goes last: it is what marks the version HAVE."""
    rt = str(rt or RT)
    return (f"ln -sfn {D}/{name} {rt}/.{name}.lnk && mv -T {rt}/.{name}.lnk {rt}/{name} && "
            f"ln -sfn {D}/{name}.manifest.json {rt}/.{name}.ml && mv -T {rt}/.{name}.ml {rt}/{name}.manifest.json")


def _host_sync_unlocked(host, name, prev, do_flip=True, smoke_here=False):
    """copy RT/<name> (HOST_PATHS) to host, check it there (manifest + parse; with smoke_here also gen_smoke), flip host RT/current -> (ok, note).
    A note starting 'RED ' means the content is wrong (not the host)."""
    D = HOST_DATA.get(host) or str(RT)                    # RT-HOST-DATA-1124: where this host's version dirs are written
    # RT-HOST-DATA-MAN-1124 (COORD: epyc10 07:54 'install: cat: -: No space left on device'): on a host-data host the 2 MB manifest is written
    # to D too, and RT gets only two small symlinks (RT/<name> and RT/<name>.manifest.json).  A version whose data and manifest are on D but
    # whose RT links are missing (a full RT disk at install) is DATA: the next sync only re-makes the links, it never copies again.
    data = (f" || {{ test -f {D}/{name}.manifest.json && test -d {D}/{name} && echo DATA; }}" if D != str(RT) else "")
    r = run(SSH + [host, f"test -f {RT}/{name}.manifest.json && echo HAVE{data} || {{ mkdir -p {D} && df -BG --output=avail {D}/.. | tail -n1; }}"], input="")
    if r.returncode == 0 and "DATA" in r.stdout and "HAVE" not in r.stdout:
        r = run(SSH + [host, host_links(D, name)], input="")
        if r.returncode:
            return False, f"install links: {(r.stderr or r.stdout).strip()[:200]}"
        r.stdout = "HAVE"
    elif r.returncode == 0 and "HAVE" not in r.stdout:
        try:
            hf = float(r.stdout.strip().split()[-1].rstrip("G"))
        except (ValueError, IndexError):
            hf = None
        if hf is not None and hf < HOST_MIN_FREE_GB:
            return False, f"SKIP {hf:.0f} GB free < {HOST_MIN_FREE_GB:g} GB (OT_RT_HOST_MIN_FREE_GB); not copied"      # SKIP = a low-disk host is a warning, not a failed sync (11-18)
        r = run(SSH + [host, f"mkdir -p {D}/.{name}.partial"], input="")
    if r.returncode:
        return False, f"ssh: {(r.stderr or r.stdout).strip()[:160]}"
    if "HAVE" not in r.stdout:
        link = ["--link-dest", f"{D}/{prev}/"] if prev else []          # a prev that is not on D: rsync warns and copies (first cut on a new D)
        args = ["rsync", "-a", "--relative", "--exclude=__pycache__", *link,
                "-e", "ssh -o ControlPath=none -o BatchMode=yes", *[f"{RT}/{name}/./{p}" for p in HOST_PATHS],
                f"{host}:{D}/.{name}.partial/"]
        r = run(args, timeout=1800)
        if r.returncode:
            return False, f"rsync rc={r.returncode}: {(r.stderr or '').strip()[:200]}"
        man = json.loads((RT / f"{name}.manifest.json").read_text())
        sub = {k: v for k, v in man["files"].items() if any(k.startswith(p.rstrip("/") + "/") for p in HOST_PATHS)}
        check = MANIFEST_PY + f'''
