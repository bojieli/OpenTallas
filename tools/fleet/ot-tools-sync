'''
        r = run(SSH + [host, "python3", "-I", "-c", shlex.quote(check)], input=json.dumps(sub), timeout=600)
        try:
            bad = json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            return False, f"remote check failed rc={r.returncode}: {(r.stderr or r.stdout).strip()[:200]}"
        if bad:
            return False, f"RED remote copy differs: {bad[:5]}"
        if smoke_here:
            v, note = gen_smoke(host, Path(D) / f".{name}.partial")
            if v != "ok":
                return False, ("RED gen smoke: " if v == "red" else "gen smoke not run: ") + note
        m = json.dumps({"sha": man["sha"], "made": man["made"], "files": sub})
        r = run(SSH + [host, f"chmod -R a-w {D}/.{name}.partial/* && mv -T {D}/.{name}.partial {D}/{name} && "
                             f"cat > {D}/.{name}.m.tmp && mv {D}/.{name}.m.tmp {D}/{name}.manifest.json"
                             + (f" && {host_links(D, name)}" if D != str(RT) else "")], input=m)
        if r.returncode:
            return False, f"install: {(r.stderr or r.stdout).strip()[:200]}"
    elif smoke_here:                                       # copied by an earlier sync: smoke the installed copy
        v, note = gen_smoke(host, RT / name)
        if v != "ok":
