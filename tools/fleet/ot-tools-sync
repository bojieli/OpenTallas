def smoke(d, tests=True):
    """-> [problems]: every Python file under tools/autopilot + tools/fleet + tools/die_plan (top level) parses, every shell
    script of physical/common_flow + tools/fleet passes bash -n, the wave suite passes, and the tree is still clean"""
    bad = []
    for sub in ("tools/autopilot", "tools/fleet", "tools/die_plan", "physical/common_flow"):
        base = d / sub
        if not base.is_dir():
            bad.append(f"{sub} missing")
            continue
        for p in sorted(base.iterdir()):
            if not p.is_file() or p.suffix in (".pyc", ".json", ".md", ".tsv", ".txt", ".tcl", ".sdc", ".lef", ".lib", ".v", ".sv"):
                continue
            try:
                txt = p.read_text(errors="replace")
            except OSError:
                continue
            first = txt.split("\n", 1)[0]
            if p.suffix == ".py" or (first.startswith("#!") and "python" in first):
                try:
                    compile(txt, str(p), "exec", dont_inherit=True)
                except SyntaxError as e:
                    bad.append(f"{p.relative_to(d)}: SyntaxError line {e.lineno}")
            elif p.suffix == ".sh" or (first.startswith("#!") and re.search(r"\b(ba)?sh\b", first)):
                if run(["bash", "-n", str(p)], timeout=60).returncode:
                    bad.append(f"{p.relative_to(d)}: bash -n")
    if tests and SMOKE_TESTS and Path(PY).exists():
        tmp = MQ / "smoke-tmp"
        tmp.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", TMPDIR=str(tmp))
        env.pop("PYTHONPATH", None)
        p = run([PY, "-m", "pytest", "-q", "-n", "8", "-p", "no:cacheprovider", "-W", "ignore", f"--basetemp={tmp}/bt",
                 "--tb=line", *SMOKE_TESTS], cwd=d, timeout=1200, env=env)
        if p.returncode not in (0, 5):
            bad.append(f"smoke tests rc={p.returncode}: {' | '.join((p.stdout or p.stderr).strip().splitlines()[-3:])[:300]}")
    if (d / ".git").exists():
        st = run(["git", "status", "--porcelain", "--untracked-files=all"], cwd=d, timeout=300).stdout
        st = [l for l in st.splitlines() if "__pycache__" not in l]
        if st:
            bad.append(f"tree not clean after smoke: {st[:5]}")
    return bad


FLOW_BLOB_DIRS = ("tools/die_plan", "physical/common_flow")
FLOW_BLOB_DAYS = int(os.environ.get("OT_RT_FLOW_BLOB_DAYS", "30"))
FLOW_BLOB_REL = "tools/.flow_blobs.json"


def flow_blobs(full, days=FLOW_BLOB_DAYS):
    """{rel: [git blob ids]} of every .tcl/.py/.sh under FLOW_BLOB_DIRS at `full` plus every version main had in the last `days`:
    kit_flow_refresh.py replaces a kit's verbatim copy of an older version by the current one (COORD 11-18 flow-script class fix)"""
    ext = (".tcl", ".py", ".sh")
    out = {}
    for ln in git("ls-tree", "-r", full, "--", *FLOW_BLOB_DIRS).splitlines():
        meta, _, rel = ln.partition("\t")
        if rel.endswith(ext) and meta.split()[1] == "blob":
            out.setdefault(rel, set()).add(meta.split()[2])
    for ln in git("log", f"--since={days}.days", "--format=", "--raw", "--no-abbrev", "--no-renames", full, "--", *FLOW_BLOB_DIRS,
                  timeout=1200).splitlines():
        if not ln.startswith(":"):
            continue
        meta, _, rel = ln.partition("\t")
        f = meta.split()
        if rel.endswith(ext):
            for b in (f[2], f[3]):
                if set(b) != {"0"}:
                    out.setdefault(rel, set()).add(b)
    return {k: sorted(v) for k, v in sorted(out.items())}


def write_flow_blobs(d, full):
    try:
        blobs = flow_blobs(full)
    except Exception as e:                                 # noqa: BLE001 - an index failure never blocks the rt version
        log(f"flow blob index skipped: {type(e).__name__}: {e}")
        return
    try:                                                   # untracked in the worktree: keep the smoke's clean-tree check quiet
        ex = Path(git("rev-parse", "--git-common-dir", cwd=d).strip())
        ex = (ex if ex.is_absolute() else d / ex) / "info" / "exclude"
        ex.parent.mkdir(parents=True, exist_ok=True)
        if "/" + FLOW_BLOB_REL not in (ex.read_text() if ex.exists() else ""):
            with open(ex, "a") as f:
                f.write("/" + FLOW_BLOB_REL + "\n")
    except Exception as e:                                 # noqa: BLE001
        log(f"flow blob exclude: {type(e).__name__}: {e}")
    (d / FLOW_BLOB_REL).write_text(json.dumps({"sha": full, "days": FLOW_BLOB_DAYS, "blobs": blobs}, sort_keys=True))


def set_aside_partial(d, in_use_fn=None, rt=None):
    """MATERIALIZE-FRESH-1119 (COORD: rt sync died 'rt/88537c5e1383 is partial but in use; not touched', rt/current stuck behind main): a partial build dir is NEVER a reason to refuse.  Not in use -> it is
    removed by the caller as before.  In use (another sync still building it, or a stray cwd) -> it is RENAMED aside to RT/.stale-<name>-<pid> (processes keep their cwd; git worktree metadata is pruned) and
    the caller builds a fresh dir under the real name.  -> the stale path or None"""
    import os as _os
    rt = rt or RT
    if not (in_use_fn or in_use)(d):
        return None
    st = Path(rt) / f".stale-{Path(d).name}-{_os.getpid()}"
    _os.rename(d, st)
    return st


def materialize_lock(name):
    """one materialize of a given sha at a time (the follower, the catch-up timer and manual syncs raced into the same partial dir): flock RT/.materialize.<name>.lock, waits up to 20 min"""
    import fcntl
    lf = open(RT / f".materialize.{name}.lock", "w")
    t_end = time.time() + 1200
    while True:
        try:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lf
        except OSError:
            if time.time() > t_end:
                raise RuntimeError(f"another sync has been building rt/{name} for over 20 min")
            time.sleep(2.0)


def materialize(full):
    """hub: RT/<sha12> as a detached sparse worktree, files read-only, manifest beside it -> dir"""
    name = sha12(full)
    d = RT / name
    ok = RT / f"{name}.manifest.json"
    if d.is_dir() and ok.is_file():
        return d
    RT.mkdir(parents=True, exist_ok=True)
    fg = free_gb(RT)
    if fg < MIN_FREE_GB:
        pruned = prune_snapshots(RT, protect=(current() or "",))          # make room by dropping the oldest unused snapshots first
        fg = free_gb(RT)
        if fg < MIN_FREE_GB:
            raise RuntimeError(f"{RT}: {fg:.0f} GB free < {MIN_FREE_GB:g} GB (OT_RT_MIN_FREE_GB); nothing written (pruned {len(pruned)})")
    _mlock = materialize_lock(name)                        # held until this function returns; after the disk check so a refused write leaves RT untouched
    if d.is_dir() and ok.is_file():                        # the other builder finished while we waited
        return d
    if d.exists():                                         # a partial earlier attempt (no manifest): rebuild it if unused
        if set_aside_partial(d) is None:
            run(["git", "worktree", "remove", "--force", str(d)], cwd=REPO)
            if d.exists():
                run(["rm", "-rf", "--one-file-system", str(d)])
    run(["git", "worktree", "prune"], cwd=REPO)
    git("worktree", "add", "-q", "--detach", "--no-checkout", str(d), full)
    git("sparse-checkout", "set", "--no-cone", *SPARSE, cwd=d)
    git("checkout", "-q", "--detach", full, cwd=d, timeout=1200)
    head = git("rev-parse", "HEAD", cwd=d).strip()
    if head != full:
        raise RuntimeError(f"{d} HEAD {head} != {full}")
    write_flow_blobs(d, full)
    run(["chmod", "-R", "a-w", "--", *[str(x) for x in d.iterdir() if x.name != ".git"]])
    m = manifest(str(d))
    t = RT / f".{name}.manifest.tmp"
    t.write_text(json.dumps({"sha": full, "made": now().isoformat(timespec="seconds"), "files": m}, sort_keys=True))
    os.replace(t, ok)
    return d


