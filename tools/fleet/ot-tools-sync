            except OSError: pass
    for cmd in (["crontab", "-l"], ["systemctl", "--user", "cat", "*"]):
        try: t += S.run(cmd, capture_output=True, text=True, timeout=30).stdout
        except Exception: pass
    try: t += "\n" + private_spec_text()
    except Exception: pass
    try: t += "\n" + live_reference_text()       # the hub's own queued / armed ot-run clients name the rt/<sha> a build host will run: sent to the hosts with the pins
    except Exception: pass
    return t


def prune_snapshots(root=RT, keep=None, protect=(), text=None, rm=None):
    """-> [removed names].  Snapshots are RT/<12 hex>; the newest `keep`, current, `protect`, any in_use() or named in `text` stay."""
    keep = KEEP if keep is None else keep
    if keep <= 0:
        return []
    root = Path(root)
    if not any(re.fullmatch(r"[0-9a-f]{12}", d.name) and d.is_dir() and (not d.is_symlink() or _data_target(d)) for d in root.iterdir()):
        return []
    import fcntl

    with (root / ".prune.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log(f"{root} prune skipped: a prune is already active")
            return []
        return _prune_snapshots_locked(root, max(keep, MIN_KEEP), protect, text, rm)


def _data_target(d):
    """RT-HOST-DATA-1124: the data dir of a symlinked version RT/<sha12> -> <data>/<sha12> (same name, a real dir), else None"""
    try:
        if not os.path.islink(d):
            return None
        t = Path(os.path.realpath(d))
        return t if t.name == Path(d).name and t.is_dir() and not t.is_symlink() else None
    except OSError:
        return None


def _prune_snapshots_locked(root, keep, protect, text, rm):
    snaps = sorted((d for d in root.iterdir() if re.fullmatch(r"[0-9a-f]{12}", d.name) and d.is_dir() and (not d.is_symlink() or _data_target(d))),
                   key=lambda d: d.stat().st_mtime, reverse=True)
    cur = current(root)
    stay = {d.name for d in snaps[:keep]} | {cur, *protect}
    text = names_in_use_text() if text is None else text
    try: text = text + "\n" + live_reference_text()                    # this host's own processes, queued units and armed waiters too (on a build host `text` came from the hub)
    except Exception: pass
    gone = []
    for d in snaps:
        if d.name in stay or d.name == current(root) or named_in(d.name, text) or in_use(d):
            continue
        try:
            if rm: rm(d)
            else:
                tgt = _data_target(d)                                       # RT-HOST-DATA-1124: a symlinked version: drop the link, then its data dir
                if tgt:
                    d.unlink()
                    d = tgt
                run(["find", str(d), "-type", "d", "-exec", "chmod", "u+w", "{}", "+"])
                run(["rm", "-rf", "--one-file-system", "--", str(d)])
                (Path(root) / f"{tgt.name if tgt else d.name}.manifest.json").unlink(missing_ok=True)
                if tgt:                                                     # RT-HOST-DATA-MAN-1124: its manifest lives on the data disk too
                    (tgt.parent / f"{tgt.name}.manifest.json").unlink(missing_ok=True)
            gone.append(d.name)
        except Exception as e:
            log(f"prune {d.name} failed: {e}")
    if gone:
        log(f"pruned {len(gone)} old snapshots (kept {keep} newest + current): {' '.join(gone[:6])}{' ...' if len(gone) > 6 else ''}")
    return gone


