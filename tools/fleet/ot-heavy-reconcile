def conf(key):
    """a v8 admission factor: the environment, else /etc/ot-heavy.conf (KEY=value), else DEFAULTS"""
    v = os.environ.get(key)
    if v is None:
        m = re.search(rf"^{key}=([0-9.]+)", rd("/etc/ot-heavy.conf"), re.M)
        v = m[1] if m else None
    try:
        return float(v) if v is not None else DEFAULTS[key]
    except ValueError:
        return DEFAULTS[key]


def class_peak(cls, table):
    e = table.get(cls) if cls and cls not in ("?", "cd") else None
    return e["peak_gb"] if e and e["n"] + e.get("proved", 0) >= 1 and e["peak_gb"] > 0 else None


def books(rows, total, avail, table, gf=None):
    """the charge of every unit (r['grow'], GB it may still take) and the host sums; see the module text for the rule"""
    gf = conf("GROWTH_FACTOR") if gf is None else gf
    young = 0.0
    for r in rows:
        r["cp"] = class_peak(r.get("cls"), table)
        if not r["active"]:                            # admitted a moment ago and not started yet: its whole charge
            # v12: held while its ot-heavy launcher still lives (systemd-run can take > GONE_S under load)
            hold = r["file_age"] <= GONE_S or (r.get("launcher_alive") and r["file_age"] <= conf("LAUNCH_HOLD_S"))
            r["exp"] = r["res"] if hold else 0.0
            young += r["exp"]
            continue
        r["ceil"] = min(r["req"], r["res"]) if r["now"] < 0.8 * r["res"] else r["req"]
        if r["age"] < YOUNG_S:
            exp = max(1.1 * r["cp"], r["now"] + 4) if r["cp"] else max(r["req"] / 2, r["now"] + 4)
            r["exp"] = max(0.0, min(exp, r["ceil"]) - r["now"])
            young += r["exp"]
    plenty = avail - young >= PLENTY * total
    win, gfull = conf("GROW_WINDOW_S"), conf("GROWING_FACTOR")
    pending, settled = 0.0, 0.0
    for r in rows:
        r["pending"] = False
        if not r["active"]:
            r["grow"] = gfull * r["exp"]               # v12: the whole reservation (v8 charged GROWTH_FACTOR x it)
            r["pending"] = r["exp"] > 0
            pending += r["grow"]
            continue
        now = r["now"]
        margin = max(0.0, r["ceil"] - now)
        # v14 OLD SLOW / v15 BUILD WAIT: past GROW_WINDOW_S (v14: 2 h), measured, frontend only waiting on its --build
        orate = max(r.get("slow", 0.0), r.get("rate", 0.0))
        build_wait = (r.get("frontend_waiting") and r["age"] >= max(win, conf("OLD_S")) and r.get("sampled", True) and
                      (r.get("slow_span", 0.0) >= conf("OLD_MIN_SPAN_S") or r.get("rate", 0.0) > 0))
        if r.get("frontend_pids") and not build_wait:
            # A real Verilator frontend can grow again after a long AST/DFG plateau. Its declared budget
            # stays pending until that executable exits, even when class reconciliation lowered res.
            r["grow"], r["pending"] = max(0.0, r.get("declared", r["req"]) - now), True
        elif r["age"] < win or not r.get("sampled", True):
            # v12/v13: admitted in the last GROW_WINDOW_S, or reconcile has no RSS sample of it yet (still building):
            # its whole remaining reservation
            r["grow"], r["pending"] = gfull * margin, True
        elif r.get("frontend_pids"):
            # v14: an old, slowly growing --build job whose frontend only waits on the C++ compile (cc1plus RSS is
            # what grows): 3 x the growth its measured rate gives over the next 30 min, at most 32 GB, <= the margin
            if orate * 600 < conf("OLD_SLOW_GB"):
                r["grow"] = min(margin, conf("OLD_MULT") * orate * conf("OLD_HORIZON_S"), conf("OLD_CAP_GB"))
            else:                                      # v15: a fast -j cc1plus burst: the v13 rate rule
                r["grow"] = min(margin, conf("RATE_MULT") * orate * conf("RATE_HORIZON_S"))
            r["pending"] = True
        elif r.get("rate", 0.0) > 0:
            # v13: RSS rose > 5 % between the last two cron samples: RATE_MULT x the measured rate over RATE_HORIZON_S
            r["grow"], r["pending"] = min(margin, conf("RATE_MULT") * r["rate"] * conf("RATE_HORIZON_S")), True
        else:
            # v13: stable or old: nothing beyond what it holds (earlyoom + per-job MemoryMax + the settled floor below)
            r["grow"] = 0.0
            settled += margin
        # v16 MEASURED RESERVE (coordinator 10-22, owner 10-17 "admit ASAP, light reservations, swap is the safety net";
        # ep7 10-22: avail 632 GB, growth charged 510 -> admits 176, S81 H11 300 GB die build queued): a running unit
        # past YOUNG_S with an RSS sample is charged what its MEASURED growth gives over the next ~30 min, never the
        # full projection (declared - now): min(projection above, RESERVE_K x observed rate x RESERVE_HORIZON_S).
        # A Verilator frontend still in its AST/DFG phase grows in steps its RSS slope cannot show (gold2 10-21: flat
        # at 476 of 720 GB, then +244): it keeps its projection and is bounded only by the host cap below.
        in_ast = r.get("frontend_pids") and not build_wait
        if conf("MEASURED_RESERVE") and r["age"] >= YOUNG_S and r.get("sampled", True) and r["grow"] > 0 and not in_ast:
            r["grow"] = max(0.0, min(r["grow"], conf("RESERVE_K") * orate * conf("RESERVE_HORIZON_S")))
            r["pending"] = r["pending"] and r["grow"] > 0
        if r["pending"]:
            pending += r["grow"]
    # v13: a small host floor for the settled units' combined slack, never above that slack
    sfloor = min(settled, conf("SETTLED_FLOOR_FRAC") * total)
    grow = sum(r["grow"] for r in rows) + sfloor
    unstarted = sum(r["grow"] for r in rows if not r["active"])
    if conf("MEASURED_RESERVE"):
        # v16: the growth charge of RUNNING units (and the settled floor) is capped at GROWTH_CAP_AVAIL_FRAC (25 %) of
        # physical MemAvailable; swap and the per-job MemoryMax (memcg OOM, oom_score_adj -999/0 since 10-22) are the
        # safety net.  Memory of units admitted < YOUNG_S ago or not started yet is NOT capped: MemAvailable cannot show
        # it yet (EP7 10-21: five rapid 64 GB replays at 146 GB available -> earlyoom burst)
        fresh = sum(r["grow"] for r in rows if not r["active"] or r["age"] < YOUNG_S)
        fresh_p = sum(r["grow"] for r in rows if r["pending"] and (not r["active"] or r["age"] < YOUNG_S))
        cap = conf("GROWTH_CAP_AVAIL_FRAC") * max(avail, 0.0)
        grow = fresh + min(grow - fresh, cap)
        pending = fresh_p + min(pending - fresh_p, cap)
    return dict(grow=grow, young=young, plenty=plenty, pending=pending, settled_floor=sfloor, unstarted=unstarted,
                fresh_gb=sum(r["grow"] for r in rows if not r["active"] or r["age"] < YOUNG_S),
                used=sum(r["now"] for r in rows), reserved=sum(r["res"] for r in rows if r["active"]),
                running=sum(1 for r in rows if r["active"]), fresh=sum(1 for r in rows if r["active"] and r["age"] < 90))


def floor_gb(total):
    try:
        return float(os.environ["REAL_FLOOR_GB"])
    except (KeyError, ValueError):
        return conf("MIN_AVAIL_FRAC") * total


def charged_growth(b, total):
    """Sum the supported per-unit growth without hiding concurrent jobs behind a host-wide cap.

    books() already applies age, observed/class peaks and the configured GROWTH_FACTOR to each unit.
    Keeping the total argument preserves the placement/admission API; legacy GROWTH_CAP_FRAC is ignored.
    """
    return b["grow"]


def admissible(total, avail, b, floor, need=None):
    """v8: the largest DECLARED request (charge) the host admits now (GB, may be negative): NEED_FACTOR x it must fit in
    MemAvailable - the full sum of supported unit growth, and leave MemAvailable above the floor"""
    need = conf("NEED_FACTOR") if need is None else need
    return min(avail - charged_growth(b, total), avail - floor) / need


def die_admissible(avail, b, floor, need, can):
    """the largest request a die-level job is admitted at now.  v9-v15: current memory minus pending growth (/ NEED);
    v16 (coordinator 10-22): physical MemAvailable - DIE_HEADROOM_GB (64) >= its request, minus only the memory of
    units admitted < YOUNG_S ago or not started yet (memory MemAvailable cannot show yet); swap is the safety net"""
    old = max(can, min(avail - b.get("pending", 0.0) - b.get("settled_floor", 0.0), avail - floor) / need)
    if not conf("MEASURED_RESERVE"):
        return old
    return max(can, avail - b.get("fresh_gb", b.get("unstarted", 0.0)) - conf("DIE_HEADROOM_GB"))


_LATE = {}


def class_late(cls, table):
    """v17.4: a class's measured late growth = the 75th percentile of its finished runs' peaks (peaks.tsv; table
    entries may carry it as 'p75_gb') when >= 3 runs are recorded, else its measured peak (class_peak)"""
    e = table.get(cls) if cls else None
    if e and e.get("p75_gb"):
        return e["p75_gb"]
    if "_" not in _LATE:
        runs = {}
        for ln in rd(PEAKS).splitlines():
            f = ln.split("\t")
            if len(f) >= 5:
                try:
                    runs.setdefault(f[2], []).append(float(f[4]))
                except ValueError:
                    pass
        _LATE["_"] = {c: sorted(v)[min(len(v) - 1, int(0.75 * len(v)))] for c, v in runs.items() if len(v) >= 3}
    return _LATE["_"].get(cls) or class_peak(cls, table)


def phase_target(r, table):
    """v17.4 (coordinator 10-22 (b)/(c)) what a unit in a known growth phase may still reach, capped at its declared
    --mem: its class's measured peak; with none, a Verilator build in its C++ compile (or frontend) holds its declared
    cap (ep9 16:52: S81 run_h11r declared 300 GB, 30-60 GB for 2 h, then 250 GB) and an openroad GPL/GRT/DRT step its
    family seed (family_seed).  Settled units (no growth phase) get nothing beyond max(now, peak)."""
    ph = r.get("phase")
    if not ph or not conf("PHASE_MARGIN"):
        return 0.0
    cap = r.get("decl") or r.get("declared") or r.get("req") or 0.0
    cp = class_late(r.get("cls"), table or {})
    if cp:
        return min(cap, cp) if cap else cp
    if ph == "vl":
        return cap
    for pre in SEED:
        if (r.get("cls") or "").startswith(pre):
            return min(cap, family_seed(r["cls"], pre, table or {})[0]) if cap else 0.0
    return 0.0


def invariant(rows, total, avail, b, table=None):
    """v17 HARD INVARIANT (S81c coordinator / TOKc-ADM 2026-10-22; ep5 14:12-14:22 and gold2 13:07 earlyoom cc1plus kills at
    mem 3 % / swap 100 % while every scope sat under its own cap): the host's committed memory, never above physical RAM
    minus INV_HEADROOM_GB (64):
      committed = (MemTotal - MemAvailable) + sum over running units of (max(now, measured peak so far, <= MemoryMax) - now)
                = other + sum(max(now, peak)) when the units' memory is all in use
                  + reserve (the v16 running-growth charge beyond each unit's peak gap; v17.1: no settled floor) + fresh (unstarted / < YOUNG_S units'
                  charge beyond what they already hold or peaked at)
      other     = (MemTotal - MemAvailable) - sum(now): memory held outside ot-heavy units (closure-daemon docker,
                  sessions; ep5 10-22 ~540 GB), so committed >= physical memory in use
    A request is admitted only when committed + request <= MemTotal - INV_HEADROOM_GB; die jobs too.  free < 0 -> nothing
    is admitted.  The running units' own growth cannot be stopped here; this keeps NEW admissions off an exhausted host."""
    used = max(0.0, total - avail)
    act = [r for r in rows if r["active"]]
    now = sum(r["now"] for r in act)
    held = 0.0
    fresh = 0.0
    run_grow = 0.0                                     # v16 running-growth charge of the old units, before the cap
    reserve_dup = 0.0                                  # v17.1: part of it already inside a unit's peak gap
    # v17.5 (coordinator 20:00, fleet ~2.4 TB available admitting ~0; gold2 peak gap 391 GB, ep7 323 GB): the v17.4
    # phase targets (class p75 for any unit in a vl/or phase, generic classes such as run_dv_slice.sh at 234 GB) are
    # the bulk of the peak gap.  Their sum beyond what each unit holds or peaked at in this step is capped at
    # PHASE_CAP_AVAIL_FRAC (10 %) of available, scaled per unit; measured step peaks are charged in full.
    base, extra = {}, {}
    for r in rows:
        if r["active"]:
            h0 = max(r["now"], min(r.get("obs", r["now"]), r.get("req", r.get("obs", r["now"]))))
            base[id(r)], extra[id(r)] = h0, max(0.0, phase_target(r, table) - h0)   # v17.4 (b)/(c): growth-phase units only
    tot_extra = sum(extra.values())
    pcap = conf("PHASE_CAP_AVAIL_FRAC") * max(avail, 0.0)
    scale = 1.0 if tot_extra <= pcap or tot_extra <= 0 else pcap / tot_extra
    for r in rows:
        if not r["active"]:
            fresh += r.get("grow", 0.0)
            continue
        h = base[id(r)] + scale * extra[id(r)]
        held += h
        g = r.get("grow", 0.0)
        if r["age"] < YOUNG_S:                         # its fresh charge counts beyond what max(now, peak) already holds
            fresh += max(0.0, r["now"] + g - h)
        else:
            # v17.1 (coordinator 16:0x, ep5 committed 1,163 at 219 GB available): a running unit's v16 growth (from
            # now) and its peak gap (peak - now) are the SAME headroom; charge max(peak, now + grow) - now, not both
            run_grow += g
            reserve_dup += min(g, h - r["now"])
    # v16 reserve of the old running units (already capped at 25 % of available), minus what their peak gaps hold;
    # v17.1: the v13 settled floor is a safety pad and is NOT charged here -- INV_HEADROOM_GB (64) is the pad
    capped = max(0.0, b["grow"] - b.get("fresh_gb", 0.0) - b.get("settled_floor", 0.0))
    reserve = max(0.0, min(capped, run_grow) - reserve_dup)
    other = max(0.0, used - now)
    # = other + held when the units' memory.current is all in use; when it holds reclaimable page cache (now > what
    # MemAvailable says is in use) the cache is not counted twice: in use + every unit's peak above what it holds now
    committed = used + (held - now) + reserve + fresh
    limit = total - conf("INV_HEADROOM_GB")
    return dict(committed=committed, free=limit - committed, limit=limit, other=other, held=held, now=now, used=used,
                reserve=reserve, fresh=fresh, phase_extra=scale * tot_extra, phase_raw=tot_extra, on=bool(conf("HARD_INVARIANT")))


def inv_cap(x, inv):
    """v17: an admission capacity bounded by the hard invariant headroom"""
    return min(x, inv["free"]) if inv["on"] else x


def inv_text(inv):
    return (f"invariant: committed {inv['committed']:.0f} GB (in use {inv['used']:.0f}, other {inv['other']:.0f}, units max(now, peak) {inv['held']:.0f}, "
            f"+ reserve {inv['reserve']:.0f} + fresh {inv['fresh']:.0f}) vs physical - {conf('INV_HEADROOM_GB'):g} = "
            f"{inv['limit']:.0f} GB -> headroom {inv['free']:.0f} GB" + ("" if inv["on"] else " (HARD_INVARIANT=0: not enforced)"))


def holds_admit_lock(fd=8):
    """v12: True when our caller (ot-heavy: `exec 8>>admit.lock; flock 8`) passed us the admission lock on fd 8"""
    try:
        a, b = os.fstat(fd), os.stat(LOCK)
    except OSError:
        return False
    return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)


def gate(mem, argv):
    """ot-heavy asks under its admission lock: may this request start now, and at what charge.  v12: a caller that does
    not hold the lock gets it taken here, so two admissions never read the same books."""
    if holds_admit_lock():
        return gate_locked(mem, argv)
    with open(LOCK, "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        return gate_locked(mem, argv)


def gate_locked(mem, argv):
    cls = classify(argv)
    table = sizes()
    a = admit_size(mem, cls, table)
    res, note = (a[0], a[1]) if a and a[0] < mem else (mem, "")
    total, avail = meminfo()
    rows = read_units()
    for r in rows:                                     # finished long ago: drop the reservation and its side files
        if not r["active"] and r["file_age"] > 120:
            for p in (r["file"], f"{D}/meta.{r['unit']}", f"{D}/orig.{r['unit']}"):
                try:
                    os.unlink(p)
                except OSError:
                    pass
    b = books(rows, total, avail, table)
    floor, need = floor_gb(total), conf("NEED_FACTOR")
    can = admissible(total, avail, b, floor, need)
    # v9: a die job is admitted on current memory alone; v12: memory promised to units admitted in the last
    # GROW_WINDOW_S / still growing (b["pending"]) is not current memory, so it is charged to die jobs too
    # v13: and the settled floor (die jobs still never pay the settled units' growth itself)
    inv = invariant(rows, total, avail, b, table)
    can = inv_cap(can, inv)                            # v17: committed + request <= physical - 64 GB, die jobs too
    can_die = inv_cap(die_admissible(avail, b, floor, need, can), inv)
    me_die = os.environ.get("OT_HEAVY_PRIO") == "die" or die_like(argv, os.getcwd())
    if me_die and can < res <= can_die:
        note = (note + "; " if note else "") + f"DIE: admitted on current memory ({avail:.0f} GB available, {b.get('pending', 0.0):.0f} GB pending charged, settled growth not charged)"
    ok = (can_die if me_die else can) >= res
    held = die_hold(total, can_die, floor, table, need) if ok and not me_die else 0
    if held and can - res < held:
        ok, note = False, (note + "; " if note else "") + f"DIE-FIRST: {held:.0f} GB held for a waiting die trial"
    print(f"{'OK' if ok else 'NO'} {res} {cls} | need {need:g} x {res} = {need * res:.0f} GB, admissible {can:.0f} GB: "
          f"available {avail:.0f} GB, growth charged {charged_growth(b, total):.0f} GB ({('v16 measured reserve (legacy figure, not the admission: see the v17 invariant), running growth cap ' + format(100 * conf('GROWTH_CAP_AVAIL_FRAC'), 'g') + ' % of available') if conf('MEASURED_RESERVE') else 'v13 rate rule, uncapped sum'}, settled floor {b.get('settled_floor', 0.0):.0f} GB; pending {b.get('pending', 0.0):.0f} GB at x{conf('GROWING_FACTOR'):g}), young {b['young']:.0f} GB, "
          f"floor {floor:.0f} GB; {inv_text(inv)}" + (f"; {note}" if note else ""))


DIE_RE = re.compile(r"(?i)(die[_-]?(sta|gen\d*|grt\d*|chain|trial|place|bind)|(sta|gen\d*|grt\d*)[_-]die\b)")
PRIO_FILE = f"{D}/prio_die.re"


def die_like(argv, cwd="", environ=()):
    """die-level job: OT_HEAVY_PRIO=die, or DIE_RE / a PRIO_FILE regex on its command line or working directory"""
    if "OT_HEAVY_PRIO=die" in environ:
        return True
    text = " ".join(argv) + " " + cwd
    if DIE_RE.search(text):
        return True
    for ln in rd(PRIO_FILE).splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("#"):
            try:
                if re.search(ln, text):
                    return True
            except re.error:
                pass
    return False


def prio_waiters(table, skip=()):
    """DIE-FIRST (owner 2026-10-15 23:50: die-level trials iterate back to back and get admission priority on the
    large-memory hosts): waiting ot-heavy processes started with OT_HEAVY_PRIO=die (ot-run --priority die), as
    [(start_ticks, charge_gb)], oldest first"""
    out = []
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) in skip:
            continue
        a = rd(f"/proc/{p}/cmdline").split("\0")[:-1]
        if not (len(a) > 3 and a[1:2] == ["/usr/local/bin/ot-heavy"] and "--mem" in a[:8] and "--" in a):
            continue
        try:
            cwd = os.readlink(f"/proc/{p}/cwd")
        except OSError:
            cwd = ""
        if not die_like(a[a.index("--") + 1:], cwd, rd(f"/proc/{p}/environ").split("\0")):
            continue
        m = int(a[a.index("--mem") + 1])
        try:
            start = int(rd(f"/proc/{p}/stat").rsplit(")", 1)[1].split()[19])
        except (IndexError, ValueError):
            start = 0
        out.append((start, (admit_size(m, classify(a[a.index("--") + 1:]), table) or [m])[0]))
    return sorted(out)


def die_hold(total, can, floor, table, need=None):
    """DIE-FIRST v2 (2026-10-18): GB a non-die request must leave free = the charge of the oldest waiting die job that the
    host admits NOW (charge <= can); it starts on its next attempt.  A die job that does not fit now holds nothing: priority
    orders the queue and never leaves memory idle.  (total, floor, need kept for the call signature.)"""
    me = {os.getpid(), os.getppid()}
    try:
        me.add(int(rd(f"/proc/{os.getppid()}/stat").rsplit(")", 1)[1].split()[1]))
    except (IndexError, ValueError):
        pass
    for _, charge in prio_waiters(table, skip=me):
        if charge <= can:
            return charge
    return 0


def waiters(table):
    wait, req = [], []
    for a in (rd(f"/proc/{p}/cmdline").split("\0")[:-1] for p in os.listdir("/proc") if p.isdigit()):
        if len(a) > 3 and a[1:2] == ["/usr/local/bin/ot-heavy"] and "--mem" in a[:8] and "--" in a:
            m = int(a[a.index("--mem") + 1])
            req.append(m)                                # charged like ot-heavy will charge it
            wait.append((admit_size(m, classify(a[a.index("--") + 1:]), table) or [m])[0])
    return wait, req


def free(path):
