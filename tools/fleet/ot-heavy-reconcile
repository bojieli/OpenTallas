        e = sizes().get(cls)
        if e and e["n"] + e["live"] and mem > 2 * max(e["peak_gb"], 2):
            print(f"WARN request {mem}G is {mem / max(e['peak_gb'], 0.1):.1f}x the measured peak {e['peak_gb']}G of class "
                  f"'{cls}' (n={e['n']}+{e['live']} live); --mem {e['suggest_gb']} is enough")
    elif sys.argv[1:2] == ["--gate"]:
        gate(int(sys.argv[2]), sys.argv[4:])
    elif "--units" in sys.argv:
        units()
    elif "--selftest" in sys.argv:
        sys.exit(selftest())
    elif "--free" in sys.argv:
        i = sys.argv.index("--free")
        free(sys.argv[i + 1] if len(sys.argv) > i + 1 else "/")
    elif "--sizes" in sys.argv:
        for c, e in sorted(sizes().items(), key=lambda kv: -kv[1]["peak_gb"]):
            print(f"{e['peak_gb']:8.1f} GB peak  suggest {e['suggest_gb']:4d}  requested {e['req_gb']:4d}  n={e['n']} proved={e['proved']} live={e['live']}  {c}")
    else:
        with open(f"{D}/reconcile.lock", "a") as run_lock:
            try:
                fcntl.flock(run_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                sys.exit(0)
            main()
