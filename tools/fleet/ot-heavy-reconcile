                          cpu_load1=float(open("/proc/loadavg").read().split()[0]), ncpu=os.cpu_count(), running=b["running"],
                          fresh=b["fresh"], waiting=len(wait), waiting_gb=sum(wait), waiting_req_gb=sum(req), disk_gb=disk,
                          admit_gb=math.floor(can), free_gb=math.floor(can) - sum(wait), die_admit_gb=math.floor(can_die),
                          inv_free_gb=math.floor(inv["free"]), committed_gb=round(inv["committed"]),
                          inv_limit_gb=round(inv["limit"]), other_gb=round(inv["other"]), admit_gb_v16=round(can_v16),
