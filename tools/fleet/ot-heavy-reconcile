def journal(args):
    """journalctl lines (short-iso); the system journal needs adm or sudo -n"""
    for pre in ([], ["sudo", "-n"]):
        try:
            r = subprocess.run(pre + ["journalctl", "--no-pager", "-q", "-o", "short-iso", *args], capture_output=True,
                               text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.splitlines()
    return []


EO_RE = re.compile(r"^(\S+) .*earlyoom\[\d+\]: sending (SIG\w+) to process (\d+) uid \d+ \"([^\"]*)\".*?VmRSS (\d+) MiB")
EO_MEM = re.compile(r"^(\S+) .*earlyoom\[\d+\]: mem avail: .*?\(\s*([\d.]+)%\), swap free: .*?\(\s*([\d.]+)%\)")


def exit_report(unit, t0, rc, pidfile, cg=""):
    """v17 (TOKc-ADM 10-22): why did this job's command end?  EARLYOOM when earlyoom signalled one of the scope's processes
    (pids sampled into pidfile by ot-heavy-exit) since t0; MEMCG-OOM when the scope's memory.events counts an oom_kill"""
    host = os.uname().nodename
    pids = set()
    for ln in rd(pidfile).split():
        if ln.isdigit():
            pids.add(int(ln))
    out = []
    since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(t0) - 5))
    mem, done = "", set()
    for ln in journal(["-u", "earlyoom", "--since", since]):
        m = EO_MEM.match(ln)
        if m:
            mem = f"host mem avail {m[2]} %, swap free {m[3]} %"
            continue
        m = EO_RE.match(ln)
        if m and int(m[3]) in pids and int(m[3]) not in done:   # earlyoom re-sends SIGTERM every 10 s: one line per pid
            done.add(int(m[3]))
            out.append(f"ot-heavy: EARLYOOM on {host} at {m[1]}: earlyoom {m[2]} pid {m[3]} {m[4]} VmRSS {int(m[5]) / 1024:.1f} GiB"
                       f" ({mem or 'host memory exhausted'}); unit {unit}, job exit {rc}.  Host-level kill, not this job's cap: "
                       f"the host was over-committed (see ot-heavy-reconcile --free inv_free_gb)")
    ev = rd(f"{cg}/memory.events") if cg else ""
    k = re.search(r"^oom_kill (\d+)", ev, re.M)
    if k and int(k[1]) > 0:
        out.append(f"ot-heavy: MEMCG-OOM on {host} at {time.strftime('%Y-%m-%dT%H:%M:%S%z')}: {k[1]} process(es) of unit {unit} "
                   f"killed at the scope's own MemoryMax ({rd(cg + '/memory.max').strip()} B, peak "
                   f"{num(cg + '/memory.peak') / GB:.1f} GiB); job exit {rc}: raise --mem or lower -j")
    for ln in out:
        print(ln)
        try:
            open(f"{D}/exit.log", "a").write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {ln}\n")
        except OSError:
            pass
    return 0


