[Unit]
Description=OpenTallas merge queue: land sha-pinned "COORD APPROVED: <branch> @<sha>" lines on main (MERGE-QUEUE-1, OWNER 2026-11-14)

[Service]
Type=oneshot
WorkingDirectory=%h
# runs the pinned main copy once ot-tools-sync has made one; the installed bootstrap copy until then
ExecStart=/bin/sh -c 'f=/srv/opentallas-scratch2/claude/rt/current/tools/fleet/ot-merge-queue; [ -f "$f" ] || f=%h/merge-queue/bin/ot-merge-queue; exec /usr/bin/python3 -I "$f" tick'
Nice=5
TimeoutStartSec=5400
