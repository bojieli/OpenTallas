[Unit]
Description=OpenTallas daily die source-tree refresh (MERGE-QUEUE-1, OWNER/COORD 2026-11-15): one batch, staged smoke, all gen_hosts replicas, rollback on failure

[Service]
Type=oneshot
WorkingDirectory=%h
# the 4 dies of the wave (HBM parked); a second run in the same day is a no-op (last good sha per die)
ExecStart=/bin/sh -c 'f=/srv/opentallas-scratch2/claude/rt/current/tools/fleet/ot-src-refresh; [ -f "$f" ] || f=%h/merge-queue/bin/ot-src-refresh; exec /usr/bin/python3 -I "$f" daily --apply --dies qwen_compute,qwen_kvsys,s81,s81_head'
Nice=5
TimeoutStartSec=7200
