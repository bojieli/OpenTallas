[Unit]
Description=OpenTallas worktree reaper (tools/fleet/wt-reaper.py: removes clean, pushed, idle >2 h, unreferenced, unprotected worktrees)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/opentallas-scratch2/claude/infra/wt-reaper/wt-reaper.py --apply
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
