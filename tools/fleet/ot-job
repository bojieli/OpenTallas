#!/usr/bin/python3 -I
"""ot-job: run one command as a SEALED JOB (ISOLATE-1; OWNER 2026-11-09 03:4x "yes, isolate the jobs. simply delete the
finished job folder").

  ot-job run (--spec FILE | --spec-b64 B64) [--tag TAG] -- <command...>
  ot-job check-spec FILE                 validate a spec, print the resolved plan, run nothing
  ot-job reap [ROOT...]                  delete every job dir under ROOT whose ot-job process is gone (its lock is
                                         free), after stopping the containers it started; legacy dirs are listed only

A job owns exactly one directory J = <root>/<name>-<tag> (root default /srv/opentallas-scratch2/claude/ot-jobs):
  J/in/<n>       declared inputs, hardlinked read-only from the host store (<fs>/ot-store, see ot_store.py)
  J/work         the writable work dir, seeded by copies of the declared work seeds
  J/tmp          the job's /tmp
  J/.ot-job      job.json (spec, owner tag), map.json (what the docker shim allows), the docker shim, results
The command runs under bwrap: /srv, /mnt, /media, /archive, /tmp and $HOME are empty except the job dir, each input
at the absolute path the job names it by (its "at", default its source path), the work dir at its "at", and a
read-only allowlist of tool dirs in $HOME (.local, bin, opentallas-tools).  /usr/bin/docker is ot-job-docker, which
refuses any container mount of an undeclared host path.  So a job that reads a path it did not declare FAILS, at once.

At exit: every "publish" item is put into the store (hardlinks, no copy) with an artifact record naming the producer,
re-verified, the "return" paths are copied to the caller dir, and J is DELETED.  If publishing fails J is kept and
the exit status is 98 (the command's own status is in J/.ot-job/result.json).  The command's status is returned.
KW-FIX-44 11-09 (COORD 17:3x step 5, OWNER "the finished job folder is simply deleted"): the same end runs when the
job is STOPPED (SIGTERM/SIGINT/SIGHUP, e.g. an ot-heavy unit stop): the command gets the signal, the containers the
job started (docker label ot-job.dir=J) are stopped and removed, then publish / return / delete as above (rc 128+sig).
J holds an flock (J/.ot-job/lock) for the job's whole life; a J whose lock is free has no live ot-job (SIGKILL, host
reboot) and is deleted by "ot-job reap", which every ot-job run calls on its own root first.  A J kept after a
publish failure is reaped after KEEP_FAILED_S (24 h, OWNER 11-08 host lifetimes); keep=true is never reaped.

Spec (JSON, schema opentallas.ot_job.v1):
  {"name": "kv3_hub_Ei-place",
   "root": "/srv/opentallas-scratch2/claude/ot-jobs",                    optional
   "inputs": [{"path": "/abs/src", "sha": "<tree or file sha>", "host": "epyc4", "at": "/abs/as-seen", "mode": "ro"}],
   "work": {"at": "/abs/kit/path/the/job/uses", "seed": [{"path"|"sha"|"host", "into": "."}]},
   "publish": [{"name": "place-run", "path": "run", "when": "ok"|"always", "required": false}],
   "return": {"to": "/abs/caller/dir", "paths": ["run/logs", "result.json"]},
   "allow_ro": ["/abs/host/prefix"],                                       optional, read-only system paths
   "replicate": ["epyc4"],                                                optional: push published objects there too
   "keep": false}                                                          true keeps J (pilot debugging only)
An input is found by sha in the local store, else at its path on this host, else fetched from "host" (by sha from
that host's store, else as a tar stream of the path).  Paths in publish/return are relative to the work dir.
"""
import stat
import base64
import fcntl
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import ot_store as S  # noqa: E402

SCHEMA = "opentallas.ot_job.v1"
DEFAULT_ROOT = "/srv/opentallas-scratch2/claude/ot-jobs"
HIDE = ("/srv", "/mnt", "/media", "/archive", "/tmp", "/var/tmp")
HOME_ALLOW = (".local", "bin", ".docker", ".gitconfig", "opentallas-tools")
SYSTEM_RW = ("/var/tmp/ot-heavy",)       # fleet admission state: a nested ot-heavy (lec_async LEC unit) must see it
PUBLISH_FAIL = 98
KEEP_FAILED_S = 24 * 3600
LOCK_PROTO = 1            # .ot-isolated.json "lock": J holds J/.ot-job/lock while its ot-job lives
STOP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
STOP_GRACE_S = 20         # under systemd's 90 s stop timeout, so publish / return / delete still run
SPEC_FAIL = 99


class JobError(Exception):
    pass


def say(m):
    print(f"ot-job: {m}", file=sys.stderr, flush=True)


def load_spec(a):
    if "--spec-b64" in a:
        s = json.loads(base64.b64decode(a[a.index("--spec-b64") + 1]))
    elif "--spec" in a:
        with open(a[a.index("--spec") + 1]) as fh:
            s = json.load(fh)
    else:
        raise JobError("no --spec / --spec-b64")
    if s.get("schema", SCHEMA) != SCHEMA:
        raise JobError(f"spec schema {s.get('schema')!r} != {SCHEMA}")
    if not s.get("name") or "/" in s["name"]:
        raise JobError("spec needs a plain name")
    for i in s.get("inputs", []):
        at = i.get("at") or i.get("path")
        if not at or not os.path.isabs(at):
            raise JobError(f"input {i}: needs an absolute path or at")
        if i.get("mode", "ro") != "ro":
            raise JobError(f"input {i}: mode must be ro (writable data is a work seed)")
        if not (i.get("sha") or i.get("path")):
            raise JobError(f"input {i}: needs path or sha")
    w = s.get("work") or {}
    if w.get("at") and not os.path.isabs(w["at"]):
        raise JobError("work.at must be absolute")
    for p in [x["path"] for x in s.get("publish", [])] + list((s.get("return") or {}).get("paths", [])):
        if os.path.isabs(p) or os.path.normpath(p).startswith(".."):
            raise JobError(f"publish/return path {p!r} must be relative to the work dir")
    return s


def tar_fetch(host, path, dest):
    """copy host:path (a file or dir) to dest through ssh; dest must not exist"""
    os.makedirs(dest)
    parent, base = os.path.dirname(path.rstrip("/")), os.path.basename(path.rstrip("/"))
    p1 = subprocess.Popen(["ssh", "-n", "-o", "ControlPath=none", "-o", "BatchMode=yes", host,
                           f"tar -C '{parent}' -cf - '{base}'"], stdout=subprocess.PIPE)
    p2 = subprocess.run(["tar", "-C", dest, "-xf", "-"], stdin=p1.stdout)
    p1.stdout.close()
    if p1.wait() != 0 or p2.returncode != 0:
        raise JobError(f"fetch {host}:{path} failed")
    return os.path.join(dest, base)


def seed_mtimes(path):
    """{rel: st_mtime_ns} of the regular files of a seed source ('.' for one file).  The store keeps content only: staged
    copies are dated when staged, in path order, which made vclk_ff.sdc newer than a restored run/results netlist
    (RESYNTH-GUARD exit 12, HBM pt_w 11-10)."""
    if not os.path.isdir(path):
        return {".": os.stat(path).st_mtime_ns}
    out = {}
    for dp, _dns, fns in os.walk(path, followlinks=False):
        for fn in fns:
            q = os.path.join(dp, fn)
            st = os.lstat(q)
            if stat.S_ISREG(st.st_mode):
                out[os.path.relpath(q, path)] = st.st_mtime_ns
    return out


def apply_mtimes(dest, times):
    """give the staged copies under dest the source dates seed_mtimes read"""
    for rel, ns in times.items():
        q = os.path.normpath(os.path.join(dest, rel))
        if os.path.isfile(q) and not os.path.islink(q):
            os.utime(q, ns=(ns, ns))


def resolve(store, item, J, n, times=None):
    """-> (kind, sha) of an input/seed, put into the local store; times (a dict) receives the source files' mtimes when the
    source is a path here or fetched from a host (a seed named only by sha has none)"""
    sha, path, host = item.get("sha"), item.get("path"), item.get("host")
    if sha and S.have(store, sha) and not S.verify(store, sha):
        return ("tree" if S.read_tree(store, sha) else "file"), sha
    if path and os.path.exists(path):
        if times is not None:
            times.update(seed_mtimes(os.path.realpath(path)))
        kind, got = S.put(store, os.path.realpath(path))
    elif host and sha:
        S.fetch(store, sha, host)
        kind, got = ("tree" if S.read_tree(store, sha) else "file"), sha
    elif host and path:
        tmp = os.path.join(J, ".ot-job", "fetch", str(n))
        got_path = tar_fetch(host, path, tmp)
        if times is not None:
            times.update(seed_mtimes(got_path))
        kind, got = S.put(store, got_path, link=True)
        shutil.rmtree(tmp)
    else:
        raise JobError(f"input {item}: not in the store, not on this host" + ("" if host else ", and no host to fetch from"))
    if sha and got != sha:
        raise JobError(f"input {item}: content sha {got} != declared {sha}")
    return kind, got


def bwrap_argv(J, maps, work_at, cmd, home):
    a = ["bwrap", "--die-with-parent", "--ro-bind", "/", "/", "--dev-bind", "/dev", "/dev", "--proc", "/proc"]
    for h in HIDE:
        if os.path.isdir(h) and not os.path.islink(h):
            a += ["--tmpfs", h]
    if home and os.path.isdir(home):
        a += ["--tmpfs", home]
        for x in HOME_ALLOW:
            p = os.path.join(home, x)
            if os.path.exists(p):
                a += ["--ro-bind", p, p]
    for p in SYSTEM_RW:
        if os.path.isdir(p):
            a += ["--bind", p, p]
    a += ["--bind", J, J, "--ro-bind", J + "/in", J + "/in", "--ro-bind", J + "/.ot-job", J + "/.ot-job",
          "--bind", J + "/tmp", "/tmp"]
    for m in sorted(maps, key=lambda m: len(m["at"])):
        if m["at"] in (J, J + "/in", J + "/work"):
            continue
        a += ["--ro-bind" if m["ro"] else "--bind", m["real"], m["at"]]
    a += ["--ro-bind", J + "/.ot-job/ot-job-docker", "/usr/bin/docker"]
    a += ["--setenv", "OT_JOB_DIR", J, "--setenv", "OT_JOB_MAP", J + "/.ot-job/map.json", "--setenv", "TMPDIR", "/tmp",
          "--unsetenv", "OT_JOB_SHIM_CHECKED", "--chdir", work_at, "--"]
    return a + list(cmd)


def _copy_file(src, dst):
    """copy one file or link to dst; an existing dst is unlinked first (never written through: it may be a hardlink
    into another tree), and an identical one is left alone"""
    if os.path.islink(src):
        if os.path.lexists(dst):
            os.unlink(dst)
        os.symlink(os.readlink(src), dst)
        return
    st = os.stat(src)
    if os.path.isfile(dst) and not os.path.islink(dst) and os.path.getsize(dst) == os.path.getsize(src) \
            and S.sha_file(dst) == S.sha_file(src):
        d = os.stat(dst)
        if d.st_nlink == 1 and d.st_mtime_ns != st.st_mtime_ns:     # a hardlinked dst is left alone (shared inode)
            os.utime(dst, ns=(st.st_atime_ns, st.st_mtime_ns))
        return
    if os.path.lexists(dst):
        os.unlink(dst)
    shutil.copyfile(src, dst)
    shutil.copymode(src, dst)
    # RETURN-MTIME (KW-FIX-44 11-10, COORD; HBM-COLLECT-1 q_spb0 ddfecd820a35 a2): the returned copy keeps the source
    # date.  copyfile dated every returned file at return time in walk order, so a kit came back with rtl/ newer than
    # its run/results checkpoints and the next resume stopped at RESYNTH-GUARD (exit 12).
    os.utime(dst, ns=(st.st_atime_ns, st.st_mtime_ns))


def copy_out(src, dst):
    """return copy of a work path to the caller dir (files and trees)"""
    if not (os.path.isdir(src) and not os.path.islink(src)):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        _copy_file(src, dst)
        return
    for dp, dns, fns in os.walk(src):
        rd = os.path.relpath(dp, src)
        od = os.path.normpath(os.path.join(dst, rd))
        if os.path.islink(od) or (os.path.lexists(od) and not os.path.isdir(od)):
            os.unlink(od)
        os.makedirs(od, exist_ok=True)
        for n in list(dns):
            if os.path.islink(os.path.join(dp, n)):
                dns.remove(n)
                fns.append(n)
        for n in fns:
            _copy_file(os.path.join(dp, n), os.path.join(od, n))


def _writable(J):
    for dp, dns, _fns in os.walk(J):
        for d in dns:
            p = os.path.join(dp, d)
            if not os.path.islink(p):
                os.chmod(p, 0o755)
    os.chmod(J, 0o755)


MARKER = ".ot-isolated.json"


def mark(d, what):
    p = os.path.join(d, MARKER)
    if not os.path.exists(p):
        with open(p, "w") as fh:
            json.dump(dict(what, schema="opentallas.ot_isolated.v1", written=time.time()), fh)


def remove_job(J):
    marker = os.path.join(J, ".ot-job", "job.json")
    if not (os.path.isfile(marker) and os.path.isfile(os.path.join(J, MARKER))):
        raise JobError(f"{J} has no ot-job marker: not deleting")
    try:
        _writable(J)
        shutil.rmtree(J)
    except PermissionError:
        # files a container wrote as root (a killed run never reached run_kit.sh's chown): chown through docker, retry
        subprocess.run(["/usr/bin/docker", "run", "--rm", "-v", f"{J}:/j", os.environ.get("OT_JOB_CHOWN_IMAGE", "alpine:latest"),
                        "chown", "-R", f"{os.getuid()}:{os.getgid()}", "/j"], capture_output=True, timeout=600)
        _writable(J)
        shutil.rmtree(J)


def docker_cli():
    return shutil.which("docker", path="/usr/bin") or "/usr/bin/docker"


def stop_containers(J):
    """stop + remove every container this job started (the shim labels each one ot-job.dir=J) -> [ids]"""
    try:
        p = subprocess.run([docker_cli(), "ps", "-aq", "--filter", f"label=ot-job.dir={J}"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return []
    ids = p.stdout.split()
    if ids:
        subprocess.run([docker_cli(), "stop", "-t", "20"] + ids, capture_output=True, timeout=180)
        subprocess.run([docker_cli(), "rm", "-f"] + ids, capture_output=True, timeout=120)
    return ids


LOCK_FD = []


def hold_lock(J):
    """the job's life lock: held until this process AND the command it runs have ended, however they end (the fd is
    passed to the command, so an orphaned command keeps J locked and the reaper waits for it)"""
    fd = os.open(os.path.join(J, ".ot-job", "lock"), os.O_CREAT | os.O_RDWR, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def ot_job_alive(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as fh:
            return b"ot-job" in fh.read()
    except (OSError, ValueError):
        return False


def reap(roots, now=None, say_=None):
    """delete each J under ROOTS whose ot-job is gone: a lock-protocol J with a free lock (stop its containers first);
    a J kept after a publish failure only after KEEP_FAILED_S; never keep=true, never a J without the ot-job marker,
    never a legacy J (no lock protocol: listed, untouched).  -> {"reaped": [...], "legacy": [...], "live": n}"""
    now = now or time.time()
    say_ = say_ or say
    out = {"reaped": [], "legacy": [], "live": 0}
    for root in roots:
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue
        for n in names:
            J = os.path.join(root, n)
            try:
                mk = json.load(open(os.path.join(J, MARKER)))
                job = json.load(open(os.path.join(J, ".ot-job", "job.json")))
            except (OSError, ValueError):
                continue
            if mk.get("kind") != "ot-job":
                continue
            if mk.get("lock") != LOCK_PROTO:
                # a J of an ot-job without the lock: dead when its recorded ot-job pid on this host is gone
                if job.get("host") == socket.gethostname() and job.get("pid") and not ot_job_alive(job["pid"]) \
                        and not (job.get("spec") or {}).get("keep"):
                    ids = stop_containers(J)
                    try:
                        remove_job(J)
                        out["reaped"].append(J)
                        say_(f"reaped legacy {J} (ot-job pid {job['pid']} gone; {len(ids)} container(s) stopped)")
                    except (JobError, OSError) as e:
                        say_(f"reap {J}: {e}")
                else:
                    out["legacy"].append(J)
                continue
            try:
                fd = os.open(os.path.join(J, ".ot-job", "lock"), os.O_RDWR)
            except OSError:
                continue
            try:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    out["live"] += 1
                    continue
                if (job.get("spec") or {}).get("keep"):
                    continue
                try:
                    res = json.load(open(os.path.join(J, ".ot-job", "result.json")))
                except (OSError, ValueError):
                    res = None
                if res and res.get("errors") and now - res.get("ended", now) < KEEP_FAILED_S:
                    continue
                ids = stop_containers(J)
                try:
                    remove_job(J)
                except (JobError, OSError) as e:
                    say_(f"reap {J}: {e}")
                    continue
                out["reaped"].append(J)
                say_(f"reaped {J} (no live ot-job; {len(ids)} container(s) stopped)")
            finally:
                os.close(fd)
    return out


def run(spec, tag, cmd, bwrap=True):
    host = socket.gethostname()
    root = spec.get("root") or os.environ.get("OT_JOB_ROOT") or DEFAULT_ROOT
    J = os.path.join(os.path.realpath(root), f"{spec['name']}-{tag}")
    store = S.default_store(J)
    if os.path.isdir(os.path.realpath(root)):
        reap([os.path.realpath(root)])           # dead jobs on this root go before a new one starts
    os.makedirs(J)
    mark(J, {"kind": "ot-job", "tag": tag, "host": host, "lock": LOCK_PROTO})   # legacy cleanup never owns a marked folder
    mark(os.path.dirname(J), {"kind": "ot-jobs-root"})
    for d in ("in", "work", "tmp", ".ot-job"):
        os.makedirs(os.path.join(J, d))
    LOCK_FD[:] = [hold_lock(J)]
    meta = {"schema": SCHEMA, "spec": spec, "tag": tag, "host": host, "J": J, "store": store, "cmd": cmd,
            "started": time.time(), "pid": os.getpid()}
    with open(os.path.join(J, ".ot-job", "job.json"), "w") as fh:
        json.dump(meta, fh, indent=1, sort_keys=True)
    work_at = (spec.get("work") or {}).get("at") or J + "/work"
    maps = [{"at": J + "/in", "real": J + "/in", "ro": True}, {"at": J, "real": J, "ro": False},
            {"at": J + "/.ot-job", "real": J + "/.ot-job", "ro": True},
            {"at": work_at, "real": J + "/work", "ro": False}]
    # GC-LOCK (KW-FIX-44 11-10): shared from the first put to the job-<tag> ref, so a gc --apply cannot delete an object
    # this job has just named (a dedup put onto an old object) before the ref protects it; a running gc delays staging.
    with S.lock(store):
        try:
            shas, staged = stage_all(spec, store, J, maps)
        except Exception:
            remove_job(J)                        # nothing ran and nothing was published: the dir is ours alone
            raise
        S.ref(store, "job-" + tag, shas, note=f"live inputs of ot-job {J} on {host}")
    return run_sealed(spec, meta, J, store, tag, cmd, maps, staged, work_at, bwrap)


def stage_all(spec, store, J, maps):
    shas, staged = [], []
    for n, item in enumerate(spec.get("inputs", [])):
        kind, sha = resolve(store, item, J, n)
        dst = os.path.join(J, "in", str(n))
        S.stage(store, sha, dst)
        at = item.get("at") or item["path"]
        maps.append({"at": at, "real": dst, "ro": True})
        shas.append(sha)
        staged.append({"n": n, "at": at, "sha": sha, "kind": kind})
    for n, item in enumerate((spec.get("work") or {}).get("seed", [])):
        times = {}
        kind, sha = resolve(store, item, J, f"seed{n}", times)
        into = os.path.normpath(os.path.join(J, "work", item.get("into", ".")))
        if kind == "tree":
            tmp = os.path.join(J, ".ot-job", f"seed{n}")
            S.stage(store, sha, tmp, copy=True)
            shutil.copytree(tmp, into, symlinks=True, dirs_exist_ok=True)
            shutil.rmtree(tmp)
            apply_mtimes(into, times)
        else:
            dst = into if not os.path.isdir(into) else os.path.join(into, os.path.basename(item.get("path", sha)))
            S.stage(store, sha, dst, copy=True)
            apply_mtimes(dst, times)
        shas.append(sha)
        staged.append({"seed": n, "sha": sha, "kind": kind})
    return shas, staged


def run_sealed(spec, meta, J, store, tag, cmd, maps, staged, work_at, bwrap):
    os.chmod(os.path.join(J, "in"), 0o555)
    real_docker = docker_cli()
    open(os.path.join(J, ".ot-job", "docker.real"), "w").close()
    shutil.copyfile(os.path.join(HERE, "ot-job-docker"), os.path.join(J, ".ot-job", "ot-job-docker"))
    os.chmod(os.path.join(J, ".ot-job", "ot-job-docker"), 0o555)
    nxt = None
    if os.environ.get("OT_JOB_NEXT_DOCKER"):         # tests: a stand-in for the docker CLI, copied in so the view has it
        nxt = os.path.join(J, ".ot-job", "next_docker")
        shutil.copyfile(os.environ["OT_JOB_NEXT_DOCKER"], nxt)
        os.chmod(nxt, 0o555)
    with open(os.path.join(J, ".ot-job", "map.json"), "w") as fh:
        json.dump({"job": J, "maps": maps, "allow_ro": spec.get("allow_ro", []), "next_docker": nxt}, fh, indent=1, sort_keys=True)
    with open(os.path.join(J, ".ot-job", "inputs.json"), "w") as fh:
        json.dump(staged, fh, indent=1)
    if bwrap:
        argv = bwrap_argv(J, maps, work_at, cmd, os.path.expanduser("~"))
        i = argv.index("--setenv")
        argv[i:i] = ["--ro-bind", real_docker, J + "/.ot-job/docker.real"]
    else:                                        # tests without bwrap only
        argv = list(cmd)
    say(f"SEALED {J}: {len(staged)} inputs, store {store}, cmd {' '.join(cmd)[:160]}")
    got = []
    # its own process group: a stop reaches every process of the command (bwrap does not forward signals into the
    # sandbox); STOP_GRACE_S later the group is killed, so the job end always runs
    child = subprocess.Popen(argv, cwd=J + "/work" if not bwrap else None, pass_fds=tuple(LOCK_FD), start_new_session=True)
    with open(os.path.join(J, ".ot-job", "cmd.pgid"), "w") as fh:      # the command's process group (ops / reap)
        fh.write(str(child.pid))

    def group(sig):
        try:
            os.killpg(child.pid, sig)
        except OSError:
            pass

    def stop(sig, _frame):
        if not got:
            say(f"signal {sig}: stopping the command; the job end (publish, return, delete) follows")
            import threading
            k = threading.Timer(STOP_GRACE_S, group, (signal.SIGKILL,))
            k.daemon = True
            k.start()
        got.append(sig)
        group(sig)
    old = {s: signal.signal(s, stop) for s in STOP_SIGNALS}
    try:
        rc = child.wait()
    finally:
        for s in STOP_SIGNALS:
            signal.signal(s, signal.SIG_IGN)     # the job end itself is not interrupted by a second stop
    if got and rc >= 0:
        rc = 128 + got[0]
    elif rc < 0:
        rc = 128 - rc
    ids = stop_containers(J)
    say(f"command exit {rc}" + (f" (stopped by signal {got[0]})" if got else "") + (f"; {len(ids)} container(s) stopped" if ids else ""))
    return finish(spec, meta, J, store, tag, rc)


def finish(spec, meta, J, store, tag, rc):
    try:
        return _finish(spec, meta, J, store, tag, rc)
    finally:
        for fd in LOCK_FD:      # the command has ended and J is gone, or kept (then reapable)
            os.close(fd)
        LOCK_FD[:] = []


def _finish(spec, meta, J, store, tag, rc):
    ok = rc == 0
    pub, errors = [], []
    producer = {"job": meta["J"], "tag": tag, "host": meta["host"], "name": spec["name"], "cmd": meta["cmd"][:20],
                "rc": rc, "started": meta["started"], "ended": time.time(),
                "inputs": json.load(open(os.path.join(J, ".ot-job", "inputs.json")))}
    for p in spec.get("publish", []):
        if p.get("when", "ok") == "ok" and not ok:
            continue
        src = os.path.join(J, "work", p["path"])
        if not os.path.exists(src):
            if p.get("required"):
                errors.append(f"required output {p['path']} missing")
            continue
        try:
            pub.append(S.publish(store, src, p["name"], producer, link=True))
        except (S.StoreError, OSError) as e:
            errors.append(f"publish {p['path']}: {e}")
    for r in pub:
        bad = S.verify(store, r["sha"])
        if bad:
            errors.append(f"verify {r['name']}: {bad[:3]}")
    for h in spec.get("replicate", []):          # hosts are volatile: a second copy of what a live form will read
        for r in pub:
            try:
                S.push(store, r["sha"], h)
            except S.StoreError as e:
                errors.append(f"replicate {r['name']} to {h}: {e}")
    refusals = []
    try:
        with open(os.path.join(J, "tmp", "isolation_refusals.log")) as fh:
            refusals = [json.loads(x) for x in fh if x.strip()][:50]
    except (OSError, ValueError):
        pass
    result = {"rc": rc, "refusals": refusals, "published": [{k: r[k] for k in ("id", "name", "kind", "sha")} for r in pub], "errors": errors,
              "store": store, "host": meta["host"], "J": J, "ended": time.time()}
    ret = spec.get("return") or {}
    if ret.get("to"):
        try:
            for p in ret.get("paths", []):
                src = os.path.join(J, "work", p)
                if os.path.lexists(src):
                    copy_out(src, os.path.join(ret["to"], p))
            os.makedirs(ret["to"], exist_ok=True)
            with open(os.path.join(ret["to"], f".ot-job-{spec['name']}-{tag}.json"), "w") as fh:
                json.dump(result, fh, indent=1, sort_keys=True)
        except OSError as e:
            errors.append(f"return copy: {e}")
    with open(os.path.join(J, ".ot-job", "result.json"), "w") as fh:
        json.dump(result, fh, indent=1, sort_keys=True)
    S.unref(store, "job-" + tag)
    if errors:
        say(f"PUBLISH FAILED, job dir KEPT {J}: {errors[:3]}")
        return PUBLISH_FAIL
    if spec.get("keep"):
        say(f"keep=true: job dir kept {J}")
    else:
        remove_job(J)
        say(f"published {len(pub)} artifact(s); job dir deleted {J}")
    return rc


def main(a):
    if a[:1] == ["check-spec"]:
        print(json.dumps(load_spec(["--spec", a[1]]), indent=1))
        return 0
    if a[:1] == ["reap"]:
        r = reap(a[1:] or [DEFAULT_ROOT, DEFAULT_ROOT.replace("scratch2", "scratch3")])
        print(json.dumps({"reaped": len(r["reaped"]), "live": r["live"], "legacy": r["legacy"]}))
        return 0
    if a[:1] != ["run"] or "--" not in a:
        print(__doc__, file=sys.stderr)
        return SPEC_FAIL
    opts, cmd = a[1:a.index("--")], a[a.index("--") + 1:]
    try:
        spec = load_spec(opts)
    except (JobError, ValueError, OSError) as e:
        say(f"SPEC REFUSED: {e}")
        return SPEC_FAIL
    tag = opts[opts.index("--tag") + 1] if "--tag" in opts else f"{socket.gethostname()}-{os.getpid()}-{int(time.time())}"
    try:
        return run(spec, tag, cmd, bwrap=os.environ.get("OT_JOB_NO_BWRAP_FOR_TESTS") != "1")
    except (JobError, S.StoreError) as e:
        say(f"NOT RUN: {e}")
        return SPEC_FAIL


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
