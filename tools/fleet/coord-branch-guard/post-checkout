#!/bin/sh
# coord-branch-guard (FLOW-HEALTH-1 11-19, COORD incident 11-19 06:0x): the hub-coord worktree stays on coord/state.
# A `git checkout -f -B <lane branch> origin/main` run here by mistake deleted 4,816 coord files and wrote ~101k main files.
# git has no pre-checkout hook, so this runs right after any branch checkout and puts the worktree back (a plain, non-forced
# `git checkout coord/state` removes exactly the files the wrong branch added and restores the ones it removed).
# (A ref-transaction hook that refused the new branch was tried and dropped: git changes the tree BEFORE it updates refs, so the refusal left the
# damage in place and skipped this hook.)  Local uncommitted edits that a FORCED checkout already overwrote cannot be brought back by a hook.
# args: <previous HEAD> <new HEAD> <flag: 1 = branch / whole-tree checkout>.  COORD_GUARD_OFF=1 disables (maintenance only).
[ "$3" = 1 ] || exit 0
[ "${COORD_GUARD_OFF:-0}" = 1 ] && exit 0
[ -n "${COORD_GUARD_RESTORING:-}" ] && exit 0
B=${COORD_GUARD_BRANCH:-coord/state}
cur=$(git symbolic-ref -q --short HEAD 2>/dev/null)
[ "$cur" = "$B" ] && exit 0
echo "COORD-GUARD: this worktree must stay on $B; a checkout moved it to '${cur:-detached at $(git rev-parse --short HEAD)}'; restoring $B" >&2
if COORD_GUARD_RESTORING=1 git checkout -q "$B"; then
  echo "COORD-GUARD: restored $B (the branch the mistaken checkout created, if any, is still in the repo: delete it by hand)" >&2
else
  echo "COORD-GUARD: RESTORE FAILED: run  git checkout $B  here now" >&2
fi
exit 1
