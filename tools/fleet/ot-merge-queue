def load_state():
    try:
        return json.loads((MQ / "state.json").read_text())
    except (OSError, ValueError):
        return {"items": {}, "posts": []}


def save_state(st):
    if DRY:
        return
    MQ.mkdir(parents=True, exist_ok=True)
    t = MQ / "state.json.tmp"
    t.write_text(json.dumps(st, indent=1, sort_keys=True))
    os.replace(t, MQ / "state.json")


def queue_post(st, kind, to, body):
    line = f"- {stamp()} {kind} [{ME}{(' -> ' + to) if to else ''}] {body}"
    log(f"POST {line}")
    st.setdefault("posts", []).append({"line": line, "posted": False})


def flush_posts(st):
    pend = [p for p in st.get("posts", []) if not p.get("posted")]
    if not pend or DRY:
        return
    files = []
    for rel in (QUEUE_REL, LANE_REL):
        f = COORD / rel
        have = f.read_text(errors="replace") if f.exists() else ""
        add = [p["line"] for p in pend if p["line"] not in have]
        if add:
            with open(f, "a") as o:
                o.write(("" if not have or have.endswith("\n") else "\n") + "\n".join(add) + "\n")
        files.append(rel)
    r = run(["bash", COMMIT, f"{ME}: {pend[0]['line'][22:80]}", *files], cwd=COORD, timeout=900)
    if r.returncode == 0:
        for p in pend:
            p["posted"] = True
        st["posts"] = st["posts"][-200:]
    else:
        log(f"coord-commit rc={r.returncode}: {(r.stderr or r.stdout).strip()[-300:]} (retry next tick)")


# ---------------------------------------------------------------- landing

def big_blobs(a, b, cwd):
    p = run(["bash", "-c", f"git rev-list --objects {a}..{b} | git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)'"],
            cwd=cwd, timeout=300)
    return [l for l in p.stdout.splitlines() if l.startswith("blob ") and int(l.split()[1]) > MAX_BLOB]


def push_main(tip, old, wt):
    if DRY:
        log(f"DRY push {tip[:11]} (main {old[:11]})")
        return True, ""
    p = git("push", "-q", REMOTE, f"{tip}:refs/heads/{MAIN}", cwd=wt, check=False, timeout=300)
    return p.returncode == 0, (p.stderr or p.stdout).strip()[-300:]


def push_tags(tip, wt, text):
    names = git("ls-remote", "--tags", REMOTE, "flow-*", cwd=wt, check=False, timeout=200).stdout.splitlines()
    series = next_tag(names, text)
    refs = [f"{tip}:refs/tags/{series}-{d}" for d in DIES]
    if DRY:
        return series + "-*"
    p = git("push", "-q", REMOTE, *refs, cwd=wt, check=False, timeout=300)
    if p.returncode:
        log(f"tag push {series} failed: {(p.stderr or p.stdout).strip()[-300:]}")
        return f"(tag push failed: {series})"
    git("fetch", "-q", REMOTE, *[f"+refs/tags/{series}-{d}:refs/tags/{series}-{d}" for d in DIES], check=False)
    return series + "-*"


def land(it, text, st):
    """serial: apply onto current main if it moved, re-test on overlap, push, tag -> post; returns new main or ''"""
    wt = WT / it["id"]
    for attempt in range(3):
        cur = fetch_main()
        if cur != it["base"]:
            moved = changed_files(wt, it["base"], cur) if is_ancestor(it["base"], cur, cwd=wt) else ["<main rewritten>"]
            it["extra"] = sorted({os.path.dirname(f) for f in it.get("changed", [])})
            wt_make(it["id"], cur, it["extra"])
            status, detail = apply(wt, cur, it["sha_full"], it["branch"], HOW(it))
            if status == "ALREADY":
                return finish(st, it, "ALREADY", f"landed meanwhile: {detail}", cur)
            if status != "OK":
                return fail(st, it, text, status, detail, cur)
            overlap = sorted(set(moved) & set(it.get("changed", [])))
            old_base = it["base"]
            it["base"] = cur
            it["mode"] = detail
            if overlap:
                log(f"{it['key']}: main moved {old_base[:11]} -> {cur[:11]} over {overlap[:5]}: re-test")
                res, note = gate(it, wt, cur)
                if res == "RED":
                    return fail(st, it, text, "RED", note, cur)
                if res == "INFRA":
                    it["status"] = "INFRA"; return ""
                it["note"] = note + f" (re-tested on {cur[:11]}: main changed {', '.join(overlap[:4])})"
        tip = rev("HEAD", cwd=wt)
        big = big_blobs(cur, tip, wt)
        if big:
            return fail(st, it, text, "RED", f"blob > 95 MB: {big[:3]}", cur)
        ok, err = push_main(tip, cur, wt)
        if ok:
            tags = push_tags(tip, wt, text)
            it.update(tip=tip, tags=tags)
            return finish(st, it, "MERGED", "", cur, tip)
        log(f"{it['key']}: push rejected ({err}); main moved, retry {attempt + 1}")
    it["status"] = "INFRA"
    return ""


def finish(st, it, status, detail, main_before, tip=None):
    it["status"] = status
    it["updated"] = stamp()
    br = f"{it['branch']}@{it['sha_full'][:11]}" if it["branch"] else it["sha_full"][:11]
    if status == "MERGED":
        st["last_merge_ts"] = time.time()
        if it.get("auto"):
            log(f"MERGED-AUTO [{it['branch']}] @{it['sha_full']}")
            st.setdefault("auto_pending", []).append(f"{it['branch']}@{it['sha_full'][:11]}")
        body = (f"{br} -> main {main_before[:11]} -> {tip[:11]}, {it.get('mode')}, tags {it.get('tags')}. "
                f"Gate: {it.get('note')}; tests: {' '.join(os.path.basename(t) for t in it.get('tests', [])[:12]) or 'none'}"
                f"{' +' + str(len(it['tests']) - 12) if len(it.get('tests', [])) > 12 else ''}. Lane {it['lane']}.")
        queue_post(st, "MERGED", it["lane"], body)
        return tip
    queue_post(st, "MERGED", it["lane"], f"{br}: nothing to land, {detail}.")
    return ""


def fail(st, it, text, status, detail, base):
    it["status"] = "FAIL"
    it["reason"] = f"{status}: {detail}"
    it["updated"] = stamp()
    sha = (it.get("sha_full") or it["sha"])[:11]             # an UNFETCHABLE item never got a full sha
    br = f"{it['branch']}@{sha}" if it["branch"] else sha
    if status == "CONFLICT":
        what = f"conflict with main {base[:11]} in: {', '.join(detail) if isinstance(detail, list) else detail}"
    else:
        what = f"{status.lower()} on main {base[:11]}: {detail}"
    queue_post(st, "MERGE-FAIL", it["lane"], f"{br} NOT landed, skipped: {what}. Rebase onto main, fix, push a new head and "
                                             f"ask COORD for a new 'COORD APPROVED: <branch> @<sha>'.")
    return ""


def HOW(it):
    return "auto-merge, GREEN gate record, no approval wait" if it.get("auto") else "COORD APPROVED"


def auto_enabled():
    return os.environ.get("MQ_AUTO", "") == "1" or (MQ / "auto.on").exists()


def remote_tip(branch):
    """-> the branch's tip sha on the remote now (GitHub first, the hub checkout when GitHub has no such branch), or ''"""
    for r in (REMOTE, FALLBACK):
        if not r:
            continue
        o = git("ls-remote", r, f"refs/heads/{branch}", check=False, timeout=300)
        rows = [l.split() for l in o.stdout.splitlines() if l.strip()]
        if o.returncode == 0 and rows:
            return rows[0][0]
    return ""


def auto_candidates(text, items, base, hours=None):
    """-> [(age_h, branch, fullsha)] claude/* branches with a gate record < hours old, whose remote tip IS the gated sha, not in main,
    not settled in the state file, not REVOKED by COORD"""
    hours = AUTO_HOURS if hours is None else hours
    revoked = [(branch, sha) for kind, branch, sha, _, _ in coord_rulings(text) if kind == "REVOKED"]
    settled = {(v.get("sha_full") or v.get("sha", "")) for v in items.values() if v.get("status") in TERMINAL}
    out = []
    for f in sorted((MQ / "gates").glob("*.json")):
        full = f.stem
        age = (time.time() - f.stat().st_mtime) / 3600
        try:
            r = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        br = r.get("branch", "")
        if age > hours or not br.startswith("claude/") or not re.fullmatch(r"[0-9a-f]{40}", full) or full in settled:
            continue
        if any(matches_revocation(br, full, branch, sha) for branch, sha in revoked):
            continue
        if f"{br}@{full}" in items and items[f"{br}@{full}"].get("status") in TERMINAL:
            continue
        if remote_tip(br) != full:
            continue                                         # tip moved past the gate, or branch gone: wait for a new gate
        if rev(full) and is_ancestor(full, base):
            continue
        out.append((age, br, full))
    return sorted(out)


def auto_digest(st, force=False):
    pend = st.get("auto_pending", [])
    if pend and (force or time.time() - st.get("auto_digest_ts", 0) >= AUTO_DIGEST_SECS):
        queue_post(st, "STATE", "COORD", f"MERGED-AUTO digest: {len(pend)} branch(es) merged without approval since the last digest "
                                         f"(COORD reviews after the merge): " + "; ".join(pend[:30]))
        st["auto_pending"] = []
        st["auto_digest_ts"] = time.time()
        flush_posts(st)


# ---------------------------------------------------------------- tick

def gate_record(full, base, it):
    """a GREEN `gate` record (~/merge-queue/gates/<sha>.json, written by `ot-merge-queue gate` here or by ot-gate-remote on a
    build host) is the item's gate when it ran on this main, or on an older main whose later commits touch none of the
    branch's files and none of its tests -> note, or '' (gate it here)"""
    try:
        r = json.loads((MQ / "gates" / f"{full}.json").read_text())
    except (OSError, ValueError):
        return ""
    m = r.get("main", "")
    if not m or not rev(m) or not is_ancestor(m, base):
        return ""
    if m != base:
        mb = git("merge-base", base, full).stdout.strip()
        mine = set(changed_files(REPO, mb, full)) | set(r.get("tests", []))
        moved = set(changed_files(REPO, m, base))
        if mine & moved or len(moved) > 400:
            return ""
    it["tests"] = r.get("tests", [])
    return (f"gate record from {r.get('host', 'hub')} {r.get('at', '')} on main {m[:11]}"
            + ("" if m == base else f" (main since: no overlap)") + f": {r.get('note', '')}")


def run_group(cmd, timeout):
    """shell command in its own process group; on timeout the whole group (sh, ot-run, ssh) is killed, not just the sh"""
    p = S.Popen(cmd, shell=True, stdout=S.PIPE, stderr=S.PIPE, text=True, cwd="/", start_new_session=True)
    try:
        out, err = p.communicate(timeout=timeout)
    except S.TimeoutExpired:
        try:
            os.killpg(p.pid, 15)
        except OSError:
            pass
        out, err = p.communicate()
        raise S.TimeoutExpired(cmd, timeout, output=(out or "").encode())
    return S.CompletedProcess(cmd, p.returncode, out, err)


def stall_alert(st, pending):
    """ALERT once per STALL_SECS when nothing merged for STALL_SECS while approvals wait (a stuck tick cannot post at its end)"""
    if not pending:
        st.pop("pending_since_ts", None)
        return
    now_ = time.time()
    pending_since = st.setdefault("pending_since_ts", now_)
    last = max(pending_since, st.get("last_merge_ts") or pending_since)
    if now_ - last > STALL_SECS and now_ - st.get("last_alert_ts", 0) > STALL_SECS:
        st["last_alert_ts"] = now_
        queue_post(st, "ALERT", "COORD", f"nothing merged for {int((now_ - last) // 60)} min with {pending} approval(s) pending; "
                                         f"tick pid {os.getpid()} (log ~/merge-queue/log). Items running > {ITEM_SECS // 60} min are set aside.")
        flush_posts(st)
        save_state(st)


def await_item(st, it, fut, pending):
    """result of an item's prepare; sets it aside (INFRA, retried by the next tick) after ITEM_SECS so one slow gate cannot hold the rest"""
    while True:
        try:
            return fut.result(timeout=5)
        except CF.TimeoutError:
            pass
        stall_alert(st, pending)
        t0 = it.get("t0")
        if t0 and time.time() - t0 > ITEM_SECS:
            ASIDE.append(it["key"])
            return "INFRA", f"ASIDE: prepare/gate ran > {ITEM_SECS // 60} min; set aside, the rest of the tick goes on"


def gate_remote(it, full, base):
    """run the item's gate on a build host (GATE_REMOTE, ot-run + ot-gate-remote; CLEAN-ALL 11-15 16:0x: hub scratch took
    5 gate trees, ~15 GB of churn an hour) -> (status, note), or None when the runner could not start (gate it here)"""
    cmd = GATE_REMOTE.format(key=f"{it['branch'] or '-'}@{full}")
    try:
        r = run_group(cmd, GATE_REMOTE_TIMEOUT)
    except S.TimeoutExpired as e:
        tail = ((e.stdout or b"") if isinstance(e.stdout, bytes) else (e.stdout or "").encode())[-300:].decode(errors="replace")
        return "INFRA", f"remote gate timed out after {GATE_REMOTE_TIMEOUT // 60} min ({cmd.split()[0]}): {tail}"
    out = (r.stdout or "") + (r.stderr or "")
    rec = gate_record(full, base, it)
    if rec:
        return "GREEN", "remote " + rec
    last = [ln for ln in out.splitlines() if re.match(r"(GREEN|RED|INFRA)\b", ln)]
    if r.returncode == 78 and not last:
        # ot-run did not start the gate. Keep the request with placement when it reports a capacity hold.
        refusal = next((ln for ln in reversed(out.splitlines()) if ln.startswith("NOT-RUN ")), None)
        if refusal:
            return "INFRA", f"remote gate admission deferred: {refusal[:1000]}"
    if r.returncode in (126, 127) or not last:
        log(f"{it['key']}: remote gate did not run (rc {r.returncode}: {out.strip()[-200:]}); gating on the hub")
        return None
    word, _, rest = last[-1].partition(" ")
    rest = rest.split(": ", 1)[1] if ": " in rest else rest
    if word == "GREEN":                                     # GREEN without a usable record (main moved under it): gate here
        return None
    return word, "remote: " + rest[:1500]


def prepare(it, base, remote=True):
    """fetch + apply + gate in the item's own worktree (parallel part)"""
    it["t0"] = time.time()
    try:
        full = fetch_sha(it["branch"], it["sha"])
        if not full:
            if it["branch"] and (rev(f"refs/mq/{REMOTE}/{it['branch']}") or rev(f"refs/mq/{FALLBACK}/{it['branch']}")):
                return "WAIT", f"INVALID-SHA: sha {it['sha']} is not in branch {it['branch']} (branch fetched, sha absent); check the approval"
            return "WAIT", f"sha {it['sha']} not fetchable from {REMOTE}/{FALLBACK} (branch {it['branch'] or '-'})"
        it["sha_full"] = full
        if it["branch"]:
            tipb = rev(f"refs/mq/{REMOTE}/{it['branch']}") or rev(f"refs/mq/{FALLBACK}/{it['branch']}")
            if tipb and tipb != full and not is_ancestor(full, tipb):
                log(f"{it['key']}: note: branch tip {tipb[:11]} does not contain the approved sha; landing the approved sha")
        if is_ancestor(full, base):
            return "ALREADY", f"{full[:11]} is an ancestor of main {base[:11]}"
        mb = git("merge-base", base, full).stdout.strip()
        it["extra"] = changed_checkout_entries(changed_files(REPO, mb, full))
        wt = wt_make(it["id"], base, it["extra"])
        status, detail = apply(wt, base, full, it["branch"], HOW(it))
        if status != "OK":
            return status, detail
        it["mode"] = detail
        rec = gate_record(full, base, it)
        if rec:
            it["note"] = rec                                 # the MERGED post quotes it (drt0255 16:19 quoted its old INFRA)
            return "GREEN", rec
        if it.get("auto"):                                   # auto / merge-now never gates: a new gate (ot-gate-remote) is the lane's step
            return "SKIP", "no GREEN gate record valid on current main (missing, or main since touched its files): gate it again"
        if remote and GATE_REMOTE and not DRY:
            got = gate_remote(it, full, base)
            if got:
                it["note"] = got[1]
                return got
        res, note = gate(it, wt, base)
        it["note"] = note
        return res, note
    except Exception as e:                                   # a git / host error is infra, retried next tick
        return "INFRA", f"{type(e).__name__}: {str(e)[:300]}"


def pregate(branch, sha):
    """start the remote gate for a READY whose stamp is missing or stale (detached; one per sha) -> what was done"""
    if not GATE_REMOTE or DRY:
        return "no remote runner; the tick gates it on approval"
    full = rev(sha) or sha
    out = MQ / "pregate" / f"{sha}.out"
    if (MQ / "gates" / f"{full}.json").exists() or out.exists():
        return "gate record or gate run already there (one gate per sha)"
    out.parent.mkdir(parents=True, exist_ok=True)
    with open(out, "w") as f:
        S.Popen(GATE_REMOTE.format(key=f"{branch}@{sha}"), shell=True, stdout=f, stderr=S.STDOUT, stdin=S.DEVNULL, cwd="/",
                start_new_session=True)
    return f"gating it on the remote runner (output {out})"


def check_ready(text, st):
    """new READY lines (after st['ready_from']) whose gate stamp is missing or wrong are gated by the queue itself (pregate),
    never bounced (COORD r178); -> number pre-gated"""
    lines = text.splitlines()
    if "ready_from" not in st:                       # rule goes live: only READYs posted from now on are checked
        st["ready_from"] = len(lines) + 1
        return 0
    seen = set(st.setdefault("ready_seen", []))
    main_ref, n_b = None, 0
    # a READY whose sha is already approved by COORD, landed by the queue, or contained in main is not judged (09:08 11-15:
    # s81-leaf-t14-1115b was bounced while the same tick merged it as 12f54cf1aec)
    done = [a["sha"] for a in parse_approvals(text) if not a["revoked"]]
    done += [it.get("sha_full") or it.get("sha", "") for it in st.get("items", {}).values()
             if it.get("status") in ("MERGED", "ALREADY")]
    def settled(sha):
        nonlocal main_ref
        if any(d and (d.startswith(sha) or sha.startswith(d)) for d in done):
            return True
        if main_ref is None:
            main_ref = fetch_main()
        full = rev(sha)
        return bool(full and main_ref) and is_ancestor(full, main_ref)
    for n in range(int(st["ready_from"]), len(lines) + 1):
        line = lines[n - 1]
        m = READY_RE.match(line)
        if not m or m.group(1) in (ME, "COORD", "OWNER") or m.group(1).startswith(ME):
            continue
        bm = READY_BRANCH_RE.search(line)
        if not bm:
            continue                                  # a READY without branch@sha is a status / result line, not a merge request
        key = f"{bm.group(1)}@{bm.group(2)}"
        if key in seen:
            continue
        if settled(bm.group(2)):
            seen.add(key)
            continue
        g, why = GATE_RE.search(line), ""
        if not g:
            why = "no GATE stamp"
        elif int(g.group(3)) == 0 or int(g.group(2)) != int(g.group(3)):
            why = f"GATE pass={g.group(2)}/{g.group(3)} is not all-pass"
        else:
            if main_ref is None:
                main_ref = fetch_main()
            gm, tip = rev(g.group(1)), ""
            try:
                fetch_sha(bm.group(1), bm.group(2))
            except Exception:                             # noqa: BLE001 - reported as a bounce reason
                pass
            tip = rev(bm.group(2))
            if not tip:
                if st.get("ready_wait", {}).get(key, 0) < WAIT_TICKS:
                    st.setdefault("ready_wait", {})[key] = st.get("ready_wait", {}).get(key, 0) + 1
                    continue                              # not pushed yet: look again next tick
                why = f"branch sha {bm.group(2)} not found on {REMOTE} or {FALLBACK or '-'}"
            elif not gm or not is_ancestor(gm, main_ref):
                why = f"GATE main={g.group(1)} is not a commit on main"
            elif not is_ancestor(gm, tip):
                why = f"branch {bm.group(2)} is not rebased on GATE main={g.group(1)} (that main is not an ancestor of the tip)"
            else:
                behind = int(git("rev-list", "--count", "--first-parent", f"{gm}..{main_ref}").stdout.strip() or 0)
                if behind > GATE_MAX_BEHIND:
                    why = f"GATE main={g.group(1)} is {behind} main commits old (limit {GATE_MAX_BEHIND}); rebase on current main"
        seen.add(key)
        if why:
            # FABLE-FLOW-1600 / COORD r178: never bounce a READY for its stamp; gate it ourselves, once per sha, so the
            # record is waiting when COORD approves
            n_b += 1
            log(f"READY {key} line {n}: {why}; " + pregate(bm.group(1), bm.group(2)))
        else:
            log(f"READY {key} line {n}: gate stamp ok ({g.group(0)})")
    st["ready_seen"] = sorted(seen)[-2000:]
    return n_b


def sync_hook_note(result):
    """Report activation evidence before incidental stderr; rc 4 can follow a successful flip."""
    lines = [line.strip() for line in (result.stdout or "").splitlines() if line.strip()]
    current = next((line for line in reversed(lines) if line.startswith("rt/current -> ")), "")
    smoke = next((line for line in lines if line.startswith("SMOKE-FAIL ")), "")
    failed = next((line for line in reversed(lines) if " SYNC FAILED " in line), "")     # ot-tools-sync sync_guarded: the exception text (e.g. hub free GB < OT_RT_MIN_FREE_GB)
    if current:
        parts = [current]
        parts += [line for line in lines if line.startswith("ALERT ")]
    elif smoke:
        parts = [smoke, "rt/current unchanged: smoke failed before activation"]
    elif failed:
        parts = [failed.split(" SYNC FAILED ", 1)[1].strip()] + [line for line in lines[-3:] if line != failed and " SYNC " in line]
    else:
        parts = lines[-3:] or ["runtime activation state not reported"]
    note = " ; ".join(parts)[:1600]
    if (result.stderr or "").strip():
        note += "; stderr context: " + result.stderr.strip()[-400:]
    return note


def tick(args):
    MQ.mkdir(parents=True, exist_ok=True)
    lockf = open(MQ / "lock", "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another tick holds the lock; exit")
        return 0
    st = load_state()
    flush_posts(st)
    text = (COORD / QUEUE_REL).read_text(errors="replace")
    if not args.only:
        try:
            nb = check_ready(text, st)
            if nb:
                log(f"ready gate: {nb} READY line(s) without a usable stamp, gated by the queue")
        except Exception as e:                            # noqa: BLE001 - the gate check never stops the train
            log(f"ready gate check error: {e}")
        flush_posts(st)
    apps = parse_approvals(text)
    apps = [a for a in apps if a.get("high")] + [a for a in apps if not a.get("high")]    # priority HIGH first
    items = st.setdefault("items", {})
    todo = []
    for a in apps:
        if args.only and not a["sha"].startswith(args.only[:len(a["sha"])]) and not args.only.startswith(a["sha"]):
            continue
        it = items.get(a["key"])
        if it and it.get("status") in TERMINAL:
            continue
        if a["revoked"]:
            if not it or it.get("status") not in TERMINAL:
                items[a["key"]] = dict(it or {}, key=a["key"], branch=a["branch"], sha=a["sha"], status="REVOKED", updated=stamp())
                log(f"{a['key']}: revoked before landing")
            continue
        if not it:
            it = items[a["key"]] = {"key": a["key"], "branch": a["branch"], "sha": a["sha"], "status": "NEW",
                                    "first_seen": stamp(), "tries": 0, "line": a["line"]}
        it["id"] = re.sub(r"[^\w.-]", "_", f"{a['sha'][:12]}")
        it["high"] = a.get("high", False)
        it["lane"] = lane_for(text, a["branch"], a["sha"])
        todo.append(it)
    if not args.only and auto_enabled():
        try:
            base0 = fetch_main()
            for age, br, full in auto_candidates(text, items, base0):
                key = f"{br}@{full}"
                it = items.get(key)
                if it and it.get("status") in TERMINAL:
                    continue
                if not it:
                    it = items[key] = {"key": key, "branch": br, "sha": full, "status": "NEW", "first_seen": stamp(), "tries": 0,
                                       "line": 0, "auto": True}
                it["auto"] = it.get("auto", True)
                it["id"] = re.sub(r"[^\w.-]", "_", full[:12])
                it["high"] = False
                it["lane"] = lane_for(text, br, full)
                if it not in todo:
                    todo.append(it)
        except Exception as e:                            # noqa: BLE001 - the auto scan never stops approved items
            log(f"auto scan error: {type(e).__name__}: {e}")
    if not todo:
        if not args.only:
            stall_alert(st, 0)
        auto_digest(st)
        save_state(st)
        log(f"tick: {len(apps)} approval(s) in queue, none new")
        return 0
    st.setdefault("pending_since_ts", time.time())
    process_todo(st, todo, text, args)
    if not args.only and not any(it["key"] in items and it.get("status") not in TERMINAL for it in todo):
        stall_alert(st, 0)
    auto_digest(st)
    save_state(st)
    return 0


def process_todo(st, todo, text, args):
    items = st["items"]
    base = fetch_main()
    log(f"tick: main {base[:11]}, {len(todo)} new approval(s): {', '.join(i['key'] for i in todo)}")
    # gates run in parallel; each item LANDS as soon as its own gate and every gate before it are done (COORD 11-15 08:4x:
    # a 30-min gate of one item held 7 green items behind it).  land() re-tests on the moved main where files overlap.
    ex = CF.ThreadPoolExecutor(max_workers=max(1, PAR))
    for it in todo:
        it.pop("t0", None)
    futs = {it["key"]: ex.submit(prepare, it, base) for it in todo}
    landed = ""
    for it in todo:                                          # serial: priority HIGH approvals first, then queue order
        status, detail = await_item(st, it, futs[it["key"]], len(todo))
        if status == "SKIP":                                 # auto item without a usable gate: not recorded, looked at again next tick
            log(f"{it['key']}: SKIP: {detail}")
            it["skip"] = detail
            if it.get("status") == "NEW":
                items.pop(it["key"], None)
            continue
        it["tries"] = int(it.get("tries", 0)) + 1
        it["base"] = base
        log(f"{it['key']}: {status}: {detail if isinstance(detail, str) else detail}")
        if status == "WAIT":
            it["status"] = "WAIT"
            if str(detail).startswith("INVALID-SHA") and not it.get("invalid_posted"):
                it["invalid_posted"] = True
                queue_post(st, "INVALID-SHA", "COORD", f"{it['key']}: {detail}")
            if it["tries"] >= WAIT_TICKS:
                fail(st, it, text, "UNFETCHABLE", detail, base)
        elif status == "INFRA":
            it["status"] = "INFRA"
            if it["tries"] >= INFRA_TRIES:
                fail(st, it, text, "INFRA", detail, base)
        elif status == "ALREADY":
            it["sha_full"] = it.get("sha_full") or it["sha"]
            finish(st, it, "ALREADY", detail, base)
        elif status in ("CONFLICT", "ERROR", "RED"):
            fail(st, it, text, status, detail, base)
        elif status == "GREEN":
            tip = land(it, text, st)
            if tip:
                landed = tip
        save_state(st)
        if it.get("status") in TERMINAL and not args.keep:
            wt_drop(it["id"])
    ex.shutdown(wait=not ASIDE, cancel_futures=True)
    keep = "base-" + fetch_main()[:12]
    for name in [p.name for p in WT.glob("base-*")]:
        if name != keep:
            wt_drop(name)
    sync_note = ""
    if landed and SYNC_HOOK and not DRY:
        cmd = SYNC_HOOK.format(sha=landed)
        r = run(shlex.split(cmd), timeout=1800)
        sync_note = sync_hook_note(r)
        log(f"sync hook rc={r.returncode}: {sync_note}")
        if r.returncode:
            queue_post(st, "STATE", "COORD", f"ot-tools-sync for main {landed[:11]} failed rc={r.returncode}: "
                                             f"{sync_note}")
    if landed and SRC_HOOK and not DRY:
        r = run(shlex.split(SRC_HOOK.format(old=base, new=landed)), timeout=3600)
        out = (r.stdout or "").strip().splitlines()
        log(f"src refresh hook rc={r.returncode}: {' | '.join(out)[:600]}")
        held = [l for l in out if re.search(r"\b(CONFLICT|BUSY|LOCAL|ERROR)\b", l)]
        if r.returncode or held:
            queue_post(st, "STATE", "COORD", f"src refresh {base[:11]}..{landed[:11]} rc={r.returncode}: {' ; '.join(held or out)[:900]} "
                                             f"(CONFLICT/LOCAL kept as the die tree has them; BUSY retried after the next merge; "
                                             f"rows ~/merge-queue/src-refresh.tsv)")
    flush_posts(st)
    save_state(st)


def commit_lane(c):
    """the lane a main commit belongs to: a leading `[LANE]` / `LANE:` of the subject, else the author name"""
    subj = git("log", "-1", "--format=%s", c, check=False).stdout.strip()
    m = re.match(r"\[?([A-Za-z0-9][\w.-]{1,40})[\]:]", subj)
    if m and m.group(1).lower() not in ("merge", "fix", "revert", "add", "update"):
        return m.group(1).upper()
    return git("log", "-1", "--format=%an", c, check=False).stdout.strip() or "COORD"


def redwatch_staging_refusal():
    """Use the launcher and reservation used by standard gates, on the local worktree volume."""
    root = WT.absolute()
    parent = next(p for p in (root, *root.parents) if p.is_dir())
    launcher = shutil.which("ot-run") or str(HOME / ".local/bin/ot-run")
    try:
        disk_admission = runpy.run_path(str(Path(__file__).resolve().with_name("ot-run")))
        # On an authorized second scratch root, ot-run already subtracts the
        # root reserve. Its required raw target is therefore usable floor + peak.
        floor = (disk_admission["SCRATCH_SECOND_FLOOR_GB"] if parent.stat().st_dev == Path("/").stat().st_dev
                 else disk_admission["sfloor"]("localhost"))
        admitted = S.run([launcher, "--hosts", "localhost", "--strict-host", "--dir", str(parent),
                          "--mem", "4", "--threads", "1", "--disk", str(floor + 60), "--max-wait", "1", "--pick"],
                         capture_output=True, text=True, timeout=45)
    except (OSError, S.TimeoutExpired) as exc:
        return str(exc)
    if admitted.returncode == 0 and admitted.stdout.strip() == "localhost":
        return ""
    return (admitted.stderr or admitted.stdout).strip()[-500:] or f"admission exit {admitted.returncode}"


def redwatch_gate(commit, parent):
    """Run the canonical gate at the exact landed commit and its first parent."""
    it = {"id": f"rw-{commit[:10]}", "key": f"main@{commit[:11]}"}
    try:
        it["extra"] = changed_checkout_entries(changed_files(REPO, parent, commit))
        return gate(it, wt_make(it["id"], commit, it["extra"]), parent)
    except Exception as e:
        return "INFRA", f"{type(e).__name__}: {str(e)[:300]}"
    finally:
        wt_drop(it["id"])


def redwatch_gate_cmd(commit, parent):
    if (not all(re.fullmatch(r"[0-9a-f]{40}", sha) for sha in (commit, parent))
            or not is_ancestor(commit, fetch_main()) or rev(f"{commit}^1") != parent):
        print("REDWATCH_GATE: commit or first parent unavailable on mirror", flush=True)
        return 2
    status, note = redwatch_gate(commit, parent)
    print("REDWATCH_GATE " + json.dumps({"sha": commit, "parent": parent, "status": status, "note": note}), flush=True)
    return {"GREEN": 0, "RED": 1}.get(status, 2)


def redwatch_gate_remote(commit, parent):
    cmd = REDWATCH_REMOTE.format(sha=commit, parent=parent)
    try:
        result = run_group(cmd, GATE_REMOTE_TIMEOUT)
    except (OSError, S.TimeoutExpired) as e:
        return "INFRA", f"remote gate: {type(e).__name__}"
    for line in reversed((result.stdout or "").splitlines()):
        if not line.startswith("REDWATCH_GATE "):
            continue
        try:
            receipt = json.loads(line.removeprefix("REDWATCH_GATE "))
        except ValueError:
            break
        status = receipt.get("status")
        if receipt.get("sha") == commit and receipt.get("parent") == parent and (
                (status, result.returncode) in (("GREEN", 0), ("RED", 1))):
            return status, "remote: " + str(receipt.get("note") or "")[:1500]
        return "INFRA", "remote exact gate did not complete: " + str(receipt.get("note") or "")[:400]
    return "INFRA", ((result.stderr or result.stdout or "").strip()[-400:] or f"remote gate exit {result.returncode}")


def redwatch():
    """OWNER 11-18: the queue is no gate any more.  Alarm only: for each NEW commit on main (first-parent, newest MQ_REDWATCH_MAX), run the
    tests its touched files select (the same gate() run, against the commit's first parent, so a failure main already had is baseline); a
    NEW failure posts one KNOWN-RED line naming the commit to its author lane.  Nobody is blocked."""
    MQ.mkdir(parents=True, exist_ok=True)
    lockf = open(MQ / "redwatch.lock", "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    f = MQ / "redwatch.json"
    try:
        rs = json.loads(f.read_text())
    except (OSError, ValueError):
        rs = {}
    base = fetch_main()
    seen = rs.get("seen", "")
    if not seen or not rev(seen) or not is_ancestor(seen, base):
        rs["seen"] = base
        rs.pop("deferred", None)
        f.write_text(json.dumps(rs, indent=1))
        log(f"redwatch: start at main {base[:11]}")
        return 0
    commits = git("rev-list", "--first-parent", "--reverse", f"{seen}..{base}").stdout.split()
    deferred = set(rs.pop("deferred", [])) & set(commits)
    cap = int(os.environ.get("MQ_REDWATCH_MAX", "4"))
    if cap > 0 and len(commits) > cap:
        first = [c for c in commits if c in deferred][:cap]
        remaining = cap - len(first)
        newer = [c for c in commits if c not in deferred]
        selected = set(first + (newer[-remaining:] if remaining else []))
        log(f"redwatch: {len(commits)} new commits, checking {cap} ({len(first)} deferred first)")
        commits = [c for c in commits if c in selected]
    st = {"posts": []}
    remote_used = False
    for index, c in enumerate(commits):
        par = rev(f"{c}^1")
        if not par:
            rs["seen"] = c
            deferred.discard(c)
            continue
        if reason := redwatch_staging_refusal():
            if not REDWATCH_REMOTE or remote_used or DRY:
                log(f"redwatch {c[:11]}: source staging deferred: {reason}")
                deferred.update(commits[index:])
                break
            remote_used = True                                    # one existing gate budget per timer tick
            log(f"redwatch {c[:11]}: local staging unavailable; dispatch exact gate vs {par[:11]}")
            res, note = redwatch_gate_remote(c, par)
        else:
            res, note = redwatch_gate(c, par)
        log(f"redwatch {c[:11]}: {res}: {note[:300]}")
        if res not in ("GREEN", "RED"):
            deferred.update(commits[index:])
            break
        if res == "RED":
            lane = commit_lane(c)
            subj = git("log", "-1", "--format=%s", c).stdout.strip()[:100]
            queue_post(st, "KNOWN-RED", lane, f"main {c[:11]} ('{subj}') made test(s) red: {note[:900]}. Not blocking anyone; "
                                              f"fix on main (ot-push-main) or revert.")
            rs.setdefault("red", {})[c] = note[:300]
        rs["seen"] = c
        deferred.discard(c)
    flush_posts(st)
    if deferred:
        rs["deferred"] = sorted(deferred)
    f.write_text(json.dumps(rs, indent=1))
    return 0


def auto_list():
    st = load_state()
    base = fetch_main()
    text = (COORD / QUEUE_REL).read_text(errors="replace")
    c = auto_candidates(text, st.get("items", {}), base)
    print(f"auto-merge {'ON' if auto_enabled() else 'OFF'}; main {base[:11]}; {len(c)} candidate(s) (gate < {AUTO_HOURS:g} h, remote tip == gated sha)")
    for age, br, full in c:
        print(f"{age:5.1f} h  {br} @{full[:11]}")
    return 0


def merge_now(branch, sha):
    """land <branch>@<fullsha> NOW under the tick lock; needs a GREEN gate record valid on current main and sha == remote tip"""
    if not re.fullmatch(r"[0-9a-f]{40}", sha) or not branch.startswith("claude/"):
        print("merge-now: need claude/<branch> and the FULL 40-hex sha"); return 2
    if not (MQ / "gates" / f"{sha}.json").exists():
        print(f"NO-GATE {branch}@{sha[:11]}: no GREEN gate record; run ot-gate-remote first"); return 3
    tip = remote_tip(branch)
    if tip != sha:
        print(f"TIP-MOVED {branch}: remote tip {tip[:11] or 'none'} != gated {sha[:11]}; push done? gate the new tip"); return 4
    lockf = open(MQ / "lock", "w")
    t0 = time.time()
    while True:
        try:
            fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB); break
        except OSError:
            if time.time() - t0 > MERGE_NOW_WAIT:
                print("BUSY: the merge-queue lock is held > %d min; the 5-min tick will pick it up" % (MERGE_NOW_WAIT // 60)); return 5
            time.sleep(5)
    st = load_state()
    flush_posts(st)
    items = st.setdefault("items", {})
    key = f"{branch}@{sha}"
    it = items.get(key)
    if it and it.get("status") in TERMINAL:
        print(f"{it['status']} {key} already settled: {it.get('reason', '')}"); return 0 if it["status"] in ("MERGED", "ALREADY") else 1
    text = (COORD / QUEUE_REL).read_text(errors="replace")
    if not it:
        it = items[key] = {"key": key, "branch": branch, "sha": sha, "status": "NEW", "first_seen": stamp(), "tries": 0, "line": 0}
    it.update(auto=True, id=re.sub(r"[^\w.-]", "_", sha[:12]), high=True, lane=lane_for(text, branch, sha))
    process_todo(st, [it], text, argparse.Namespace(only="", keep=False))
    auto_digest(st)
    save_state(st)
    s = items.get(key) or it
    if s.get("skip"):
        print(f"SKIP {key}: {s['skip']}"); return 6
    print(f"{s.get('status', '?')} {key} {s.get('tip', '')} {s.get('reason', '')}")
    return 0 if s.get("status") in ("MERGED", "ALREADY") else 1


def status():
    st = load_state()
    for k, it in sorted(st.get("items", {}).items(), key=lambda kv: kv[1].get("first_seen", "")):
        print(f"{it.get('status', '?'):8} {k:60} {it.get('updated', it.get('first_seen', ''))} {it.get('tip', '')[:11]} "
              f"{it.get('reason', it.get('note', ''))[:120]}")
    pend = [p for p in st.get("posts", []) if not p.get("posted")]
    print(f"unposted lines: {len(pend)}")


def main():
    global DRY
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", default="tick", choices=["tick", "status", "parse", "gate", "known-red", "auto-list", "merge-now", "redwatch", "redwatch-gate"])
    ap.add_argument("target", nargs="?", default="", help="gate: <branch>[@<sha>]")
    ap.add_argument("sha", nargs="?", default="", help="merge-now: the full sha")
    ap.add_argument("--dry-run", action="store_true", help="test only: no push, no tag, no post, no state write")
    ap.add_argument("--only", default="", help="only the approval of this sha")
    ap.add_argument("--keep", action="store_true", help="keep worktrees of finished items")
    a = ap.parse_args()
    DRY = a.dry_run
    if a.cmd == "status":
        return status()
    if a.cmd == "known-red":
        return known_red_cmd()
    if a.cmd == "redwatch-gate":
        return redwatch_gate_cmd(a.target, a.sha)
    if a.cmd == "redwatch":
        try:
            return redwatch()
        finally:
            pack_guard()
    if a.cmd == "auto-list":
        return auto_list()
    if a.cmd == "merge-now":
        try:
            return merge_now(a.target, a.sha)
        finally:
            pack_guard()
    if a.cmd == "gate":
        if not a.target:
            ap.error("gate needs <branch>[@<sha>]")
        return gate_cmd(a.target)
    if a.cmd == "parse":
        text = (COORD / QUEUE_REL).read_text(errors="replace")
        st = load_state().get("items", {})
        for x in parse_approvals(text):
            print(f"{x['key']:60} line {x['line']:6} lane {lane_for(text, x['branch'], x['sha']):20} "
                  f"{'REVOKED ' if x['revoked'] else ''}{st.get(x['key'], {}).get('status', 'NEW')}")
        return 0
    try:
        return tick(a)
    finally:
        pack_guard()


if __name__ == "__main__":
    _rc = main() or 0
    if ASIDE:                                    # set-aside gate threads must not hold the process (state and posts are saved)
        sys.stdout.flush(); os._exit(_rc)
    sys.exit(_rc)
