class GitError(RuntimeError):
    pass


def run(cmd, cwd=None, timeout=600, env=None, check=False):
    try:
        p = S.run(cmd, cwd=str(cwd) if cwd else None, capture_output=True, text=True, timeout=timeout, env=env)
    except S.TimeoutExpired as e:
        p = S.CompletedProcess(cmd, 124, e.stdout or "", (e.stderr or "") if isinstance(e.stderr, str) else "timeout")
        if isinstance(p.stdout, bytes):
            p.stdout = p.stdout.decode(errors="replace")
    if check and p.returncode:
        raise GitError(f"{' '.join(map(str, cmd))[:200]} rc={p.returncode}: {(p.stderr or p.stdout).strip()[:400]}")
    return p


def git(*a, cwd=REPO, check=True, timeout=600):
    return run(["git", *a], cwd=cwd, timeout=timeout, check=check)


def rev(ref, cwd=REPO):
    p = git("rev-parse", "-q", "--verify", f"{ref}^{{commit}}", cwd=cwd, check=False)
    return p.stdout.strip() if p.returncode == 0 else ""


def is_ancestor(a, b, cwd=REPO):
    return git("merge-base", "--is-ancestor", a, b, cwd=cwd, check=False).returncode == 0


# ---------------------------------------------------------------- parsing

def parse_approvals(text):
    """-> ordered list of {'key','branch','sha','line','revoked'} (first approval of a key wins; REVOKED after it marks it)"""
    out, seen = [], {}
    for n, line in enumerate(text.splitlines(), 1):
        ts = LINE_TS_RE.match(line)
        ext = bool(ts) and ts.group(1) >= APPROVE_EXT_FROM
        heads = list((APPROVE_HEAD_RE if ext else re.compile(r"COORD (APPROVED|REVOKED):")).finditer(line))
        if not heads:
            continue
        if QUOTE_RE.search(line):
            continue
        au = AUTHOR_RE.search(line[:heads[0].start()])
        if au and au.group(1) not in APPROVERS:
            continue
        found = [(m.group(1), m.group(2) or "", m.group(3).lower()) for m in (APPROVE_EXT_RE if ext else APPROVE_RE).finditer(line)]
        if ext:
            # "(a) x @s ... (b) y @t" after an APPROVED header: every lettered item up to the next header
            for i, h in enumerate(heads):
                if h.group(1) != "APPROVED":
                    continue
                seg = line[h.end():heads[i + 1].start() if i + 1 < len(heads) else len(line)]
                if not re.match(r"\s*\([a-z]\)", seg):
                    continue
                for li in LIST_ITEM_RE.finditer(seg):
                    t = ("APPROVED", li.group(2), li.group(3).lower())
                    if t not in found:
                        found.append(t)
        for kind, branch, sha in found:
            key = f"{branch or '-'}@{sha}"
            if kind == "APPROVED" and key not in seen:
                seen[key] = {"key": key, "branch": branch, "sha": sha, "line": n, "revoked": False,
                             "high": bool(PRIORITY_RE.search(line))}
                out.append(seen[key])
            elif kind == "REVOKED":
                for a in out:                         # a revoke names the sha (prefix either way), branch optional
                    if (a["sha"].startswith(sha) or sha.startswith(a["sha"])) and (not branch or branch == a["branch"]):
                        a["revoked"] = True
    return out


def lane_for(text, branch, sha):
    """the lane that posted READY for this branch / sha (newest line first, READY before STATE/ASK); else a name from the branch"""
    probes = [p for p in (sha[:9], branch) if p]
    # a READY line often quotes the approval it asks for: keep it; drop only the approval rulings themselves
    lines = [l for l in reversed(text.splitlines()) if any(p in l for p in probes)
             and ("COORD APPROVED" not in l or re.search(r"\bREADY \[", l))]
    if branch:                                    # the READY that names the branch itself beats a line that only quotes the sha
        for line in lines:
            if branch in line:
                for m in LANE_RE.finditer(line):
                    if m.group(1) not in (ME, "COORD") and m.group(0).startswith("READY"):
                        return m.group(1)
    for want in ("READY", None):
        for line in lines:
            for m in LANE_RE.finditer(line):
                if m.group(1) not in (ME, "COORD") and (want is None or m.group(0).startswith(want)) \
                        and (not m.group(1).startswith(ME) or ME.lower() in (branch or "")):   # the merge lane quotes shas
                    return m.group(1)
    if branch:
        b = re.sub(r"^(claude|codex)/", "", branch)
        b = re.sub(r"-\d{4}(-[0-9a-f]{6})?$", "", b)
        return b.upper()
    return "COORD"


def next_tag(names, text="", today=None):
    """flow tag series after the newest one in use (remote tag names + names quoted in the queue): flow-<date>-<xx>"""
    pairs = [(m.group(1), m.group(2)) for n in names for m in [TAG_RE.search(n)] if m] + TAG_RE.findall(text)
    best = max(pairs) if pairs else None
    date = TAG_DATE or (best[0] if best else (today or now().strftime("%Y%m%d")))
    if not best or best[0] != date:
        return f"flow-{date}-aa"
    a, b = best[1]
    if b != "z":
        return f"flow-{date}-{a}{chr(ord(b) + 1)}"
    if a != "z":
        return f"flow-{date}-{chr(ord(a) + 1)}a"
    return f"flow-{today or now().strftime('%Y%m%d')}-aa"


# ---------------------------------------------------------------- test selection

def is_test(p):
    return os.path.basename(p).startswith("test_") and p.endswith(".py")


def select_tests(changed, all_tests, read):
    """changed: repo paths the candidate changes; all_tests: every test file in the worktree; read(path) -> text.
    -> (sorted test files, {test: reason}).  Rules (OWNER 11-14): tools/autopilot -> test_kit_wave.py; tools/die_plan -> the
    die_plan tests named after or referencing the module; ot-run / ot-heavy -> their tests; otherwise the branch's own (new or
    changed) tests plus the tests named after / referencing each changed file."""
    have = set(all_tests)
    pick = {}

    def add(t, why):
        if t in have and t not in pick:
            pick[t] = why

    cache = {}

    def text(t):
        if t not in cache:
            try:
                cache[t] = read(t)
            except OSError:
                cache[t] = ""
        return cache[t]

    for f in changed:
        if is_test(f):
            add(f, "changed test")
    for f in changed:
        if is_test(f) or f.endswith((".md", ".txt", ".json", ".tsv", ".csv")) and not f.startswith("tools/"):
            continue
        d, base = os.path.dirname(f), os.path.basename(f)
        stem = base.rsplit(".", 1)[0] if "." in base else base
        variants = {stem, stem.replace("-", "_")}
        if f.startswith("tools/autopilot/"):
            add("tools/autopilot/test_kit_wave.py", "tools/autopilot rule")
        if f.startswith("tools/fleet/ot-run"):
            for t in all_tests:
                if t.startswith("tools/fleet/test_ot_run"):
                    add(t, "ot-run rule")
        if f.startswith("tools/fleet/ot-heavy"):
            for t in all_tests:
                if t.startswith("tools/fleet/test_ot_heavy"):
                    add(t, "ot-heavy rule")
        for t in all_tests:                                   # sibling tests named after the file
            td, tb = os.path.dirname(t), os.path.basename(t)
            if (td == d or td == os.path.join(d, "tests")) and any(tb.startswith(f"test_{v}") for v in variants):
                add(t, f"named after {base}")
        if len(stem) < 4:
            continue
        scope = f.split("/")[0] + "/" + f.split("/")[1] + "/" if f.startswith("tools/") and f.count("/") >= 2 else "tools/"
        pat = re.compile(r"(?<![\w-])" + re.escape(stem) + r"(?![\w-])" if base.endswith(".py")
                         else re.escape(base))
        refs = [t for t in all_tests if t.startswith(scope) and t != f and pat.search(text(t))]
        if len(refs) > REF_CAP:                               # a common name: keep the tests that import / name the file
            strict = re.compile(r"(import\s+%s\b|from\s+%s\b|%s)" % (re.escape(stem), re.escape(stem), re.escape(base)))
            refs = [t for t in refs if strict.search(text(t))][:REF_CAP]
        for t in refs:
            add(t, f"references {base}")
    return sorted(pick), pick


# ---------------------------------------------------------------- worktrees

def wt_make(name, ref, extra_dirs=()):
    """a detached sparse worktree of the queue clone at ref (reused if present)"""
    p = WT / name
    with _LOCK, CLONE_LOCK():
        if p.exists() and not (p / ".git").exists():
            shutil.rmtree(p)
        if not p.exists():
            WT.mkdir(parents=True, exist_ok=True)
            git("worktree", "prune")
            git("worktree", "add", "-q", "--detach", "--no-checkout", str(p), ref)
    pats = list(SPARSE) + sorted({"/" + d.strip("/") + "/" for d in extra_dirs if d and d not in (".", "/")})
    git("sparse-checkout", "set", "--no-cone", *pats, cwd=p)
    for a in (("cherry-pick", "--abort"), ("merge", "--abort")):
        git(*a, cwd=p, check=False)
    git("checkout", "-q", "-f", "--detach", ref, cwd=p)
    git("clean", "-fdq", cwd=p, check=False)
    return p


def wt_drop(name):
    p = WT / name
    if p.exists():
        with _LOCK, CLONE_LOCK():
            git("worktree", "remove", "--force", str(p), check=False)
            if p.exists():
                shutil.rmtree(p, ignore_errors=True)


def fetch_main():
    with CLONE_LOCK():
        git("fetch", "-q", REMOTE, f"+refs/heads/{MAIN}:refs/remotes/{REMOTE}/{MAIN}", timeout=300)
    return rev(f"{REMOTE}/{MAIN}")


def fetch_sha(branch, sha):
    """-> full sha or '' (GitHub branch, then the hub checkout read-only); one fetch at a time per clone"""
    with _FETCH, CLONE_LOCK():
        return _fetch_sha(branch, sha)


def _fetch_sha(branch, sha):
    full = rev(sha)
    if full:
        return full
    for remote in (REMOTE, FALLBACK):
        if not remote:
            continue
        if branch:
            git("fetch", "-q", "--no-tags", remote, f"+refs/heads/{branch}:refs/mq/{remote}/{branch}", check=False, timeout=300)
        full = rev(sha)
        if full:
            return full
        git("fetch", "-q", "--no-tags", remote, sha, check=False, timeout=300)   # works when the sha is advertised / allowed
        full = rev(sha)
        if full:
            return full
    return ""


# ---------------------------------------------------------------- apply / check / test

def apply(wt, base, full, branch):
    """-> (status, detail) status: OK / ALREADY / CONFLICT / ERROR; HEAD of wt is the candidate tip on OK"""
    if is_ancestor(full, base, cwd=wt):
        return "ALREADY", f"{full[:11]} is an ancestor of main {base[:11]}"
    ch = git("cherry", base, full, cwd=wt).stdout.split("\n")
    plus = [l[2:].strip() for l in ch if l.startswith("+ ")]
    minus = [l[2:].strip() for l in ch if l.startswith("- ")]
    if not plus:
        return "ALREADY", f"every commit of {full[:11]} is already in main {base[:11]} (patch-equal)"
    if not minus:
        msg = f"Merge {branch or full[:11]} @{full[:11]} (MERGE-QUEUE, COORD APPROVED)\n\n{CO_AUTHOR}"
        p = git("merge", "--no-ff", "-q", "-m", msg, full, cwd=wt, check=False)
        mode = "no-ff merge"
        if p.returncode:
            u = git("diff", "--name-only", "--diff-filter=U", cwd=wt, check=False).stdout.split()
            git("merge", "--abort", cwd=wt, check=False)
            return ("CONFLICT", u) if u else ("ERROR", (p.stderr or p.stdout).strip()[:300])
        return "OK", mode
    for c in plus:
        p = git("cherry-pick", "-x", c, cwd=wt, check=False)
        if p.returncode:
            u = git("diff", "--name-only", "--diff-filter=U", cwd=wt, check=False).stdout.split()
            if not u and "empty" in (p.stderr + p.stdout):
                git("cherry-pick", "--skip", cwd=wt, check=False)
                continue
            git("cherry-pick", "--abort", cwd=wt, check=False)
            return ("CONFLICT", u) if u else ("ERROR", f"cherry-pick {c[:11]}: {(p.stderr or p.stdout).strip()[:300]}")
    return "OK", f"cherry-pick -x of {len(plus)} new commit(s) ({len(minus)} already in main)"


def changed_files(wt, a, b):
    return [x for x in git("diff", "--name-only", "--no-renames", a, b, cwd=wt).stdout.split("\n") if x]


def static_check(wt, files):
    """parse every changed Python / shell file; no conflict markers -> [problems]"""
    bad = []
    for f in files:
        p = wt / f
        if not p.is_file():
            continue
        try:
            head = p.read_bytes()[:4096]
        except OSError:
            continue
        if b"\0" in head:
            continue
        txt = p.read_text(errors="replace")
        if re.search(r"^(<<<<<<<|>>>>>>>) ", txt, re.M):
            bad.append(f"{f}: conflict marker")
        first = txt.split("\n", 1)[0]
        if f.endswith(".py") or ("python" in first and first.startswith("#!")):
            try:
                compile(txt, f, "exec", dont_inherit=True)
            except SyntaxError as e:
                bad.append(f"{f}: SyntaxError line {e.lineno}: {e.msg}")
        elif f.endswith(".sh") or (first.startswith("#!") and re.search(r"\b(ba)?sh\b", first)):
            r = run(["bash", "-n", str(p)], timeout=60)
            if r.returncode:
                bad.append(f"{f}: bash -n: {r.stderr.strip()[:200]}")
    return bad


def all_test_files(wt):
    out = git("ls-files", "--", "tools", cwd=wt).stdout.split("\n")
    return [f for f in out if is_test(f) and (wt / f).is_file()]


FAIL_RE = re.compile(r"^(FAILED|ERROR) (\S+)")


def pytest(wt, items, tag, n):
    """-> (rc, set(failed nodeids), tail)"""
    bt = WT / "bt" / tag
    tmp = WT / "tmp" / tag
    shutil.rmtree(bt, ignore_errors=True)
    bt.parent.mkdir(parents=True, exist_ok=True)
    tmp.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", TMPDIR=str(tmp))
    env.pop("PYTHONPATH", None)
    nargs = ["-n", str(n)] if n > 1 else []
    cmd = [PY, "-m", "pytest", "-q", *nargs, "--tb=line", "-rfE", "--continue-on-collection-errors", "-p", "no:cacheprovider",
           "-W", "ignore", f"--basetemp={bt}", *items]
    timeout = FLEET_TIMEOUT if all(i.startswith("tools/fleet/") for i in items) and len(items) == 1 else TEST_TIMEOUT
    p = run(cmd, cwd=wt, timeout=timeout, env=env)
    out = (p.stdout or "") + (p.stderr or "")
    fails = {m.group(2) for m in map(FAIL_RE.match, out.splitlines()) if m}
    tail = " | ".join(l for l in out.strip().splitlines()[-2:])[:300]
    if p.returncode == 124:
        fails.add(f"TIMEOUT({timeout}s):{' '.join(items)[:120]}")
    if fails:
        miss = missing_src(wt, out)
        if miss:
            fails.add("MISSING-SOURCE:" + " ".join(miss[:6]))
    shutil.rmtree(bt, ignore_errors=True)
    return p.returncode, fails, tail


def run_tests(wt, tests, tag):
    """fleet tests one file at a time (ot-heavy admission tests hang a shared run); the rest in one xdist run"""
    fleet = [t for t in tests if t.startswith("tools/fleet/")]
    rest = [t for t in tests if t not in fleet]
    fails, rcs, tails = set(), [], []
    if rest:
        rc, f, tail = pytest(wt, rest, tag + "-a", min(XDIST, max(2, 4 * len(rest))))
        fails |= f; rcs.append(rc); tails.append(tail)
    for i, t in enumerate(fleet):
        rc, f, tail = pytest(wt, [t], f"{tag}-f{i}", min(4, XDIST))
        fails |= f; rcs.append(rc); tails.append(tail)
    infra = [rc for rc in rcs if rc not in (0, 1, 5, 124)]
    return fails, infra, tails


def baseline(base, fails, extra=(), tag=""):
    """the failures that also fail on main@base (by file existence + rerun) -> set.  The main tree gets the SAME sparse set as
    the candidate (extra = the candidate's extra dirs) and is private to the item: a test that reads a file outside the sparse
    set then fails on both sides alike (11-14 20:51: test_core_reset_io read physical/die_plan/* that a shared base tree had)."""
    if not fails:
        return set()
    name = f"base-{base[:12]}" + (f"-{tag}" if tag else "")
    files = {f.split("::")[0] for f in fails if not f.startswith("TIMEOUT")}
    p = wt_make(name, base, set(extra) | {os.path.dirname(f) for f in files})
    # whole FILES on main, not node ids: one id that main does not have (a new or renamed test) makes pytest exit 4 and run
    # nothing, so every failure looked new (11-14 21:03 kit-ops-5 68 / pg-aware 57 test_core_reset_io + clock "new" failures)
    files = sorted(f for f in files if (p / f).is_file())
    if not files:
        return set()
    fleet = [f for f in files if f.startswith("tools/fleet/")]
    rest = [f for f in files if f not in fleet]
    on_main = set()
    if rest:
        on_main |= pytest(p, rest, name + "-a", min(XDIST, max(2, 4 * len(rest))))[1]
    for f in fleet:
        on_main |= pytest(p, [f], name + "-f", min(4, XDIST))[1]
    # a failure on main is baseline when the same nodeid (or its whole file, for a collection ERROR) fails there too
    return {f for f in fails if f in on_main or f.split("::")[0] in on_main}


_TOPS = {}


def _tops(rev_):
    if rev_ not in _TOPS:
        _TOPS[rev_] = sorted(git("ls-tree", "--name-only", "-d", rev_).stdout.split())
    return _TOPS[rev_]


def _path_lit_re(rev_, quoted=True):
    alt = "|".join(map(re.escape, _tops(rev_))) or "rtl"
    return re.compile((r"""["']/?((?:%s)/[\w.+-][\w./+-]*?)/?["']""" if quoted else r"""(?<![\w.-])((?:%s)/[\w.+-][\w./+-]*[\w+-])""") % alt)


def _tree_types(rev_, paths, cwd=REPO):
    """{path: 'blob'|'tree'} of the paths that exist at rev_ (one cat-file --batch-check)"""
    paths = sorted(set(paths))
    if not paths:
        return {}
    p = S.run(["git", "cat-file", "--batch-check"], cwd=str(cwd), input="".join(f"{rev_}:{x}\n" for x in paths),
              capture_output=True, text=True, timeout=300)
    out = {}
    for x, line in zip(paths, p.stdout.splitlines()):
        f = line.split()
        if len(f) == 3 and f[1] in ("blob", "tree"):
            out[x] = f[1]
    return out


def test_deps(wt, base, tests):
    """dirs the selected tests need beyond the sparse set: repo paths named as string literals in each test, its conftest.py
    files and the local modules it imports (11-15 kv-pvgen: test_pvgen_vport_selrep compiles rtl/test/kv_bootage_1019/*.sv
    and rtl/qwen_sys/... that the branch does not touch; the sparse gate tree lacked them and the sims timed out at 2400 s)"""
    files = set(tests)
    for t in tests:
        d = os.path.dirname(t)
        while d:
            files.add(f"{d}/conftest.py")
            d = os.path.dirname(d)
        try:
            txt = (wt / t).read_text(errors="replace")
        except OSError:
            continue
        for m in re.finditer(r"^\s*(?:from\s+([\w.]+)\s+import|import\s+([\w.]+))", txt, re.M):
            mod = (m.group(1) or m.group(2)).split(".")[0]
            for c in (f"{os.path.dirname(t)}/{mod}.py", f"tools/die_plan/{mod}.py", f"tools/{mod}.py"):
                files.add(c)
    lit, paths = _path_lit_re(base), set()
    for f in files:
        try:
            txt = (wt / f).read_text(errors="replace")
        except OSError:
            continue
        paths |= {m.group(1) for m in lit.finditer(txt)}
    dirs = set()
    for x, kind in _tree_types(base, paths).items():
        if kind == "blob":
            dirs.add(os.path.dirname(x))
        elif x.count("/") >= 1:                  # a named directory, never a whole top-level dir (rtl/, physical/)
            dirs.add(x)
    return {d for d in dirs if d}


def _covered(d, pats):
    d = "/" + d.strip("/") + "/"
    return any(not p.startswith("!") and p.endswith("/") and p != "/" and d.startswith(p) for p in pats)


MISSING_MARK_RE = re.compile(r"No such file|FileNotFoundError|ENOENT|[Cc]an'?not (?:open|find|read)|[Cc]an't (?:open|find|read)|"
                             r"[Uu]nable to (?:open|find)|does not exist|not found|[Mm]issing (?:file|source)")


def missing_src(wt, out):
    """repo paths an output names that exist in the gate tree's commit but are absent from its sparse checkout"""
    out = "\n".join(l for l in (out or "").splitlines() if MISSING_MARK_RE.search(l))
    if not out:
        return []
    try:
        cand = {m.group(1) for m in _path_lit_re(rev("HEAD", cwd=wt) or "HEAD", quoted=False).finditer(out or "")}
    except Exception:                                  # noqa: BLE001 - detection only
        return []
    cand = {c.rstrip(".") for c in cand}
    have = _tree_types("HEAD", cand, cwd=wt)
    return sorted(x for x in have if not (wt / x).exists())


def gate(it, wt, base):
    """compile + tests of the candidate at wt HEAD against base -> it updated with result"""
    tip = rev("HEAD", cwd=wt)
    ch = changed_files(wt, base, tip)
    it["changed"] = ch
    bad = static_check(wt, ch)
    if bad:
        return "RED", f"static check: {'; '.join(bad[:6])}"
    alltests = all_test_files(wt)
    tests, why = select_tests(ch, alltests, lambda t: (wt / t).read_text(errors="replace"))
    it["tests"] = tests
    if not tests:
        return "GREEN", f"no tests select for {len(ch)} changed file(s); static check only"
    pats = list(SPARSE) + ["/" + d.strip("/") + "/" for d in it.get("extra", ())]
    need = sorted(d for d in test_deps(wt, base, tests) if not _covered(d, pats))
    if need:
        git("sparse-checkout", "add", *["/" + d + "/" for d in need], cwd=wt, timeout=1800)
        it["extra"] = sorted(set(it.get("extra", ())) | set(need))      # the main baseline tree gets the same dirs
        it["deps"] = need
    fails, infra, tails = run_tests(wt, tests, it["id"])
    miss = sorted({f for f in fails if f.startswith("MISSING-SOURCE:")})
    for rnd in range(MISS_ROUNDS + 1):
        if not miss:
            break
        # paths built at run time (no literal to scan): add the dirs the run reported missing and run again.  Each round can
        # expose the next include (drt0255 15:4x: rtl/dsrom_sys, then rtl/hdc, rtl/v41rom ...); the last round adds the whole
        # top-level dir when it is in WHOLE_TOPS (rtl/ ~0.9 GB; never physical/, 33 GB)
        paths = {x for m in miss for x in m.split(":", 1)[1].split()}
        if rnd < MISS_ROUNDS:
            got = sorted({os.path.dirname(x) for x in paths} - {""})
        else:
            got = sorted({x.split("/")[0] for x in paths} & set(WHOLE_TOPS))
        got = [d for d in got if not _covered(d, pats + ["/" + x + "/" for x in need])]
        if not got:
            break
        git("sparse-checkout", "add", *["/" + d + "/" for d in got], cwd=wt, timeout=1800)
        need = sorted(set(need) | set(got))
        it["extra"] = sorted(set(it.get("extra", ())) | set(got))
        it["deps"] = need
        fails, infra, tails = run_tests(wt, tests, f"{it['id']}-m{rnd}")
        miss = sorted({f for f in fails if f.startswith("MISSING-SOURCE:")})
    if miss:
        return "INFRA", (f"MISSING SOURCE in the gate's sparse tree (queue defect, not the branch): "
                         f"{' '.join(m.split(':', 1)[1] for m in miss)[:300]}")
    if infra and not fails:
        return "INFRA", f"pytest rc {infra}: {' / '.join(tails)[:300]}"
    base_f = baseline(base, fails, it.get("extra", ()), it["id"])
    wt_drop(f"base-{base[:12]}-{it['id']}")
    new = sorted(fails - base_f)
    flaky = []
    if new:
        # 11-14 20:4x: under parallel items x xdist, order / load dependent tests fail on the branch and pass on the main rerun
        # (form_wait_arm, test_m8_grant env, clock tests with 5 items in flight).  A new failure counts only when it also fails
        # when the branch reruns it on its own, one file per process, no xdist.
        still = rerun_serial(wt, new, it["id"])
        flaky = [f for f in new if f not in still]
        new = [f for f in new if f in still]
    tos = [f for f in new if f.startswith("TIMEOUT")]
    if tos:
        # FABLE-FLOW-1000 class 7: a fleet test file that hit its timeout under parallel load (epyc2-scratch3 08:59, 600 s;
        # the same file ran in <10 s alone) is rerun once alone; only a second timeout, or a failure main does not have, is RED
        new = [f for f in new if not f.startswith("TIMEOUT")]
        for t in tos:
            files = t.split(":", 1)[1].split()
            if not files or not all((wt / f).is_file() for f in files):
                new.append(t)
                continue
            rc, fl, _tail = pytest(wt, files, f"{it['id']}-t", 1)
            if rc == 124:
                new.append(t)
                continue
            fl = {f for f in fl if f not in base_f}
            if fl:
                bt = baseline(base, fl, it.get("extra", ()), it["id"] + "-t")
                wt_drop(f"base-{base[:12]}-{it['id']}-t")
                base_f |= bt
                fl -= bt
            new += sorted(fl)
            flaky.append(t)
    known_red(base_f, base)
    if new:
        return "RED", (f"{len(new)} new failure(s) (not failing on main {base[:11]}; still failing on a serial rerun of the branch): "
                       f"{', '.join(new[:8])}" + (f"; {len(flaky)} more passed on the serial rerun (flaky)" if flaky else ""))
    note = f"{len(tests)} test file(s) pass" + (f" (+{len(it['deps'])} source dir(s) the tests name: {' '.join(it['deps'][:4])})"
                                                if it.get("deps") else "") + (f" ({len(base_f)} failure(s) also fail on main: baseline)" if base_f else "") + \
        (f" ({len(flaky)} order/load-flaky failure(s) passed on a serial rerun: {', '.join(flaky[:4])})" if flaky else "")
    return "GREEN", note


def known_red(fails, base):
    """FABLE-FLOW-1000 class 7: every failure a gate found red on main too goes to ~/merge-queue/known-red.json (first/last
    seen, main sha, count).  FLOW-HEALTH-1 drives it to zero; `ot-merge-queue known-red` lists what failed in the last 24 h."""
    if DRY or not fails:
        return
    with _LOCK:
        p = MQ / "known-red.json"
        try:
            kr = json.loads(p.read_text())
        except (OSError, ValueError):
            kr = {}
        t = now().strftime("%Y-%m-%d %H:%M")
        for f in fails:
            e = kr.setdefault(f, {"first": t, "n": 0})
            e.update(last=t, main=base[:11], n=e.get("n", 0) + 1)
        tmp = p.with_suffix(".tmp")
        tmp.write_text(json.dumps(kr, indent=1, sort_keys=True))
        os.replace(tmp, p)


def known_red_cmd(hours=24):
    try:
        kr = json.loads((MQ / "known-red.json").read_text())
    except (OSError, ValueError):
        kr = {}
    cut = (now() - datetime.timedelta(hours=hours)).strftime("%Y-%m-%d %H:%M")
    live = {k: v for k, v in kr.items() if v.get("last", "") >= cut}
    for k, v in sorted(live.items()):
        print(f"{v['last']}  main {v.get('main', '-')}  x{v.get('n', 0):<3} {k}")
    print(f"{len(live)} test(s) red on main in the last {hours} h (known-red baseline; FLOW-HEALTH-1 drives it to 0)")
    return 0


def gate_cmd(spec):
    """`ot-merge-queue gate <branch>[@<sha>]`: the queue's OWN gate (same test selection, baseline, serial rerun) on current
    GitHub origin/main; prints the READY stamp.  FABLE-FLOW-1000 class 7: lanes ran their touched files only, the queue ran
    up to 140 files, so 40 READYs went MERGE-FAIL on 11-15.  One gate at a time (flock); nothing is pushed or posted."""
    branch, _, sha = spec.partition("@")
    MQ.mkdir(parents=True, exist_ok=True)
    slots = [open(MQ / f"gate-cmd.{i}.lock", "w") for i in range(max(1, GATE_PAR))]
    got = None
    while got is None:                                   # first free slot; GATE_PAR gates run at once, the rest wait
        for f in slots:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                got = f
                break
            except OSError:
                continue
        else:
            time.sleep(5)
    base = fetch_main()
    if not sha:
        with CLONE_LOCK():
            git("fetch", "-q", "--no-tags", REMOTE, f"+refs/heads/{branch}:refs/mq/{REMOTE}/{branch}", check=False, timeout=300)
        sha = rev(f"refs/mq/{REMOTE}/{branch}")
        if not sha:
            print(f"branch {branch} not on {REMOTE} (push it to the lane mirror first: ot-lane-clone)")
            return 2
    it = {"key": f"{branch}@{sha[:11]}", "branch": branch, "sha": sha, "id": f"gc-{sha[:10]}"}
    try:
        res, note = prepare(it, base)
    finally:
        wt_drop(it["id"])
    if res == "GREEN":
        n = max(1, len(it.get("tests", [])))
        stamp_ = f"GATE main={base[:11]} pass={n}/{n}"
        rec = MQ / "gates"
        rec.mkdir(exist_ok=True)
        (rec / f"{it['sha_full']}.json").write_text(json.dumps(dict(main=base, branch=branch, tests=it.get("tests", []),
                                                                    note=note, at=stamp()), indent=1))
        print(f"GREEN {it['key']}: {note}\n{stamp_}")
        return 0
    print(f"{res} {it['key']} on main {base[:11]}: {note}")
    return 1


def rerun_serial(wt, ids, tag):
    """the failures that still fail when rerun on the candidate alone: per test file, no xdist -> set"""
    still = set()
    for f in sorted({i.split("::")[0] for i in ids if not i.startswith("TIMEOUT")}):
        if not (wt / f).is_file():
            still |= {i for i in ids if i.split("::")[0] == f}
            continue
        sel = [i for i in ids if i.split("::")[0] == f]
        rc, fl, _tail = pytest(wt, sel, f"{tag}-s{abs(hash(f)) % 10000}", 1)
        if rc not in (0, 1, 5):                               # collection / infra error: keep them as failures
            still |= set(sel)
            continue
        still |= {i for i in sel if i in fl or i.split("::")[0] in fl}
    still |= {i for i in ids if i.startswith("TIMEOUT")}
    return still


