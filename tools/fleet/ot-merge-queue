class _ClonePLock:
    """process-wide lock on the queue clone for the short ref / worktree writes (fetch, worktree add/remove): the tick and
    several `gate` commands share one clone; two fetches into one ref fail with 'cannot lock ref'"""

    def __enter__(self):
        MQ.mkdir(parents=True, exist_ok=True)
        self.f = open(MQ / "clone.lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


