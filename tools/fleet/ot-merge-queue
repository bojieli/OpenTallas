class GitError(RuntimeError):
    pass


def run(cmd, cwd=None, timeout=600, env=None, check=False):
    try:
        p = S.run(cmd, cwd=str(cwd) if cwd else None, capture_output=True, text=True, timeout=timeout, env=env,
                  stdin=S.DEVNULL)    # KV-PVGEN 11-15: yosys under an open stdin pipe idles until the 2400 s timeout
    except S.TimeoutExpired as e:
        p = S.CompletedProcess(cmd, 124, e.stdout or "", (e.stderr or "") if isinstance(e.stderr, str) else "timeout")
        if isinstance(p.stdout, bytes):
            p.stdout = p.stdout.decode(errors="replace")
    if check and p.returncode:
        raise GitError(f"{' '.join(map(str, cmd))[:200]} rc={p.returncode}: {(p.stderr or p.stdout).strip()[:400]}")
    return p


def git(*a, cwd=REPO, check=True, timeout=600, env=None):
    return run(["git", *a], cwd=cwd, timeout=timeout, check=check, env=env)


def rev(ref, cwd=REPO):
    # MQ-PACK-FIX 11-16: a sha that is not in the object store must fail fast: no lazy fetch (partial clone), and the
    # lookup then costs one midx probe, not a scan of every pack index.
    p = git("rev-parse", "-q", "--verify", f"{ref}^{{commit}}", cwd=cwd, check=False, env=dict(os.environ, GIT_NO_LAZY_FETCH="1"))
    return p.stdout.strip() if p.returncode == 0 else ""


PACK_LIMIT = int(os.environ.get("MQ_PACK_LIMIT", "200"))       # packs before the guard consolidates
PACK_REPACK = int(os.environ.get("MQ_PACK_REPACK", "2000"))    # packs before it also repacks geometrically


def pack_count(repo=REPO):
    try:
        return sum(1 for n in os.listdir(Path(repo) / ".git" / "objects" / "pack") if n.endswith(".pack"))
    except OSError:
        return 0


def live_pack_processes(repo, proc=Path("/proc")):
    # Preserve an inherited progressing repack; a second pack would duplicate
    # its working set and write load. Match the repository and exact executable.
    found = []
    wanted = Path(repo).resolve()
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if (entry / "cwd").resolve() != wanted:
                continue
            args = (entry / "cmdline").read_bytes().split(b"\0")
            exe = Path(os.fsdecode(args[0])).name
            if exe == "git" and len(args) > 1 and args[1] == b"repack" or exe == "pack-objects":
                found.append(int(entry.name))
        except (OSError, ValueError):
            continue
    return sorted(found)


def pack_guard(repo=REPO):
    """MQ-PACK-FIX 11-16: lazy blob fetches leave one pack each (105k files once); keep the count bounded after every tick.
    multi-pack-index write makes object lookup one probe; above PACK_REPACK a geometric repack merges the small packs.
    Never gc/prune; a failure only logs."""
    if DRY:
        return 0
    n = pack_count(repo)
    if n <= PACK_LIMIT:
        return n
    active = live_pack_processes(repo)
    if active:
        log(f"pack guard: defer to progressing pack process(es) {active}")
        return n
    try:
        if n > PACK_REPACK:
            r = git("repack", "-d", "-q", "--geometric=2", "--write-midx", cwd=repo, check=False, timeout=None)
            log(f"pack guard: {n} packs, geometric repack rc={r.returncode} -> {pack_count(repo)} packs")
        r = git("multi-pack-index", "write", cwd=repo, check=False, timeout=900)
        log(f"pack guard: {n} packs, multi-pack-index write rc={r.returncode}")
    except Exception as e:                                  # noqa: BLE001 - maintenance never stops the train
        log(f"pack guard error: {e}")
    return pack_count(repo)


