#!/bin/bash
# ot-copy-reaper-hub (COPY-REAPER-1119): from the hub, on every build host that has more than REAP_OVER rsync processes, run tools/fleet/rsync_reaper.sh there.
# Per-host backoff when ssh fails (state ~/.local/state/copy-reaper/<host>: 5, 10, 20, 30 min).  No LLM: a systemd timer drives it.
RT=/srv/opentallas-scratch2/claude/rt/current; ST=$HOME/.local/state/copy-reaper; mkdir -p $ST
REAP_OVER=${REAP_OVER:-60}; HOSTS=${REAP_HOSTS:-"intel1 epyc2 epyc7 epyc8 epyc9 epyc10"}
now=$(date +%s)
for h in $HOSTS; do
  ( f=$ST/$h; nxt=0; fl=0; [ -f $f ] && read nxt fl < $f
    [ "$now" -lt "${nxt:-0}" ] && { echo "$h: backoff until $nxt"; exit 0; }
    n=$(timeout 90 ssh -n -o BatchMode=yes -o ConnectTimeout=30 $h 'pgrep -xc rsync' 2>/dev/null)
    if [ -z "$n" ]; then fl=$(( ${fl:-0} + 1 )); w=$(( 300 * (fl>6?6:fl) )); echo "$((now+w)) $fl" > $f; echo "$h: unreachable (fail $fl), next try in $((w/60)) min"; exit 0; fi
    echo "0 0" > $f
    if [ "$n" -gt "$REAP_OVER" ]; then echo "$h: $n rsync processes, reaping"; timeout 1500 ssh -n -o BatchMode=yes -o ConnectTimeout=30 $h "nice -n 5 bash $RT/tools/fleet/rsync_reaper.sh"; ssh -n -o ConnectTimeout=30 $h 'tail -2 /tmp/flops_reap7.log' 2>/dev/null; else echo "$h: $n rsync processes, ok"; fi ) &
done
wait
