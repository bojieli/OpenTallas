NAMES_PY = r'''
def top_names(code, rel):
    """top-level defs/classes (.py) or proc names (.tcl); None = cannot judge"""
    import ast, re
    if rel.endswith(".tcl"):
        return set(re.findall(rb"^\s*proc\s+(\S+)", code, re.M))
    if not rel.endswith(".py"):
        return None
    try:
        t = ast.parse(code)
    except SyntaxError:
        return None
    return {n.name for n in t.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))}
def mod_names(code):
    """every name a module binds anywhere (defs, classes, assignments, imports, globals); None = dynamic (star import, __getattr__)"""
    import ast
    try:
        t = ast.parse(code)
    except SyntaxError:
        return None
    out, star = set(), False
    for n in ast.walk(t):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            out.add(n.name)
        elif isinstance(n, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
            for tg in (n.targets if isinstance(n, ast.Assign) else [n.target]):
                out |= {x.id for x in ast.walk(tg) if isinstance(x, ast.Name)}
        elif isinstance(n, ast.Import):
            out |= {(a.asname or a.name).split(".")[0] for a in n.names}
        elif isinstance(n, ast.ImportFrom):
            star = star or any(a.name == "*" for a in n.names)
            out |= {a.asname or a.name for a in n.names if a.name != "*"}
        elif isinstance(n, ast.Global):
            out |= set(n.names)
    return None if star or "__getattr__" in out else out
'''

