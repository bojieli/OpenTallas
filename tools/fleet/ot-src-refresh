def main_names(rev):
    """{module: [names]} of main's tools/die_plan + tools top-level modules (the smoke's attribute reference)"""
    tb = tree_blobs(rev)
    prefetch(tb.values())
    files = [p for p in tb
             if p.endswith(".py") and in_scope(p) and p.count("/") == (2 if p.startswith("tools/die_plan/") else 1)]
    got = read_blobs([tb[p] for p in files])
    out = {}
    for d in ("tools/die_plan/", "tools/"):
        for p in files:
            m = p[len(d):-3]
            if p.startswith(d) and "/" not in p[len(d):] and m not in out:
                nm = mod_names(got.get(tb[p]) or b"")
                if nm is not None:
                    out[m] = sorted(nm)
    return out


def _cmd(host, py):
    if host in LOCAL_HOSTS:
        return [sys.executable, "-I", "-c", py]
    return shlex.split(SSH) + [host, "python3", "-I", "-c", shlex.quote(py)]


def _root(host, path):
