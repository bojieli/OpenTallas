def git(*a, check=True, binary=False):
    p = S.run(["git", *a], cwd=str(REPO), capture_output=True, timeout=600)
    if check and p.returncode:
        raise RuntimeError(f"git {' '.join(a)[:160]}: {p.stderr.decode(errors='replace').strip()[:300]}")
    return p.stdout if binary else p.stdout.decode(errors="replace")


def in_scope(p):
    if not p.startswith(SCOPE) or p.startswith(EXCLUDE):
        return False
    b = os.path.basename(p)
    return not (b.startswith("test_") or "/tests/" in p or b.endswith((".pyc",)))


_BLOBS = {}


def read_blobs(oids):
    """{oid: bytes} through ONE git cat-file --batch (a git show per file costs ~1 s in this repo: main_names took 35+ min)"""
    want = sorted({o for o in oids if o and o not in _BLOBS})
    if want:
        p = S.run(["git", "cat-file", "--batch"], cwd=str(REPO), input=("\n".join(want) + "\n").encode(),
                  capture_output=True, timeout=1800)
        buf, i = p.stdout, 0
        while i < len(buf):
            j = buf.index(b"\n", i)
            head = buf[i:j].split()
            i = j + 1
            if len(head) < 3 or head[1] == b"missing":
                continue
            n = int(head[2])
            _BLOBS[head[0].decode()] = buf[i:i + n]
            i += n + 1
    return {o: _BLOBS.get(o) for o in oids if o}


def blob_at(rev, path):
    if path is None and rev in _BLOBS:
        return _BLOBS[rev]
    p = S.run(["git", "show", f"{rev}:{path}" if path else rev], cwd=str(REPO), capture_output=True, timeout=300)
    return p.stdout if p.returncode == 0 else None


def history_blobs(paths, since="2026-10-01"):
    """path -> set of blob ids main had for it (to call a tree copy 'an earlier main version')"""
    out = {}
    if not paths:
        return out
    txt = git("log", f"{REMOTE}/main", f"--since={since}", "--raw", "--no-abbrev", "--format=", "--", *paths, check=False)
    for line in txt.splitlines():
        f = line.split()
        if len(f) >= 6 and line.startswith(":"):
            out.setdefault(f[5], set()).add(f[3])
    return out


def prefetch(oids):
    """fetch every missing blob of a partial clone in ONE request (a lazy git show fetches one blob per round trip: the
    11-15 dry runs timed out after 20-50 min on that)"""
    oids = sorted({o for o in oids if o})
    if not oids:
        return 0
    env = dict(os.environ, GIT_NO_LAZY_FETCH="1")
    p = S.run(["git", "cat-file", "--batch-check"], cwd=str(REPO), input="\n".join(oids) + "\n", capture_output=True,
              text=True, env=env, timeout=600)
    miss = [l.split()[0] for l in p.stdout.splitlines() if l.endswith(" missing")]
    for i in range(0, len(miss), 2000):
        S.run(["git", "-c", "fetch.negotiationAlgorithm=noop", "fetch", "-q", "--no-tags", "--no-write-fetch-head",
               "--filter=blob:none", REMOTE, *miss[i:i + 2000]], cwd=str(REPO), capture_output=True, timeout=1800)
    return len(miss)


def tree_blobs(rev, paths=("tools",)):
    """{path: blob id} at rev under paths"""
    out = {}
    for line in git("ls-tree", "-r", rev, "--", *paths, check=False).splitlines():
        meta, _, path = line.partition("\t")
        f = meta.split()
        if len(f) == 3 and f[1] == "blob":
            out[path] = f[2]
    return out


def _numstat(a, b):
    import tempfile
    with tempfile.TemporaryDirectory() as td:
        x, y = os.path.join(td, "x"), os.path.join(td, "y")
        open(x, "wb").write(a); open(y, "wb").write(b)
        o = S.run(["git", "diff", "--no-index", "--numstat", x, y], capture_output=True, text=True).stdout.split()
    return int(o[0]) + int(o[1]) if len(o) >= 2 and o[0].isdigit() else (0 if a == b else 10 ** 9)


def closest_bases(host, src, paths, hist):
    """{path: base bytes}: for each tree copy that is a LOCAL edit (no main version equals it), the main version (from
    hist) closest to it.  06:00 11-15 the merge base was the last daily sha; the KV schema.py lane copy predates it, so
    everything main added before that sha read as a local deletion and the clean merge dropped full_area_hard_ip."""
    code = ("import base64, json, os\nsrc = %r\nout = {}\nfor r in %r:\n    p = os.path.join(src, r)\n"
            "    out[r] = base64.b64encode(open(p, 'rb').read()).decode() if os.path.isfile(p) else None\nprint(json.dumps(out))\n"
            % (_root(host, src), list(paths)))
    p = S.run(_cmd(host, code), capture_output=True, text=True, timeout=600)
    try:
        got = json.loads(p.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {}
    out = {}
    for r, v in got.items():
        if v is None or not hist.get(r):
            continue
        have = base64.b64decode(v)
        cands = sorted(hist[r])
        if any(bid_local(have) == c for c in cands):
            continue                                     # an earlier main version: REPLACE, no merge needed
        read_blobs(cands[-MAX_HIST:])
        best = None
        for c in cands[-MAX_HIST:]:
            b = blob_at(c, None)
            if b is None:
                continue
            d = _numstat(b, have)
            if best is None or d < best[0]:
                best = (d, b)
        if best:
            out[r] = best[1]
    return out


def bid_local(b):
    return hashlib.sha1(b"blob %d\0" % len(b) + b).hexdigest()


def targets(cfg):
    """[(die, host, src)] of enabled dies + their item_inputs trees, de-duplicated by (host, src)"""
    seen, out = set(), []
    for die, d in sorted((cfg.get("dies") or {}).items()):
        if not isinstance(d, dict) or not d.get("enabled") or not d.get("gen_host"):
            continue
        srcs = [d.get("src")] + [v.get("src") for v in (d.get("item_inputs") or {}).values() if isinstance(v, dict)]
        for s in srcs:
            if s and str(s).startswith("/") and (d["gen_host"], s) not in seen:
                seen.add((d["gen_host"], s))
                out.append((die, d["gen_host"], str(s)))
    return out


