def manifest(host, src, overlay="", files_under=()):
    job = {"src": _root(host, src), "overlay": _root(host, overlay) if overlay else "", "roots": list(MAN_ROOTS),
           "skip_dirs": list(MAN_SKIP_DIRS), "skip_files": list(MAN_SKIP_FILES), "files_under": list(files_under)}
    p = S.run(_cmd(host, MANIFEST_PY), input=json.dumps(job), capture_output=True, text=True, timeout=3600)
    try:
        return json.loads(p.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"error": f"rc={p.returncode} {(p.stderr or p.stdout).strip()[-200:]}"}


def compare(hosts, src, overlay=""):
    """-> (problems, diffs) diffs = {rel: {host: (sha1|None, mtime)}} where the hosts' trees differ (hosts[0] = reference)"""
    man, problems = {}, []
    for h in hosts:
        m = manifest(h, src, overlay)
        if "error" in m:
            problems.append(f"{h}: manifest {m['error']}")
        else:
            man[h] = m
    if len(man) < 2 or len({m["digest"] for m in man.values()}) == 1:
        return problems, {}
    keys = set().union(*(m["dirs"] for m in man.values()))
    bad = sorted(k for k in keys if len({m["dirs"].get(k) for m in man.values()}) > 1)
    full = {h: manifest(h, src, overlay, files_under=bad) for h in man}
    diffs = {}
    for r in sorted(set().union(*(f.get("files", {}) for f in full.values()))):
        v = {h: tuple(full[h].get("files", {}).get(r, (None, 0))) for h in full}
        if len({x[0] for x in v.values()}) > 1:
            diffs[r] = v
    return problems, diffs


def fmt_diffs(diffs, ref, n=12):
    out = []
    for r, v in list(diffs.items())[:n]:
        newest = max(v, key=lambda h: v[h][1])
        odd = [h for h in v if v[h][0] != v[ref][0]]
        out.append(f"{r} (differs on {','.join(odd)} vs {ref}; newest {newest} "
                   f"{datetime.datetime.fromtimestamp(v[newest][1]).strftime('%m-%d %H:%M') if v[newest][1] else '-'})")
    return out + ([f"... +{len(diffs) - n} more"] if len(diffs) > n else [])


def _imports(code):
    """top-level module names a .py imports (absolute imports only), as the smoke reads them"""
    import ast
    try:
        t = ast.parse(code)
    except SyntaxError:
        return set()
    out = set()
    for n in ast.walk(t):
        if isinstance(n, ast.Import):
            out |= {a.name.split(".")[0] for a in n.names}
        elif isinstance(n, ast.ImportFrom) and n.module and not n.level:
            out.add(n.module.split(".")[0])
    return out


def missing_deps(host, src, paths, new):
    """in-scope main modules that the batch's .py files import (transitively) but the host's tree lacks -> add them (ADD).
    03:46 11-15 dry run: main bind.py / kit_istations.py import bind_strict_src, native_source_banks, split_bind_routes,
    split_source_guard, all on main before the last daily base but never copied into the die trees; changed-since-base alone
    staged an importer without its module and the smoke stopped every die."""
    files = [p for p in git("ls-tree", "-r", "--name-only", new, "--", "tools").split("\n") if p.endswith(".py") and in_scope(p)]
    mod = {}
    for d in ("tools/die_plan/", "tools/"):          # the smoke's (and gen's) path order: tools/die_plan first
        for p in files:
            if p.startswith(d) and "/" not in p[len(d):]:
                mod.setdefault(p[len(d):-3], p)
    have, seen, out = set(paths), set(paths), []
    level = [p for p in paths if p.endswith(".py")]
    while level:
        cand = []
        for p in level:
            b = blob_at(new, p)
            for m in _imports(b or b""):
                r = mod.get(m)
                if r and r not in seen:
                    seen.add(r); cand.append(r)
        if not cand:
            break
        q = "import json, os, sys; print(json.dumps([r for r in %r if not os.path.exists(os.path.join(%r, r))]))" % (cand, _root(host, src))
        pr = S.run(_cmd(host, q), capture_output=True, text=True, timeout=300)
        try:
            miss = json.loads(pr.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            miss = []
        out += [r for r in miss if r not in have]
        level = miss
    return out


