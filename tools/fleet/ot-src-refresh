def die_hosts(cfg, die):
    d = cfg["dies"][die]
    g = d["gen_host"]
    return g, [h for h in dict.fromkeys(d.get("gen_hosts") or []) if h and h != g]


def daily(new, apply_, only):
    """the 06:00 batch (see the module doc)"""
    cfg = json.loads(CFG.read_text())
    lastf = MQ / "src-refresh-last.json"
    try:
        last = json.loads(lastf.read_text())
    except (OSError, ValueError):
        last = {}
    new = git("rev-parse", new).strip()
    stamp = now().strftime("%Y%m%d-%H%M%S")
    out_lines, rows = [], []
    mnames = main_names(new)
    for die in sorted(cfg.get("dies") or {}):
        d = cfg["dies"][die]
        if (only and die not in only) or not isinstance(d, dict) or not d.get("enabled") or not d.get("src"):
            continue
        old = last.get(die)
        if not old:
            out_lines.append(f"{die}: no last good sha in {lastf.name}; set it once (catch-up first), skipped")
            continue
        if old == new:
            continue
        paths = changed(old, new)
        if not paths:
            last[die] = new
            continue
        src, (gen, reps) = d["src"], die_hosts(cfg, die)
        deps = missing_deps(gen, src, paths, new)
        if deps:
            paths = paths + deps
            out_lines.append(f"{die}: + {len(deps)} module(s) the batch imports, missing in the tree, added from main: {', '.join(deps[:12])}")
        hosts = [gen] + [h for h in reps if "error" not in run_remote(h, {"src": src, "apply": False, "mode": "dry", "stamp": stamp,
                                                                            "to": new, "files": []})]
        # 0. the replicas must already be identical (tools/ + physical/): a lane that copied a file to some of them shows here
        pb, diffs = compare(hosts, src)
        hd = {r: v for r, v in diffs.items() if hard(r)}
        if pb or hd:
            out_lines.append(f"{die}: REPLICA DRIFT before the refresh, nothing staged ({len(hd)} code file(s); {'; '.join(pb)}): "
                             + "; ".join(fmt_diffs(hd, gen)))
            continue
        if diffs:
            out_lines.append(f"{die}: note {len(diffs)} plan/data file(s) under physical/ differ across copies (flagged, not blocking): "
                             + "; ".join(fmt_diffs(diffs, gen, 4)))
        # 1. stage on the gen host (merge), then the gen host's exact result staged on every replica
        hist = history_blobs(paths)
        prefetch([b for p in paths for b in hist.get(p, ())] + [tree_blobs(new, paths).get(p) for p in paths])
        jobs = file_jobs(paths, old, new, hist)
        cb = closest_bases(gen, src, paths, hist)
        for j in jobs:
            if j["path"] in cb:
                j["base"] = base64.b64encode(cb[j["path"]]).decode()
        st = run_remote(gen, {"src": src, "apply": False, "mode": "stage", "stamp": stamp, "to": new, "files": jobs, "want_out": True})
        if "error" in st:
            out_lines.append(f"{die}: gen host {gen} ERROR {st['error']}"); continue
        todo = [r for r in st["results"] if r.get("staged")]
        held = [f"{r['path']} {r['status']}" for r in st["results"] if r["status"] in ("CONFLICT", "BUSY", "LOCAL", "ERROR", "UNREADABLE")]
        dropped = [f"{r['path']} ({r.get('note', '')})" for r in st["results"] if "would drop" in r.get("note", "")]
        if dropped:
            out_lines.append(f"{die}: CONFLICT kept (the merge would drop main code; the die lane merges these): " + "; ".join(dropped[:10]))
        gjobs = [{"path": r["path"], "new": r["out"], "base": r.get("have"), "hist": []} for r in todo]
        ovl = f"{src}/.mq-stage/{stamp}"
        for h in hosts[1:]:
            run_remote(h, {"src": src, "apply": False, "mode": "stage", "stamp": stamp, "to": new, "files": gjobs})

        def unstage():
            for h in hosts:
                S.run(_cmd(h, f"import shutil; shutil.rmtree({_root(h, ovl)!r}, ignore_errors=True)"), capture_output=True, timeout=300)
        # 2. every host's tree + its stage must hash identical, then the staged smoke on every host
        pb, diffs = compare(hosts, src, overlay=ovl)
        diffs = {r: v for r, v in diffs.items() if hard(r)}
        bad = pb + ([f"staged trees differ: {'; '.join(fmt_diffs(diffs, gen))}"] if diffs else [])
        if not bad:
            for h in hosts:
                b = smoke(h, src, [r["path"] for r in todo], overlay=ovl, mnames=mnames)
                if b:
                    bad.append(f"{h}: {'; '.join(b)[:400]}"); break
        unstage()
        if bad:
            out_lines.append(f"{die}: STAGED CHECK FAILED, nothing swapped: {' | '.join(bad)[:700]}")
            continue
        if not apply_:
            out_lines.append(f"{die}: dry {len(todo)} file(s) would change on {len(hosts)} host(s), identical + staged smoke ok; held {held[:8]}")
            continue
        # 3. swap on every host (one step, copy+mv, backups), verify identical, smoke each; any failure -> roll back all hosts
        hosts_done, fail = [], []
        for h in hosts:
            rr = run_remote(h, {"src": src, "apply": True, "mode": "apply", "stamp": stamp, "to": new, "files": gjobs})
            hosts_done.append(h)
            if "error" in rr:
                fail.append(f"{h}: {rr['error']}"); break
            for r in rr["results"]:
                rows.append([stamp, "daily", die, h, src, r["path"], r["status"], r.get("note", ""), "applied" if r.get("written") else ""])
        if not fail:
            pb, diffs = compare(hosts, src)
            diffs = {r: v for r, v in diffs.items() if hard(r)}
            fail += pb + ([f"trees differ after swap: {'; '.join(fmt_diffs(diffs, gen))}"] if diffs else [])
        if not fail:
            for h in hosts:
                b = smoke(h, src, [j["path"] for j in gjobs], mnames=mnames)
                if b:
                    fail.append(f"{h}: {'; '.join(b)[:400]}"); break
        if fail:
            for h in hosts_done:
                run_remote(h, {"src": src, "apply": True, "mode": "rollback", "stamp": stamp, "to": new, "files": []})
            out_lines.append(f"{die}: CHECK FAILED after swap ({' | '.join(fail)[:600]}); ROLLED BACK on {', '.join(hosts_done)}")
            continue
        last[die] = new
        cnt = {}
        for r in todo:
            cnt[r["status"]] = cnt.get(r["status"], 0) + 1
        out_lines.append(f"{die}: {old[:11]}..{new[:11]} on {len(hosts)} host(s), identical after swap: "
                         + " ".join(f"{k}={v}" for k, v in sorted(cnt.items())) + (f"; kept {held[:10]}" if held else ""))
    MQ.mkdir(parents=True, exist_ok=True)
    if apply_:
        with open(MQ / "src-refresh.tsv", "a") as f:
            for r in rows:
                f.write("\t".join(map(str, r)) + "\n")
        t = lastf.with_suffix(".tmp"); t.write_text(json.dumps(last, indent=1, sort_keys=True)); os.replace(t, lastf)
    for l in out_lines:
        log(f"DAILY {'APPLY' if apply_ else 'DRY'} {l}")
    if apply_ and out_lines:
        post("STATE" if not any("FAILED" in l or "ERROR" in l for l in out_lines) else "RESULT",
             f"daily die-tree refresh to main {new[:11]} (stamp {stamp}): " + " ;; ".join(out_lines))
    return out_lines


def drift(only, post_new):
    """flag replica skew: per die, files whose content differs between the gen_hosts copies (tools/ + physical/)"""
    cfg = json.loads(CFG.read_text())
    sf = MQ / "src-drift-flagged.json"
    try:
        seen = json.loads(sf.read_text())
    except (OSError, ValueError):
        seen = {}
    lines, now_seen = [], {}
    for die in sorted(cfg.get("dies") or {}):
        d = cfg["dies"][die]
        if (only and die not in only) or not isinstance(d, dict) or not d.get("enabled") or not d.get("src"):
            continue
        gen, reps = die_hosts(cfg, die)
        pb, diffs = compare([gen] + reps, d["src"])
        now_seen[die] = sorted(diffs)
        hd = {r: v for r, v in diffs.items() if hard(r)}
        fresh = [r for r in hd if r not in set(seen.get(die, []))]
        if pb:
            lines.append(f"{die}: {'; '.join(pb)}")
        if hd:
            lines.append(f"{die}: {len(hd)} CODE file(s) differ across {len(reps) + 1} copies ({len(fresh)} new): "
                         + "; ".join(fmt_diffs({r: hd[r] for r in (fresh or hd)}, gen)))
        if len(diffs) > len(hd):
            lines.append(f"{die}: {len(diffs) - len(hd)} plan/data file(s) under physical/ differ (flag only)")
    MQ.mkdir(parents=True, exist_ok=True)
    t = sf.with_suffix(".tmp"); t.write_text(json.dumps(now_seen, indent=1)); os.replace(t, sf)
    for l in lines:
        log(f"DRIFT {l}")
    if post_new and any("CODE file(s)" in l and "(0 new)" not in l for l in lines):
        post("STATE", "REPLICA DRIFT (a file copied to only some of a die's gen_hosts copies; the wave gens on any of them). "
             "Copy to all copies with: ot-src-refresh put --die <die> <path>...  " + " ;; ".join(lines))
    return lines


def put(die, rels, apply_, from_main=False):
    """the sanctioned way to change a die tree by hand: copy files from the gen host's tree to EVERY gen_hosts copy, then verify.
    put never reads main unless --from-main: it syncs the gen host's copy (05:22 11-15 KIT-OPS-5 ran put for a KV gen_phys.py
    271 lines behind main; gen host and replicas were identical, so every copy said SAME). Each run now reports the gen host
    copy against main; --from-main writes main's version to the gen host AND every replica (backups, copy+mv)."""
    cfg = json.loads(CFG.read_text())
    d = cfg["dies"][die]
    gen, reps = die_hosts(cfg, die)
    stamp = now().strftime("%Y%m%d-%H%M%S")
    git("fetch", "-q", REMOTE, "main", check=False)
    mref = f"{REMOTE}/main"
    msha = git("rev-parse", mref).strip()
    mainb = {r: blob_at(msha, r) for r in rels}
    code = ("import base64, json, os, sys\nsrc = %r\nout = {}\nfor r in %r:\n    p = os.path.join(src, r)\n"
            "    out[r] = base64.b64encode(open(p, 'rb').read()).decode() if os.path.isfile(p) else None\nprint(json.dumps(out))\n"
            % (_root(gen, d["src"]), list(rels)))
    p = S.run(_cmd(gen, code), capture_output=True, text=True, timeout=600)
    got = json.loads(p.stdout.strip().splitlines()[-1])
    lines = []
    for r in rels:
        g, m = got.get(r), mainb.get(r)
        gb = base64.b64decode(g) if g is not None else None
        if m is None:
            st = "not on main"
        elif gb is None:
            st = "missing in the gen host tree"
        elif gb == m:
            st = "== main"
        else:
            gl, ml = gb.count(b"\n"), m.count(b"\n")
            st = (f"DIFFERS from main (gen host {gl} lines, main {ml} lines)"
                  + ("" if from_main else "; to take main's version run put --from-main"))
        lines.append(f"{r}: gen host {gen} copy vs main {msha[:11]}: {st}")
    if from_main:
        nomain = [r for r in rels if mainb[r] is None]
        if nomain:
            return lines + [f"refused: not on main {msha[:11]}: {nomain}"]
        jobs = [{"path": r, "new": base64.b64encode(mainb[r]).decode(), "base": None, "hist": []} for r in rels]
        targets = [gen] + reps
    else:
        miss = [r for r, v in got.items() if v is None]
        if miss:
            return lines + [f"not in the gen host tree {gen}:{d['src']}: {miss}"]
        jobs = [{"path": r, "new": v, "base": None, "hist": []} for r, v in got.items()]
        targets = reps
    for h in targets:
        rr = run_remote(h, {"src": d["src"], "apply": apply_, "mode": "force" if apply_ else "dryforce", "stamp": stamp,
                            "to": f"main {msha[:11]}" if from_main else "put", "files": jobs})
        lines.append(f"{h}: " + ("ERROR " + rr["error"] if "error" in rr else
                                 " ".join(f"{x['path']}={x['status']}" for x in rr["results"])))
    pb, diffs = compare([gen] + reps, d["src"])
    left = {r: v for r, v in diffs.items() if r in set(rels)}
    other = {r: v for r, v in diffs.items() if hard(r) and r not in left}
    lines.append("copies identical" if not (pb or left) else f"still differ: {'; '.join(pb + fmt_diffs(left, gen))}")
    if other:
        lines.insert(-1, f"other code drift on {die} (not part of this put): " + "; ".join(fmt_diffs(other, gen, 6)))
    for l in lines:
        log(f"PUT {die} {l}")
    return lines


def changed(old, new):
    return [p for p in git("diff", "--name-only", "--no-renames", old, new).split("\n") if p and in_scope(p)]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("refresh"); a.add_argument("--from", dest="old", required=True); a.add_argument("--to", dest="new", required=True)
    c = sub.add_parser("catchup"); c.add_argument("--since", required=True); c.add_argument("--to", dest="new", default=f"{REMOTE}/main")
    dl = sub.add_parser("daily"); dl.add_argument("--to", dest="new", default=f"{REMOTE}/main")
    dr = sub.add_parser("drift"); dr.add_argument("--post", action="store_true"); dr.add_argument("--dies", default="")
    pu = sub.add_parser("put"); pu.add_argument("--die", required=True); pu.add_argument("paths", nargs="+"); pu.add_argument("--apply", action="store_true")
    pu.add_argument("--from-main", action="store_true", help="write main's version to the gen host and every replica")
    for p in (a, c, dl):
        p.add_argument("--apply", action="store_true"); p.add_argument("--dies", default=""); p.add_argument("--show", action="store_true")
    x = ap.parse_args()
    if getattr(x, "apply", False) and "OT_SRC_CFG" not in os.environ and "MQ_REPO" in os.environ:
        sys.exit("refusing --apply: MQ_REPO is set (a test or side clone) but the die config is the production kit_wave.json")
    only = set(getattr(x, "dies", "").split(",")) - {""}
    if x.cmd == "drift":
        lines = drift(only, x.post)
        for l in lines:
            print(l)
        return 0
    if x.cmd == "put":
        lines = put(x.die, x.paths, x.apply, x.from_main)
        for l in lines:
            print(l)
        return 0 if lines and lines[-1] == "copies identical" else 1
    if x.cmd == "daily":
        git("fetch", "-q", REMOTE, "main", check=False)
        lines = daily(x.new, x.apply, only)
        for l in lines:
            print(l)
        return 1 if any("ERROR" in l for l in lines) else 0
    if x.cmd == "refresh":
        paths = changed(x.old, x.new)
        rows, summ = refresh(paths, x.old, x.new, x.apply, only, f"{x.old[:11]}..{x.new[:11]}")
    else:
        since = x.since + " 00:00" if re.fullmatch(r"\d{4}-\d\d-\d\d", x.since) else x.since   # git reads a bare date as "now on that day"
        paths = sorted({p for p in git("log", x.new, f"--since={since}", "--name-only", "--format=").split("\n") if p and in_scope(p)})
        rows, summ = refresh(paths, "", x.new, x.apply, only, f"catchup-since-{x.since}", catchup=True)
    for s in summ:
        print(s)
    if x.show:
        for r in rows:
            if r[6] != "SAME":
                print("\t".join(map(str, r[2:])))
    bad = [s for s in summ if "ERROR" in s]
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
