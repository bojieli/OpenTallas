#!/usr/bin/env python3
"""ot-delete TREE... : the one way to delete a whole tree under /srv/opentallas-scratch* (FLEET-OPS-R, COORD 11-17).
Wraps ot_delete_guard.refuse(): a tree the guard refuses (protected by kit_wave.json / markers / receipts, a live process under it, a symlink,
a partial delete inside a source tree) is SKIPPED, not an error (exit 0, 'SKIP <path>: <reason>').  An allowed tree is removed whole
(directories made writable first, never files: a hardlinked file shares its inode with the base tree) and df before/after is printed.
A single regular FILE goes the same way (FLOW-OPS-1000, COORD 11-21: lanes stranded stray files in shared dirs): same guard, same manifest,
then unlink.  A symlink, socket, fifo or device is SKIPPED.  --dry lists what would go.  Needs the guard list
fleet-ops-r/protected_struct.txt or OT_GUARD_LIST (fail-closed: no list = every source tree is skipped)."""
import importlib.util, os, shutil, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))


def manifest(t):
    """FLOW-OPS-0900: per-file record of the tree before it goes (tools/fleet/delete_manifest.py); a record only, never a stop"""
    try:
        sp = importlib.util.spec_from_file_location("delete_manifest", os.path.join(HERE, "delete_manifest.py"))
        m = importlib.util.module_from_spec(sp); sp.loader.exec_module(m)
        return m.write(t, "ot-delete")
    except Exception as e:                    # noqa: BLE001
        print("ot-delete: manifest not written for %s: %s" % (t, e), file=sys.stderr)
        return None


def load_guard():
    for c in (os.path.join(HERE, "ot_delete_guard.py"), os.environ.get("OT_DELETE_GUARD", "")):
        if c and os.path.isfile(c):
            sp = importlib.util.spec_from_file_location("ot_delete_guard", c)
            m = importlib.util.module_from_spec(sp); sp.loader.exec_module(m)
            return m
    raise SystemExit("ot-delete: ot_delete_guard.py not found next to this tool")


def avail(path):
    try:
        s = os.statvfs(path if os.path.exists(path) else os.path.dirname(path))
        return s.f_bavail * s.f_frsize
    except OSError:
        return -1


ROOT_OK = ("/srv/opentallas-scratch/", "/srv/opentallas-scratch2/", "/srv/opentallas-scratch3/")


def sudo_rm(t):
    """CLEAN-AGGR-R3 (COORD 11-21: ot-run spill copy-back / docker jobs leave root-owned dirs that ot-delete could not remove):
    the same guard-approved path, removed as root, like ot-autoclean's class-a root mode.  Never follows symlinks or crosses filesystems."""
    return subprocess.run(["sudo", "-n", "rm", "-rf", "--one-file-system", "--", t], capture_output=True, text=True, timeout=7200)


def root_fallback_ok(t):
    """only a real (non-symlink, canonical) tree below a scratch root that still exists after the ubuntu-side delete failed"""
    return (os.path.lexists(t) and not os.path.islink(t) and os.path.isdir(t) and os.path.realpath(t) == t
            and t.startswith(ROOT_OK) and t.rstrip("/").count("/") >= 4)


def main(argv, guard=None, rmtree=None, rootrm=None, root_ok=None):
    # FLEET-OPS 11-25 (COORD safety bug: KV-HGI-WGATE ran `ot-delete --help` and the tool took --help as a path): -h / --help print usage (exit 0); an argument that starts with
    # '-' and is not a known flag (--dry) is refused with exit 2 BEFORE anything is looked at or deleted; a literal path that starts with '-' goes after `--`.
    if any(a in ("-h", "--help") for a in argv[:argv.index("--")] if True) if "--" in argv else any(a in ("-h", "--help") for a in argv):
        print(__doc__); return 0
    opts, rest = (argv[:argv.index("--")], argv[argv.index("--") + 1:]) if "--" in argv else (argv, [])
    bad = [a for a in opts if a.startswith("-") and a != "--dry"]
    if bad:
        print("ot-delete: unknown option %s (nothing deleted; usage: ot-delete [--dry] [--] TREE...; a path that starts with '-' goes after --)" % ", ".join(bad), file=sys.stderr)
        return 2
    dry = "--dry" in opts
    targets = [a for a in opts if a != "--dry"] + rest
    if not targets:
        print(__doc__); return 2
    g = guard or load_guard()
    rm = rmtree or (lambda t: (subprocess.run(["find", t, "-type", "d", "-exec", "chmod", "u+w", "{}", "+"], check=False), shutil.rmtree(t)))
    lst = os.environ.get("OT_GUARD_LIST")
    protected = None
    if lst:
        protected, err = g.load_list(lst)
        if protected is None:
            print("SKIP all: guard list unreadable: %s" % err); return 0
    rc = 0
    for t in targets:
        t = os.path.abspath(t)
        if not os.path.lexists(t):
            print("SKIP %s: does not exist" % t); continue
        if not os.path.islink(t) and not os.path.isdir(t) and not os.path.isfile(t):
            print("SKIP %s: not a directory or regular file" % t); continue
        why = g.refuse(t, protected) if protected is not None else g.refuse(t)
        if why:
            print("SKIP %s: %s" % (t, why)); continue
        before = avail(t)
        if dry:
            print("WOULD-DELETE %s" % t); continue
        mf = manifest(t)
        if mf:
            print("MANIFEST %s -> %s" % (t, mf))
        try:
            if os.path.isfile(t) and not os.path.islink(t):
                os.unlink(t)                  # a single regular file: the guard and the manifest above apply as for a tree
            else:
                rm(t)
        except OSError as e:
            ok = (root_ok or root_fallback_ok)(t)
            r = (rootrm or sudo_rm)(t) if ok else None
            if r is None or r.returncode or os.path.lexists(t):
                print("FAILED %s: %s%s" % (t, e, "" if r is None else " (root fallback rc %s: %s)" % (r.returncode, (r.stderr or "").strip()[:160])))
                rc = 1; continue
            print("ROOT-FALLBACK %s: ubuntu-side delete failed (%s); removed as root" % (t, e))
        print("DELETED %s  df before %.1f GB after %.1f GB" % (t, before / 2**30, avail(os.path.dirname(t)) / 2**30))
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
