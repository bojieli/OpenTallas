#!/usr/bin/env python3
"""ot-wait <unit|name|pid> [--timeout S] [--poll S] [--cmdline TEXT] [--dir DIR]     (WAITER-STD-1600, 2026-11-20)
ot-wait --kit KITDIR --stage floorplan|place|cts|grt|route|finish [--host H] [--also NAME] [--timeout S] [--poll S]     (KIT-STAGE mode, FLOW-PROC-B 11-21)
Wait for an ot-run job or an ot-push-main push, then print its status and exit with it.  Never `pgrep -f`: a pgrep waiter matches itself.

  <name>   a status file name (otrun-<host>-<pid>, otpush-<host>-<pid>) in $OT_STATUS_DIR (default ~/.local/state/ot-status)
  <unit>   an ot-heavy scope name oth-... (the file whose "unit" field equals it)
  <pid>    a number: the pid of an ot-run / ot-push-main client of THIS host (status file otrun-<host>-<pid> or otpush-<host>-<pid>);
           any other process is waited on by identity (kill -0, /proc starttime, /proc cmdline; a reused pid ends the wait)
Output, one line on stdout:  DONE rc=0 unit=... end=HH:MM:SS log=...   |   DIED rc=N ...   |   ENDED rc=unknown ...
Exit status: the job's own rc when a status file has it; 0 is returned only for a recorded rc 0.
  66  nothing found for the target (never a silent success)       2  usage / refused (--cmdline mismatch)
  70  a process ended and left no status (rc unknown)             71  the client died without writing a status (killed; treated as DIED)
  124 --timeout reached, job still running
KIT-STAGE mode: waits on the kit's stage RESULT, never on a log line.  A grep loop on run_place.log hangs forever on a route-goal kit (run_kit.sh GOAL=route writes
  run_route.log) and misses a rewritten log.  The stage is reached when its ODB exists in KITDIR/run/results/asap7/*/base/ (floorplan 2_floorplan.odb, place 3_place.odb,
  cts 4_cts.odb, grt 5_1_grt.odb, route 5_route.odb or 5_2_route.odb, finish 6_final.odb); the kit failed when KITDIR/FAIL_* exists first (FAIL_PREFLOOR, FAIL_POSTCTS, FAIL_route ...).
  Output: DONE rc=0 kit=... stage=... marker=...  |  DIED rc=1 kit=... stage=... fail=FAIL_xxx: <first line>.  --host H checks KITDIR on H over ssh (default: this host).
  --also NAME (an otrun-<host>-<pid> record or oth- unit on THIS host): if that ot-run ended (done, or its client died) and the stage ODB is absent, the wait ends
  DIED with the job's rc, so a killed or finished-early job never leaves a waiter hanging.  Exit: 0 reached, 1 failed (FAIL_*), the job's rc / 71 for --also, 124 timeout.
  Example:  ot-wait --kit /srv/opentallas-scratch2/claude/x/kit --host epyc10 --stage place --also oth-ubuntu-123-456 --timeout 28800 > place.wait &
Usage in a lane:  ot-wait otrun-$(hostname)-$PID > $LANE/wait.out &        or    ot-run ... & ; ot-wait $!
--cmdline TEXT: refuse unless the target pid's /proc cmdline contains TEXT (guards against waiting on a pid someone else now owns).
DIGEST mode (FLOW-OPS-1000, FABLE-FLOW-1000 i: one wake per job end, so lanes woke many times an hour and re-read raw logs):
  ot-wait --digest T1 T2 ... [--every MIN] [--timeout S]   one waiter for many targets (names, oth- units, pids).  It returns ONCE: when every target
  ended, or at the first --every boundary (default 30 min) after at least one target ended, with one line per target (DONE/DIED/ENDED ... or RUNNING)
  and a last line REMAINING <targets still running> (re-arm with exactly those).  Exit: 0 all ended rc 0; the first non-zero rc among the ended;
  75 = some ended rc 0, others still running (re-arm REMAINING); 124 timeout with none ended.
DURABLE mode (FLOW-FLEET-R1 11-22, COORD: lane waiters hit the 1 h / 12 h tool caps and missed job ends all night):
  ot-wait --durable <any of the forms above> [--timeout S]
  A detached watcher (own session: a tool-cap kill or a dropped ssh of the lane does not reach it) runs the same wait with no timeout and keeps its
  answer in ~/.local/state/ot-wait/durable/<key>.out (key = the wait's targets).  The foreground call only reads that file: it returns the watcher's
  line(s) and rc as soon as the job ends, or after --timeout (default 3000 s, under a 1 h cap) with exit 75 and a REARM line.  Re-running the SAME
  command re-attaches to the same watcher, so a job that ended while nobody was attached is reported at once; a watcher that vanished (reboot) is
  restarted.  Lane usage:   ot-wait --durable otrun-$(hostname)-$PID > $LANE/wait.out     (re-run it on exit 75)
LEDGER: every ot-wait exit appends one line to ~/.local/state/ot-wait/waits.tsv (OT_WAIT_LEDGER overrides): time, host, lane (OT_LANE), mode, targets,
  rc, waited s, timeout yes/no, ended n of m.  A record only, so a review can count waits, timeouts and wake-ups without a result."""
import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ot_status as S  # noqa: E402


def find(target, d=None):
    """-> (record, path) of the status file for target, or (None, None)"""
    d = d or S.status_dir()
    cands = [os.path.join(d, target + ".json")]
    if target.isdigit():
        cands = [os.path.join(d, f"otrun-{S.host()}-{target}.json"), os.path.join(d, f"otpush-{S.host()}-{target}.json")]
    for p in cands:
        try:
            return json.load(open(p)), p
        except (OSError, ValueError):
            pass
    if target.startswith("oth-") and os.path.isdir(d):
        for fn in sorted(os.listdir(d), key=lambda f: os.path.getmtime(os.path.join(d, f)), reverse=True):
            if not fn.endswith(".json") or fn.startswith("."):
                continue
            try:
                r = json.load(open(os.path.join(d, fn)))
            except (OSError, ValueError):
                continue
            if r.get("unit") == target:
                return r, os.path.join(d, fn)
    return None, None


def alive(rec):
    """the recorded client is still the same process"""
    pid = rec.get("pid")
    if not pid or not os.path.exists(f"/proc/{pid}"):
        return False
    try:
        os.kill(pid, 0)
    except PermissionError:
        pass
    except OSError:
        return False
    st = S.pid_start(pid)
    return st is not None and (rec.get("pid_start") is None or st == rec["pid_start"])


def line(word, rec):
    end = time.strftime("%H:%M:%S", time.localtime(rec["t_end"])) if rec.get("t_end") else "?"
    return f"{word} rc={rec.get('rc') if rec.get('rc') is not None else 'unknown'} unit={rec.get('unit') or rec.get('name')} host={rec.get('host')} end={end} log={rec.get('log') or 'none'}"


def wait_status(target, a):
    rec, path = find(target, a.dir)
    if rec is None:
        print(f"ot-wait: no status record for {target!r} in {a.dir or S.status_dir()} (and no such running ot-run/ot-push-main client); refusing to guess", file=sys.stderr)
        return None, 66
    t0 = time.time()
    while True:
        try:
            rec = json.load(open(path))
        except (OSError, ValueError):
            pass
        if rec.get("state") == "done":
            rc = rec.get("rc")
            print(line("DONE" if rc == 0 else "DIED", rec), flush=True)
            return rec, (rc if isinstance(rc, int) else 71)
        if not alive(rec):
            time.sleep(1)                      # the client may have written the file between our read and the liveness check
            try:
                rec = json.load(open(path))
            except (OSError, ValueError):
                pass
            if rec.get("state") == "done":
                continue
            print(line("DIED", rec) + " (client gone, no exit status written: killed)", flush=True)
            return rec, 71
        if a.timeout and time.time() - t0 >= a.timeout:
            print(f"ot-wait: timeout after {a.timeout} s, {rec['name']} still running", flush=True)
            return rec, 124
        time.sleep(a.poll)


def wait_pid(pid, a):
    cl = S.cmdline(pid)
    st = S.pid_start(pid)
    if st is None or not cl:
        print(f"ot-wait: no process {pid} (or empty cmdline); nothing to wait for", file=sys.stderr)
        return 66
    if a.cmdline and a.cmdline not in cl:
        print(f"ot-wait: pid {pid} cmdline {cl[:120]!r} does not contain {a.cmdline!r}; refusing", file=sys.stderr)
        return 2
    t0 = time.time()
    while True:
        cur = S.pid_start(pid)
        if cur is None or cur != st or S.cmdline(pid) != cl:
            rec, _ = find(str(pid), a.dir)          # the client may have written its record after we looked (race at start-up)
            if rec is not None and rec.get("state") == "done" and rec.get("pid_start") == st:
                print(line("DONE" if rec.get("rc") == 0 else "DIED", rec), flush=True)
                return rec["rc"] if isinstance(rec.get("rc"), int) else 71
            print(f"ENDED rc=unknown pid={pid} cmd={cl[:140]} end={time.strftime('%H:%M:%S')}", flush=True)
            return 70
        if a.timeout and time.time() - t0 >= a.timeout:
            print(f"ot-wait: timeout after {a.timeout} s, pid {pid} still running", flush=True)
            return 124
        time.sleep(a.poll)


STAGE_ODB = {"floorplan": ["2_floorplan.odb"], "place": ["3_place.odb"], "cts": ["4_cts.odb"], "grt": ["5_1_grt.odb"],
             "route": ["5_route.odb", "5_2_route.odb"], "finish": ["6_final.odb"]}


def kit_probe(kit, stage, host=""):
    """-> ("done", marker) | ("fail", "FAIL_x: first line") | ("wait", "") | ("error", why).  Stage ODB wins over a FAIL_ file."""
    import glob
    import shlex
    if host and host != S.host():
        pats = " ".join(shlex.quote(f"{kit}/run/results/asap7/*/base/{o}") for o in STAGE_ODB[stage])
        sh = (f'for f in {pats}; do if ls $f >/dev/null 2>&1; then echo "done $(ls $f | head -1)"; exit 0; fi; done; '
              f'for f in {shlex.quote(kit)}/FAIL_*; do [ -f "$f" ] && {{ echo "fail $(basename $f): $(head -c 200 $f | head -1)"; exit 0; }}; done; '
              f'[ -d {shlex.quote(kit)} ] && echo wait || echo error kit dir missing')
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ControlPath=none", "-o", "ConnectTimeout=15", host, sh],
                               capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            return ("wait", f"ssh {host}: {e}")             # a flaky link is not a verdict
        if r.returncode != 0 and not r.stdout.strip():
            return ("wait", f"ssh {host} rc={r.returncode}")
        w, _, rest = r.stdout.strip().partition(" ")
        return (w if w in ("done", "fail", "wait", "error") else "wait", rest)
    if not os.path.isdir(kit):
        return ("error", "kit dir missing")
    for o in STAGE_ODB[stage]:
        for f in sorted(glob.glob(os.path.join(kit, "run/results/asap7/*/base", o))):
            return ("done", f)
    for f in sorted(glob.glob(os.path.join(kit, "FAIL_*"))):
        try:
            first = open(f, errors="replace").readline().strip()[:200]
        except OSError:
            first = ""
        return ("fail", f"{os.path.basename(f)}: {first}")
    return ("wait", "")


def wait_kit(a):
    if a.stage not in STAGE_ODB:
        print(f"ot-wait: --stage must be one of {', '.join(STAGE_ODB)}", file=sys.stderr)
        return 2
    kit = a.kit.rstrip("/")
    t0 = time.time()
    while True:
        st, info = kit_probe(kit, a.stage, a.host)
        if st == "done":
            print(f"DONE rc=0 kit={kit} stage={a.stage} marker={info}", flush=True)
            return 0
        if st == "fail":
            print(f"DIED rc=1 kit={kit} stage={a.stage} fail={info}", flush=True)
            return 1
        if st == "error":
            print(f"ot-wait: {info}: {kit} on {a.host or S.host()}; refusing to guess", file=sys.stderr)
            return 66
        if a.also:
            rec, path = find(a.also, a.dir)
            if rec is None:
                print(f"ot-wait: --also {a.also!r}: no status record on this host", file=sys.stderr)
                return 66
            if rec.get("state") == "done" or not alive(rec):
                # the ODB may land just before the client exits: look once more before calling it
                st, info = kit_probe(kit, a.stage, a.host)
                if st == "done":
                    print(f"DONE rc=0 kit={kit} stage={a.stage} marker={info}", flush=True)
                    return 0
                rc = rec.get("rc")
                print(f"DIED rc={rc if rc is not None else 'unknown'} kit={kit} stage={a.stage} unit={rec.get('unit') or rec.get('name')} "
                      f"(job ended, no {a.stage} result{'; ' + info if info else ''})", flush=True)
                return rc if isinstance(rc, int) and rc != 0 else 71
        if a.timeout and time.time() - t0 >= a.timeout:
            print(f"ot-wait: timeout after {a.timeout} s, kit {kit} has not reached {a.stage}", flush=True)
            return 124
        time.sleep(a.poll)


def ledger(mode, targets, rc, t0, ended=None, total=None):
    """one line per ot-wait exit (a record only; never fails the wait)"""
    try:
        p = os.environ.get("OT_WAIT_LEDGER") or os.path.expanduser("~/.local/state/ot-wait/waits.tsv")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        new = not os.path.exists(p)
        with open(p, "a") as f:
            if new:
                f.write("time\thost\tlane\tmode\ttargets\trc\twaited_s\ttimeout\tended\n")
            f.write("\t".join([time.strftime("%F %T"), S.host(), os.environ.get("OT_LANE", "") or "-", mode, ",".join(targets)[:400], str(rc),
                                "%.0f" % (time.time() - t0), "yes" if rc == 124 else "no",
                                "-" if ended is None else f"{ended}/{total}"]) + "\n")
    except OSError:
        pass


def probe(target, a, memo):
    """non-blocking state of one digest target -> (ended, rc, line).  memo keeps the first-seen pid identity."""
    if target.isdigit() and target not in memo:
        rec, _ = find(target, a.dir)
        memo[target] = ("pid", S.pid_start(int(target)), S.cmdline(int(target))) if rec is None else ("rec", None, None)
    if target.isdigit() and memo[target][0] == "pid":
        _, st, cl = memo[target]
        cur = S.pid_start(int(target))
        if st is not None and cur == st and S.cmdline(int(target)) == cl:
            return False, None, f"RUNNING pid={target}"
        rec, _ = find(target, a.dir)
        if rec is not None and rec.get("state") == "done" and (st is None or rec.get("pid_start") == st):
            rc = rec.get("rc")
            return True, (rc if isinstance(rc, int) else 71), line("DONE" if rc == 0 else "DIED", rec)
        return True, 70, f"ENDED rc=unknown pid={target}"
    rec, path = find(target, a.dir)
    if rec is None:
        return True, 66, f"MISSING {target}: no status record"
    if rec.get("state") == "done":
        rc = rec.get("rc")
        return True, (rc if isinstance(rc, int) else 71), line("DONE" if rc == 0 else "DIED", rec)
    if not alive(rec):
        try:
            rec = json.load(open(path))
        except (OSError, ValueError):
            pass
        if rec.get("state") == "done":
            rc = rec.get("rc")
            return True, (rc if isinstance(rc, int) else 71), line("DONE" if rc == 0 else "DIED", rec)
        return True, 71, line("DIED", rec) + " (client gone, no exit status written: killed)"
    return False, None, f"RUNNING {rec.get('unit') or rec.get('name') or target}"


def wait_digest(targets, a, now=time.time, sleep=time.sleep):
    t0 = now()
    every = max(1.0, float(a.every)) * 60
    memo, done = {}, {}
    while True:
        for t in targets:
            if t in done:
                continue
            ended, rc, ln = probe(t, a, memo)
            if ended:
                done[t] = (rc, ln)
        el = now() - t0
        remaining = [t for t in targets if t not in done]
        boundary = done and int(el // every) > int((el - a.poll) // every) if el >= every else False
        timed_out = a.timeout and el >= a.timeout
        if not remaining or boundary or timed_out:
            for t in targets:
                print(done[t][1] if t in done else probe(t, a, memo)[2], flush=True)
            print("REMAINING " + (" ".join(remaining) if remaining else "-"), flush=True)
            bad = [rc for rc, _ in done.values() if rc != 0]
            rc = bad[0] if bad else (0 if not remaining else (75 if done else 124))
            return rc, len(done)
        sleep(a.poll)


DURABLE_DIR = os.path.expanduser(os.environ.get("OT_WAIT_DURABLE_DIR", "~/.local/state/ot-wait/durable"))
DURABLE_TIMEOUT_S = 3000
DURABLE_RC = "OT_WAIT_RC="


def durable_key(a):
    import hashlib
    k = json.dumps({"t": a.target, "d": a.digest, "k": a.kit.rstrip("/"), "s": a.stage, "h": a.host, "a": a.also, "c": a.cmdline, "dir": a.dir}, sort_keys=True)
    return hashlib.sha1(k.encode()).hexdigest()[:16]


def durable_argv(argv):
    """the watcher's argv: this call without --durable / --timeout (it waits until the end)"""
    out, skip = [], False
    for x in argv:
        if skip:
            skip = False
            continue
        if x == "--durable":
            continue
        if x == "--timeout":
            skip = True
            continue
        if x.startswith("--timeout="):
            continue
        out.append(x)
    return out


def _watcher_alive(pidf):
    try:
        pid, start = open(pidf).read().split()
        return S.pid_start(int(pid)) == int(start)
    except (OSError, ValueError):
        return False


def wait_durable(a, argv, popen=subprocess.Popen, sleep=time.sleep, now=time.time):
    os.makedirs(DURABLE_DIR, exist_ok=True)
    key = durable_key(a)
    out, pidf = os.path.join(DURABLE_DIR, key + ".out"), os.path.join(DURABLE_DIR, key + ".pid")

    def answer():
        try:
            txt = open(out, errors="replace").read()
        except OSError:
            return None
        if DURABLE_RC not in txt:
            return None
        body = [ln for ln in txt.splitlines() if not ln.startswith(DURABLE_RC)]
        rc = int(txt.rsplit(DURABLE_RC, 1)[1].split()[0])
        return body, rc

    got = answer()
    if got is None and not _watcher_alive(pidf):
        w = [sys.executable, "-I", os.path.realpath(__file__)] + durable_argv(argv)
        sh = f"{' '.join(__import__('shlex').quote(x) for x in w)} > {__import__('shlex').quote(out)} 2>&1; echo {DURABLE_RC}$? >> {__import__('shlex').quote(out)}"
        p = popen(["bash", "-c", sh], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        st = S.pid_start(p.pid)
        with open(pidf + ".tmp", "w") as f:
            f.write(f"{p.pid} {st if st is not None else 0}\n")
        os.replace(pidf + ".tmp", pidf)
        print(f"ot-wait: durable watcher {key} started (pid {p.pid}); answer file {out}", file=sys.stderr, flush=True)
    t0, limit = now(), (a.timeout or DURABLE_TIMEOUT_S)
    while got is None:
        if now() - t0 >= limit:
            print(f"RUNNING durable watcher {key} keeps waiting; REARM: re-run the same ot-wait --durable command", flush=True)
            return 75
        sleep(a.poll)
        got = answer()
        if got is None and not _watcher_alive(pidf) and answer() is None:
            print(f"ot-wait: durable watcher {key} gone without an answer; re-run to restart it", file=sys.stderr, flush=True)
            return 71
    for ln in got[0]:
        print(ln, flush=True)
    return got[1]


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("target", nargs="?", default="")
    ap.add_argument("--kit", default="")
    ap.add_argument("--stage", default="")
    ap.add_argument("--host", default="")
    ap.add_argument("--also", default="")
    ap.add_argument("--timeout", type=float, default=0)
    ap.add_argument("--poll", type=float, default=5)
    ap.add_argument("--cmdline", default="")
    ap.add_argument("--dir", default="")
    ap.add_argument("--digest", nargs="+", default=None, help="one waiter for many targets; returns once (see DIGEST mode)")
    ap.add_argument("--every", type=float, default=30, help="--digest: minutes between wakes (default 30)")
    ap.add_argument("--durable", action="store_true", help="detached watcher survives tool caps / ssh drops; re-run the same command to re-attach (see DURABLE)")
    a = ap.parse_args(argv)
    t0 = time.time()
    if a.durable:
        rc = wait_durable(a, argv)
        ledger("durable", ([a.kit + ":" + a.stage] if a.kit else ([a.target] if a.target else []) + list(a.digest or [])), rc, t0)
        return rc
    if a.digest:
        tg = ([a.target] if a.target else []) + a.digest
        rc, n = wait_digest(tg, a)
        ledger("digest", tg, rc, t0, n, len(tg))
        return rc
    rc = _main(a)
    ledger("kit" if a.kit else ("pid" if a.target.isdigit() else "status"), [a.kit + ":" + a.stage] if a.kit else [a.target], rc, t0)
    return rc


def _main(a):
    if a.kit:
        return wait_kit(a)
    if not a.target:
        print("ot-wait: a target (unit|name|pid), --digest T..., or --kit KITDIR --stage STAGE is required", file=sys.stderr)
        return 2
    if a.target.isdigit():
        rec, _ = find(a.target, a.dir)
        cur = S.pid_start(int(a.target))
        # a record of an older client that had this pid number is not this process (pid reuse)
        if rec is None or (cur is not None and rec.get("pid_start") is not None and cur != rec["pid_start"]):
            return wait_pid(int(a.target), a)
    return wait_status(a.target, a)[1]


if __name__ == "__main__":
    sys.exit(main())
