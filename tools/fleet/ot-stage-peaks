#!/usr/bin/env python3
"""ot-stage-peaks (ADMIT-TUNE-1 11-14 19:0x, OWNER-approved Fable fix 3): measure the real peak RSS of each build STAGE and publish the table ot-heavy-reconcile
charges running builds with (STAGE_PEAK).  Every minute: scan openroad/yosys/... processes, remember each one's stage (the flow .tcl on its command line) and
VmHWM (its own high-water RSS); when a process is gone, append `time stage hwm_gb` to /var/tmp/ot-heavy/stage-peaks.tsv.  The table
/var/tmp/ot-heavy/stage-peaks.json = per stage max(p90 x 1.1 of the last 24 h of finished-stage peaks when >= 5, the seed measured on 11-14 across the 7 hosts).
  ot-stage-peaks [--dir DIR]"""
import argparse, json, os, re, sys, time

D = "/var/tmp/ot-heavy"
COMMS = {"openroad", "yosys", "yosys-abc", "klayout", "cc1plus", "verilator_bin", "verilator_bin_dbg"}
MULT, MIN_N, KEEP_S = 1.1, 5, 24 * 3600
# seed: p90 of VmHWM x 1.1 over 450 live processes on the 7 hosts at 11-14 18:5x (lower bounds: unfinished stages), raised to the Fable review figures
# (detail route 27-37 GB, GRT with repair 19-27 GB) for the two routing stages
SEED = {"global_route.tcl": 29.7, "detail_route.tcl": 40.7, "cts.tcl": 14.1, "global_place.tcl": 21.8, "global_place_skip_io.tcl": 4.1, "pregrt_ff_hold.tcl": 10.3,
        "postcts_gate.tcl": 10.9, "floorplan.tcl": 2.1, "synth.tcl": 21.8, "layout_render.tcl": 5.1, "grt_policy_ff.tcl": 8.5, "grt_policy_tt.tcl": 11.3, "resize.tcl": 1.9,
        "final_report.tcl": 6.4, "geom_grt.tcl": 8.9, "pdn.tcl": 1.3, "io_placement.tcl": 0.7, "detail_place.tcl": 7.0, "fabric.tcl": 13.8, "proof2.tcl": 11.1,
        "gen_lint.tcl": 2.3, "tapcell.tcl": 0.2, "fillcell.tcl": 6.4}


def stage_of(cmdline):
    m = re.findall(r"([A-Za-z0-9_.\-]+\.tcl)", cmdline)
    return m[0] if m else ""


def scan(proc="/proc"):
    """{(pid, starttime): (stage, hwm_gb)}"""
    out = {}
    for p in os.listdir(proc):
        if not p.isdigit():
            continue
        try:
            if open(f"{proc}/{p}/comm").read().strip() not in COMMS:
                continue
            stage = stage_of(open(f"{proc}/{p}/cmdline").read().replace("\0", " "))
            if not stage:
                continue
            st = open(f"{proc}/{p}/stat").read().rsplit(")", 1)[1].split()[19]
            hwm = int(re.search(r"VmHWM:\s+(\d+)", open(f"{proc}/{p}/status").read()).group(1)) / 1048576
            out[f"{p}:{st}"] = (stage, round(hwm, 2))
        except (OSError, ValueError, IndexError, AttributeError):
            continue
    return out


def build_table(rows, now, seed=SEED):
    """rows: [(epoch, stage, hwm_gb)] -> {stage: GB}"""
    by = {}
    for t, s, h in rows:
        if now - t <= KEEP_S:
            by.setdefault(s, []).append(h)
    tab = dict(seed)
    for s, v in by.items():
        if len(v) >= MIN_N:
            v.sort()
            tab[s] = round(v[min(len(v) - 1, int(0.9 * len(v)))] * MULT, 1)
    return tab


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dir", default=D)
    a = ap.parse_args(argv)
    os.makedirs(a.dir, exist_ok=True)
    state_f, tsv, tab_f = a.dir + "/stage-peaks.state", a.dir + "/stage-peaks.tsv", a.dir + "/stage-peaks.json"
    try:
        old = json.load(open(state_f))
    except (OSError, ValueError):
        old = {}
    cur, now = scan(), time.time()
    with open(tsv, "a") as f:
        for k, (stage, hwm) in old.items():
            if k not in cur:
                f.write(f"{int(now)}\t{stage}\t{hwm}\n")
    json.dump(cur, open(state_f + ".tmp", "w")); os.replace(state_f + ".tmp", state_f)
    rows = []
    try:
        for ln in open(tsv):
            t, s, h = ln.rstrip("\n").split("\t")
            rows.append((float(t), s, float(h)))
    except (OSError, ValueError):
        pass
    rows = [r for r in rows if now - r[0] <= KEEP_S]
    open(tsv + ".tmp", "w").write("".join(f"{int(t)}\t{s}\t{h}\n" for t, s, h in rows)); os.replace(tsv + ".tmp", tsv)   # prune to 24 h
    json.dump(build_table(rows, now), open(tab_f + ".tmp", "w"), indent=0); os.replace(tab_f + ".tmp", tab_f)
    print(f"ot-stage-peaks: {len(cur)} stage processes, {len(rows)} finished-stage samples (24 h)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
