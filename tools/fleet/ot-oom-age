#!/usr/bin/env python3
"""ot-oom-age (ADMIT-TUNE-1 11-14, COORD): when a host runs out of memory the kill should hit the job with the LEAST sunk work, not
the biggest.  earlyoom and the kernel both rank victims by /proc/PID/oom_score = RSS share + oom_score_adj, so an 8 h GRT (50 GB) dies
before a fresh job.  This root helper sets each build process's oom_score_adj from its age: STARTADJ (800) when new, minus STEP (100)
per hour, floor 0.  An adj of 800 outweighs any RSS (1 GB of 1 TB = 1 point), so the youngest die first; among old ones RSS decides.
Stage: an openroad in DRT or past GRT is set to 0, one in GRT to 3/8 of its age value, 300 for a new one (stage_adj).  Only these tool comms are touched, and never a process whose current adj is outside [0, 800] (die containers run at -999, the
closure-loop runner at 900).  Lowering an adj needs root (CAP_SYS_RESOURCE): run from root cron / systemd timer.
  ot-oom-age [--dry-run] [--now-offset SECONDS] [--comm a,b] [--pid N ...]"""
import argparse, json, os, re, subprocess, sys, time

COMMS = {"openroad", "yosys", "yosys-abc", "verilator_bin", "verilator_bin_dbg", "cc1plus", "cc1", "klayout", "vvp"}
STARTADJ, STEP, FLOOR, MAXMANAGED = 800, 100, 0, 800


def target_adj(age_s, start=STARTADJ, step=STEP, floor=FLOOR):
    return max(floor, start - step * int(max(0, age_s) // 3600))


def proc_age(pid, now, hz):
    st = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
    up = float(open("/proc/uptime").read().split()[0])
    return up - int(st[19]) / hz + (now - time.time())


STATE = "/var/tmp/ot-oom-age/first.json"
KEEP_S = 24 * 3600


def item_key(name):
    """container name -> job key: dpkit-<item>-<client pid> -> dpkit-<item> (a resubmitted job is a new container with a new pid suffix)"""
    return re.sub(r"-\d+$", "", name) if name else None


def container_names():
    """{container id: name} (one docker call; empty when docker is unavailable)"""
    try:
        out = subprocess.run(["docker", "ps", "--no-trunc", "--format", "{{.ID}} {{.Names}}"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return {ln.split()[0]: ln.split()[1] for ln in out.splitlines() if len(ln.split()) == 2}


def container_id(pid):
    try:
        m = re.search(r"docker-([0-9a-f]{64})\.scope", open(f"/proc/{pid}/cgroup").read())
    except OSError:
        return None
    return m.group(1) if m else None


def credited_age(first, key, start_age, now):
    """AGECREDIT: a job resubmitted after an infra kill keeps the age of its earlier attempts (first-seen time of its key, kept 24 h); no key -> the process age"""
    if not key:
        return start_age
    t0 = first.setdefault(key, {"first": now - start_age, "seen": now})
    t0["first"] = min(t0["first"], now - start_age)
    t0["seen"] = now
    return now - t0["first"]


def load_state(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def save_state(path, first, now):
    first = {k: v for k, v in first.items() if now - v.get("seen", 0) < KEEP_S}
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        json.dump(first, open(path + ".tmp", "w")); os.replace(path + ".tmp", path)
    except OSError:
        pass


LATE_RE = re.compile(r"/(detail_route|detailed_route|fillcell|final_report|route_cleanup)\.tcl\b")      # past GRT: routing / fill / final: most sunk work
GRT_RE = re.compile(r"/global_route\.tcl\b")
GRT_CAP = 300


def stage_adj(cmdline, age_adj):
    """STAGEADJ (COORD 11-14): the job that loses the least work dies first.  Jobs in DRT or past GRT (detail_route / fillcell / final_report) get 0 -- the
    lowest score; a job inside GRT is scaled to GRT_CAP/STARTADJ of its age value (800 -> 300); everything earlier keeps the age-based value (800 new, -100 per hour)."""
    if LATE_RE.search(cmdline):
        return FLOOR
    if GRT_RE.search(cmdline):
        return age_adj * GRT_CAP // STARTADJ        # scaled, not clipped: young GRT jobs still die before older ones
    return age_adj


def managed(cur):
    return 0 <= cur <= MAXMANAGED


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--now-offset", type=float, default=0.0)
    ap.add_argument("--comm", default="")
    ap.add_argument("--pid", type=int, nargs="*", default=[])
    ap.add_argument("--state", default=STATE)
    a = ap.parse_args(argv)
    comms = set(a.comm.split(",")) if a.comm else COMMS
    hz = os.sysconf("SC_CLK_TCK")
    now = time.time() + a.now_offset
    pids = [str(p) for p in a.pid] or [p for p in os.listdir("/proc") if p.isdigit()]
    changed = seen = 0
    first, names = load_state(a.state), container_names()
    for p in pids:
        try:
            comm = open(f"/proc/{p}/comm").read().strip()
            if comm not in comms:
                continue
            cur = int(open(f"/proc/{p}/oom_score_adj").read())
            if not managed(cur):
                continue
            age = proc_age(p, now, hz)
            key = item_key(names.get(container_id(p) or ""))
            want = stage_adj(open(f"/proc/{p}/cmdline").read().replace("\0", " "), target_adj(credited_age(first, key, age, now)))
            seen += 1
            if want != cur:
                if not a.dry_run:
                    open(f"/proc/{p}/oom_score_adj", "w").write(str(want))
                changed += 1
        except (OSError, ValueError, IndexError):
            continue
    if not a.dry_run:
        save_state(a.state, first, now)
    print(f"ot-oom-age: {seen} managed, {changed} {'would change' if a.dry_run else 'changed'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
