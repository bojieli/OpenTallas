#!/usr/bin/env python3
"""ot-oom-age (ADMIT-TUNE-1 11-14, COORD): when a host runs out of memory the kill should hit the job with the LEAST sunk work, not
the biggest.  earlyoom and the kernel both rank victims by /proc/PID/oom_score = RSS share + oom_score_adj, so an 8 h GRT (50 GB) dies
before a fresh job.  This root helper sets each build process's oom_score_adj from its age: STARTADJ (800) when new, minus STEP (100)
per hour, floor 0.  An adj of 800 outweighs any RSS (1 GB of 1 TB = 1 point), so the youngest die first; among old ones RSS decides.
Stage: an openroad in DRT or past GRT is set to 0, one in GRT to 3/8 of its age value, 300 for a new one (stage_adj).  Only these tool comms are touched, and never a process whose current adj is outside [0, 800] (die containers run at -999, the
closure-loop runner at 900).  Lowering an adj needs root (CAP_SYS_RESOURCE): run from root cron / systemd timer.
  ot-oom-age [--dry-run] [--now-offset SECONDS] [--comm a,b] [--pid N ...]"""
import argparse, json, os, re, signal, subprocess, sys, time

COMMS = {"openroad", "yosys", "yosys-abc", "verilator_bin", "verilator_bin_dbg", "cc1plus", "cc1", "klayout", "vvp"}
STARTADJ, STEP, FLOOR, MAXMANAGED = 800, 100, 0, 800


def target_adj(age_s, start=STARTADJ, step=STEP, floor=FLOOR):
    return max(floor, start - step * int(max(0, age_s) // 3600))


def proc_age(pid, now, hz):
    st = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
    up = float(open("/proc/uptime").read().split()[0])
    return up - int(st[19]) / hz + (now - time.time())


STATE = "/var/tmp/ot-oom-age/first.json"
KEEP_S = 24 * 3600


def item_key(name):
    """container name -> job key: dpkit-<item>-<client pid> -> dpkit-<item> (a resubmitted job is a new container with a new pid suffix)"""
    return re.sub(r"-\d+$", "", name) if name else None


def container_names():
    """{container id: name} (one docker call; empty when docker is unavailable)"""
    try:
        out = subprocess.run(["docker", "ps", "--no-trunc", "--format", "{{.ID}} {{.Names}}"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return {ln.split()[0]: ln.split()[1] for ln in out.splitlines() if len(ln.split()) == 2}


def container_id(pid):
    try:
        m = re.search(r"docker-([0-9a-f]{64})\.scope", open(f"/proc/{pid}/cgroup").read())
    except OSError:
        return None
    return m.group(1) if m else None


def credited_age(first, key, start_age, now):
    """AGECREDIT: a job resubmitted after an infra kill keeps the age of its earlier attempts (first-seen time of its key, kept 24 h); no key -> the process age"""
    if not key:
        return start_age
    t0 = first.setdefault(key, {"first": now - start_age, "seen": now})
    t0["first"] = min(t0["first"], now - start_age)
    t0["seen"] = now
    return now - t0["first"]


def load_state(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def save_state(path, first, now):
    first = {k: v for k, v in first.items() if now - v.get("seen", 0) < KEEP_S}
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        json.dump(first, open(path + ".tmp", "w")); os.replace(path + ".tmp", path)
    except OSError:
        pass


LATE_RE = re.compile(r"/(detail_route|detailed_route|fillcell|final_report|route_cleanup)\.tcl\b")      # past GRT: routing / fill / final: most sunk work
GRT_RE = re.compile(r"/global_route\.tcl\b")
GRT_CAP = 300
YOUNG_S = 3 * 3600          # VICTIM_RSS_1114: younger than this, the LARGEST process dies first
YOUNG_BASE, YOUNG_SPAN, YOUNG_PER_GB = 520, 279, 10


def stage_adj(cmdline, age_adj):
    """STAGEADJ (COORD 11-14): the job that loses the least work dies first.  Jobs in DRT or past GRT (detail_route / fillcell / final_report) get 0 -- the
    lowest score; a job inside GRT is scaled to GRT_CAP/STARTADJ of its age value (800 -> 300); everything earlier keeps the age-based value (800 new, -100 per hour)."""
    if LATE_RE.search(cmdline):
        return FLOOR
    if GRT_RE.search(cmdline):
        return age_adj * GRT_CAP // STARTADJ        # scaled, not clipped: young GRT jobs still die before older ones
    return age_adj


LATE_ECO_CONTAINER = re.compile(r"^prd-")


def late_eco_container(name):
    """11-18 (FABLE-FLOW-1750 C, COORD): the late ECO's containers (prd_run.sh: prd-<kit>-<pass>-<pid>, prd-fin-, prd-count-, prd-preclean-)
    work on a routed DB, the sunk work of the whole route attempt, so they rank as a late stage (adj 0): never the PLANGUARD victim, last for
    earlyoom.  Their openroad is a fresh process in a fresh container, so age + stage gave 300 at GRT, and the largest-RSS PLANGUARD rule
    picked it first: hd_host_n (epyc10 00:23:54, RSS 14.5 GB) died at repair_antennas with make 'Error 247' (= SIGKILL) 494 s into its ECO."""
    return bool(name) and bool(LATE_ECO_CONTAINER.match(name))


def victim_adj(cmdline, age_s, rss_gb):
    """VICTIM_RSS_1114 (COORD 11-14): killing a 4 GB job frees nothing, so earlyoom kept killing small young jobs until it reached a big one (10 h of victims: 40 percent
    of openroad kills under 8 GB, 115 of 156 young).  Early-stage jobs younger than YOUNG_S get adj 520 + 10 per GB of RSS (max 799): the largest young process dies first and
    a job under 8 GB (adj <= 599) never goes before a larger young one; older early-stage jobs decay from 500 by age.  Late stages (0) and GRT (scaled) keep STAGEADJ."""
    age_adj = target_adj(age_s)
    if LATE_RE.search(cmdline) or GRT_RE.search(cmdline):
        return stage_adj(cmdline, age_adj)
    if age_s < YOUNG_S:
        return YOUNG_BASE + min(YOUNG_SPAN, int(max(0.0, rss_gb) * YOUNG_PER_GB))
    return min(500, age_adj)


PLAN_DIR = "/var/tmp/ot-heavy"
PLAN_ADJ = -1000
PLAN_EXTRA = {"python3", "python"}      # PLANBYPASS_1114: a plan job's helper processes are protected too


def plan_pids(d=None):
    """launcher pids of the running plan jobs (markers plan.job.<pid> written by ot-heavy for OT_HEAVY_PRIO=plan); a marker of a dead launcher is removed"""
    d = d or PLAN_DIR
    out = set()
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for n in names:
        if n.startswith("plan.job.") and n[9:].isdigit():
            if os.path.isdir(f"/proc/{n[9:]}"):
                out.add(n[9:])
            else:
                try:
                    os.unlink(os.path.join(d, n))
                except OSError:
                    pass
    return out


def plan_key(pid, names):
    """launcher pid of the job a process belongs to: its oth-<user>-<pid>-<t>.scope, or the otc-<pid>-<n> container it runs in; None otherwise"""
    try:
        cg = open(f"/proc/{pid}/cgroup").read()
    except OSError:
        return None
    m = re.search(r"/oth-[^/\n]*?-(\d+)-\d+\.scope", cg)
    if m:
        return m.group(1)
    cid = container_id(pid)
    m = re.match(r"otc-(\d+)-\d+$", names.get(cid or "", ""))
    return m.group(1) if m else None


def plan_ancestor(pid, plans, depth=12):
    """a build process spawned by a plan job outside its scope / container (a host-side yosys under a bind): a marked launcher among its ancestors"""
    p = str(pid)
    for _ in range(depth):
        try:
            p = open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1]
        except (OSError, IndexError):
            return None
        if p in plans:
            return p
        if p in ("0", "1"):
            return None
    return None


GUARD_PCT_DEFAULT = 5.0


def guard_pct():
    """PLANGUARD_1114: PLAN_GUARD_PCT in /etc/ot-heavy.conf (0 = off)"""
    try:
        m = re.findall(r"^PLAN_GUARD_PCT=([0-9.]+)", open("/etc/ot-heavy.conf").read(), re.M)
        return float(m[-1]) if m else GUARD_PCT_DEFAULT
    except OSError:
        return GUARD_PCT_DEFAULT


def guard_victim(procs):
    """procs: [(pid, comm, adj, score, rss_gb)] -> the non-plan build process to kill first (adj in 1..800, highest oom_score = largest young one), or None"""
    cand = [x for x in procs if 0 < x[2] <= MAXMANAGED and x[1] in COMMS]
    # 11-18 (FABLE-FLOW-1555 A, COORD): the victim is the job whose kill FREES THE MOST memory (30 kills of 1-2 GB young openroad freed ~40 GB on epyc10 while 74 old jobs kept 939 GB);
    # the highest adj (youngest / earliest stage) is only the tie-break among equal sizes (RSS compared at 0.5 GB granularity), then oom_score.  adj 0 (late stage) and plan jobs stay excluded.
    return max(cand, key=lambda x: (round(x[4] * 2), x[2], x[3]))[0] if cand else None


def victim_ident(pid, names):
    """who a guard victim was, for kills.log (11-18 FABLE-FLOW-1950: three kills could not be told prd-* from other jobs): systemd unit, container name, cwd and the first path in its cmdline; read before the kill"""
    unit = cont = cwd = path = "-"
    try:
        cg = open(f"/proc/{pid}/cgroup").read()
        m = re.search(r"([^/\n]+\.(?:scope|service))\s*$", cg, re.M)
        unit = m.group(1) if m else "-"
        cont = names.get(container_id(pid) or "", "-")
    except OSError:
        pass
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    try:
        args = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf-8", "replace").split("\0")
        path = next((a for a in args if a.startswith("/srv/") or a.startswith("/home/")), "-")
    except OSError:
        pass
    return f"unit {unit} container {cont} cwd {cwd} path {path}"


def guard(seconds, pct, dry=False, kill=os.kill, log=None, sleep=time.sleep, meminfo=None):
    """PLANGUARD_1114 (COORD 11-14, B4L4 yosys lost at 2.6 percent free): while a plan job runs on this host and MemAvailable < pct percent, kill the largest young non-plan build
    process NOW (SIGKILL; earlyoom's SIGTERM line is 3 percent and a victim may need 10+ s to go), one per 10 s, so the plan job's memory growth never reaches the kernel's line"""
    killed, t_end, log = 0, time.time() + seconds, log or ESC_LOG
    while pct > 0 and time.time() < t_end:
        plans = plan_pids()
        if plans:
            mi = (meminfo or (lambda: {k: int(v.split()[0]) for k, v in (l.split(":", 1) for l in open("/proc/meminfo"))}))()
            if mi["MemAvailable"] * 100.0 / mi["MemTotal"] < pct:
                procs, names = [], container_names()
                for p in os.listdir("/proc"):
                    if not p.isdigit():
                        continue
                    try:
                        comm = open(f"/proc/{p}/comm").read().strip()
                        if comm not in COMMS or plan_key(p, names) in plans or plan_ancestor(p, plans):
                            continue
                        rss = int(re.search(r"VmRSS:\s+(\d+)", open(f"/proc/{p}/status").read()).group(1)) / 1048576
                        procs.append((int(p), comm, int(open(f"/proc/{p}/oom_score_adj").read()), int(open(f"/proc/{p}/oom_score").read()), rss))
                    except (OSError, ValueError, AttributeError):
                        continue
                v = guard_victim(procs)
                if v is not None:
                    killed += 1
                    if not dry:
                        try:
                            who = victim_ident(v, names)
                            kill(v, signal.SIGKILL)
                            os.makedirs(os.path.dirname(log), exist_ok=True)
                            x = next(t for t in procs if t[0] == v)
                            open(log, "a").write(f"{time.strftime('%F %T')} GUARD SIGKILL {v} {x[1]} RSS {x[4]*1024:.0f} MiB adj {x[2]} {who}: MemAvailable < {pct:g} percent with a plan job running\n")
                        except OSError:
                            pass
                    sleep(10)
                    continue
        sleep(5)
    return killed


ESC_AFTER_S = 60
ESC_LOG = "/var/tmp/ot-oom-age/kills.log"
SIGLINE = re.compile(r'^(\d+(?:\.\d+)?) \S+ earlyoom\[\d+\]: sending SIGTERM to process (\d+) uid \d+ "([^"]*)":.*?cmdline "(.*)"\s*$')


def parse_sigterms(text):
    """earlyoom journal (journalctl -o short-unix) -> {pid: (first SIGTERM epoch, comm, logged cmdline)}"""
    out = {}
    for ln in text.splitlines():
        m = SIGLINE.match(ln)
        if m:
            t, pid, comm, cmd = float(m.group(1)), int(m.group(2)), m.group(3), m.group(4)
            if pid not in out or t < out[pid][0]:
                out[pid] = (t, comm, cmd)
    return out


def escalate(terms, now, hz, dry=False, kill=os.kill, log=ESC_LOG):
    """KILLSTICK_1114 (COORD): a process earlyoom SIGTERMed > ESC_AFTER_S ago that is still alive gets one SIGKILL.  Guards: same comm, the live
    cmdline matches the one earlyoom logged (prefix), and the process started before that SIGTERM (no PID reuse)."""
    n = 0
    up = None
    for pid, (t, comm, cmd) in sorted(terms.items()):
        if now - t <= ESC_AFTER_S:
            continue
        try:
            if open(f"/proc/{pid}/comm").read().strip() != comm:
                continue
            live = open(f"/proc/{pid}/cmdline").read().replace("\0", " ").strip()
            if cmd and live and not (live.startswith(cmd[:80]) or cmd.startswith(live[:80])):
                continue
            st = open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()
            up = float(open("/proc/uptime").read().split()[0])
            if time.time() - (up - int(st[19]) / hz) >= t:
                continue
            rss = int(re.search(r"VmRSS:\s+(\d+)", open(f"/proc/{pid}/status").read()).group(1)) // 1024
        except (OSError, ValueError, IndexError, AttributeError):
            continue
        n += 1
        if not dry:
            try:
                kill(pid, signal.SIGKILL)
                os.makedirs(os.path.dirname(log), exist_ok=True)
                open(log, "a").write(f"{time.strftime('%F %T')} SIGKILL {pid} {comm} RSS {rss} MiB: SIGTERMed {int(now - t)} s ago, still alive\n")
            except OSError:
                pass
    return n


def earlyoom_journal():
    try:
        return subprocess.run(["journalctl", "-u", "earlyoom", "--since", "-15min", "-o", "short-unix", "--no-pager"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def managed(cur):
    return 0 <= cur <= MAXMANAGED


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--now-offset", type=float, default=0.0)
    ap.add_argument("--comm", default="")
    ap.add_argument("--pid", type=int, nargs="*", default=[])
    ap.add_argument("--state", default=STATE)
    ap.add_argument("--no-escalate", action="store_true")
    ap.add_argument("--guard-s", type=float, default=0.0, help="PLANGUARD: stay and watch MemAvailable this many seconds (timer service: 50)")
    a = ap.parse_args(argv)
    comms = set(a.comm.split(",")) if a.comm else COMMS
    hz = os.sysconf("SC_CLK_TCK")
    now = time.time() + a.now_offset
    pids = [str(p) for p in a.pid] or [p for p in os.listdir("/proc") if p.isdigit()]
    changed = seen = 0
    first, names = load_state(a.state), container_names()
    plans = plan_pids()
    for p in pids:
        try:
            comm = open(f"/proc/{p}/comm").read().strip()
            if plans and (comm in comms or comm in PLAN_EXTRA) and (plan_key(p, names) in plans or plan_ancestor(p, plans)):
                # PLANBYPASS_1114 (OWNER 11-14 19:40): plan connectivity jobs are never the earlyoom / kernel victim while any other job can die instead
                if int(open(f"/proc/{p}/oom_score_adj").read()) != PLAN_ADJ:
                    if not a.dry_run:
                        open(f"/proc/{p}/oom_score_adj", "w").write(str(PLAN_ADJ))
                    changed += 1
                seen += 1
                continue
            if comm not in comms:
                continue
            cur = int(open(f"/proc/{p}/oom_score_adj").read())
            if not managed(cur):
                continue
            age = proc_age(p, now, hz)
            key = item_key(names.get(container_id(p) or ""))
            _age = credited_age(first, key, age, now)
            try:
                _rss = int(re.search(r"VmRSS:\s+(\d+)", open(f"/proc/{p}/status").read()).group(1)) / 1048576
            except (OSError, AttributeError, ValueError):
                _rss = 0.0
            want = victim_adj(open(f"/proc/{p}/cmdline").read().replace("\0", " "), _age, _rss)
            if late_eco_container(names.get(container_id(p) or "")):
                want = 0
            seen += 1
            if want != cur:
                if not a.dry_run:
                    open(f"/proc/{p}/oom_score_adj", "w").write(str(want))
                changed += 1
        except (OSError, ValueError, IndexError):
            continue
    if not a.dry_run:
        save_state(a.state, first, now)
    esc = 0 if a.no_escalate or a.pid else escalate(parse_sigterms(earlyoom_journal()), now, hz, a.dry_run)
    gk = guard(a.guard_s, guard_pct(), a.dry_run) if a.guard_s and not a.pid else 0
    print(f"ot-oom-age: {seen} managed, {changed} {'would change' if a.dry_run else 'changed'}, {esc} SIGKILL escalations, {gk} plan-guard kills")
    return 0


if __name__ == "__main__":
    sys.exit(main())
