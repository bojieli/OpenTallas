#!/bin/bash
# ot-docker-bdi-cap (FLEET-EPYC7-R1 11-22): cap dirty pages on the disk holding the docker data root.
# Why: overlay umount syncfs-es the whole fs; with ~100 GB dirty on a slow/shared scratch disk, dockerd
# blocked 2 h on epyc7 (11-22 03:10-05:14 UTC). Cap = OT_BDI_MAX_BYTES (default 4 GiB), strict_limit=1.
# Installed by install_fleet_host.sh with systemd/ot-docker-bdi-cap.service and 90-ot-dirty.conf (sysctl.d).
set -u
MAX=${OT_BDI_MAX_BYTES:-4294967296}
R=$(python3 -I -c 'import json;print(json.load(open("/etc/docker/daemon.json")).get("data-root",""))' 2>/dev/null)
[ -n "$R" ] || R=/var/lib/docker
R=$(readlink -f "$R")
src=$(findmnt -no SOURCE --target "$R"); src=${src%%[*}
pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1); [ -n "$pk" ] || pk=$(basename "$src")
mm=$(lsblk -dno MAJ:MIN "/dev/$pk" | tr -d ' ')
B=/sys/class/bdi/$mm
[ -w "$B/max_bytes" ] || { echo "ot-docker-bdi-cap: no bdi for $R ($src $pk $mm)" >&2; exit 1; }
echo "$MAX" > "$B/max_bytes" && echo 1 > "$B/strict_limit"
echo "ot-docker-bdi-cap: $R on $src disk $pk bdi $mm max_bytes=$(cat $B/max_bytes) strict_limit=$(cat $B/strict_limit)"
