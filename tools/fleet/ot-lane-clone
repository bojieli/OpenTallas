#!/usr/bin/env python3
"""ot-lane-clone [--ref REF] [--cone PATH,...] DEST   (FLEET-OPS-R, COORD FABLE-FLOW-0700 (3))
A lane's working checkout of main as a sparse git worktree of ONE warm bare repo per host, not a raw checkout: two raw 49 GB checkouts filled epyc7
(41 -> 1 GB in 12 min).  Default cone = tools + rtl (about 1.5 GB).  Steps: (1) warm bare repo $OT_WARM (default <scratch2>/claude/warm/OpenTallas.git; made once with
git clone --bare --filter=blob:none from OT_LANE_ORIGIN, then only fetched), (2) `git worktree add --no-checkout --detach DEST REF`, (3) sparse-checkout cone, (4) checkout.
Refuses DEST on a disk with less than OT_LANE_MIN_FREE_GB (default 100) free, DEST outside /srv/opentallas-scratch*, an existing non-empty DEST.  --dry prints the plan.
To widen the cone later: git -C DEST sparse-checkout add <dir>   (never a full checkout)."""
import argparse, os, subprocess, sys

DEFAULT_CONE = "tools,rtl"
ORIGIN = os.environ.get("OT_LANE_ORIGIN", "ubuntu@185.8.106.226:/srv/opentallas-scratch2/git/OpenTallas.git")
WARM = os.environ.get("OT_WARM", "/srv/opentallas-scratch2/claude/warm/OpenTallas.git")
MIN_FREE_GB = float(os.environ.get("OT_LANE_MIN_FREE_GB", "100"))


def free_gb(path):
    p = path
    while not os.path.exists(p) and p != "/":
        p = os.path.dirname(p)
    s = os.statvfs(p)
    return s.f_bavail * s.f_frsize / 2**30


def plan(dest, ref, cone, warm=WARM, origin=ORIGIN):
    """-> [argv] the commands, in order (pure: tests check it)"""
    steps = []
    if not os.path.isdir(warm):
        steps.append(["git", "clone", "--bare", "--filter=blob:none", origin, warm])
    # COORD 11-17 (epyc2: the fetch refused to update a branch a retired lane's worktree still had checked out): the warm repo fetches into refs/remotes/origin/*, which no worktree can
    # have checked out, never into refs/heads/*.  A lane clone is a DETACHED worktree of origin/<ref>, so no lane ever holds a branch of the warm repo either.
    steps.append(["git", "-C", warm, "fetch", "-q", "origin", "+refs/heads/*:refs/remotes/origin/*"])
    if not ref.startswith(("refs/", "origin/")) and len(ref) < 40:
        ref = "refs/remotes/origin/" + ref
    steps += [["git", "-C", warm, "worktree", "add", "--no-checkout", "--detach", dest, ref],
              ["git", "-C", dest, "sparse-checkout", "init", "--cone"],
              ["git", "-C", dest, "sparse-checkout", "set", *cone],
              ["git", "-C", dest, "checkout", "-q"]]
    return steps


def check(dest, min_free=None):
    """-> '' or why not"""
    dest = os.path.abspath(dest); min_free = MIN_FREE_GB if min_free is None else min_free
    if not dest.startswith("/srv/opentallas-scratch"):
        return "DEST must be under /srv/opentallas-scratch*"
    if os.path.exists(dest) and os.listdir(dest):
        return "DEST exists and is not empty"
    if free_gb(dest) < min_free:
        return "only %.0f GB free < OT_LANE_MIN_FREE_GB %g" % (free_gb(dest), min_free)
    return ""


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dest"); ap.add_argument("--ref", default="main"); ap.add_argument("--cone", default=DEFAULT_CONE)
    ap.add_argument("--dry", action="store_true")
    a = ap.parse_args(argv)
    dest = os.path.abspath(a.dest); why = check(dest)
    if why:
        print("ot-lane-clone: refused: " + why, file=sys.stderr); return 2
    steps = plan(dest, a.ref, [c for c in a.cone.split(",") if c])
    for s in steps:
        print("+ " + " ".join(s), file=sys.stderr)
        if not a.dry and subprocess.run(s).returncode:
            print("ot-lane-clone: step failed", file=sys.stderr); return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
