#!/bin/bash
# git-history-shim (FLOW-OPS-1000, FABLE-FLOW-1000 g; COORD rule 11-21 GIT SEARCHES): installed as ~/.local/bin/git on every gen host.
# A git history search (log / rev-list / whatchanged / shortlog with -S / -G / --all / --pickaxe-* / --find-object, or rev-list --all)
# started without a terminal on stdin runs under `timeout 600` (TERM, KILL 30 s later), so an orphaned search can no longer hold
# deleted packs open for hours (epyc8 + intel2 437 GB, epyc7 pid 2832979 43.7 GB on 11-21).  Every other git call is exec'd unchanged.
# OT_GIT_SEARCH_TIMEOUT=<s> changes the limit (0 = no limit); OT_REAL_GIT names the real binary (default /usr/bin/git).
real=${OT_REAL_GIT:-/usr/bin/git}
[ -x "$real" ] || real=$(PATH=/usr/local/bin:/usr/bin:/bin command -v git)
lim=${OT_GIT_SEARCH_TIMEOUT:-600}
if [ "$lim" != 0 ] && ! [ -t 0 ]; then
  sub= ; skip=0
  for a in "$@"; do
    if [ $skip = 1 ]; then skip=0; continue; fi
    if [ -z "$sub" ]; then
      case "$a" in
        -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env) skip=1; continue;;
        -*) continue;;
        *) sub=$a; continue;;
      esac
    fi
    case "$sub" in
      log|rev-list|whatchanged|shortlog)
        case "$a" in
          -S*|-G*|--all|--pickaxe-*|--find-object*|--reflog) exec timeout -k 30 "$lim" "$real" "$@";;
        esac;;
      *) break;;
    esac
  done
fi
exec "$real" "$@"
