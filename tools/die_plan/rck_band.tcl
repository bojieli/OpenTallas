uplevel #0 {
set rb_blk [ord::get_db_block]; set rb_dbu [$rb_blk getDbUnitsPerMicron]
set rb_top [expr {round($::env(OT_RCK_BAND_TOP_UM) * $rb_dbu)}]
set rb_m [$rb_blk findInst $::env(OT_RCK_BAND_INST)]
if {$rb_m eq "NULL"} { error "OT_RCK_BAND receiver macro $::env(OT_RCK_BAND_INST) not in the block" }
