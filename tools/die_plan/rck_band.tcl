foreach r [$rb_blk getRows] {
  set oy [lindex [$r getOrigin] 1]; set h [[$r getSite] getHeight]
  if {$oy + $h <= $rb_top - 2*$h} { lappend rb_rows [list $oy $r] }
}
set rb_rows [lrange [lsort -integer -decreasing -index 0 $rb_rows] 0 [expr {$::env(OT_RCK_BAND_ROWS) - 1}]]
set rb_targets {}
if {$rb_m ne "NULL"} {
  foreach it [$rb_m getITerms] {
    if {![$it isOutputSignal]} continue
    set net [$it getNet]; if {$net eq "NULL"} continue
    set bb [$it getBBox]; set px [expr {([$bb xMin]+[$bb xMax])/2}]
    set front [list $net]; set seen {}
