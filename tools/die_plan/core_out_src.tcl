# GENERATED by tools/die_plan/gen.py phys (appended to face_flops.tcl, PRE_GLOBAL_PLACE, AFTER core_out_land.tcl) for the
# types listed in plan budgets.core_out_src_types (or GEN env OT_CORE_OUT_SRC=1): core-to-core register chains keep
# their stages at the SOURCE pin, so the one hard-core crossing of the link falls on the last hop into the core input.
# Why (KIT-NK-SRCPIN 11-11, CPL-QC-NK-OUT pilot1, QC cbn_q11 a14): core_out_land.tcl lands r[0] of an NK output chain
# (ot_dp_dly u_d<N>: r[0] .. r[N-2], q) at the NK pin and closes hop 1 (TT -824 -> +15), but wirelength GPL then puts
# r[1] / q in the middle channel, so the 458-um NK crossing sits on the fabric->fabric hop r[0] -> r[1] (budget ~587 ps
# of wire; one crossing costs ~600-680 ps, no repeater or register can sit over the core): TT -11..-90, tail -404.
# The hop into an NK input has ~630-790 ps (measured q -> n_a across t32: +147..+248).  Rule, per landing flop placed
# by core_out_land.tcl: follow its Q through <= 4 BUF/INV/HB cells while each stage is a movable flop D whose Q has ONE
# leaf load; the chain must end at a hard-core INPUT pin.  When the Manhattan L route source pin -> destination pin
# crosses EXACTLY ONE hard-core outline (best of the two L orders; outlines shrunk by 0.5 um so a face pin is not
# inside its own core) and is <= OT_CORE_OUT_SRC_REACH_UM (default 900) long, every stage after r[0] is placed FIRM
# beside r[0] (same site search and row reservation as core_out_land.tcl); face_flops_release.tcl releases them with
# the landing flops (ot_core_out_land.txt) before DPL.  It runs before GPL and so before the resize step: repair_design
# buffers the long last hop with the stages already fixed (chain_even.tcl runs after resize and cannot do this).
# Chains with 0 crossings stay with GPL.  Chains with >= 2 crossings stay with GPL too: with every register off the
# cores one crossing must sit on a fabric hop whatever the stage placement, which is an S2 floorplan item (orient /
# move a core), reported in ot_core_out_src.tsv and the summary line.  Netlist unchanged, 0 cycles.
uplevel #0 {
if {![info exists col_occ] || ![file exists $::env(RESULTS_DIR)/ot_core_out_land.txt]} {
  puts "OT_CORE_OUT_SRC skipped: core_out_land.tcl did not run (OT_CORE_OUT_LAND=1 is required)"
} else {
set cos_reach [expr {[info exists ::env(OT_CORE_OUT_SRC_REACH_UM)] ? double($::env(OT_CORE_OUT_SRC_REACH_UM)) : 900.0}]
set cos_eps [expr {int(0.5 * $col_dbu)}]
set cos_mac {}
foreach i [$col_blk getInsts] {
  if {[[$i getMaster] isBlock]} {
    set b [$i getBBox]
    lappend cos_mac [list [expr {[$b xMin]+$cos_eps}] [expr {[$b yMin]+$cos_eps}] [expr {[$b xMax]-$cos_eps}] [expr {[$b yMax]-$cos_eps}]]
  }
}
# number of core outlines an axis-parallel segment passes through (strictly inside the shrunk outline)
proc cos_hits {x0 y0 x1 y1 hit} {
  upvar $hit h
  set xa [expr {min($x0, $x1)}]; set xb [expr {max($x0, $x1)}]
  set ya [expr {min($y0, $y1)}]; set yb [expr {max($y0, $y1)}]
  set k 0
  foreach m $::cos_mac {
    lassign $m a b c d
    if {$xb > $a && $xa < $c && $yb > $b && $ya < $d} { dict set h $k 1 }
    incr k
  }
}
proc cos_crossings {sx sy dx dy} {
  set hv {}; cos_hits $sx $sy $dx $sy hv; cos_hits $dx $sy $dx $dy hv
  set vh {}; cos_hits $sx $sy $sx $dy vh; cos_hits $sx $dy $dx $dy vh
  return [expr {min([dict size $hv], [dict size $vh])}]
}
# leaf loads of a flop's output nets through <= 4 BUF/INV/HB (core_out_land.tcl walk): ITerms, PORT for a BTerm
proc cos_leaves {f} {
  set leaves {}; set front {}; set seen {}
  foreach it [$f getITerms] {
    if {[$it isOutputSignal] && [$it getNet] ne "NULL"} { lappend front [list [$it getNet] 0] }
  }
  while {[llength $front]} {
    lassign [lindex $front 0] nt d; set front [lrange $front 1 end]
    if {[dict exists $seen $nt]} continue
    dict set seen $nt 1
    if {[llength [$nt getBTerms]]} { lappend leaves PORT }
    foreach s [$nt getITerms] {
      if {![$s isInputSignal]} continue
      set g [$s getInst]
      if {$d < 4 && ![[$g getMaster] isBlock] && [col_isbuf $g]} {
        foreach o [$g getITerms] { if {[$o isOutputSignal] && [$o getNet] ne "NULL"} { lappend front [list [$o getNet] [expr {$d + 1}]] } }
      } else { lappend leaves $s }
    }
  }
  return $leaves
}
# the hard-core output pin that drives flop f's D through <= 4 BUF/INV/HB, or ""
proc cos_src_pin {f} {
  set di [$f findITerm D]; if {$di eq "NULL" || $di eq ""} { return "" }
  set net [$di getNet]
  for {set d 0} {$d <= 4 && $net ne "NULL"} {incr d} {
    set drv ""
    foreach s [$net getITerms] { if {[$s isOutputSignal]} { set drv $s; break } }
    if {$drv eq ""} { return "" }
    set g [$drv getInst]
    if {[[$g getMaster] isBlock]} { return $drv }
    if {![col_isbuf $g]} { return "" }
    set net "NULL"
    foreach s [$g getITerms] { if {[$s isInputSignal] && [$s getNet] ne "NULL"} { set net [$s getNet]; break } }
  }
  return ""
}
proc cos_xy {it} {
  lassign [$it getAvgXY] ok x y
  if {!$ok} { set b [[$it getInst] getBBox]; set x [expr {([$b xMin]+[$b xMax])/2}]; set y [expr {([$b yMin]+[$b yMax])/2}] }
  return [list $x $y]
}
set cos_fh [open $::env(RESULTS_DIR)/ot_core_out_land.txt r]
set cos_land [split [string trim [read $cos_fh]] "\n"]
close $cos_fh
set cos_rep [open $::env(RESULTS_DIR)/ot_core_out_src.tsv w]
puts $cos_rep "landing\tsrc_pin\tdst_pin\tstages\tcrossings\tmanhattan_um\taction"
set cos_add {}
set cos_n 0; set cos_ch 0; set cos_c0 0; set cos_c2 0; set cos_far 0; set cos_shape 0; set cos_nosite 0
foreach ln $cos_land {
  if {$ln eq ""} continue
  set f [$col_blk findInst $ln]
  if {$f eq "NULL" || $f eq ""} continue
  set sp [cos_src_pin $f]
  if {$sp eq ""} { incr cos_shape; continue }
  # follow the chain: one leaf per stage, movable flop D pins, ending at a hard-core input pin
  set stages {}; set dst ""; set cur $f
  for {set k 0} {$k < 64} {incr k} {
    set lv [cos_leaves $cur]
    if {[llength $lv] != 1 || [lindex $lv 0] eq "PORT"} break
    set s [lindex $lv 0]; set g [$s getInst]
    if {[[$g getMaster] isBlock]} { set dst $s; break }
    if {![string match "*DFF*" [[$g getMaster] getName]] || [[$s getMTerm] getName] ne "D"} break
    if {[$g getPlacementStatus] in {FIRM LOCKED COVER}} break
    lappend stages $g; set cur $g
  }
  set spn "[[$sp getInst] getName]/[[$sp getMTerm] getName]"
  if {$dst eq "" || ![llength $stages]} {
    incr cos_shape
    puts $cos_rep "[$f getName]\t$spn\t-\t[llength $stages]\t-\t-\tskip_shape"
    continue
  }
  incr cos_ch
  lassign [cos_xy $sp] sx sy
  lassign [cos_xy $dst] dx dy
  set dpn "[[$dst getInst] getName]/[[$dst getMTerm] getName]"
  set nc [cos_crossings $sx $sy $dx $dy]
  set mh [expr {(abs($dx - $sx) + abs($dy - $sy)) / double($col_dbu)}]
  set act src
  if {$nc == 0} { set act skip_no_crossing; incr cos_c0 }
  if {$nc >= 2} { set act skip_multi_crossing; incr cos_c2 }
  if {$nc == 1 && $mh > $cos_reach} { set act skip_reach; incr cos_far }
  if {$act eq "src"} {
    lassign [$f getLocation] fx fy
    foreach g $stages {
      set w [[$g getMaster] getWidth]
      set best {}
      for {set r 1} {$r < 400 && $best eq {}} {incr r} {
        set dd [expr {$r * $col_step}]
        foreach {ox oy} [list 0 $dd 0 -$dd $dd 0 -$dd 0 $dd $dd -$dd $dd $dd -$dd -$dd -$dd] {
          set cx [expr {$col_x0 + (($fx + $ox - $col_x0) / $col_sw) * $col_sw}]
          set cy [expr {$col_y0 + (($fy + $oy - $col_y0) / $col_rh) * $col_rh}]
          if {[dict exists $col_occ "$cx,$cy"] || ![col_free $cx $cy $w]} continue
          set best [list $cx $cy]; break
        }
      }
      if {$best eq {}} { set act src_partial; incr cos_nosite; break }
      lassign $best cx cy
      for {set k -24} {$k <= 36} {incr k} { dict set col_occ "[expr {$cx + $k * $col_sw}],$cy" 1 }
      $g setLocation $cx $cy
      if {[dict exists $col_orient $cy]} { $g setOrient [dict get $col_orient $cy] }
      $g setPlacementStatus FIRM
      lappend cos_add [$g getName]
      incr cos_n
    }
  }
  puts $cos_rep [format "%s\t%s\t%s\t%d\t%d\t%.1f\t%s" [$f getName] $spn $dpn [llength $stages] $nc $mh $act]
}
close $cos_rep
set cos_fh [open $::env(RESULTS_DIR)/ot_core_out_land.txt a]
foreach n $cos_add { puts $cos_fh $n }
close $cos_fh
puts "OT_CORE_OUT_SRC placed $cos_n chain stages FIRM at their source pins on [expr {$cos_ch - $cos_c0 - $cos_c2 - $cos_far}] one-crossing core->core chains of $cos_ch (left to GPL: $cos_c0 without a core crossing, $cos_c2 with >= 2 crossings = S2 floorplan item, $cos_far beyond $cos_reach um; $cos_shape landing flops not on a single-load chain into a core input; $cos_nosite without a free site)"
}
