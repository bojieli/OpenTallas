# GENERATED by tools/die_plan/gen.py phys (POST_GLOBAL_ROUTE hook, density kits; OWNER decision 5 (d), 10-24): the
# local tap trees measured -- and with OT_TAP_GRT_MODE=grt re-balanced -- on GLOBAL-ROUTE RC.  The POST_CTS pass
# (tap_balance.tcl) balanced every tree to the common latency (OT_TAP_TARGET_PS) within OT_TAP_WINDOW_PS on placement
# RC; GRT RC is closer to the routed tree.  Mode (plan clock.tap_balance_rc):
#   grt_report  OT_TAP_RC lines on the GRT parasitics ORFS just estimated (no netlist change)
#   grt         tap_balance.tcl again with OT_TAP_EST=grt: short trees get delay cells (tag 'g'), each edit inside
#               global_route -start/-end_incremental, then GRT parasitics re-estimated and route.guide re-written
#               (ORFS wrote the guides just before this hook; detailed routing reads them)
set tbg_mode [expr {[info exists ::env(OT_TAP_GRT_MODE)] ? $::env(OT_TAP_GRT_MODE) : "grt_report"}]
set tbg_dir [file dirname [file normalize [info script]]]
if {$tbg_mode eq "grt"} {
  set ::env(OT_TAP_EST) grt
  set ::env(OT_TAP_TAG) g
  set ::env(OT_TAP_REPORT_ONLY) 0
  source [file join $tbg_dir tap_balance.tcl]
  if {$::tb_added > 0} {
    estimate_parasitics -global_routing
    write_guides $::env(RESULTS_DIR)/route.guide
  }
  puts "OT_TAP_GRT rebalance: $::tb_added delay cells on GRT RC; route.guide re-written: [expr {$::tb_added > 0}]"
} elseif {$tbg_mode eq "grt_report"} {
  set ::env(OT_TAP_EST) grt
  set ::env(OT_TAP_REPORT_ONLY) 1
  source [file join $tbg_dir tap_balance.tcl]
} else {
  puts "OT_TAP_GRT skipped (mode $tbg_mode)"
}
