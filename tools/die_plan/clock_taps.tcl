# GENERATED by tools/die_plan/gen.py phys (PRE_CTS hook, COORD 10-23 R4): local clock trees under a tap grid.
# The type has one clock port per die-spine tap (clk, clk_t1, ...; pitch <= 600 um, schema.tap_grid).  The RTL
# clocks every flop from 'clk'; here every sink on the clk net moves to the net of its NEAREST tap port, so CTS builds
# one local tree per tap (radius <= ~300 um) instead of one tree from one interior tap (CP1: 1176 ps, 29-32 levels).
# QC-A0 10-24: the tap port family is OT_TAP_PORT (default clk: plan partitions clk / clk_t<i>; the A0 hard cores
# ck / ck_t<i>), so hard-core kits use this tool unchanged instead of private copies.
set ct_port [expr {[info exists ::env(OT_TAP_PORT)] ? $::env(OT_TAP_PORT) : "clk"}]
set ct_blk [ord::get_db_block]
set ct_taps {}
foreach bt [$ct_blk getBTerms] {
  set n [$bt getName]
  if {![regexp "^${ct_port}(_t\[0-9\]+)?\$" $n]} continue
  set bb [$bt getBBox]
  set net [$bt getNet]
  if {$net eq "NULL" || $net eq ""} {
    set net [odb::dbNet_create $ct_blk "${n}_net"]
    $bt connect $net
  }
  $net setSigType CLOCK
  # PATH-QC-NK 10-25: a CORE-ONLY tap (OT_CORE_ONLY_TAPS, space-separated port names) carries only the hard-core clock
  # pins OT_CORE_TAPS hangs on it; it is no grid tap, so the nearest-tap split and the cap pass never move a flop onto it
  # (a register sharing a tap with a core is balanced by CTS to core pin + ETM insertion: nk_r4 ck_t28 396 ps).
  # PATH-QC-NK2 10-25: comma- or space-separated (ref_tile orfs_vars values carry no whitespace)
  if {[info exists ::env(OT_CORE_ONLY_TAPS)] && $n in [split $::env(OT_CORE_ONLY_TAPS) ", "]} { puts "OT_CLOCK_TAPS core-only tap $n"; continue }
  lappend ct_taps [list $n $net [expr {([$bb xMin] + [$bb xMax]) / 2}] [expr {([$bb yMin] + [$bb yMax]) / 2}]]
}
# CP2 (COORD 10-23): EARLY core taps (gen.py phys core_taps.txt, env OT_CORE_TAPS; plan clock.taps[] kind 'core' with
# clock.core_taps 'early').  Each line `port inst pin|*`: the hard core's clock pin(s) leave the clk net for the core
# tap port's own net BEFORE the nearest-tap split, so the core hangs on the tap the spine delivers early (its internal
# clock latency exceeds the common latency).  Ports clk_c<k> are not grid taps: no flop is ever moved onto them.
if {[info exists ::env(OT_CORE_TAPS)] && [file exists $::env(OT_CORE_TAPS)]} {
  set ct_root [[$ct_blk findBTerm $ct_port] getNet]
  set fh [open $::env(OT_CORE_TAPS)]; set ct_cl [split [read $fh] "\n"]; close $fh
  foreach l $ct_cl {
    if {[string match "#*" $l] || [llength $l] < 3} continue
    lassign $l port iname pin
    set bt [$ct_blk findBTerm $port]
    set inst [$ct_blk findInst $iname]
    if {$bt eq "NULL" || $bt eq "" || $inst eq "NULL" || $inst eq ""} {
      puts "OT_CLOCK_TAPS WARN core tap $port: port or core instance $iname missing"
      continue
    }
    set net [$bt getNet]
    if {$net eq "NULL" || $net eq ""} {
      set net [odb::dbNet_create $ct_blk "${port}_net"]
      $bt connect $net
    }
    $net setSigType CLOCK
    set k 0
    foreach it [$inst getITerms] {
      set n0 [$it getNet]
      if {$n0 eq "NULL" || $n0 eq "" || $n0 ne $ct_root} continue
      if {$pin ne "*" && [[$it getMTerm] getName] ne $pin} continue
      $it disconnect
      $it connect $net
      incr k
    }
    puts "OT_CLOCK_TAPS core tap $port <- $iname/$pin: $k clock pin(s)"
    if {!$k} { puts "OT_CLOCK_TAPS WARN core tap $port: no clock pin of $iname/$pin on clk" }
  }
}
if {[llength $ct_taps] < 2} {
  puts "OT_CLOCK_TAPS single tap: nothing to split"
} else {
  set root [[$ct_blk findBTerm $ct_port] getNet]
  set cnt {}
  set moved 0
  foreach it [$root getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set i [$it getInst]
    set loc [$i getLocation]
    set x [lindex $loc 0]; set y [lindex $loc 1]
    set best ""; set bd 0
    foreach tp $ct_taps {
      set d [expr {abs($x - [lindex $tp 2]) + abs($y - [lindex $tp 3])}]
      if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
    }
    dict incr cnt [lindex $best 0]
    if {[lindex $best 1] ne $root} {
      $it disconnect
      $it connect [lindex $best 1]
      incr moved
    }
  }
  puts "OT_CLOCK_TAPS [llength $ct_taps] taps, $moved sinks moved off $ct_port: [lsort -stride 2 -index 0 $cnt]"
}
# COORD 10-23: size taps by SINK COUNT.  No tap keeps more than OT_TAP_MAX_SINKS (~3k): the sinks of an over-full
# tap that cost the least extra distance move to their next-nearest tap with room (capacity-constrained nearest
# assignment), so dense regions spread over the neighbouring taps instead of one deep tree (CP1 r6: 3.6-4.8k-sink
# taps 300-313 ps while 9 of 16 taps were empty; a buffer split behind the tap measured worse, 437 ps).
set ct_cap [expr {[info exists ::env(OT_TAP_MAX_SINKS)] ? $::env(OT_TAP_MAX_SINKS) : 3000}]
# a re-assigned sink may add at most half a tap pitch of distance (CP1 r6 probe: sinks moved ~300 um to an empty
# tap gave 465-ps trees); a dense region beyond that needs a finer tap pitch, not longer trees
set ct_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set ct_maxx [expr {0.5 * ([info exists ::env(OT_TAP_PITCH_UM)] ? $::env(OT_TAP_PITCH_UM) : 600.0) * $ct_dbu}]
if {[llength $ct_taps] >= 2} {
  set ct_by {}
  foreach tp $ct_taps {
    set l {}
    foreach it [[lindex $tp 1] getITerms] {
      # PATH-QC-NK 10-25: a hard core's clock pin stays on the tap OT_CORE_TAPS / the split chose (never a cap move)
      if {[info exists ::env(OT_CORE_TAPS)] && [[[$it getInst] getMaster] isBlock]} continue
      if {[[$it getMTerm] getIoType] eq "INPUT"} { lappend l $it }
    }
    dict set ct_by [lindex $tp 0] $l
  }
  set ct_moves 0
  set ct_stuck {}
  for {set pass 0} {$pass < 8 * [llength $ct_taps]} {incr pass} {
    set over ""
    foreach tp $ct_taps {
      if {[lindex $tp 0] ni $ct_stuck && [llength [dict get $ct_by [lindex $tp 0]]] > $ct_cap} { set over $tp; break }
    }
    if {$over eq ""} break
    set on [lindex $over 0]
    set excess [expr {[llength [dict get $ct_by $on]] - $ct_cap}]
    # extra distance of each sink to every other tap with room
    set cand {}
    foreach it [dict get $ct_by $on] {
      set loc [[$it getInst] getLocation]; set x [lindex $loc 0]; set y [lindex $loc 1]
      set d0 [expr {abs($x - [lindex $over 2]) + abs($y - [lindex $over 3])}]
      set best ""; set bd 0
      foreach tp $ct_taps {
        if {[lindex $tp 0] eq $on || [llength [dict get $ct_by [lindex $tp 0]]] >= $ct_cap} continue
        set d [expr {abs($x - [lindex $tp 2]) + abs($y - [lindex $tp 3]) - $d0}]
        if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
      }
      if {$best ne "" && $bd <= $ct_maxx} { lappend cand [list $bd $it $best] }
    }
    if {![llength $cand]} {
      # COORD 10-23 19:55: sinks per tap are guidance (WARN), not a gate
      puts "OT_CLOCK_TAPS WARN $on keeps [llength [dict get $ct_by $on]] sinks > cap $ct_cap: no tap with room within [format %.0f [expr {$ct_maxx / $ct_dbu}]] um (finer clock.tap_pitch_um)"
      lappend ct_stuck $on
      continue
    }
    set cand [lsort -real -index 0 $cand]
    # move the cheapest sinks toward ONE target per pass (keeps targets under cap), then re-evaluate
    set tgt [lindex $cand 0 2]; set tn [lindex $tgt 0]
    set room [expr {$ct_cap - [llength [dict get $ct_by $tn]]}]
    set keep [dict get $ct_by $on]; set add [dict get $ct_by $tn]
    set n 0
    foreach c $cand {
      if {$n >= $excess || $n >= $room} break
      if {[lindex $c 2 0] ne $tn} continue
      set it [lindex $c 1]
      $it disconnect; $it connect [lindex $tgt 1]
      set keep [lsearch -all -inline -not -exact $keep $it]
      lappend add $it
      incr n
    }
    dict set ct_by $on $keep; dict set ct_by $tn $add
    incr ct_moves $n
  }
  set l {}
  foreach tp $ct_taps { lappend l "[lindex $tp 0] [llength [dict get $ct_by [lindex $tp 0]]]" }
  puts "OT_CLOCK_TAPS cap $ct_cap sinks/tap: $ct_moves sinks re-assigned; per tap: [join $l {, }]"
}
# COORD 10-23 (CP1 r9: 7 of 16 grid taps over macros / empty areas): per-tap sink counts after the cap pass, and
# every tap that got NO sink is DROPPED: its port stays (plan pins unchanged) but carries no tree, and the die
# assembly (gen.py assembly, views/<type>/ot_clock_taps.json) leaves it unconnected, so the spine makes no dead drop.
if {[llength $ct_taps] >= 2} {
  set ct_js {}
  set ct_empty {}
  foreach tp $ct_taps {
    set k 0
    foreach it [[lindex $tp 1] getITerms] { if {[[$it getMTerm] getIoType] eq "INPUT"} { incr k } }
    lappend ct_js "\"[lindex $tp 0]\": $k"
    if {$k == 0} { lappend ct_empty "\"[lindex $tp 0]\"" }
  }
  if {[info exists ::env(RESULTS_DIR)]} {
    set fh [open $::env(RESULTS_DIR)/ot_clock_taps.json w]
    puts $fh "{\"sinks\": {[join $ct_js {, }]}, \"dropped\": \[[join $ct_empty {, }]\]}"
    close $fh
  }
  puts "OT_CLOCK_TAPS per-tap sinks: [join $ct_js {, }]; dropped (no sinks): [llength $ct_empty] [join $ct_empty { }]"
}
