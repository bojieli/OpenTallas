# GENERATED by tools/die_plan/gen.py phys (PRE_CTS hook, COORD 10-23 R4): local clock trees under a tap grid.
# The type has one clock port per die-spine tap (clk, clk_t1, ...; pitch <= 600 um, schema.tap_grid).  The RTL
# clocks every flop from 'clk'; here every sink on the clk net moves to the net of its NEAREST tap port, so CTS builds
# one local tree per tap (radius <= ~300 um) instead of one tree from one interior tap (CP1: 1176 ps, 29-32 levels).
# QC-A0 10-24: the tap port family is OT_TAP_PORT (default clk: plan partitions clk / clk_t<i>; the A0 hard cores
# ck / ck_t<i>), so hard-core kits use this tool unchanged instead of private copies.
global ct_taps ct_k ct_pinned ct_grp ct_blk ct_fre ct_group_owned ct_fixed ct_fixed_taps
set ct_port [expr {[info exists ::env(OT_TAP_PORT)] ? $::env(OT_TAP_PORT) : "clk"}]
set ct_blk [ord::get_db_block]
set ct_taps {}
foreach bt [$ct_blk getBTerms] {
  set n [$bt getName]
  if {![regexp "^${ct_port}(_t\[0-9\]+)?\$" $n]} continue
  set bb [$bt getBBox]
  set net [$bt getNet]
  if {$net eq "NULL" || $net eq ""} {
    set net [odb::dbNet_create $ct_blk "${n}_net"]
    $bt connect $net
  }
  $net setSigType CLOCK
  # PATH-QC-NK 10-25: a CORE-ONLY tap (OT_CORE_ONLY_TAPS, space-separated port names) carries only the hard-core clock
  # pins OT_CORE_TAPS hangs on it; it is no grid tap, so the nearest-tap split and the cap pass never move a flop onto it
  # (a register sharing a tap with a core is balanced by CTS to core pin + ETM insertion: nk_r4 ck_t28 396 ps).
  if {[info exists ::env(OT_CORE_ONLY_TAPS)] && $n in $::env(OT_CORE_ONLY_TAPS)} { puts "OT_CLOCK_TAPS core-only tap $n"; continue }
  # KV-PC-DELTA-1115 (opt-in OT_TAP_SKIP_MACRO=1, plan clock.tap_skip_macro): a grid tap whose port sits over a hard macro
  # takes no sink (CTS cannot root a tree over a macro: kv3_pc_v1 cl4ea58a5c had 8); like a core-only tap it stays in the plan
  # pins and is dropped with the empty taps below.
  set ct_x [expr {([$bb xMin] + [$bb xMax]) / 2}]; set ct_y [expr {([$bb yMin] + [$bb yMax]) / 2}]
  if {[info exists ::env(OT_TAP_SKIP_MACRO)] && $::env(OT_TAP_SKIP_MACRO) eq "1"} {
    set ct_onmac 0
    foreach ct_i [$ct_blk getInsts] {
      if {[catch {[$ct_i getMaster] isBlock} ct_ib] || $ct_ib ne "1"} continue
      set ct_mb [$ct_i getBBox]
      if {$ct_x > [$ct_mb xMin] && $ct_x < [$ct_mb xMax] && $ct_y > [$ct_mb yMin] && $ct_y < [$ct_mb yMax]} { set ct_onmac 1; break }
    }
    if {$ct_onmac} { puts "OT_CLOCK_TAPS skip tap $n over macro [$ct_i getName]"; continue }
  }
  lappend ct_taps [list $n $net [expr {([$bb xMin] + [$bb xMax]) / 2}] [expr {([$bb yMin] + [$bb yMax]) / 2}]]
}
# SerDes physical clock edits may change a grid tap, never a functional clock
# gate, inversion edge, forwarded-clock authority, or a gated FF's clock net.
# Capture BEFORE even the ordinary nearest-tap pass. Buffer-only clock wiring
# is transparent; every INV and functional driver/control net remains explicit.
global ct_clock_guard_on ct_clock_guard_roots ct_clock_guard_before ct_clock_guard_cache
set ct_clock_guard_on [expr {([info exists ::env(OT_TAP_CLOCK_ANCESTRY_GUARD)] && $::env(OT_TAP_CLOCK_ANCESTRY_GUARD) eq "1") || ([info exists ::env(OT_SERDES_INGRESS_COHORT)] && $::env(OT_SERDES_INGRESS_COHORT) eq "1") || ([info exists ::env(OT_SERDES_RESET_COHORT)] && $::env(OT_SERDES_RESET_COHORT) eq "1")}]
set ct_clock_guard_roots {};set ct_clock_guard_before {};set ct_clock_guard_cache {}
foreach tap $ct_taps {dict set ct_clock_guard_roots [[lindex $tap 1] getName] 1}
proc ct_clock_signature {net {depth 0}} {
 global ct_clock_guard_roots ct_clock_guard_cache
 if {$net eq "NULL" || $net eq ""} {return {DISCONNECTED}}
 set name [$net getName]
 if {[dict exists $ct_clock_guard_roots $name]} {return {LOCAL_CORE_TAP}}
 if {[dict exists $ct_clock_guard_cache $name]} {return [dict get $ct_clock_guard_cache $name]}
 if {$depth>128} {error "clock ancestry recursion/cycle at $name"}
 set ports {}
 if {![catch {$net getBTerms} bterms]} {
  foreach bt $bterms {if {[$bt getIoType] in {INPUT INOUT}} {lappend ports [$bt getName]}}
 }
 if {[llength $ports]} {set sig [list PORT [lsort $ports]]} else {
  set drivers {};set transparent {}
  foreach pin [$net getITerms] {
   if {[[$pin getMTerm] getIoType] ne "OUTPUT"} continue
   set inst [$pin getInst];set master [[$inst getMaster] getName]
   set inputs {};set wiring {}
   foreach ip [$inst getITerms] {
    if {[[$ip getMTerm] getIoType] ne "INPUT"} continue
    set pn [[$ip getMTerm] getName];set nn [$ip getNet]
    if {$nn eq "NULL" || $nn eq ""} {set is {DISCONNECTED}
    } elseif {[dict exists $ct_clock_guard_roots [$nn getName]] || [regexp {^(BUF|INV)} $master] || $pn in {CLK CLKN CK CKN CP CLKIN CKIN}} {
      set is [ct_clock_signature $nn [expr {$depth+1}]]
    } else {set is [list CONTROL_NET [$nn getName]]}
    lappend inputs [list $pn $is];lappend wiring $is
   }
   set pass_buffer 0
   if {[regexp {^BUF} $master] && [llength $wiring]==1} {set ds [lindex $wiring 0];set pass_buffer 1
   } elseif {[regexp {^INV} $master] && [llength $wiring]==1} {set ds [list INV [$inst getName] $master [lindex $wiring 0]]
   } else {set ds [list FUNCTIONAL [$inst getName] $master [[$pin getMTerm] getName] [lsort $inputs]]}
   lappend drivers $ds;lappend transparent $pass_buffer
  }
  if {[llength $drivers]==1 && [lindex $transparent 0]} {set sig [lindex $drivers 0]
  } else {set sig [expr {[llength $drivers] ? [list DRIVERS [lsort $drivers]] : [list UNDRIVEN $name]}]}
 }
 dict set ct_clock_guard_cache $name $sig
 return $sig
}
proc ct_clock_guard_snapshot {} {
 global ct_blk ct_clock_guard_cache
 set ct_clock_guard_cache {};set result {}
 foreach inst [$ct_blk getInsts] {
  if {![regexp {^(DFF|SDF)} [[$inst getMaster] getName]]} continue
  foreach pin [$inst getITerms] {
   set pn [[$pin getMTerm] getName]
   if {[[$pin getMTerm] getIoType] ne "INPUT" || $pn ni {CLK CLKN CK CKN}} continue
   dict set result [list [$inst getName] $pn] [list [[$inst getMaster] getName] [ct_clock_signature [$pin getNet]]]
  }
 }
 return $result
}
proc ct_clock_guard_verify {} {
 global ct_clock_guard_before
 set after [ct_clock_guard_snapshot]
 if {[dict size $after]!=[dict size $ct_clock_guard_before]} {error "clock ancestry clock-pin inventory changed"}
 dict for {pin signature} $ct_clock_guard_before {
  if {![dict exists $after $pin] || [dict get $after $pin] ne $signature} {error "clock ancestry changed for $pin: before=$signature after=[expr {[dict exists $after $pin] ? [dict get $after $pin] : {MISSING}}]"}
 }
 puts "OT_CLOCK_ANCESTRY PASS [dict size $after] FF clock pins; functional gates, INV edges and noncore roots preserved"
}
if {$ct_clock_guard_on} {set ct_clock_guard_before [ct_clock_guard_snapshot]}

# CP2 (COORD 10-23): EARLY core taps (gen.py phys core_taps.txt, env OT_CORE_TAPS; plan clock.taps[] kind 'core' with
# clock.core_taps 'early').  Each line `port inst pin|*`: the hard core's clock pin(s) leave the clk net for the core
# tap port's own net BEFORE the nearest-tap split, so the core hangs on the tap the spine delivers early (its internal
# clock latency exceeds the common latency).  Ports clk_c<k> are not grid taps: no flop is ever moved onto them.
if {[info exists ::env(OT_CORE_TAPS)] && [file exists $::env(OT_CORE_TAPS)]} {
  set ct_root [[$ct_blk findBTerm $ct_port] getNet]
  set fh [open $::env(OT_CORE_TAPS)]; set ct_cl [split [read $fh] "\n"]; close $fh
  foreach l $ct_cl {
    if {[string match "#*" $l] || [llength $l] < 3} continue
    lassign $l port iname pin early insertion exact
    set strict [expr {$exact eq "exact"}]
    set bt [$ct_blk findBTerm $port]
    set inst [$ct_blk findInst $iname]
    # DIE-HEAD-87 11-08: OpenDB keeps generate-loop names with escaped brackets (u_core.u.g_pp\[0\].u_pair), so a
    # plain core_taps.txt name missed and every LEP pair core tap was left empty (CTS then balanced the 56k-sink clk
    # tree to the pair macros: 1240 ps insertion vs target 450, FF hold -1051).  Retry with the escaped form.
    if {($inst eq "NULL" || $inst eq "") && [string first "\\" $iname] < 0 && [string first "\[" $iname] >= 0} {
      set inst [$ct_blk findInst [string map {"\[" "\\\[" "\]" "\\\]"} $iname]]
    }
    if {$bt eq "NULL" || $bt eq "" || $inst eq "NULL" || $inst eq ""} {
      if {$strict} { error "OT_CLOCK_TAPS exact endpoint missing $port $iname/$pin" }
      puts "OT_CLOCK_TAPS WARN core tap $port: port or core instance $iname missing"
      continue
    }
    set net [$bt getNet]
    if {$net eq "NULL" || $net eq ""} {
      set net [odb::dbNet_create $ct_blk "${port}_net"]
      $bt connect $net
    }
    $net setSigType CLOCK
    set k 0
    if {$strict} {
      set exact_it [$inst findITerm $pin]
      if {$exact_it eq "NULL" || $exact_it eq "" || ![$exact_it isInputSignal]} {
        error "OT_CLOCK_TAPS missing exact input $iname/$pin"
      }
      set exact_net [$exact_it getNet]
      if {$exact_net ne $ct_root && $exact_net ne $net} {
        error "OT_CLOCK_TAPS exact clock $iname/$pin is not on the declared source"
      }
      set sp [get_pins -quiet [list $iname/$pin]]
      set clock_ok 0
      if {[llength $sp] == 1} {
        set lc [get_lib_cells -quiet -of_objects [get_cells -quiet -of_objects $sp]]
        foreach lp [get_lib_pins -quiet -of_objects $lc] {
          if {[get_property $lp is_clock] && [get_property $lp name] eq $pin} { set clock_ok 1 }
        }
      }
      if {!$clock_ok} { error "OT_CLOCK_TAPS exact endpoint is not a Liberty clock $iname/$pin" }
      if {$exact_net eq $net} { set k 1 }
    }
    foreach it [$inst getITerms] {
      set n0 [$it getNet]
      if {$n0 eq "NULL" || $n0 eq "" || $n0 ne $ct_root} continue
      if {$pin ne "*" && [[$it getMTerm] getName] ne $pin} continue
      $it disconnect
      $it connect $net
      incr k
    }
    puts "OT_CLOCK_TAPS core tap $port <- $iname/$pin: $k clock pin(s)"
    if {$strict && $k != 1} { error "OT_CLOCK_TAPS exact endpoint coverage failed $iname/$pin count=$k" }
    if {!$k} { puts "OT_CLOCK_TAPS WARN core tap $port: no clock pin of $iname/$pin on clk" }
  }
}
# Default-off bounded per-bit affinity; capture before the ordinary tap split.
if {[info exists ::env(OT_TAP_CHAIN_AFFINITY)] && $::env(OT_TAP_CHAIN_AFFINITY) eq "1"} {
 source [file join [file dirname [info script]] tap_chain_affinity.tcl]
 ::ot_tap_chain::capture [[$ct_blk findBTerm $ct_port] getNet]
}
if {[llength $ct_taps] < 2} {
  puts "OT_CLOCK_TAPS single tap: nothing to split"
} else {
  set root [[$ct_blk findBTerm $ct_port] getNet]
  set cnt {}
  set moved 0
  foreach it [$root getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set i [$it getInst]
    set loc [$i getLocation]
    # DIE-KV-60 11-01: a hard macro's clock pin goes to the tap nearest the PIN, not the macro origin (kv3_phy PHY at
    # origin (4,4), clk pin (306,515): the origin rule hung it on clk_t1 (840,130), 625 ps of wire, and CTS padded that
    # tap's 988 E-column flops with a 12-stage delay chain -> port hold -357 ps)
    if {![catch {[$i getMaster] isBlock} ct_isblk] && $ct_isblk eq "1"} {
      set ct_axy [$it getAvgXY]
      if {[lindex $ct_axy 0]} { set loc [lrange $ct_axy 1 2] }
    }
    set x [lindex $loc 0]; set y [lindex $loc 1]
    set best ""; set bd 0
    foreach tp $ct_taps {
      set d [expr {abs($x - [lindex $tp 2]) + abs($y - [lindex $tp 3])}]
      if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
    }
    dict incr cnt [lindex $best 0]
    if {[lindex $best 1] ne $root} {
      $it disconnect
      $it connect [lindex $best 1]
      incr moved
    }
  }
  puts "OT_CLOCK_TAPS [llength $ct_taps] taps, $moved sinks moved off $ct_port: [lsort -stride 2 -index 0 $cnt]"
}
# CLOCK-RESET 10-25 (GEOM-REVIEW-3/-4 06:16-06:3x, S81 adopt178 t41/t42: 36 of 105 stations split over two taps,
# 4539 of 4545 FF hold fails cross-tap): the assignment UNIT of a registered group is the group, never the flop.
# Every sink whose instance matches OT_TAP_GROUP_RE (capture 1 = group key; default = ft stations u_ft_<x>_s<k>)
# goes, with all bits of its group, to the tap nearest the group's sink centroid; a reset relay u_rrl_<k> (or
# OT_TAP_FOLLOW_RE) follows the tap that clocks most of the flops it resets.  Grouped and following sinks are
# pinned: the cap pass and the small-tap merge below move whole taps or ungrouped sinks only.
global ct_taps ct_k ct_pinned  ;# sourced from inside an ORFS proc: procs below read these as globals
set ct_pinned {}
set ct_group_owned {}
# FLOW-CANARY 10-25: OPT-IN (default off = the 202a nearest-sink assignment).  On by default it regressed every
# gen_phys canary (s81 t12 / KV io_ft / QC coll_ftm structural FF hold -311.8/-152.0/-144.8 vs 202a PASS; a whole
# long station row on the tap nearest its centroid left 4-8 taps EMPTY and grew 460-556 ps trees; A/B with 202a
# clock_taps on the same kits: 0 empty taps, hold gate PASS).  Opt in with OT_TAP_GROUP_RE (the station form is
# OT_TAP_GROUP_RE='(?:^|[/.])(u_ft_[A-Za-z0-9]+_s[0-9]+)[/.]') once a variant passes the canaries.
set ct_gre [expr {[info exists ::env(OT_TAP_GROUP_RE)] ? $::env(OT_TAP_GROUP_RE) : {}}]
# A declared fixed group shares an existing clock port, e.g. data output
# registers and the already-declared forwarded output clock. Default off.
set ct_fixed {}; set ct_fixed_taps {}
if {[info exists ::env(OT_TAP_GROUP_FIXED)] && $::env(OT_TAP_GROUP_FIXED) ne ""} {
  if {$ct_gre eq "" && !([info exists ::env(OT_SERDES_RESET_COHORT)] && $::env(OT_SERDES_RESET_COHORT) eq "1") && !([info exists ::env(OT_SERDES_INGRESS_COHORT)] && $::env(OT_SERDES_INGRESS_COHORT) eq "1")} {error "OT_TAP_GROUP_FIXED needs an explicit group regex"}
  foreach spec [split $::env(OT_TAP_GROUP_FIXED) ,] {
    set pair [split $spec :]
    if {[llength $pair] != 2 || [lindex $pair 0] eq "" || [lindex $pair 1] eq ""} {error "OT_TAP_GROUP_FIXED malformed group:port"}
    dict set ct_fixed [lindex $pair 0] [lindex $pair 1]
    dict set ct_fixed_taps [lindex $pair 1] 1
  }
}
proc ct_fixed_target {group} {
  global ct_fixed ct_taps
  if {![dict exists $ct_fixed $group]} {return {}}
  set name [dict get $ct_fixed $group]
  foreach tap $ct_taps {if {[lindex $tap 0] eq $name} {return $tap}}
  error "OT_TAP_GROUP_FIXED unknown or non-grid clock port: $name"
}
proc ct_reassert_fixed_groups {} {
  global ct_fixed ct_grp ct_pinned ct_group_owned
  dict for {group name} $ct_fixed {
    if {![dict exists $ct_grp $group]} {error "OT_TAP_GROUP_FIXED group has no sinks: $group"}
    set target [ct_fixed_target $group]
    foreach pin [dict get $ct_grp $group] {
      if {[$pin getNet] ne [lindex $target 1]} {$pin disconnect; $pin connect [lindex $target 1]}
      dict set ct_pinned $pin 1
      dict set ct_group_owned $pin 1
    }
  }
}
set ct_fre [expr {[info exists ::env(OT_TAP_FOLLOW_RE)] ? $::env(OT_TAP_FOLLOW_RE) : {(?:^|[/.])(u_rrl_[0-9]+)[/.]}}]
proc ct_tapnets {} { global ct_taps; set d {}; foreach tp $ct_taps { dict set d [[lindex $tp 1] getName] $tp }; return $d }
proc ct_clk_iterm {inst} {
  set tn [ct_tapnets]
  foreach it [$inst getITerms] {
    set n [$it getNet]
    if {$n ne "NULL" && $n ne "" && [dict exists $tn [$n getName]] && [[$it getMTerm] getIoType] eq "INPUT"} { return $it }
  }
  return ""
}
# followers (reset relays): tap of the majority of the flops their output tree (through buf/inv) reaches
proc ct_follow {} {
  global ct_blk ct_fre ct_pinned ct_group_owned
  set ct_fmoved 0; set ct_fn 0
  foreach inst [$ct_blk getInsts] {
    if {$ct_fre eq "" || ![regexp -- $ct_fre [$inst getName]]} continue
    set cit [ct_clk_iterm $inst]
    if {$cit eq ""} continue
    # Explicit cohorts are atomic: a reset member must not follow a remote
    # descendant onto another tap after its group was assigned. Keep this
    # distinct from ct_pinned, which also contains ordinary followers and
    # must remain eligible for the post-cap follower update.
    if {[dict exists $ct_group_owned $cit]} continue
    set votes {}; set seen {}; set todo {}
    foreach it [$inst getITerms] { if {[[$it getMTerm] getIoType] eq "OUTPUT" && [$it getNet] ne "NULL"} { lappend todo [$it getNet] } }
    while {[llength $todo]} {
      set n [lindex $todo 0]; set todo [lrange $todo 1 end]
      if {[dict exists $seen [$n getName]]} continue
      dict set seen [$n getName] 1
      foreach it [$n getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT"} continue
        set li [$it getInst]
        if {[regexp {^(BUF|INV|HB)} [[$li getMaster] getName]]} {
          foreach o [$li getITerms] { if {[[$o getMTerm] getIoType] eq "OUTPUT" && [$o getNet] ne "NULL"} { lappend todo [$o getNet] } }
          continue
        }
        set lc [ct_clk_iterm $li]
        if {$lc ne ""} { dict incr votes [[$lc getNet] getName] }
      }
    }
    if {![dict size $votes]} continue
    incr ct_fn
    set win ""; set wv -1
    dict for {n v} $votes { if {$v > $wv} { set win $n; set wv $v } }
    set tp [dict get [ct_tapnets] $win]
    if {[$cit getNet] ne [lindex $tp 1]} { $cit disconnect; $cit connect [lindex $tp 1]; incr ct_fmoved }
    dict set ct_pinned $cit 1
  }
  return [list $ct_fn $ct_fmoved]
}
# Default-off SerDes clock cohorts. The incoming forwarded writer is untouched:
# only pins already on the local core clock tap family are considered below.
set ct_ingress [expr {[info exists ::env(OT_SERDES_INGRESS_COHORT)] && $::env(OT_SERDES_INGRESS_COHORT) eq "1"}]
set ct_reset_family [expr {[info exists ::env(OT_SERDES_RESET_COHORT)] && $::env(OT_SERDES_RESET_COHORT) eq "1"}]
set ct_ingress_readside [expr {[info exists ::env(OT_SERDES_INGRESS_READSIDE)] && $::env(OT_SERDES_INGRESS_READSIDE) eq "1"}]
if {$ct_ingress_readside && !$ct_ingress} {error "OT_SERDES_INGRESS_READSIDE requires OT_SERDES_INGRESS_COHORT"}
# I2 measured all-encoder grouping is intentionally not the new READSIDE API:
# its 7269-sink tree reached979ps and moved debt into finite START/reset inputs.
# The opt-in caller must name the modeled first payload stage and price every
# following stage/START/reset/forwarded-clock boundary before routing.
set ct_ingress_stage [expr {[info exists ::env(OT_SERDES_INGRESS_ENCODER_STAGE)] ? $::env(OT_SERDES_INGRESS_ENCODER_STAGE) : ""}]
if {$ct_ingress_readside && $ct_ingress_stage ne "d0"} {error "OT_SERDES_INGRESS_READSIDE requires explicit sized OT_SERDES_INGRESS_ENCODER_STAGE=d0"}
if {!$ct_ingress_readside && $ct_ingress_stage ne ""} {error "OT_SERDES_INGRESS_ENCODER_STAGE requires OT_SERDES_INGRESS_READSIDE"}
set ct_ingress_key [expr {$ct_ingress_readside ? "serdes_ingress_d0" : "u_enc"}]
set ct_ingress_bin 0;set ct_ingress_enc 0;set ct_ingress_read 0;set ct_ingress_aux 0;set ct_ingress_reset 0;set ct_ingress_start 0
set ct_ingress_ports {}
# Generated boundary payload stages identify their receiving landing. Cover the
# complete local read pipeline/read controls, not just its last register. Only
# original local core-tap clock pins are enumerated: the forwarded writer and
# any independent clock behind that barrier cannot enter this cohort.
if {$ct_ingress_readside} {
 foreach tap $ct_taps {
  foreach pin [[lindex $tap 1] getITerms] {
   if {[[$pin getMTerm] getName] ni {CLK CLKN CK CKN}} continue
   if {[regexp {(?:^|[/.])u_bin_([A-Za-z0-9_]+)[/.]q} [[$pin getInst] getName] -> port]} {dict set ct_ingress_ports $port 1}
  }
 }
 if {![dict size $ct_ingress_ports]} {error "OT_SERDES_INGRESS_READSIDE no compiled local payload boundaries"}
}
set ct_reset_members {};set ct_reset_used {};set ct_reset_map {};set ct_reset_available {}
proc ct_has_clock_pin {inst} {
  foreach pin [$inst getITerms] {
    if {[[$pin getMTerm] getName] in {CLK CLKN CK CKN}} {return 1}
  }
  return 0
}
# Trace compiled reset/data authority through combinational logic, stopping at
# every sequential/PHY boundary. A merged relay is identified by its REAL driver,
# never guessed from the collector's numeric name. No data or clock net is edited.
proc ct_rl_sources {net depth seen} {
  if {$net eq "NULL" || $net eq "" || $depth<=0 || [dict exists $seen [$net getName]]} {return {}}
  dict set seen [$net getName] 1;set found {}
  foreach pin [$net getITerms] {
    if {[[$pin getMTerm] getIoType] ne "OUTPUT"} continue
    set inst [$pin getInst];set name [$inst getName]
    if {[regexp {(?:^|[/.])u_rrl_([0-9]+)[/.]} $name -> owner] && [ct_clk_iterm $inst] ne ""} {
      dict set found $owner 1;continue
    }
    if {[ct_has_clock_pin $inst]} continue
    if {![catch {[[$inst getMaster] isBlock]} hard] && $hard eq "1"} continue
    foreach input [$inst getITerms] {
      if {[[$input getMTerm] getIoType] ne "INPUT" || [[$input getMTerm] getName] in {VDD VSS VPWR VGND}} continue
      set found [dict merge $found [ct_rl_sources [$input getNet] [expr {$depth-1}] $seen]]
    }
  }
  return $found
}
if {$ct_reset_family} {
  set ct_collectors {}
  foreach tap $ct_taps {
    foreach pin [[lindex $tap 1] getITerms] {
      if {[[$pin getMTerm] getName] ni {CLK CLKN CK CKN}} continue
      set inst [$pin getInst];set name [$inst getName]
      if {[regexp {(?:^|[/.])u_rrl_([0-9]+)[/.]} $name -> owner]} {dict set ct_reset_available $owner 1}
      if {[regexp {^(.*(?:^|[/.])u_cland_collect_rst_rl_[0-9]+)[/.]} $name -> collector]} {
        dict set ct_collectors $collector $name $inst
      }
    }
  }
  if {![dict size $ct_collectors]} {error "OT_SERDES_RESET_COHORT no compiled local-clock collectors"}
  # Typed rows are sized on the actual compiled driver graph before CTS. Each
  # bounded group has a fixed existing light-clock tap, not the encoder root.
  if {[info exists ::env(OT_SERDES_RELAY_COHORTS)] && $::env(OT_SERDES_RELAY_COHORTS) ne ""} {
    foreach row [split $::env(OT_SERDES_RELAY_COHORTS) {;}] {
      set ids [split $row ,];set key [lindex $ids 0]
      foreach id $ids {
        if {![regexp {^[0-9]+$} $id] || ![dict exists $ct_reset_available $id] || [dict exists $ct_reset_map $id]} {error "OT_SERDES_RELAY_COHORTS missing/duplicate compiled relay $id"}
        dict set ct_reset_map $id $key
      }
    }
    if {[dict size $ct_reset_map]!=[dict size $ct_reset_available]} {error "OT_SERDES_RELAY_COHORTS incomplete compiled relay coverage"}
  } else {
    dict for {id unused} $ct_reset_available {dict set ct_reset_map $id $id}
  }
  dict for {collector instances} $ct_collectors {
    set owners {}
    dict for {name inst} $instances {
      foreach pin [$inst getITerms] {
        if {[[$pin getMTerm] getName] ni {D RESETN SETN}} continue
        set owners [dict merge $owners [ct_rl_sources [$pin getNet] 12 {}]]
      }
    }
    if {[dict size $owners]!=1} {error "OT_SERDES_RESET_COHORT ambiguous/missing compiled RRL authority for $collector: [dict keys $owners]"}
    set owner [lindex [dict keys $owners] 0]
    dict set ct_reset_used $owner 1
    dict for {name inst} $instances {dict set ct_reset_members $name $owner}
    puts "OT_SERDES_RESET_COHORT compiled $collector <- u_rrl_$owner ([dict size $instances] clock pins)"
  }
}

if {[llength $ct_taps] >= 2 && ($ct_gre ne "" || $ct_ingress || $ct_reset_family)} {
  set ct_grp {}
  foreach tp $ct_taps {
    foreach it [[lindex $tp 1] getITerms] {
      if {[[$it getMTerm] getIoType] ne "INPUT"} continue
      set ct_iname [[$it getInst] getName];set g ""
      if {$ct_ingress && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && (($ct_ingress_readside && [regexp {(?:^|[/.])u_bin_([A-Za-z0-9_]+)[/.]q} $ct_iname -> port] && [dict exists $ct_ingress_ports $port]) || (!$ct_ingress_readside && [regexp {(?:^|[/.])u_bin_coll_i0[/.]q} $ct_iname]))} {
        set g $ct_ingress_key;incr ct_ingress_bin
      } elseif {$ct_ingress_readside && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && [regexp {(?:^|[/.])u_bin_([A-Za-z0-9_]+)[/.]eq} $ct_iname -> port] && [dict exists $ct_ingress_ports $port]} {
        set g $ct_ingress_key;incr ct_ingress_aux
      } elseif {$ct_ingress && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && [regexp {(?:^|[/.])u_enc[/.]} $ct_iname] && (!$ct_ingress_readside || [regexp {(?:^|[/.])u_enc[/.]d0[^A-Za-z0-9_]} $ct_iname])} {
        set g $ct_ingress_key;incr ct_ingress_enc
      } elseif {$ct_ingress_readside && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && [regexp {(?:^|[/.])u_cland_([A-Za-z0-9_]+)[/.]} $ct_iname -> port] && [dict exists $ct_ingress_ports $port]} {
        set g $ct_ingress_key;incr ct_ingress_read
      } elseif {$ct_ingress_readside && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && [regexp {(?:^|[/.])u_cland_reader_start_([A-Za-z0-9_]+)_[0-9]+[/.]} $ct_iname -> port] && [dict exists $ct_ingress_ports $port]} {
        set g $ct_ingress_key;incr ct_ingress_start
      } elseif {$ct_ingress_readside && [[$it getMTerm] getName] in {CLK CLKN CK CKN} && [regexp {(?:^|[/.])u_core[.]g_rst_tree[.]rt_e[^A-Za-z0-9_]} $ct_iname]} {
        set g u_enc;incr ct_ingress_reset
      } elseif {$ct_reset_family && [dict exists $ct_reset_members $ct_iname]} {
        set g serdes_rst_[dict get $ct_reset_map [dict get $ct_reset_members $ct_iname]]
      } elseif {$ct_reset_family && [regexp {(?:^|[/.])u_rrl_([0-9]+)[/.]} $ct_iname -> owner] && [dict exists $ct_reset_map $owner]} {
        set g serdes_rst_[dict get $ct_reset_map $owner]
      } elseif {$ct_gre ne ""} {regexp -- $ct_gre $ct_iname -> g}
      if {$g ne ""} {dict lappend ct_grp $g $it}
    }
  }
  if {$ct_ingress} {
    set expected [expr {[info exists ::env(OT_SERDES_INGRESS_BITS)] ? $::env(OT_SERDES_INGRESS_BITS) : 512}]
    if {$expected<=0 || $ct_ingress_bin!=$expected || $ct_ingress_enc<=0} {error "OT_SERDES_INGRESS_COHORT capture mismatch bin=$ct_ingress_bin expected=$expected encoder=$ct_ingress_enc"}
    if {$ct_ingress_readside && $ct_ingress_enc!=$expected} {error "OT_SERDES_INGRESS_READSIDE first-stage width=$ct_ingress_enc expected=$expected"}
    if {$ct_ingress_readside && $ct_ingress_start<=0} {error "OT_SERDES_INGRESS_READSIDE missing compiled reader START authority copies"}
    if {$ct_ingress_readside && $ct_ingress_read<=0} {error "OT_SERDES_INGRESS_READSIDE missing compiled local read-side clock pins"}
    puts "OT_SERDES_INGRESS_COHORT bin=$ct_ingress_bin encoder=$ct_ingress_enc local_readside=$ct_ingress_read interfaces=[dict keys $ct_ingress_ports] local_boundary_aux=$ct_ingress_aux encoder_reset_leaf=$ct_ingress_reset reader_start=$ct_ingress_start encoder_stage=$ct_ingress_stage group=$ct_ingress_key; local core clock only; forwarded writer unchanged"
  }
  set ct_gmoved 0; set ct_gsplit 0
  dict for {g its} $ct_grp {
    set sx 0.0; set sy 0.0; set owners {}
    foreach it $its {
      lassign [[$it getInst] getLocation] x y
      set sx [expr {$sx + $x}]; set sy [expr {$sy + $y}]
      dict set owners [[$it getNet] getName] 1
    }
    if {[dict size $owners] > 1} { incr ct_gsplit }
    if {[string match serdes_rst_* $g]} {
      set xs {};set ys {}
      foreach it $its {lassign [[$it getInst] getLocation] x y;lappend xs $x;lappend ys $y}
      set xs [lsort -integer $xs];set ys [lsort -integer $ys]
      set du [expr {double([[ord::get_db_tech] getDbUnitsPerMicron])}]
      set span [expr {([lindex $xs end]-[lindex $xs 0]+[lindex $ys end]-[lindex $ys 0])/$du}]
      if {$span>405.0 || [llength $its]>64} {error "OT_SERDES_RELAY_COHORTS unsized group $g span_um=$span FF=[llength $its]"}
      puts "OT_SERDES_RELAY_COHORTS $g FF=[llength $its] bbox_span_um=$span"
    }
    set cx [expr {$sx / [llength $its]}]; set cy [expr {$sy / [llength $its]}]
    set best ""; set bd 0
    foreach tp $ct_taps {
      if {[lindex $tp 2] eq ""} continue
      set d [expr {abs($cx - [lindex $tp 2]) + abs($cy - [lindex $tp 3])}]
      if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
    }
    set ct_forced [ct_fixed_target $g]
    if {[llength $ct_forced]} {set best $ct_forced}
    foreach it $its {
      if {[$it getNet] ne [lindex $best 1]} { $it disconnect; $it connect [lindex $best 1]; incr ct_gmoved }
      dict set ct_pinned $it 1
      dict set ct_group_owned $it 1
    }
  }
  lassign [ct_follow] ct_fn ct_fmoved
  puts "OT_CLOCK_TAPS GROUPS [dict size $ct_grp] groups (re '$ct_gre'): $ct_gsplit were split over taps by the nearest-flop pass, $ct_gmoved sinks moved, 0 split now; followers $ct_fn ('$ct_fre'), $ct_fmoved re-hung on their sinks' tap"
}
# COORD 10-23: size taps by SINK COUNT.  No tap keeps more than OT_TAP_MAX_SINKS (~3k): the sinks of an over-full
# tap that cost the least extra distance move to their next-nearest tap with room (capacity-constrained nearest
# assignment), so dense regions spread over the neighbouring taps instead of one deep tree (CP1 r6: 3.6-4.8k-sink
# taps 300-313 ps while 9 of 16 taps were empty; a buffer split behind the tap measured worse, 437 ps).
set ct_cap [expr {[info exists ::env(OT_TAP_MAX_SINKS)] ? $::env(OT_TAP_MAX_SINKS) : 3000}]
# a re-assigned sink may add at most half a tap pitch of distance (CP1 r6 probe: sinks moved ~300 um to an empty
# tap gave 465-ps trees); a dense region beyond that needs a finer tap pitch, not longer trees
set ct_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set ct_maxx [expr {0.5 * ([info exists ::env(OT_TAP_PITCH_UM)] ? $::env(OT_TAP_PITCH_UM) : 600.0) * $ct_dbu}]
# density taps (decision 5, gen.py phys OT_TAP_REASSIGN_UM = clock.tap_radius_um): no pitch; the cluster radius bounds it
if {[info exists ::env(OT_TAP_REASSIGN_UM)]} { set ct_maxx [expr {$::env(OT_TAP_REASSIGN_UM) * $ct_dbu}] }
# CT_SPAN_BEGIN  FABLE-FIX-S81-LEPE 11-19 (COORD sink region rule, plan clock.tap_span_um -> OT_TAP_SPAN_UM; unset / 0 = off):
# the cap pass and the hop-latch cap recheck below move sinks to a tap with room; with the rule on, a tap takes a sink (or a
# whole unit / group) only if its sink box stays within W + H <= span, or does not grow.  Boxes are the instance locations of
# the non-macro clock sinks in ct_by, rebuilt at the top of every pass and grown with each accepted move inside a pass.
proc ct_span_fits {box pts span} {
  if {$span <= 0} { return 1 }
  if {$box eq {}} { set a0 {}; set b0 {}; set a1 {}; set b1 {} } else { lassign $box a0 b0 a1 b1 }
  set x0 $a0; set y0 $b0; set x1 $a1; set y1 $b1
  foreach p $pts {
    lassign $p x y
    if {$x0 eq {} || $x < $x0} { set x0 $x }; if {$x1 eq {} || $x > $x1} { set x1 $x }
    if {$y0 eq {} || $y < $y0} { set y0 $y }; if {$y1 eq {} || $y > $y1} { set y1 $y }
  }
  if {$a0 ne {} && $x0 == $a0 && $y0 == $b0 && $x1 == $a1 && $y1 == $b1} { return 1 }
  expr {($x1 - $x0) + ($y1 - $y0) <= $span}
}
proc ct_span_grow {box pts} {
  if {$box eq {}} { set x0 {}; set y0 {}; set x1 {}; set y1 {} } else { lassign $box x0 y0 x1 y1 }
  foreach p $pts {
    lassign $p x y
    if {$x0 eq {} || $x < $x0} { set x0 $x }; if {$x1 eq {} || $x > $x1} { set x1 $x }
    if {$y0 eq {} || $y < $y0} { set y0 $y }; if {$y1 eq {} || $y > $y1} { set y1 $y }
  }
  list $x0 $y0 $x1 $y1
}
# CT_SPAN_END
proc ct_span_pts {its} { set l {}; foreach it $its { lappend l [[$it getInst] getLocation] }; return $l }
proc ct_span_init {by} {
  set d {}
  dict for {tap its} $by { dict set d $tap [ct_span_grow {} [ct_span_pts $its]] }
  return $d
}
set ct_span 0
if {[info exists ::env(OT_TAP_SPAN_UM)] && [string is double -strict $::env(OT_TAP_SPAN_UM)] && $::env(OT_TAP_SPAN_UM) > 0} {
  set ct_span [expr {$::env(OT_TAP_SPAN_UM) * $ct_dbu}]
  puts "OT_CLOCK_TAPS sink region rule: cap pass and cap recheck keep every receiving tap inside W+H <= $::env(OT_TAP_SPAN_UM) um"
}
set ct_span_refused 0
if {[llength $ct_taps] >= 2} {
  set ct_by {}
  foreach tp $ct_taps {
    set l {}
    foreach it [[lindex $tp 1] getITerms] {
      # PATH-QC-NK 10-25: a hard core's clock pin stays on the tap OT_CORE_TAPS / the split chose (never a cap move)
      # KV-102 11-14 (kv3_sys_c u_ucie_rom/clk moved to a tap 951 um away): a hard macro clock pin never moves in the cap pass, with or without OT_CORE_TAPS
      if {![catch {[[$it getInst] getMaster] isBlock} ct_isb0] && $ct_isb0 eq "1"} continue
      if {[[$it getMTerm] getIoType] eq "INPUT"} { lappend l $it }
    }
    dict set ct_by [lindex $tp 0] $l
  }
  set ct_moves 0
  set ct_stuck {}
  set ct_spilled {}
  set ct_spill [expr {[info exists ::env(OT_TAP_SPILL_UM)] ? $::env(OT_TAP_SPILL_UM) * $ct_dbu : 0}]
  for {set pass 0} {$pass < 8 * [llength $ct_taps]} {incr pass} {
    set over ""
    foreach tp $ct_taps {
      if {[lindex $tp 0] ni $ct_stuck && [llength [dict get $ct_by [lindex $tp 0]]] > $ct_cap} { set over $tp; break }
    }
    if {$over eq ""} break
    set on [lindex $over 0]
    set ct_sbox [expr {$ct_span > 0 ? [ct_span_init $ct_by] : {}}]
    # KV-PC-DELTA-1115: opt-in OT_TAP_SPILL_UM: a tap that found no room within half a pitch retries with this reach
    set ct_lim [expr {$on in $ct_spilled ? $ct_spill : $ct_maxx}]
    set excess [expr {[llength [dict get $ct_by $on]] - $ct_cap}]
    # extra distance of each sink to every other tap with room
    set cand {}
    foreach it [dict get $ct_by $on] {
      if {[dict exists $ct_pinned $it]} continue
      set loc [[$it getInst] getLocation]; set x [lindex $loc 0]; set y [lindex $loc 1]
      set d0 [expr {abs($x - [lindex $over 2]) + abs($y - [lindex $over 3])}]
      set best ""; set bd 0
      foreach tp $ct_taps {
        if {[lindex $tp 0] eq $on || [llength [dict get $ct_by [lindex $tp 0]]] >= $ct_cap} continue
        set d [expr {abs($x - [lindex $tp 2]) + abs($y - [lindex $tp 3]) - $d0}]
        if {[info exists ::env(OT_TAP_REASSIGN_UM)] && $d+$d0 > $ct_lim} continue
        if {$ct_span > 0 && ![ct_span_fits [dict get $ct_sbox [lindex $tp 0]] [list [list $x $y]] $ct_span]} { incr ct_span_refused; continue }
        if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
      }
      if {$best ne "" && $bd <= $ct_lim} { lappend cand [list $bd $it $best] }
    }
    if {![llength $cand] && [info exists ct_grp]} {
      # CLOCK-RESET 10-25: over-full tap of pinned groups -> move the WHOLE group (with its followers' sinks staying
      # on their own nets) that costs the least extra centroid distance to a tap with room for all of it
      set gbest ""; set gbd 0; set gtgt ""
      dict for {g its} $ct_grp {
        if {[dict exists $ct_fixed $g]} continue
        if {[[lindex $its 0] getNet] ne [lindex $over 1]} continue
        set sx 0.0; set sy 0.0
        foreach it $its { lassign [[$it getInst] getLocation] x y; set sx [expr {$sx + $x}]; set sy [expr {$sy + $y}] }
        set cx [expr {$sx / [llength $its]}]; set cy [expr {$sy / [llength $its]}]
        set d0 [expr {abs($cx - [lindex $over 2]) + abs($cy - [lindex $over 3])}]
        foreach tp $ct_taps {
          if {[lindex $tp 0] eq $on || [llength [dict get $ct_by [lindex $tp 0]]] + [llength $its] > $ct_cap} continue
          set d [expr {abs($cx - [lindex $tp 2]) + abs($cy - [lindex $tp 3]) - $d0}]
          if {[info exists ::env(OT_TAP_REASSIGN_UM)]} {
            set far 0
            foreach it $its {
              lassign [[$it getInst] getLocation] gx gy
              if {abs($gx-[lindex $tp 2])+abs($gy-[lindex $tp 3]) > $ct_maxx} {set far 1; break}
            }
            if {$far} continue
          }
          if {$ct_span > 0 && ![ct_span_fits [dict get $ct_sbox [lindex $tp 0]] [ct_span_pts $its] $ct_span]} { incr ct_span_refused; continue }
          if {$d <= $ct_maxx && ($gbest eq "" || $d < $gbd)} { set gbest $g; set gbd $d; set gtgt $tp }
        }
      }
      if {$gbest ne ""} {
        set tn [lindex $gtgt 0]; set keep [dict get $ct_by $on]; set add [dict get $ct_by $tn]
        foreach it [dict get $ct_grp $gbest] {
          $it disconnect; $it connect [lindex $gtgt 1]
          set keep [lsearch -all -inline -not -exact $keep $it]; lappend add $it
        }
        dict set ct_by $on $keep; dict set ct_by $tn $add
        incr ct_moves [llength [dict get $ct_grp $gbest]]
        continue
      }
    }
    if {![llength $cand] && $ct_spill > $ct_maxx && $on ni $ct_spilled} {
      lappend ct_spilled $on
      puts "OT_CLOCK_TAPS $on over cap with no room within half a pitch: spill reach [format %.0f [expr {$ct_spill / $ct_dbu}]] um"
      continue
    }
    if {![llength $cand]} {
      # COORD 10-23 19:55: sinks per tap are guidance (WARN), not a gate
      puts "OT_CLOCK_TAPS WARN $on keeps [llength [dict get $ct_by $on]] sinks > cap $ct_cap: no tap with room within [format %.0f [expr {$ct_maxx / $ct_dbu}]] um (finer clock.tap_pitch_um)"
      lappend ct_stuck $on
      continue
    }
    set cand [lsort -real -index 0 $cand]
    # move the cheapest sinks toward ONE target per pass (keeps targets under cap), then re-evaluate
    set tgt [lindex $cand 0 2]; set tn [lindex $tgt 0]
    set room [expr {$ct_cap - [llength [dict get $ct_by $tn]]}]
    set keep [dict get $ct_by $on]; set add [dict get $ct_by $tn]
    set n 0
    foreach c $cand {
      if {$n >= $excess || $n >= $room} break
      if {[lindex $c 2 0] ne $tn} continue
      set it [lindex $c 1]
      if {$ct_span > 0} {
        set ct_sp [ct_span_pts [list $it]]
        if {![ct_span_fits [dict get $ct_sbox $tn] $ct_sp $ct_span]} { incr ct_span_refused; continue }
        dict set ct_sbox $tn [ct_span_grow [dict get $ct_sbox $tn] $ct_sp]
      }
      $it disconnect; $it connect [lindex $tgt 1]
      set keep [lsearch -all -inline -not -exact $keep $it]
      lappend add $it
      incr n
    }
    dict set ct_by $on $keep; dict set ct_by $tn $add
    incr ct_moves $n
    if {$n == 0} { lappend ct_stuck $on; puts "OT_CLOCK_TAPS WARN $on keeps [llength $keep] sinks > cap $ct_cap: the sink region rule admits no further move" }
  }
  set l {}
  foreach tp $ct_taps { lappend l "[lindex $tp 0] [llength [dict get $ct_by [lindex $tp 0]]]" }
  puts "OT_CLOCK_TAPS cap $ct_cap sinks/tap: $ct_moves sinks re-assigned; per tap: [join $l {, }]"
  if {[info exists ct_grp]} {
    lassign [ct_follow] ct_fn ct_fmoved
    puts "OT_CLOCK_TAPS followers after cap pass: $ct_fmoved of $ct_fn re-hung on their sinks' tap"
  }
}
# CLOCK-RESET 10-25 (GEOM-REVIEW-4 06:16 item 5): a tap with fewer than OT_TAP_MIN_SINKS (opt-in; 50 was the default) sinks is a
# nearly empty tree that tap_balance must pad (t18: 42 -> 246 ps with 49 delay cells) and that launches early into
# its neighbours: its sinks (whole groups included) join the nearest tap that has >= the minimum, if that tap lies
# within one tap pitch; otherwise it stays (WARN).  The emptied tap is then dropped like any tap without sinks.
# FLOW-CANARY 10-25: OPT-IN too (default 0 = off, as 202a); part of the same canary regression (merged taps -> deep trees).
set ct_min [expr {[info exists ::env(OT_TAP_MIN_SINKS)] ? $::env(OT_TAP_MIN_SINKS) : 0}]
if {[llength $ct_taps] >= 2 && $ct_min > 0} {
  set ct_k {}
  foreach tp $ct_taps {
    set l {}
    foreach it [[lindex $tp 1] getITerms] { if {[[$it getMTerm] getIoType] eq "INPUT"} { lappend l $it } }
    dict set ct_k [lindex $tp 0] $l
  }
  set ct_merged {}
  foreach tp [lsort -command {apply {{a b} {global ct_k; expr {[llength [dict get $ct_k [lindex $a 0]]] - [llength [dict get $ct_k [lindex $b 0]]]}}}} $ct_taps] {
    set n [llength [dict get $ct_k [lindex $tp 0]]]
    if {[dict exists $ct_fixed_taps [lindex $tp 0]]} continue
    if {$n == 0 || $n >= $ct_min} continue
    set best ""; set bd 0
    foreach t2 $ct_taps {
      if {[lindex $t2 0] eq [lindex $tp 0] || [llength [dict get $ct_k [lindex $t2 0]]] < $ct_min} continue
      set d [expr {abs([lindex $tp 2] - [lindex $t2 2]) + abs([lindex $tp 3] - [lindex $t2 3])}]
      if {$best eq "" || $d < $bd} { set best $t2; set bd $d }
    }
    if {$best eq "" || $bd > 2.0 * $ct_maxx} {
      puts "OT_CLOCK_TAPS WARN [lindex $tp 0] keeps $n sinks < $ct_min: no tap with >= $ct_min sinks within one pitch"
      continue
    }
    # Density radius is a physical reach bound, including sparse control flops.
    # Tap-to-tap distance alone can hide a long arm at the far end of a bank.
    if {[info exists ::env(OT_TAP_REASSIGN_UM)]} {
      set far 0
      foreach it [dict get $ct_k [lindex $tp 0]] {
        lassign [[$it getInst] getLocation] sx sy
        set d [expr {abs($sx-[lindex $best 2])+abs($sy-[lindex $best 3])}]
        if {$d > $ct_maxx} { set far 1; break }
      }
      if {$far} {
        puts "OT_CLOCK_TAPS keeps sparse [lindex $tp 0]($n): merge exceeds density sink radius"
        continue
      }
    }
    foreach it [dict get $ct_k [lindex $tp 0]] { $it disconnect; $it connect [lindex $best 1] }
    dict set ct_k [lindex $best 0] [concat [dict get $ct_k [lindex $best 0]] [dict get $ct_k [lindex $tp 0]]]
    dict set ct_k [lindex $tp 0] {}
    lappend ct_merged "[lindex $tp 0]($n)->[lindex $best 0]"
  }
  puts "OT_CLOCK_TAPS MIN $ct_min sinks/tap: [llength $ct_merged] small taps merged [join $ct_merged { }]"
}
# Bounded opt-in affinity uses individual bits, not whole wide station rows.
if {[info exists ::env(OT_TAP_CHAIN_AFFINITY)] && $::env(OT_TAP_CHAIN_AFFINITY) eq "1"} {
 ::ot_tap_chain::apply
}
# QC-TYPES-6 11-07 TAP-PAIR AFFINITY (default off, clock.tap_pair_affinity -> OT_TAP_PAIR_AFFINITY=1): short
# reg-to-reg pairs split across taps pay the tap window on hold; whole pair components move onto one tap, never cutting
# a same-tap pair.  Clock pins only; no data/reset/cell change.  Before the hop-latch pass so latches follow it.
if {[info exists ::env(OT_TAP_PAIR_AFFINITY)] && $::env(OT_TAP_PAIR_AFFINITY) eq "1"} {
 source [file join [file dirname [info script]] tap_pair_affinity.tcl]
}
# S81-SEAM-RST-1115 form pg (default off, OT_TAP_RESET_AFFINITY=1): the last reset stage of an async clear takes the clock tap
# its sinks use (tap_reset_affinity.tcl), so launch and capture of every async pin share one insertion delay.
if {[info exists ::env(OT_TAP_RESET_AFFINITY)] && $::env(OT_TAP_RESET_AFFINITY) eq "1"} {
 source [file join [file dirname [info script]] tap_reset_affinity.tcl]
}
# QC-EVENT-S26 11-11 (COORD 21:46: a near-empty tap "must not be left to padding"; ring bonding took clk_t84 from 116
# sinks to 1): OT_TAP_POST_MIN_SINKS (opt-in, plan clock.tap_post_merge_min_sinks) re-runs the small-tap
# merge AFTER the affinity passes.  A tap left with 0 < n < min sinks moves ALL its clock pins to the nearest tap that
# has >= min sinks, room under the cap, and every moved sink within OT_TAP_POST_MIN_UM (default 200, = clock.tap_radius_um)
# of that tap.  Whole-tap moves only: a same-tap pair or group stays same-tap, so no affinity bond is cut.  A tap that
# carries a hard-core (block) clock pin, and the root port (OT_TAP_PORT, clk), are never emptied.  No legal target -> the tap stays (WARN).  The emptied tap is
# then dropped like any tap without sinks.  Unset = no change.
if {[llength $ct_taps] >= 2 && [info exists ::env(OT_TAP_POST_MIN_SINKS)] && $::env(OT_TAP_POST_MIN_SINKS) > 0} {
  global ct_pk  ;# read by the lsort comparator (this file is sourced from inside an ORFS proc)
  set ct_pmin $::env(OT_TAP_POST_MIN_SINKS)
  set ct_prad [expr {([info exists ::env(OT_TAP_POST_MIN_UM)] ? $::env(OT_TAP_POST_MIN_UM) : 200.0) * $ct_dbu}]
  set ct_pk {}; set ct_pblk {}
  foreach tp $ct_taps {
    set l {}; set b 0
    foreach it [[lindex $tp 1] getITerms] {
      if {[[$it getMTerm] getIoType] ne "INPUT"} continue
      lappend l $it
      if {[string is true -strict [[[$it getInst] getMaster] isBlock]]} { set b 1 }
    }
    dict set ct_pk [lindex $tp 0] $l
    dict set ct_pblk [lindex $tp 0] $b
  }
  set ct_pmerged {}; set ct_pkept {}
  foreach tp [lsort -command {apply {{a b} {global ct_pk; set na [llength [dict get $ct_pk [lindex $a 0]]]; set nb [llength [dict get $ct_pk [lindex $b 0]]]; expr {$na != $nb ? $na - $nb : [string compare [lindex $a 0] [lindex $b 0]]}}}} $ct_taps] {
    set nm [lindex $tp 0]
    set its [dict get $ct_pk $nm]
    set n [llength $its]
    if {$n == 0 || $n >= $ct_pmin} continue
    if {[dict exists $ct_fixed_taps $nm]} {lappend ct_pkept [format {%s(%s):fixed} $nm $n]; continue}
    if {[dict get $ct_pblk $nm]} { lappend ct_pkept "${nm}($n):core"; continue }
    if {$nm eq $ct_port} { lappend ct_pkept "${nm}($n):root"; continue }
    set best ""; set bd 0
    foreach t2 $ct_taps {
      set n2 [llength [dict get $ct_pk [lindex $t2 0]]]
      if {[lindex $t2 0] eq $nm || $n2 < $ct_pmin || $n2 + $n > $ct_cap} continue
      set far 0
      foreach it $its {
        lassign [[$it getInst] getLocation] sx sy
        if {abs($sx - [lindex $t2 2]) + abs($sy - [lindex $t2 3]) > $ct_prad} { set far 1; break }
      }
      if {$far} continue
      set d [expr {abs([lindex $tp 2] - [lindex $t2 2]) + abs([lindex $tp 3] - [lindex $t2 3])}]
      if {$best eq "" || $d < $bd} { set best $t2; set bd $d }
    }
    if {$best eq ""} { lappend ct_pkept "${nm}($n)"; continue }
    foreach it $its { $it disconnect; $it connect [lindex $best 1] }
    dict set ct_pk [lindex $best 0] [concat [dict get $ct_pk [lindex $best 0]] $its]
    dict set ct_pk $nm {}
    lappend ct_pmerged "${nm}($n)->[lindex $best 0]"
  }
  puts "OT_CLOCK_TAPS POST_MIN $ct_pmin sinks/tap (radius [expr {$ct_prad / $ct_dbu}] um): [llength $ct_pmerged] small taps merged [join $ct_pmerged { }]; kept [llength $ct_pkept] [join $ct_pkept { }]"
}
# Fixed declared source clocks take priority over automatic affinity heuristics.
# Reassert before lockup latches follow their launch clocks, not after them.
ct_reassert_fixed_groups
# TYPE-SAFE-1 11-06 (OWNER 18:5x, clock follows data): every ft hop lockup latch u_fl_* (gen_rtl.ft_hop_lockup) is
# clocked from the tap of the station flop that drives its D (the LAUNCH station), after every other assignment pass
# above (nearest / group / cap / min-merge / chain affinity), so the station -> latch check shares the launch tap
# (CRPR) and only the latch -> capture check crosses a port, with ~T/2 of hold margin.  No u_fl_ cell = no change.
set ct_hlu {}; set ct_hcap {}
if {[llength $ct_taps] >= 2} {
  set ct_hl 0; set ct_hlm 0; set ct_hlx 0
  foreach ct_i [$ct_blk getInsts] {
    # QC-MCLK lever 2 11-16 (FABLE-PD-QC-MCLK, cbn_q01: 1,187 of 21,467 FF hold endpoints): the NK core-input lockup latches
    # u_lk_nk_* ride the tap of the u_pc_nk_* register that drives their D, like the ft hop latches (same DLL/DHL master test)
    if {![regexp {(^|[./])u_f[lx]_} [$ct_i getName]] && ![regexp {(^|[./])u_lk_nk_} [$ct_i getName]]} continue
    set ct_m [[$ct_i getMaster] getName]
    # HBM-VSN-XTAP 11-11: a cross-tap hop FLOP u_fx_* (schema.ft_hop_xtap) also rides its launch station's tap: the
    # station -> flop check shares one tap and the flop -> capture leg crosses the port with a full cycle (T - W - skew)
    set ct_hf [expr {[regexp {(^|[./])u_fx_} [$ct_i getName]] && [string match "*DFF*" $ct_m]}]
    if {![string match "DLLx*" $ct_m] && ![string match "DHLx*" $ct_m] && !$ct_hf} continue
    set ct_cit [ct_clk_iterm $ct_i]
    if {$ct_cit eq ""} { incr ct_hlx; continue }
    set ct_net ""
    foreach ct_it [$ct_i getITerms] { if {[[$ct_it getMTerm] getName] eq "D"} { set ct_net [$ct_it getNet] } }
    set ct_drv ""; set ct_seen {}
    while {$ct_net ne "" && $ct_net ne "NULL" && ![dict exists $ct_seen [$ct_net getName]] && $ct_drv eq ""} {
      dict set ct_seen [$ct_net getName] 1
      set ct_nx ""
      foreach ct_it [$ct_net getITerms] {
        if {[[$ct_it getMTerm] getIoType] ne "OUTPUT"} continue
        set ct_d [$ct_it getInst]
        if {[regexp {^(BUF|INV|HB)} [[$ct_d getMaster] getName]]} {
          foreach ct_in [$ct_d getITerms] { if {[[$ct_in getMTerm] getIoType] eq "INPUT" && [$ct_in getNet] ne "NULL"} { set ct_nx [$ct_in getNet] } }
        } elseif {[ct_clk_iterm $ct_d] ne ""} { set ct_drv $ct_d }
      }
      set ct_net $ct_nx
    }
    if {$ct_drv eq ""} { incr ct_hlx; continue }
    set ct_dit [ct_clk_iterm $ct_drv]
    set ct_tn [$ct_dit getNet]
    if {[$ct_cit getNet] ne $ct_tn} { $ct_cit disconnect; $ct_cit connect $ct_tn; incr ct_hlm }
    # VSN6-B 11-11: remember latch -> launch flop clock pin for the cap recheck below (they move as one unit)
    dict set ct_hlu $ct_cit $ct_dit
    incr ct_hl
  }
  if {$ct_hl || $ct_hlx} { puts "OT_CLOCK_TAPS hop latches: $ct_hl on their launch station's tap ($ct_hlm re-hung), $ct_hlx without a tapped launch flop" }
}
# DIE-HBM-97 11-09 (vsN2 a8 TT -33.18: u_fl_rst_15/16/22 and u_fl_L201x2_o_6 on the LATE tap clk_t11 (+402 ps) feed captures
# on the EARLY tap clk_t10 (-160 window, +64 ps), so latch -> capture has T/2 - 338 ps): a latch whose launch tap is the
# later one is hung on its CAPTURE station's tap instead.  launch -> latch then crosses the port with the latch open
# from the capture fall edge (setup ~T/2 headroom, hold against the closing rise edge of the cycle before), and
# latch -> capture shares one tap (CRPR, T/2 hold).  Opt-in, named from the measured routed DB:
# OT_HOP_LATCH_CAPTURE_TAP = space-separated regexes matched against the latch instance name.  Unset = no change.
if {[llength $ct_taps] >= 2 && [info exists ::env(OT_HOP_LATCH_CAPTURE_TAP)] && [string trim $::env(OT_HOP_LATCH_CAPTURE_TAP)] ne ""} {
  set ct_cl 0; set ct_clx {}
  foreach ct_i [$ct_blk getInsts] {
    set ct_nm [$ct_i getName]
    if {![regexp {(^|[./])u_fl_} $ct_nm]} continue
    set ct_hit 0
    foreach ct_re $::env(OT_HOP_LATCH_CAPTURE_TAP) { if {[regexp -- $ct_re $ct_nm]} { set ct_hit 1; break } }
    if {!$ct_hit} continue
    set ct_cit [ct_clk_iterm $ct_i]
    if {$ct_cit eq ""} { lappend ct_clx $ct_nm; continue }
    # forward from Q through BUF/INV/HB to the clocked sinks; majority tap wins
    set ct_front {}; set ct_seen {}; set ct_votes {}; set ct_vits {}
    foreach ct_it [$ct_i getITerms] { if {[[$ct_it getMTerm] getIoType] eq "OUTPUT" && [$ct_it getNet] ne "NULL"} { lappend ct_front [$ct_it getNet] } }
    while {[llength $ct_front]} {
      set ct_n [lindex $ct_front 0]; set ct_front [lrange $ct_front 1 end]
      if {[dict exists $ct_seen [$ct_n getName]]} continue
      dict set ct_seen [$ct_n getName] 1
      foreach ct_it [$ct_n getITerms] {
        if {[[$ct_it getMTerm] getIoType] ne "INPUT"} continue
        set ct_d [$ct_it getInst]
        if {$ct_d eq $ct_i} continue
        if {[regexp {^(BUF|INV|HB)} [[$ct_d getMaster] getName]]} {
          foreach ct_o [$ct_d getITerms] { if {[[$ct_o getMTerm] getIoType] eq "OUTPUT" && [$ct_o getNet] ne "NULL"} { lappend ct_front [$ct_o getNet] } }
        } elseif {[set ct_sk [ct_clk_iterm $ct_d]] ne ""} {
          dict incr ct_votes [[$ct_sk getNet] getName]
          dict lappend ct_vits [[$ct_sk getNet] getName] $ct_sk
        }
      }
    }
    if {![dict size $ct_votes]} { lappend ct_clx $ct_nm; continue }
    set ct_best ""; set ct_bn -1
    dict for {k v} $ct_votes { if {$v > $ct_bn} { set ct_best $k; set ct_bn $v } }
    if {[[$ct_cit getNet] getName] ne $ct_best} {
      $ct_cit disconnect; $ct_cit connect [$ct_blk findNet $ct_best]; incr ct_cl
    }
    # VSN6-B 11-11: a capture-tap latch and the capture sinks it shares a tap with stay put in the cap recheck
    dict set ct_hcap $ct_cit 1
    foreach ct_sk [dict get $ct_vits $ct_best] { dict set ct_hcap $ct_sk 1 }
    unset ct_vits
  }
  puts "OT_CLOCK_TAPS hop latches on capture tap (OT_HOP_LATCH_CAPTURE_TAP): $ct_cl re-hung, [llength $ct_clx] without a tapped capture: [lrange $ct_clx 0 9]"
}
# VSN6-B 11-11 S7 CAP RECHECK (HBM vsN6 form3: clk_t14 4,004 and clk_t12 3,044 sinks with cap 3,000, no WARN): the cap
# pass above runs BEFORE the two hop-latch passes, which re-hang latches without looking at the cap (form3: 16,041 on
# the launch tap, 31,739 on the capture tap).  Every tap is rechecked here.  An over-cap tap sheds MOVABLE UNITS to the
# cheapest tap with room, under the same reach bound as the cap pass: a launch unit is a flop plus the hop latches
# hung on its tap (they move together, so flop -> latch keeps its CRPR), else a single sink.  Never moved: latches on a
# capture tap and the capture sinks they share it with, grouped/follower sinks, hard-macro clock pins.  A tap that
# stays over the cap prints OT_CLOCK_TAPS WARN CAP_AFTER_HOP_LATCH and is listed in ot_clock_taps.json "over_cap".
# OT_TAP_CAP_RECHECK=0: report only (no move).
if {[llength $ct_taps] >= 2 && $ct_cap > 0} {
  set ct_rcm [expr {![info exists ::env(OT_TAP_CAP_RECHECK)] || $::env(OT_TAP_CAP_RECHECK) ne "0"}]
  set ct_by {}
  foreach tp $ct_taps {
    set l {}
    foreach it [[lindex $tp 1] getITerms] { if {[[$it getMTerm] getIoType] eq "INPUT"} { lappend l $it } }
    dict set ct_by [lindex $tp 0] $l
  }
  # launch units: flop clock pin -> its latches (only latches still on the flop's tap)
  set ct_ul {}; set ct_inu {}
  dict for {lat drv} $ct_hlu {
    if {[dict exists $ct_hcap $lat] || [$lat getNet] ne [$drv getNet]} continue
    dict lappend ct_ul $drv $lat; dict set ct_inu $lat 1
  }
  set ct_pre {}
  foreach tp $ct_taps { set n [llength [dict get $ct_by [lindex $tp 0]]]; if {$n > $ct_cap} { lappend ct_pre "[lindex $tp 0] $n" } }
  set ct_rmv 0; set ct_rstuck {}
  if {![llength $ct_pre]} {
    puts "OT_CLOCK_TAPS cap recheck after hop latches: all [llength $ct_taps] taps <= cap $ct_cap"
  } else {
    puts "OT_CLOCK_TAPS WARN cap recheck after hop latches: [llength $ct_pre] taps over cap $ct_cap: [join $ct_pre {, }]"
  }
  for {set pass 0} {$ct_rcm && [llength $ct_pre] && $pass < 8 * [llength $ct_taps]} {incr pass} {
    set over ""
    foreach tp $ct_taps {
      if {[lindex $tp 0] ni $ct_rstuck && [llength [dict get $ct_by [lindex $tp 0]]] > $ct_cap} { set over $tp; break }
    }
    if {$over eq ""} break
    set on [lindex $over 0]
    set ct_sbox [expr {$ct_span > 0 ? [ct_span_init $ct_by] : {}}]
    set excess [expr {[llength [dict get $ct_by $on]] - $ct_cap}]
    set cand {}
    foreach it [dict get $ct_by $on] {
      if {[dict exists $ct_pinned $it] || [dict exists $ct_hcap $it] || [dict exists $ct_inu $it]} continue
      if {![catch {[[$it getInst] getMaster] isBlock} ct_isb] && $ct_isb eq "1"} continue
      set mem [list $it]
      if {[dict exists $ct_ul $it]} {
        foreach lat [dict get $ct_ul $it] { if {[$lat getNet] eq [$it getNet]} { lappend mem $lat } }
      }
      set sz [llength $mem]
      lassign [[$it getInst] getLocation] x y
      set d0 [expr {abs($x - [lindex $over 2]) + abs($y - [lindex $over 3])}]
      set best ""; set bd 0
      foreach tp $ct_taps {
        if {[lindex $tp 0] eq $on || [llength [dict get $ct_by [lindex $tp 0]]] + $sz > $ct_cap} continue
        set d [expr {abs($x - [lindex $tp 2]) + abs($y - [lindex $tp 3]) - $d0}]
        if {[info exists ::env(OT_TAP_REASSIGN_UM)] && $d+$d0 > $ct_maxx} continue
        if {$ct_span > 0 && ![ct_span_fits [dict get $ct_sbox [lindex $tp 0]] [ct_span_pts $mem] $ct_span]} { incr ct_span_refused; continue }
        if {$best eq "" || $d < $bd} { set best $tp; set bd $d }
      }
      if {$best ne "" && $bd <= $ct_maxx} { lappend cand [list $bd $mem $best] }
    }
    if {![llength $cand]} {
      puts "OT_CLOCK_TAPS WARN CAP_AFTER_HOP_LATCH $on keeps [llength [dict get $ct_by $on]] sinks > cap $ct_cap: no movable unit has a tap with room within [format %.0f [expr {$ct_maxx / $ct_dbu}]] um"
      lappend ct_rstuck $on
      continue
    }
    set cand [lsort -real -index 0 $cand]
    set tgt [lindex $cand 0 2]; set tn [lindex $tgt 0]
    set room [expr {$ct_cap - [llength [dict get $ct_by $tn]]}]
    set n 0; set gone {}
    foreach c $cand {
      if {$n >= $excess} break
      if {[lindex $c 2 0] ne $tn} continue
      set mem [lindex $c 1]
      if {[llength $mem] > $room - $n} continue
      if {$ct_span > 0} {
        set ct_sp [ct_span_pts $mem]
        if {![ct_span_fits [dict get $ct_sbox $tn] $ct_sp $ct_span]} { incr ct_span_refused; continue }
        dict set ct_sbox $tn [ct_span_grow [dict get $ct_sbox $tn] $ct_sp]
      }
      foreach it $mem { $it disconnect; $it connect [lindex $tgt 1]; dict set gone $it 1 }
      incr n [llength $mem]
    }
    set keep {}
    foreach it [dict get $ct_by $on] { if {![dict exists $gone $it]} { lappend keep $it } }
    dict set ct_by $on $keep; dict set ct_by $tn [concat [dict get $ct_by $tn] [dict keys $gone]]
    incr ct_rmv $n
    if {$n == 0} { lappend ct_rstuck $on; puts "OT_CLOCK_TAPS WARN CAP_AFTER_HOP_LATCH $on keeps [llength $keep] sinks > cap $ct_cap: the sink region rule admits no further move" }
  }
  set ct_over {}
  foreach tp $ct_taps { set n [llength [dict get $ct_by [lindex $tp 0]]]; if {$n > $ct_cap} { lappend ct_over "[lindex $tp 0] $n" } }
  if {[llength $ct_pre]} {
    puts "OT_CLOCK_TAPS cap recheck after hop latches: $ct_rmv sinks re-assigned in [dict size $ct_ul] launch units + single sinks; over cap now: [expr {[llength $ct_over] ? [join $ct_over {, }] : {none}}]"
  }
}
# COORD 10-23 (CP1 r9: 7 of 16 grid taps over macros / empty areas): per-tap sink counts after the cap pass, and
# every tap that got NO sink is DROPPED: its port stays (plan pins unchanged) but carries no tree, and the die
# assembly (gen.py assembly, views/<type>/ot_clock_taps.json) leaves it unconnected, so the spine makes no dead drop.
if {[llength $ct_taps] >= 2} {
  set ct_js {}
  set ct_empty {}
  set ct_oc {}
  foreach tp $ct_taps {
    set k 0
    foreach it [[lindex $tp 1] getITerms] { if {[[$it getMTerm] getIoType] eq "INPUT"} { incr k } }
    lappend ct_js "\"[lindex $tp 0]\": $k"
    if {$k == 0} { lappend ct_empty "\"[lindex $tp 0]\"" }
    if {$k > $ct_cap} { lappend ct_oc "\"[lindex $tp 0]\"" }
  }
  if {[info exists ::env(RESULTS_DIR)]} {
    set fh [open $::env(RESULTS_DIR)/ot_clock_taps.json w]
    puts $fh "{\"sinks\": {[join $ct_js {, }]}, \"dropped\": \[[join $ct_empty {, }]\], \"cap\": $ct_cap, \"over_cap\": \[[join $ct_oc {, }]\]}"
    close $fh
  }
  puts "OT_CLOCK_TAPS per-tap sinks: [join $ct_js {, }]; dropped (no sinks): [llength $ct_empty] [join $ct_empty { }]"
  # FABLE-FIX-S81-LEPE 11-19 (COORD sink region rule): the AS-BUILT sink box of every tap after all the passes above (nearest split,
  # cap pass, pair / chain / reset affinity, hop latches), register clock pins only.  Report, never a stop; fail-open.
  if {[catch {
    set ct_sl [expr {[info exists ::env(OT_TAP_SPAN_UM)] && [string is double -strict $::env(OT_TAP_SPAN_UM)] ? $::env(OT_TAP_SPAN_UM) : 300.0}]
    set ct_so {}; set ct_sm 0.0
    foreach tp $ct_taps {
      set x0 {}; set y0 {}; set x1 {}; set y1 {}
      foreach it [[lindex $tp 1] getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT"} continue
        set ci [$it getInst]; if {[[$ci getMaster] isBlock] || ![string match {DFF*} [[$ci getMaster] getName]]} continue
        set bb [$ci getBBox]; set cx [expr {([$bb xMin] + [$bb xMax]) / 2.0}]; set cy [expr {([$bb yMin] + [$bb yMax]) / 2.0}]
        if {$x0 eq {} || $cx < $x0} { set x0 $cx }; if {$x1 eq {} || $cx > $x1} { set x1 $cx }
        if {$y0 eq {} || $cy < $y0} { set y0 $cy }; if {$y1 eq {} || $cy > $y1} { set y1 $cy }
      }
      if {$x0 eq {}} continue
      set sp [expr {(($x1 - $x0) + ($y1 - $y0)) / $ct_dbu}]
      if {$sp > $ct_sm} { set ct_sm $sp }
      if {$sp > $ct_sl} { lappend ct_so "[lindex $tp 0]=[format %.0f $sp]" }
    }
    puts "OT_TAP_SPAN limit [format %g $ct_sl] um (W+H of the as-built register sink box): [llength $ct_so] of [llength $ct_taps] taps over, max [format %.0f $ct_sm] um[expr {[llength $ct_so] ? ": [join $ct_so { }]" : ""}]"
  } ct_se]} { puts "OT_TAP_SPAN report skipped: $ct_se" }
  # VSN6-B 11-11 S7: the final count never passes silently over the cap
  if {[llength $ct_oc]} { puts "OT_CLOCK_TAPS WARN OVER_CAP [llength $ct_oc] taps > cap $ct_cap sinks in the final assignment: [join $ct_oc { }]" }
}

# Rebind only the typed PHY export whose actual source changed in this tap split.
if {[file exists /work/phy_clock_export_source.tcl]} {source /work/phy_clock_export_source.tcl}
# Verify functional clock ancestry on the final tap state (after any PHY export rebind).
if {$ct_clock_guard_on} {ct_clock_guard_verify}
