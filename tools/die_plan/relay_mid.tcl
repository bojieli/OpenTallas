# GENERATED by tools/die_plan/gen.py phys (sourced at the end of face_flops.tcl, PRE_GLOBAL_PLACE): soft relay stations
# of a partition with hard cores sit ON the straight line between their fixed source and fixed sink, at L*j/(n+1).
# Why (S81-P8 10-23, S81 G3 frame kits): a wirelength-driven GPL put each single relay (ot_s81_rly u_y_*) next to its
# source macro, so the hop to the sink macro was 0.8-1.0 mm (1.2-2.5k register-to-register connections > 750 um per
# kit; COORD: internal hops > 750 need a stage).  At the midpoint the same relay gives two ~450-um hops.
# A relay = the flops whose name matches $::env(OT_RELAY_MID_RE) (group = first capture).  Its sources / sinks are traced
# through <= 4 buffers/inverters to FIXED points (hard-core pins, ports, FIRM face flops) or to another relay group
# (a chain: stage j of n between the head's fixed sources and the tail's fixed sinks).  Groups whose endpoints are not
# all fixed, or whose span is < OT_RELAY_MID_MIN_UM (200), are left to GPL.  Each group is placed FIRM as one compact
# cluster outside every hard-core halo; face_flops_release.tcl releases them (ot_relay_mid.txt) before DPL.
# FIT (S81-TYPES-5 11-07, COORD COLH10 e10 channel; opt-in OT_RELAY_MID_FIT=1, default off = byte-identical behaviour):
# the old fallback took the NEAREST free point to a blocked midpoint, which is often a narrow macro channel (COLH10 vR:
# 1085 lpl_15/16/17 relay flops packed into the two 40-um e10 side channels at density .6-.7).  With FIT a station takes
# the spot on its source-sink line (nearest to the j/(n+1) point) where the WHOLE cluster footprint plus
# OT_RELAY_MID_CHAN_UM (default 20) clears every macro halo, with both legs (previous / next point of the chain)
# <= OT_RELAY_MID_MAX_HOP_UM (default 405); then the same on rings around the midpoint; else the old fallback (logged).
uplevel #0 {
set rm_blk [ord::get_db_block]
set rm_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set rm_re $::env(OT_RELAY_MID_RE)
# OT_RELAY_MID_DEPTH: buffers/inverters traced through to an endpoint (default 4)
set ::rm_depth [expr {[info exists ::env(OT_RELAY_MID_DEPTH)] ? $::env(OT_RELAY_MID_DEPTH) : 4}]
set rm_min [expr {[info exists ::env(OT_RELAY_MID_MIN_UM)] ? $::env(OT_RELAY_MID_MIN_UM) : 200.0}]
set rm_core [$rm_blk getCoreArea]
set rm_x0 [$rm_core xMin]; set rm_y0 [$rm_core yMin]; set rm_x1 [$rm_core xMax]; set rm_y1 [$rm_core yMax]
set rm_rows [$rm_blk getRows]
set rm_sw [[[lindex $rm_rows 0] getSite] getWidth]
set rm_rh [[[lindex $rm_rows 0] getSite] getHeight]
set rm_orient {}
foreach r $rm_rows { dict set rm_orient [lindex [$r getOrigin] 1] [$r getOrient] }
set rm_halo [expr {int(8.64 * $rm_dbu)}]
set rm_mac {}
foreach i [$rm_blk getInsts] {
  if {[[$i getMaster] isBlock]} {
    set b [$i getBBox]
    lappend rm_mac [list [expr {[$b xMin]-$rm_halo}] [expr {[$b yMin]-$rm_halo}] [expr {[$b xMax]+$rm_halo}] [expr {[$b yMax]+$rm_halo}]]
  }
}
set rm_grp {}
set rm_of {}
foreach i [$rm_blk getInsts] {
  set m [$i getMaster]
  if {[$m isBlock] || ![string match "*DFF*" [$m getName]]} continue
  if {![regexp $rm_re [string map {\\ {}} [$i getName]] -> pfx]} continue
  if {[$i getPlacementStatus] in {FIRM LOCKED COVER}} continue
  dict lappend rm_grp $pfx $i
  dict set rm_of [$i getName] $pfx
}
proc rm_isbuf {inst} {
  set m [[$inst getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "INV*" $m] || [string match "HB*" $m]}]
}
proc rm_ctr {b} { return [list [expr {([$b xMin] + [$b xMax]) / 2}] [expr {([$b yMin] + [$b yMax]) / 2}]] }
proc rm_sig {inst io} {
  set r {}
  foreach it [$inst getITerms] {
    if {[$it getSigType] ne "SIGNAL"} continue
    if {[[$it getMTerm] getIoType] eq $io} { lappend r $it }
  }
  return $r
}
# endpoint of an iterm's instance: {P x y} fixed point, {G pfx} relay group, or {} (soft logic)
proc rm_end {it} {
  global rm_of
  set inst [$it getInst]
  if {[[$inst getMaster] isBlock]} { return [concat P [rm_ctr [$it getBBox]]] }
  if {[dict exists $rm_of [$inst getName]]} { return [list G [dict get $rm_of [$inst getName]]] }
  if {[$inst getPlacementStatus] in {FIRM LOCKED}} { return [concat P [rm_ctr [$inst getBBox]]] }
  return {}
}
proc rm_drv {net depth} {
  if {$net eq "NULL" || $net eq "" || [$net getSigType] ne "SIGNAL"} { return {} }
  foreach bt [$net getBTerms] { return [list [concat P [rm_ctr [$bt getBBox]]]] }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "OUTPUT"} continue
    set inst [$it getInst]
    if {[string match "TIE*" [[$inst getMaster] getName]]} { return {} }
    if {$depth < $::rm_depth && ![[$inst getMaster] isBlock] && [rm_isbuf $inst]} {
      foreach i2 [rm_sig $inst INPUT] { return [rm_drv [$i2 getNet] [expr {$depth + 1}]] }
    }
    set e [rm_end $it]
    return [expr {$e eq {} ? [list X] : [list $e]}]
  }
  return {}
}
# a 2-input gate on the way to the sink (the seam writer's chunk clear: q = rq ? i : 0, ot_pl_seam_w_pl) is part of the
# data path, not an endpoint (S81 g3k3 review 10-24: h10_r2 u_y_rt_24b_0..sk -> u_lpl_8_w -> S face flop was left to GPL,
# 4 stages bunched at the source, last hop 894 um); only on the load side, where the gated input is the traced one
proc rm_isgate {inst} {
  return [regexp {^(AND2|NAND2|OR2|NOR2)x} [[$inst getMaster] getName]]
}
proc rm_loads {net depth} {
  set r {}
  if {$net eq "NULL" || $net eq "" || [$net getSigType] ne "SIGNAL"} { return $r }
  foreach bt [$net getBTerms] { lappend r [concat P [rm_ctr [$bt getBBox]]] }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set inst [$it getInst]
    # flop async set/reset / clock pins are not data sinks (a relay's reset-pin register drives its own RESETNs)
    if {[string match "*DFF*" [[$inst getMaster] getName]] && [[$it getMTerm] getName] ne "D"} continue
    if {$depth < $::rm_depth && ![[$inst getMaster] isBlock] && ([rm_isbuf $inst] || [rm_isgate $inst])} {
      foreach o [rm_sig $inst OUTPUT] { set r [concat $r [rm_loads [$o getNet] [expr {$depth + 1}]]] }
      continue
    }
    set e [rm_end $it]
    lappend r [expr {$e eq {} ? "X" : $e}]
  }
  return $r
}
# per group: fixed source / sink centroids, source / sink groups, soft (X) endpoints
set rm_info {}
dict for {g insts} $rm_grp {
  set sp {}; set sg {}; set kp {}; set kg {}; set soft 0
  foreach i $insts {
    foreach d [rm_sig $i INPUT] {
      if {[[$d getMTerm] getName] ne "D"} continue
      foreach e [rm_drv [$d getNet] 0] {
        switch [lindex $e 0] { P { lappend sp [lrange $e 1 2] } G { if {[lindex $e 1] ne $g} { dict set sg [lindex $e 1] 1 } } default { incr soft } }
      }
    }
    foreach q [rm_sig $i OUTPUT] {
      foreach e [rm_loads [$q getNet] 0] {
        switch [lindex $e 0] { P { lappend kp [lrange $e 1 2] } G { if {[lindex $e 1] ne $g} { dict set kg [lindex $e 1] 1 } } default { incr soft } }
      }
    }
  }
  dict set rm_info $g [list $sp [dict keys $sg] $kp [dict keys $kg] $soft]
}
proc rm_cent {pts} {
  set x 0; set y 0
  foreach p $pts { set x [expr {$x + [lindex $p 0]}]; set y [expr {$y + [lindex $p 1]}] }
  set n [llength $pts]
  return [list [expr {$x / $n}] [expr {$y / $n}]]
}
# ---- OT_RELAY_POLY: polyline stations around hard macros --------------------------------------------------------
# rm_polyline g ax ay bx by -> {x0 y0 x1 y1 ... xn yn total_len} (Manhattan, DBU) or {} (straight line is clear: old behaviour)
# 1. OT_RELAY_POLY_FILE lines "<glob on head group> x y x y ..." (um) give the full polyline explicitly (plan waypoints)
# 2. otherwise the line is tested against every macro grown by OT_RELAY_POLY_PAD um (default 6.5, so gaps < 13 um close);
#    if it crosses one, a turn-penalised shortest path on an OT_RELAY_POLY_GRID um grid (default 8) avoiding them is used.
set rm_poly [expr {[info exists ::env(OT_RELAY_POLY)] && $::env(OT_RELAY_POLY) eq "1"}]
set rm_wp {}
if {$rm_poly && [info exists ::env(OT_RELAY_POLY_FILE)] && [file exists $::env(OT_RELAY_POLY_FILE)]} {
  set rm_f [open $::env(OT_RELAY_POLY_FILE)]
  foreach rm_l [split [read $rm_f] "\n"] {
    set rm_l [string trim $rm_l]
    if {$rm_l eq "" || [string index $rm_l 0] eq "#"} continue
    dict set rm_wp [lindex $rm_l 0] [lrange $rm_l 1 end]
  }
  close $rm_f
}
set rm_pad [expr {int(([info exists ::env(OT_RELAY_POLY_PAD)] ? $::env(OT_RELAY_POLY_PAD) : 6.5) * $rm_dbu)}]
set rm_gd [expr {int((([info exists ::env(OT_RELAY_POLY_GRID)] ? $::env(OT_RELAY_POLY_GRID) : 8.0)) * $rm_dbu)}]
set rm_pr {}
if {$rm_poly} {
  foreach i [$rm_blk getInsts] {
    if {[[$i getMaster] isBlock]} {
      set b [$i getBBox]
      lappend rm_pr [list [expr {[$b xMin]-$rm_pad}] [expr {[$b yMin]-$rm_pad}] [expr {[$b xMax]+$rm_pad}] [expr {[$b yMax]+$rm_pad}]]
    }
  }
}
proc rm_blocked {x y} {
  global rm_pr
  foreach m $rm_pr { lassign $m a b c d; if {$x > $a && $x < $c && $y > $b && $y < $d} { return 1 } }
  return 0
}
proc rm_seg_clear {x0 y0 x1 y1} {
  global rm_gd
  set len [expr {abs($x1 - $x0) + abs($y1 - $y0)}]
  set k [expr {max(1, int($len / ($rm_gd / 2)))}]
  for {set t 0} {$t <= $k} {incr t} {
    if {[rm_blocked [expr {int($x0 + ($x1 - $x0) * double($t) / $k)}] [expr {int($y0 + ($y1 - $y0) * double($t) / $k)}]]} { return 0 }
  }
  return 1
}
proc rm_plen {pts} {
  set tot 0
  for {set i 2} {$i < [llength $pts]} {incr i 2} {
    set tot [expr {$tot + abs([lindex $pts $i] - [lindex $pts [expr {$i-2}]]) + abs([lindex $pts [expr {$i+1}]] - [lindex $pts [expr {$i-1}]])}]
  }
  return $tot
}
# Manhattan walk A -> B through the polyline vertices: every leg is an L (x first); the walk's length is the polyline's
proc rm_walk {pts} {
  set w [list [lindex $pts 0] [lindex $pts 1]]
  for {set i 2} {$i < [llength $pts]} {incr i 2} {
    set x [lindex $pts $i]; set y [lindex $pts [expr {$i+1}]]
    if {$x != [lindex $w end-1] && $y != [lindex $w end]} { lappend w $x [lindex $w end] }
    lappend w $x $y
  }
  return $w
}
proc rm_along {pts d} {
  set w [rm_walk [lrange $pts 0 end-1]]
  set acc 0
  for {set i 2} {$i < [llength $w]} {incr i 2} {
    set x0 [lindex $w [expr {$i-2}]]; set y0 [lindex $w [expr {$i-1}]]; set x1 [lindex $w $i]; set y1 [lindex $w [expr {$i+1}]]
    set l [expr {abs($x1 - $x0) + abs($y1 - $y0)}]
    if {$l > 0 && $acc + $l >= $d} {
      set f [expr {($d - $acc) / double($l)}]
      return [list [expr {int($x0 + ($x1 - $x0) * $f)}] [expr {int($y0 + ($y1 - $y0) * $f)}]]
    }
    set acc [expr {$acc + $l}]
  }
  return [list [lindex $w end-1] [lindex $w end]]
}
proc rm_polyline {g ax ay bx by} {
  global rm_wpmap rm_pr rm_gd rm_x0 rm_y0 rm_x1 rm_y1 rm_dbu
  # one waypoint = the source point of a soft-source head only (plan relay_polylines with a single point): auto path from it
  if {[dict exists $rm_wpmap $g] && [llength [dict get $rm_wpmap $g]] > 2} {
    set pts {}
    foreach v [dict get $rm_wpmap $g] { lappend pts [expr {int($v * $rm_dbu)}] }
    set pts [concat [list $ax $ay] $pts [list $bx $by]]
    return [concat $pts [rm_plen $pts]]
  }
  # straight (Manhattan-by-L is not the placement line; the old line is the diagonal): test the diagonal
  if {[rm_seg_clear $ax $ay $bx $by]} { return {} }
  set gd $rm_gd
  set nx [expr {($rm_x1 - $rm_x0) / $gd + 1}]; set ny [expr {($rm_y1 - $rm_y0) / $gd + 1}]
  # blocked grid (rasterise macro rectangles)
  set blk [dict create]
  foreach m $rm_pr {
    lassign $m a b c d
    set i0 [expr {max(0, ($a - $rm_x0) / $gd)}]; set i1 [expr {min($nx - 1, ($c - $rm_x0) / $gd + 1)}]
    set j0 [expr {max(0, ($b - $rm_y0) / $gd)}]; set j1 [expr {min($ny - 1, ($d - $rm_y0) / $gd + 1)}]
    for {set i $i0} {$i <= $i1} {incr i} {
      set cx [expr {$rm_x0 + $i * $gd}]
      if {$cx <= $a || $cx >= $c} continue
      for {set j $j0} {$j <= $j1} {incr j} {
        set cy [expr {$rm_y0 + $j * $gd}]
        if {$cy > $b && $cy < $d} { dict set blk "$i,$j" 1 }
      }
    }
  }
  # snap endpoints to the nearest free grid node
  foreach {nm px py} [list s $ax $ay t $bx $by] {
    set ci [expr {min($nx - 1, max(0, ($px - $rm_x0 + $gd / 2) / $gd))}]
    set cj [expr {min($ny - 1, max(0, ($py - $rm_y0 + $gd / 2) / $gd))}]
    set found {}
    for {set r 0} {$r < 200 && $found eq {}} {incr r} {
      for {set di -$r} {$di <= $r && $found eq {}} {incr di} {
        foreach dj [list [expr {-$r}] $r] {
          set ii [expr {$ci + $di}]; set jj [expr {$cj + $dj}]
          if {$ii < 0 || $jj < 0 || $ii >= $nx || $jj >= $ny} continue
          if {![dict exists $blk "$ii,$jj"]} { set found [list $ii $jj]; break }
        }
      }
      if {$found eq {}} {
        for {set dj [expr {-$r}]} {$dj <= $r && $found eq {}} {incr dj} {
          foreach di [list [expr {-$r}] $r] {
            set ii [expr {$ci + $di}]; set jj [expr {$cj + $dj}]
            if {$ii < 0 || $jj < 0 || $ii >= $nx || $jj >= $ny} continue
            if {![dict exists $blk "$ii,$jj"]} { set found [list $ii $jj]; break }
          }
        }
      }
    }
    if {$found eq {}} { return {} }
    set e$nm $found
  }
  lassign $es si sj
  lassign $et ti tj
  # turn-penalised Dijkstra (bucket queue); state = i,j,dir
  set turn 4
  set dist [dict create]
  set prev [dict create]
  set bucket [dict create 0 [list [list $si $sj 4]]]
  dict set dist "$si,$sj,4" 0
  set cost 0; set goal {}
  set maxc [expr {($nx + $ny) * 6}]
  while {$goal eq {} && $cost <= $maxc} {
    if {![dict exists $bucket $cost]} { incr cost; continue }
    foreach st [dict get $bucket $cost] {
      lassign $st i j dr
      if {[dict get $dist "$i,$j,$dr"] != $cost} continue
      if {$i == $ti && $j == $tj} { set goal "$i,$j,$dr"; break }
      set k 0
      foreach {di dj} {1 0 0 1 -1 0 0 -1} {
        set ni [expr {$i + $di}]; set nj [expr {$j + $dj}]
        if {$ni < 0 || $nj < 0 || $ni >= $nx || $nj >= $ny || [dict exists $blk "$ni,$nj"]} { incr k; continue }
        set nc [expr {$cost + 1 + (($dr != 4 && $dr != $k) ? $turn : 0)}]
        set key "$ni,$nj,$k"
        if {![dict exists $dist $key] || [dict get $dist $key] > $nc} {
          dict set dist $key $nc
          dict set prev $key "$i,$j,$dr"
          dict lappend bucket $nc [list $ni $nj $k]
        }
        incr k
      }
    }
    dict unset bucket $cost
    incr cost
  }
  if {$goal eq {}} { return {} }
  set path {}
  set cur $goal
  while {1} {
    lassign [split $cur ,] i j dr
    set path [linsert $path 0 [list $i $j $dr]]
    if {![dict exists $prev $cur]} break
    set cur [dict get $prev $cur]
  }
  # corner points only; the true endpoints A and B bracket the path
  set pts [list $ax $ay]
  set last -1
  for {set q 0} {$q < [llength $path]} {incr q} {
    lassign [lindex $path $q] i j dr
    set nxt [expr {$q + 1 < [llength $path] ? [lindex $path [expr {$q + 1}] 2] : -2}]
    if {$q == 0 || $nxt != $dr} { lappend pts [expr {$rm_x0 + $i * $gd}] [expr {$rm_y0 + $j * $gd}] }
  }
  lappend pts $bx $by
  return [concat $pts [rm_plen $pts]]
}
# chains: head = fixed sources only; follow the unique successor group (whose unique predecessor is this group)
# waypoint patterns -> head group: a pattern ("re:<regex>" = plan relay_polylines group_re, else a glob) selects any group of a
# chain; the chain's head (walk back over the unique predecessor group) owns the polyline
set rm_wpmap [dict create]
if {$rm_poly} {
  dict for {pat wp} $rm_wp {
    dict for {g inf} $rm_info {
      set hit [expr {[string range $pat 0 2] eq "re:" ? [regexp [string range $pat 3 end] $g] : [string match $pat $g]}]
      if {!$hit} continue
      set h $g; set seen [list $g]
      while {1} {
        set pg [lindex $inf 1]
        if {[llength $pg] != 1 || [lsearch $seen [lindex $pg 0]] >= 0} break
        set h [lindex $pg 0]; lappend seen $h; set inf [dict get $rm_info $h]
      }
      dict set rm_wpmap $h $wp
    }
  }
}
set rm_station {}
set rm_seg {}
# OT_RELAY_MID_SOFT_FRAC (FABLE-FIX-KV-HG 11-18, default 0.02 = unchanged): the share of soft (GPL-placed) endpoints a group may
# have next to its fixed ones.  KV hst2_g: 1,543 fixed lane-pad sources + 32 soft pd1 pad-chain bits = 2.07 %, so the whole
# g/t1/t2 chain of head 2 was left to GPL while the head 3 chain (16 soft bits) was placed.
set rm_softf [expr {[info exists ::env(OT_RELAY_MID_SOFT_FRAC)] && $::env(OT_RELAY_MID_SOFT_FRAC) ne "" ? double($::env(OT_RELAY_MID_SOFT_FRAC)) : 0.02}]
# OT_RELAY_MID_DEBUG=1: one line per relay group (why a group is, or is not, a chain member)
if {[info exists ::env(OT_RELAY_MID_DEBUG)] && $::env(OT_RELAY_MID_DEBUG) eq "1"} {
  dict for {g inf} $rm_info {
    lassign $inf sp sg kp kg soft
    puts "OT_RELAY_MID_DEBUG $g flops [llength [dict get $rm_grp $g]] fixed_src [llength $sp] src_groups {$sg} fixed_sink [llength $kp] sink_groups {$kg} soft $soft (soft_frac $rm_softf)"
  }
}
set rm_polybad {}
dict for {g inf} $rm_info {
  lassign $inf sp sg kp kg soft
  # a few soft endpoints (<= 2% of the fixed ones: status / debug taps) do not move the station
  # OT_RELAY_POLY_FILE waypoints for this head group make a soft-source head (a chain that starts at an lpl / GPL-placed
  # flop, e.g. lpl_18_r.u_y_q -> y_rt_20a_5 -> n20) a legal chain: the first waypoint is its source point
  set wpk {}
  if {$rm_poly && [dict exists $rm_wpmap $g]} { set wpk [dict get $rm_wpmap $g] }
  if {$wpk ne {}} {
    if {[llength $sg] > 0 || [llength $sp] > 0} { set wpk {} }
  }
  if {$wpk eq {} && ($soft > $rm_softf * ([llength $sp] + [llength $kp]) || [llength $sp] == 0 || [llength $sg] > 0)} continue
  if {$wpk ne {} && [llength $sp] == 0} { set sp [list [list [expr {int([lindex $wpk 0] * $rm_dbu)}] [expr {int([lindex $wpk 1] * $rm_dbu)}]]] }
  set chain [list $g]; set cur $g
  while {1} {
    lassign [dict get $rm_info $cur] csp csg ckp ckg csoft
    if {[llength $ckp] > 0 && [llength $ckg] == 0} break
    if {[llength $ckg] != 1 || [llength $ckp] > 0} { set chain {}; break }
    set nx [lindex $ckg 0]
    lassign [dict get $rm_info $nx] nsp nsg nkp nkg nsoft
    if {$nsoft > $rm_softf * ([llength $nsp] + [llength $nkp] + 1) || [llength $nsp] > 0 || [llength $nsg] != 1 || [lsearch $chain $nx] >= 0} { set chain {}; break }
    lappend chain $nx; set cur $nx
  }
  if {$chain eq {}} continue
  lassign [rm_cent $sp] ax ay
  lassign [rm_cent [lindex [dict get $rm_info [lindex $chain end]] 2]] bx by
  if {abs($bx - $ax) + abs($by - $ay) < $rm_min * $rm_dbu} continue
  set n [llength $chain]
  # OT_RELAY_POLY=1 (FIX-RELAYPOLY, R-COL-4): when the straight source-sink line crosses a hard macro (or a sub-12-um gap
  # between macros) the n stations are spread evenly along a polyline that avoids them, not on the line
  set rm_pts {}
  if {$rm_poly} { set rm_pts [rm_polyline $g $ax $ay $bx $by] }
  if {$rm_pts ne {}} {
    set rm_tot [lindex $rm_pts end]
    set rm_tn [expr {$n + 1}]
    if {$rm_tot / double($rm_tn) > 405.0 * $rm_dbu} {
      puts "OT_RELAY_POLY WARN $g path [expr {$rm_tot / $rm_dbu}] um, $rm_tn hops > 405 um"
      lappend rm_polybad [format "%s:%.0fum/%dhops" $g [expr {$rm_tot / $rm_dbu}] $rm_tn]
    }
    set j 0
    foreach c $chain {
      incr j
      dict set rm_station $c [rm_along $rm_pts [expr {$rm_tot * $j / double($rm_tn)}]]
    }
    puts "OT_RELAY_POLY chain [lindex $chain 0]..[lindex $chain end] ($n stations): path [expr {$rm_tot / $rm_dbu}] um, hop [expr {$rm_tot / $rm_dbu / $rm_tn}] um"
    continue
  }
  # S81-COLGEN-3: the straight-line chain's hop is the Manhattan span / (n + 1)
  if {(abs($bx - $ax) + abs($by - $ay)) / double($n + 1) > 405.0 * $rm_dbu} {
    puts "OT_RELAY_POLY WARN $g straight path [expr {(abs($bx - $ax) + abs($by - $ay)) / $rm_dbu}] um, [expr {$n + 1}] hops > 405 um"
    lappend rm_polybad [format "%s:%.0fum/%dhops" $g [expr {(abs($bx - $ax) + abs($by - $ay)) / $rm_dbu}] [expr {$n + 1}]]
  }
  # OT_RELAY_MID_TAIL=1 (FABLE-FIX-KV-HG 11-18, opt-in, default off = byte-identical): a tail that broadcasts to fixed sinks spread
  # wider than the even hop (KV hst_t2 -> the front pins of 4 head eighths over 1.2 mm: with the tail at L*n/(n+1) the far core
  # stays 750-1000 um from it, kv3_hgi_v4 1,170 ends at -255 ps) sits AT the sink centroid: stations at L*j/n.
  set rm_den [expr {$n + 1.0}]
  if {[info exists ::env(OT_RELAY_MID_TAIL)] && $::env(OT_RELAY_MID_TAIL) eq "1"} {
    set rm_spr 0
    foreach rm_p [lindex [dict get $rm_info [lindex $chain end]] 2] {
      set rm_d [expr {abs([lindex $rm_p 0] - $bx) + abs([lindex $rm_p 1] - $by)}]
      if {$rm_d > $rm_spr} { set rm_spr $rm_d }
    }
    if {$rm_spr > (abs($bx - $ax) + abs($by - $ay)) / ($n + 1.0)} {
      set rm_den [expr {double($n)}]
      puts "OT_RELAY_MID_TAIL chain [lindex $chain 0]..[lindex $chain end] ($n stations): sink spread [expr {$rm_spr / double($rm_dbu)}] um > even hop [expr {(abs($bx - $ax) + abs($by - $ay)) / ($n + 1.0) / $rm_dbu}] um, tail at the sink centroid [expr {$bx / double($rm_dbu)}] [expr {$by / double($rm_dbu)}]"
    }
  }
  set j 0
  foreach c $chain {
    incr j
    dict set rm_station $c [list [expr {int($ax + ($bx - $ax) * $j / $rm_den)}] [expr {int($ay + ($by - $ay) * $j / $rm_den)}]]
    dict set rm_seg $c [list $ax $ay $bx $by $j $n]
  }
}
# place: nearest point outside every halo (rings of 2.16 um), compact cluster, clusters at one spot stack upward
proc rm_free {x y} {
  global rm_mac rm_x0 rm_y0 rm_x1 rm_y1
  if {$x < $rm_x0 || $y < $rm_y0 || $x > $rm_x1 || $y > $rm_y1} { return 0 }
  foreach m $rm_mac { lassign $m a b c d; if {$x > $a && $x < $c && $y > $b && $y < $d} { return 0 } }
  return 1
}
set rm_out [open $::env(RESULTS_DIR)/ot_relay_mid.txt w]
set rm_log [open $::env(RESULTS_DIR)/ot_relay_mid_stations.txt w]
set rm_stack {}
set rm_n 0
set rm_step [expr {int(2.16 * $rm_dbu)}]
set rm_fit [expr {[info exists ::env(OT_RELAY_MID_FIT)] && $::env(OT_RELAY_MID_FIT) eq "1"}]
set rm_chan [expr {int(([info exists ::env(OT_RELAY_MID_CHAN_UM)] ? $::env(OT_RELAY_MID_CHAN_UM) : 20.0) * $rm_dbu)}]
set rm_chan0 $rm_chan
set rm_hop [expr {([info exists ::env(OT_RELAY_MID_MAX_HOP_UM)] ? $::env(OT_RELAY_MID_MAX_HOP_UM) : 405.0) * $rm_dbu}]
# footprint {x0 y0 x1 y1} of a cluster centred on x, bottom at y, clear of every halo by rm_chan and inside the core
proc rm_fits {x y w h} {
  global rm_mac rm_x0 rm_y0 rm_x1 rm_y1 rm_chan
  set fx0 [expr {$x - $w / 2}]; set fx1 [expr {$x + $w / 2}]; set fy0 $y; set fy1 [expr {$y + $h}]
  if {$fx0 < $rm_x0 || $fy0 < $rm_y0 || $fx1 > $rm_x1 || $fy1 > $rm_y1} { return 0 }
  foreach m $rm_mac {
    lassign $m a b c d
    if {$fx1 > $a - $rm_chan && $fx0 < $c + $rm_chan && $fy1 > $b - $rm_chan && $fy0 < $d + $rm_chan} { return 0 }
  }
  return 1
}
set rm_nfit 0; set rm_nold 0; set rm_nofit {}; set rm_ndepth 0; set rm_depth {}
dict for {g st} $rm_station {
  lassign $st x y
  set rm_done 0
  if {$rm_fit && [dict exists $rm_seg $g]} {
    lassign [dict get $rm_seg $g] ax ay bx by j n
    set nc0 [llength [dict get $rm_grp $g]]
    set ncol0 [expr {max(1, int(ceil(sqrt($nc0 * 4.0))))}]
    set fw [expr {$ncol0 * $rm_sw * 24}]
    set fh [expr {int(ceil(double($nc0) / $ncol0)) * $rm_rh}]
    # previous / next point of the chain on the line (source and sink for a single stage)
    set px [expr {$ax + ($bx - $ax) * ($j - 1) / ($n + 1.0)}]; set py [expr {$ay + ($by - $ay) * ($j - 1) / ($n + 1.0)}]
    set qx [expr {$ax + ($bx - $ax) * ($j + 1) / ($n + 1.0)}]; set qy [expr {$ay + ($by - $ay) * ($j + 1) / ($n + 1.0)}]
    set f0 [expr {$j / ($n + 1.0)}]
    set len [expr {abs($bx - $ax) + abs($by - $ay)}]
    set steps [expr {max(1, int($len / $rm_step))}]
    set best {}; set bestd {}
    # graded margins: the full channel margin first, then half, then a quarter (never 0: a cluster narrower than a channel
    # would fit back into it; COLH10 vS: margin 20 alone left 11 of 13 stations on the old fallback)
    foreach rm_chan_try [list $rm_chan0 [expr {$rm_chan0 / 2}] [expr {$rm_chan0 / 4}]] {
    if {$best ne {}} break
    set rm_chan $rm_chan_try
    for {set s 0} {$s <= $steps} {incr s} {
      set f [expr {double($s) / $steps}]
      set cx [expr {int($ax + ($bx - $ax) * $f)}]; set cy [expr {int($ay + ($by - $ay) * $f)}]
      set by0 [expr {$cy - $fh / 2}]
      if {abs($cx - $px) + abs($cy - $py) > $rm_hop || abs($cx - $qx) + abs($cy - $qy) > $rm_hop} continue
      if {![rm_fits $cx $by0 $fw $fh]} continue
      set dd [expr {abs($f - $f0)}]
      if {$bestd eq {} || $dd < $bestd} { set best [list $cx $by0 line]; set bestd $dd }
    }
    if {$best eq {}} {
      for {set r 1} {$r < 400 && $best eq {}} {incr r} {
        set d [expr {$r * $rm_step}]
        foreach {dx dy} [list 0 $d 0 -$d $d 0 -$d 0 $d $d -$d $d $d -$d -$d -$d] {
          set cx [expr {$x + $dx}]; set cy [expr {$y + $dy}]
          if {abs($cx - $px) + abs($cy - $py) > $rm_hop || abs($cx - $qx) + abs($cy - $qy) > $rm_hop} continue
          if {[rm_fits $cx [expr {$cy - $fh / 2}] $fw $fh]} { set best [list $cx [expr {$cy - $fh / 2}] ring]; break }
        }
      }
    }
    }
    set rm_used $rm_chan; set rm_chan $rm_chan0
    if {$best ne {}} {
      lassign $best x y how
      set rm_done 1; incr rm_nfit
      puts "OT_RELAY_MID_FIT $g $how [expr {$x / double($rm_dbu)}] [expr {$y / double($rm_dbu)}] footprint [expr {$fw / double($rm_dbu)}]x[expr {$fh / double($rm_dbu)}] um margin [expr {$rm_used / double($rm_dbu)}] um"
    } else {
      incr rm_nold
      # S81-TYPES-R2 11-16: the even-split hop of this stage's line, so a fail-closed stop names depth (hop > max) vs site space
      set rm_eh [expr {$len / ($n + 1.0) / $rm_dbu}]
      lappend rm_nofit [format "%s:%.0f" $g $rm_eh]
      # S81-COL-FLOW-1118 (COORD: col_h9_r0_p2 rt_4a_0 252 um / rt_4b_0 206 um failed place): an even hop within the reach is a
      # site-space miss; the fallback puts the station on its line point (or the nearest free site), so its hop stays ~ the even hop
      if {$rm_eh * $rm_dbu > $rm_hop} { incr rm_ndepth; lappend rm_depth [format "%s:%.0f" $g $rm_eh] }
      puts "OT_RELAY_MID_FIT $g NOFIT (old nearest-free fallback) line [expr {$len / double($rm_dbu)}] um stages $n even hop [format %.1f $rm_eh] um"
    }
  }
  if {!$rm_done && ![rm_free $x $y]} {
    set best {}
    for {set r 1} {$r < 400 && $best eq {}} {incr r} {
      set d [expr {$r * $rm_step}]
      foreach {dx dy} [list 0 $d 0 -$d $d 0 -$d 0 $d $d -$d $d $d -$d -$d -$d] {
        if {[rm_free [expr {$x + $dx}] [expr {$y + $dy}]]} { set best [list [expr {$x + $dx}] [expr {$y + $dy}]]; break }
      }
    }
    if {$best ne {}} { lassign $best x y }
  }
  set key "[expr {$x / (20*$rm_dbu)}],[expr {$y / (20*$rm_dbu)}]"
  set off [expr {[dict exists $rm_stack $key] ? [dict get $rm_stack $key] : 0}]
  set cells [dict get $rm_grp $g]
  set nc [llength $cells]
  set ncol [expr {max(1, int(ceil(sqrt($nc * 4.0))))}]
  set pitch [expr {$rm_sw * 24}]
  set k 0
  foreach c $cells {
    set cx [expr {$x + ($k % $ncol) * $pitch - ($ncol * $pitch) / 2}]
    set cy [expr {$y + ($off + $k / $ncol) * $rm_rh}]
    set cx [expr {$rm_x0 + (($cx - $rm_x0) / $rm_sw) * $rm_sw}]
    set cy [expr {$rm_y0 + (($cy - $rm_y0) / $rm_rh) * $rm_rh}]
    set cx [expr {min(max($cx, $rm_x0), $rm_x1 - [[$c getMaster] getWidth])}]
    set cy [expr {min(max($cy, $rm_y0), $rm_y1 - $rm_rh)}]
    $c setLocation $cx $cy
    if {[dict exists $rm_orient $cy]} { $c setOrient [dict get $rm_orient $cy] }
    $c setPlacementStatus FIRM
    puts $rm_out [$c getName]
    incr k; incr rm_n
  }
  dict set rm_stack $key [expr {$off + int(ceil(double($nc) / $ncol)) + 1}]
  puts $rm_log "$g\t[expr {$x / double($rm_dbu)}]\t[expr {$y / double($rm_dbu)}]\t$nc"
}
close $rm_out; close $rm_log
if {$rm_fit} { puts "OT_RELAY_MID_FIT fitted $rm_nfit stations, $rm_nold on the old fallback (chan [expr {$rm_chan / double($rm_dbu)}] um, hop [expr {$rm_hop / double($rm_dbu)}] um)" }
# GENBUG-7 (11-15): coverage line for the FIT form; OT_RELAY_FALLBACK_MAX_FRAC=<f> (unset = advisory only) fails the hook when
# more than that share of stations took the old nearest-free fallback (table proposal 0.05; 15 of 18 S81 col kits are above it today).
if {$rm_fit} {
  set rm_cov [expr {$rm_nfit + $rm_nold}]
  puts "OT_HOOK_COVERAGE hook=relay_mid touched=$rm_nfit expected=$rm_cov fallback=$rm_nold depth_fallback=$rm_ndepth advisory=[expr {![info exists ::env(OT_RELAY_FALLBACK_MAX_FRAC)]}]"
  if {$rm_nold > $rm_ndepth} {
    puts "OT_HOOK_COVERAGE WARN relay_mid: [expr {$rm_nold - $rm_ndepth}] site-space fallback(s), even hop within [expr {$rm_hop / double($rm_dbu)}] um (advisory): [join $rm_nofit { }]"
  }
  if {[info exists ::env(OT_RELAY_FALLBACK_MAX_FRAC)] && $rm_cov > 0 && double($rm_ndepth) / $rm_cov > $::env(OT_RELAY_FALLBACK_MAX_FRAC)} {
    error "OT_HOOK_COVERAGE relay_mid: $rm_ndepth of $rm_cov stations on the old fallback with an even hop over [expr {$rm_hop / double($rm_dbu)}] um (> $::env(OT_RELAY_FALLBACK_MAX_FRAC)); unfitted group:even_hop_um [join $rm_depth { }]"
  }
}
# S81-COLGEN-3 11-17: OT_RELAY_POLY_FAIL=1 (plan budgets.relay_hop_fail, gen_phys) fails the hook on every relay chain whose hop
# exceeds the 405-um reach once the generator has covered the chains (relay_depth.py rows: stations = ceil(path / 405) - 1).
if {[info exists ::env(OT_RELAY_POLY_FAIL)] && $::env(OT_RELAY_POLY_FAIL) eq "1" && [llength $rm_polybad] > 0} {
  error "OT_RELAY_POLY relay_mid: [llength $rm_polybad] relay chain(s) with a hop > 405 um (relay_depth rows missing?): [join [lrange $rm_polybad 0 11] { }]"
}
puts "OT_RELAY_MID placed $rm_n relay flops of [dict size $rm_station] stations ([dict size $rm_grp] relay groups) FIRM on their source-sink lines"
}
