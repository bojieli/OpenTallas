# GENERATED by tools/die_plan/gen.py phys (PRE_DETAIL_ROUTE hook, only when die.layer_budget.ft_route_layers is set
# and the type has ft slots): ft station-to-station nets on the reserved ft layers (FT-PLAN: partitions M1-M7, ft wires
# on M8/M9; PLAN-TOOL5 reach M8/M9 ~1.0 mm vs M4-M7 ~0.4 mm).
# Why (KV-P7 10-23 22:04): routed KV io kits put the ~640-700 um ft station hops on M1-M4 (io_cor_v1 ft13 s0->s1 TT
# -132.7 ps, io_ft_v1 -37.0 ps).  OpenROAD 26Q3 has no per-net layer range, so:
#   1. GRT (step 5_1) routes every net on MIN..MAX_ROUTING_LAYER as before (ft layers unused by GRT).
#   2. Here, before DRT: the ft hop nets = nets from a station flop u_ft_<slot>_s<j> output through BUF/INV/HB cells
#      to the next cells, with pin-bbox HPWL >= OT_FT_ROUTE_MIN_UM, are global-routed AGAIN with the signal range set
#      to the ft layers only (set_nets_to_route: GRT pin-access stacks from the pin layer up, trunk on the ft layers,
#      capacity-aware), which replaces their guides; then the signal range is opened to MIN..top ft layer for DRT.
#      Every other net keeps its step-5_1 guides (<= MAX_ROUTING_LAYER), so the ft layers carry only ft hops.
# Env: OT_FT_ROUTE_LAYERS (e.g. M8-M9), OT_FT_ROUTE_MIN_UM (default 100), MIN_ROUTING_LAYER; table /work/ft_stations.txt
# (or OT_FT_STATIONS).  Prints FT_ROUTE lines (nets, per-layer guide count, other-net guide check).
uplevel #0 {
set ftr_blk [ord::get_db_block]
set ftr_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set ftr_rng $::env(OT_FT_ROUTE_LAYERS)
lassign [split $ftr_rng "-"] ftr_lo ftr_hi
if {$ftr_hi eq ""} { set ftr_hi $ftr_lo }
set ftr_min_um [expr {[info exists ::env(OT_FT_ROUTE_MIN_UM)] ? $::env(OT_FT_ROUTE_MIN_UM) : 100.0}]
set ftr_smin [expr {[info exists ::env(MIN_ROUTING_LAYER)] ? $::env(MIN_ROUTING_LAYER) : "M2"}]
set ftr_tab [expr {[info exists ::env(OT_FT_STATIONS)] ? $::env(OT_FT_STATIONS) : "/work/ft_stations.txt"}]
# slot -> stations
set ftr_slots [dict create]
set fh [open $ftr_tab r]
foreach ln [split [read $fh] "\n"] {
  if {$ln eq "" || [string index $ln 0] eq "#"} continue
  dict set ftr_slots [lindex $ln 0] [lindex $ln 1]
}
close $fh
proc ftr_is_buf {inst} {
  set m [[$inst getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "INV*" $m] || [string match "HB*" $m]}]
}
proc ftr_out_nets {inst} {
  set r {}
  foreach it [$inst getITerms] {
    if {[$it getSigType] ne "SIGNAL" || [[$it getMTerm] getIoType] ne "OUTPUT"} continue
    set n [$it getNet]
    if {$n ne "NULL"} { lappend r $n }
  }
  return $r
}
proc ftr_hpwl_um {net} {
  global ftr_dbu
  set x0 ""; set y0 ""; set x1 ""; set y1 ""
  foreach it [$net getITerms] {
    set b [$it getBBox]
    foreach {x y} [list [expr {([$b xMin] + [$b xMax]) / 2}] [expr {([$b yMin] + [$b yMax]) / 2}]] {}
    if {$x0 eq "" || $x < $x0} { set x0 $x }; if {$x1 eq "" || $x > $x1} { set x1 $x }
    if {$y0 eq "" || $y < $y0} { set y0 $y }; if {$y1 eq "" || $y > $y1} { set y1 $y }
  }
  foreach bt [$net getBTerms] {
    set b [$bt getBBox]
    set x [expr {([$b xMin] + [$b xMax]) / 2}]; set y [expr {([$b yMin] + [$b yMax]) / 2}]
    if {$x0 eq "" || $x < $x0} { set x0 $x }; if {$x1 eq "" || $x > $x1} { set x1 $x }
    if {$y0 eq "" || $y < $y0} { set y0 $y }; if {$y1 eq "" || $y > $y1} { set y1 $y }
  }
  if {$x0 eq ""} { return 0.0 }
  return [expr {double($x1 - $x0 + $y1 - $y0) / $ftr_dbu}]
}
# station flops (not the last station of a slot: its output is the slot's out port, registered by the neighbour)
set ftr_seen [dict create]
set ftr_work {}
set ftr_nst 0
foreach inst [$ftr_blk getInsts] {
  set nm [$inst getName]
  if {![regexp {^u_ft_(.+)_s([0-9]+)[./\[]} $nm -> slot j]} continue
  if {![dict exists $ftr_slots $slot]} continue
  if {$j >= [dict get $ftr_slots $slot] - 1} continue
  if {![string match "*DFF*" [[$inst getMaster] getName]]} continue
  incr ftr_nst
  foreach n [ftr_out_nets $inst] {
    if {![dict exists $ftr_seen [$n getName]]} { dict set ftr_seen [$n getName] $n; lappend ftr_work $n }
  }
}
# forward through buffers / inverters (repeaters, the QN inverter, repair buffers) to the next station
while {[llength $ftr_work]} {
  set n [lindex $ftr_work end]; set ftr_work [lrange $ftr_work 0 end-1]
  foreach it [$n getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set inst [$it getInst]
    if {![ftr_is_buf $inst]} continue
    foreach n2 [ftr_out_nets $inst] {
      if {![dict exists $ftr_seen [$n2 getName]]} { dict set ftr_seen [$n2 getName] $n2; lappend ftr_work $n2 }
    }
  }
}
set ftr_nets {}
set ftr_long 0.0
dict for {nm n} $ftr_seen {
  set l [ftr_hpwl_um $n]
  if {$l >= $ftr_min_um} { lappend ftr_nets $n; if {$l > $ftr_long} { set ftr_long $l } }
}
puts "FT_ROUTE station_flops $ftr_nst hop_nets [dict size $ftr_seen] routed_on_${ftr_lo}-${ftr_hi} [llength $ftr_nets] (hpwl >= $ftr_min_um um, longest [format %.1f $ftr_long] um)"
if {[llength $ftr_nets]} {
  # a reference non-ft net: its guides must survive the ft-only global route
  set ftr_ref ""; set ftr_ref_g 0
  foreach n [$ftr_blk getNets] {
    if {[$n getSigType] ne "SIGNAL" || [dict exists $ftr_seen [$n getName]]} continue
    set g [llength [$n getGuides]]
    if {$g > $ftr_ref_g} { set ftr_ref $n; set ftr_ref_g $g }
    if {$g >= 8} break
  }
  # GRT clamps its min layer to the lowest IO pin layer (M4 here), so the layers below the ft range get ZERO capacity
  # (adjustment 1.0) for this pass: trunks can only use the ft layers; pin-access via stacks need no edge capacity
  set ftr_lo_lvl [[[ord::get_db_tech] findLayer $ftr_lo] getRoutingLevel]
  set_routing_layers -signal ${ftr_lo}-${ftr_hi}
  set_global_routing_layer_adjustment ${ftr_lo}-${ftr_hi} 0.0
  set_global_routing_layer_adjustment ${ftr_smin}-M[expr {$ftr_lo_lvl - 1}] 1.0
  foreach n $ftr_nets { grt::add_net_to_route $n }
  global_route -congestion_iterations 30 -allow_congestion -verbose
  set_routing_layers -signal ${ftr_smin}-${ftr_hi}
  set ftr_cnt [dict create]
  set ftr_trunk_lo 0
  foreach n $ftr_nets {
    foreach g [$n getGuides] {
      set ln [[$g getLayer] getName]
      dict incr ftr_cnt $ln
      set b [$g getBox]
      # a guide longer than 4 um below the ft layers = trunk off the ft layers
      if {[[$g getLayer] getRoutingLevel] < [[[ord::get_db_tech] findLayer $ftr_lo] getRoutingLevel] &&
          max([$b dx], [$b dy]) > 4 * $ftr_dbu} { incr ftr_trunk_lo }
    }
  }
  puts "FT_ROUTE ft guides per layer: $ftr_cnt; trunk guides below $ftr_lo: $ftr_trunk_lo"
  if {$ftr_ref ne ""} {
    puts "FT_ROUTE reference non-ft net [$ftr_ref getName]: guides $ftr_ref_g -> [llength [$ftr_ref getGuides]]"
  }
  puts "FT_ROUTE block routing layers [$ftr_blk getMinRoutingLayer]-[$ftr_blk getMaxRoutingLayer]"
}
}
