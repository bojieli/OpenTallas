# GENERATED by tools/die_plan/gen.py phys (PRE_RESIZE hook: after global placement, before repair_design).
# OWNER RESET RULE 10-24 / DECISION 13 leaf hop bound (PROTO-KITS 10-25: adopt178 slice_station__t8 leaf hop 448 um,
# relay u_rrl_33 -> station epoch flop u_ft_ft3_s2/eq; OT_RESET_TREE bounded relay -> relay hops only).
# Every tap relay of the partition reset tree (reset_tree.tcl: rtr_place rst_n_t<i> {<inst pattern>} ...) releases
# on the SAME clock (equal depth K at every tap), so any sink may take any tap: here every placed reset-tree sink
# (leaf contents on the centre tap, GPL-placed station / epoch flops, FIRM face flops) moves to the same-polarity net
# of the tap relay NEAREST its placed site -- the nearest-tap rule clock_taps.tcl applies to the clock pin, so a
# sink's reset relay and its clock tap are the same local region.  Taps are found by their relay INSTANCES (not by
# net name: Yosys may keep the alias 'rst_n' for the leaf tap's net).  The relay flops themselves, the entry / run
# stages and hard-core (block) pins are left alone.  repair_design (next) buffers the re-pointed nets.
# Reports  OT_RESET_SINKS ... leaf max <um> (limit OT_RESET_REACH_UM) ... PASS|FAIL  and writes ot_reset_sinks.txt.
set rs_blk [ord::get_db_block]
set rs_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set rs_lim_um [expr {[info exists ::env(OT_RESET_REACH_UM)] ? double($::env(OT_RESET_REACH_UM)) : 405.0}]
set rs_tree /work/reset_tree.tcl
if {[info exists ::env(OT_RESET_TREE_TCL)]} { set rs_tree $::env(OT_RESET_TREE_TCL) }
proc rs_is_inv {inst} { return [string match "INV*" [[$inst getMaster] getName]] }
proc rs_is_buf {inst} {
  set m [[$inst getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "HB*" $m]}]
}
proc rs_ctr {inst} {
  set bb [$inst getBBox]
  return [list [expr {([$bb xMin] + [$bb xMax]) / 2}] [expr {([$bb yMin] + [$bb yMax]) / 2}]]
}
proc rs_outnet {inst} {
  foreach o [$inst getITerms] {
    if {[[$o getMTerm] getIoType] eq "OUTPUT" && [$o getNet] ne "NULL"} { return [$o getNet] }
  }
  return "NULL"
}
# tap relays: rtr_place rst_n_t<i> {<pattern>} x y tag
set rs_pat {}
if {[file exists $rs_tree]} {
  set fh [open $rs_tree r]
  foreach line [split [read $fh] "\n"] {
    if {[regexp {^rtr_place rst_n_t([0-9]+) \{(\S+)\}} $line -> i pat]} { dict set rs_pat $i $pat }
  }
  close $fh
}
set rs_taps {}   ;# tap -> {net x y}
set rs_relay {}  ;# inst name -> 1 (tree / entry / run stages: never re-pointed)
foreach ins [$rs_blk getInsts] {
  set nm [$ins getName]
  if {[regexp {(^|[/.])(u_rst_root|u_rst_in|u_run_root|u_run_in|u_rrl_[0-9]+(_r)?|u_srl_[0-9]+|u_rsync_t[0-9]+)[/.]} $nm]} {
    dict set rs_relay $nm 1
  }
  if {![string match "*DFF*" [[$ins getMaster] getName]]} continue
  dict for {i pat} $rs_pat {
    if {[dict exists $rs_taps $i] || ![string match $pat $nm]} continue
    set n [rs_outnet $ins]
    if {$n eq "NULL"} continue
    lassign [rs_ctr $ins] x y
    dict set rs_taps $i [list $n $x $y]
  }
}
if {[dict size $rs_taps] < 2} {
  puts "OT_RESET_SINKS [dict size $rs_taps] tap relays found ([dict size $rs_pat] in $rs_tree): nothing to do"
} else {
  # nets per tap and polarity (relay output = parity 0; buffer / inverter tree below it)
  set rs_cls {}; set rs_rep {}
  dict for {i v} $rs_taps {
    set todo [list [list [lindex $v 0] 0]]
    while {[llength $todo]} {
      lassign [lindex $todo 0] net par
      set todo [lrange $todo 1 end]
      if {[dict exists $rs_cls [$net getName]]} continue
      dict set rs_cls [$net getName] [list $i $par]
      if {![dict exists $rs_rep "$i,$par"]} { dict set rs_rep "$i,$par" $net }
      foreach it [$net getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT"} continue
        set ins [$it getInst]
        set inv [rs_is_inv $ins]
        if {!$inv && ![rs_is_buf $ins]} continue
        set o [rs_outnet $ins]
        if {$o ne "NULL"} { lappend todo [list $o [expr {$par ^ $inv}]] }
      }
    }
  }
  set rs_moved 0; set rs_keep 0; set rs_nopol 0; set rs_n 0
  set rs_max 0; set rs_max0 0; set rs_bad 0; set rs_worst {}
  set rs_cnt {}
  set fo [open $::env(RESULTS_DIR)/ot_reset_sinks.txt w]
  puts $fo "# inst pin tap_before tap_after dist_before_um dist_after_um"
  foreach ins [$rs_blk getInsts] {
    if {[[$ins getMaster] isBlock]} continue
    if {[rs_is_inv $ins] || [rs_is_buf $ins]} continue
    if {[dict exists $rs_relay [$ins getName]]} continue
    lassign [rs_ctr $ins] x y
    foreach it [$ins getITerms] {
      if {[[$it getMTerm] getIoType] ne "INPUT"} continue
      set net [$it getNet]
      if {$net eq "NULL" || ![dict exists $rs_cls [$net getName]]} continue
      lassign [dict get $rs_cls [$net getName]] k par
      # nearest tap relay that has this polarity
      set best ""; set bd 0
      dict for {i v} $rs_taps {
        if {![dict exists $rs_rep "$i,$par"]} continue
        set d [expr {abs($x - [lindex $v 1]) + abs($y - [lindex $v 2])}]
        if {$best eq "" || $d < $bd} { set best $i; set bd $d }
      }
      set v0 [dict get $rs_taps $k]
      set d0 [expr {abs($x - [lindex $v0 1]) + abs($y - [lindex $v0 2])}]
      incr rs_n
      if {$best eq ""} { incr rs_nopol; set best $k; set bd $d0 }
      if {$best == $k} {
        incr rs_keep
      } else {
        $it disconnect
        $it connect [dict get $rs_rep "$best,$par"]
        incr rs_moved
      }
      dict incr rs_cnt $best
      if {$d0 > $rs_max0} { set rs_max0 $d0 }
      if {$bd > $rs_max} { set rs_max $bd }
      if {$bd > $rs_lim_um * $rs_dbu} {
        incr rs_bad
        if {[llength $rs_worst] < 10} { lappend rs_worst "[$ins getName]/[[$it getMTerm] getName]@t$best:[format %.1f [expr {$bd / double($rs_dbu)}]]" }
      }
      puts $fo "[$ins getName]\t[[$it getMTerm] getName]\t$k\t$best\t[format %.1f [expr {$d0 / double($rs_dbu)}]]\t[format %.1f [expr {$bd / double($rs_dbu)}]]"
    }
  }
  close $fo
  set rs_v [expr {$rs_bad ? "FAIL" : "PASS"}]
  puts "OT_RESET_SINKS [dict size $rs_taps] tap relays, $rs_n sink pins: $rs_moved re-pointed to the nearest tap relay, $rs_keep already there, $rs_nopol without a same-polarity tap (kept); leaf max [format %.1f [expr {$rs_max / double($rs_dbu)}]] um (before [format %.1f [expr {$rs_max0 / double($rs_dbu)}]] um), $rs_bad > $rs_lim_um um: $rs_v $rs_worst; per tap: [lsort -stride 2 -integer -index 0 $rs_cnt]"
}
