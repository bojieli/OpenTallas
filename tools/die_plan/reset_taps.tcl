    if {[llength $source] == 3} {
      lassign $source source_net source_parity xy
      set todo [list [list $source_net $source_parity]]
    } else {
      if {[info exists rt_leaf_reach_um]} { error "OT_RESET_LEAF terminal [$n0 getName] has no single reset launch flop" }
      set todo [list [list $n0 0]]
    }
    while {[llength $todo]} {
      lassign [lindex $todo 0] net par
      set todo [lrange $todo 1 end]
      if {[dict exists $rt_cls [$net getName]]} continue
      dict set rt_cls [$net getName] [list $i $par]
      if {![dict exists $rt_rep "$i,$par"]} { dict set rt_rep "$i,$par" $net }
      foreach it [$net getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT"} continue
        set ins [$it getInst]
        set inv [rt_is_inv $ins]
        if {!$inv && ![rt_is_buf $ins]} continue
        foreach o [$ins getITerms] {
          if {[[$o getMTerm] getIoType] ne "OUTPUT" || [$o getNet] eq "NULL"} continue
          lappend todo [list [$o getNet] [expr {$par ^ $inv}]]
        }
      }
    }
  }
  if {[info exists rt_leaf_reach_um]} {
    foreach alias $rt_zero_aliases {
      if {![dict exists $rt_cls [$alias getName]]} {
        error "OT_RESET_LEAF shared leaf alias [$alias getName] has no unambiguous reset terminal"
      }
    }
  }
  set rt_launch {}
  foreach tp $rt_taps {
    set i [lindex $tp 0]
    set net [rt_tapnet $rt_blk $i]
    if {$net eq "NULL"} continue
    set xy [rt_launch_xy $net {}]
    if {[llength $xy] == 2} { dict set rt_launch $i $xy }
  }
  # (1) synchroniser flops FIRM at their tap
  # listed in ot_face_flops.txt like the face flops, so face_flops_release.tcl hands them back to DPL (PLACED) to
  # legalise next to where GPL kept them (a FIRM DFFASRHQN pair is not row/padding-legal for check_placement)
  set rt_sync 0
  set rt_out [open $::env(RESULTS_DIR)/ot_face_flops.txt a]
  if {(![info exists rt_postplace] || !$rt_postplace) && ![info exists rt_repoint_only]} {
  foreach ins [$rt_blk getInsts] {
    if {![regexp {(^|[/.])u_rsync_t([0-9]+)[/.]} [$ins getName] -> prefix i]} continue
    if {![string match "*DFF*" [[$ins getMaster] getName]]} continue
    foreach tp $rt_taps {
      if {[lindex $tp 0] == $i} {
        set got [ff_put_near $ins [lindex $tp 1] [lindex $tp 2]]
        if {$got ne ""} { puts $rt_out "[$ins getName]\trsync$i\t[expr {[lindex $got 0] / double($rt_dbu)}]\t[expr {[lindex $got 1] / double($rt_dbu)}]\tclk_t$i"; incr rt_sync }
        break
      }
    }
  }
  }
  close $rt_out
  # (2) FIRM flops -> nearest tap's synchroniser nets
  set rt_moved 0; set rt_keep 0; set rt_nopol 0; set rt_aff_refused 0; set rt_aff_l {}; set rt_relay_todo {}; set rt_relay_done 0
  set rt_cnt {}; set rt_leaf_n 0; set rt_leaf_max 0; set rt_leaf_bad {}
  foreach ins [$rt_blk getInsts] {
    # rt_repoint_only (landing_placement.tcl, after the landed line moved stations): only those flops
    if {[info exists rt_repoint_only] && ![dict exists $rt_repoint_only [$ins getName]]} continue
    if {![string match "*DFF*" [[$ins getMaster] getName]]} continue
    if {[info exists rt_postplace] && $rt_postplace} {
      if {[$ins getPlacementStatus] ni {FIRM PLACED LOCKED}} continue
    } elseif {[$ins getPlacementStatus] ne "FIRM"} { continue }
    if {[regexp {(^|[/.])u_rsync_t[0-9]+[/.]} [$ins getName]]} continue
    if {[regexp {(^|[/.])(u_rst_root|u_rst_in|u_run_root|u_run_in|u_[rs]rl_[0-9]+(_[rgb])?)[/.]} [$ins getName]]} continue
    lassign [$ins getLocation] x y
    foreach it [$ins getITerms] {
      if {[[$it getMTerm] getIoType] ne "INPUT"} continue
      set net [$it getNet]
      if {$net eq "NULL" || ![dict exists $rt_cls [$net getName]]} continue
      lassign [dict get $rt_cls [$net getName]] k par
    set best ""; set bd 0
    foreach tp $rt_taps {
      if {[lindex $tp 0] in $rt_bad || ![dict exists $rt_rep "[lindex $tp 0],$par"]} continue
      set i [lindex $tp 0]
      if {[dict exists $rt_launch $i]} { lassign [dict get $rt_launch $i] lx ly } else { lassign [lrange $tp 1 2] lx ly }
      set d [expr {abs($x - $lx) + abs($y - $ly)}]
      if {$best eq "" || $d < $bd} { set best [lindex $tp 0]; set bd $d }
    }
    # QC-TYPES-6 11-07: with TAP-PAIR AFFINITY a flop's clock tap may differ from its nearest tap; its reset then
    # follows its CLOCK tap's relay (same tap = no tap-to-tap recovery/removal path), if that relay has the polarity
    # and is within the leaf reach.  Without OT_TAP_PAIR_AFFINITY=1 nothing changes.
    if {[info exists ::env(OT_TAP_PAIR_AFFINITY)] && $::env(OT_TAP_PAIR_AFFINITY) eq "1" && [info exists rt_postplace] && $rt_postplace} {
      set ck_i ""
      foreach ck [$ins getITerms] {
        if {[[$ck getMTerm] getName] ni {CLK CLKN} || [$ck getNet] eq "NULL"} continue
        set cn [[$ck getNet] getName]
        if {$cn eq "clk"} { set ck_i 0 } else { regexp {^clk_t([0-9]+)$} $cn -> ck_i }
      }
      if {$ck_i ne "" && $ck_i ne $best && $ck_i ni $rt_bad && [dict exists $rt_rep "$ck_i,$par"] && [dict exists $rt_launch $ck_i]} {
        lassign [dict get $rt_launch $ck_i] lx ly
        set d [expr {abs($x - $lx) + abs($y - $ly)}]
        set reach_dbu [expr {[info exists rt_leaf_reach_um] ? $rt_leaf_reach_um * $rt_dbu : ""}]
        set lim_dbu ""
        if {[info exists ::env(OT_RESET_AFFINITY_MAX_DRIVER_UM)] && $::env(OT_RESET_AFFINITY_MAX_DRIVER_UM) ne ""} { set lim_dbu [expr {$::env(OT_RESET_AFFINITY_MAX_DRIVER_UM) * $rt_dbu}] }
        set d_drv 0; set drv_known 0
        set dxy [rt_net_driver_xy [dict get $rt_rep "$ck_i,$par"]]
        if {[llength $dxy] == 2} { set d_drv [expr {abs($x - [lindex $dxy 0]) + abs($y - [lindex $dxy 1])}]; set drv_known 1 }
        lassign [rt_aff_choose $best $bd $ck_i $d $reach_dbu $d_drv $drv_known $lim_dbu] best bd aff_st
        if {$aff_st eq "refused"} {
          incr rt_aff_refused; lappend rt_aff_l "[$ins getName]/[[$it getMTerm] getName]:clk_t$ck_i driver [expr {$drv_known ? [format %.1f [expr {$d_drv/double($rt_dbu)}]] : "unmeasurable"}]um"
        }
      }
    }
      if {$best eq ""} { error "OT_RESET_LEAF no equal-polarity reset terminal for [$ins getName]" }
      dict incr rt_cnt $best
      incr rt_leaf_n
      if {$bd > $rt_leaf_max} { set rt_leaf_max $bd }
      if {[info exists rt_leaf_reach_um] && ![dict exists $rt_launch $best]} {
        error "OT_RESET_LEAF no launch flop on reset terminal $best for [$ins getName]/[[$it getMTerm] getName]"
      }
      if {[info exists rt_leaf_reach_um] && $bd > $rt_leaf_reach_um * $rt_dbu} {
        lappend rt_leaf_bad "[$ins getName]/[[$it getMTerm] getName]:[format %.3f [expr {$bd/double($rt_dbu)}]]um"
      }
      if {[info exists rt_postplace] && $rt_postplace && [info exists ::env(OT_RESET_AFFINITY_MAX_DRIVER_UM)] && $::env(OT_RESET_AFFINITY_MAX_DRIVER_UM) ne ""} {   ;# relay candidates only on the post-place run: pre-GPL coordinates mean nothing
        set tgt ""
        if {$k == $best} { set tgt $net } elseif {[dict exists $rt_rep "$best,$par"]} { set tgt [dict get $rt_rep "$best,$par"] }
        if {$tgt ne ""} {
          set rdxy [rt_net_driver_xy $tgt]
          set rknown [expr {[llength $rdxy] == 2}]
          set rd [expr {$rknown ? abs($x - [lindex $rdxy 0]) + abs($y - [lindex $rdxy 1]) : 0}]
          if {[rt_relay_needed $rd $rknown [expr {$::env(OT_RESET_AFFINITY_MAX_DRIVER_UM) * $rt_dbu}]]} {
            lappend rt_relay_todo [list $ins $it $tgt $rdxy "[$ins getName]/[[$it getMTerm] getName]" [expr {$rknown ? [format %.1f [expr {$rd/double($rt_dbu)}]] : "unmeasurable"}]]
          }
        }
      }
      if {$k == $best} { incr rt_keep; continue }
      if {![dict exists $rt_rep "$best,$par"]} { incr rt_nopol; continue }
      $it disconnect
      $it connect [dict get $rt_rep "$best,$par"]
      incr rt_moved
    }
  }
  if {[info exists rt_leaf_reach_um]} {
    set verdict [expr {[llength $rt_leaf_bad] ? "OVER" : "PASS"}]
    puts "OT_RESET_TREE LEAF $rt_leaf_n sinks, max hop [format %.3f [expr {$rt_leaf_max/double($rt_dbu)}]] um, limit $rt_leaf_reach_um um: $verdict"
    if {[llength $rt_leaf_bad]} { puts "OT_RESET_LEAF advisory, over the hop target, timed at sign-off: [lrange $rt_leaf_bad 0 19]" }
  }
  if {[llength $rt_relay_todo]} {
    if {[info exists ::env(OT_RESET_RELAY)] && $::env(OT_RESET_RELAY) eq "1"} {
      foreach td $rt_relay_todo {
        lassign $td rins rit rnet rdxy rtag rleg
        if {[llength $rdxy] == 2 && [rt_insert_relay $rt_blk $rit $rdxy $rtag]} { incr rt_relay_done }
      }
    }
    puts [rt_relay_report $rt_relay_todo $rt_relay_done [expr {[info exists ::env(OT_RESET_RELAY)] ? $::env(OT_RESET_RELAY) : 0}]]
  }
  if {$rt_aff_refused} { puts "OT_RESET_AFFINITY_REFUSED $rt_aff_refused affinity override(s) refused (relay driver beyond or unmeasurable at $::env(OT_RESET_AFFINITY_MAX_DRIVER_UM) um), nearest tap used: [lrange $rt_aff_l 0 19]" }
  puts "OT_RESET_TAPS [llength $rt_taps] taps ([llength $rt_bad] without a synchroniser: their flops use the nearest tap that has one), $rt_sync synchroniser flops FIRM at their taps; FIRM flop reset/epoch pins: $rt_moved re-pointed (nearest tap, or the clock tap under TAP-PAIR AFFINITY), $rt_keep already there, $rt_nopol without a same-polarity net (kept); per tap: [lsort -stride 2 -integer -index 0 $rt_cnt]"
}
}
lassign [lindex $rt_role_tables 0] rt_reset_role rt_named_nets rt_zero_aliases
