# GENERATED by tools/die_plan/gen.py phys (POST_GLOBAL_PLACE hook, after GPL and before repair_design / DPL).
# Re-clusters the leaves of every landing reset forest (rtl/common/landed_parent/ot_pl_land_reset_forest.sv: a prefix
# chain of DEPTH-2 kept flops -> BRANCHES kept branch flops -> LEAVES kept leaf flops, leaf l fed by branch[l/32]) by
# LOCATION and re-places the branch and prefix flops, so every forest hop is <= OT_FOREST_HOP_UM (750, COORD R3-INTERNAL).
# Why (S81-P9 10-23, GEOM-REVIEW6): the RTL assignment leaf l -> branch[l/32] ignores where GPL puts the leaves (next to
# their landing seams), so each branch sat at the centroid of 32 scattered leaves: branch -> leaf hops 1.0-1.7 mm in
# every S81 frame band (u_r<k>.u_lpr_r<k>).
# Function: every branch flop has the SAME D (the last prefix flop, through the same buffer/inverter parity), the same
# clock and the same master, so all branch outputs carry the identical value every cycle; which branch feeds which leaf
# is functionally irrelevant.  The step checks exactly that per forest (else the forest is left alone and logged as
# SKIP) and the only netlist edit is: a leaf's D moves from a net of branch a to the net of the SAME parity
# (relative to the branch output pin) of branch b.  A missing parity-1 net gets one new inverter at branch b; buffers /
# inverters left without loads are removed (repair_design re-buffers).  Every edit -> $RESULTS_DIR/ot_forest_recluster.txt.
# Placement (PLACED, DPL legalises): each leaf moves to the bbox centre of its loads; the leaves are split into
# BRANCHES groups of <= OT_FOREST_BRANCH_CAP (32, the RTL fan-out) by recursive bisection that minimises the larger
# half's extent; branch b sits at its group's bbox centre (pulled toward the hub when the hub is > hop away); the last
# prefix flop (the hub) at the bbox centre of the branches; prefix flops 0..P-2 evenly on the line from prefix[0]'s
# driver to the hub.  Hops that still exceed the limit are reported as OT_FOREST_RECLUSTER WARN (geometry, not tool).
uplevel #0 {
set fr_blk [ord::get_db_block]
set fr_dbu [[ord::get_db_tech] getDbUnitsPerMicron]
set fr_re [expr {[info exists ::env(OT_FOREST_RE)] ? $::env(OT_FOREST_RE) : {^(.*)[.]g_(prefix|branch|leaf)\[([0-9]+)\][.]u_ff[./]}}]
set fr_hop [expr {([info exists ::env(OT_FOREST_HOP_UM)] ? $::env(OT_FOREST_HOP_UM) : 750.0) * $fr_dbu}]
# plan to the limit minus a legalisation margin (row / site snapping and DPL moves; OT_FOREST_MARGIN_UM, 25)
set fr_plan [expr {$fr_hop - ([info exists ::env(OT_FOREST_MARGIN_UM)] ? $::env(OT_FOREST_MARGIN_UM) : 25.0) * $fr_dbu}]
set fr_cap [expr {[info exists ::env(OT_FOREST_BRANCH_CAP)] ? $::env(OT_FOREST_BRANCH_CAP) : 32}]
set fr_core [$fr_blk getCoreArea]
set fr_x0 [$fr_core xMin]; set fr_y0 [$fr_core yMin]; set fr_x1 [$fr_core xMax]; set fr_y1 [$fr_core yMax]
set fr_rows [$fr_blk getRows]
set fr_sw [[[lindex $fr_rows 0] getSite] getWidth]
set fr_rh [[[lindex $fr_rows 0] getSite] getHeight]
set fr_orient {}
foreach r $fr_rows { dict set fr_orient [lindex [$r getOrigin] 1] [$r getOrient] }
set fr_halo [expr {int(8.64 * $fr_dbu)}]
set fr_mac {}
foreach i [$fr_blk getInsts] {
  if {[[$i getMaster] isBlock]} {
    set b [$i getBBox]
    lappend fr_mac [list [expr {[$b xMin]-$fr_halo}] [expr {[$b yMin]-$fr_halo}] [expr {[$b xMax]+$fr_halo}] [expr {[$b yMax]+$fr_halo}]]
  }
}
proc fr_is_ff {i} { return [string match "*DFF*" [[$i getMaster] getName]] }
proc fr_is_inv {i} { return [string match "INV*" [[$i getMaster] getName]] }
proc fr_is_buf {i} {
  set m [[$i getMaster] getName]
  return [expr {[string match "BUF*" $m] || [string match "HB*" $m]}]
}
proc fr_ctr {i} {
  set b [$i getBBox]
  return [list [expr {([$b xMin] + [$b xMax]) / 2}] [expr {([$b yMin] + [$b yMax]) / 2}]]
}
proc fr_pin {i nm} {
  foreach it [$i getITerms] { if {[[$it getMTerm] getName] eq $nm} { return $it } }
  return ""
}
proc fr_out {i} {
  foreach it [$i getITerms] {
    if {[$it getSigType] eq "SIGNAL" && [[$it getMTerm] getIoType] eq "OUTPUT" && [$it getNet] ne "NULL"} { return $it }
  }
  return ""
}
proc fr_in1 {i} {
  foreach it [$i getITerms] {
    if {[$it getSigType] eq "SIGNAL" && [[$it getMTerm] getIoType] eq "INPUT"} { return $it }
  }
  return ""
}
# source of a net through buffers / inverters: {inst parity} (inst = the driving non-buffer cell), {PORT name 0}, or {}
proc fr_src {net} {
  set par 0
  for {set d 0} {$d < 512} {incr d} {   ;# timing-driven GPL repeater chains run > 16 deep (h10_r0_p1: 20+)
    if {$net eq "NULL" || $net eq ""} { return {} }
    foreach bt [$net getBTerms] { return [list PORT [$bt getName] $par] }
    set drv ""
    foreach it [$net getITerms] { if {[[$it getMTerm] getIoType] eq "OUTPUT"} { set drv $it; break } }
    if {$drv eq ""} { return {} }
    set i [$drv getInst]
    if {[fr_is_buf $i] || [fr_is_inv $i]} {
      if {[fr_is_inv $i]} { set par [expr {$par ^ 1}] }
      set net [[fr_in1 $i] getNet]
      continue
    }
    return [list $i $par]
  }
  return {}
}
# nets below a flop output through buffers / inverters: list of {net parity}, BFS order; collects the tree's cells
proc fr_tree {ff cellsVar} {
  upvar $cellsVar cells
  set o [fr_out $ff]
  if {$o eq ""} { return {} }
  set r {}; set todo [list [list [$o getNet] 0]]; set seen {}
  while {[llength $todo]} {
    lassign [lindex $todo 0] net par
    set todo [lrange $todo 1 end]
    if {[dict exists $seen [$net getId]]} continue
    dict set seen [$net getId] 1
    lappend r [list $net $par]
    foreach it [$net getITerms] {
      if {[[$it getMTerm] getIoType] ne "INPUT"} continue
      set i [$it getInst]
      if {!([fr_is_buf $i] || [fr_is_inv $i])} continue
      lappend cells $i
      set oo [fr_out $i]
      if {$oo ne ""} { lappend todo [list [$oo getNet] [expr {$par ^ [fr_is_inv $i]}]] }
    }
  }
  return $r
}
proc fr_free {x y} {
  global fr_mac fr_x0 fr_y0 fr_x1 fr_y1
  if {$x < $fr_x0 || $y < $fr_y0 || $x > $fr_x1 || $y > $fr_y1} { return 0 }
  foreach m $fr_mac { lassign $m a b c d; if {$x > $a && $x < $c && $y > $b && $y < $d} { return 0 } }
  return 1
}
# nearest point outside every macro halo (rings of 2.16 um)
proc fr_freept {x y} {
  global fr_dbu fr_x0 fr_y0 fr_x1 fr_y1
  set x [expr {min(max($x, $fr_x0), $fr_x1)}]; set y [expr {min(max($y, $fr_y0), $fr_y1)}]
  if {[fr_free $x $y]} { return [list $x $y] }
  set st [expr {int(2.16 * $fr_dbu)}]
  for {set r 1} {$r < 600} {incr r} {
    set d [expr {$r * $st}]
    foreach {dx dy} [list 0 $d 0 -$d $d 0 -$d 0 $d $d -$d $d $d -$d -$d -$d] {
      if {[fr_free [expr {$x + $dx}] [expr {$y + $dy}]]} { return [list [expr {$x + $dx}] [expr {$y + $dy}]] }
    }
  }
  return [list $x $y]
}
proc fr_put {i x y} {
  global fr_x0 fr_y0 fr_x1 fr_y1 fr_sw fr_rh fr_orient
  lassign [fr_freept $x $y] x y
  set cx [expr {$fr_x0 + int(($x - $fr_x0) / $fr_sw) * $fr_sw}]
  set cy [expr {$fr_y0 + int(($y - $fr_y0) / $fr_rh) * $fr_rh}]
  set cx [expr {min(max($cx, $fr_x0), $fr_x1 - [[$i getMaster] getWidth])}]
  set cy [expr {min(max($cy, $fr_y0), $fr_y1 - $fr_rh)}]
  if {[dict exists $fr_orient $cy]} { $i setOrient [dict get $fr_orient $cy] }
  $i setLocation $cx $cy
  $i setPlacementStatus PLACED
  return [list $cx $cy]
}
proc fr_md {a b} { return [expr {abs([lindex $a 0] - [lindex $b 0]) + abs([lindex $a 1] - [lindex $b 1])}] }
proc fr_bb {pts} {
  set xs {}; set ys {}
  foreach p $pts { lappend xs [lindex $p 1]; lappend ys [lindex $p 2] }
  set xs [lsort -real $xs]; set ys [lsort -real $ys]
  return [list [lindex $xs 0] [lindex $ys 0] [lindex $xs end] [lindex $ys end]]
}
proc fr_bbc {pts} { lassign [fr_bb $pts] a b c d; return [list [expr {($a + $c) / 2}] [expr {($b + $d) / 2}]] }
# recursive bisection: pts = list of {id x y}, B groups of <= cap; split minimises the larger half's (w+h)
proc fr_split {pts B cap} {
  if {$B <= 1} { return [list $pts] }
  set n [llength $pts]
  set best ""; set bc 0
  foreach ax {1 2} {
    set s [lsort -real -index $ax $pts]
    # prefix / suffix bbox half-perimeters
    set pre {}; set a 1e18; set b 1e18; set c -1e18; set d -1e18
    foreach p $s {
      set a [expr {min($a, [lindex $p 1])}]; set b [expr {min($b, [lindex $p 2])}]
      set c [expr {max($c, [lindex $p 1])}]; set d [expr {max($d, [lindex $p 2])}]
      lappend pre [expr {($c - $a) + ($d - $b)}]
    }
    set suf {}; set a 1e18; set b 1e18; set c -1e18; set d -1e18
    foreach p [lreverse $s] {
      set a [expr {min($a, [lindex $p 1])}]; set b [expr {min($b, [lindex $p 2])}]
      set c [expr {max($c, [lindex $p 1])}]; set d [expr {max($d, [lindex $p 2])}]
      lappend suf [expr {($c - $a) + ($d - $b)}]
    }
    set suf [lreverse $suf]
    for {set b1 1} {$b1 < $B} {incr b1} {
      set b2 [expr {$B - $b1}]
      set lo [expr {max(0, $n - $cap * $b2)}]; set hi [expr {min($n, $cap * $b1)}]
      for {set n1 $lo} {$n1 <= $hi} {incr n1} {
        set e1 [expr {$n1 > 0 ? [lindex $pre [expr {$n1 - 1}]] / double($b1) : 0}]
        set e2 [expr {$n1 < $n ? [lindex $suf $n1] / double($b2) : 0}]
        set cost [expr {max($e1, $e2)}]
        if {$best eq "" || $cost < $bc} { set bc $cost; set best [list $ax $b1 $n1] }
      }
    }
  }
  lassign $best ax b1 n1
  set s [lsort -real -index $ax $pts]
  return [concat [fr_split [lrange $s 0 [expr {$n1 - 1}]] $b1 $cap] [fr_split [lrange $s $n1 end] [expr {$B - $b1}] $cap]]
}

# weighted L1 minimax: pts = {x y R}; the point that minimises max(d - R) (|dx|+|dy| = max(|du|,|dv|), u=x+y, v=x-y)
proc fr_minimax {pts} {
  set lu -1e18; set hu 1e18; set lv -1e18; set hv 1e18
  foreach p $pts {
    lassign $p x y R
    set u [expr {$x + $y}]; set v [expr {$x - $y}]
    set lu [expr {max($lu, $u - $R)}]; set hu [expr {min($hu, $u + $R)}]
    set lv [expr {max($lv, $v - $R)}]; set hv [expr {min($hv, $v + $R)}]
  }
  set u [expr {($lu + $hu) / 2.0}]; set v [expr {($lv + $hv) / 2.0}]
  return [list [expr {int(($u + $v) / 2)}] [expr {int(($u - $v) / 2)}]]
}

# ---- 1-bit reset pipelines (ot_pl_pad chains of the landing reset: u_lpr_root, u_lpr_ft<k>, u_frl_rst; S81-P9 10-23)
# GPL clumps their g_reg.r[k] stages, so a 1-6 stage chain still made one mm-long hop (h10_r0_p1: lpr_root ->
# frame_int_o0 1,680 um).  Each chain (stage k fed by stage k-1, checked) goes on the line from its head's source to the
# L1 minimax point of its tail's loads, stage j of n at j/(n+1); a chain that needs more stages (ceil(L / plan) - 1 > n) or whose
# loads spread beyond one hop is reported (OT_RESET_CHAIN NEED), the stages are added in RTL.
set fr_cre [expr {[info exists ::env(OT_RSTCHAIN_RE)] ? $::env(OT_RSTCHAIN_RE) : {^(.*[.]u_(?:lpr_root|lpr_ft[0-9]*|frl_rst))[.]g_reg[.]r\[([0-9]+)\]}}]
set fr_ch {}
foreach i [$fr_blk getInsts] {
  if {![fr_is_ff $i]} continue
  if {![regexp $fr_cre [string map {\\ {}} [$i getName]] -> cpfx k]} continue
  dict set fr_ch $cpfx $k $i
}
set fr_cn 0; set fr_cneed 0; set fr_cb 0; set fr_ca 0
proc fr_xy_of {it} {
  set i [$it getInst]
  if {[[$i getMaster] isBlock]} { set b [$it getBBox]; return [list [expr {([$b xMin]+[$b xMax])/2}] [expr {([$b yMin]+[$b yMax])/2}]] }
  return [fr_ctr $i]
}
proc fr_loads {net depth} {
  set r {}
  if {$net eq "NULL" || $net eq ""} { return $r }
  foreach bt [$net getBTerms] { set b [$bt getBBox]; lappend r [list [expr {([$b xMin]+[$b xMax])/2}] [expr {([$b yMin]+[$b yMax])/2}]] }
  foreach it [$net getITerms] {
    if {[[$it getMTerm] getIoType] ne "INPUT"} continue
    set i [$it getInst]
    if {$depth < 64 && ([fr_is_buf $i] || [fr_is_inv $i])} {
      set o [fr_out $i]
      if {$o ne ""} { set r [concat $r [fr_loads [$o getNet] [expr {$depth + 1}]]] }
      continue
    }
    lappend r [fr_xy_of $it]
  }
  return $r
}
dict for {cpfx stg} $fr_ch {
  set ks [lsort -integer [dict keys $stg]]
  set L {}; foreach k $ks { lappend L [dict get $stg $k] }
  set ok [expr {[lindex $ks 0] == 0 && [lindex $ks end] == [llength $ks] - 1}]
  for {set j 1} {$ok && $j < [llength $L]} {incr j} {
    set s [fr_src [[fr_pin [lindex $L $j] D] getNet]]
    if {[lindex $s 0] ne [lindex $L [expr {$j - 1}]]} { set ok 0 }
  }
  set s [fr_src [[fr_pin [lindex $L 0] D] getNet]]
  if {!$ok || $s eq {}} { puts "OT_RESET_CHAIN SKIP $cpfx (not a simple chain)"; continue }
  if {[lindex $s 0] eq "PORT"} { set b [[$fr_blk findBTerm [lindex $s 1]] getBBox]; set sxy [list [expr {([$b xMin]+[$b xMax])/2}] [expr {([$b yMin]+[$b yMax])/2}]] } else { set sxy [fr_ctr [lindex $s 0]] }
  set lds [fr_loads [[fr_out [lindex $L end]] getNet] 0]
  if {![llength $lds]} { puts "OT_RESET_CHAIN SKIP $cpfx (no loads)"; continue }
  # before
  set hb 0; set prev $sxy
  foreach f $L { set hb [expr {max($hb, [fr_md $prev [fr_ctr $f]])}]; set prev [fr_ctr $f] }
  foreach q $lds { set hb [expr {max($hb, [fr_md $prev $q])}] }
  set mm {}; foreach q $lds { lappend mm [list {*}$q 0] }
  set T [fr_minimax $mm]
  set rs 0; foreach q $lds { set rs [expr {max($rs, [fr_md $T $q])}] }
  set n [llength $L]
  set j 0
  foreach f $L {
    incr j
    fr_put $f [expr {int([lindex $sxy 0] + ([lindex $T 0] - [lindex $sxy 0]) * $j / ($n + 1.0))}] [expr {int([lindex $sxy 1] + ([lindex $T 1] - [lindex $sxy 1]) * $j / ($n + 1.0))}]
  }
  set ha 0; set prev $sxy
  foreach f $L { set ha [expr {max($ha, [fr_md $prev [fr_ctr $f]])}]; set prev [fr_ctr $f] }
  foreach q $lds { set ha [expr {max($ha, [fr_md $prev $q])}] }
  set need [expr {int(ceil([fr_md $sxy $T] / double($fr_plan))) - 1}]
  set u [expr {double($fr_dbu)}]
  set msg ""
  if {$ha > $fr_hop} {
    incr fr_cneed
    set msg " NEED [expr {max($need, $n)}] stages (has $n; source->tail-load centre [format %.0f [expr {[fr_md $sxy $T] / $u}]] um)[expr {$rs > $fr_plan ? " + loads spread [format %.0f [expr {$rs / $u}]] um from their centre: split the fan-out" : ""}]"
  }
  puts "OT_RESET_CHAIN $cpfx: $n stages, [llength $lds] loads, max hop [format %.0f [expr {$hb / $u}]] -> [format %.0f [expr {$ha / $u}]] um$msg"
  set fr_cb [expr {max($fr_cb, $hb)}]; set fr_ca [expr {max($fr_ca, $ha)}]
  incr fr_cn
}
puts "OT_RESET_CHAIN $fr_cn chains placed on their source->load lines ($fr_cneed still over [expr {$fr_hop / double($fr_dbu)}] um); max hop [format %.0f [expr {$fr_cb / double($fr_dbu)}]] -> [format %.0f [expr {$fr_ca / double($fr_dbu)}]] um"

# ---- forests by name
set fr_f {}
foreach i [$fr_blk getInsts] {
  if {![fr_is_ff $i]} continue
  if {![regexp $fr_re [string map {\\ {}} [$i getName]] -> pfx kind idx]} continue
  dict lappend fr_f $pfx [list $kind $idx $i]
}
set fr_log [open $::env(RESULTS_DIR)/ot_forest_recluster.txt w]
puts $fr_log "# forest\tleaf\told_branch\tnew_branch\tparity\tleaf_x_um\tleaf_y_um\tnew_branch_x_um\tnew_branch_y_um"
set fr_tot_mv 0; set fr_tot_leaf 0; set fr_done 0; set fr_skip 0; set fr_newinv 0; set fr_rm 0
set fr_wmax_b 0; set fr_wmax_a 0; set fr_warn 0
set fr_inv_master ""
dict for {pfx lst} $fr_f {
  set pre {}; set br {}; set lv {}; set bad ""
  foreach e $lst {
    lassign $e kind idx i
    set dd [expr {$kind eq "prefix" ? "pre" : ($kind eq "branch" ? "br" : "lv")}]
    if {[dict exists [set $dd] $idx]} { set bad "two flops in $kind\[$idx\]"; break }
    dict set $dd $idx $i
  }
  if {$bad eq "" && ([dict size $pre] < 1 || [dict size $br] < 1 || [dict size $lv] < 1)} { set bad "incomplete ([dict size $pre] prefix, [dict size $br] branch, [dict size $lv] leaf)" }
  set npre [dict size $pre]
  set preL {}; foreach k [lsort -integer [dict keys $pre]] { lappend preL [dict get $pre $k] }
  set brL {}; foreach k [lsort -integer [dict keys $br]] { lappend brL [dict get $br $k] }
  # identical branches: same master, clock net, D source + parity
  if {$bad eq ""} {
    set b0 [lindex $brL 0]
    set m0 [[$b0 getMaster] getName]
    set c0 [[fr_pin $b0 CLK] getNet]
    set s0 [fr_src [[fr_pin $b0 D] getNet]]
    if {$s0 eq {} || [lindex $s0 0] ne [lindex $preL end]} { set bad "branch D source is not the last prefix flop" }
    foreach b $brL {
      if {$bad ne ""} break
      set ck [fr_pin $b CLK]; set dp [fr_pin $b D]
      if {$ck eq "" || $dp eq "" || [[$b getMaster] getName] ne $m0 || [$ck getNet] ne $c0 || [fr_src [$dp getNet]] ne $s0} {
        set bad "branch [$b getName] not identical to [$b0 getName]"
      }
      foreach it [$b getITerms] {
        if {[[$it getMTerm] getName] in {SETN RESETN} && [$it getNet] ne "NULL"} { set bad "branch [$b getName] has an async set/reset" }
      }
    }
  }
  if {$bad ne ""} { incr fr_skip; puts "OT_FOREST_RECLUSTER SKIP $pfx: $bad"; puts $fr_log "# SKIP $pfx $bad"; continue }
  # branch output trees: net per parity (shallowest), and their buffer / inverter cells
  set fr_cells {}
  set rep {}; set brof {}
  foreach b $brL {
    foreach np [fr_tree $b fr_cells] {
      lassign $np net par
      if {![dict exists $rep "[$b getName],$par"]} { dict set rep "[$b getName],$par" $net }
    }
  }
  foreach c $fr_cells { if {[fr_is_inv $c] && $fr_inv_master eq ""} { set fr_inv_master [$c getMaster] } }
  # leaves: current branch + parity, target = bbox centre of their loads
  set pts {}; set lcur {}; set lpos {}
  foreach k [lsort -integer [dict keys $lv]] {
    set l [dict get $lv $k]
    set s [fr_src [[fr_pin $l D] getNet]]
    if {$s eq {} || [lsearch -exact $brL [lindex $s 0]] < 0} { puts $fr_log "# KEEP [$l getName]: D not from a branch"; continue }
    dict set lcur [$l getName] $s
    set lo [fr_out $l]
    set lp {}
    if {$lo ne ""} {
      foreach it [[$lo getNet] getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT"} continue
        set li [$it getInst]
        if {[[$li getMaster] isBlock]} { set bb [$it getBBox]; lappend lp [list x [expr {([$bb xMin]+[$bb xMax])/2}] [expr {([$bb yMin]+[$bb yMax])/2}]] } else { lappend lp [concat x [fr_ctr $li]] }
      }
      foreach bt [[$lo getNet] getBTerms] { set bb [$bt getBBox]; lappend lp [list x [expr {([$bb xMin]+[$bb xMax])/2}] [expr {([$bb yMin]+[$bb yMax])/2}]] }
    }
    set c [expr {[llength $lp] ? [fr_bbc $lp] : [fr_ctr $l]}]
    dict set lpos [$l getName] [list $l $c]
    lappend pts [list [$l getName] [lindex $c 0] [lindex $c 1]]
  }
  # before (GPL positions, RTL assignment)
  set hb 0
  dict for {ln s} $lcur { set hb [expr {max($hb, [fr_md [fr_ctr [lindex [dict get $lpos $ln] 0]] [fr_ctr [lindex $s 0]]])}] }
  set psrc [fr_src [[fr_pin [lindex $preL 0] D] getNet]]
  set src_xy ""
  if {$psrc ne {} && [lindex $psrc 0] ne "PORT"} { set src_xy [fr_ctr [lindex $psrc 0]] }
  if {$psrc ne {} && [lindex $psrc 0] eq "PORT"} { set bb [[$fr_blk findBTerm [lindex $psrc 1]] getBBox]; set src_xy [list [expr {([$bb xMin]+[$bb xMax])/2}] [expr {([$bb yMin]+[$bb yMax])/2}]] }
  set hpb 0
  set prev $src_xy
  foreach p $preL { if {$prev ne ""} { set hpb [expr {max($hpb, [fr_md $prev [fr_ctr $p]])}] }; set prev [fr_ctr $p] }
  foreach b $brL { set hpb [expr {max($hpb, [fr_md [fr_ctr [lindex $preL end]] [fr_ctr $b]])}] }
  # groups -> branches (group g -> the branch flop nearest its centre, greedy by group size)
  set grp [fr_split $pts [llength $brL] $fr_cap]
  set gc {}
  foreach g $grp { lappend gc [expr {[llength $g] ? [fr_bbc $g] : ""}] }
  # hub = weighted L1 minimax point: a branch whose leaves span r may sit up to (plan - r) from its group centre, so
  # the hub must lie within 2*plan - r of that centre (rotated-box intersection; its centre when empty)
  set hub_pts {}
  set gi 0
  foreach g $grp {
    set c [lindex $gc $gi]; incr gi
    if {$c eq ""} continue
    set r 0; foreach p $g { set r [expr {max($r, [fr_md $c [lrange $p 1 2]])}] }
    lappend hub_pts [list [lindex $c 0] [lindex $c 1] [expr {max(0.0, 2.0 * $fr_plan - $r)}]]
  }
  set hub [fr_minimax $hub_pts]
  # pull a branch toward the hub when the hub is beyond one hop (keeps its leaves within reach if they allow it)
  set bxy {}
  set gi 0
  foreach g $grp {
    set c [lindex $gc $gi]; incr gi
    if {$c eq ""} { lappend bxy $hub; continue }
    set r 0; foreach p $g { set r [expr {max($r, [fr_md $c [lrange $p 1 2]])}] }
    set d [fr_md $c $hub]
    if {$d > $fr_plan} {
      set t [expr {min($d - $fr_plan, max(0.0, $fr_plan - $r))}]
      set f [expr {$t / double($d)}]
      set c [list [expr {int([lindex $c 0] + ([lindex $hub 0] - [lindex $c 0]) * $f)}] [expr {int([lindex $c 1] + ([lindex $hub 1] - [lindex $c 1]) * $f)}]]
    }
    lappend bxy $c
  }
  # netlist: leaf -> branch of its group (same parity net)
  set nmv 0
  set gi 0
  foreach g $grp {
    set b [lindex $brL $gi]
    lassign [fr_put $b {*}[lindex $bxy $gi]] bx by
    foreach p $g {
      set ln [lindex $p 0]
      lassign [dict get $lcur $ln] ob par
      set l [lindex [dict get $lpos $ln] 0]
      lassign [fr_put $l [lindex $p 1] [lindex $p 2]] lx ly
      if {$ob ne $b} {
        if {![dict exists $rep "[$b getName],$par"]} {
          # parity 1 below branch b does not exist yet: one new inverter at the branch
          if {$fr_inv_master eq ""} { set fr_inv_master [[ord::get_db] findMaster INVx2_ASAP7_75t_R] }
          if {$fr_inv_master eq "NULL" || $fr_inv_master eq ""} { puts $fr_log "# KEEP $ln: no inverter master"; continue }
          set nn [odb::dbNet_create $fr_blk "ot_frc_n_${fr_newinv}"]
          set ni [odb::dbInst_create $fr_blk $fr_inv_master "ot_frc_inv_${fr_newinv}"]
          [fr_in1 $ni] connect [[fr_out $b] getNet]
          foreach it [$ni getITerms] { if {[[$it getMTerm] getIoType] eq "OUTPUT"} { $it connect $nn } }
          fr_put $ni $bx $by
          dict set rep "[$b getName],1" $nn
          incr fr_newinv
        }
        set dp [fr_pin $l D]
        $dp disconnect
        $dp connect [dict get $rep "[$b getName],$par"]
        incr nmv
      }
      puts $fr_log "$pfx\t$ln\t[$ob getName]\t[$b getName]\t$par\t[expr {$lx / double($fr_dbu)}]\t[expr {$ly / double($fr_dbu)}]\t[expr {$bx / double($fr_dbu)}]\t[expr {$by / double($fr_dbu)}]"
    }
    incr gi
  }
  # remove buffers / inverters of the old branch trees that lost every load
  set again 1
  while {$again} {
    set again 0
    set keep {}
    foreach c $fr_cells {
      if {[lsearch -exact $keep $c] >= 0} continue
      set o [fr_out $c]
      set dead 0
      if {$o eq ""} { set dead 1 } else {
        set net [$o getNet]
        set nl 0
        foreach it [$net getITerms] { if {[[$it getMTerm] getIoType] eq "INPUT"} { incr nl } }
        if {$nl == 0 && [llength [$net getBTerms]] == 0} { set dead 1 }
      }
      if {$dead} {
        set net [expr {$o eq "" ? "" : [$o getNet]}]
        odb::dbInst_destroy $c
        if {$net ne ""} { odb::dbNet_destroy $net }
        incr fr_rm; set again 1
        set fr_cells [lsearch -all -inline -not -exact $fr_cells $c]
        break
      } else { lappend keep $c }
    }
  }
  # the buffers / inverters left below each branch sit at the branch (DPL spreads them)
  foreach b $brL {
    set bc {}
    fr_tree $b bc
    foreach c $bc { fr_put $c {*}[fr_ctr $b] }
  }
  # prefix chain: last = hub, the rest evenly on the line from prefix[0]'s source
  set P [llength $preL]
  if {$src_xy eq ""} { set src_xy $hub }
  set j 0
  foreach p $preL {
    incr j
    fr_put $p [expr {int([lindex $src_xy 0] + ([lindex $hub 0] - [lindex $src_xy 0]) * $j / double($P))}] [expr {int([lindex $src_xy 1] + ([lindex $hub 1] - [lindex $src_xy 1]) * $j / double($P))}]
  }
  # after: planned hops (pre-DPL positions)
  set ha 0; set hpa 0
  set prev $src_xy
  foreach p $preL { set hpa [expr {max($hpa, [fr_md $prev [fr_ctr $p]])}]; set prev [fr_ctr $p] }
  foreach b $brL { set hpa [expr {max($hpa, [fr_md [fr_ctr [lindex $preL end]] [fr_ctr $b]])}] }
  foreach b $brL {
    foreach np [fr_tree $b fr_dummy] {
      foreach it [[lindex $np 0] getITerms] {
        if {[[$it getMTerm] getIoType] ne "INPUT" || [[$it getMTerm] getName] ne "D"} continue
        set ha [expr {max($ha, [fr_md [fr_ctr $b] [fr_ctr [$it getInst]]])}]
      }
    }
  }
  set u [expr {double($fr_dbu)}]
  set w [expr {max($ha, $hpa) > $fr_hop ? " WARN > [expr {$fr_hop / $u}] um" : ""}]
  if {$w ne ""} { incr fr_warn }
  puts "OT_FOREST_RECLUSTER $pfx: $P prefix / [llength $brL] branch / [llength $pts] leaf flops, $nmv leaves re-pointed; branch->leaf max [format %.0f [expr {$hb / $u}]] -> [format %.0f [expr {$ha / $u}]] um, prefix/hub->branch max [format %.0f [expr {$hpb / $u}]] -> [format %.0f [expr {$hpa / $u}]] um$w"
  puts $fr_log "# $pfx branch->leaf [format %.0f [expr {$hb / $u}]] -> [format %.0f [expr {$ha / $u}]] um prefix/hub->branch [format %.0f [expr {$hpb / $u}]] -> [format %.0f [expr {$hpa / $u}]] um"
  set fr_wmax_b [expr {max($fr_wmax_b, $hb)}]; set fr_wmax_a [expr {max($fr_wmax_a, $ha, $hpa)}]
  incr fr_tot_mv $nmv; incr fr_tot_leaf [llength $pts]; incr fr_done
}
close $fr_log
puts "OT_FOREST_RECLUSTER $fr_done forests ($fr_skip skipped, $fr_warn over the hop limit), $fr_tot_mv of $fr_tot_leaf leaves re-pointed to an identical branch, $fr_newinv inverters added, $fr_rm dead buffers/inverters removed; max forest hop [format %.0f [expr {$fr_wmax_b / double($fr_dbu)}]] -> [format %.0f [expr {$fr_wmax_a / double($fr_dbu)}]] um"
}
