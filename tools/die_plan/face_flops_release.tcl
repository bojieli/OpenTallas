# GENERATED by tools/die_plan/gen.py phys (PRE_DETAIL_PLACE hook): release the face_flops.tcl pin registers to PLACED
# so DPL legalises them next to where GPL kept them.
set ff_blk [ord::get_db_block]
set ff_n 0; set ff_esc 0
# Kept reset FF/driver pairs have a checked joint footprint; DPL must not split them.
set ff_reset_fixed {}
set ff_reset_file $::env(RESULTS_DIR)/ot_reset_pair_fixed.txt
if {[info exists ::env(OT_RESET_PAIR_FIXED)] && $::env(OT_RESET_PAIR_FIXED) eq "1" && [file exists $ff_reset_file]} {
  set ff_rf [open $ff_reset_file r]
  foreach n [split [read $ff_rf] "\n"] { if {$n ne ""} { dict set ff_reset_fixed $n 1 } }
  close $ff_rf
}
set fh [open $::env(RESULTS_DIR)/ot_face_flops.txt r]
foreach ln [split [read $fh] "\n"] {
  if {$ln eq ""} continue
  set ff_name [lindex [split $ln "\t"] 0]
  if {[dict exists $ff_reset_fixed $ff_name]} continue
  set i [$ff_blk findInst $ff_name]
  # DIE-HEAD-76 11-06: kit_istations exact banks list names with the bus-bit escapes stripped; look up the escaped
  # DB name too, else those station flops stay FIRM on tap sites (DPL-0033, 75 overlaps in the hd_spn 1106 kit).
  if {$i eq "NULL" || $i eq ""} { set i [$ff_blk findInst [string map {"\[" "\\[" "\]" "\\]"} $ff_name]]; if {$i ne "NULL" && $i ne ""} { incr ff_esc } }
  if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_n }
}
close $fh
puts "OT_FACE_FLOPS released $ff_n pin registers for DPL ($ff_esc found by escaped name)"
# HBM-GAPS-8 11-06 (OT_FF_CHAIN_PIN): release the face-chain BUF/INV cells too (empty list when off)
set ff_cf $::env(RESULTS_DIR)/ot_face_chain.txt
if {[file exists $ff_cf]} {
  set ff_nc 0; set fh [open $ff_cf r]
  foreach n [split [read $fh] "\n"] { if {$n eq ""} continue; set i [$ff_blk findInst $n]; if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_nc } }
  close $fh; if {$ff_nc} { puts "OT_FACE_CHAIN released $ff_nc face-chain cells for DPL" }
}
# S81-P8 10-23: relay_mid.tcl stations
set ff_f $::env(RESULTS_DIR)/ot_relay_mid.txt
if {[file exists $ff_f]} {
  set ff_m 0
  set fh [open $ff_f r]
  foreach n [split [read $fh] "\n"] {
    if {$n eq ""} continue
    set i [$ff_blk findInst $n]
    if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_m }
  }
  close $fh
  puts "OT_RELAY_MID released $ff_m relay flops for DPL"
}
# S81-TYPES-5 11-07 NARROW-GUTTER: gutter_block.tcl blockages steer GPL only, removed here before DPL
if {[file exists /work/gutter_release.tcl]} { source /work/gutter_release.tcl }
# DIE-HEAD-69 11-05: core_out_land.tcl landing flops
set ff_f $::env(RESULTS_DIR)/ot_core_out_land.txt
if {[file exists $ff_f]} {
  set ff_m 0
  set fh [open $ff_f r]
  foreach n [split [read $fh] "\n"] {
    if {$n eq ""} continue
    set i [$ff_blk findInst $n]
    if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_m }
  }
  close $fh
  puts "OT_CORE_OUT_LAND released $ff_m landing flops for DPL"
}
# S81-T51-RECUT 11-06: native_ff_pose.tcl source FFs stay LOCKED through GPL (the reviewed pose anchors the stages);
# released to PLACED here so DPL legalises a resizer-grown FF next to its pose (LOCKED x2 on x1 sites -> DPL-0033).
# No ot_native_pose.txt (every kit without recipe native_ff_pose) = nothing changes.
set ff_f $::env(RESULTS_DIR)/ot_native_pose.txt
if {[file exists $ff_f]} {
  set ff_m 0
  set fh [open $ff_f r]
  foreach n [split [read $fh] "\n"] {
    if {$n eq ""} continue
    set i [$ff_blk findInst $n]
    if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "LOCKED"} { $i setPlacementStatus PLACED; incr ff_m }
  }
  close $fh
  puts "OT_NATIVE_POSE released $ff_m posed FFs for DPL"
}
