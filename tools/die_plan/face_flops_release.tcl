# GENERATED by tools/die_plan/gen.py phys (PRE_DETAIL_PLACE hook): release the face_flops.tcl pin registers to PLACED
# so DPL legalises them next to where GPL kept them.
set ff_blk [ord::get_db_block]
set ff_n 0
set fh [open $::env(RESULTS_DIR)/ot_face_flops.txt r]
foreach ln [split [read $fh] "\n"] {
  if {$ln eq ""} continue
  set i [$ff_blk findInst [lindex [split $ln "\t"] 0]]
  if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_n }
}
close $fh
puts "OT_FACE_FLOPS released $ff_n pin registers for DPL"
# S81-P8 10-23: relay_mid.tcl stations
set ff_f $::env(RESULTS_DIR)/ot_relay_mid.txt
if {[file exists $ff_f]} {
  set ff_m 0
  set fh [open $ff_f r]
  foreach n [split [read $fh] "\n"] {
    if {$n eq ""} continue
    set i [$ff_blk findInst $n]
    if {$i ne "NULL" && $i ne "" && [$i getPlacementStatus] eq "FIRM"} { $i setPlacementStatus PLACED; incr ff_m }
  }
  close $fh
  puts "OT_RELAY_MID released $ff_m relay flops for DPL"
}
