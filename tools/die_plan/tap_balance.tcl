  foreach o [lsort -unique $outs] {
    set ot [$i findITerm $o]
    if {$ot ne "NULL" && [$ot getNet] ne "NULL"} { lappend todo [$ot getNet]; lappend nets [[$ot getNet] getName] }
  }
  puts "OT_TAP_PASSTHRU $p -> [lsort -unique $outs] (followed nets: [llength $nets])"
