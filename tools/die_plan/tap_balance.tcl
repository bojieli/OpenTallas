          set nb [expr {max($ns, int(round(($need - $base - 10.0) / $tb_cstage * 0.75)))}]
          set pts [tb_core_path $sx $sy $px $py $ns]
          set tag "[regsub -all {[^A-Za-z0-9_]} $p _]_ce${tb_tag}${ci}"
          puts "OT_TAP_CORE_ETAP $p need [format %.0f $need] ps from $kind [$src getName] at [format %.0f $base] ps, [format %.0f $bd] um, $ns repeaters + [expr {$nb - $ns}] pad"
          incr tb_added [tb_hang_path $it $src $nb $tag $pts $px $py]
          dict set tb_hung $p 1
          set todo 1
          continue
        }
        # ETAP off (default): branch off the tap's own CTS tree: the tree buffer nearest the core pin whose output
        # arrives early enough (out + ~20 ps of wire <= need); the chain sits at the pin.  The tap port itself is the
        # last resort (a long unbuffered wire from an ideal port: CP2 probe 10-23, 505 ps slew at the chain head).
        lassign [tb_outside $it] px py
        set best ""; set bd 0
        foreach b [tb_tree_bufs [$bt getNet]] {
          lassign $b bn bpin bnet bx by
          set q [get_pins -quiet $bpin]
          if {$q eq ""} continue
          set ba [tb_rise $q 1]
          if {$ba eq "" || $ba + 20.0 > $need} continue
          set dd [expr {abs($bx - $px) + abs($by - $py)}]
          if {$best eq "" || $dd < $bd} { set best [list $bnet $ba]; set bd $dd }
        }
        if {$best eq ""} {
          set src [$bt getNet]; set base 0.0
        } else {
          lassign $best src base
        }
        set nb [expr {max(1, int(round(($need - $base - 20.0) / 18.0 * 0.75)))}]
      } else {
        set src [$it getNet]
        set nb [expr {max(1, int(round($d / $tb_cstage * 0.75)))}]
      }
      if {$tb_conv && $d > 0} {
        # TAP-GRID-2130 converge: an early core pin is padded by the measured remainder at its own learned stage price
        if {[dict exists $tb_cprice $p]} { set nb [expr {max(1, int(floor($d / [dict get $tb_cprice $p] + 0.25)))}] }
        dict set tb_cprev $p [list [expr {$a + $L}] $nb]
      }
      lassign [tb_outside $it] x y
      set tag "[regsub -all {[^A-Za-z0-9_]} $p _]_cb${tb_tag}${ci}"
      incr tb_added [tb_hang $it $src $nb $tag $x $y]
      dict set tb_hung $p 1
      set todo 1
    }
    tb_end $todo
    if {!$todo} break
  }
}
if {$tb_conv} {
  # TAP-GRID-2130: the core pass moved pins of grid taps; verify the taps again and finish the remainder (bounded)
  for {set it $tb_iters} {$it < 2 * $tb_iters} {incr it} {
    if {![tb_tap_pass $it]} break
  }
  set m [tb_measure]
  set tb_off {}
  dict for {n v} $m { if {abs([lindex $v 0] - $tgt) > $tb_tol} { lappend tb_off "$n=[format %.0f [lindex $v 0]]" } }
  foreach c $tb_cores { lassign $c p tap a L; if {abs($a + $L - $tgt) > $tb_tol} { lappend tb_off "$p=[format %.0f [expr {$a + $L}]]" } }
  puts "OT_TAP_CONVERGE [expr {[llength $tb_off] ? {OPEN} : {DONE}}] target [format %.0f $tgt] tol [format %.0f $tb_tol]: [llength $tb_off] taps / core pins off target after [expr {$it}] tap passes (bound [expr {2 * $tb_iters}]): [lrange $tb_off 0 40]"
}
set m [tb_measure]
set lo 1e9; set hi 0.0; set fail {}
dict for {n v} $m {
  set lo [expr {min($lo, [lindex $v 0])}]; set hi [expr {max($hi, [lindex $v 0])}]
  if {[lindex $v 2] > $::tb_bnd + $tb_win} { lappend fail "$n=[format %.0f [lindex $v 2]]" }
}
set tb_empty {}
foreach bt [$tb_blk getBTerms] {
  set n [$bt getName]
  if {[regexp $tb_port_re $n] && ![dict exists $m $n]} { lappend tb_empty $n }
}
if {[llength $tb_cores]} {
  set cw [tb_core_report $tgt]
  puts "OT_TAP_CORE [llength $tb_cores] core clock pins, $cw outside target +/- [format %.0f $tb_win] ps"
}
if {$tb_undone} { puts "OT_TAP_BOUND $tb_undone chain(s) removed over the tree bound [format %.0f [expr {$::tb_bnd + $tb_win}]] ps" }
puts "OT_TAP_BALANCE done: $tb_added delay cells; tap mean insertion [format %.0f $lo]..[format %.0f $hi] ps (spread [format %.0f [expr {$hi - $lo}]], target [format %.0f $tgt]); empty taps [llength $tb_empty] $tb_empty"
if {[llength $fail]} {
  # insertion ~ grows with the tree span; shrink the pitch by the overshoot ratio
  set sug [expr {$tb_pitch * ($::tb_bnd + $tb_win) / max($hi, 1.0)}]
  # COORD 10-23 19:55 (owner clock rule): absolute insertion is GUIDANCE -> WARN; the hard clock checks are face-flop
  # spread <= 80 ps (TT+FF, RC) and seam skew <= 80 ps to the die common latency (clock.common_latency_ps)
  puts "OT_TAP_CHECK WARN trees over [format %.0f [expr {$::tb_bnd + $tb_win}]] ps: $fail; re-pitch taps to <= [format %.0f $sug] um (partition clock.tap_pitch_um)"
} else {
  puts "OT_TAP_CHECK OK every tap tree <= [format %.0f [expr {$::tb_bnd + $tb_win}]] ps"
}
}
}
