  set prev $src
  for {set b 0} {$b < $nb} {incr b} {
    set inst [odb::dbInst_create $tb_blk $tb_master "${tag}_d$b"]
    set nxt [expr {$b == $nb - 1 ? $tree : [odb::dbNet_create $tb_blk "${tag}_n$b"]}]
    if {$nxt ne $tree} { $nxt setSigType CLOCK }
    foreach t [$inst getITerms] {
      set mt [$t getMTerm]
      if {[$mt getSigType] in {POWER GROUND}} continue
      if {[$mt getIoType] eq "INPUT"} { $t connect $prev } elseif {[$mt getIoType] eq "OUTPUT"} { $t connect $nxt }
    }
    if {$b < [llength $pts]} { lassign [lindex $pts $b] lx ly } else { set lx [expr {$x + ($b - [llength $pts]) * 2 * [$tb_master getWidth]}]; set ly $y }
    $inst setLocation $lx $ly
    $inst setPlacementStatus PLACED
    set prev $nxt
  }
  return $nb
}
proc tb_core_report {tgt} {
  global tb_cores tb_win tb_tol
  set warn 0
  foreach c $tb_cores {
    lassign $c p tap a L
    set e [expr {$a + $L}]
    set st OK
    if {abs($e - $tgt) > $tb_win} {
      set st WARN; incr warn
      if {$e > $tgt && ![string match clk_c* $tap] && $L > $tgt - 40.0} {
        append st " internal latency [format %.0f $L] ps leaves no room on a grid tap: needs an early core tap (clock.taps kind core, clock.core_taps early; pair.py --core-taps)"
      } elseif {$e > $tgt && [string match clk_c* $tap]} {
        append st " early core tap still late: raise its insertion_ps (spine delivers it earlier)"
      }
    }
    puts "OT_TAP_CORE $p tap $tap pin [format %.0f $a] + internal [format %.0f $L] = effective [format %.0f $e] ps (target [format %.0f $tgt], window [format %.0f $tb_win]) $st"
  }
  return $warn
}
set tb_added 0
if {$tb_ronly} {
  set m [tb_measure 0]
  set lo 1e9; set hi 0.0; set mx 0.0
  dict for {n v} $m { set lo [expr {min($lo, [lindex $v 1])}]; set hi [expr {max($hi, [lindex $v 2])}] }
  puts "[tb_line {OT_TAP_RC mean(min-max,sinks):} $m]"
  puts "OT_TAP_RC sink insertion [format %.0f $lo]..[format %.0f $hi] ps (partition skew [format %.0f [expr {$hi - $lo}]]; limit [format %.0f [expr {$tb_target + $tb_win}]])"
  if {[llength $tb_cores]} { tb_core_report $tb_target }
} else {
# TAP-GRID-2130 (FABLE-CLOSURE-STRATEGY 21:30 lever 3 + COORD 21:4x col_h9_r1 u_u_s6 core clock 422 against 450): OT_TAP_CONVERGE=1
# (plan clock.tap_grid; unset = the old loop byte for byte) VERIFIES every tap and every hard-core pin on target after each
# pass and iterates until all are inside OT_TAP_TOL_PS, bounded by OT_TAP_CONVERGE_ITERS passes (default 8): (1) the stage
# price is learned per tap / per core pin from the previous pass (gain / stages; 18 ps a BUFx4 under-estimated the 2nd pass
# and over-padded clk_c* by 6-11 ps on t60), so each later pass pads the measured remainder, not 3/4 of a guess; (2) the
# latest-sink cap is target + OT_TAP_CONVERGE_WIN_PS (default the window + 60) instead of target + window, so a tap with a
# wide in-tap spread is still moved to the target mean (t60: taps left 30-150 ps early); (3) OT_TAP_CONVERGE_RAISE_PS
# (default 0) lifts the kit target to the latest raw tap mean, at most this much above the plan insertion, so no tap is left
# late; (4) the tap pass runs again after the core pass, then one OT_TAP_CONVERGE line lists every tap / core pin still off
# target (verification; advisory, never a stop).
set tb_conv [expr {[info exists ::env(OT_TAP_CONVERGE)] && $::env(OT_TAP_CONVERGE) eq "1"}]
set tb_iters [expr {$tb_conv && [info exists ::env(OT_TAP_CONVERGE_ITERS)] ? int($::env(OT_TAP_CONVERGE_ITERS)) : ($tb_conv ? 8 : 4)}]
set tb_cwin [expr {$tb_conv ? ([info exists ::env(OT_TAP_CONVERGE_WIN_PS)] ? $::env(OT_TAP_CONVERGE_WIN_PS) : $tb_win + 60.0) : $tb_win}]
set tb_raise [expr {$tb_conv && [info exists ::env(OT_TAP_CONVERGE_RAISE_PS)] ? $::env(OT_TAP_CONVERGE_RAISE_PS) : 0.0}]
set tb_price {}; set tb_prev {}
# FLOW-OBS-GCELL-1121 (FABLE-PD-HEAD-0700, HEAD sdr2d clk_t4/t5): a tap port inside a reserved M1-M7 strip (die clock-site
# obstruction, (1214.19,16.2)-(1330.88,18.36), 116.7 um long) seeded its delay chain at the port, inside the placement
# blockage; the legalizer put the cells on both sides of the strip and 7 chain nets detoured 80-143 um around its ends on
# M8+ (+91..+112 ps capture insertion).  The seed moves out of the strip, to the side of the tap's sink centroid, past the
# clock-halo rows (OT_CLK_OBS_HALO_ROWS + 1), so the whole chain legalizes on one side.  A port outside every M1 obstruction
# (or OT_TAP_SEED_SIDE=0) keeps the port seed byte for byte.
proc tb_seed_side {bt tree x y} {
  global tb_blk
  if {[info exists ::env(OT_TAP_SEED_SIDE)] && $::env(OT_TAP_SEED_SIDE) eq "0"} { return [list $x $y] }
  set hit ""
  foreach o [$tb_blk getObstructions] {
    set b [$o getBBox]; set L [$b getTechLayer]
    if {$L eq "NULL" || [$L getName] ne "M1"} continue
    if {$x >= [$b xMin] && $x <= [$b xMax] && $y >= [$b yMin] && $y <= [$b yMax]} { set hit [list [$b xMin] [$b yMin] [$b xMax] [$b yMax]]; break }
  }
  if {$hit eq ""} { return [list $x $y] }
  lassign $hit ox0 oy0 ox1 oy1
  set sx 0.0; set sy 0.0; set ns 0
  foreach t [$tree getITerms] { set ib [$t getInst]; set bb [$ib getBBox]; set sx [expr {$sx + ([$bb xMin] + [$bb xMax]) / 2.0}]; set sy [expr {$sy + ([$bb yMin] + [$bb yMax]) / 2.0}]; incr ns }
  if {$ns == 0} { return [list $x $y] }
  set cx [expr {$sx / $ns}]; set cy [expr {$sy / $ns}]
  set rows [$tb_blk getRows]
  set rh [expr {[llength $rows] ? [[[lindex $rows 0] getSite] getHeight] : 270}]
  set hr [expr {[info exists ::env(OT_CLK_OBS_HALO_ROWS)] ? $::env(OT_CLK_OBS_HALO_ROWS) : 1}]
  set gap [expr {($hr + 1) * $rh}]
  set core [$tb_blk getCoreArea]
  if {($ox1 - $ox0) >= ($oy1 - $oy0)} {
    # long in x: above or below; x stays on the port, clamped into the strip span
    set up [expr {$cy >= ($oy0 + $oy1) / 2.0}]
    set ny [expr {$up ? $oy1 + $gap : $oy0 - $gap - $rh}]
    if {$ny < [$core yMin] || $ny + $rh > [$core yMax]} { set up [expr {!$up}]; set ny [expr {$up ? $oy1 + $gap : $oy0 - $gap - $rh}] }
    set nx [expr {int(max($ox0, min($ox1, $x)))}]
    puts "OT_TAP_SEED_SIDE [$bt getName] port in M1 strip ($ox0,$oy0)-($ox1,$oy1): chain seed [expr {$up ? {above} : {below}}] at y $ny (sink centroid y [format %.0f $cy], $ns sinks)"
    return [list $nx [expr {int($ny)}]]
  }
  set rt [expr {$cx >= ($ox0 + $ox1) / 2.0}]
  set nx [expr {$rt ? $ox1 + 10 * 54 : $ox0 - 10 * 54 - 2000}]
  if {$nx < [$core xMin] || $nx > [$core xMax]} { set rt [expr {!$rt}]; set nx [expr {$rt ? $ox1 + 10 * 54 : $ox0 - 10 * 54 - 2000}] }
  puts "OT_TAP_SEED_SIDE [$bt getName] port in M1 strip ($ox0,$oy0)-($ox1,$oy1): chain seed [expr {$rt ? {east} : {west}}] at x $nx (sink centroid x [format %.0f $cx], $ns sinks)"
  return [list [expr {int($nx)}] [expr {int(max($oy0, min($oy1, $y)))}]]
}
# TAPBAL-BOUND 11-24 (QC-CBX-CLOCK, COORD): a tap is never padded above the post-CTS tree bound (tb_bnd + window).  The pad
# count is priced at ~18 ps a BUFx4 stage, but the last stage drives the whole tree root: QC slw_hc1 cl3449ea95 clk_t101 (7319
# sinks) took +41 ps for ONE stage (251 -> 292, max 263 -> 304), clk_t10 +61 for two; 54 of 132 taps ended over 285 ps with
# every raw tree under it (sle_ctl 69/265, sle_fw 46/107).  After each pass a tap whose slowest sink is now over the bound loses
# the chain just added (tree back on the port net, cells and nets removed) and may be padded again with one stage fewer
# (0 = frozen as built).  OT_TAP_BOUND_GUARD=0 turns it off (the old loop byte for byte).
set tb_guard [expr {![info exists ::env(OT_TAP_BOUND_GUARD)] || $::env(OT_TAP_BOUND_GUARD) ne "0"}]
set tb_last {}; set tb_ncap {}; set tb_undone 0
proc tb_undo {n c} {
  global tb_blk tb_added
  lassign $c root tree insts nets
  set mine {}
  foreach i $insts { set ii [$tb_blk findInst $i]; if {$ii ne "NULL"} { lappend mine $ii } }
  foreach t [$tree getITerms] {
    if {[lsearch -exact $mine [$t getInst]] >= 0} continue
    $t disconnect; $t connect $root
  }
  foreach ii $mine { odb::dbInst_destroy $ii; incr tb_added -1 }
  foreach nn [concat $nets [list [$tree getName]]] { set x [$tb_blk findNet $nn]; if {$x ne "NULL"} { odb::dbNet_destroy $x } }
}
# m = a fresh tb_measure; returns 1 when a chain was removed (the caller re-measures)
proc tb_bound_guard {m} {
  global tb_guard tb_last tb_ncap tb_win tb_undone
  if {!$tb_guard || ![dict size $tb_last]} { set tb_last {}; return 0 }
  set lim [expr {$::tb_bnd + $tb_win}]
  set undo {}
  dict for {n c} $tb_last {
    if {![dict exists $m $n]} continue
    if {[lindex [dict get $m $n] 2] > $lim} { lappend undo $n }
  }
  if {![llength $undo]} { set tb_last {}; return 0 }
  tb_begin
  foreach n $undo {
    set c [dict get $tb_last $n]
    tb_undo $n $c
    dict set tb_ncap $n [expr {[llength [lindex $c 2]] - 1}]
    incr tb_undone
    puts "OT_TAP_BOUND $n max [format %.0f [lindex [dict get $m $n] 2]] > bound [format %.0f $lim] ps after [llength [lindex $c 2]] stage(s): chain removed, next pad <= [dict get $tb_ncap $n]"
  }
  tb_end 0
  set tb_last {}
  return 1
}
proc tb_tap_pass {it} {
  global tb_blk tb_master tb_target tb_win tb_tol tb_tag tb_grt tb_added tgt tb_conv tb_cwin tb_raise tb_price tb_prev tb_coreonly
  global tb_cdirect tb_cdmax tb_slowest tb_slow_max tb_ncap tb_last
  set m [tb_measure]
  if {[llength [info procs tb_bound_guard]] && [tb_bound_guard $m]} { set m [tb_measure] }
  set longest 0.0
  set slow_tap ""
  dict for {n v} $m { if {[lindex $v 0] > $longest} { set longest [lindex $v 0]; set slow_tap $n } }
  # target fixed at the first pass (padding overshoot must not ratchet it up); a padded tree's slowest sink stays
  # <= ins + tol
  # KV-P5 17:34 / KV-P6: the target is the PLAN insertion (OT_TAP_TARGET_PS = clock.insertion_ps = the vclk source
  # latency of the IO SDC and the neighbours' insertion), not the slowest local tree: kits8 trees at 205-222 ps
  # balanced to their own 222 ps captured every in2reg path ~30 ps early (TT in2reg -76.6).  Trees already above the
  # target stay as built (<= ins + win, else OT_TAP_CHECK WARN).  OT_TAP_BALANCE_TO=longest restores the old rule.
  if {$it == 0} {
    if {[info exists ::env(OT_TAP_BALANCE_TO)] && $::env(OT_TAP_BALANCE_TO) eq "longest"} {
      set tgt [expr {min($tb_target + $tb_win, max($tb_target - $tb_win, $longest))}]
    } else {
      set tgt $tb_target
    }
    if {$tb_conv && $tb_raise > 0} {
      set tgt [expr {max($tgt, min($tb_target + $tb_raise, $longest))}]
      puts "OT_TAP_CONVERGE target [format %.0f $tgt] ps (plan [format %.0f $tb_target], latest raw tap mean [format %.0f $longest], raise cap [format %.0f $tb_raise])"
    }
    if {$tb_slowest} {
      set s [expr {max($tb_target, $longest)}]
      if {$tb_slow_max > 0} { set s [expr {min($s, max($tb_target, $tb_slow_max))}] }
      set tgt [expr {max($tgt, $s)}]
      set ::tb_bnd $tgt
      puts "OT_TAP_SLOWEST target [format %.0f $tgt] ps (plan [format %.0f $tb_target], slowest raw tap $slow_tap mean [format %.0f $longest], cap [expr {$tb_slow_max > 0 ? [format %.0f $tb_slow_max] : {none}}]); post-CTS tree bound [format %.0f [expr {$tgt + $::tb_win}]] ps"
    }
  }
  if {$tb_conv} {
    # learned stage price of every tap padded in the previous pass
    dict for {n pv} $tb_prev {
      if {![dict exists $m $n]} continue
      lassign $pv m0 nb0
      set g [expr {[lindex [dict get $m $n] 0] - $m0}]
      if {$g > 1.0 && $nb0 > 0} { dict set tb_price $n [expr {$g / $nb0}] }
    }
    set tb_prev {}
  }
  puts "[tb_line "OT_TAP_BALANCE[expr {$tb_grt ? { GRT} : {}}] it$it target [format %.0f $tgt]:" $m]"
  set todo 0
  tb_begin
  dict for {n v} $m {
    if {$tb_conv} {
      set d [expr {min($tgt - [lindex $v 0], $tgt + $tb_cwin - [lindex $v 2])}]
    } else {
      set d [expr {min($tgt - [lindex $v 0], $::tb_bnd + $tb_win - [lindex $v 2])}]
    }
    if {$d <= $tb_tol} continue
    if {$tb_cdirect && [dict exists $tb_coreonly $n] && [set tb_dc [tb_direct_core $n [lindex $v 4]]] ne ""} {
      puts "OT_TAP_CORE_DIRECT $n port inside $tb_dc: effective [format %.0f [lindex $v 0]] ps, [format %.0f $d] ps under target [format %.0f $tgt]: not padded (a delay cell must leave the core)[expr {$d > $tb_cdmax ? " WARN over [format %.0f $tb_cdmax] ps: lower the core tap early shift in the plan" : ""}]"
      continue
    }
    # TAP-GRID-2130 converge: a core-only early tap (clk_c<k>) is not padded at its port (a port-side pad drives the whole port -> core
    # wire: KV pv v8c 82 ps a stage, clk_c14 209 -> 373 against 250); the core pass pads in front of the pin instead (short net)
    if {$tb_conv && [string match clk_c* $n] && [dict exists $tb_coreonly $n]} continue
    set todo 1
    # ~18 ps per BUFx4 stage on a short local net; insert 3/4 of the estimate per pass and re-measure
    if {$tb_conv && [dict exists $tb_price $n]} {
      # converge: the measured remainder at this tap's own measured stage price (rounded down past a quarter stage: never overshoot by a stage)
      set nb [expr {max(1, int(floor($d / [dict get $tb_price $n] + 0.25)))}]
    } else {
      set nb [expr {max(1, int(round($d / 18.0 * 0.75)))}]
    }
    if {[info exists tb_ncap] && [dict exists $tb_ncap $n]} {
      if {[dict get $tb_ncap $n] < 1} continue
      set nb [expr {min($nb, [dict get $tb_ncap $n])}]
    }
    if {$tb_conv} { dict set tb_prev $n [list [lindex $v 0] $nb] }
    set bt [lindex $v 4]
    set root [$bt getNet]
    set bb [$bt getBBox]
    set x [expr {([$bb xMin] + [$bb xMax]) / 2}]; set y [expr {([$bb yMin] + [$bb yMax]) / 2}]
    # the tree hangs off a new net; the chain runs tap port -> buf ... -> new net
    set tree [odb::dbNet_create $tb_blk "${n}_tb${tb_tag}${it}_tree"]
    $tree setSigType CLOCK
    foreach t [$root getITerms] { $t disconnect; $t connect $tree }
    lassign [tb_seed_side $bt $tree $x $y] x y
    set prev $root
    set tb_ci {}; set tb_cn {}
    for {set b 0} {$b < $nb} {incr b} {
      set inst [odb::dbInst_create $tb_blk $tb_master "${n}_tb${tb_tag}${it}_d$b"]
      lappend tb_ci "${n}_tb${tb_tag}${it}_d$b"; if {$b < $nb - 1} { lappend tb_cn "${n}_tb${tb_tag}${it}_n$b" }
      set nxt [expr {$b == $nb - 1 ? $tree : [odb::dbNet_create $tb_blk "${n}_tb${tb_tag}${it}_n$b"]}]
      if {$nxt ne $tree} { $nxt setSigType CLOCK }
      foreach t [$inst getITerms] {
        set mt [$t getMTerm]
        if {[$mt getSigType] in {POWER GROUND}} continue
        if {[$mt getIoType] eq "INPUT"} { $t connect $prev } elseif {[$mt getIoType] eq "OUTPUT"} { $t connect $nxt }
      }
      $inst setLocation [expr {$x + $b * 2 * [$tb_master getWidth]}] $y
      $inst setPlacementStatus PLACED
      set prev $nxt
      incr tb_added
    }
    dict set tb_last $n [list $root $tree $tb_ci $tb_cn]
  }
  tb_end $todo
  return $todo
}
for {set it 0} {$it < $tb_iters} {incr it} {
