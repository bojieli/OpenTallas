# ~/coord/events/<EVENT>.env : one env file per plan event (EVENT-ENV-PREFLIGHT 11-24, main e4a84a2ca3, tools/fleet/ot_event_env.py).
# Use:   ot-run --event-env ~/coord/events/<EVENT>.env --mem .. --hosts .. -- <cmd>      (or export OT_RUN_EVENT_ENV=<file>)
# Check: python3 -I <rt>/tools/fleet/ot_event_env.py --check ~/coord/events/<EVENT>.env
# Literal KEY=VALUE lines only (no $ expansion).  The die lead owns the file and changes it via bin/coord-commit.sh, never in a lane script.
# At queue time ot-run refuses (NOT-RUN PREFLIGHT) a unit when:
#   - its host lacks OT_EVENT_INPUTS or the event rt;
#   - its command, its script or the caller sets an OT_PLAN_GATE_* / OT_TOOLSTALE_RT value that differs from this file.
OT_EVENT=TEMPLATE
# rt snapshot every unit of the event pins (12-hex sha of <scratch>/claude/rt/<sha>); exported as OT_TOOLSTALE_RT
OT_EVENT_RT=000000000000
# absolute bind / tree dirs the units read; they must exist on the chosen host (two-host publish: same path on 2 hosts)
OT_EVENT_INPUTS=/srv/opentallas-scratch2/claude/<owner-lane>/<event>/bind,/srv/opentallas-scratch2/claude/<owner-lane>/<event>/tree
# fail (default) | warn | off
OT_RUN_PREFLIGHT=fail
# the event gate env: the WHOLE gate env (a lane-set OT_PLAN_GATE_SKIP the event does not list is a finding)
OT_PLAN_GATE_PRE=warn
OT_PLAN_GATE_BASELINE=/srv/opentallas-scratch2/claude/<owner-lane>/inputs/<baseline_plan>.json
# the wave's effective env (private kits must match the wave kit: memory private-kit-wave-env-1121); copy from the wave kit config.mk
OT_PGCAP=1
OT_PLACE_MAX_FANOUT=64
OT_CLAND_STRIP_DENS=1
OT_IO_HOLD=sender_min
OT_GPL_SPARSE_UTIL=0.10
